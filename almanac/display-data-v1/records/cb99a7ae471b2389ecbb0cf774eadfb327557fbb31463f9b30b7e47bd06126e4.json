 retained as approximately 220 km; the two jet records share one source claim, not independent observations or annual extrema."}],"season_url":"seasons.html?current=pacific-south-subsurface-countercurrent","section_fingerprints":{"claims":"0e0c05a5d40952d9c2c97313b1d6ab731b38dead749fd38cf5c17ec5ff77e35f","identity":"b7414bf443e8963a5b28ca403c015f93dda386b06a5e6fe57a874c0e5c244f15","measurements":"09913ea1ed86149f222febf291858e761589867e603167c0564914aca98c925b","media":"58afbefd1dab0d7d6c48803e676a9db2cb525a9c221574435bb52c2a5c6e12b4","routes_geometry":"a41b9a5f328318ad9e999375b059a9a2466c73f5345cac8c14d01462ef68b8b5","sources":"3a8e02fd0bf8b562ae4d8bbeaba84aea67b798490a5b40994a03a6751b758022","time_evidence":"8d86da8229951992c802d517eaeaeeb84a4b5f1a3e916ecd7944f448135387bd"},"series":[],"setting":"equatorial","source_ids":["source:4dc5fc618c26565f","source:4f7441b953be4651","source:803229fe82eb2360","source:b038491b0e5a3967","source:df8a86f107aba236"],"source_kind":"eastward subsurface jets south of the Equatorial Undercurrent","state_codes":[],"state_evidence":[],"time_behavior":"persistent_variable","type":"named_current","velocity_sample_ids":[],"width_ids":["pacific-south-subsurface-countercurrent-rowe-2000-general-angular-width"],"width_sample_ids":[]},"reference_routes":[{"approximate_reference_path_km":5000,"candidate_file":"research/pacific-sscc-mean-reach-reference-path-candidate.json","candidate_sha256":"bb9b13844a2eb7b52c2a25689a900c3f161841acf13a90240b4a7767df57eed1","comparison_group":"osw_studied_reach_routes","current_id":"pacific-south-subsurface-countercurrent","figure":"figures/pacific-sscc-mean-reach-reference-path-candidate.svg","generator_sha256":"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240","id":"pacific-sscc-mean-reach-reference-path-candidate","name":"Pacific South Subsurface Countercurrent","nominal_atlas_state_crossings":["PEQD","PNEC"],"ordering_sensitivity":null,"parent_current_id":null,"parent_scope_note":null,"reco
ce_paths":["research/south-java-java-bali-reference-path-v2-candidate.json","research/south-java-parent-audit-result-v1.json","research/south-java-parent-audit-selected-records-v1.json","research/south-java-reference-geography-result-v1.json","research/south-java-reference-map-review-v2.json","research/south-java-reference-query-contract-v1.json","research/south-java-reference-runtime-contract-v1.json"],"original_source_strings_preserved":616,"original_sources_verified":617,"replaced_source_paths":["research/ocean-motion-dashboard.json"],"scientific_source_documents_replaced":0}},"state_geometry_runtime":{"pyproj":"3.7.2","shapely":"2.1.2"},"status":"local_editorial_and_canonical_snapshot_not_new_scientific_admission","supplemental_object_collections":["widths","current_identity_admissions","current_measurement_admissions","current_regional_reaches","route_decisions","current_direction_calendars","current_direction_descriptions","current_reported_width_evidence","current_cross_shore_context","current_regime_context"],"taxonomy":{"complete_physical_taxonomy":false,"identity_levels":{"current":"One named current with a source-dependent upstream and downstream extent.","dated_detection":"A feature designated by one provider in one dated receipt; no historical-name equivalence, formation time, lifetime, or continuity across dates is established.","eddy_family":"A named class of related eddies, such as Agulhas Rings; individual members need separate dated identities.","family":"Shared name used for related flows in more than one basin; split before measuring.","individual_eddy":"A particular named eddy, separate from its type, region, and trajectory ID.","recurrent_eddy_region":"A geographic name reused for eddies forming or persisting in a region; not one dated individual or trajectory.","segment":"Named part or continuation of a larger current system.","system":"A named circulation system that can contain branches or segments."},"link_count":25,"measurement_inheritance_eligible":false,"node_count":251,"schema":"osw.query-taxonomy.v1","scope":"Existing editorial identity facets and ledger parent assignments; not flow connectivity, physical containment, equivalent identities or inherited measurements. Missing members remain unassessed.","source_receipts":[{"file":"research/ocean-current-almanac.json","sha256":"6c8a143208c0953512875f222154a819d5f56b7326daa6816f0609e61b4f261e","source_json":"{\r\n  \"schema\": \"osw.almanac.named-currents.v1\",\r\n  \"as_of\": \"2026-10-02\",\r\n  \"scope\": \"First source-backed set of named currents and current systems, anchored to NOAA's currents glossary and map and extended with regional primary sources; not an exhaustive world register.\",\r\n  \"ranking_rule\": \"Only published approximate along-current or system-length estimates admitted as established flows are ordered. Proposed continuity hypotheses, sampled reaches, derived or published lower bounds, and unknown lengths are unranked. Estimates with different system boundaries are not precise head-to-head measurements.\",\r\n  \"sources\": {\r\n    \"noaa_map\": \"https://www.vos.noaa.gov/docs/marine_info_guide.pdf\",\r\n    \"noaa_glossary\": \"https://www.tidesandcurrents.noaa.gov/glossary.html\",\r\n    \"regional_oceanography_atlantic\": \"https://incois.gov.in/Tutor/regoc/pdffiles/colour/single/14P-Atlantic.pdf\",\r\n    \"noaa_loop\": \"https://oceanservice.noaa.gov/facts/loopcurrent.html\",\r\n    \"noaa_aoml\": \"https://www.aoml.noaa.gov/phod/altimetry/cvar/index.php\",\r\n    \"acc_length\": \"https://doi.org/10.1029/2021JC017899\",\r\n    \"nasa_acc_length\": \"https://www.nasa.gov/centers-and-facilities/jpl/seal-takes-ocean-heat-transport-data-to-new-depths/\",\r\n    \"california_length\": \"https://meetings.pices.int/publications/special-publications/NPESR/2004/File_10_pp_177_192.pdf\",\r\n    \"kuroshio_length\": \"https://tos.org/oceanography/assets/docs/28-4_yj-yang.pdf\",\r\n    \"humboldt_system_extent\": \"https://repositorio.imarpe.gob.pe/bitstream/20.500.12958/2108/1/Purca%20Cuicapusa%2C%20Sara.pdf\",\r\n    \"kuroshio_extension_kess\": \"https://www.whoi.edu/science/PO/POOL/projects.html\",\r\n    \"leeuwin_extent\": \"https://api.research-repository.uwa.edu.au/ws/portalfiles/portal/12257343/THESIS_DOCTOR_OF_PHILOSOPHY_ONG_Jia_Lin_Joyce_2017.pdf\",\r\n    \"cartographic_map\": \"https://services3.arcgis.com/o98K21Ga5N91Ugjw/ArcGIS/rest/services/Hurricane%20TracksAA/FeatureServer/11\",\r\n    \"caribbean_fisheries_oceanography\": \"https://repository.library.noaa.gov/view/noaa/4711/noaa_4711_DS1.pdf\",\r\n    \"south_atlantic_float_study\": \"https://www.aoml.noaa.gov/phod/docs/boebel_et_al1999a.pdf\",\r\n    \"south_indian_geotraces_study\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1002/2014gb004898\",\r\n    \"noaa_equatorial\": \"https://tidesandcurrents.noaa.gov/glossary.html\",\r\n    \"south_pacific_paper\": \"https://journals.ametsoc.org/view/journals/phoc/25/1/1520-0485_1995_025_0077_tspc_2_0_co_2.xml\",\r\n    \"australian_boundary_length\": \"https://doi.org/10.1029/2003JC001921\",\r\n    \"marine_regions\": \"https://www.marineregions.org/gazetteer.php?p=webservices\",\r\n    \"antarctic_coastal_paper\": \"https://doi.org/10.1016/j.dsr.2009.06.005\",\r\n    \"azores_section\": \"https://doi.org/10.1029/2011JC007129\",\r\n    \"portugal_section\": \"https://doi.org/10.1002/jgrc.20227\",\r\n    \"norwegian_coastal_stations\": \"https://academic.oup.com/icesjms/article/69/5/758/646533\",\r\n    \"torungen_place\": \"https://stadnamn.kartverket.no/fakta/789560\",\r\n    \"algerian_current_study\": \"https://os.copernicus.org/articles/15/1111/2019/\",\r\n    \"balearic_current_study\": \"https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2021JC017589\",\r\n    \"western_adriatic_drifters\": \"https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2005JC003177\",\r\n    \"baffin_bay_survey\": \"https://www.sciencedirect.com/science/article/pii/S0079661124001289\",\r\n    \"mauritania_seasonal\": \"https://journals.ametsoc.org/view/journals/phoc/52/1/JPO-D-21-0092.1.xml\",\r\n    \"gaspe_coastal_jet\": \"https://journals.ametsoc.org/view/journals/phoc/31/11/1520-0485_2001_031_3146_doabdc_2.0.co_2.xml\",\r\n    \"northern_mediterranean\": \"https://os.copernicus.org/articles/14/689/2018/\",\r\n    \"pacific_euc_mooring\": \"https://doi.org/10.1029/93JC03506\",\r\n    \"pacific_euc_pathway\": \"https://doi.org/10.1029/2011JC007477\",\r\n    \"pacific_euc_alternate_extent\": \"https://doi.org/10.1080/03091929.2015.1066785\",\r\n    \"atlantic_euc_mooring\": \"https://doi.org/10.1029/2004GL022206\",\r\n    \"indian_euc_survey\": \"https://repository.library.noaa.gov/view/noaa/64055\",\r\n    \"indian_euc_review\": \"https://repository.library.noaa.gov/view/noaa/44660/noaa_44660_DS1.pdf\",\r\n    \"lomonosov_alias\": \"https://www.fao.org/4/t0081e/T0081E03.htm\",\r\n    \"atlantic_neuc_mooring\": \"https://doi.org/10.1029/2020GL088350\",\r\n    \"pacific_neuc_array\": \"https://www.frontiersin.org/journals/marine-science/articles/10.3389/fmars.2022.979442/full\",\r\n    \"atlantic_seuc_section\": \"https://doi.org/10.1029/2002GL016849\",\r\n    \"indian_seuc_mooring\": \"https://doi.org/10.1029/2022GL098163\",\r\n    \"greenland_coastal_hypothesis\": \"https://doi.org/10.1175/1520-0485(1989)019%3C0384:OTOOSW%3E2.0.CO;2\",\r\n    \"gulf_stream_sampled_reach\": \"https://doi.org/10.1029/2024GL111000\",\r\n    \"noaa_gulf_stream_coast_pilot\": \"https://nauticalcharts.noaa.gov/publications/coast-pilot/files/cp4/CPB4_WEB.pdf\",\r\n    \"east_australian_latitude_span\": \"https://gmd.copernicus.org/articles/19/3853/2026/\",\r\n    \"tasman_front_observations\": \"https://doi.org/10.1002/2017JC013097\",\r\n    \"atlantic_necc_observations\": \"https://doi.org/10.1029/2007JC004215\",\r\n    \"pacific_necc_sections\": \"https://www.pmel.noaa.gov/pubs/outstand/john2337/zonal_velocity.shtml\",\r\n    \"atlantic_secc_survey\": \"https://doi.org/10.1175/1520-0485(1998)028%3C1904:TAPOTU%3E2.0.CO;2\",\r\n    \"pacific_secc_argo\": \"https://doi.org/10.1029/2025JC023053\",\r\n    \"indian_secc_xbt\": \"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_6/b_fdi_45-46/010007560.pdf\",\r\n    \"aleutian_current_glossary\": \"https://glossary.ametsoc.org/wiki/aleutian-current/\",\r\n    \"mediterranean_undercurrent_floats\": \"https://doi.org/10.1029/2001JC001007\",\r\n    \"atlantic_dwbc_section\": \"https://doi.org/10.1029/2006GL026965\",\r\n    \"atlantic_decadal_circulation_sections\": \"https://os.copernicus.org/articles/19/1009/2023/\",\r\n    \"east_adriatic_measurements\": \"https://doi.org/10.1029/2005JC003271\",\r\n    \"black_sea_rim_indicator\": \"https://data.marine.copernicus.eu/product/OMI_CIRCULATION_BOUNDARY_BLKSEA_rim_current_index/description\",\r\n    \"nasa_po2_western_boundary\": \"https://svs.gsfc.nasa.gov/5425\",\r\n    \"nasa_indonesian_passages\": \"https://svs.gsfc.nasa.gov/5141\",\r\n    \"antilles_section\": \"https://spo.nmfs.noaa.gov/sites/default/files/pdf-content/1975/733/ingham.pdf\",\r\n    \"arabian_marginal_outflows\": \"https://doi.org/10.1029/1999JC900297\",\r\n    \"east_greenland_coastal_survey\": \"https://www.whoi.edu/cms/files/Sutherland_EGCC_revised_withfigs_33743.pdf\",\r\n    \"east_greenland_extent\": \"https://doi.org/10.1029/2023JC019890\",\r\n    \"agulhas_return_hydrography\": \"https://www.cfoo.co.za/seaatlas/papers/agulhas_return_current.pdf\",\r\n    \"agulhas_current_extent_reanalysis\": \"https://www.frontiersin.org/journals/marine-science/articles/10.3389/fmars.2022.837906/full\",\r\n    \"agulhas_coastal_length_review\": \"https://bg.copernicus.org/articles/18/5967/2021/\",\r\n    \"east_australian_system_review\": \"https://www.unsw.edu.au/content/dam/pdfs/science/bees/research-reports/2024-05-oceanography/Oke_etal.pdf\",\r\n    \"western_pacific_euc_pathways\": \"https://doi.org/10.1029/2011JC007477\",\r\n    \"new_guinea_coastal_moorings\": \"https://doi.org/10.1029/2020JC016242\",\r\n    \"pacific_subsurface_countercurrent_sections\": \"https://www.pmel.noaa.gov/pubs/outstand/john2337/zonal_velocity.shtml\",\r\n    \"hiri_current_scope\": \"https://doi.org/10.1002/2013JC009591\",\r\n    \"alaska_coastal_gulf_extent\": \"https://doi.org/10.1016/j.dsr2.2015.12.016\",\r\n    \"antarctic_slope_review\": \"https://doi.org/10.1029/2018RG000624\",\r\n    \"malvinas_egu_2009_length\": \"https://meetingorganizer.copernicus.org/EGU2009/EGU2009-12242.pdf\"\r\n  },\r\n  \"entries\": [\r\n    {\r\n      \"id\": \"acc\",\r\n      \"name\": \"Antarctic Circumpolar Current\",\r\n      \"basin\": \"Southern Ocean\",\r\n      \"kind\": \"circumpolar current system\",\r\n      \"length_km\": 25000,\r\n      \"length_scope\": \"Approximate circumpolar path; source calls it the longest wind-driven current.\",\r\n      \"length_source\": \"acc_length\",\r\n      \"name_source\": \"noaa_map\",\r\n      \"source_reported_length_variants\": [\r\n        {\r\n          \"length_km_approx\": 21000,\r\n          \"scope\": \"NASA/JPL's 2019 overview says the Antarctic Circumpolar Current spans about 13,000 miles (21,000 km). It does not specify a reference streamline or contour, so this alternate whole-current approximation is retained separately from the ranked 25,000 km research estimate.\",\r\n          \"source\": \"nasa_acc_length\",\r\n          \"rank_eligible\": false,\r\n          \"source_locator\": \"NASA/JPL article, paragraph beginning The Antarctic Circumpolar Current flows in a loop (13,000 miles / 21,000 km)\"\r\n        }\r\n      ],\r\n      \"length_source_locator\": \"Section 1 Introduction, opening sentence (approximately 25,000 km)\"\r\n    },\r\n    {\r\n      \"id\": \"antarctic-coastal\",\r\n      \"name\": \"Antarctic Coastal Current (East Wind Drift)\",\r\n      \"basin\": \"Southern Ocean\",\r\n      \"kind\": \"westward polar coastal current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The East Wind Drift is westward near the Antarctic coast. Its continuity and start/end limits vary by sector; the four published map arrows do not supply a measured centerline or comparable whole-current length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"antarctic_coastal_paper\"\r\n    },\r\n    {\r\n      \"id\": \"california\",\r\n      \"name\": \"California Current\",\r\n      \"basin\": \"North Pacific\",\r\n      \"kind\": \"eastern boundary current system\",\r\n      \"length_km\": 3000,\r\n      \"length_scope\": \"Approximate California Current System extent from Baja California Sur to northern Vancouver Island; not a measured California Current core axis.\",\r\n      \"length_source\": \"california_length\",\r\n      \"name_source\": \"noaa_map\",\r\n      \"length_source_locator\": \"PDF page 3, background box under California Current (California Current System extends 3,000 km)\"\r\n    },\r\n    {\r\n      \"id\": \"gulf-stream-system\",\r\n      \"name\": \"Gulf Stream System\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"kind\": \"multi-segment current system\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"NOAA's glossary defines a continuous system comprising the Florida Current, Gulf Stream, and North Atlantic Current. The whole system extends beyond the Grand Banks toward the British Isles, so no 3,000 km Florida-to-Grand-Banks span is treated as its complete length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\",\r\n      \"component_current_ids\": [\r\n        \"florida\",\r\n        \"gulf-stream\",\r\n        \"north-atlantic\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"gulf-stream\",\r\n      \"name\": \"Gulf Stream\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"kind\": \"western boundary current\",\r\n      \"length_km\": 2500,\r\n      \"length_scope\": \"Tomczak and Godfrey report approximately 2,500 km for the Gulf Stream proper as an open-ocean free jet downstream of Cape Hatteras toward the Newfoundland Rise/Grand Banks near 50°W. This excludes the Florida Current and North Atlantic Current; it is a textbook path-scale description, not a measured reference streamline. NOAA's glossary uses the same strict segment definition, while NASA and NOAA Coast Pilot sometimes use Gulf Stream more broadly.\",\r\n      \"length_source\": \"regional_oceanography_atlantic\",\r\n      \"name_source\": \"noaa_map\",\r\n      \"part_of_system\": \"gulf-stream-system\",\r\n      \"source_extent_variants\": [\r\n        {\r\n          \"source\": \"noaa_glossary\",\r\n          \"definition\": \"strict Gulf Stream segment\",\r\n          \"upstream\": \"region off Cape Hatteras\",\r\n          \"downstream\": \"southeast of Grand Banks near 40°N, 50°W\"\r\n        },\r\n        {\r\n          \"source\": \"noaa_gulf_stream_coast_pilot\",\r\n          \"definition\": \"broader Gulf Stream usage including Florida Straits\",\r\n          \"upstream\": \"Straits of Florida\",\r\n          \"downstream\": \"Grand Banks region\"\r\n        },\r\n        {\r\n          \"source\": \"nasa_po2_western_boundary\",\r\n          \"definition\": \"NASA visualization usage beginning at Florida Straits\",\r\n          \"upstream\": \"Florida Straits\",\r\n          \"downstream\": \"not defined on the cited page\"\r\n        }\r\n      ],\r\n      \"sampled_reach\": {\r\n        \"alongflow_km_approx\": 2000,\r\n        \"region\": \"offshore U.S. East Coast\",\r\n        \"source\": \"gulf_stream_sampled_reach\",\r\n        \"scope\": \"Fifty-two glider missions sampled along a roughly 2,000 km long portion during 2015–2023.\",\r\n        \"source_locator\": \"PDF page 3, Section 2.1 Underwater Glider Data and Methods, paragraph on 52 missions sampling a roughly 2,000 km Gulf Stream reach\"\r\n      },\r\n      \"length_source_locator\": \"Chapter 14, The Atlantic Ocean, PDF page 11 (printed page 239), paragraph beginning Recirculation of Gulf Stream water (next 2,500 km Gulf Stream proper)\"\r\n    },\r\n    {\r\n      \"id\": \"kuroshio\",\r\n      \"name\": \"Kuroshio Current\",\r\n      \"basin\": \"North Pacific\",\r\n      \"kind\": \"western boundary current\",\r\n      \"length_km\": 3000,\r\n      \"length_scope\": \"Approximate Kuroshio journey from about 12°N to 35°N in the western North Pacific; not a measured whole-current axis, and the Kuroshio Extension is separate.\",\r\n      \"length_source\": \"kuroshio_length\",\r\n      \"name_source\": \"noaa_map\",\r\n      \"length_source_locator\": \"PDF page 3, Introduction opening paragraph (3,000 km journey from about 12°N to 35°N)\"\r\n    },\r\n    {\r\n      \"id\": \"agulhas\",\r\n      \"name\": \"Agulhas Current\",\r\n      \"basin\": \"Indian Ocean\",\r\n      \"kind\": \"western boundary current\",\r\n      \"length_km\": null,\r\n      \"length_lower_bound_km\": 1400,\r\n      \"length_bound_basis\": \"OSW conservative meridional floor from the research paper's 27°S–40°S Agulhas Current span: about 1,442 km on WGS84, rounded down to 1,400 km. This is not a measured along-current centerline or an estimate for the Agulhas Return Current.\",\r\n      \"length_scope\": \"The research description spans roughly 27°S–40°S; the coastal path is longer than its north–south separation. Retroflection, leakage, and the eastward Agulhas Return Current are distinct from this boundary-current core. The derived floor is unranked. A 2021 review also describes a roughly 1,000 km coastal segment. That narrower usage conflicts with the broader 27°S–40°S derived floor, so the two numbers are displayed as source-specific scopes and neither is ranked as a common whole-current length.\",\r\n      \"length_source\": \"agulhas_current_extent_reanalysis\",\r\n      \"name_source\": \"noaa_map\",\r\n      \"related_current_ids\": [\r\n        \"agulhas-return\"\r\n      ],\r\n      \"source_reported_length_variants\": [\r\n        {\r\n          \"length_km_approx\": 1000,\r\n          \"scope\": \"Coastal western boundary current along southeastern Africa; narrower than the 27°S–40°S span used for the existing broad lower bound. End gates and centerline are not specified.\",\r\n          \"source\": \"agulhas_coastal_length_review\",\r\n          \"rank_eligible\": false,\r\n          \"source_locator\": \"Section 2.1.1 Background, opening paragraph (1,000 km western boundary current)\"\r\n        }\r\n      ],\r\n      \"length_source_locator\": \"Section The Agulhas Current, opening paragraph (27–40°S); 1,400 km floor is OSW meridional gate geometry\"\r\n    },\r\n    {\r\n      \"id\": \"agulhas-return\",\r\n      \"name\": \"Agulhas Return Current\",\r\n      \"aliases\": [\r\n        \"ARC\"\r\n      ],\r\n      \"basin\": \"South Indian Ocean\",\r\n      \"kind\": \"eastward frontal return current\",\r\n      \"length_km\": null,\r\n      \"length_lower_bound_km\": 3000,\r\n      \"length_bound_basis\": \"OSW conservative WGS84 geodesic floor between published Agulhas Return Current sections near 21°E, 40.5°S and 60°E, 44.5°S: about 3,206 km, rounded down to 3,000 km. An along-flow path with meanders is longer; the source does not report one comparable whole-current length.\",\r\n      \"length_scope\": \"The hydrographic survey distinguishes the Agulhas Return Current from the Agulhas Current and traces its weakening eastward flow toward the Crozet Basin. This derived distance floor is not a measured streamline, whole-current length, or the length of the westward Agulhas Current.\",\r\n      \"length_source\": \"agulhas_return_hydrography\",\r\n      \"name_source\": \"agulhas_return_hydrography\",\r\n      \"nasa_description_source\": \"nasa_po2_western_boundary\",\r\n      \"related_current_ids\": [\r\n        \"agulhas\",\r\n        \"south-indian\"\r\n      ],\r\n      \"related_nasa_object_ids\": [\r\n        \"agulhas-retroflection\"\r\n      ],\r\n      \"length_source_locator\": \"PDF pages 20–22, Figure 14 and Section 6 Conclusions, Agulhas Return Current surveyed eastward from 18°E to 76°E; 3,000 km floor is OSW gate geometry\"\r\n    },\r\n    {\r\n      \"id\": \"east-australian\",\r\n      \"name\": \"East Australian Current\",\r\n      \"basin\": \"South Pacific\",\r\n      \"kind\": \"western boundary current\",\r\n      \"length_km\": null,\r\n      \"length_lower_bound_km\": 1800,\r\n      \"length_bound_basis\": \"OSW conservative meridional floor from source-described coherent jet near 15°S to shelf separation near 32°S: about 1,883 km on WGS84, rounded down to 1,800 km. Actual path may be longer and extensions have different boundaries.\",\r\n      \"length_scope\": \"A derived minimum north–south span for the coherent shelf-break jet only; not a measured streamline or a published whole-current length. Separation and extension shift over time.\",\r\n      \"length_source\": \"east_australian_latitude_span\",\r\n      \"name_source\": \"noaa_map\",\r\n      \"related_current_ids\": [\r\n        \"tasman-front\"\r\n      ],\r\n      \"length_source_locator\": \"Section 1 Introduction, opening EAC paragraph (15–32°S); 1,800 km floor is OSW meridional gate geometry\"\r\n    },\r\n    {\r\n      \"id\": \"tasman-front\",\r\n      \"name\": \"Tasman Front\",\r\n      \"basin\": \"Tasman Sea / South Pacific\",\r\n      \"kind\": \"eastward frontal current downstream of the East Australian Current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The East Australian Current separates eastward as the Tasman Front at a variable latitude, reported between 28°S and 37°S. The cited study does not give stable whole-front endpoints or an along-flow length; do not add this branch to the East Australian Current's coastal floor. A 2019 review found the front rarely distinct in instantaneous fields; a single stable path length would overstate that evidence.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"tasman_front_observations\",\r\n      \"related_current_ids\": [\r\n        \"east-australian\"\r\n      ],\r\n      \"identity_scope_note\": \"A 2019 observational review found the Tasman Front and East Australian Current Extension rarely appear as distinct instantaneous flows; they are clearer in time-mean circulation. Other studies retain the Tasman Front name for the eastward flow. This name is an atlas index, not proof of a continuously identifiable jet.\",\r\n      \"identity_scope_source\": \"east_australian_system_review\"\r\n    },\r\n    {\r\n      \"id\": \"peru-humboldt\",\r\n      \"name\": \"Peru (Humboldt) Current\",\r\n      \"basin\": \"South Pacific\",\r\n      \"kind\": \"eastern boundary current system\",\r\n      \"length_km\": 6000,\r\n      \"length_scope\": \"Approximate 6,000 km Humboldt Current belt from southern Chile toward northern Peru and the Galápagos, reported in an embedded Purca et al. manuscript in Purca Cuicapusa's 2005 thesis. This is a broad eastern South Pacific current-system extent, not a measured core streamline or the Peru Coastal Current alone; the manuscript separately describes its 1,000 km Peru study area.\",\r\n      \"length_source\": \"humboldt_system_extent\",\r\n      \"name_source\": \"noaa_map\",\r\n      \"length_source_locator\": \"PDF page 65, embedded Purca et al. manuscript, Introduction opening paragraph (ca. 6,000 km belt); PDF page 66 distinguishes its 1,000 km Peru study area\"\r\n    },\r\n    {\r\n      \"id\": \"benguela\",\r\n      \"name\": \"Benguela Current\",\r\n      \"basin\": \"South Atlantic\",\r\n      \"kind\": \"eastern boundary current system\",\r\n      \"length_km\": null,\r\n      \"length_lower_bound_km\": 1200,\r\n      \"length_bound_basis\": \"OSW conservative meridional floor between the paper's Benguela Current system sections at 30°S and 19°S: approximately 1,218 km on WGS84, rounded down to 1,200 km. This is a source-gated geographic separation, not a traced flow path.\",\r\n      \"length_scope\": \"The study identifies the Benguela Current system at 30°, 24°, and 19°S across decadal inverse solutions, with no continuity north of 19°S. The current and Benguela ecosystem have different extents. Section observations are from different cruises and do not establish a simultaneous centerline; the derived floor is unranked.\",\r\n      \"length_source\": \"atlantic_decadal_circulation_sections\",\r\n      \"name_source\": \"noaa_map\",\r\n      \"length_source_locator\": \"Section 3.1.3 and Figure 5, Benguela Current system at 30°S, 24°S, and 19°S; OSW WGS84 meridional gate calculation\"\r\n    },\r\n    {\r\n      \"id\": \"canary\",\r\n      \"name\": \"Canary Current\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"kind\": \"eastern boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"A fall 2009 section at 29°N locates a westward extent across the section and separates transport by depth layer. It does not measure the current's along-flow length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_map\",\r\n      \"section_observation\": {\r\n        \"latitude\": 29,\r\n        \"longitude_range\": [\r\n          -22.25,\r\n          -18.5\r\n        ],\r\n        \"observed_period\": \"October–November 2009\",\r\n        \"transport_layers_sv\": [\r\n          {\r\n            \"layer\": \"thermocline\",\r\n            \"value\": 6.2,\r\n            \"uncertainty\": 0.6\r\n          },\r\n          {\r\n            \"layer\": \"intermediate\",\r\n            \"value\": 2.0,\r\n            \"uncertainty\": 0.8\r\n          }\r\n        ],\r\n        \"direction\": \"southward\",\r\n        \"source\": \"portugal_section\",\r\n        \"method_note\": \"Cruise section positions; depth-layer transports estimated with the study's inverse box model.\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"labrador\",\r\n      \"name\": \"Labrador Current\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"kind\": \"subpolar boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"No comparable path-length estimate admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_map\"\r\n    },\r\n    {\r\n      \"id\": \"greenland-middle-atlantic-shelf-hypothesis\",\r\n      \"name\": \"Greenland–Middle Atlantic shelf-current hypothesis\",\r\n      \"basin\": \"Northwest Atlantic shelves\",\r\n      \"kind\": \"proposed buoyancy-driven coastal current system\",\r\n      \"length_km\": null,\r\n      \"hypothesized_length_km\": 5000,\r\n      \"length_scope\": \"A 1989 paper hypothesizes a 5,000 km buoyancy-driven coastal connection from southern Greenland to the Middle Atlantic Bight based on limited oxygen-isotope evidence. This proposed system length is unranked and is not the length of the Labrador Current alone.\",\r\n      \"length_source\": null,\r\n      \"hypothesis_source\": \"greenland_coastal_hypothesis\",\r\n      \"name_source\": \"greenland_coastal_hypothesis\",\r\n      \"related_current_ids\": [\r\n        \"labrador\"\r\n      ],\r\n      \"length_source_locator\": \"Abstract, proposed 5,000 km buoyancy-driven coastal current from southern Greenland to the Middle Atlantic Bight\"\r\n    },\r\n    {\r\n      \"id\": \"brazil\",\r\n      \"name\": \"Brazil Current\",\r\n      \"basin\": \"South Atlantic\",\r\n      \"kind\": \"western boundary current\",\r\n      \"length_km\": null,\r\n      \"length_lower_bound_km\": 1200,\r\n      \"length_bound_basis\": \"OSW conservative meridional floor between the paper's Brazil Current sections at 19°S and 30°S: approximately 1,218 km on WGS84, rounded down to 1,200 km. This is a source-gated geographic separation, not a traced flow path.\",\r\n      \"length_scope\": \"The study identifies southward Brazil Current transport at 19°, 24°, and 30°S. Confluence location and downstream identity vary. Section observations are from different cruises and do not establish a simultaneous centerline; the derived floor is unranked.\",\r\n      \"length_source\": \"atlantic_decadal_circulation_sections\",\r\n      \"name_source\": \"noaa_map\",\r\n      \"length_source_locator\": \"Section 3.1.2 and Figure 5, Brazil Current at 19°S, 24°S, and 30°S; OSW WGS84 meridional gate calculation\"\r\n    },\r\n    {\r\n      \"id\": \"north-atlantic\",\r\n      \"name\": \"North Atlantic Current\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"kind\": \"northeastward current system segment\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"NOAA's glossary defines this as a named Gulf Stream System segment from southeast of the Grand Banks near 40°N, 50°W toward the British Isles. Its downstream branches and whole-current path length are unresolved here.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\",\r\n      \"part_of_system\": \"gulf-stream-system\"\r\n    },\r\n    {\r\n      \"id\": \"deep-western-boundary\",\r\n      \"name\": \"Deep Western Boundary Current\",\r\n      \"basin\": \"North Atlantic segment\",\r\n      \"kind\": \"deep western boundary current\",\r\n      \"length_km\": null,\r\n      \"length_lower_bound_km\": 2400,\r\n      \"length_bound_basis\": \"OSW conservative meridional floor between the paper's deep western boundary current sections at 47°N and 24.5°N: approximately 2,497 km on WGS84, rounded down to 2,400 km. This is a source-gated geographic separation, not a traced deep-current path.\",\r\n      \"length_scope\": \"The study identifies southward deep western boundary flow at 47°, 36°, and 24.5°N in decadal inverse solutions. This is a North Atlantic segment only; sections from different cruises do not establish one simultaneous continuous path or a whole-Atlantic current length. The derived floor is unranked.\",\r\n      \"length_source\": \"atlantic_decadal_circulation_sections\",\r\n      \"name_source\": \"atlantic_dwbc_section\",\r\n      \"length_source_locator\": \"Section 3.2.3 and Figure 8, DWBC at 47°N, 36°N, and 24.5°N; OSW WGS84 meridional gate calculation\"\r\n    },\r\n    {\r\n      \"id\": \"azores\",\r\n      \"name\": \"Azores Current\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"kind\": \"eastward subtropical jet\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The 110 km figure below is width across one 2009 meridional section at 24.5°W, not along-current length or a whole-current extent.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"azores_section\",\r\n      \"section_observation\": {\r\n        \"longitude\": -24.5,\r\n        \"latitude_range\": [\r\n          33.5,\r\n          34.5\r\n        ],\r\n        \"observed_period\": \"October–November 2009\",\r\n        \"meridional_width_km\": 110,\r\n        \"transport_sv\": 13.9,\r\n        \"direction\": \"eastward\",\r\n        \"source\": \"azores_section\",\r\n        \"source_locator\": \"Abstract [1] and Section 4 Discussion and Conclusions [15], October 2009 section at 24.5°W; each current has 110 km meridional width\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"azores-countercurrent\",\r\n      \"name\": \"Azores Countercurrent\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"kind\": \"subsurface westward countercurrent\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The 110 km figure below is width across one 2009 meridional section at 24.5°W, not along-current length or a whole-current extent.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"azores_section\",\r\n      \"section_observation\": {\r\n        \"longitude\": -24.5,\r\n        \"latitude_range\": [\r\n          35.25,\r\n          36.25\r\n        ],\r\n        \"observed_period\": \"October–November 2009\",\r\n        \"meridional_width_km\": 110,\r\n        \"transport_sv\": 5.5,\r\n        \"direction\": \"westward\",\r\n        \"source\": \"azores_section\",\r\n        \"source_locator\": \"Abstract [1] and Section 4 Discussion and Conclusions [15], October 2009 section at 24.5°W; each current has 110 km meridional width\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"portugal\",\r\n      \"name\": \"Portugal Current\",\r\n      \"basin\": \"Northeast Atlantic\",\r\n      \"kind\": \"southward offshore current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The 2009 study identifies one zonal crossing at 37°N; its 13.5–14.8°W longitude band and transport do not establish a whole-current length. Keep the offshore Portugal Current distinct from coastal counterflows.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"portugal_section\",\r\n      \"section_observation\": {\r\n        \"latitude\": 37,\r\n        \"longitude_range\": [\r\n          -14.8,\r\n          -13.5\r\n        ],\r\n        \"observed_period\": \"October–November 2009\",\r\n        \"transport_sv\": 1.8,\r\n        \"transport_uncertainty_sv\": 0.4,\r\n        \"direction\": \"southward\",\r\n        \"source\": \"portugal_section\",\r\n        \"method_note\": \"Cruise section positions; transport estimated with the study's inverse box model.\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"mediterranean-undercurrent\",\r\n      \"name\": \"Mediterranean Undercurrent\",\r\n      \"basin\": \"Gulf of Cádiz / southwest Iberian Atlantic margin\",\r\n      \"kind\": \"intermediate-depth boundary undercurrent\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"RAFOS floats and hydrography track the undercurrent from the Gulf of Cádiz around southwestern Portugal, where a roughly 30 km wide jet weakens and broadens northward. That width is cross-stream, not its length; branching and loss from the slope prevent a single measured endpoint here.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"mediterranean_undercurrent_floats\"\r\n    },\r\n    {\r\n      \"id\": \"east-adriatic\",\r\n      \"name\": \"East Adriatic Current\",\r\n      \"basin\": \"Eastern Adriatic Sea\",\r\n      \"kind\": \"northwestward coastal boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"2002–2003 measurements off the eastern Adriatic coast establish a variable current that strengthened in January–February and again in May. Its Dalmatian coastal reach may overlap the older Dalmatian Current name, but that synonymy is not yet established; no full path length is admitted.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"east_adriatic_measurements\",\r\n      \"possible_name_overlap_mrgid\": 3356\r\n    },\r\n    {\r\n      \"id\": \"black-sea-rim\",\r\n      \"name\": \"Black Sea Rim Current\",\r\n      \"basin\": \"Black Sea\",\r\n      \"kind\": \"cyclonic basin-margin current system\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Copernicus Marine defines this basin-scale cyclonic flow and measures intensity in northern and southern slope sectors. Those sectors are monitoring windows, not a full current centerline or length. Older Caucasus and Southern Current names may describe sectors, but equivalence is unresolved.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"black_sea_rim_indicator\",\r\n      \"possible_name_overlap_mrgids\": [\r\n        3734,\r\n        3736\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"loop\",\r\n      \"name\": \"Loop Current\",\r\n      \"basin\": \"Gulf of Mexico\",\r\n      \"kind\": \"western boundary current segment\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The loop expands and retracts; its path length changes.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_loop\"\r\n    },\r\n    {\r\n      \"id\": \"florida\",\r\n      \"name\": \"Florida Current\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"kind\": \"western boundary current segment\",\r\n      \"length_km\": 1200,\r\n      \"length_scope\": \"Tomczak and Godfrey report approximately 1,200 km from the Florida Straits along the coast to separation near Cape Hatteras. This is the Florida Current segment of the Gulf Stream System, not a whole-system length or a measured reference streamline. NOAA's glossary independently names the same segment; NASA and NOAA Coast Pilot sometimes use Gulf Stream more broadly for the Florida Straits flow.\",\r\n      \"length_source\": \"regional_oceanography_atlantic\",\r\n      \"name_source\": \"noaa_glossary\",\r\n      \"part_of_system\": \"gulf-stream-system\",\r\n      \"length_source_locator\": \"Chapter 14, The Atlantic Ocean, PDF page 11 (printed page 239), paragraph beginning Recirculation of Gulf Stream water (1,200 km downstream to Cape Hatteras)\"\r\n    },\r\n    {\r\n      \"id\": \"north-brazil\",\r\n      \"name\": \"North Brazil Current\",\r\n      \"basin\": \"Tropical Atlantic\",\r\n      \"kind\": \"western boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Retroflection and rings need separate treatment.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_aoml\"\r\n    },\r\n    {\r\n      \"id\": \"alaska\",\r\n      \"name\": \"Alaska Current\",\r\n      \"basin\": \"North Pacific\",\r\n      \"kind\": \"subpolar boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"No comparable path-length estimate admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"aleutian\",\r\n      \"name\": \"Aleutian Current\",\r\n      \"aliases\": [\r\n        \"Pacific Subarctic Current\"\r\n      ],\r\n      \"basin\": \"Subpolar North Pacific\",\r\n      \"kind\": \"eastward subpolar-gyre current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The meteorological glossary identifies this as the southern eastward limb of the North Pacific subpolar gyre, also called the Subarctic Current. Its mixing with the North Pacific Current and variable frontal boundary leave no source-defined whole-current length for this ledger.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"aleutian_current_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"antilles\",\r\n      \"name\": \"Antilles Current\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"kind\": \"regional current with disputed northern surface expression\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"NOAA's six sections near 28°35′N found variable northward and southward bands rather than the broad, persistent northward surface current shown on older charts. This section cannot establish a whole-current path or length and does not resolve flow farther south.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\",\r\n      \"section_review_source\": \"antilles_section\"\r\n    },\r\n    {\r\n      \"id\": \"davidson\",\r\n      \"name\": \"Davidson Current\",\r\n      \"basin\": \"North Pacific\",\r\n      \"kind\": \"seasonal coastal current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"A seasonal countercurrent, not a permanent jet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"east-greenland\",\r\n      \"name\": \"East Greenland Current\",\r\n      \"basin\": \"Arctic / North Atlantic\",\r\n      \"kind\": \"polar boundary current\",\r\n      \"length_km\": null,\r\n      \"length_lower_bound_km\": 2100,\r\n      \"length_bound_basis\": \"OSW conservative meridional floor between the study's Fram Strait section at 78.5°N and Cape Farewell at 59°N: about 2,175 km on WGS84, rounded down to 2,100 km. This is geographic separation across a study region, not a measured along-current centerline or the separate East Greenland Coastal Current length. The older 81°N endpoint was the northern edge of Fram Strait, not the source's current section.\",\r\n      \"length_scope\": \"The study distinguishes the outer East Greenland Current from the coastal branch and assesses the system between the 78.5°N Fram Strait section and Cape Farewell. The coast-following route may be longer than the north–south separation; no comparable whole-current centerline length is admitted, so this regional floor is unranked.\",\r\n      \"length_source\": \"east_greenland_extent\",\r\n      \"name_source\": \"noaa_glossary\",\r\n      \"length_source_locator\": \"Section 2, paragraph defining East Greenland shelf from Fram Strait 78.5°N to Cape Farewell 59°N; 2,100 km floor is OSW meridional gate geometry\"\r\n    },\r\n    {\r\n      \"id\": \"east-greenland-coastal\",\r\n      \"name\": \"East Greenland Coastal Current\",\r\n      \"aliases\": [\r\n        \"EGCC\"\r\n      ],\r\n      \"basin\": \"Southeast Greenland shelf\",\r\n      \"kind\": \"low-salinity inner-shelf coastal jet\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"A summer 2004 hydrographic and velocity survey identified this inner-shelf branch along the approximately 1,000 km southeast Greenland shelf south of Denmark Strait. That is a documented regional reach, not a measured whole-current path or a year-round length; the offshore East Greenland Current is distinct.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"east_greenland_coastal_survey\",\r\n      \"sampled_reach\": {\r\n        \"alongflow_km_approx\": 1000,\r\n        \"region\": \"southeast Greenland shelf south of Denmark Strait\",\r\n        \"source\": \"east_greenland_coastal_survey\",\r\n        \"scope\": \"Published 2004 survey found the current along the entire approximately 1,000 km shelf, with uncertain origin north of Denmark Strait.\",\r\n        \"source_locator\": \"PDF page 36, Conclusions opening paragraph (current along entire 1,000 km southeast Greenland shelf)\"\r\n      },\r\n      \"related_current_ids\": [\r\n        \"east-greenland\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"falkland\",\r\n      \"name\": \"Falkland (Malvinas) Current\",\r\n      \"basin\": \"South Atlantic\",\r\n      \"kind\": \"subpolar boundary current\",\r\n      \"length_km\": 2000,\r\n      \"length_scope\": \"Source-reported approximate 2,000 km northward loop of the northern Antarctic Circumpolar Current branch in the Argentine Basin, from a 2009 EGU conference abstract. No reference centerline, endpoint coordinates, depth-defined length or uncertainty is supplied. Do not interpret this as a measured dated path, a shelf-break front length, or an independently specified Malvinas Return Current extent.\",\r\n      \"length_source\": \"malvinas_egu_2009_length\",\r\n      \"name_source\": \"noaa_glossary\",\r\n      \"length_source_locator\": \"Page 1, opening sentence of EGU2009-12242 abstract (2000 km northward loop)\"\r\n    },\r\n    {\r\n      \"id\": \"guiana\",\r\n      \"name\": \"Guiana Current\",\r\n      \"basin\": \"Tropical Atlantic\",\r\n      \"kind\": \"regional current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"No comparable path-length estimate admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"guinea\",\r\n      \"name\": \"Guinea Current\",\r\n      \"basin\": \"Tropical Atlantic\",\r\n      \"kind\": \"regional current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"No comparable path-length estimate admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"irminger\",\r\n      \"name\": \"Irminger Current\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"kind\": \"subpolar current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"No comparable path-length estimate admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"kuroshio-extension\",\r\n      \"name\": \"Kuroshio Extension\",\r\n      \"basin\": \"North Pacific\",\r\n      \"kind\": \"current extension\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"A named continuation of the Kuroshio; keep separate from its core length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"kuroshio_extension_kess\",\r\n      \"related_current_ids\": [\r\n        \"kuroshio\"\r\n      ],\r\n      \"related_nasa_object_ids\": [\r\n        \"kuroshio-eastward-turn\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"monsoon\",\r\n      \"name\": \"Monsoon Current\",\r\n      \"basin\": \"Indian Ocean\",\r\n      \"kind\": \"seasonal current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Seasonal reversal changes the path and direction.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"indonesian-throughflow\",\r\n      \"name\": \"Indonesian Throughflow\",\r\n      \"aliases\": [\r\n        \"ITF\"\r\n      ],\r\n      \"basin\": \"Maritime Continent / Pacific–Indian Ocean passage\",\r\n      \"kind\": \"interbasin passage system\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"NASA names the Pacific-to-Indian freshwater passage through narrow gaps of the Maritime Continent but gives no single current centerline or whole-system length. This is a multi-channel flow, so no length enters the ranking.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"nasa_po2_western_boundary\",\r\n      \"classification_source\": \"nasa_indonesian_passages\"\r\n    },\r\n    {\r\n      \"id\": \"red-sea-saline-overflow\",\r\n      \"name\": \"Red Sea saline overflow\",\r\n      \"basin\": \"Red Sea / Gulf of Aden\",\r\n      \"kind\": \"dense saline strait overflow\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"NASA identifies a saline overflow contribution from the Red Sea to the western Indian Ocean. The gateway at Bab el Mandeb is not a measured plume endpoint or a whole-flow centerline; the downstream pathway and seasonal strength require separate observations.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"arabian_marginal_outflows\",\r\n      \"nasa_description_source\": \"nasa_po2_western_boundary\"\r\n    },\r\n    {\r\n      \"id\": \"persian-gulf-saline-overflow\",\r\n      \"name\": \"Persian Gulf saline overflow\",\r\n      \"basin\": \"Persian Gulf / Gulf of Oman\",\r\n      \"kind\": \"dense saline strait overflow\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"NASA identifies a saline overflow contribution from the Persian Gulf to the western Indian Ocean. The Strait of Hormuz gateway is not a measured plume endpoint or a whole-flow centerline; dilution and circulation beyond the strait require separate observations.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"arabian_marginal_outflows\",\r\n      \"nasa_description_source\": \"nasa_po2_western_boundary\"\r\n    },\r\n    {\r\n      \"id\": \"north-cape\",\r\n      \"name\": \"North Cape Current\",\r\n      \"basin\": \"Arctic / North Atlantic\",\r\n      \"kind\": \"regional current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"No comparable path-length estimate admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"north-equatorial\",\r\n      \"name\": \"North Equatorial Current\",\r\n      \"basin\": \"Atlantic / Pacific / Indian\",\r\n      \"kind\": \"equatorial current family\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The same name is used in multiple basins; split into basin-specific records before measuring.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"north-pacific\",\r\n      \"name\": \"North Pacific Current\",\r\n      \"basin\": \"North Pacific\",\r\n      \"kind\": \"basin-spanning current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Branches and continuation limits require a declared rule.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"norwegian\",\r\n      \"name\": \"Norwegian Current\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"kind\": \"regional current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"No comparable path-length estimate admitted yet. Published usage of this name overlaps with, or distinguishes it from, the Norwegian Coastal Current; identity remains unresolved here.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\",\r\n      \"identity_review\": {\r\n        \"status\": \"ambiguous_with_norwegian_coastal\",\r\n        \"related_current_id\": \"norwegian-coastal\",\r\n        \"note\": \"Marine Regions records the names separately, but naming conventions conflict; do not sum these as distinct flows without a source-specific definition.\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"norwegian-coastal\",\r\n      \"name\": \"Norwegian Coastal Current\",\r\n      \"basin\": \"North Sea / Norwegian Sea\",\r\n      \"kind\": \"low-salinity coastal current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"A source identifies the current along the Norwegian coast and represents it with stations 1 and 5 nautical miles off Torungen; this is a section location, not a whole-current length. Its relation to the name Norwegian Current is convention-dependent.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"norwegian_coastal_stations\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=2364\",\r\n      \"identity_review\": {\r\n        \"status\": \"ambiguous_with_norwegian\",\r\n        \"related_current_id\": \"norwegian\",\r\n        \"note\": \"The Norwegian Coastal Current is distinct from the Norwegian Atlantic Current in the station study; the broader Norwegian Current label is used inconsistently across sources.\"\r\n      },\r\n      \"section_observation\": {\r\n        \"reference_place\": \"Store Torungen\",\r\n        \"reference_point\": [\r\n          8.79025,\r\n          58.39885\r\n        ],\r\n        \"distance_from_coast_nautical_miles\": [\r\n          1,\r\n          5\r\n        ],\r\n        \"source\": \"norwegian_coastal_stations\",\r\n        \"reference_point_source\": \"torungen_place\",\r\n        \"method_note\": \"Hydrographic coastal stations used to characterize the Norwegian Coastal Current; approximate atlas point is inferred from the Torungen reference, not a published station coordinate.\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"algerian\",\r\n      \"name\": \"Algerian Current\",\r\n      \"basin\": \"Western Mediterranean\",\r\n      \"kind\": \"eastward coastal current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The source describes a coastal current along Algeria that sheds mesoscale eddies; the atlas point is regional and does not define a start, end, or measured centerline.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"algerian_current_study\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=3834\"\r\n    },\r\n    {\r\n      \"id\": \"balearic\",\r\n      \"name\": \"Balearic Current\",\r\n      \"basin\": \"Western Mediterranean\",\r\n      \"kind\": \"island-margin current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The source describes a branch of the Northern Current turning near 40.6°N and contributing to flow in front of Mallorca; no comparable whole-current length is given.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"balearic_current_study\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=30231\"\r\n    },\r\n    {\r\n      \"id\": \"western-adriatic\",\r\n      \"name\": \"Western Adriatic Current\",\r\n      \"basin\": \"Adriatic Sea\",\r\n      \"kind\": \"southeastward coastal current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Drifter evidence identifies a fast, coastally confined southeastward flow along the Italian Adriatic coast; the regional atlas point is not a measured centerline or length endpoint.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"western_adriatic_drifters\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=56789\"\r\n    },\r\n    {\r\n      \"id\": \"baffin\",\r\n      \"name\": \"Baffin Current\",\r\n      \"aliases\": [\r\n        \"Baffin Island Current\"\r\n      ],\r\n      \"basin\": \"Baffin Bay\",\r\n      \"kind\": \"southward polar boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The source identifies Baffin Island Current flow along western Baffin Bay; the atlas point is regional, with no source-defined whole-current centerline or length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"baffin_bay_survey\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=5307\"\r\n    },\r\n    {\r\n      \"id\": \"mauritanian\",\r\n      \"name\": \"Mauritanian Current\",\r\n      \"aliases\": [\r\n        \"Mauritania Current\"\r\n      ],\r\n      \"basin\": \"Northeast tropical Atlantic\",\r\n      \"kind\": \"seasonal poleward eastern-boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The source reports poleward surface flow during the May–July relaxation season in the Mauritanian upwelling region; winter upwelling-season coastal flow is equatorward. A single year-round direction or whole-current length would misrepresent this seasonal regime.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"mauritania_seasonal\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=30081\"\r\n    },\r\n    {\r\n      \"id\": \"gaspe\",\r\n      \"name\": \"Gaspé Current\",\r\n      \"aliases\": [\r\n        \"Gaspe Current\"\r\n      ],\r\n      \"basin\": \"Gulf of St. Lawrence\",\r\n      \"kind\": \"buoyancy-driven coastal jet\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The source places the jet along the Gaspé Peninsula and reports a typical width of about 10–20 km near its strongest reach; width is not along-current length, and no comparable whole-current estimate is admitted.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"gaspe_coastal_jet\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=30052\"\r\n    },\r\n    {\r\n      \"id\": \"northern-mediterranean\",\r\n      \"name\": \"Northern Current\",\r\n      \"aliases\": [\r\n        \"Liguro-Provençal-Catalan Current\"\r\n      ],\r\n      \"alias_source\": \"northern_mediterranean\",\r\n      \"basin\": \"Northwestern Mediterranean\",\r\n      \"kind\": \"coastal boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The named flow is described from the Ligurian Sea along the Provençal and Catalan coasts. The cited paper reports widths and local sections, not a comparable whole-current alongstream length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"northern_mediterranean\"\r\n    },\r\n    {\r\n      \"id\": \"ligurian\",\r\n      \"name\": \"Ligurian Current\",\r\n      \"basin\": \"Northwestern Mediterranean\",\r\n      \"kind\": \"Northern Current segment\",\r\n      \"part_of_current_id\": \"northern-mediterranean\",\r\n      \"part_of_current_source_locator\": \"Section 1 Introduction, paragraph beginning 'The Liguro–Provençal–Catalan Current': Northern Current forms in the Ligurian Sea and continues along the Provençal and Balearic slopes; segment classification is OSW editorial\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The source describes a Northern Current formed in the Ligurian Sea that flows onward along the Provençal and Balearic slopes; the Ligurian name is treated here as its source-region segment, without assigning the whole system's extent to this record.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"northern_mediterranean\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=3357\"\r\n    },\r\n    {\r\n      \"id\": \"oyashio\",\r\n      \"name\": \"Oyashio\",\r\n      \"basin\": \"North Pacific\",\r\n      \"kind\": \"subpolar boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"No comparable path-length estimate admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"somali\",\r\n      \"name\": \"Somali Current\",\r\n      \"basin\": \"Indian Ocean\",\r\n      \"kind\": \"monsoon-reversing current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Seasonal reversal makes a single static length misleading.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"south-equatorial\",\r\n      \"name\": \"South Equatorial Current\",\r\n      \"basin\": \"Atlantic / Pacific / Indian\",\r\n      \"kind\": \"equatorial current family\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The same name is used in multiple basins; split into basin-specific records before measuring.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"spitsbergen-atlantic\",\r\n      \"name\": \"Spitsbergen Atlantic Current\",\r\n      \"basin\": \"Arctic / North Atlantic\",\r\n      \"kind\": \"regional current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"No comparable path-length estimate admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"tsushima\",\r\n      \"name\": \"Tsushima Current\",\r\n      \"basin\": \"Sea of Japan\",\r\n      \"kind\": \"regional current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"A segment of the Kuroshio system in NOAA's glossary.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"west-australian\",\r\n      \"name\": \"West Australian Current\",\r\n      \"basin\": \"Indian Ocean\",\r\n      \"kind\": \"eastern boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"No comparable path-length estimate admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"leeuwin\",\r\n      \"name\": \"Leeuwin Current\",\r\n      \"basin\": \"Indian Ocean\",\r\n      \"kind\": \"poleward eastern boundary current\",\r\n      \"length_km\": null,\r\n      \"length_lower_bound_km\": 2000,\r\n      \"length_scope\": \"Published lower bound for southward flow along Western Australia's continental shelf, from tropical to cool-temperate coasts; distinct from the northward West Australian Current offshore. A lower bound is not a ranked whole-current estimate.\",\r\n      \"length_source\": \"leeuwin_extent\",\r\n      \"length_source_locator\": \"PDF page 108 (viewer page including cover); source states more than 2,000 km\",\r\n      \"name_source\": \"leeuwin_extent\",\r\n      \"part_of_system\": \"australian-west-south-boundary-flow\"\r\n    },\r\n    {\r\n      \"id\": \"australian-west-south-boundary-flow\",\r\n      \"name\": \"Western and southern Australian boundary flow\",\r\n      \"basin\": \"Indian / Southern Ocean margin\",\r\n      \"kind\": \"seasonal coastal current system\",\r\n      \"length_km\": 5500,\r\n      \"length_scope\": \"Continuous austral-winter shelf-edge flow from North West Cape to southern Tasmania, comprising the Leeuwin, South Australian, and Zeehan currents; not the length of Leeuwin alone.\",\r\n      \"length_source\": \"australian_boundary_length\",\r\n      \"name_source\": \"australian_boundary_length\",\r\n      \"component_current_ids\": [\r\n        \"leeuwin\",\r\n        \"south-australian\",\r\n        \"zeehan\"\r\n      ],\r\n      \"length_source_locator\": \"Abstract [1] and Section 9 Discussion and Conclusion [53] (5,500 km winter boundary-flow system)\"\r\n    },\r\n    {\r\n      \"id\": \"south-australian\",\r\n      \"name\": \"South Australian Current\",\r\n      \"basin\": \"South Australian shelf\",\r\n      \"kind\": \"shelf-edge current segment\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Named section from eastern Great Australian Bight to western Bass Strait in the source's winter boundary-flow convention.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"australian_boundary_length\",\r\n      \"part_of_system\": \"australian-west-south-boundary-flow\"\r\n    },\r\n    {\r\n      \"id\": \"zeehan\",\r\n      \"name\": \"Zeehan Current\",\r\n      \"basin\": \"Tasmanian west coast\",\r\n      \"kind\": \"shelf-edge current segment\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Named section off western Tasmania in the source's winter boundary-flow convention.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"australian_boundary_length\",\r\n      \"part_of_system\": \"australian-west-south-boundary-flow\"\r\n    },\r\n    {\r\n      \"id\": \"caribbean\",\r\n      \"name\": \"Caribbean Current\",\r\n      \"basin\": \"Caribbean Sea\",\r\n      \"kind\": \"regional current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"No source-defined whole-current path length admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"caribbean_fisheries_oceanography\",\r\n      \"name_source_locator\": \"Chapter 3, section 3.1.2, PDF page 26; names the Caribbean Current south of the U.S. Caribbean islands.\"\r\n    },\r\n    {\r\n      \"id\": \"equatorial-countercurrent\",\r\n      \"name\": \"Equatorial Countercurrent\",\r\n      \"basin\": \"Atlantic / Pacific / Indian\",\r\n      \"kind\": \"equatorial current family\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Umbrella label for multiple eastward tropical countercurrents. North and South named families and basin-specific flows require separate boundaries and length estimates.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_equatorial\",\r\n      \"component_current_ids\": [\r\n        \"north-equatorial-countercurrent\",\r\n        \"south-equatorial-countercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"north-equatorial-countercurrent\",\r\n      \"name\": \"North Equatorial Countercurrent\",\r\n      \"basin\": \"Atlantic / Pacific\",\r\n      \"kind\": \"eastward tropical countercurrent family\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Atlantic and Pacific upper-ocean currents share a name but have distinct paths and seasonality. The family has no single measured length; this is distinct from the deeper North Equatorial Undercurrent.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"marine_regions\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=5387\",\r\n      \"part_of_system\": \"equatorial-countercurrent\",\r\n      \"component_current_ids\": [\r\n        \"atlantic-north-equatorial-countercurrent\",\r\n        \"pacific-north-equatorial-countercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"atlantic-north-equatorial-countercurrent\",\r\n      \"name\": \"Atlantic North Equatorial Countercurrent\",\r\n      \"basin\": \"Tropical Atlantic\",\r\n      \"kind\": \"eastward upper-ocean countercurrent\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Observed cores near 6.5°N and 8°N at 38°W in the 1998–2006 survey record, with marked seasonal variability. These cross-sections do not determine an along-current length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"atlantic_necc_observations\",\r\n      \"part_of_system\": \"north-equatorial-countercurrent\"\r\n    },\r\n    {\r\n      \"id\": \"pacific-north-equatorial-countercurrent\",\r\n      \"name\": \"Pacific North Equatorial Countercurrent\",\r\n      \"basin\": \"Tropical Pacific\",\r\n      \"kind\": \"eastward upper-ocean countercurrent\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Repeated Pacific velocity sections identify a near-surface eastward core around 7°N at 140°W. The section locates the current but gives no comparable along-current length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"pacific_necc_sections\",\r\n      \"part_of_system\": \"north-equatorial-countercurrent\"\r\n    },\r\n    {\r\n      \"id\": \"south-equatorial-countercurrent\",\r\n      \"name\": \"South Equatorial Countercurrent\",\r\n      \"basin\": \"Atlantic / Pacific / Indian\",\r\n      \"kind\": \"eastward tropical countercurrent family\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Separate Atlantic, Pacific, and Indian eastward tropical flows share this name. Their seasonal expression and geographic limits differ; no cross-basin family length can be ranked.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"marine_regions\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=5389\",\r\n      \"part_of_system\": \"equatorial-countercurrent\",\r\n      \"component_current_ids\": [\r\n        \"atlantic-south-equatorial-countercurrent\",\r\n        \"pacific-south-equatorial-countercurrent\",\r\n        \"indian-south-equatorial-countercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"atlantic-south-equatorial-countercurrent\",\r\n      \"name\": \"Atlantic South Equatorial Countercurrent\",\r\n      \"basin\": \"Tropical South Atlantic\",\r\n      \"kind\": \"eastward upper-ocean countercurrent\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Ship observations place a weak eastward flow in the 7–9°S belt near 30°W in some seasons, with westward flow in spring 1994. The western survey limit and intermittency prevent a defensible whole-current length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"atlantic_secc_survey\",\r\n      \"part_of_system\": \"south-equatorial-countercurrent\"\r\n    },\r\n    {\r\n      \"id\": \"pacific-south-equatorial-countercurrent\",\r\n      \"name\": \"Pacific South Equatorial Countercurrent\",\r\n      \"basin\": \"Tropical South Pacific\",\r\n      \"kind\": \"seasonally varying eastward countercurrent\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Argo-based analysis reports a boreal-spring band near 5–13°S from 150°E to 170°W, with seasonal changes in zonal reach and depth. That observed seasonal envelope is not a traced alongstream length and is unranked.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"pacific_secc_argo\",\r\n      \"part_of_system\": \"south-equatorial-countercurrent\"\r\n    },\r\n    {\r\n      \"id\": \"indian-south-equatorial-countercurrent\",\r\n      \"name\": \"Indian Ocean South Equatorial Countercurrent\",\r\n      \"basin\": \"Tropical South Indian Ocean\",\r\n      \"kind\": \"eastward tropical countercurrent\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Repeated XBT shipping-line sections identify this flow, including a western line near 55°E with a variable trough around 5–10°S. Section transports and latitude bands are not an along-current length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"indian_secc_xbt\",\r\n      \"part_of_system\": \"south-equatorial-countercurrent\"\r\n    },\r\n    {\r\n      \"id\": \"equatorial-undercurrent\",\r\n      \"name\": \"Equatorial Undercurrent\",\r\n      \"basin\": \"Atlantic / Pacific / Indian\",\r\n      \"kind\": \"subsurface equatorial current family\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"A shared subsurface name across three basins. The Indian Ocean expression is weaker and seasonal; component currents require separate boundaries and length estimates.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_equatorial\",\r\n      \"component_current_ids\": [\r\n        \"pacific-equatorial-undercurrent\",\r\n        \"atlantic-equatorial-undercurrent\",\r\n        \"indian-equatorial-undercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"pacific-equatorial-undercurrent\",\r\n      \"name\": \"Pacific Equatorial Undercurrent\",\r\n      \"aliases\": [\r\n        \"Cromwell Current\"\r\n      ],\r\n      \"basin\": \"Equatorial Pacific\",\r\n      \"kind\": \"eastward subsurface jet\",\r\n      \"length_km\": 14000,\r\n      \"length_scope\": \"Approximate basin-wide eastward pathway from north of Papua New Guinea to the South American coast described in Grenier et al. (2011). The source's 14,000 km is a broad path estimate, not a traced instantaneous core or the length of the Atlantic or Indian Equatorial Undercurrent. A 0°N, 140°W mooring locates the current independently.\",\r\n      \"length_source\": \"pacific_euc_pathway\",\r\n      \"name_source\": \"pacific_euc_mooring\",\r\n      \"source_reported_length_variants\": [\r\n        {\r\n          \"length_km_approx\": 13000,\r\n          \"scope\": \"A later wave–current dynamics paper describes the Pacific EUC as traversing the equatorial Pacific over about 13,000 km. It does not define the same exact core or gates as Grenier et al.; retained as a source-specific whole-basin approximation rather than an independent rank.\",\r\n          \"source\": \"pacific_euc_alternate_extent\",\r\n          \"rank_eligible\": false,\r\n          \"source_locator\": \"Introduction, opening Equatorial Undercurrent description, entire Pacific equatorial length about 13,000 km\"\r\n        }\r\n      ],\r\n      \"part_of_system\": \"equatorial-undercurrent\",\r\n      \"length_source_locator\": \"Section 1 Introduction, paragraph [2] (14,000 km pathway)\"\r\n    },\r\n    {\r\n      \"id\": \"atlantic-equatorial-undercurrent\",\r\n      \"name\": \"Atlantic Equatorial Undercurrent\",\r\n      \"aliases\": [\r\n        \"Lomonosov Current\",\r\n        \"Lomonoscov Current\"\r\n      ],\r\n      \"basin\": \"Equatorial Atlantic\",\r\n      \"kind\": \"eastward subsurface jet\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"A PIRATA ADCP observed the current at 0°N, 23°W in 2002; the station is not a whole-current length. Lomonosov is an established alternate name; Marine Regions spells it Lomonoscov.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"atlantic_euc_mooring\",\r\n      \"alias_source\": \"lomonosov_alias\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=30077\",\r\n      \"part_of_system\": \"equatorial-undercurrent\"\r\n    },\r\n    {\r\n      \"id\": \"indian-equatorial-undercurrent\",\r\n      \"name\": \"Indian Ocean Equatorial Undercurrent\",\r\n      \"basin\": \"Equatorial Indian Ocean\",\r\n      \"kind\": \"seasonal eastward subsurface jet\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Observed across a 2°S–2°N section at 90°E on 1–3 March 2017; the reported ~13.5 Sv is section transport, not path length. A later review describes the Indian expression as weaker and seasonally varying; one campaign does not establish a permanent path.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"indian_euc_survey\",\r\n      \"seasonality_source\": \"indian_euc_review\",\r\n      \"part_of_system\": \"equatorial-undercurrent\",\r\n      \"survey_section\": {\r\n        \"longitude\": 90,\r\n        \"latitude_range\": [\r\n          -2,\r\n          2\r\n        ],\r\n        \"period\": \"2017-03-01/2017-03-03\",\r\n        \"transport_sv_approx\": 13.5,\r\n        \"direction\": \"eastward\",\r\n        \"source\": \"indian_euc_survey\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"north-equatorial-undercurrent\",\r\n      \"name\": \"North Equatorial Undercurrent\",\r\n      \"basin\": \"Atlantic / Pacific\",\r\n      \"kind\": \"off-equatorial subsurface current family\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The same name is used for separately observed Atlantic and Pacific subsurface flows with different latitude and depth settings. Do not rank a cross-basin family length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"marine_regions\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=5388\",\r\n      \"component_current_ids\": [\r\n        \"atlantic-north-equatorial-undercurrent\",\r\n        \"pacific-north-equatorial-undercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"atlantic-north-equatorial-undercurrent\",\r\n      \"name\": \"Atlantic North Equatorial Undercurrent\",\r\n      \"basin\": \"Tropical Atlantic\",\r\n      \"kind\": \"eastward subsurface jet\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Direct observations near 5°N, 23°W cover a 65–270 m subsurface layer; variability is dominated by intraseasonal events, and the mooring does not determine basin-wide length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"atlantic_neuc_mooring\",\r\n      \"part_of_system\": \"north-equatorial-undercurrent\"\r\n    },\r\n    {\r\n      \"id\": \"pacific-north-equatorial-undercurrent\",\r\n      \"name\": \"Pacific North Equatorial Undercurrent\",\r\n      \"basin\": \"Western tropical Pacific\",\r\n      \"kind\": \"intermittent subsurface jets\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The 130°E mooring array measures eastward subsurface jets between 8.5°N and 17.5°N, with 5.1 Sv mean positive transport to 900 m under the study definition. This cross-section is not a path length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"pacific_neuc_array\",\r\n      \"part_of_system\": \"north-equatorial-undercurrent\",\r\n      \"survey_section\": {\r\n        \"longitude\": 130,\r\n        \"latitude_range\": [\r\n          8.5,\r\n          17.5\r\n        ],\r\n        \"period\": \"2014–2021 mooring mean\",\r\n        \"transport_sv_approx\": 5.1,\r\n        \"direction\": \"eastward\",\r\n        \"source\": \"pacific_neuc_array\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"south-equatorial-undercurrent\",\r\n      \"name\": \"South Equatorial Undercurrent\",\r\n      \"basin\": \"Atlantic / Indian\",\r\n      \"kind\": \"off-equatorial subsurface current family\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The same name appears in separate Atlantic and Indian observations, with different vertical reach and seasonality; a family has no single measured length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"marine_regions\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=5391\",\r\n      \"component_current_ids\": [\r\n        \"atlantic-south-equatorial-undercurrent\",\r\n        \"indian-south-equatorial-undercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"atlantic-south-equatorial-undercurrent\",\r\n      \"name\": \"Atlantic South Equatorial Undercurrent\",\r\n      \"basin\": \"Tropical Atlantic\",\r\n      \"kind\": \"eastward subsurface jet\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The 35°W section identifies eastward flow between 2.5°S and 4°S at 200–500 m, with 2.8 Sv mean transport under the study definition. Section transport is not whole-current length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"atlantic_seuc_section\",\r\n      \"part_of_system\": \"south-equatorial-undercurrent\",\r\n      \"survey_section\": {\r\n        \"longitude\": -35,\r\n        \"latitude_range\": [\r\n          -4,\r\n          -2.5\r\n        ],\r\n        \"period\": \"multi-cruise mean reported 2003\",\r\n        \"transport_sv_approx\": 2.8,\r\n        \"direction\": \"eastward\",\r\n        \"source\": \"atlantic_seuc_section\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"indian-south-equatorial-undercurrent\",\r\n      \"name\": \"Indian Ocean South Equatorial Undercurrent\",\r\n      \"basin\": \"South Indian Ocean\",\r\n      \"kind\": \"seasonal deep-penetrating eastward jet\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"A 10°S, 87°E mooring and reanalysis identify a subsurface eastward jet beneath the westward South Equatorial Current; its deep reach and seasonality differ from the Atlantic flow. No comparable whole-current length is admitted.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"indian_seuc_mooring\",\r\n      \"part_of_system\": \"south-equatorial-undercurrent\"\r\n    },\r\n    {\r\n      \"id\": \"south-atlantic\",\r\n      \"name\": \"South Atlantic Current\",\r\n      \"basin\": \"South Atlantic\",\r\n      \"kind\": \"basin-spanning current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Named basin-spanning flow in the cited study; no source-defined whole-current path length admitted yet. Cartographic crossings remain separately pending review.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"south_atlantic_float_study\",\r\n      \"name_source_locator\": \"Section 3.5, journal page 380 (PDF page 27); describes the South Atlantic Current as the subtropical gyre's southern limb.\"\r\n    },\r\n    {\r\n      \"id\": \"south-indian\",\r\n      \"name\": \"South Indian Current\",\r\n      \"basin\": \"South Indian Ocean\",\r\n      \"kind\": \"basin-spanning current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Eastward subtropical-gyre flow near 40 degrees S in the cited study; no source-defined whole-current path length admitted. Do not conflate with the Agulhas Return Current or offshore West Australian Current. Cartographic crossings remain separately pending review.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"south_indian_geotraces_study\",\r\n      \"name_source_locator\": \"Section 3.2, paragraph beginning 'The subtropical gyre of the South Indian Ocean'; identifies the eastward South Indian Current near 40 degrees S.\"\r\n    },\r\n    {\r\n      \"id\": \"south-pacific\",\r\n      \"name\": \"South Pacific Current\",\r\n      \"basin\": \"South Pacific\",\r\n      \"kind\": \"basin-spanning current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Named eastward current associated with the South Pacific subtropical front; map arrows do not measure its full length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"south_pacific_paper\"\r\n    },\r\n    {\r\n      \"id\": \"west-greenland\",\r\n      \"name\": \"West Greenland Current\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"kind\": \"regional current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"No comparable path-length estimate admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"noaa_glossary\"\r\n    },\r\n    {\r\n      \"id\": \"west-spitsbergen\",\r\n      \"name\": \"West Spitsbergen Current\",\r\n      \"basin\": \"Arctic / Norwegian Sea\",\r\n      \"kind\": \"polar margin current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Marine Regions supplies one geographic point, not a centerline or endpoints; no comparable path-length estimate admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"marine_regions\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=33646\",\r\n      \"source_mrgid\": 33646\r\n    },\r\n    {\r\n      \"id\": \"jutland\",\r\n      \"name\": \"Jutland Current\",\r\n      \"basin\": \"North Sea / Skagerrak\",\r\n      \"kind\": \"coastal current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Marine Regions supplies one geographic point, not a current boundary or endpoints; no comparable path-length estimate admitted yet.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"marine_regions\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=33647\",\r\n      \"source_mrgid\": 33647\r\n    },\r\n    {\r\n      \"id\": \"mindanao-current\",\r\n      \"name\": \"Mindanao Current\",\r\n      \"basin\": \"Western tropical North Pacific\",\r\n      \"kind\": \"southward low-latitude western boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The source describes flow southward along the Philippine Islands and supply to the Indonesian Throughflow, North Equatorial Countercurrent, and Pacific Equatorial Undercurrent. It gives no whole-current alongflow length or fixed endpoint gates.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"western_pacific_euc_pathways\",\r\n      \"related_nasa_object_ids\": [\r\n        \"indonesian-throughflow\"\r\n      ],\r\n      \"related_current_ids\": [\r\n        \"indonesian-throughflow\",\r\n        \"pacific-north-equatorial-countercurrent\",\r\n        \"pacific-equatorial-undercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"new-guinea-coastal-undercurrent\",\r\n      \"name\": \"New Guinea Coastal Undercurrent\",\r\n      \"basin\": \"Southwestern tropical Pacific / Solomon Sea\",\r\n      \"kind\": \"northwestward subsurface western boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The source describes northwestward flow along Papua New Guinea and through Vitiaz Strait into the Pacific Equatorial Undercurrent source region. It gives no comparable whole-current centerline length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"western_pacific_euc_pathways\",\r\n      \"related_current_ids\": [\r\n        \"pacific-equatorial-undercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"new-ireland-coastal-undercurrent\",\r\n      \"name\": \"New Ireland Coastal Undercurrent\",\r\n      \"basin\": \"Southwestern tropical Pacific / Solomon Sea\",\r\n      \"kind\": \"subsurface island boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The source describes flow along New Ireland's eastern coast, with branches joining the New Guinea Coastal Undercurrent or retroflecting toward the Pacific Equatorial Undercurrent. It gives no whole-current length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"western_pacific_euc_pathways\",\r\n      \"related_current_ids\": [\r\n        \"new-guinea-coastal-undercurrent\",\r\n        \"pacific-equatorial-undercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"solomon-island-coastal-undercurrent\",\r\n      \"name\": \"Solomon Island Coastal Undercurrent\",\r\n      \"basin\": \"Southwestern tropical Pacific / Solomon Islands\",\r\n      \"kind\": \"proposed subsurface island boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The source schematically names this equatorward flow along the Solomon Islands and says it may feed the New Ireland Coastal Undercurrent. Its continuity and whole-current length are unresolved.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"western_pacific_euc_pathways\",\r\n      \"related_current_ids\": [\r\n        \"new-ireland-coastal-undercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"new-guinea-coastal-current\",\r\n      \"name\": \"New Guinea Coastal Current\",\r\n      \"basin\": \"Southwestern tropical Pacific / north New Guinea coast\",\r\n      \"kind\": \"seasonally reversing surface western boundary current\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"Three years of moorings distinguish this upper-100 m current from the deeper New Guinea Coastal Undercurrent: it flows southeastward in boreal winter and northwestward in boreal summer. The observations do not define a whole-current alongflow length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"new_guinea_coastal_moorings\",\r\n      \"related_current_ids\": [\r\n        \"new-guinea-coastal-undercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"pacific-north-subsurface-countercurrent\",\r\n      \"name\": \"Pacific North Subsurface Countercurrent\",\r\n      \"basin\": \"Equatorial North Pacific\",\r\n      \"kind\": \"eastward subsurface jet north of the Equatorial Undercurrent\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"A Pacific section at 140°W locates this eastward jet near 4°N and 200 m; the section does not determine its complete alongflow route or length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"pacific_subsurface_countercurrent_sections\",\r\n      \"related_current_ids\": [\r\n        \"pacific-equatorial-undercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"pacific-south-subsurface-countercurrent\",\r\n      \"name\": \"Pacific South Subsurface Countercurrent\",\r\n      \"basin\": \"Equatorial South Pacific\",\r\n      \"kind\": \"eastward subsurface jets south of the Equatorial Undercurrent\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The Pacific 140°W section resolves two south-side branches near 4.5°S at 200 m and 7°S at 250 m. These section positions do not supply a whole-current path length or a single branch-averaged centerline.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"pacific_subsurface_countercurrent_sections\",\r\n      \"related_current_ids\": [\r\n        \"pacific-equatorial-undercurrent\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"hiri-current\",\r\n      \"name\": \"Hiri Current\",\r\n      \"basin\": \"Coral Sea / Gulf of Papua\",\r\n      \"kind\": \"northward western boundary branch and Gulf of Papua circulation\",\r\n      \"length_km\": null,\r\n      \"length_scope\": \"The literature uses Hiri Current for the northward branch after South Equatorial Current bifurcation off northeast Australia, with variable continuation around the Gulf of Papua. No one fixed path or endpoint pair is admitted for a whole-current length.\",\r\n      \"length_source\": null,\r\n      \"name_source\": \"hiri_current_scope\",\r\n      \"related_current_ids\": [\r\n        \"east-australian\",\r\n        \"south-equatorial\"\r\n      ],\r\n      \"identity_scope_note\": \"Some sources distinguish a northward North Queensland Current and an eastward Hiri Current, while others use Hiri Current or Hiri Gyre for the wider Gulf of Papua circulation. This ledger keeps the name with unresolved precise boundaries.\",\r\n      \"identity_scope_source\": \"hiri_current_scope\"\r\n    },\r\n    {\r\n      \"id\": \"alaska-coastal-gulf\",\r\n      \"name\": \"Alaska Coastal Current (Gulf of Alaska)\",\r\n      \"basin\": \"North Pacific / Gulf of Alaska and eastern Aleutians\",\r\n      \"kind\": \"source-defined coastal current system\",\r\n      \"length_km\": 1700,\r\n      \"length_scope\": \"Stabeno et al. (2016) report an approximate 1,700 km coastal system between Seward and Samalga Pass. This is the northern Gulf of Alaska/eastern Aleutian scope, separate from the offshore Alaska Current and Alaskan Stream. It does not cover every coastal flow sharing the Alaska Coastal Current name, including Arctic usage. The paper integrates intermittent observations from 1984-2014; this extent is not a measured simultaneous reference streamline or dated footprint.\",\r\n      \"length_source\": \"alaska_coastal_gulf_extent\",\r\n      \"name_source\": \"alaska_coastal_gulf_extent\",\r\n      \"name_source_locator\": \"Accepted manuscript, PDF page 2, Abstract, lines 25-28; PDF page 3, Introduction, lines 42-59 distinguishes coastal flow from the offshore Alaska Gyre currents and broader coastal usage.\",\r\n      \"length_source_locator\": \"Accepted manuscript, PDF page 2, Abstract, lines 25-28 (~1700 km, Seward to Samalga Pass); PDF page 3, Introduction, lines 51-59 defines the regional continuity scope.\",\r\n      \"aliases\": [\r\n        \"Alaska Coastal Current\"\r\n      ],\r\n      \"alias_source\": \"alaska_coastal_gulf_extent\",\r\n      \"identity_scope_note\": \"Preferred OSW label adds Gulf of Alaska to the paper name. This source-defined system is distinct from Alaska Current, Alaskan Stream, and Arctic coastal naming conventions; the ACC abbreviation is not an alias because it also names Antarctic Circumpolar Current.\",\r\n      \"identity_scope_source\": \"alaska_coastal_gulf_extent\"\r\n    },\r\n    {\r\n      \"id\": \"antarctic-slope\",\r\n      \"name\": \"Antarctic Slope Current\",\r\n      \"basin\": \"Antarctic continental margin\",\r\n      \"kind\": \"source-defined slope current system\",\r\n      \"length_km\": 21000,\r\n      \"length_scope\": \"Review-reported upper-continental-slope system span; not a measured reference streamline or dated footprint. The Antarctic Peninsula interrupts circumpolar continuity.\",\r\n      \"length_source\": \"antarctic_slope_review\",\r\n      \"name_source\": \"antarctic_slope_review\",\r\n      \"name_source_locator\": \"Title; section 1.1 ASC Characteristics\",\r\n      \"length_source_locator\": \"Section 1.1 ASC Characteristics, first sentence; Figure 2 caption and following paragraph qualify continuity\",\r\n      \"identity_scope_note\": \"Distinct from Antarctic Coastal Current and Antarctic Circumpolar Current; near-circumpolar system interrupted by Antarctic Peninsula. ASC is a source abbreviation, not a global alias.\",\r\n      \"identity_scope_source\": \"antarctic_slope_review\"\r\n    }\r\n  ]\r\n}\r\n"},{"file":"research/ocean-motion-taxonomy.json","sha256":"c0e81210393e8feb5c104ab1bd26434bee2fc1ed4de585c6af10003f7acf1877","source_json":"{\r\n  \"schema\": \"osw.almanac.motion-taxonomy.v1\",\r\n  \"status\": \"OSW editorial crosswalk; not an official oceanographic standard\",\r\n  \"parent_registry\": \"ocean-object-classification.csv\",\r\n  \"nasa_motion_forms\": \"research/nasa-perpetual-ocean-motion-forms.json\",\r\n  \"scope\": \"Facets for named motion records. Object type, identity level, geographic setting, time behavior, and evidence are separate axes; a name alone does not establish a measured boundary or live track.\",\r\n  \"sources\": {\r\n    \"cmecs\": \"https://iocm.noaa.gov/cmecs/documents/CMECS-Classifiers-20140619.pdf\",\r\n    \"noaa_currents\": \"https://oceanservice.noaa.gov/education/tutorial_currents/\",\r\n    \"meta4\": \"https://essd.copernicus.org/articles/18/7043/2026/\",\r\n    \"nasa\": \"https://svs.gsfc.nasa.gov/5425\"\r\n  },\r\n  \"axes\": {\r\n    \"object_type\": {\r\n      \"current\": \"Organized advective flow; crosswalk OBJ017.\",\r\n      \"boundary_current\": \"Current following an ocean basin margin; crosswalk OBJ019.\",\r\n      \"eddy\": \"Rotating, finite-lived flow structure; crosswalk OBJ021.\",\r\n      \"ring\": \"Eddy detached from a parent current; crosswalk OBJ022.\"\r\n    },\r\n    \"motion_form\": {\r\n      \"definition\": \"Primary physical form of an identified NASA record, separate from NASA naming support and from the identity level of any individual feature.\",\r\n      \"vocabulary\": \"research/nasa-perpetual-ocean-motion-forms.json\",\r\n      \"applies_to\": \"All records in research/nasa-perpetual-ocean-objects.json\"\r\n    },\r\n    \"identity_level\": {\r\n      \"family\": \"Shared name used for related flows in more than one basin; split before measuring.\",\r\n      \"system\": \"A named circulation system that can contain branches or segments.\",\r\n      \"current\": \"One named current with a source-dependent upstream and downstream extent.\",\r\n      \"segment\": \"Named part or continuation of a larger current system.\",\r\n      \"eddy_family\": \"A named class of related eddies, such as Agulhas Rings; individual members need separate dated identities.\",\r\n      \"recurrent_eddy_region\": \"A geographic name reused for eddies forming or persisting in a region; not one dated individual or trajectory.\",\r\n      \"individual_eddy\": \"A particular named eddy, separate from its type, region, and trajectory ID.\",\r\n      \"dated_detection\": \"A feature designated by one provider in one dated receipt; no historical-name equivalence, formation time, lifetime, or continuity across dates is established.\"\r\n    },\r\n    \"setting\": {\r\n      \"western_boundary\": \"Along the western edge of an ocean basin.\",\r\n      \"eastern_boundary\": \"Along the eastern edge of an ocean basin.\",\r\n      \"polar_or_subpolar_margin\": \"High-latitude margin; boundary side needs case-specific evidence.\",\r\n      \"coastal_or_shelf\": \"Coastal or shelf-following flow without a claimed basin-boundary class.\",\r\n      \"equatorial\": \"Equatorial or tropical zonal flow; basin-specific records may be needed.\",\r\n      \"circumpolar\": \"Circulation that passes around Antarctica.\",\r\n      \"basin_interior_or_extension\": \"Open-ocean pathway or named downstream continuation.\",\r\n      \"regional\": \"Named regional flow whose finer setting has not been established here.\",\r\n      \"gulf_of_mexico\": \"Regional locator for named Loop Current rings; not an eddy centroid.\"\r\n    },\r\n    \"time_behavior\": {\r\n      \"persistent_variable\": \"Recognizable over years, with a shifting path and strength.\",\r\n      \"seasonal\": \"Strongly seasonal expression.\",\r\n      \"seasonally_reversing\": \"Direction changes with the seasonal circulation.\",\r\n      \"transient\": \"A finite-lived individual event.\",\r\n      \"recurrent\": \"A named regional eddy form appears repeatedly or quasi-persistently; individual generations need dated IDs.\",\r\n      \"unresolved\": \"The naming source does not establish a temporal class.\"\r\n    },\r\n    \"vertical_setting\": {\r\n      \"surface_expression\": \"A named flow with a documented surface expression; its core may extend below the surface.\",\r\n      \"subsurface_core\": \"A named flow whose defining core is below the surface; a geographic movie tile alone does not verify it visually.\",\r\n      \"deep_flow\": \"A named flow primarily at deep or bottom depths; surface views are not evidence for its position.\",\r\n      \"unresolved\": \"The source does not establish a depth setting.\"\r\n    },\r\n    \"polarity\": {\r\n      \"cyclonic\": \"Rotation in the local cyclonic sense; requires detection or source evidence.\",\r\n      \"anticyclonic\": \"Rotation in the local anticyclonic sense; requires detection or source evidence.\",\r\n      \"unresolved\": \"Not inferred from a name, map symbol, or core temperature.\"\r\n    },\r\n    \"core_thermal_sign\": {\r\n      \"warm\": \"Warmer core relative to nearby water, in a specified observation product.\",\r\n      \"cold\": \"Colder core relative to nearby water, in a specified observation product.\",\r\n      \"unresolved\": \"Polarity and temperature are independent claims.\"\r\n    },\r\n    \"location_evidence\": {\r\n      \"editorial_locator\": \"Approximate place to find the named flow on an atlas; no boundary or centroid claim.\",\r\n      \"source_region_only\": \"Source supports the region, not a position for the individual eddy.\",\r\n      \"observed_track\": \"Dated positions from a named observation or tracking product.\"\r\n    }\r\n  },\r\n  \"admission_rules\": [\r\n    \"Keep official source terms and OSW editorial labels distinguishable.\",\r\n    \"Every individual eddy needs a naming source; a track ID needs its own product and identifier.\",\r\n    \"Do not infer eddy polarity, core temperature, footprint, or live status from a name.\",\r\n    \"Do not use a locator point to calculate a current length or claim an eddy position.\",\r\n    \"A video showing particles is not a feature boundary or a global name register.\"\r\n  ],\r\n  \"source_scoped_regime_vocabularies\": [\r\n    {\r\n      \"id\": \"classification_vocabulary:thompson-2018-antarctic-shelf-regimes\",\r\n      \"entity_id\": \"current:antarctic-slope\",\r\n      \"label\": \"Antarctic shelf/slope hydrographic regimes (Thompson et al., 2018)\",\r\n      \"source_url\": \"https://doi.org/10.1029/2018RG000624\",\r\n      \"source_locator\": \"Section 2 introductory classification paragraphs; sections 2.1-2.3\",\r\n      \"scope\": \"Regional shelf/slope hydrographic regimes in this review, not a whole-current permanent class or global eddy taxonomy\",\r\n      \"terms\": [\r\n        {\r\n          \"id\": \"fresh_shelf\",\r\n          \"source_label\": \"Fresh Shelf\",\r\n          \"criterion_summary\": \"Layers with neutral density gamma_n greater than 28.0 (source-reported kg/m3 scale) do not extend onto the shelf.\"\r\n        },\r\n        {\r\n          \"id\": \"dense_shelf\",\r\n          \"source_label\": \"Dense Shelf\",\r\n          \"criterion_summary\": \"Water with neutral density gamma_n greater than 28.0 (source-reported kg/m3 scale) occupies the shelf, which stays relatively cold with convection and dense-water formation.\"\r\n        },\r\n        {\r\n          \"id\": \"warm_shelf\",\r\n          \"source_label\": \"Warm Shelf\",\r\n          \"criterion_summary\": \"Water with neutral density gamma_n greater than 28.0 reaches the shelf without dense-water formation; shelf water exceeds 0.5 degrees Celsius at some shelf depth.\"\r\n        }\r\n      ],\r\n      \"assignment_status\": \"vocabulary_only_no_osw_state_assignments\",\r\n      \"assignments\": [],\r\n      \"density_variable_note\": \"Thresholds refer to the source's neutral-density variable gamma_n in its conventional reported units, not an absolute seawater mass density of 28 kg/m3.\",\r\n      \"assignment_requirements\": [\r\n        \"Source-supported regional/time/depth support\",\r\n        \"Compatible hydrographic fields\",\r\n        \"Explicit unknown or mixed regime where support is insufficient\"\r\n      ],\r\n      \"not_equivalent_to\": [\r\n        \"eddy_core_thermal_sign\",\r\n        \"surface_temperature_only\",\r\n        \"permanent_state_property\"\r\n      ],\r\n      \"method\": \"OSW paraphrase of the cited source classification; criteria describe regional hydrographic support, not observed assignments or automatic surface-image classification\"\r\n    }\r\n  ]\r\n}\r\n"}]},"azores_2009_section_review_v1":{"logical_parent_sha256":"233c156bf1e044e7378d5bb739633da59eadb28125d40fc3254dd503e2bc1a32","input_sha256":{"research/azores-2009-section-original-review-v1.json":"41562d76736613929e6e8eff83e5903621e8b6526c8fd38c4507fa1c9b027593","research/azores-2009-section-record-bindings-v1.json":"7687e8b60c8b57871438e40182a6762f4b3810a4058f2ca18430d16cebc72af9","research/azores-2009-section-card-visual-review-v1.json":"994597ce9524c2e1603ef585d186ff16e270010a88bb2899c85baf498374a746","figures/azores-2009-section-card-v1.svg":"11716551311a52961d070f0acd92df97eed266ff2730989d3a03203af74d0107"},"measurement_records_added":0,"measurement_records_changed":0},"azores_2009_section_source_index_v1":{"original_sources_verified":624,"original_source_strings_preserved":624,"replaced_source_paths":[],"added_source_paths":["research/azores-2009-section-card-visual-review-v1.json","research/azores-2009-section-original-review-v1.json","research/azores-2009-section-record-bindings-v1.json"],"scientific_source_documents_replaced":0},"published_current_speed_statistics_v1":{"logical_parent_sha256":"9d35ca1c8cebee0f48e49dd66bb83321b506fa43260f1dd5db4b1e06102293da","source_file":"research/eacc-pemba-semba-2019-seasonal-speed-v1.json","source_file_sha256":"95c569347f5941d218e3f6ff8baeea05dfc06f49c956fee030ee2b6f4a055d78","records_added":15,"length_or_width_records_added":0},"published_current_speed_source_index_v1":{"original_sources_verified":627,"original_source_strings_preserved":627,"replaced_source_paths":[],"added_source_paths":["research/eacc-pemba-semba-2019-s
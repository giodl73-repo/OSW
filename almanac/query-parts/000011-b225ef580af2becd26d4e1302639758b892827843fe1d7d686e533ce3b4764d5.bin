on\": \"July 1987, TEW287 A87: approximately 50 km author-reported decay scale. A decay scale describes how rapidly the cross-section velocity decreases; it is not a full edge-to-edge width.\",\r\n        \"display_method_note\": \"Historical Hiri/Coral Sea NGCU source convention; northern modern NGCU is not assigned this value. July 1987 and July 1990 are different years and reaches, not seasonal extrema. Width depth support and paired boundaries unresolved.\",\r\n        \"quality_note\": \"Primary thesis inspected. Cross-section e-folding scalar has no supplied numeric error or reconstructed edges. Historical source naming and reference velocity require scope-specific interpretation.\",\r\n        \"audit_file\": \"research/hiri-hughes-1993-local-decay-scales-scope-audit.json\",\r\n        \"audit_sha256\": \"a4db684cf25734a0519e902115cd9197e1c6f41e0d0097c4a0e7073dc0698084\",\r\n        \"audit_pointer\": \"/measurements/0\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"hiri-hughes-1993-1990-07-local-decay-scale\",\r\n      \"current_id\": \"hiri-current\",\r\n      \"name\": \"Hiri Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"width_metric\": \"author_reported_e_folding_scale\",\r\n      \"width_metric_label\": \"local e-folding scale\",\r\n      \"approximate_width_km\": 75,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"dated_local_point_descriptor_not_temporal_range\",\r\n      \"range_interpretation\": \"Author-reported local descriptor. No statistical error, full-current inference or annual range supplied.\",\r\n      \"geographic_scope\": \"Eastern B90 transect across the Coral Sea between southern Papua and Queensland Plateau; detached current core context about 160 km offshore.\",\r\n      \"layer\": \"Thermal-wind cross-section context; no numerical fixed-depth width layer. Transport integration to 1500 dbar does not define the width support.\",\r\n      \"time_convention\": \"July 1990 cruise occupation; exact day unresolved. Different reaches and years are not a recurring seasonal series.\",\r\n      \"boundary_rule\": \"Author e-folding scaling width; lateral fit, reference velocity and paired velocity edges not independently reconstructed. No theoretical full-width multiplier.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Author cross-section descriptor; no independent perpendicular correction or paired edge extraction.\",\r\n      \"source_url\": \"https://researchonline.jcu.edu.au/46216/1/46216-hughes-1993-thesis.pdf\",\r\n      \"source_citation\": \"Hughes, R.D. (1993), An Investigation of the Coral Sea with an Ocean General Circulation Model, PhD thesis, James Cook University of North Queensland, December 1993.\",\r\n      \"source_locator\": \"Printed p73 / PDF89; Figure 3.18 printed p75 / PDF91; July 1990 cruise map printed p74 / PDF90.\",\r\n      \"source_retrieved_date\": \"2026-10-13\",\r\n      \"source_evidence_kind\": \"primary_thesis_author_reported_local_geostrophic_decay_scale\",\r\n      \"extraction_method\": \"Numerical prose descriptor transcribed from reviewed original. Source figures inspected for context only; no curve or velocity boundaries digitized.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"July 1990 Fr0690 B90 e-folding scale\",\r\n      \"observed_month\": \"1990-07\",\r\n      \"time_precision\": \"month\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Primary thesis inspected. Cross-
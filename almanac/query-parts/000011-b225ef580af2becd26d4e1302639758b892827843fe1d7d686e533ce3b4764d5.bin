2686090deea7764749eca886698f\",\n        \"sources\": \"fc499f8708a71982e37552a03408341daeae9bce690af22335d5fd8aadbcac63\",\n        \"time_evidence\": \"8d86da8229951992c802d517eaeaeeb84a4b5f1a3e916ecd7944f448135387bd\",\n        \"pacific_secc_western_reference\": \"de110b943b30e095c0ff37a17859c4eb3f665aae90e6e89ff9fa91da71cc989e\"\n      },\n      \"latest_observation_date\": null,\n      \"claim_review_counts\": {\n        \"not_individually_reviewed\": 56\n      },\n      \"linked_source_count\": 7,\n      \"map_features\": [\n        {\n          \"coordinate_reference_system\": \"OGC:CRS84\",\n          \"geometry\": {\n            \"coordinates\": [\n              165,\n              -9\n            ],\n            \"type\": \"Point\"\n          },\n          \"geometry_id\": \"geometry:0099\",\n          \"note\": \"Representative point inside Argo-observed boreal-spring 150°E–170°W, 5–13°S envelope; not a path endpoint.\",\n          \"positional_uncertainty\": \"not quantified; no observed current core or path\",\n          \"role\": \"editorial_locator\",\n          \"source_id\": \"source:4dc5fc618c26565f\"\n        },\n        {\n          \"geometry\": {\n            \"type\": \"LineString\",\n            \"coordinates\": [\n              [\n                164,\n                -9\n              ],\n              [\n                168,\n                -9\n              ],\n              [\n                172,\n                -9.5\n              ],\n              [\n                176,\n                -9.5\n              ],\n              [\n                180,\n                -9.5\n              ]\n            ]\n          },\n          \"role\": \"editorial_reference_route\",\n          \"candidate_id\": \"pacific-south-equatorial-countercurrent-western-mean-reference-reach-v1\",\n          \"note\": \"Western mean-circulation reference reach between OSW offshore gates164E and180E. Gates and bends are editorial, not physical origin/termination or source-extracted axis points. Excludes upstream island branches, eastern seasonal extensions, SEC return, STCC and subsurface equatorial jets. No whole-current length.\",\n          \"source_url\": \"https://www.soest.hawaii.edu/oceanography/bo/CQ04.pdf\",\n          \"source_locator\": \"Paragraph2 on PDF page1 and Figure1b/caption on PDF page2: western SECC context and mean0-200m geostrophy relative to1500dbar. Selected page2 pixels actually reviewed on2026-10-27.\",\n          \"source_file_sha256\": \"a8bb517551f04dbe1018a6d5a51817cee4c3e3afaf2d82447bccdab03cef1d85\",\n          \"observation_date\": null,\n          \"layer\": \"Source context: mean0-200m relative zonal geostrophy, referenced to1500dbar. The selected path is not a fixed-depth, absolute-current or observed velocity-core axis.\",\n          \"time_convention\": \"WOA01 mean-field context only. Publication2004 is not an observation date. No dated trajectory or seasonal route reconstructed.\",\n          \"physical_current_axis_admitted\": false,\n          \"physical_state_join_eligible\": false,\n          \"source_id\": \"source:chen-qiu-secc-seasonal-2004\"\n        }\n      ],\n      \"state_evidence\": [],\n      \"connections\": [],\n      \"scope_notes\": [\n        {\n          \"current_id\": \"pacific-south-equatorial-countercurrent\",\n          \"label\": \"Argo seasonal envelope and dateline scope\",\n          \"audit_file\": \"research/pacific-secc-argo-seasonal-extent-scope-audit.json\",\n          \"summary\": \"Source preview reports a spring envelope from 150 E to 170 W and an autumn extension to 140 W. These dateline-crossing spans are not traced current lengths. Spring latitude limits are not paired current edges; full methods, averaging years and calendar months remain unresolved.\",\n          \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2025JC023053?af=R\",\n          \"source_locator\": \"Publisher abstract, Plain Language Summary and Data Availability Statement.\",\n          \"observed_period\": null\n        },\n        {\n          \"current_id\": \"pacific-south-equatorial-countercurrent\",\n          \"label\": \"WOA01 mean flow and seasonal anomaly separation\",\n          \"audit_file\": \"research/pacific-secc-woa01-anomaly-scope-audit.json\",\n          \"summary\": \"Full 2004 paper distinguishes surface and 0-200 m WOA01 geostrophy relative to 1500 dbar, modeled Sverdrup flow, and band-passed seasonal anomaly sections at 170 E. Anomaly zero contours and averaging windows cannot define current widths or endpoints. Numerical compatible flow fields remain needed.\",\n          \"source_url\": \"https://www.soest.hawaii.edu/oceanography/bo/CQ04.pdf\",\n          \"source_locator\": \"Figures 1, 2 and 8; paragraphs 2-3, 20 and 26.\",\n          \"observed_period\": null\n        }\n      ],\n      \"evidence_links\": [\n        {\n          \"label\": \"Pacific SECC western reference and measurement scope\",\n          \"url\": \"pacific-secc-reference-support.html\"\n        }\n      ],\n      \"object_url\": \"object.html?id=current%3Apacific-south-equatorial-countercurrent\",\n      \"route_url\": \"reference-routes.html?atlas-layout=map&atlas-feature=current%3Apacific-south-equatorial-countercurrent&atlas-route=pacific-south-equatorial-countercurrent-western-mean-reference-reach-v1#route-atlas\",\n      \"season_url\": \"seasons.html?current=pacific-south-equatorial-countercurrent\",\n      \"dashboard_search\": \"Pacific South Equatorial Countercurrent Tropical South Pacific\",\n      \"width_ids\": [\n        \"pacific-secc-rotschi-1972-170e-width-range\"\n      ],\n      \"measurement_ids\": [],\n      \"route_ids\": [\n        \"pacific-south-equatorial-countercurrent-western-mean-reference-reach-v1\"\n      ],\n      \"source_ids\": [\n        \"source:4dc5fc618c26565f\",\n        \"source:4f7441b953be4651\",\n        \"source:803229fe82eb2360\",\n        \"source:b038491b0e5a3967\",\n  
inition\",\n          \"observed_period\": null,\n          \"supporting_sources\": [\n            {\n              \"url\": \"https://www.pmel.noaa.gov/pubs/outstand/stab1878/stab1878.shtml\",\n              \"label\": \"Bering Sea circulation and separate North Slope identity\",\n              \"locator\": \"Mean Upper Ocean Circulation subsections.\",\n              \"access\": \"Relevant HTML sections/captions read; figures and fields not digitized.\"\n            },\n            {\n              \"url\": \"https://eprints.lib.hokudai.ac.jp/repo/huscap/all/70589/naturecommunications9_1190.pdf\",\n              \"label\": \"Western Subarctic front and Isoguchi jets\",\n              \"locator\": \"Introduction, first Results subsection, Figure 1 caption; Methods Data.\",\n              \"access\": \"Relevant repository PDF text read; gradient front and search window are not velocity boundaries.\"\n            }\n          ],\n          \"related_proposed_current_ids\": [\n            \"alaskan-stream\",\n            \"aleutian-north-slope\"\n          ],\n          \"related_proposed_currents\": [\n            {\n              \"id\": \"alaskan-stream\",\n              \"name\": \"Alaskan Stream\"\n            },\n            {\n              \"id\": \"aleutian-north-slope\",\n              \"name\": \"Aleutian North Slope Current\"\n            }\n          ]\n        }\n      ],\n      \"evidence_links\": [\n        {\n          \"label\": \"Inspect Aleutian published width greater than400km\",\n          \"url\": \"../figures/aleutian-onishi-2001-width-constraint.svg\"\n        },\n        {\n          \"label\": \"Query Aleutian source width constraint\",\n          \"url\": \"query.html?q=%7B%22collection%22%3A%22diagnostics%22%2C%22filters%22%3A%5B%7B%22field%22%3A%22id%22%2C%22op%22%3A%22eq%22%2C%22value%22%3A%22diagnostic%3Aaleutian-onishi-2001-width-constraint%22%7D%5D%2C%22limit%22%3A1%7D#query-chart-section\"\n        },\n        {\n          \"label\"
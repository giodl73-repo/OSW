80,\r\n        \"source_beta_plane_sla_filter_fwhm_km\": 340,\r\n        \"preprocessing_scales_are_current_widths\": false,\r\n        \"figure3_variability_envelope_transferred\": false,\r\n        \"paired_velocity_boundaries_extracted\": false,\r\n        \"paired_sst_boundaries_extracted\": false,\r\n        \"width_descriptor_applies_to_every_winter_month\": false,\r\n        \"source_figures_digitized_for_this_descriptor\": false,\r\n        \"summer_50km_core_shift_is_width_change\": false,\r\n        \"core_offshore_distance_is_width\": false,\r\n        \"ngcuc_width_transferred\": false,\r\n        \"width_range_is_annual\": false,\r\n        \"source_cruise_season_label_conflict\": \"Section 2.2 pairs trade winds with Dec-Feb and northwest monsoon with Jun-Sep, opposite sections 1/5 narrative. These cruise labels are not used to date the width descriptors.\",\r\n        \"display_title\": \"Western cold-water vein / separate thermal metric\",\r\n        \"display_aria_label\": \"Western cold-water vein / separate thermal metric: 100–150 km, author trade-wind surface cold-water vein. This thermal metric is separate from current-anomaly width. No midpoint, annual extrema, mapped edges or numerical uncertainty supplied.\",\r\n        \"display_caption\": \"Western cold-water vein / separate thermal metric: 100–150 km. Trade-wind / austral-winter description, illustrated by August seasonal fields. Thermal water-mass span following the current core; separate from the velocity-anomaly vein.\",\r\n        \"display_method_note\": \"2001–2010 seasonal climatology context; exact width dates, paired edges and uncertainty unresolved. Current descriptors share one source claim and overlap geographically; the near-200 km western maxima are a subset of the 100–200 km western span. Figure 3 variability-envelope widths, 80/340 km SLA smoothing, core displacement and offshore core position remain distinct metrics. No seasonal width animation inferred.\",\r\n        \"quality_note\": \"Complete unchanged HAL deposit inspected. Author regional numbers retained with their metrics and seasonal context; paired boundaries and numeric errors not recovered.\",\r\n        \"source_pdf_sha256\": \"6da50667b80790752fa0189ff9cf0cdfd88c521509b0f393365de306286bacbe\",\r\n        \"protocol_file\": \"plans/ngcc-seasonal-vein-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"e39b24d49fea763f129e82e9c76dbaa6f2e23b6d5485ffb6e4008ee5b4038d73\",\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"full_width_conversion_admitted\": false,\r\n        \"audit_file\": \"research/ngcc-radenac-2016-seasonal-vein-width-scope-audit.json\",\r\n        \"audit_sha256\": \"223405cce3aa4a5fecdf94dd25ebff225a9594f33fb04f784a469fd4e6e8ce10\",\r\n        \"audit_pointer\": \"/measurements/3\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"azores-carracedo-2014-spring-core-width\",\r\n      \"phase_label\": \"WOA09 spring climatology (April-June)\",\r\n      \"source_season_label\": \"spring\",\r\n      \"calendar_months\": [\r\n        4,\r\n        5,\r\n        6\r\n      ],\r\n      \"approximate_width_km\": 240,\r\n      \"source_reported_maximum_core_depth_m\": 790,\r\n      \"width_range_km\": null,\r\n      \"measurement_uncertainty_interval_km\": null,\r\n      \"is_confidence_interval\": false,\r\n      \"current_id\": \"azores\",\r\n      \"name\": \"Azores Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_seasonal_summary\",\r\n      \"width_metric\": \"author_reported_inverse_model_velocity_threshold_core_span\",\r\n      \"phase_kind\": \"seasonal_summary\",\r\n      \"range_interpretation\": \"Approximate source-reported seasonal core value; no width uncertainty interval supplied.\",\r\n      \"geographic_scope\": \"Western WOA-Box section at 19.5 W. A regional cross-current model core extent, with no paired edge coordinates extracted.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Meridional western WOA-Box section; no exact flow-normal correction inferred.\",\r\n      \"layer\": \"Depth-varying inverse-model section. Source reports maximum core depth about 790 m in spring and 1100 m in autumn; these are source-reported vertical context, not fixed depth layers at which these widths were measured.\",\r\n      \"time_convention\": \"WOA09 mixed historical climatologies in a regional inverse model; source quarter WOA09 spring climatology (April-June). Not an individual occupation or dated current footprint.\",\r\n      \"boundary_rule\": \"Author defines the core using velocities greater than 2 cm/s. No full-current envelope or universal half-peak threshold inferred.\",\r\n      \"source_url\": \"https://nora.nerc.ac.uk/id/eprint/521101/1/1-s2.0-S0079661113002437-main.pdf\",\r\n      \"source_citation\": \"Carracedo, Gilcoto, Mercier and Perez (2014), Seasonal dynamics in the Azores-Gibraltar Strait region: A climatologically-based study, Progress in Oceanography 122, 116-130, doi:10.1016/j.pocean.2013.12.005.\",\r\n      \"source_locator\": \"Section 3.1.1.1, printed page 122 / PDF page 7; methods section 2.1, printed page 118 / PDF page 3.\",\r\n      \"source_retrieved_date\": \"2026-10-14\",\r\n      \"source_evidence_kind\": \"published_inverse_model_climatological_core_summary\",\r\n      \"extraction_method\": \"Author-reported values transcribed from original prose; no contour digitization or model reproduction.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"observed_period\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"remaining_gates\": [\r\n        \"Recover original model fields and paired boundaries before geometry or scientific reproduction.\",\r\n        \"Width error and whole-current dimensions remain unknown.\",\r\n        \"Independent scientific and canonical admission.\"\r\n      ],\r\n      \"calendar_source_locator\": \"World Ocean Atlas 2009 Volume 1, Introduction, printed page 1 / PDF page 13\",\r\n      \"calendar_source_url\": \"https://www.ncei.noaa.gov/sites/default/files/2020-04/woa09_vol1_text.pdf\",\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"azores_seasonal_model_core\",\r\n        \"audit_pointer\": \"/measurements/0\",\r\n        \"display_aria_label\": \"WOA09 spring climatology (April-June): about 240 km regional model core span; width error unknown.\",\r\n        \"display_caption\": \"WOA09 spring climatology (April-June) · about 240 km in the regional inverse-model core at 19.5 W. Model-climatological seasonal extremes are about 240–400 km; whole-current annual physical range and width uncertainty remain unknown.\",\r\n        \"display_method_note\": \"Source criterion: velocities greater than 2 cm/s. WOA09 input grid is 1 degree; finer integration is not improved observational resolution. Historical climatologies have mixed support. Depth varies; no fixed-layer width, monthly interpolation or mapped band inferred.\",\r\n        \"model_support\": {\r\n          \"hydrographic_product\": \"World Ocean Atlas 2009\",\r\n          \"native_horizontal_grid_degrees\": 1,\r\n          \"standard_depth_levels\": 33,\r\n          \"temperature_salinity_climatology_periods\": [\r\n            [\r\n              1955,\r\n              1964\r\n            ],\r\n            [\r\n              1965,\r\n              1974\r\n            ],\r\n            [\r\n              1975,\r\n              1984\r\n            ],\r\n            [\r\n              1985,\r\n              1994\r\n            ],\r\n            [\r\n              1995,\r\n              2006\r\n            ]\r\n          ],\r\n          \"temperature_salinity_decadal_climatologies_averaged\": true,\r\n          \"oxygen_nutrients_use_all_available_years\": true,\r\n          \"source_transport_integration_grid\": {\r\n            \"pressure_spacing_dbar\": 1,\r\n            \"latitude_spacing_degrees\": 0.01\r\n          },\r\n          \"integration_grid_is_native_observation_resolution\": false,\r\n          \"one_uniform_observation_period_assigned\": false,\r\n          \"publication_year_is_width_occupation\": false\r\n        },\r\n        \"season_convention\": {\r\n          \"basis\": \"WOA09 quarter definitions, not meteorological month windows\",\r\n          \"source_url\": \"https://www.ncei.noaa.gov/sites/default/files/2020-04/woa09_vol1_text.pdf\",\r\n          \"source_locator\": \"World Ocean Atlas 2009 Volume 1, Introduction, printed page 1 / PDF page 13\",\r\n          \"source_document_file\": \"research/source-data/woa09-season-definition/journal-article.pdf\",\r\n          \"source_document_bytes\": 349881,\r\n          \"source_document_sha256\": \"8f5046eeea5e4bb405f60dc526baf46143cc4ca1a2724f21203d9777277034da\",\r\n          \"source_access\": \"Original Introduction text read and page visually inspected.\",\r\n          \"source_retrieved_date\": \"2026-10-14\",\r\n          \"winter_months\": [\r\n            1,\r\n            2,\r\n            3\r\n          ],\r\n          \"spring_months\": [\r\n            4,\r\n            5,\r\n            6\r\n          ],\r\n          \"summer_months\": [\r\n            7,\r\n            8,\r\n            9\r\n          ],\r\n          \"autumn_months\": [\r\n            10,\r\n            11,\r\n            12\r\n          ]\r\n        },\r\n        \"reported_model_core_seasonal_extrema\": {\r\n          \"approximate_minimum_km\": 240,\r\n          \"minimum_source_season\": \"spring\",\r\n          \"approximate_maximum_km\": 400,\r\n          \"maximum_source_season\": \"autumn\",\r\n          \"range_kind\": \"author_reported_regional_climatological_core_seaso
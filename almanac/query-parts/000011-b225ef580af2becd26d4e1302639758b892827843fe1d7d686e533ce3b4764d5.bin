lse,\r\n        \"salinity_maximum_is_unambiguous_origin_boundary\": false,\r\n        \"recirculation_excluded\": false,\r\n        \"model_display_depth_is_width_layer\": false,\r\n        \"map_buffer_eligible\": false,\r\n        \"cross_current_width_inheritance_eligible\": false,\r\n        \"seasonal_calendar_extracted\": false,\r\n        \"campaign_context\": {\r\n          \"observation_period\": [\r\n            \"2016-07-01\",\r\n            \"2016-07-20\"\r\n          ],\r\n          \"section_averaging_period\": [\r\n            \"2016-07-05\",\r\n            \"2016-07-15\"\r\n          ],\r\n          \"section_latitude_degrees_north\": 8,\r\n          \"role\": \"Campaign and section-analysis context, not repeated width observation dates.\"\r\n        },\r\n        \"comparison_context\": {\r\n          \"other_quantity_km\": 300,\r\n          \"previous_transport_scaling_assumptions_km\": [\r\n            100,\r\n            200\r\n          ],\r\n          \"transport_uncertainty_sv\": 4,\r\n          \"nemo_figure4_display_depth_m\": 110,\r\n          \"prior_study_widths_independently_reviewed\": false\r\n        },\r\n        \"display_title\": \"Conditional Arabian Sea origin component\",\r\n        \"display_aria_label\": \"Monsoon Current: approximately 150 kilometres, Conditional Arabian Sea origin component. July 2016 southern Bay of Bengal study. Distinct from the other component, not a pooled width range, annual extrema or an occupied current footprint. Numerical uncertainty and paired edges unresolved.\",\r\n        \"display_caption\": \"Approximately 150 km · Conditional Arabian Sea origin component. Conditional salinity-maximum origin proxy; some water still recirculates. Separate feature definitions; no 150–300 km range. Numerical uncertainty unknown.\",\r\n        \"display_method_note\": \"Conditional author interpretation: assume subsurface salinity maximum identifies Arabian Sea origin. No clear boundary separates continuous and recirculating flow; some origin-proxy water still recirculates. July 2016 study context; no extracted monthly width series. Earlier 100–200 km scaling assumptions, ±4 Sv transport uncertainty and the 110 m NEMO display depth do not establish width support or error.\",\r\n        \"audit_file\": \"research/monsoon-webber-2018-distinct-widths-scope-audit.json\",\r\n        \"audit_sha256\": \"01add615729f0ebf28ac9632cf4f76b85d9a0d2e67af33cee9088e52018192c4\",\r\n        \"audit_pointer\": \"/measurements/1\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"tasman-front-nilsson-1980-meander-occupied-band\",\r\n      \"current_id\": \"tasman-front\",\r\n      \"name\": \"Tasman Front\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_meander_occupied_band_breadth\",\r\n      \"approximate_width_km\": 600,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"approximate_regional_point_no_reported_interval\",\r\n      \"range_interpretation\": \"One approximate author description for this feature definition. Not a range endpoint, annual extrema or confidence interval.\",\r\n      \"geographic_scope\": \"Zonal band in the Tasman Sea containing a meandering front extending from Australia to New Zealand; band center described as near 33 or 34 S.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Meridional breadth of a zonal occupied band; no exact paired cross-band edges extracted.\",\r\n      \"layer\": \"Regional dynamic-height and thermal-structure synthesis; no fixed numerical layer assigned to the band breadth.\",\r\n      \"time_convention\": \"Historical report synthesis using surveys and earlier sections; not a dated repeated-width series or annual climatology.\",\r\n      \"boundary_rule\": \"Author-reported approximate breadth of the band occupied by a meandering front and associated eddies; not boundaries of one jet.\",\r\n      \"source_url\": \"https://ntrs.nasa.gov/api/citations/19800022345/downloads/19800022345.pdf\",\r\n      \"source_citation\": \"Nilsson, Andrews, Lawrence, Ball and Latham (1980), Heat Capacity Mapping Mission Project HCM-051: Progress Report to 30 April 1980, RAN Research Laboratory Internal Technical Memorandum 3/80; NASA NTRS 19800022345.\",\r\n      \"source_locator\": \"Original PDF p27 / printed p23, section 3.9; p26 / printed p22 provides separate maximum-scale context.\",\r\n      \"source_retrieved_date\": \"2026-10-09\",\r\n      \"source_evidence_kind\": \"original_technical_report_regional_synthesis\",\r\n      \"extraction_method\": \"Factual numerical prose extraction from visually inspected original report; no map or boundary digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Meander and eddy occupied band\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Microfiche reproduction of an interim technical report. Width passage visually verified. No individual jet width, exact boundary criterion or dated width sequence established.\",\r\n      \"remaining_gates\": [\r\n        \"Obtain paired observed edges and a declared band/jet definition, layer and averaging rule.\",\r\n        \"Acquire comparable repeated observations before annual or seasonal margins.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"tasman_meander_occupied_band\",\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_methods_reviewed\": true,\r\n        \"full_study_reproduced\": false,\r\n        \"temporal_operator\": \"historical_report_regional_synthesis\",\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"map_buffer_eligible\": false,\r\n        \"cross_current_width_inheritance_eligible\": false,\r\n        \"seasonal_calendar_extracted\": false,\r\n        \"individual_jet_width_eligible\": false,\r\n        \"thermal_transition_is_occupied_band\": false,\r\n        \"maximum_scale_is_uncertainty_interval\": false,\r\n        \"band_center_latitude_context_degrees_south\": [\r\n          33,\r\n          34\r\n        ],\r\n        \"comparison_context\": {\r\n          \"maximum_scale_context_km\": [\r\n            600,\r\n            700\r\n          ],\r\n          \"surface_thermal_transition_km\": 30,\r\n          \"thermocline_thermal_transition_upper_limit_km\": 120,\r\n          \"older_postulated_zonal_flow_km\": 500,\r\n          \"role\": \"Distinct scales and supports, not band interval endpoints or annual extremes.\"\r\n        },\r\n        \"display_title\": \"Meander and eddy occupied band\",\r\n        \"display_aria_label\": \"Tasman Front: approximately 600 kilometres for the zonal band occupied by the meandering front and associated eddies. Historical regional synthesis, not individual jet width, thermal transition thickness, dated boundaries or annual extrema. Numerical uncertainty unknown.\",\r\n        \"display_caption\": \"Approximately 600 km · band occupied by the meandering front and associated eddies. Individual jet and thermal-front widths differ. No annual range or mapped footprint; numerical uncertainty unknown.\",\r\n        \"display_method_note\": \"Original 1980 report discussion describes a band centered near 33 or 34 S. The 600 or 700 km maximum-scale discussion is not an uncertainty interval. Separate surface and thermocline transition widths are not this band. No exact edges, fixed measurement layer or repeated width series extracted.\",\r\n        \"audit_file\": \"research/tasman-front-nilsson-1980-meander-band-scope-audit.json\",\r\n        \"audit_sha256\": \"6205515eaa753b22b115dfebc5900b6e507bb4401644683ca14cf74c2ab838e6\",\r\n        \"audit_pointer\": \"/measurements/0\"\r\n      },\r\n      \"width_metric_label\": \"Meander and eddy occupied zonal band, not individual jet width\"\r\n    },\r\n    {\r\n      \"id\": \"antarctic-coastal-schubert-2021-section-01\",\r\n      \"current_id\": \"antarctic-coastal\",\r\n      \"name\": \"Antarctic Coastal Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_composite_threshold_section_width\",\r\n      \"width_metric\": \"coast_to_fractional_integrated_velocity_edge\",\r\n      \"approximate_width_km\": 28.4,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"source_reported_composite_point_no_width_error\",\r\n      \"range_interpretation\": \"One published composite cross-shelf extent; differences among sections are spatial, not annual extrema or confidence limits.\",\r\n      \"geographic_scope\": \"Source section 1: West Antarctic Peninsula continental shelf.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Source composite cross-shelf transect; no geographic paired edges transcribed.\",\r\n      \"layer\": \"Geostrophic velocity referenced to 400 m; depth integral from surface to the variable 34.4 psu isohaline, not a fixed 0-400 m layer.\",\r\n      \"time_convention\": \"Historical composite of disjoint seal-profile sampling periods and both seasons; no exact section width dates or monthly width curve extracted.\",\r\n      \"boundary_rule\": \"Coastline or ice-shelf face to the offshore location where depth-integrated velocity is 15% of its value at the current center, identified by maximum gradient of net transport.\",\r\n      \"source_url\": \"https://doi.org/10.5194/tc-15-4179-20
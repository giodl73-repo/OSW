   \"ledger_kind\": \"eastward upper-ocean countercurrent\",\r\n      \"route_strategy_id\": \"expand_section_evidence\",\r\n      \"route_strategy_label\": \"Extend evidence beyond sections\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"Repeated Pacific velocity sections identify a near-surface eastward core around 7°N at 140°W. The section locates the current but gives no comparable along-current length.\",\r\n      \"next_action\": \"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.\",\r\n      \"strategy_next_action\": \"Find sourced upstream/downstream gates and continuity between sections; preserve widths and section transports as different measurements.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"pacific-north-equatorial-undercurrent\",\r\n      \"name\": \"Pacific North Equatorial Undercurrent\",\r\n      \"existing_length_evidence_status\": \"section_only\",\r\n      \"existing_scope\": \"The 130°E mooring array measures eastward subsurface jets between 8.5°N and 17.5°N, with 5.1 Sv mean positive transport to 900 m under the study definition. This cross-section is not a path length.\",\r\n      \"name_source_url\": \"https://www.frontiersin.org/journals/marine-science/articles/10.3389/fmars.2022.979442/full\",\r\n      \"candidate_ids\": [\r\n        \"pacific-neuc-middle-reach-reference-path-candidate\",\r\n        \"pacific-neuc-northern-reach-reference-path-candidate\",\r\n        \"pacific-neuc-southern-reach-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"intermittent subsurface jets\",\
d_degrees":[-11,-8],"role":"regional_context_not_paired_velocity_edges","source_locator":"Paragraph 2"},"observed_period":null,"remaining_gates":["Acquire compatible numerical mean/monthly velocity fields and resolve their reference state, averaging periods and uncertainty.","Recover longitudinal connected velocity-core support and source-defined gates before tracing a route; do not bridge separated positive components.","Use paired total-flow boundaries for local width extraction; anomaly zero crossings remain inadmissible as current-width edges.","Keep 2004 relative-geostrophic support separate from the 2026 Argo absolute-geostrophic envelopes and ENSO composites.","Independent scientific boundary, identity and canonical admission review."],"schema":"osw.current-source-scope-audit.v1","scope":"Keep mean relative geostrophy, modeled flow and seasonal anomaly sections distinct before route or width extraction.","seasonal_route_playback_supported":false,"source_access":"University-hosted full PDF acquired; relevant text and rendered Figures 1 and 8 inspected. No numerical field or contour trace extracted. The newer Wu et al. (2026) methods were not acquired through the inspected publisher paths.","source_citation":"Chen and Qiu (2004), Seasonal variability of the South Equatorial Countercurrent, JGR 109 C08003, doi:10.1029/2003JC002243.","source_locator":"Paragraphs 2-3, 20, 26 and 34; Figures 1, 2, 5 and 8 captions; PDF pages 1-3, 6, 8-9 and 11.","source_pdf_bytes":946060,"source_pdf_file":"research/source-data/pacific-secc-chen-qiu-2004.pdf","source_pdf_pages":12,"source_pdf_sha256":"3c194db5c94961aafc89d4e33011384cdedabaf2d9551941c1a659fd959c3643","source_retrieved_date":"2026-10-04","source_url":"https://www.soest.hawaii.edu/oceanography/bo/CQ04.pdf","status":"editorial_source_scope_not_scientific_approval","whole_current_length_km":null,"whole_current_width_km":null},"note":{"audit_file":"research/pacific-secc-woa01-anomaly-scope-audit.json","current_id":"pacific-south-equatorial-countercurrent","label":"WOA01 mean flow and seasonal anomaly separation","observed_period":null,"source_locator":"Figures 1, 2 and 8; paragraphs 2-3, 20 and 26.","source_url":"https://www.soest.hawaii.edu/oceanography/bo/CQ04.pdf","summary":"Full 2004 paper distinguishes surface and 0-200 m WOA01 geostrophy relative to 1500 dbar, modeled Sverdrup flow, and band-passed seasonal anomaly sections at 170 E. Anomaly zero contours and averaging windows cannot define current widths or endpoints. Numerical compatible flow fields remain needed."},"source_sha256":"0a98a08b0191c3450c9e5b4146299c411e724b9ffd6a267cbf548587a5d10051"}],"source_catalog_file":"research/ocean-current-reference-path-candidates.json","source_catalog_sha256":"b06caed27655c39f8127ddda441cba0a856800f599ec52edcd5b30d2ad37b633","source_decision":{"candidate_ids":[],"component_inventory_status":"not_assessed_by_this_planning_crosswalk","current_id":"pacific-south-equatorial-countercurrent","existing_length_evidence_status":"no_numeric_length","existing_scope":"Argo-based analysis reports a boreal-spring band near 5–13°S from 150°E to 170°W, with seasonal changes in zonal reach and depth. That observed seasonal envelope is not a traced alongstream length and is unranked.","known_component_currents":[],"ledger_kind":"seasonally varying eastward countercurrent","name":"Pacific South Equatorial Countercurrent","name_source_url":"https://doi.org/10.1029/2025JC023053","next_action":"Recover compatible numerical total-flow axes and paired boundaries; keep WOA01 surface/0-200 m geostrophy relative to 1500 dbar separate from modeled Sverdrup flow and band-passed anomaly sections at 170 E. Do not use anomaly zero contours as width edges, averaging windows as endpoints, or merge them with the newer Argo envelopes. See research/pacific-secc-woa01-anomaly-scope-audit.json; full 2026 methods and seasonal calendars remain needed.","planning_basis":"Argo-based analysis reports a boreal-spring band near 5–13°S from 150°E to 170°W, with seasonal changes in zonal reach and depth. That observed seasonal envelope is not a traced alongstream length and is unranked.","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","published_length_rank_eligible":false,"reference_path_decision":"reference_path_not_constructed","route_strategy_id":"seasonal_routes","route_strategy_label":"Construct seasonal routes","strategy_next_action":"Choose sourced season, direction and layer; construct each supported seasonal path separately and preserve missing seasons."},"source_url":"https://doi.org/10.1029/2025JC023053","status":"editorial_planning_crosswalk_not_scientific_classification_approval","strategy_id":"seasonal_routes","strategy_label":"Construct seasonal routes"},"audited_prior_owner":{"basin":"Tropical South Pacific","capabilities":{"dated_diagnostics":0,"flow_network":0,"geometry":0,"observed_velocity":0,"passage_transport":0,"radius_evidence":0,"reference_route":0,"reported_length":0,"scope_notes":2,"scoped_width":1,"source_connectivity":0,"time_samples":0,"width_samples":0},"claim_review_counts":{"not_individually_reviewed":56},"connections":[],"current_section_ids":[],"dashboard_search":"Pacific South Equatorial Countercurrent Tropical South Pacific","evidence_links":[],"fingerprint":"66e41ceb39ed8f12c1e5b517b2946575fc708a8d6eb87e1babc349379518f2bc","id":"current:pacific-south-equatorial-countercurrent","identity_level":"current","label":"Pacific South Equatorial Countercurrent","latest_observation_date":null,"linked_source_count":5,"map_features":[{"coordinate_reference_system":"OGC:CRS84","geometry":{"coordinates":[165,-9],"type":"Point"},"geometry_id":"geometry:0099","note":"Representative point inside Argo-observed boreal-spring 150°E–170°W, 5–13°S envelope; not a path endpoint.","positional_uncertainty":"not quantified; no observed current core or path","role":"editorial_locator","source_id":"source:4dc5fc618c26565f"}],"measurement_ids"
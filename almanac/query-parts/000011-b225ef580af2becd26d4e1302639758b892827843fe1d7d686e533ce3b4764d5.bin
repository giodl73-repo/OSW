tain compatible repeated observations before seasonal or annual dimensions.\"\r\n      ],\r\n      \"stream_tube_context\": {\r\n        \"section_id\": \"C\",\r\n        \"stream_tube\": 1,\r\n        \"threshold_velocity_m_s\": 0.04,\r\n        \"threshold_sensitivity_cases\": [\r\n          {\r\n            \"velocity_m_s\": 0.02,\r\n            \"width_km\": 37\r\n          },\r\n          {\r\n            \"velocity_m_s\": 0.08,\r\n            \"width_km\": 32\r\n          }\r\n        ],\r\n        \"constraint_transport_sv\": null,\r\n        \"constraint_transport_tolerance_fraction\": null,\r\n        \"transport_tolerance_is_width_error\": false,\r\n        \"offshore_core_relative_edge_km\": -11,\r\n        \"section_c_offshore_edge_from_SADCP\": true,\r\n        \"section_b_tube2_shelf_limited\": false,\r\n        \"shared_observation_group\": null,\r\n        \"cruise_context_period\": {\r\n          \"start\": \"2015-08-12\",\r\n          \"end\": \"2015-08-21\"\r\n        },\r\n        \"cruise_period_is_section_sampling_period\": false,\r\n        \"AW_observed_depth_context_m\": [\r\n          45,\r\n          475\r\n        ],\r\n        \"AW_depth_context_is_fixed_width_layer\": false,\r\n        \"geostrophic_reference_pressure_dbar\": 100,\r\n        \"reference_pressure_is_width_depth\": false,\r\n        \"comparison_velocity_depth_context_m\": [\r\n          50,\r\n          500\r\n        ],\r\n        \"comparison_depth_is_width_layer\": false,\r\n        \"grid_horizontal_km\": 1,\r\n        \"grid_vertical_m\": 2,\r\n        \"smoothing_horizontal_km\": 10,\r\n        \"smoothing_vertical_m\": 10,\r\n        \"study_along_isobath_coordinate_km\": 0,\r\n        \"study_coordinate_is_whole_current_length\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"protocol_file\": \"plans/west-spitsbergen-stream-tube-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"444d500d47552dcb9482383146e827230a27340178eb465cd96e8e9940861290\",\r\n        \"audit_file\": \"research/west-spitsbergen-kolas-2018-stream-tube-width-scope-audit.json\",\r\n        \"audit_sha256\": \"cb35ac68f45f3d1697583f129c4eb16156803c333d319eb724f60a8ca0083075\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"west-spitsbergen-kolas-2018-c-tube-2\",\r\n      \"current_id\": \"west-spitsbergen\",\r\n      \"name\": \"West Spitsbergen Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_synoptic_AW_stream_tube_section_width\",\r\n      \"width_metric\": \"along_section_span_of_property_bounded_transport_stream_tube\",\r\n      \"approximate_width_km\": 10,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": null,\r\n      \"is_confidence_interval\": false,\r\n      \"range_interpretation\": \"Threshold cases describe boundary-choice sensitivity, not confidence limits, temporal variation or annual extrema. Tube definitions cannot be averaged or added.\",\r\n      \"geographic_scope\": \"Section C northwest/north of Svalbard, August 2015; local WSC stream-tube support. C is upstream of branch partitioning; tube 2 constrains a Svalbard-branch interpretation.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Source cross-current survey section; no geographic edge pair or flow-normal projection extracted.\",\r\n      \"layer\": \"Property-defined Atlantic Water (practical salinity >34.88; corresponding rounded absolute salinity >35.05 g/kg; conservative temperature >=2 C), limited by seabed; not a fixed depth interval.\",\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"time_convention\": \"Synoptic August 2015 cruise context, 12-21 August; exact section dates unextracted. Three sections span about five days, not seasonal phases.\",\r\n      \"boundary_rule\": \"Tube 2: integrate from core in equal distance increments to conserve approximately 1.3 Sv within 10%; section B limited by shelf. Transport tolerance is not width uncertainty. A tube definitions coincide.\",\r\n      \"source_url\": \"https://os.copernicus.org/articles/14/1603/2018/\",\r\n      \"source_citation\": \"Kolas, E. and Fer, I. (2018), Hydrography, transport and mixing of the West Spitsbergen Current: the Svalbard Branch in summer 2015, Ocean Science 14, 1603-1618, doi:10.5194/os-14-1603-2018.\",\r\n      \"source_locator\": \"Table 2, printed p.1611, Width (km), section C, stream tube 2; methods sections 3.2-3.3, pp.1606-1608.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_synoptic_section_diagnostic\",\r\n      \"extraction_method\": \"Transcribed original PDF Table 2 cells after rendering and visual inspection; numeric methods read. No new inversion or geographic edge digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"calendar_months\": null,\r\n      \"observed_period\": null,\r\n      \"phase_label\": \"Section C / tube 2 / August 2015 snapshot\",\r\n      \"phase_kind\": \"synoptic_stream_tube_section\",\r\n      \"source_current_label\": \"West Spitsbergen Current; locally constrained stream tube\",\r\n      \"boundary_sides\": \"paired_along_section_stream_tube_limits\",\r\n      \"source_quality_note\": \"Original Table 2 and methods inspected. Brackets are threshold sensitivity; exact occupation dates and geographic width edges are unextracted. A1/A2 share one source tube.\",\r\n      \"remaining_gates\": [\r\n        \"Independent scientific admission and identity review.\",\r\n        \"Recover exact section dates and geographic edge coordinates before mapped width or state intersection.\",\r\n        \"Obtain compatible repeated observations before seasonal or annual dimensions.\"\r\n      ],\r\n      \"stream_tube_context\": {\r\n        \"section_id\": \"C\",\r\n        \"stream_tube\": 2,\r\n        \"threshold_velocity_m_s\": null,\r\n        \"threshold_sensitivity_cases\": [],\r\n        \"constraint_transport_sv\": 1.3,\r\n        \"constraint_transport_tolerance_fraction\": 0.1,\r\n        \"transport_tolerance_is_width_error\": false,\r\n        \"offshore_core_relative_edge_km\": null,\r\n        \"section_c_offshore_edge_from_SADCP\": false,\r\n        \"section_b_tube2_shelf_limited\": false,\r\n        \"shared_observation_group\": null,\r\n        \"cruise_context_period\": {\r\n          \"start\": \"2015-08-12\",\r\n          \"end\": \"2015-08-21\"\r\n        },\r\n        \"cruise_period_is_section_sampling_period\": false,\r\n        \"AW_observed_depth_context_m\": [\r\n          45,\r\n          475\r\n        ],\r\n        \"AW_depth_context_is_fixed_width_layer\": false,\r\n        \"geostrophic_reference_pressure_dbar\": 100,\r\n        \"reference_pressure_is_width_depth\": false,\r\n        \"comparison_velocity_depth_context_m\": [\r\n          50,\r\n          500\r\n        ],\r\n        \"comparison_depth_is_width_layer\": false,\r\n        \"grid_horizontal_km\": 1,\r\n        \"grid_vertical_m\": 2,\r\n        \"smoothing_horizontal_km\": 10,\r\n        \"smoothing_vertical_m\": 10,\r\n        \"study_along_isobath_coordinate_km\": 0,\r\n        \"study_coordinate_is_whole_current_length\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"protocol_file\": \"plans/west-spitsbergen-stream-tube-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"444d500d47552dcb9482383146e827230a27340178eb465cd96e8e9940861290\",\r\n        \"audit_file\": \"research/west-spitsbergen-kolas-2018-stream-tube-width-scope-audit.json\",\r\n        \"audit_sha256\": \"cb35ac68f45f3d1697583f129c4eb16156803c333d319eb724f60a8ca0083075\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"california-2011-abstract-regional-width\",\r\n      \"current_id\": \"california\",\r\n      \"name\": \"California Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": null,\r\n      \"width_range_km\": [\r\n        500,\r\n        800\r\n      ],\r\n      \"range_interpretation\": \"Reported regional width span; no midpoint, confidence interval or annual extrema inferred.\",\r\n      \"geographic_scope\": \"California Current regional description along the coast from 43 N to 23 N; not a narrow coastal jet, the undercurrent or an individual filament.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"No reproducible section endpoints extracted from the abstract.\",\r\n      \"layer\": \"Argo and high-resolution XBT synthesis; no fixed measurement layer for the width extracted from the abstract.\",\r\n      \"time_convention\": \"Abstract dataset context: Argo 2004-2010; Honolulu-San Francisco XBT 1991-2010; Honolulu-Los Angeles XBT 2008-2010. These are dataset periods, not exact width occupations or an annual width series.\",\r\n      \"boundary_rule\": \"Author-reported regional width span; paired geographic edges and the diagnostic boundary convention remain unextracted from the full methods.\",\r\n      \"source_url\": \"https://www.sciencedirect.com/science/article/abs/pii/S0079661111001157\",\r\n      \"source_citation\": \"Auad, G., Roemmich, D. and Gilson, J. (2011), The California Current System in relation to the Northeast Pacific Ocean circulation, Progress in Oceanography 91(4), 576-592, doi:10.1016/j.pocean.2011.09.004.\",\r\n      \"source_locator\": \"Publisher abstract, regional current-width sentence.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_publisher_abstract\",\r\n      \"extraction_method\": \"Transcribed publisher abstract numerical description; full original methods and figures not inspected.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Publisher abstract regional description\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"remaining_gates\": [\r\n        \"Inspect full original methods and figures to recover the width convention, layer and spatial support.\",\r\n        \"Obtain compatible dated repeat sections before seasonal animation or annual ranges.\",\r\n        \"Independent scientific and canonical admission review.\"\r\n      ],\r\n      \"source_quality_note\": \"Source access: publisher abstract inspected (California via publisher-indexed text). Full original methods, figures and boundary definitions remain unreviewed; no original PDF acquisition claimed.\",\r\n      \"range_kind\": \"reported_typical_regional_width_span\",\r\n      \"source_scope_context\": {\r\n        \"boundary_coordinates_supplied\": false,\r\n        \"bathymetry_is_measurement_layer\": false,\r\n        \"dataset_period_is_width_sampling_period\": false,\r\n        \"full_original_inspected\": false,\r\n        \"velocity_context_is_boundary_cutoff\": false,\r\n        \"audit_file\": \"research/california-2011-abstract-width-scope-audit.json\",\r\n        \"audit_sha256\": \"3669688088cf53d5fa4e66544967009f18d7e105df721567188d518855a06463\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"oyashio-2005-abstract-regional-width\",\r\n      \"current_id\": \"oyashio\",\r\n      \"name\": \"Oyashio Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_scalar_width_summary\",\r\n      \"width_metric\": \"author_reported_regional_current_scale\",\r\n      \"approximate_width_km\": 100,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"Approximate regional scalar; numerical uncertainty and annual variation unknown.\",\r\n      \"geographic_scope\": \"Oyashio along the southern Kuril Island Chain; not the distinct narrow Coastal Oyashio or the downstream Subarctic Current.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"No reproducible section endpoints extracted from the abstract.\",\r\n      \"layer\": \"Satellite-tracked surface drifter description; exact drogue depth and a fixed measurement layer remain unextracted from full methods.\",\r\n      \"time_convention\": \"Study velocity-field context September 1999-August 2000. No exact width occupations, seasonal width series or annual extrema extracted.\",\r\n      \"boundary_rule\": \"Approximate regional current width reported in the abstract; paired edges and a width-defining velocity cutoff are not supplied there. Reported 0.2-0.4 m/s flow is velocity context, not an edge threshold.\",\r\n      \"source_url\": \"https://link.springer.com/article/10.1007/s10872-006-0004-3\",\r\n      \"source_citation\": \"Ohshima, K. I., Wakatsuchi, M. and Saitoh, S. I. (2005), Velocity Field of the Oyashio Region Observed with Satellite-Tracked Surface Drifters during 1999-2000, Journal of Oceanography 61, 845-855, doi:10.1007/s10872-006-0004-3.\",\r\n      \"source_locator\": \"Publisher abstract, regional current-width sentence.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_publisher_abstract\",\r\n      \"extraction_method\": \"Transcribed publisher abstract numerical description; full original methods and figures not inspected.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Publisher abstract regional description\",\r\n      \"phase_kind\": \"regional_scalar_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"remaining_gates\": [\r\n        \"Inspect full original methods and figures to recover the width convention, layer and spatial support.\",\r\n        \"Obtain compatible dated repeat sections before seasonal animation or annual ranges.\",\r\n        \"Independent scientific and canonical admission review.\"\r\n      ],\r\n      \"source_quality_note\": \"Source access: publisher abstract inspected (California via publisher-indexed text). Full original methods, figures and boundary definitions remain unreviewed; no original PDF acquisition claimed.\",\r\n      \"source_scope_context\": {\r\n        \"boundary_coordinates_supplied\": false,\r\n        \"bathymetry_is_measurement_layer\": false,\r\n        \"dataset_period_is_width_sampling_period\": false,\r\n        \"full_original_inspected\": false,\r\n        \"velocity_context_is_boundary_cutoff\": false,\r\n        \"audit_file\": \"research/oyashio-2005-abstract-width-scope-audit.json\",\r\n        \"audit_sha256\": \"7fd3b4cfbe3249d7d7e4ea78242d3f809db99e6a9d2b6f8c2a7d5ea42693c605\"\r\n      },\r\n      \"regional_scalar_context\": {\r\n        \"boundary_coordinates_supplied\": false,\r\n        \"bathymetry_is_measurement_layer\": false,\r\n        \"dataset_period_is_width_sampling_period\": false,\r\n        \"full_original_inspected\": false,\r\n        \"velocity_context_is_boundary_cutoff\": false,\r\n        \"audit_file\": \"research/oyashio-2005-abstract-width-scope-audit.json\",\r\n        \"audit_sha256\": \"7fd3b4cfbe3249d7d7e4ea78242d3f809db99e6a9d2b6f8c2a7d5ea42693c605\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"somali-schott-2001-march-may-coastal-width\",\r\n      \"current_id\": \"somali\",\r\n      \"name\": \"Somali Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_seasonal_regional_prose_width_span\",\r\n      \"width_metric\": \"author_reported_seasonal_regional_current_scale\",\r\n      \"approximate_width_km\": null,\r\n      \"width_range_km\": [\r\n        50,\r\n        100\r\n      ],\r\n      \"range_interpretation\": \"One seasonal regional prose span, not an annual range, probability interval or three monthly measurements. Other months have no compatible width evidence here.\",\r\n      \"geographic_scope\": \"Northern Somali coastal upwelling regime, farther north than the southern EACC extension that turns offshore near 3-4 N. Northern latitude limits unresolved; no width assigned to the southern gyre, Great Whirl or the entire Somali Current.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"No reproducible section endpoints extracted from the original review prose.\",\r\n      \"layer\": \"Shallow northward coastal flow overlying a southward undercurrent; no numerical fixed layer or velocity threshold extracted for the width.\",\r\n      \"time_convention\": \"March-May seasonal synthesis in the 2001 review; no specific year, exact occupied section dates or monthly width values supplied.\",\r\n      \"boundary_rule\": \"Author-reported order-of-magnitude width scale of the northern shallow coastal flow. Paired geographic edges and a speed cutoff are unextracted.\",\r\n      \"source_url\": \"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf\",\r\n      \"source_citation\": \"Schott, F. A. and McCreary, J. P. Jr. (2001), The monsoon circulation of the Indian Ocean, Progress in Oceanography 51, 1-123, doi:10.1016/S0079-6611(01)00083-0.\",\r\n      \"source_locator\": \"Section 4.1.1, printed p. 38 (PDF page 38), March-May paragraph, final sentence and preceding northern-flow context.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_seasonal_synthesis_of_prior_observations\",\r\n      \"extraction_method\": \"Numerical seasonal width scale transcribed from inspected full original prose; no contour, section or raw observation digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"March-May northern coastal flow\",\r\n      \"phase_kind\": \"seasonal_regional_width_range\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": [\r\n        3,\r\n        4,\r\n        5\r\n      ],\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"remaining_gates\": [\r\n        \"Recover underlying dated northern coastal sections and boundary convention.\",\r\n        \"Obtain compatible repeat widths across the other nine months before a yearly cycle.\",\r\n        \"Independent scientific and canonical admission.\"\r\n      ],\r\n      \"source_quality_note\": \"Full original review inspected and printed p. 38 rendered. This is a seasonal synthesis; underlying width occupations and boundary methods remain unextracted.\",\r\n      \"range_kind\": \"author_reported_seasonal_regional_width_scale_span\",\r\n      \"calendar_source_locator\": \"Section 4.1.1, printed p. 38 (PDF page 38), March-May paragraph heading.\",\r\n      \"seasonal_regional_context\": {\r\n        \"southern_turnoff_latitude_is_width_edge\": false,\r\n        \"undercurrent_is_same_width_layer\": false,\r\n        \"Great_Whirl_scale_is_coastal_width\": false,\r\n        \"season_months_are_monthly_measurements\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"full_original_inspected\": true,\r\n        \"protocol_file\": \"plans/somali-seasonal-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"5182a21bd951600e62581469470a0cf3a2b74d2ab17a7475e93d070d7e90e53a\",\r\n        \"audit_file\": \"research/somali-schott-2001-premonsoon-width-scope-audit.json\",\r\n        \"audit_sha256\": \"726977308ec5be08932acf561d01d05c350778a9aad78cebb0770ef375cd5388\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"guinea-djakoure-2017-reference-mean-regional-width\",\r\n      \"current_id\": \"guinea\",\r\n      \"name\": \"Guinea Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_model_regional_prose_width\",\r\n      \"width_metric\": \"author_reported_regional_width_of_annual_mean_reference_model_surface_flow\",\r\n      \"width_metric_label\": \"Regional annual-mean reference-model width\",\r\n      \"approximate_width_km\": 200,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"One approximate regional model-mean width; numerical uncertainty and monthly/annual extrema unresolved. The separate theoretical 210 km inertial scale is not a width bound.\",\r\n      \"geographic_scope\": \"Northern Gulf of Guinea: eastward surface current between 2 N and African coast; no paired geographic edges extracted.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"No paired transverse section endpoints extracted; published regional model comparison prose.\",\r\n      \"layer\": \"Surface velocity field; numerical top-cell depth unextracted. Introductory 30-40 m thickness is not assigned as a width layer.\",\r\n      \"time_convention\": \"Reference model years 5-10, from a ten-year climatologically forced ROMS integration. Model years are not calendar years; annual mean is not an annual width minimum/maximum.\",\r\n      \"boundary_rule\": \"Approximate width reported in model comparison prose; cutoff and paired section boundaries unextracted.\",\r\n      \"source_url\": \"https://archimer.ifremer.fr/doc/00391/50248/69638.pdf\",\r\n      \"source_citation\": \"Djakoure, S., Penven, P., Bourles, B., Kone, V., and Veitch, J. (2017). Respective Roles of the Guinea Current and Local Winds on the Coastal Upwelling in the Northern Gulf of Guinea. Journal of Physical Oceanography 47, 1367-1387. doi:10.1175/JPO-D-16-0126.1\",\r\n      \"source_locator\": \"printed p1379, section 3c(2), first paragraph; Figure 1d context in section 3a(1), pp1371-1372\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_reference_model_regional_mean\",\r\n      \"extraction_method\": \"Approximate width transcribed from inspected original p1379 prose; no figure, contour or model-field digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Regional annual-mean reference model\",\r\n      \"phase_kind\": \"model_regional_width_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"remaining_gates\": [\r\n        \"Resolve top-cell depth and model figure caption conflict before edge digitization.\",\r\n        \"Acquire compatible repeated regional boundaries before monthly/annual variation.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"source_quality_note\": \"Original institutionally hosted publisher article inspected. Figure 1 caption calls model panels idealized while section 3a(1) calls them reference; width retained from explicit p1379 reference-experiment prose.\",\r\n      \"model_regional_context\": {\r\n        \"model\": {\r\n          \"parent_resolution_degrees\": 0.2,\r\n          \"child_resolution_degrees\": 0.06666666666666667,\r\n          \"ten_year_climatological_integration\": true,\r\n          \"analysis_model_years\": [\r\n            5,\r\n            6,\r\n            7,\r\n            8,\r\n            9,\r\n            10\r\n          ],\r\n          \"calendar_dates\": null\r\n        },\r\n        \"theoretical_inertial_scale_is_width_bound\": false,\r\n        \"model_years_are_calendar_years\": false,\r\n        \"annual_mean_is_annual_extrema\": false,\r\n        \"introduction_thickness_is_fixed_width_layer\": false,\r\n        \"velocity_maximum_is_boundary_cutoff\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"figure_caption_conflict_resolved\": false,\r\n        \"full_original_inspected\": true,\r\n        \"protocol_file\": \"plans/guinea-model-regional-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"10fc2a7ad5855a266e9a7b1d2f21dc74d957f8b7dba968ad3db4472f9cf7df29\",\r\n        \"audit_file\": \"research/guinea-djakoure-2017-model-width-source-review.json\",\r\n        \"audit_sha256\": \"15d7b34f39d840541cb5d10deb0fac79f029640866ebc0c0acd61dc5dfd5eea6\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"algerian-cotroneo-2019-regional-width\",\r\n      \"current_id\": \"algerian\",\r\n      \"name\": \"Algerian Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": null,\r\n      \"width_range_km\": [\r\n        30,\r\n        50\r\n      ],\r\n      \"range_kind\": \"reported_typical_regional_width_span\",\r\n      \"range_interpretation\": \"One reported regional along-slope width span; not annual extrema, a confidence interval, three autumn observations or a selected midpoint.\",\r\n      \"geographic_scope\": \"Eastward along-slope Atlantic Water flow along the Algerian coast after leaving the Alboran Sea; no exact longitudinal terminal gates or paired width edges supplied.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"No reproducible transverse section endpoints supplied for the introductory width description.\",\r\n      \"layer\": \"Surface Atlantic Water regional flow; numerical width layer unresolved. Dataset sampling down to 975 m is not assigned as a width layer.\",\r\n      \"time_convention\": \"Regional background synthesis in a 2019 article; no width occupation dates or calendar supplied. Autumn 2014-2016 describes the separate ABACUS survey dataset.\",\r\n      \"boundary_rule\": \"Author-reported regional span, citing Testor et al. (2005). No paired edge positions or velocity cutoff extracted.\",\r\n      \"source_url\": \"https://essd.copernicus.org/articles/11/147/2019/\",\r\n      \"source_citation\": \"Cotroneo, Aulicino, Ruiz, Sanchez Roman, Torner Tomas, Pascual, Fusco, Heslop, Tintore and Budillon (2019), Glider data collected during the Algerian Basin Circulation Unmanned Survey, Earth System Science Data 11, 147-161, doi:10.5194/essd-11-147-2019.\",\r\n      \"source_locator\": \"Section 1 Introduction, printed p148 (PDF page 2), left column paragraph beginning with the Alboran Sea departure and citing Testor et al. (2005).\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_original_regional_background_synthesis\",\r\n      \"extraction_method\": \"Numerical span transcribed from inspected publisher original prose; no glider, image or velocity-field boundary digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Regional along-slope background synthesis\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Original publisher PDF and p148 visually inspected. Introductory width cites prior work, not an ABACUS width calculation. Underlying Testor et al. boundary method remains unreviewed.\",\r\n      \"remaining_gates\": [\r\n        \"Review the underlying width citation and paired boundary method.\",\r\n        \"Obtain compatible repeat sections before monthly or annual variation.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"full_original_inspected\": true,\r\n        \"underlying_width_source\": \"Testor et al. (2005), cited in section 1\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"survey_years_are_width_occupations\": false,\r\n        \"survey_depth_is_width_layer\": false,\r\n        \"LIW_depth_is_width_layer\": false,\r\n        \"eddy_diameter_is_current_width\": false,\r\n        \"span_is_annual_range\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"protocol_file\": \"plans/algerian-regional-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"e19cf5ac14c488820940035164fde4185138b777b4e389313d28737317617789\",\r\n        \"audit_file\": \"research/algerian-cotroneo-2019-regional-width-scope-audit.json\",\r\n        \"audit_sha256\": \"417252a69db47dd73f102c06408807ed43c14acc6fa6c81470ca8141aba3c600\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"alaska-weingartner-2002-regional-width\",\r\n      \"current_id\": \"alaska\",\r\n      \"name\": \"Alaska Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": 300,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"approximate_regional_point_no_reported_interval\",\r\n      \"range_interpretation\": \"One approximate regional background value; no numerical uncertainty, range, confidence interval, annual extrema or seasonal observations supplied.\",\r\n      \"geographic_scope\": \"Eastern Gulf of Alaska boundary flow along the continental slope, distinct from the Alaskan Stream in the northwestern gulf and inner-shelf Alaska Coastal Current. No paired width edges or exact terminal gates supplied.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"No reproducible transverse section endpoints supplied for the regional breadth description.\",\r\n      \"layer\": \"Regional current flow; fixed numerical width layer unspecified. Weak horizontal and vertical shears do not establish a depth interval.\",\r\n      \"time_convention\": \"Regional background synthesis in a 2002 article; no dated width occupation or width climatology. Year-round persistence and GLOBEC program dates are separate context.\",\r\n      \"boundary_rule\": \"Author-reported approximate regional breadth. No paired edge positions or velocity cutoff extracted. Sentence continues on p50 to contrast the Alaskan Stream and cite Reed and Schumacher (1986).\",\r\n      \"source_url\": \"https://tos.org/oceanography/article/the-northeast-pacific-globec-program-coastal-gulf-of-alaska\",\r\n      \"source_citation\": \"Weingartner et al. (2002), The Northeast Pacific GLOBEC Program: Coastal Gulf of Alaska, Oceanography 15(2), 48-63, doi:10.5670/oceanog.2002.21.\",\r\n      \"source_locator\": \"Physical Setting, printed p49 (PDF page 2), right column final paragraph; sentence continuation on p50 (PDF page 3), left column below Figure 1.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_original_regional_background_synthesis\",\r\n      \"extraction_method\": \"Approximate point transcribed from visually inspected publisher original prose; no current axis or map width digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Regional eastern Gulf background synthesis\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Original publisher PDF and p49/p50 visually inspected. Approximate regional description, not a new GLOBEC width calculation. Underlying cited boundary method and attribution remain unreviewed.\",\r\n      \"remaining_gates\": [\r\n        \"Resolve the cited original width support and paired boundary method.\",\r\n        \"Obtain compatible repeat sections before monthly or annual variation.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_source\": \"Reed and Schumacher (1986) at the end of the sentence on p50; application to the Alaska breadth is not independently resolved.\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"survey_years_are_width_occupations\": false,\r\n        \"drifter_depth_is_width_layer\": false,\r\n        \"forcing_climatologies_are_width_climatology\": false,\r\n        \"year_round_persistence_is_monthly_width_series\": false,\r\n        \"alaskan_stream_width_is_range_endpoint\": false,\r\n        \"coastal_confinement_is_alaska_width\": false,\r\n        \"shelf_breadth_is_current_width\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"protocol_file\": \"plans/alaska-regional-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"21c30fc5f5de4b01ca8ff53e2ac382b2e55052a38618a935669b3729b460b553\",\r\n        \"display_caption\": \"Eastern Gulf of Alaska boundary current · one approximate 300 km regional background description. Numerical uncertainty, width range, fixed layer and observation dates unknown. GLOBEC survey dates, drifter depth and forcing climatologies do not define this width. No annual range, monthly samples or mapped edges inferred.\",\r\n        \"display_method_note\": \"Publisher p49 and its p50 sentence continuation inspected. The narrower Alaskan Stream and inner-shelf Alaska Coastal Current are separate features. The cited original boundary method remains unreviewed.\",\r\n        \"audit_file\": \"research/alaska-weingartner-2002-regional-width-scope-audit.json\",\r\n        \"audit_sha256\": \"475b2cbc7c21e6aac907e2a61153b50088fb77010053f0957e6f2cf44f5535ad\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"pacific-euc-wang-2022-background-width\",\r\n      \"current_id\": \"pacific-equatorial-undercurrent\",\r\n      \"name\": \"Pacific Equatorial Undercurrent\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": 400,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"approximate_regional_point_no_reported_interval\",\r\n      \"range_interpretation\": \"One approximate regional background value; no numerical uncertainty, range, confidence interval, annual extrema or seasonal observations supplied.\",\r\n      \"geographic_scope\": \"Pacific eastward equatorial subsurface jet; background approximation without a fixed section longitude or paired edge coordinates. Not the generic cross-basin family or Atlantic/Indian EUC.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"No reproducible transverse section endpoints supplied for the regional breadth description.\",\r\n      \"layer\": \"Subsurface current background; adjacent approximate thickness and 50–200 m core depths are context, not a fixed width measurement layer.\",\r\n      \"time_convention\": \"Background synthesis in a 2022 article; no dated width occupation or monthly width climatology. Simulation years and transport/velocity climatologies have different support.\",\r\n      \"boundary_rule\": \"Author-reported approximate background width. No velocity cutoff, paired boundaries or explicit transverse section extracted. Model transport boxes are not width boundaries.\",\r\n      \"source_url\": \"https://www.frontiersin.org/journals/marine-science/articles/10.3389/fmars.2022.908939/full\",\r\n      \"source_citation\": \"Wang et al. (2022), Wind-Driven Mechanisms for the Variations of the Pacific Equatorial Undercurrent Based on Adjoint Sensitivity Analysis, Frontiers in Marine Science 9:908939, doi:10.3389/fmars.2022.908939.\",\r\n      \"source_locator\": \"Introduction opening paragraph, printed p1 (PDF page 1); different model/transport supports in sections 2.1–2.2 and Figures 1/2, printed pp3–4.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_original_regional_background_synthesis\",\r\n      \"extraction_method\": \"Approximate width transcribed from visually inspected publisher original p1 prose; no map, current axis or model transport-box width digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Pacific subsurface jet background synthesis\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Original publisher p1 width and p4 transport/velocity context visually inspected. Background 400 km is not a derived width from the adjoint experiment. Underlying historical width method and exact attribution remain unreviewed.\",\r\n      \"remaining_gates\": [\r\n        \"Resolve the original historical width support and paired boundary method.\",\r\n        \"Obtain compatible repeated width sections before monthly or annual variation.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_source\": \"Cromwell et al. (1954) cited in the opening current description; exact support for the background width and original measurement method not independently resolved.\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"approximate_thickness_is_fixed_width_layer\": false,\r\n        \"core_depths_are_fixed_width_layer\": false,\r\n        \"model_transport_bounds_are_width_edges\": false,\r\n        \"model_transport_depths_are_width_layer\": false,\r\n        \"model_years_are_width_occupations\": false,\r\n        \"transport_velocity_climatology_is_width_climatology\": false,\r\n        \"transport_seasonality_is_width_seasonality\": false,\r\n        \"other_publication_width_is_range_endpoint\": false,\r\n        \"cross_basin_width_inheritance_eligible\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"transport_context\": {\r\n          \"longitude_deg_e\": 165,\r\n          \"latitude_bounds_deg\": [\r\n            -3,\r\n            3\r\n          ],\r\n          \"gecco_depth_bounds_m\": [\r\n            87.5,\r\n            310\r\n          ],\r\n          \"hycom_depth_bounds_m\": [\r\n            85,\r\n            310\r\n          ],\r\n          \"velocity_average_depth_bounds_m\": [\r\n            100,\r\n            300\r\n          ],\r\n          \"hycom_tao_velocity_climatology_years\": [\r\n            1994,\r\n            2013\r\n          ],\r\n          \"source_locator\": \"Sections 2.1–2.2, equation 6 and Figures 1/2, printed pp3–4\",\r\n          \"is_width_measurement_support\": false\r\n        },\r\n        \"protocol_file\": \"plans/pacific-euc-background-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"ef339570824337ee7a398ffd18a4aaba5e151c177912ce74da958222b09eec1b\",\r\n        \"display_caption\": \"Pacific eastward subsurface jet · one approximate 400 km background width. Numerical uncertainty, width range, fixed measurement layer and observation dates unknown. Transport and velocity seasonal cycles do not supply monthly widths. No annual range or mapped edges inferred.\",\r\n        \"display_method_note\": \"Publisher p1 width prose and p4 transport context inspected. About 200 m thickness and 50–200 m core depths are separate descriptions. The 3°S–3°N transport box is not a width observation. Historical boundary method remains unreviewed; no transfer to other basin currents.\",\r\n        \"audit_file\": \"research/pacific-euc-wang-2022-background-width-scope-audit.json\",\r\n        \"audit_sha256\": \"9be49243e762e82c9a7ce0e0348a3a8e29c4c8973b34f4773a4ebdb49799c998\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"atlantic-euc-gouriou-1988-background-width\",\r\n      \"current_id\": \"atlantic-equatorial-undercurrent\",\r\n      \"name\": \"Atlantic Equatorial Undercurrent\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": 200,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"approximate_regional_point_no_reported_interval\",\r\n      \"range_interpretation\": \"One approximate regional background value; no numerical uncertainty, range, confidence interval, annual extrema or seasonal observations supplied.\",\r\n      \"geographic_scope\": \"Atlantic eastward subsurface equatorial jet, called Lomonosov current; Brazil to Gulf of Guinea background description without paired boundary coordinates or a specified transverse section.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"No reproducible transverse section endpoints supplied for the regional breadth description.\",\r\n      \"layer\": \"Subsurface current background. Adjacent 150 m thickness and 50–125 m core depths do not define a fixed width measurement layer.\",\r\n      \"time_convention\": \"1988 French synthesis; no dated width occupation. Compilation years, dated example sections and transport occupations are separate supports.\",\r\n      \"boundary_rule\": \"Approximate author-reported background width; no paired edges or boundary threshold directly resolved. Transport cutoff is not adopted as this width method.\",\r\n      \"source_url\": \"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/divers11-10/34183.pdf\",\r\n      \"source_citation\": \"Y. Gouriou (1988), chapter III, section 3.3.2, printed p16, in Fonteneau and Marcille (eds.), FAO Fisheries Technical Paper 292 (French edition), ISBN 92-5-202652-5.\",\r\n      \"source_locator\": \"Printed p16 / PDF page 31, section 3.3.2; title/copyright PDF pages 2–3; Figure 3.4 printed p18 / PDF page 33.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_original_regional_background_synthesis\",\r\n      \"extraction_method\": \"Approximate breadth transcribed from visually inspected institutional original; no contour, transport or coordinate digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Atlantic subsurface jet background synthesis\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Original French volume confirms 200 km prose. Exact historical paired-boundary support remains unresolved. The later English OCR version and dated Voituriez sections are not independent 200 km width observations.\",\r\n      \"remaining_gates\": [\r\n        \"Resolve historical background-width boundary method and exact attribution.\",\r\n        \"Extract compatible repeated transverse sections before seasonal dimensions.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_source\": \"Voituriez (1983) cited near the description; its source sections were reviewed separately, without directly establishing this regional 200 km boundary method.\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"thickness_is_fixed_width_layer\": false,\r\n        \"core_depths_are_fixed_width_layer\": false,\r\n        \"core_position_oscillation_is_width_range\": false,\r\n        \"compilation_years_are_width_occupations\": false,\r\n        \"figure_section_dates_are_background_width_dates\": false,\r\n        \"garp_transport_dates_are_width_occupations\": false,\r\n        \"transport_cutoff_is_background_width_boundary\": false,\r\n        \"translation_is_independent_width_observation\": false,\r\n        \"cross_basin_width_inheritance_eligible\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"protocol_file\": \"plans/atlantic-euc-background-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"f37545d040de00e884348a6aee729c18db00f40cc7db65beb903003459298279\",\r\n        \"display_caption\": \"Atlantic eastward subsurface jet · one approximate 200 km background width. Fixed width layer, numerical uncertainty, paired edges and observation dates unknown. No annual range or seasonal width series inferred.\",\r\n        \"display_method_note\": \"Original French FAO p16 inspected. 150 m thickness, 50–125 m core depths and core-position oscillations are separate descriptions. The 1988 synthesis and 1993 English version are not two width samples; dated sections and transport thresholds do not date or define this background breadth.\",\r\n        \"audit_file\": \"research/atlantic-euc-gouriou-1988-background-width-scope-audit.json\",\r\n        \"audit_sha256\": \"f6881f5090e36b3ae3b82459b52d9b5fd06fb93a23cd25ffc3202beb94a80433\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"kuroshio-extension-sasaki-2013-monthly-field-width\",\r\n      \"current_id\": \"kuroshio-extension\",\r\n      \"name\": \"Kuroshio Extension\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": 100,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"approximate_regional_point_no_reported_interval\",\r\n      \"range_interpretation\": \"One approximate regional background value; no numerical uncertainty, range, confidence interval, annual extrema or seasonal observations supplied.\",\r\n      \"geographic_scope\": \"Intense Kuroshio Extension jet in monthly mean fields, extending eastward from Japan to the date line; no transverse boundary coordinates extracted.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Author-reported meridional width; not assumed normal to the meandering jet.\",\r\n      \"layer\": \"Surface SSH and geostrophic velocity context; no fixed vertical width layer supplied.\",\r\n      \"time_convention\": \"Monthly mean fields summarized in source prose; no dated width series extracted. January 2005 is the illustrative Figure 1b field.\",\r\n      \"boundary_rule\": \"Author-reported meridional jet width. Continuous SSH contours and peak velocity locate the axis; no paired width edges or threshold resolved.\",\r\n      \"source_url\": \"https://eprints.lib.hokudai.ac.jp/repo/huscap/all/52934/jpo-d-12-096.1.pdf\",\r\n      \"source_citation\": \"Sasaki, Y. N., S. Minobe and N. Schneider (2013), Decadal Response of the Kuroshio Extension Jet to Rossby Waves: Observation and Thin-Jet Theory, JPO 43(2):442–456, doi:10.1175/JPO-D-12-096.1.\",\r\n      \"source_locator\": \"Printed p445 / PDF page 5, section 3 first paragraph; data/methods pp443–444; Figure 1 printed p444 / PDF page 4.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_original_regional_monthly_field_summary\",\r\n      \"extraction_method\": \"Approximate width transcribed from visually inspected original; no contour, coordinate or velocity-profile digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Meridional jet width in monthly mean fields\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Monthly mean is a temporal operator, not a recovered month-by-month width series. The separate 200 km climatological meridional scale has different support; it is not an interval endpoint.\",\r\n      \"remaining_gates\": [\r\n        \"Resolve a reproducible meridional width boundary rule and exact transverse support.\",\r\n        \"Extract dated compatible sections before seasonal dimensions or playback.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_source\": \"Original section 3 and Figure 1; axis method inspected separately from unresolved paired width method.\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"monthly_mean_is_dated_width_series\": false,\r\n        \"illustrative_figure_date_is_width_occupation\": false,\r\n        \"analysis_period_is_width_occupation\": false,\r\n        \"climatological_scale_is_width_range_endpoint\": false,\r\n        \"jet_displacement_is_width_variation\": false,\r\n        \"axis_search_contours_are_width_edges\": false,\r\n        \"eof_anomaly_scale_is_width_measurement\": false,\r\n        \"low_pass_shading_is_monthly_width_series\": false,\r\n        \"meridional_width_is_flow_normal_width\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"temporal_operator\": \"monthly_mean\",\r\n        \"illustrative_figure_month\": \"2005-01\",\r\n        \"analysis_period_context\": {\r\n          \"start\": \"1993-01\",\r\n          \"end\": \"2010-12\",\r\n          \"is_width_measurement_support\": false\r\n        },\r\n        \"data_context\": {\r\n          \"product\": \"AVISO monthly absolute dynamic height and surface geostrophic velocities\",\r\n          \"grid\": \"1/3 degree Mercator\",\r\n          \"mean_dynamic_topography\": \"Rio and Hernandez (2004)\",\r\n          \"low_pass_context\": \"9-month running mean for low-frequency analyses; Figure 1a standard deviations explicitly filtered; Figure 1b monthly mean distinct.\"\r\n        },\r\n        \"climatological_scale_context\": {\r\n          \"meridional_scale_km\": 200,\r\n          \"temporal_operator\": \"climatological_mean\",\r\n          \"geographic_scope\": \"Japan coast near 35°N to 165°E\",\r\n          \"source_locator\": \"Printed p445, section 3 first paragraph / Figure 1a\",\r\n          \"is_width_sample\": false,\r\n          \"is_range_endpoint\": false,\r\n          \"uncertainty_km\": null\r\n        },\r\n        \"protocol_file\": \"plans/kuroshio-extension-width-averaging-protocol-v1.md\",\r\n        \"protocol_sha256\": \"bac962694f1a0f2e0560218ace30240e3f0f8716ef5e4a8edef53c0bd7f99d79\",\r\n        \"display_caption\": \"Monthly mean fields · approximate 100 km meridional jet width, extending to the date line. No dated width series, numerical uncertainty, paired edges or annual range extracted.\",\r\n        \"display_method_note\": \"Separate context: the climatological jet has a reported 200 km meridional scale from Japan to 165°E. Different temporal and geographic supports; no 100–200 km seasonal range. Farther downstream, shifts of the narrow jet broaden its long-term mean. January 2005 illustrates a monthly SSH field; 60–120 cm contours locate the axis search region, not width edges.\",\r\n        \"audit_file\": \"research/kuroshio-extension-sasaki-2013-width-averaging-scope-audit.json\",\r\n        \"audit_sha256\": \"dfa44d57f053ac0cd8af32abcfdb0c5dcbdc63a3937c64abf14c79a2cb9370c7\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"ngcu-zenk-1999-vitiaz-width-constraint\",\r\n      \"current_id\": \"new-guinea-coastal-undercurrent\",\r\n      \"name\": \"New Guinea Coastal Undercurrent\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": null,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"author_reported_order_of_magnitude_less_than_scale\",\r\n      \"range_interpretation\": \"Source O(<20 km) preserves an approximate less-than size description; not a measured 20 km point, rigorous hard bound, 0–20 km interval, uncertainty or seasonal extrema.\",\r\n      \"geographic_scope\": \"Local bands near the western exit of Vitiaz Strait; downstream central Bismarck Sea widening retained as context, not a whole-current dimension.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Local Doppler band breadth; exact transverse orientation and paired coordinates unresolved.\",\r\n      \"layer\": \"Subsurface slope-parallel current described near 200 m. No fixed width layer or paired depth-specific edges extracted.\",\r\n      \"time_convention\": \"SONNE cruise 113 context (10 October–19 November 1996); exact Doppler width occupations unresolved. March 1999 is publication, not observation.\",\r\n      \"boundary_rule\": \"Author-reported order-of-magnitude less-than band size. Exceeding 80 cm/s describes speed, not an adopted width-edge cutoff.\",\r\n      \"source_url\": \"https://oceanrep.geomar.de/1816/1/news34.pdf\",\r\n      \"source_citation\": \"Zenk, W., G. Siedler, J. Holfort and O. Boebel (1999), Float Observations Showing the Equatorial Crossing of Antarctic Intermediate Water in the Western Pacific, International WOCE Newsletter 34 (March), pp10–14, printed p13. Unpublished manuscript / work-in-progress newsletter report.\",\r\n      \"source_locator\": \"Printed/PDF p13 first column, continuation from p10; article pp10–14. Copyright PDF page 44. Figure 3 cruise-label conflict on p13.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_original_local_doppler_band_size_constraint\",\r\n      \"extraction_method\": \"Qualifier and reference size transcribed from visually inspected original; no profile digitization, exact crossing pairing or doubled downstream value.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Vitiaz exit Doppler band size constraint\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Work-in-progress newsletter report, not a peer-reviewed width series. Cruise 113 in prose conflicts with cruise 133 in Figure 3 caption. Salinity sections and float trajectories do not supply width boundaries.\",\r\n      \"remaining_gates\": [\r\n        \"Recover Doppler crossings, exact width layer and paired boundary rule.\",\r\n        \"Resolve cruise-label conflict and occupation support before dated widths.\",\r\n        \"Recover independently measured downstream dimensions; no factor-of-two arithmetic admission.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_source\": \"Zenk et al. (1999), p13; cited SONNE report inspected for ADCP context, not a resolved paired width definition.\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"reference_scale_is_point_width\": false,\r\n        \"notation_is_rigorous_upper_bound\": false,\r\n        \"zero_to_reference_is_width_range\": false,\r\n        \"downstream_doubling_is_numeric_width\": false,\r\n        \"downstream_widening_is_seasonal_range\": false,\r\n        \"speed_exceedance_is_width_cutoff\": false,\r\n        \"core_depth_is_fixed_width_layer\": false,\r\n        \"adcp_depth_coverage_is_fixed_width_layer\": false,\r\n        \"salinity_section_is_width_boundary\": false,\r\n        \"cruise_dates_are_width_occupations\": false,\r\n        \"publication_month_is_width_observation\": false,\r\n        \"float_dates_are_width_occupations\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"cruise_context\": {\r\n          \"prose_cruise_number\": \"113\",\r\n          \"figure_3_caption_cruise_number\": \"133\",\r\n          \"cruise_number_conflict\": true,\r\n          \"voyage_start\": \"1996-10-10\",\r\n          \"voyage_end\": \"1996-11-19\",\r\n          \"is_width_measurement_support\": false\r\n        },\r\n        \"downstream_context\": {\r\n          \"reported_core_widening_factor\": 2,\r\n          \"location\": \"central Bismarck Sea\",\r\n          \"derived_width_km\": null,\r\n          \"is_seasonal_variation\": false\r\n        },\r\n        \"method_context\": {\r\n          \"local_speed_exceeds_cm_s\": 80,\r\n          \"core_depth_context_m\": 200,\r\n          \"adcp_coverage_context_m\": [\r\n            350,\r\n            400\r\n          ],\r\n          \"is_width_boundary_method\": false\r\n        },\r\n        \"supporting_report\": {\r\n          \"source_url\": \"https://oceanrep.geomar.de/id/eprint/2244/1/IFM-BER_288.pdf\",\r\n          \"source_locator\": \"Printed p16 / PDF page 17, ADCP subsection; printed pp3 and 8–10 voyage context; no paired width extraction.\",\r\n          \"source_document_file\": \"research/source-data/siedler-sonne-1997/journal-article.pdf\",\r\n          \"source_document_bytes\": 4094903,\r\n          \"source_document_sha256\": \"cc9e293b98a47581b9d162c63781af1e5842d6aa0de403a7f06941ea7e6f4cca\",\r\n          \"acquisition_file\": \"research/source-data/siedler-sonne-1997/acquisition.json\",\r\n          \"acquisition_sha256\": \"31672631b098531dc6d707525055183e08b3b04e25c43381722bb6f6941653b3\",\r\n          \"is_independent_width_measurement\": false\r\n        },\r\n        \"protocol_file\": \"plans/ngcu-reported-width-constraint-protocol-v1.md\",\r\n        \"protocol_sha256\": \"ff0d0e46f03a9054a69bc06205063064c235d9ac70d640401a4191aeaf76f3c2\",\r\n        \"display_caption\": \"Vitiaz exit subsurface Doppler bands · source reports O(<20 km). Approximate size constraint, not a 20 km measured point or a 0–20 km range. Exact representative width, numerical uncertainty, dates and paired edges unresolved.\",\r\n        \"display_method_note\": \"Core widening by a factor of two in the central Bismarck Sea describes spatial change; no 40 km width or seasonal cycle inferred. The 200 m core, 350–400 m ADCP coverage, salinity section and speeds above 80 cm/s do not define paired width edges. Cruise 113 in the prose conflicts with 133 in Figure 3 caption; exact width occupations remain unresolved.\",\r\n        \"audit_file\": \"research/ngcu-zenk-1999-width-constraint-scope-audit.json\",\r\n        \"audit_sha256\": \"f7aaac4169046b43f85affa40bbf711b50be1278bf72079777cf6292d3b5a13d\"\r\n      },\r\n      \"reported_width_constraint\": {\r\n        \"kind\": \"author_order_of_magnitude_less_than\",\r\n        \"reference_scale_km\": 20,\r\n        \"source_notation\": \"O(<20 km)\",\r\n        \"is_rigorous_upper_bound\": false,\r\n        \"representative_width_km\": null,\r\n        \"lower_bound_km\": null,\r\n        \"numerical_uncertainty_km\": null\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"zeehan-cresswell-2000-historical-slope-width\",\r\n      \"current_id\": \"zeehan\",\r\n      \"name\": \"Zeehan Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": 40,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"approximate_regional_point_no_reported_interval\",\r\n      \"range_interpretation\": \"One approximate regional background value; no numerical uncertainty, range, confidence interval, annual extrema or seasonal observations supplied.\",\r\n      \"geographic_scope\": \"Continental slope at the western entrance of Bass Strait; attributed historical estimate, not all western Tasmanian shelf flow.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Regional cross-current description; exact transverse axis and paired edges unresolved.\",\r\n      \"layer\": \"Warm baroclinic slope-current context; fixed width depth bounds unresolved.\",\r\n      \"time_convention\": \"Historical Baines et al. (1983) description repeated in Cresswell (2000); exact width occupation support unresolved.\",\r\n      \"boundary_rule\": \"Attributed author approximate width; no numerical threshold or paired edge coordinates extracted.\",\r\n      \"source_url\": \"https://eprints.utas.edu.au/13585/7/2000_Cresswell_Currents_rst.pdf\",\r\n      \"source_citation\": \"Cresswell, G. (2000), Currents of the continental shelf and upper slope of Tasmania, Papers and Proceedings of the Royal Society of Tasmania 133(3):21–30, doi:10.26749/rstpp.133.3.21.\",\r\n      \"source_locator\": \"Introduction, printed p21 / PDF page 1, paragraph on Baines et al. (1983). Separate Strahan sections: pp24–25 and Figure 5C p28 / PDF page 8.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_original_attributed_historical_regional_summary\",\r\n      \"extraction_method\": \"Approximate width from visually reviewed original paragraph; qualitative section comparison transcribed separately, no velocity-contour digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Attributed historical Bass Strait slope width\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"The 40 km summary is attributed to Baines et al. (1983); March/December 1997 Strahan widths remain numerically unknown. Neither the survey depth nor later seasonal calendar supplies this width support.\",\r\n      \"remaining_gates\": [\r\n        \"Resolve original width boundary operator, layer and occupation support.\",\r\n        \"Extract compatible dated paired boundaries before numerical seasonal ranges.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_source\": \"Baines, Edwards & Fandry (1983), doi:10.1071/MF9830155, as attributed in Cresswell Introduction.\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"historical_width_is_1997_section_width\": false,\r\n        \"two_occupations_are_annual_extrema\": false,\r\n        \"survey_months_are_width_calendar\": false,\r\n        \"adcp_depth_coverage_is_fixed_width_layer\": false,\r\n        \"mooring_isobaths_are_width_layer\": false,\r\n        \"drifter_drogue_is_width_layer\": false,\r\n        \"velocity_sign_contours_are_admitted_paired_edges\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"original_width_source_access\": {\r\n          \"doi\": \"10.1071/MF9830155\",\r\n          \"archive_url\": \"https://citeseerx.ist.psu.edu/document?doi=82056fb29ae09eb8f42aa4b8174a95a3c70b533c&repid=rep1&type=pdf\",\r\n          \"access\": \"Three-page archived article text readable through web PDF extraction; original bytes not acquired or visually inspected. Publisher download 403; direct archive request 404.\",\r\n          \"source_response_sha256\": null,\r\n          \"is_independent_width_record\": false\r\n        },\r\n        \"method_context\": {\r\n          \"ship_adcp_frequency_khz\": 150,\r\n          \"ship_depth_coverage_m\": 300,\r\n          \"lowest_water_column_fraction_excluded\": 0.15,\r\n          \"mooring_isobaths_m\": [\r\n            100,\r\n            200\r\n          ],\r\n          \"drifter_drogue_depth_m\": 15,\r\n          \"is_historical_width_layer\": false,\r\n          \"december_flow_extends_beyond_adcp_depth_coverage\": true\r\n        },\r\n        \"section_comparison\": {\r\n          \"site\": \"Strahan, western Tasmania\",\r\n          \"source_locator\": \"Printed p25, Strahan December paragraph; Figure 5C printed p28 / PDF page 8.\",\r\n          \"comparison_kind\": \"author_qualitative_between_two_occupations\",\r\n          \"width_relation\": \"December narrower than March\",\r\n          \"strength_relation\": \"December slightly stronger than March\",\r\n          \"numerical_width_ratio\": null,\r\n          \"annual_range_eligible\": false,\r\n          \"monthly_climatology_eligible\": false,\r\n          \"occupied_geometry_eligible\": false,\r\n          \"records\": [\r\n            {\r\n              \"id\": \"strahan-1997-03\",\r\n              \"observed_month\": \"1997-03\",\r\n              \"station_label\": \"19:27\",\r\n              \"width_km\": null,\r\n              \"width_range_km\": null,\r\n              \"width_description\": \"Broader of the two reported occupations\",\r\n              \"strength_description\": \"Reported southward speeds up to 0.2 m/s in prose\",\r\n              \"whole_voyage_context\": {\r\n                \"start\": \"1997-03-19\",\r\n                \"end\": \"1997-03-27\",\r\n                \"is_exact_section_support\": false\r\n              }\r\n            },\r\n            {\r\n              \"id\": \"strahan-1997-12\",\r\n              \"observed_month\": \"1997-12\",\r\n              \"station_label\": \"41–49\",\r\n              \"width_km\": null,\r\n              \"width_range_km\": null,\r\n              \"width_description\": \"Narrower than March\",\r\n              \"strength_description\": \"Slightly stronger than March; maximum not transcribed\",\r\n              \"whole_voyage_context\": {\r\n                \"start\": \"1997-12-01\",\r\n                \"end\": \"1997-12-09\",\r\n                \"is_exact_section_support\": false\r\n              }\r\n            }\r\n          ]\r\n        },\r\n        \"protocol_file\": \"plans/zeehan-width-source-separation-protocol-v1.md\",\r\n        \"protocol_sha256\": \"fadd4e4eff23f524ccdd16aaa6e1f906bb46c9b2bc23dca8cc082c7865f82411\",\r\n        \"display_caption\": \"Approximate 40 km historical slope-current width near western Bass Strait, attributed to Baines et al. (1983). Numerical uncertainty and paired edges unknown; not a 1997 Strahan section width.\",\r\n        \"display_method_note\": \"Separate 1997 Strahan evidence: December is described as narrower and slightly stronger than March. Neither section has a numerical width here. Two occupations do not establish annual extrema or a monthly climatology; 300 m ADCP coverage is not the historical width layer.\",\r\n        \"audit_file\": \"research/zeehan-cresswell-2000-width-section-scope-audit.json\",\r\n        \"audit_sha256\": \"83b7c97d7d30ff2b2044bfc12316d99806b3005da5709afbf385a7f485c1f0c5\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"tsushima-matsuyama-1990-nearshore-modal-width\",\r\n      \"current_id\": \"tsushima\",\r\n      \"name\": \"Tsushima Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_campaign_modal_decay_estimate\",\r\n      \"width_metric\": \"coast_to_modal_decay_threshold_distance\",\r\n      \"approximate_width_km\": 22,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"reported_modal_estimate_with_unresolved_arithmetic_discrepancy\",\r\n      \"range_interpretation\": \"Reported 22 km; summary approximately 20 km and recalculation 23.0769 km describe the same estimate. They do not define a measured range or numerical uncertainty.\",\r\n      \"geographic_scope\": \"Nearshore branch over the continental shelf off the San’in coast, Japan Sea; not the entire Tsushima Current system.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Offshore y direction approximately northward from the east–west coast in the source model; paired edge coordinates unresolved.\",\r\n      \"layer\": \"First baroclinic mode under summer density stratification; eastward above the seasonal thermocline and westward below. No fixed width slab extracted.\",\r\n      \"time_convention\": \"Finite July–August 1980 campaign. Modal coefficient from the 8 August hydrographic profile; station and current-average durations differ. No homogeneous width occupation interval or recurring seasonal calendar assigned.\",\r\n      \"boundary_rule\": \"Offshore modal amplitude exp(-gamma_1*y), relative to its coastal value; adopted exp(-3) decay criterion (approximately 5%). Printed gamma_1=1.3e-4 m^-1.\",\r\n      \"source_url\": \"https://www.jstage.jst.go.jp/article/kaiyou1942/46/4/46_4_156/_pdf\",\r\n      \"source_citation\": \"Matsuyama, M. (1990), The Structure of the Nearshore Branch of the Tsushima Current on the Shelf off the San’in Coast in Summer, Journal of the Oceanographical Society of Japan 46(4):156–166, doi:10.1007/BF02125576.\",\r\n      \"source_locator\": \"Printed p165 / PDF page 10, Discussion decay equation and Summary(1); eigenvalue and fit method p161 / PDF page 6; station dates p158 and common average p159; separate Fig10 p164.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_original_campaign_modal_diagnosis\",\r\n      \"extraction_method\": \"Manual original equation and context transcription with visual verification; independently calculate printed arithmetic, without digitizing current boundaries.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"1980 coastal-branch modal estimate\",\r\n      \"phase_kind\": \"campaign_modal_decay_width\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Reported 22 km disagrees with 3/(1.3e-4) m = 23.0769 km; cause unresolved. Approximately 20 km is a summary of the same estimate. Fig10 caption 134°E conflicts with Discussion 132°E; the climatological section is separate support. Printed Eq8 plus sign is inconsistent with the stated exponential solution for real positive gamma; no correction inferred.\",\r\n      \"remaining_gates\": [\r\n        \"Resolve source differential-equation sign and arithmetic discrepancies; independent scientific admission.\",\r\n        \"Extract geographically located compatible boundaries and uncertainty.\",\r\n        \"Acquire repeat occupations before seasonal ranges or playback.\"\r\n      ],\r\n      \"modal_decay_context\": {\r\n        \"normalized_amplitude_equation\": \"Y(y)/Y(0)=exp(-gamma_1*y)\",\r\n        \"coastal_reference_amplitude\": 1,\r\n        \"printed_gamma_per_m\": 0.00013,\r\n        \"edge_exponent\": 3,\r\n        \"edge_relative_amplitude\": 0.049787068367863944,\r\n        \"source_rounded_relative_amplitude\": 0.05,\r\n        \"source_reported_width_km\": 22,\r\n        \"source_summary_width_km_approx\": 20,\r\n        \"recalculated_width_km\": 23.076923076923077,\r\n        \"arithmetic_discrepancy_unresolved\": true,\r\n        \"summary_is_independent_measurement\": false,\r\n        \"discrepancy_is_uncertainty_interval\": false,\r\n        \"coefficient_method\": \"Separation constant of density-profile eigenvalue problem (Eq7 with boundary conditions); least-squares fits current data to computed mode shapes, not an offshore velocity-coefficient fit.\",\r\n        \"model_assumptions\": [\r\n          \"Hydrostatic and Boussinesq approximations\",\r\n          \"Flat bottom and rigid lid\",\r\n          \"Zero initial potential vorticity; coast-relative exponential offshore mode\"\r\n        ],\r\n        \"fitted_current_modes\": [\r\n          \"barotropic\",\r\n          \"first_baroclinic\"\r\n        ],\r\n        \"campaign_context\": {\r\n          \"start\": \"1980-07-26\",\r\n          \"end\": \"1980-08-25\",\r\n          \"is_homogeneous_width_observation_period\": false\r\n        },\r\n        \"station_support\": [\r\n          {\r\n            \"station\": \"A\",\r\n            \"start\": \"1980-07-26\",\r\n            \"end\": \"1980-08-25\",\r\n            \"source_reported_days\": 31\r\n          },\r\n          {\r\n            \"station\": \"B\",\r\n            \"start\": \"1980-07-26\",\r\n            \"end\": \"1980-08-25\",\r\n            \"source_reported_days\": 31\r\n          },\r\n          {\r\n            \"station\": \"C\",\r\n            \"start\": \"1980-07-26\",\r\n            \"end\": \"1980-08-14\",\r\n            \"source_reported_days\": 19\r\n          },\r\n          {\r\n            \"station\": \"D\",\r\n            \"start\": \"1980-07-26\",\r\n            \"end\": \"1980-08-14\",\r\n            \"source_reported_days\": 19\r\n          },\r\n          {\r\n            \"station\": \"E\",\r\n            \"start\": \"1980-07-26\",\r\n            \"end\": \"1980-08-14\",\r\n            \"source_reported_days\": 19\r\n          }\r\n        ],\r\n        \"common_current_mean_period\": {\r\n          \"start\": \"1980-07-26\",\r\n          \"end\": \"1980-08-14\",\r\n          \"source_locator\": \"Printed p159, section4: common period for five-station time averages.\"\r\n        },\r\n        \"station_B_modal_mean_period\": {\r\n          \"start\": \"1980-07-26\",\r\n          \"end\": \"1980-08-25\",\r\n          \"source_locator\": \"Printed p162, Figure8 discussion: entire B record.\"\r\n        },\r\n        \"hydrographic_profile_support\": {\r\n          \"station\": \"H\",\r\n          \"date\": \"1980-08-08\",\r\n          \"latitude_degrees_north\": 36.15,\r\n          \"longitude_degrees_east\": 134.13333333333333,\r\n          \"role\": \"Density profile input for computed vertical modes; not a current edge.\"\r\n        },\r\n        \"instrument_context\": {\r\n          \"surface_offset_m\": 10,\r\n          \"bottom_offset_m\": 10,\r\n          \"sampling_interval_minutes\": 10,\r\n          \"is_fixed_width_layer\": false\r\n        },\r\n        \"shelf_context\": {\r\n          \"coast_to_200m_isobath_km\": [\r\n            15,\r\n            20\r\n          ],\r\n          \"is_width_range\": false\r\n        },\r\n        \"separate_hydrographic_climatology\": {\r\n          \"start_year\": 1964,\r\n          \"end_year\": 1985,\r\n          \"calendar_months\": [\r\n            7,\r\n            8,\r\n            9\r\n          ],\r\n          \"caption_longitude_degrees_east\": 134,\r\n          \"discussion_longitude_degrees_east\": 132,\r\n          \"longitude_conflict\": true,\r\n          \"is_1980_width_support\": false\r\n        },\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"summer_campaign_is_recurring_calendar\": false,\r\n        \"display_caption\": \"Coastal branch · reported modal width 22 km (summer 1980). Diagram illustrates the published exponential expression; its differential-equation sign remains unresolved. No mapped edge or seasonal range.\",\r\n        \"display_method_note\": \"The source adopts roughly 5% of coastal amplitude as the edge. Its printed coefficient gives 23.1 km; the paper reports 22 km and summarizes about 20 km. Arithmetic discrepancy unresolved; numerical uncertainty unknown.\",\r\n        \"offshore_equation_consistency\": {\r\n          \"source_locator\": \"Printed p161 / PDF page 6, Eq8 and following solution statement; original visually verified.\",\r\n          \"printed_equation\": \"d2Y_n/dy2+gamma_n^2*Y_n=0\",\r\n          \"stated_solution\": \"Y_n~exp(-gamma_n*y)\",\r\n          \"finding_class\": \"editorial_mathematical_consistency_check_not_author_correction\",\r\n          \"inconsistent_for_real_positive_gamma\": true,\r\n          \"sign_resolution\": null,\r\n          \"diagram_validates_printed_differential_equation\": false\r\n        },\r\n        \"audit_file\": \"research/tsushima-matsuyama-1990-modal-width-scope-audit.json\",\r\n        \"audit_sha256\": \"587cccbd45b3673137523241a2bbab07f3ee681e8f5549a7b44f0ae6ced90fb6\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"west-australian-glenn-2008-offshore-breadth-constraint\",\r\n      \"current_id\": \"west-australian\",\r\n      \"name\": \"West Australian Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": null,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"government_reported_greater_than_offshore_breadth\",\r\n      \"range_interpretation\": \"Reported offshore geographic breadth exceeds 1000 km in this synthesis. No representative width, finite upper end, statistical uncertainty, annual range or velocity-core boundaries extracted.\",\r\n      \"geographic_scope\": \"Broad equatorward surface flow offshore of Leeuwin in the southeastern Indian Ocean; no reproducible cross-flow transect or paired endpoints supplied.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Offshore geographic breadth in government synthesis, not a defined transverse velocity section.\",\r\n      \"layer\": \"Source describes equatorward surface current as shallow; no fixed numerical depth layer supplied for the breadth.\",\r\n      \"time_convention\": \"Undated geographic synthesis published 2008; publication year and adjacent summer inflow discussion do not date or season the breadth statement.\",\r\n      \"boundary_rule\": \"Issuer-reported greater-than geographic breadth. No velocity threshold, core edges, finite outer limit or section orientation extracted.\",\r\n      \"source_url\": \"https://www.ga.gov.au/bigobj/GA13412.pdf\",\r\n      \"source_citation\": \"Glenn, Nichol, Pattiaratchi, Daniell, Anderson, Borissova, Heap, Griffin and Fellows (2008), Vlaming Sub-Basin and Mentelle Basin: Environmental Summary, Geoscience Australia Record 2008/20, GeoCat 66577.\",\r\n      \"source_locator\": \"Section 6.3.5, printed pp71-72 / PDF pp87-88, offshore WAC paragraph; Figure 6.15 printed p66 / PDF p82 is schematic; copyright printed pii / PDF p3.\",\r\n      \"source_retrieved_date\": \"2026-10-09\",\r\n      \"source_evidence_kind\": \"government_geographic_synthesis_constraint_citing_prior_review\",\r\n      \"extraction_method\": \"Inequality transcribed from visually inspected original report prose. No contour digitization, current-axis diagnosis or conversion from the printed coordinate phrase.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Reported offshore geographic breadth\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Government environmental synthesis, not a primary width-section analysis. The report cites Schott and McCreary (2001); identical named-current numeric wording was not found in inspected review text. Printed latitude 60 E mixes coordinate type and hemisphere notation.\",\r\n      \"remaining_gates\": [\r\n        \"Recover the underlying velocity-based breadth definition and compatible layer/time support.\",\r\n        \"Resolve the printed coordinate-type conflict independently of the source inequality.\",\r\n        \"Review historical narrow-stream versus offshore-current naming without pooling dimensions.\",\r\n        \"Obtain repeated comparable sections before annual width ranges or map geometry.\",\r\n        \"Independent scientific and canonical admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"width_passage_visually_inspected\": true,\r\n        \"source_class\": \"government_environmental_synthesis\",\r\n        \"quantity_scope\": \"offshore_geographic_breadth_not_velocity_core_width\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"reference_scale_is_point_width\": false,\r\n        \"notation_is_rigorous_lower_bound\": false,\r\n        \"finite_upper_width_extracted\": false,\r\n        \"span_is_annual_range\": false,\r\n        \"publication_year_is_width_occupation\": false,\r\n        \"adjacent_summer_inflow_is_breadth_support\": false,\r\n        \"schematic_is_velocity_axis\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"coordinate_conflict\": {\r\n          \"source_phrase\": \"latitude 60 E\",\r\n          \"coordinate_type_agrees_with_hemisphere_notation\": false,\r\n          \"coordinate_repaired\": false,\r\n          \"used_for_kilometre_conversion\": false\r\n        },\r\n        \"historical_stream_context\": {\r\n          \"source_citation\": \"Andrews (1977), doi:10.1016/0146-6291(77)90517-3\",\r\n          \"source_access\": \"Publisher-indexed abstract; original full article remains unreviewed.\",\r\n          \"reported_width_km\": [\r\n            100,\r\n            200\r\n          ],\r\n          \"scope\": \"Narrow cyclonic stream with poleward coastal turn, distinct source convention from broad offshore equatorward flow.\",\r\n          \"is_range_endpoint_for_this_record\": false,\r\n          \"is_seasonal_width_extrema\": false\r\n        },\r\n        \"protocol_file\": \"plans/west-australian-breadth-constraint-protocol-v1.md\",\r\n        \"protocol_sha256\": \"c180fd59c91f61b0b835bf0739cc9a8cc8db0c8a52654832ca46bb466393cdbc\",\r\n        \"display_caption\": \"West Australian Current: report describes offshore geographic breadth >1000 km. Not a measured 1000 km point, finite width interval, statistical bound or seasonal range.\",\r\n        \"display_method_note\": \"Government synthesis, not a defined velocity section. The latitude 60 E coordinate phrase is inconsistent and is not converted to kilometres. Figure 6.15 is schematic; older 100-200 km cyclonic-stream width is separate naming context. No mapped band or seasonal playback inferred.\",\r\n        \"audit_file\": \"research/west-australian-glenn-2008-breadth-scope-audit.json\",\r\n        \"audit_sha256\": \"cae64ac5000db69c62c1c8d7bb2b1785c28a7dcd3ddec7cd9277caac27b6851e\"\r\n      },\r\n      \"reported_width_constraint\": {\r\n        \"kind\": \"issuer_reported_greater_than_geographic_breadth\",\r\n        \"reference_scale_km\": 1000,\r\n        \"source_notation\": \">1000 km\",\r\n        \"is_rigorous_lower_bound\": false,\r\n        \"representative_width_km\": null,\r\n        \"upper_bound_km\": null,\r\n        \"numerical_uncertainty_km\": null\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"humboldt-fuenzalida-2008-core-width\",\r\n      \"current_id\": \"peru-humboldt\",\r\n      \"name\": \"Peru (Humboldt) Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": 250,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"approximate_regional_point_no_reported_interval\",\r\n      \"range_interpretation\": \"One reported description with its own scope. No 250-350 km or 250-800 km range, representative whole-current width, uncertainty, confidence interval or annual extrema inferred.\",\r\n      \"geographic_scope\"
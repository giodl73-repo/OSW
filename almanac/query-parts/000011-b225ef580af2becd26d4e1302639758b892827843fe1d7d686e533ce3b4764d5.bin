sistencies are retained in the audit.\",\n          \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2022GL098163\",\n          \"source_locator\": \"Sections 2-4 and Figure 2-3 captions\",\n          \"observed_period\": null\n        }\n      ],\n      \"evidence_links\": [],\n      \"object_url\": \"object.html?id=current%3Aindian-south-equatorial-undercurrent\",\n      \"route_url\": \"reference-routes.html#indian-seuc-mam-reach-reference-path-candidate\",\n      \"season_url\": \"seasons.html?current=indian-south-equatorial-undercurrent\",\n      \"dashboard_search\": \"Indian Ocean South Equatorial Undercurrent South Indian Ocean\",\n      \"width_ids\": [\n        \"indian-seuc-bran-mam-core-spatial-summary\"\n      ],\n      \"measurement_ids\": [],\n      \"route_ids\": [\n        \"indian-seuc-mam-reach-reference-path-candidate\"\n      ],\n      \"source_ids\": [\n        \"source:4dc5fc618c26565f\",\n        \"source:4f7441b953be4651\",\n        \"source:803229fe82eb2360\",\n        \"source:a3441d003647d17d\",\n        \"source:b038491b0e5a3967\"\n      ],\n      \"state_codes\": [],\n      \"published_length_km\": null,\n      \"width_sample_ids\": [],\n      \"route_decision_ids\": [\n        \"route-decision:indian-south-equatorial-undercurrent\"\n      ],\n      \"current_section_ids\": [],\n      \"velocity_sample_ids\": []\n    },\n    {\n      \"id\": \"current:indonesian-throughflow\",\n      \"label\": \"Indonesian Throughflow\",\n      \"type\": \"named_current\",\n      \"identity_level\": \"system\",\n      \"source_kind\": \"interbasin passage system\",\n      \"setting\": \"regional\",\n      \"time_behavior\": \"persistent_variable\",\n      \"basin\": \"Maritime Continent / Pacific–Indian Ocean passage\",\n      \"capabilities\": {\n        \"observed_velocity\": 0,\n        \"radius_evidence\": 0,\n        \"reported_length\": 0,\n        \"reference_route\": 0,\n        \"scoped_width\": 0,\n        \"geometry
}\n      ],\n      \"state_evidence\": [],\n      \"connections\": [],\n      \"scope_notes\": [\n        {\n          \"current_id\": \"indonesian-throughflow\",\n          \"label\": \"Source-described passage network and exit observations\",\n          \"audit_file\": \"research/indonesian-throughflow-network-scope-audit.json\",\n          \"summary\": \"Twelve conceptual nodes and fourteen selected passage connections; three 2004–2006 exit transport means and eight published mooring sites. No whole-system length, geographic graph edges or transfer of integration widths to physical current width.\",\n          \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2008JC005257\",\n          \"source_locator\": \"Introduction paragraphs 3–4, Tables 1–2 and section 2.2\",\n          \"observed_period\": {\n            \"start_year\": 2004,\n            \"end_year\": 2006,\n            \"precision\": \"year\"\n          }\n        },\n        {\n          \"current_id\": \"indonesian-throughflow\",\n          \"label\": \"Measurement object scope: passage network\",\n          \"audit_file\": \"research/current-measurement-scopes/indonesian-throughflow.json\",\n          \"summary\": \"Measure each passage with explicit depth, period and boundary rules. Channel and transport-integration spans are not current-width boundaries.\",\n          \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2008JC005257\",\n          \"source_locator\": \"Existing cited current ledger entry and explicit component links; retained source-scope audit research/indonesian-throughflow-network-scope-audit.json\",\n          \"observed_period\": null,\n          \"measurement_scope_assessment\": true,\n          \"related_current_ids\": [],\n          \"related_proposed_current_ids\": []\n        }\n      ],\n      \"evidence_links\": [\n        {\n          \"label\": \"Open passage network card\",\n          \"url\": \"query.html?q=%7B%22collection%22%3A%22flow_networks%22%2C%22limit%22%3A50%2C%22filters%22%3A%5B%7B%22field%22%3A%22id%22%2C%22op%22%3A%22eq%22%2C%22value%22%3A%22flow-network%3Aindonesian-throughflow%22%7D%5D%7D&inspect=flow-network%3Aindonesian-throughflow\"\n        },\n        {\n          \"label\": \"Map exit transport mooring sites\",\n          \"url\": \"query.html?q=%7B%22collection%22%3A%22passage_samples%22%2C%22limit%22%3A50%2C%22filters%22%3A%5B%7B%22field%22%3A%22network_id%22%2C%22op%22%3A%22eq%22%2C%22value%22%3A%22flow-network%3Aindonesian-throughflow%22%7D%5D%7D\"\n        }\n      ],\n      \"object_url\": \"object.html?id=current%3Aindonesian-throughflow\",\n      \"route_url\": null,\n      \"season_url\": \"seasons.html?current=indonesian-throughflow\",\n      \"scope_audits\": [\n        {\n          \"schema\": \"osw.current-source-scope-audit.v1\",\n          \"current_id\": \"indonesian-throughflow\",\n          \"as_of\": \"2026-10-04\",\n          \"status\": \"source_supported_conceptual_network_not_scientific_taxonomy_admission\",\n          \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2008JC005257\",\n          \"source_access\": \"Publisher Introduction paragraphs 3–8, Tables 1–2 and section 2.2 read; no figure, field or transport time-series digitized.\",\n          \"source_locator\": \"Introduction paragraphs 3–4; Tables 1–2; section 2.2.\",\n          \"network_file\": \"research/indonesian-throughflow-network-input.json\",\n          \"summary\": \"Selected western/eastern inflow and three main exit pathways represented as twelve conceptual nodes and fourteen connections. Three exit transport means retain 2004–2006 support, processing-choice intervals and eight published first-deployment mooring positions. No geographic network edges, full system length, current width, annual extrema or instantaneous one-way-flow claim.\",\n          \"observed_period\": {\n            \"start_year\": 2004,\n            \"end_year\": 2006,\n            \"precision\": \"year\"\n          },\n          \"source_time_caution\": \"Abstract mentions January 2003; Table 1 explicitly reports 2004–2006 averages. Individual mooring deployment dates differ, including an August 2003 Ombai deployment. Preserve these distinctions.\",\n          \"integration_width_caution\": \"35/35/160 km are transport-integration widths, not current widths. Ombai geographic width is discussed as 37 km in paragraph 8, while transport calculations use 35 km. Neither provides a uniform current footprint.\",\n          \"whole_current_length_km\": null,\n          \"whole_current_width_km\": null,\n          \"annual_length_range_km\": null,\n          \"annual_width_range_km\": null,\n          \"rank_eligible\": false,\n          \"canonical_taxonomy_admitted\": false,\n          \"remaining_gates\": [\n            \"Assess full passage/depth coverage and reversals; no complete network asserted.\",\n            \"Recover axes and scientifically justify branch gates before measuring lengths.\",\n            \"Keep upstream and downstream transport budgets separate; no sum over graph edges.\",\n            \"Review original processing and observation gaps before new derived dimensions.\"\n          ]\n        },\n        {\n          \"schema\": \"osw.current-measurement-object-scope.v1\",\n          \"current_id\": \"indonesian-throughflow\",\n          \"name\": \"Indonesian Throughflow\",\n          \"status\": \"editorial_measurement_scope_assessment_not_physical_taxonomy_admission\",\n          \"scope_kind\": \"passage_network\",\n          \"summary\": \"Measure each passage with explicit depth, period and boundary rules. Channel and transport-integration spans are not current-width boundaries.\",\n          \"members\": [],\n          \"source_registry_file\": \"research/current-measurement-object-scope-index.json\",\n          \"basis_object_sha256\": \"6f438c549817bd4f0099f727b6244b62fc99ad4a9607e1f3ed1bc89f655e360e\",\n     
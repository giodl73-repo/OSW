   \"source_citation\": \"Korotaev, Oguz, Dorofeyev, Demyshev, Kubryakov and Ratner (2011), Development of Black Sea nowcasting and forecasting system, Ocean Science 7, 629-649, doi:10.5194/os-7-629-2011.\",\r\n      \"source_locator\": \"Section 3.1, printed page 632 (PDF page index 3), right column, paragraph describing the Rim Current above the continental slope.\",\r\n      \"source_retrieved_date\": \"2026-10-07\",\r\n      \"source_evidence_kind\": \"published_regional_literature_summary\",\r\n      \"extraction_method\": \"40–80 km range transcribed from original PDF prose, checked on the rendered page. No figure digitization, midpoint, bathymetric buffer or seasonal assignments.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Regional width description (2011 publication)\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"regional_range_context\": {\r\n        \"audit_file\": \"research/black-sea-rim-korotaev-2011-width-scope-audit.json\",\r\n        \"audit_sha256\": \"a292de32ff40d0d3ceeb731391ee9d692d6ed19c8b1042fc728317c7b0eca513\",\r\n        \"pycnocline_is_measurement_layer\": false,\r\n        \"boundary_coordinates_supplied\": false\r\n      },\r\n      \"remaining_gates\": [\r\n        \"Recover underlying width observations and paired boundaries with layer and occupation support.\",\r\n        \"Acquire compatible repeat sections before annual variation or seasonal map animation.\",\r\n        \"Independent scientific admission and protected-main publication.\"\r\n      ]\r\n    },\r\n    {\r\n      \"id\": \"alaska-coastal-gulf-jarosz-2017-typical-width\",\r\n      \"current_id\": \"alaska-coastal-gulf\",\r\n      \"name\": \"Alaska Coastal Current (Gulf of Alaska)\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_scalar_width_summary\",\r\n      \"width_metric\": \"author_reported_regional_current_scale\",\r\n      \"width_metric_label\": \"typical Gulf-of-Alaska coastal flow; regional prose synthesis\",\r\n      \"approximate_width_km\": 35,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"No annual extrema or numerical uncertainty interval supplied.\",\r\n      \"geographic_scope\": \"Gulf-of-Alaska coastal shelf current; no width transferred to offshore Alaska Current, Alaskan Stream or the Arctic/Bering namesake.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Unspecified in regional prose; no occupied section extracted.\",\r\n      \"layer\": \"Regional coastal-current description; no fixed measurement layer assigned to the typical-width statement.\",\r\n      \"time_convention\": \"Introductory regional literature summary in a 2017 winter study. The October 2012-March 2013 experiment dates do not date this typical width; seasonal variation is qualitative only.\",\r\n      \"boundary_rule\": \"Author-reported typical regional width; no paired boundaries, velocity threshold or width occupation interval assigned to the 35 km introduction statement.\",\r\n      \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1002/2016JC012102\",\r\n      \"source_citation\": \"Jarosz, Wang, Wijesekera, Pegau and Moum (2017), Flow variability within the Alaska Coastal Current in winter, JGR Oceans 122, 3884-3906, doi:10.1002/2016JC012102.\",\r\n      \"source_locator\": \"Section 1 Introduction, second paragraph: typical approximately 35 km width; distinct shelf circulation from subarctic gyre in preceding paragraph.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_regional_prose_synthesis\",\r\n      \"extraction_method\": \"Approximate 35 km scalar transcribed from publisher Introduction; no axis, footprint or paired edges reconstructed.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Typical Gulf-of-Alaska coastal width (regional summary)\",\r\n      \"phase_kind\": \"regional_scalar_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"regional_scalar_context\": {\r\n        \"audit_file\": \"research/alaska-coastal-gulf-jarosz-2017-regional-width-scope-audit.json\",\r\n        \"audit_sha256\": \"308e05e7c1c8122aaee0b917b85822b1162b8b25021aa0f77387eca11714843b\",\r\n        \"boundary_coordinates_supplied\": false,\r\n        \"bathymetry_is_measurement_layer\": false\r\n      },\r\n      \"remaining_gates\": [\r\n        \"Review original width definitions behind the introductory literature synthesis.\",\r\n        \"Obtain paired boundaries and compatible repeated sections before seasonal dimension ranges.\",\r\n        \"Independent scientific and canonical admission review.\"\r\n      ],\r\n      \"source_quality_note\": \"Typical-width literature statement, not a measured winter width from the article experiment. Original contributing definitions remain unreviewed.\"\r\n    },\r\n    {\r\n      \"id\": \"mindanao-schonau-2015-mean-surface-offshore-extent\",\r\n      \"current_id\": \"mindanao-current\",\r\n      \"name\": \"Mindanao Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_mean_surface_offshore_extent_range\",\r\n      \"width_metric\": \"author_reported_mean_surface_equatorward_offshore_extent\",\r\n      \"approximate_width_km\": null,\r\n      \"width_range_km\": [\r\n        250,\r\n        300\r\n      ],\r\n      \"range_kind\": \"author_reported_approximate_offshore_extent_of_mean_surface_flow\",\r\n      \"range_interpretation\": \"Approximate range in the author’s prose description of one averaged surface section; not uncertainty, seasonal extrema or a paired-boundary full width.\",\r\n      \"geographic_scope\": \"Oblique mean line from 8.16 N, 126.61 E to 8.77 N, 130 E off Mindanao. Profiles within 80 km were projected and objectively mapped; not an along-current envelope.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Oblique mean line; reported offshore distance retained without converting it to paired cross-flow edges.\",\r\n      \"layer\": \"Surface expression of averaged absolute geostrophic equatorward flow. The 0–1000 m glider velocity reference is not a fixed measurement layer for this extent.\",\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"time_convention\": \"Spatial and temporal mean of glider profiles; campaign context June 2009–July 2014. Exact contributing dates of the Figure 2 mean unresolved.\",\r\n      \"boundary_rule\": \"Author-reported offshore extent of equatorward mean flow, not a diagnosed pair of current boundaries. Figure 2 contours are 0.1 m/s intervals; no numerical extent threshold assigned.\",\r\n      \"source_url\": \"https://www.soest.hawaii.edu/oceanography/bo/Schonau_etal_TOS2015.pdf\",\r\n      \"source_citation\": \"Schönau et al. (2015), The Mindanao Current: Mean Structure and Connectivity, Oceanography 28(4), 34–45, doi:10.5670/oceanog.2015.79.\",\r\n      \"source_locator\": \"Printed p.38 / PDF p.6, Velocity and Transport, glider paragraph and Figure 2a; mean-line sampling described on pp.36–37 / PDF pp.4–5.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_observational_mean_section_description\",\r\n      \"extraction_method\": \"250–300 km transcribed from p.38 prose after inspecting Figure 2a; no edge digitization, midpoint or route buffer.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"calendar_months\": null,\r\n      \"observed_period\": null,\r\n      \"boundary_sides\": \"author_reported_one_sided_offshore_extent\",\r\n      \"phase_label\": \"glider mean surface offshore extent\",\r\n      \"phase_kind\": \"mean_offshore_extent_range\",\r\n      \"remaining_gates\": [\r\n        \"Obtain contributing profile dates and machine-readable velocity fields.\",\r\n        \"Diagnose paired edges with a consistent threshold before full-width or seasonal ranges.\",\r\n        \"Independent scientific and canonical admission review.\"\r\n      ],\r\n      \"mean_offshore_context\": {\r\n        \"mean_line_endpoints_lon_lat\": [\r\n          [\r\n            126.61,\r\n            8.16\r\n          ],\r\n          [\r\n            130,\r\n            8.77\r\n          ]\r\n        ],\r\n        \"projection_corridor_km\": 80,\r\n        \"velocity_method\": \"absolute_geostrophic_referenced_to_glider_depth_average\",\r\n        \"velocity_reference_depth_range_m\": [\r\n          0,\r\n          1000\r\n        ],\r\n        \"campaign_context_months\": {\r\n          \"start\": \"2009-06\",\r\n          \"end\": \"2014-07\"\r\n        },\r\n        \"campaign_context_is_mean_sampling_interval\": false,\r\n        \"source_date_discrepancy\": \"p.35 describes intended repeated sections June 2009–January 2014; p.36 reports deployments June 2009–July 2014. Neither supplies exact profiles entering Figure 2.\",\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"velocity_threshold_m_s\": null,\r\n        \"offshore_secondary_core_may_be_eddy\": true,\r\n        \"secondary_core_location_is_current_width\": false,\r\n        \"transport_integration_limit_is_current_width\": false,\r\n        \"audit_file\": \"research/mindanao-schonau-2015-mean-offshore-extent-scope-audit.json\",\r\n        \"audit_sha256\": \"6d5ff66c68d353d6f34bd3440945327baca6578d130a2014bd439c1af37f376d\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"agulhas-return-boebel-2003-adcp-a\",\r\n      \"current_id\": \"agulhas-return\",\r\n      \"name\": \"Agulhas Return Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_multilayer_ADCP_threshold_width\",\r\n      \"width_metric\": \"median_across_ADCP_depth_bins_of_flow_normal_half_maximum_isotach_distance\",\r\n      \"approximate_width_km\": 48,\r\n      \"reported_total_error_km\": 14,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"Source ± total error estimate is stored separately; no confidence level or seasonal range supplied. Projection error is already a component of total error.\",\r\n      \"geographic_scope\": \"Near 39 S, 22 E; source body differs from preliminary poster 23 E. Local Seward Johnson cruise crossing, not the full current envelope.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Flow-normal projection for each depth bin; source reports a median across bin widths.\",\r\n      \"layer\": \"Near-surface and upper-ocean ADCP bins; deepest reported bin 325–375 m, nominal center 350 m. Width is a median across bins, not a fixed-depth surface width or 0–1000 m width.\",\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"time_convention\": \"1997 cruise context only; exact dates of this crossing not extracted. Figure 3a MODAS SSH date 1997-08-23 is contextual imagery; source says cruise ends 10 days later. Exact dates of the four crossings are not extracted. Crossings b2 and c approximately one day apart.\",\r\n      \
 or season-specific flow estimate.\",\n          \"junction_coordinate\": null,\n          \"transport_sv\": null,\n          \"canonical_admission\": false,\n          \"diagram_role\": \"schematic_identity_connection_not_measured_flow_path\",\n          \"remaining_gates\": [\n            \"Review vertical, seasonal and naming conventions against physical observations.\",\n            \"Diagnose physical feeding and splitting before any junction coordinates or transport fractions.\",\n            \"Do not inherit lengths, widths, footprints or state relations across the link.\"\n          ]\n        }\n      ],\n      \"scope_notes\": [],\n      \"evidence_links\": [],\n      \"object_url\": \"object.html?id=current%3Aalaska\",\n      \"route_url\": \"reference-routes.html#alaska-reference-path-candidate\",\n      \"season_url\": \"seasons.html?current=alaska\",\n      \"dashboard_search\": \"Alaska Current North Pacific\",\n      \"width_ids\": [\n        \"alaska-weingartner-2002-regional-width\"\n      ],\n      \"measurement_ids\": [],\n      \"route_ids\": [\n        \"alaska-reference-path-candidate\"\n      ],\n      \"source_ids\": [\n        \"source:4556886a82d6f61a\",\n        \"source:4dc5fc618c26565f\",\n        \"source:4f7441b953be4651\",\n        \"source:803229fe82eb2360\",\n        \"source:b038491b0e5a3967\"\n      ],\n      \"state_codes\": [],\n      \"published_length_km\": null,\n      \"width_sample_ids\": [],\n      \"route_decision_ids\": [\n        \"route-decision:alaska\"\n      ],\n      \"current_section_ids\": [],\n      \"velocity_sample_ids\": []\n    },\n    {\n      \"id\": \"current:aleutian\",\n      \"label\": \"Aleutian Current\",\n      \"type\": \"named_current\",\n      \"identity_level\": \"current\",\n      \"source_kind\": \"eastward subpolar-gyre current\",\n      \"setting\": \"polar_or_subpolar_margin\",\n      \"time_behavior\": \"persistent_variable\",\n      \"basin\": \"Subpolar North Pacific\",\n      \"capabil
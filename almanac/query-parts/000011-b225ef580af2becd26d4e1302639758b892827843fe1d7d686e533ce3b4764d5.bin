328ba4e8bde28aef9627121b0749b21ce33730c477f313b68d7f\"\n      },\n      \"latest_observation_date\": null,\n      \"claim_review_counts\": {\n        \"not_individually_reviewed\": 56\n      },\n      \"linked_source_count\": 5,\n      \"map_features\": [\n        {\n          \"geometry\": {\n            \"coordinates\": [\n              112,\n              -28\n            ],\n            \"type\": \"Point\"\n          },\n          \"role\": \"editorial_locator\",\n          \"note\": \"Approximate editorial locator points place a name in a recognizable region on the OSW equirectangular map. Points are neither observed cores nor endpoints or length measurements. Multi-basin family names have one point per basin and must be split into separate records before quantitative comparison.\",\n          \"geometry_id\": \"geometry:0080\",\n          \"coordinate_reference_system\": \"OGC:CRS84\",\n          \"positional_uncertainty\": \"not quantified; no observed current core or path\",\n          \"source_id\": \"source:4dc5fc618c26565f\"\n        }\n      ],\n      \"state_evidence\": [],\n      \"connections\": [],\n      \"scope_notes\": [\n        {\n          \"current_id\": \"west-australian\",\n          \"label\": \"Offshore West Australian versus coastal Leeuwin flow\",\n          \"audit_file\": \"research/west-australian-current-naming-seasonal-scope-audit.json\",\n          \"summary\": \"Modern West Australian Current means broad northward offshore flow, distinct from coastal southward Leeuwin. Andrews (1977) used the name for a cyclonic stream turning poleward: its reported 800 km trough extent and 100-200 km stream width remain historical source context, not admitted dimensions for this current or seasonal extrema. Whole-current axis, endpoints, width and annual ranges remain unresolved.\",\n          \"source_url\": \"https://glossary.ametsoc.org/wiki/west-australian-current/\",\n          \"source_locator\": \"West Australian Current definition paragraphs\",\n          \"observed_period\": null,\n          \"related_current_ids\": [\n            \"leeuwin\"\n          ],\n          \"supporting_sources\": [\n            {\n              \"label\": \"Historical naming and dimensions: Andrews (1977)\",\n              \"url\": \"https://www.sciencedirect.com/science/article/pii/0146629177905173\",\n              \"locator\": \"Publisher abstract\",\n              \"access\": \"Indexed abstract inspected; full paper unavailable and not reviewed.\"\n            },\n            {\n              \"label\": \"Separate coastal flows and model limits: Yit Sen Bull and van Sebille (2016)\",\n              \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1002/2015JC011486\",\n              \"locator\": \"Introduction and sections 2.1-2.4\",\n              \"access\": \"Relevant full-text sections inspected; no model data or geometry extracted.\"\n            }\n          ]\n        }\n      ],\n      \"evidence_links\": [\n        {\n          \"label\": \"Compare twelve surrounding offshore source-vector maps\",\n          \"url\": \"../figures/west-australian-oscar-2d-source.svg\"\n        },\n        {\n          \"label\": \"Query surrounding monthly source fields and paired support\",\n          \"url\": \"query.html?source-q=%7B%22document%22%3A%22research%2Fwest-australian-oscar-2d-monthly-source-fields.json%22%2C%22pointer%22%3A%22%2Fmonths%22%2C%22limit%22%3A1%2C%22offset%22%3A0%7D#source-query-title\"\n        },\n        {\n          \"label\": \"Compare refined regional lengths with the Euler baseline\",\n          \"url\": \"../figures/west-australian-regional-streamlines-rk4.svg\"\n        },\n        {\n          \"label\": \"See refined regional paths and retained failures\",\n          \"url\": \"../figures/west-australian-regional-streamline-paths-rk4.svg\"\n        },\n        {\n          \"label\": \"Query all117refined regional path attempts\",\n          \"url\": \"query.html?source-q=%7B
a7f6c853505266f62c028b7910\",\n    \"research/kuroshio-liu-gan-2012-stream-mean-width-scope-audit.json\": \"607924d8b2f54393fcb150bd29b6e08f5abc99616e72b9142f879a17ded83fcd\",\n    \"research/source-data/kuroshio-liu-gan-2012/acquisition.json\": \"3c067c722f79ee4688de6adb176849587ce40e1612e4cd035ba4f2993eafac0d\",\n    \"research/source-data/kuroshio-liu-gan-2012/journal-article.pdf\": \"a452007ff7f3b0051f811ba8172e9ae7932642ed1916a29c779db6335772203b\"\n  },\n  \"config_file\": \"research/source-data/kuroshio-liu-gan-2012/figure7a-time-extraction.json\",\n  \"protocol_file\": \"plans/kuroshio-filtered-width-time-series-protocol-v1.md\",\n  \"generator_file\": \"analysis/build_kuroshio_filtered_width_series.py\",\n  \"generator_sha256\": \"7ae9485fc37be7e6688c16dfc6f26d00ff589f64fd64c26d19ee9495d7e61beb\",\n  \"extraction_runtime\": {\n    \"pymupdf\": \"1.28.2\"\n  },\n  \"width_metric\": \"half_year_filtered_regional_mean_diagnosed_axis_normal_0.1m_s_threshold_width\",\n  \"units\": \"km\",\n  \"layer\": \"Surface absolute geostrophic diagnosis; no fixed-depth section boundaries extracted.\",\n  \"geographic_scope\": \"Source stream mean between122–130E in the East China Sea, not the whole Kuroshio.\",\n  \"source_study_period_years\": [\n    1993,\n    2008\n  ],\n  \"source_product\": \"AVISO updated merged absolute surface geostrophic velocity; ADT = SLA + MDT\",\n  \"source_temporal_resolution\": \"7-day averaged gridded product\",\n  \"source_method_context\": {\n    \"original_grid_degrees\": 0.3333333333333333,\n    \"analysis_interpolation_grid_degrees\": 0.1,\n    \"grid_interpolation_is_new_observation_resolution\": false,\n    \"averaging_order\": \"Stream-coordinate diagnostics including section width calculated every 7 days, then temporal and along-stream summaries; not width diagnosed from a seasonal mean velocity field.\",\n    \"source_quality_note\": \"Weekly averaged and smoothed surface geostrophic product; ageostrophic flow is not included in t
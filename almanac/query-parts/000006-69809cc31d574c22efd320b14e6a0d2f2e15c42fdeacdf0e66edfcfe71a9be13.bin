e_interval\": false,\n  \"seasonal_playback_eligible\": false,\n  \"geographic_playback_eligible\": false,\n  \"chart_playback_eligible\": true,\n  \"scope_note\": \"Month-midpoint readings of the published half-year-filtered East China Sea regional mean width curve. Month labels are graphical positions, not independent monthly means or exact observation dates. Kernel and averaging details are unresolved; reading allowances are not physical uncertainty, annual extrema or whole-current widths.\",\n  \"cautions\": [\n    \"Month labels identify sampled positions on the published filtered curve, not independently observed monthly means or exact timestamps.\",\n    \"The weekly surface geostrophic diagnosis excludes ageostrophic flow. Interpolating the original one-third-degree grid to0.1degrees adds no independent observation resolution.\",\n    \"The source half-year filter kernel, alignment, endpoint treatment and detailed weights remain unresolved.\",\n    \"Reading intervals reflect graphical/calibration/rounding allowance, not measurement uncertainty, confidence or annual physical variation.\",\n    \"Existing seasonal spatial profiles and218/207/210km prose means remain separate and unchanged; no new geographic edges or whole-current dimension.\"\n  ]\n}\n","document":{"schema":"osw.filtered-current-width-plot-time-series.v1","current_id":"kuroshio","status":"editorial_source_plot_readings_scientific_review_pending","source_url":"https://www.sciencedirect.com/science/article/pii/S0967063711001968","source_citation":"Liu and Gan (2012), Variability of the Kuroshio in the East China Sea derived from satellite altimetry data, Deep-Sea Research I 59, 25-36, doi:10.1016/j.dsr.2011.10.008.","source_locator":"Figure7a and caption, printed page30/PDF6; section3.3 printed pages30–31; method section2.2.","input_sha256":{"research/source-data/kuroshio-liu-gan-2012/figure7a-time-extraction.json":"05a0be59242a846390472334c834c71b24cfc93302d82327d43933f3ee2a0729","plans/kuroshio-filtered-width-time-series-protocol-v1.md":"b9bc5e3480d3917de88df916c6a1d1325c8950a7f6c853505266f62c028b7910","research/kuroshio-liu-gan-2012-stream-mean-width-scope-audit.json":"607924d8b2f54393fcb150bd29b6e08f5abc99616e72b9142f879a17ded83fcd","research/source-data/kuroshio-liu-gan-2012/acquisition.json":"3c067c722f79ee4688de6adb176849587ce40e1612e4cd035ba4f2993eafac0d","research/source-data/kuroshio-liu-gan-2012/journal-article.pdf":"a452007ff7f3b0051f811ba8172e9ae7932642ed1916a29c779db6335772203b"},"config_file":"research/source-data/kuroshio-liu-gan-2012/figure7a-time-extraction.json","protocol_file":"plans/kuroshio-filtered-width-time-series-protocol-v1.md","generator_file":"analysis/build_kuroshio_filtered_width_series.py","generator_sha256":"7ae9485fc37be7e6688c16dfc6f26d00ff589f64fd64c26d19ee9495d7e61beb","extraction_runtime":{"pymupdf":"1.28.2"},"width_metric":"half_year_filtered_regional_mean_diagnosed_axis_normal_0.1m_s_threshold_width","units":"km","layer":"Surface absolute geostrophic diagnosis; no fixed-depth section boundaries extracted.","geographic_scope":"Source stream mean between122–130E in the East China Sea, not the whole Kuroshio.","source_study_period_years":[1993,2008],"source_product":"AVISO updated merged absolute surface geostrophic velocity; ADT = SLA + MDT","source_temporal_resolution":"7-day averaged gridded product","source_method_context":{"original_grid_degrees":0.3333333333333333,"analysis_interpolation_grid_degrees":0.1,"grid_interpolation_is_new_observation_resolution":false,"averaging_order":"Stream-coordinate diagnostics including section width calculated every 7 days, then temporal and along-stream summaries; not width diagnosed from a seasonal mean velocity field.","source_quality_note":"Weekly averaged and smoothed surface geostrophic product; ageostrophic flow is not included in the width diagnosis. Interpolation to 0.1 degree does not add independent observation resolution. Exact spatial/temporal weighting and season-to-month convention remain unresolved."},"source_temporal_filter":{"source_label":"1/2 year filtered mean","kernel":null,"window_alignment":null,"endpoint_treatment":null,"filter_reproduced":false},"sample_time_kind":"month_midpoint_positions_between_printed_year_ticks_not_exact_UTC_dates","plot_coordinate_allowance_years":0.05,"monthly_sampling_is_new_source_resolution":false,"samples_are_raw_monthly_means":false,"independent_sample_count":null,"source_curve_segment_count":755,"source_curve_breaks":[{"before_segment_index":112,"after_segment_index":113,"before_end_pdf_points":[197.127,325.03198],"after_start_pdf_points":[197.127,325.03299],"separation_pdf_points":0.001010000000007949,"link_added":false}],"source_curve_breaks_bridged":false,"source_curve_sha256":"32a82a5f6f4b4031a7f1c0370356db30fa892309b53640b0cae9f2b244016a7d","source_curve_vertices_are_observations":false,"continuous_graphic_proves_complete_observation_record":false,"samples":[{"id":"kuroshio-ecs-filtered-width-plot-1993-01","sample_label":"1993-01 (filtered plot sample)","plot_year":1993.0416666666667,"plot_year_label":1993,"plot_month_label":1,"sample_time_is_observation_date":false,"target_x_pdf_points":151.05275,"brackets":[{"segment":{"segment_index":1,"source_path_index":474,"path_segment_index":1,"start_pdf_points":[150.87,317.689],"end_pdf_points":[151.125,319.168]},"fraction_from_segment_start":0.7166666666666741,"interpolated_y_pdf_points":318.74895000000004}],"raw_plot_width_km":225.4609424414927,"approximate_width_km":225,"plot_reading_interval_km":[220,230],"status":"resolved_filtered_curve_plot_reading"},{"id":"kuroshio-ecs-filtered-width-plot-1993-02","sample_label":"1993-02 (filtered plot sample)","plot_year":1993.125,"plot_year_label":1993,"plot_month_label":2,"sample_time_is_observation_date":false,"target_x_pdf_points":152.64225000000002,"brackets":[{"segment":{"segment_index":6,"source_path_index":474,"path_segment_index":6,"start_pdf_points":[152.60399,325.33899],"end_pdf_points
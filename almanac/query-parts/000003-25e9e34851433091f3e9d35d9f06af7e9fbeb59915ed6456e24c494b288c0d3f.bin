source_time_index":452},{"latitude_degrees_north":40.4989013671875,"layer_mean":{"eastward_m_s":-0.17662500068545342,"joint_valid_thickness_m":200.0,"northward_m_s":0.09157500062137842},"longitude_degrees_east":178.99789428710938,"observed_at":"1993-07-18T11:57:00Z","source_time_index":453},{"latitude_degrees_north":40.49869918823242,"layer_mean":{"eastward_m_s":-0.17947500199079514,"joint_valid_thickness_m":200.0,"northward_m_s":0.09897500053048133},"longitude_degrees_east":178.9945068359375,"observed_at":"1993-07-18T12:57:00Z","source_time_index":454},{"latitude_degrees_north":40.49509811401367,"layer_mean":{"eastward_m_s":-0.1832000009715557,"joint_valid_thickness_m":200.0,"northward_m_s":0.10282500013709069},"longitude_degrees_east":178.9886016845703,"observed_at":"1993-07-18T13:57:00Z","source_time_index":455},{"latitude_degrees_north":40.3651008605957,"layer_mean":{"eastward_m_s":-0.11545000039041042,"joint_valid_thickness_m":200.0,"northward_m_s":0.11702499967068433},"longitude_degrees_east":178.9929962158203,"observed_at":"1993-07-18T14:57:00Z","source_time_index":456},{"latitude_degrees_north":40.1775016784668,"layer_mean":{"eastward_m_s":-0.07460000030696393,"joint_valid_thickness_m":200.0,"northward_m_s":0.10627499911934138},"longitude_degrees_east":178.99899291992188,"observed_at":"1993-07-18T15:57:00Z","source_time_index":457},{"latitude_degrees_north":40.018699645996094,"layer_mean":{"eastward_m_s":-0.10212500020861626,"joint_valid_thickness_m":200.0,"northward_m_s":0.07647500056773424},"longitude_degrees_east":179.00180053710938,"observed_at":"1993-07-18T16:57:00Z","source_time_index":458},{"latitude_degrees_north":40.00149917602539,"layer_mean":{"eastward_m_s":-0.0717000003089197,"joint_valid_thickness_m":200.0,"northward_m_s":0.06889999993145465},"longitude_degrees_east":179.00230407714844,"observed_at":"1993-07-18T18:57:00Z","source_time_index":460},{"latitude_degrees_north":40.00450134277344,"layer_mean":{"eastward_m_s":-0.08969999998807907,"joint_valid_thickness_m":200.0,"northward_m_s":0.05342500063125044},"longitude_degrees_east":179.0019073486328,"observed_at":"1993-07-18T19:57:00Z","source_time_index":461}],"schema":"osw.observed-component-spans.v1","seasonal_playback_supported":false,"sensitivity_is_confidence_interval":false,"status":"exploratory_component_spans_pending_review","whole_current_width_km":null,"width_rank_eligible":false},"entity_id":"current:aleutian","id":"diagnostic:current-research:aleutian","label":"Aleutian / Subarctic Current research evidence","rank_eligible":false,"research_evidence":{"additional_figures":[{"alt":"Measured in-situ ITS-90 temperature and PSS-78 salinity at 17 casts; QC2 cells and other quality codes distinguished; original velocity profiles and 84 candidate timing/distance offsets. No interpolated physical current edges.","file":"figures/aleutian-p14n-1993-hydrography-correspondence.svg","label":"CTD properties and pairing offsets"},{"alt":"Both branch windows show actual vector means, half-peak crossings and native brackets; fourteen finite threshold and velocity scenarios remain separate. North about 100 km and south about 80 km are local component spans, not physical widths or annual ranges.","file":"figures/aleutian-p14n-1993-component-spans.svg","label":"Component spans and sensitivity"},{"alt":"Actual native observation latitude, ship-speed magnitude and both 100\u2013300 m ocean velocity components against UTC ensemble end. Recorded CTD begin/end intervals and fixed ship-speed scenarios remain distinct. Source editing flags, gaps and uncertainty do not define physical current edges.","file":"figures/aleutian-p14n-1993-native-vector-support.svg","label":"Native vectors and ship-motion support"},{"alt":"Six panels compare northern and southern 100\u2013300 m eastward means for fixed 30, 60 and 150 minute windows and all three ship-speed cutoffs. Horizontal bars are contributor latitude footprints, not uncertainty or edges. Hollow markers have less than 80% time coverage. All 54 relative-peak and 72 velocity-sensitivity scenarios remain unresolved. Station gaps are not bridged; no physical width or annual range is admitted.","file":"figures/aleutian-p14n-1993-underway-averages.svg","label":"Native averages: unresolved boundaries"},{"alt":"Whole-run eastward means and spatial footprints remain in source order. Dashed links assume temporal comparability across eligible gaps, not measured velocities inside them. The complete 126-case matrix retains all 18 unresolved nominal half-peak cases and 18 successful sensitivity cases under other thresholds. Successful northern spans of about 80\u2013140 km use roughly 23 hours of bracketing observations; these are separate assumptions, not a physical width range or uncertainty interval.","file":"figures/aleutian-p14n-1993-run-composite.svg","label":"Conditional run composite: gap assumptions"}],"additional_tables":[{"caption":"Native averaging support across the full 40\u201348 N reach. Counts are retained bins, not boundary support inside either branch. Every experiment has 6 relative-peak and 8 velocity-sensitivity cases across both branches; none resolve two crossings.","headers":["Minimum ship speed (m/s)","Window (minutes)","All retained bins","Bins with \u226580% coverage","Resolved boundary cases"],"rows":[["1.0","30","128","95","0 / 14"],["1.0","60","81","41","0 / 14"],["1.0","150","53","16","0 / 14"],["2.0","30","103","92","0 / 14"],["2.0","60","57","39","0 / 14"],["2.0","150","29","16","0 / 14"],["3.0","30","96","85","0 / 14"],["3.0","60","54","37","0 / 14"],["3.0","150","27","15","0 / 14"]]},{"caption":"Conditional run composite: all northern and southern nominal 50% spans remain unresolved. The resolved-case count includes other thresholds under explicit gap assumptions; cases are not independent observations and their separations are not a physical width range.","headers":["Minimum ship speed (m/s)","Maximum unobserved gap (h)","North nominal 50%","South nominal 50%","Resolved sensitivity cases"],"rows":[["1.0","3","Unresolved","Unresolved","0 / 14"],["1.0","6","Unresolved","Unresolved","3 / 14"],["1.0","12","Unresolved","Unresolved","3 / 14"],["2.0","3","Unresolved","Unresolved","0 / 14"],["2.0","6","Unresolved","Unresolved","3 / 14"],["2.0","12","Unresolved","Unresolved","3 / 14"],["3.0","3","Unresolved","Unresolved","0 / 14"],["3.0","6","Unresolved","Unresolved","3 / 14"],["3.0","12","Unresolved","Unresolved","3 / 14"]]}],"annual_width_range_km":null,"current_id":"aleutian","diagnostic_id":"diagnostic:current-research:aleutian","facts":[{"label":"Observed sampling","value":"132 profiles \u00b7 13\u201318 July 1993"},{"label":"Joint vector support","value":"4,030 / 4,092 positions"},{"label":"Primary depth layer","value":"100\u2013300 m"},{"label":"Supported layer means","value":"131 / 132 profiles"},{"label":"Companion hydrography","value":"17 casts \u00b7 84 candidate profile pairs"},{"label":"Local 50% component spans","value":"North \u2248100 km \u00b7 south \u224880 km"},{"label":"Complete declared scenarios","value":"14 / 14 resolved"},{"label":"Native regional support","value":"1,585 profiles \u00b7 1,582 layer means"},{"label":"Native underway eligibility","value":"568 profiles \u00b7 19 runs at \u22652 m/s"},{"label":"Native averaging boundary tests","value":"126 / 126 unresolved"},{"label":"Conditional run-composite tests","value":"18 / 126 sensitivity cases resolve; all nominal 50% cases unresolved"},{"label":"Physical current width","value":"Unknown"}],"figure_alt":"Unconnected P14N sampling locations; observed eastward and northward velocity by latitude and depth; 100\u2013300 m layer means with a gap break. Missing values are marked and no physical current boundaries are drawn.","figure_file":"figures/aleutian-p14n-1993-observed-vectors.svg","figure_label":"Observed velocity section","figure_sha256":"a70b7e8f75ec5e810ab7d6e88e88a1a946028219409a7c9df3a200408161a867","finding":"The July 1993 observations resolve local eastward-component spans of about 100 km in the northern branch window and 80 km in the southern window. Threshold-choice envelopes are 90\u2013110 km and 60\u201390 km. Temporal crossings, velocity sensitivity and nearby eddy flow prevent treating these as verified physical current widths.","geometry_role":"research_evidence_no_current_axis_or_physical_width_geometry","kind":"current_research_evidence","label":"Aleutian / Subarctic Current","new_width_record_admitted":false,"next_evidence":"The separate declared run composite does not recover nominal half-peak boundaries under any tested gap cap. Eighteen other threshold cases resolve only under temporal-comparability assumptions and about 23 hours of bracketing observations. Independent repeated sections, branch/eddy attribution and transverse boundary support remain required; do not tune thresholds to replace the unresolved nominal result.","notes":["Hourly archive means at 10 m depth levels are reduced products, not the native five-minute ensembles or four-metre acquisition bins.","Layer means use midpoint cell thickness clipped to 100\u2013300 m, joint u/v validity and at least 160 m valid support. Missing velocities remain missing; no vertical interpolation or component-to-speed substitution.","The source track has 16 northward latitude steps and one two-hour gap. Points remain in acquisition order. The plot breaks the mean curve at the long gap; it does not silently fit a monotone current crossing.","The paper places Subarctic branches near 42 N and 45 N. Fixed 41\u201343 N and 44\u201346 N windows are search context, not physical edges. The westward Alaskan Stream and Bering-side Aleutian North Slope Current are distinct.","Provider metadata describe GPS selective availability, heading correction and CTD wire interference editing. Per-cell native editing history is not included in this reduced archive.","One July 1993 transect is not a seasonal climatology or annual width range. No current-edge geometry, full width, uncertainty interval or seasonal playback is admitted. The separate 2013 OSCAR component diagnostic is retained.","A separate whole-run composite explicitly tests interpolation between summary positions under 3/6/12 hour gap caps, a 25 km unobserved-distance cap and unchanged source-order/quality barriers. All 18 nominal half-peak cases remain unresolved. Only northern 60% and positive threshold-offset cases resolve with 6/12 hour caps: 18 of 126 cases. Their about 80\u2013140 km separations are different assumptions, not a width range. Their full bracketing observations span about 23 hours; temporal comparability and physical branch identity remain unverified. This does not replace the earlier no-bridge negative result.","A separate exploratory OSW operator averages native supported layer means within each contiguous underway run, using fixed 30/60/150 minute windows and 1/2/3 m/s ship-speed cutoffs. Overlapping ensemble time is counted once and boundary analysis requires at least 80% of the full window duration. All 54 relative-peak and 72 velocity-sensitivity cases lack two resolved crossings. No station gap is bridged; run ends and incomplete windows cannot substitute for boundaries.","The separate native products retain 1,585 regional ensemble profiles and 190,200 depth cells in their original files. There are 1,582 supported 100\u2013300 m means and 182,081 jointly finite unflagged vectors. CODAS editing bits are distinct from CTD WOCE quality codes.","Fixed ship-speed eligibility at 1/2/3 m/s gives 623/568/532 profiles in 42/19/19 contiguous runs. Every run remains available, including short ones. Source gaps, missing support and ineligible profiles break runs; no latitude sorting or station-gap bridge is applied.","All 685 profiles whose nominal ensemble intervals overlap recorded CTD BE\u2013EN events fall outside the \u22652 m/s eligibility class. This event/speed agreement is context, not proof of depth-specific simultaneity or a new CTD-wire interference flag.","Short-product ocean velocities already include ship motion; numerical correspondence with the long relative-water/absolute-ship fields is checked. Actual ensemble durations are 300 seconds; timestamps and positions refer to ensemble end, and depths are nominal bin centres. OSW applies no further temporal ocean-velocity averaging in this audit.","All 14 declared component scenarios resolve within the original fixed windows. Nominal half-peak endpoint separations are about 100 km north and 80 km south; 40/50/60% envelopes are 90\u2013110 km and 60\u201390 km, not error bounds or annual ranges.","The northern first crossing bracket spans only 0.34 km in one hour near a CTD occupation. Nominal bracketing observations span about 13 hours north and 14 hours south. Temporal change can masquerade as a spatial edge.","Separate \u00b10.02 and \u00b10.06 m/s threshold-comparator scenarios yield roughly 43\u2013152 km north and 56\u201390 km south. They explore GPS-related hourly velocity sensitivity; they are not a total error budget or a confidence interval. No rotation to a flow-normal width is applied.","Companion CCHDO hydrography retains 17 casts and all 84 qualifying cast-to-hourly-profile pairs within three hours of nominal cast-bottom time and 15 km. No nearest-only selection or interpolation is applied. Forty-eight hourly velocity profiles have no qualifying pair.","All 17 nominal timestamps agree with unique BO (bottom) events in the original station log. This does not establish simultaneous sampling at 100\u2013300 m. Cast beginning/end events and actual offsets remain inspectable.","Of 3,009 upper-ocean property cells, 2,525 meet joint WOCE QC2. Raw edited/despiked code7 and questionable code3 values remain available; other codes are not silently relabeled missing or acceptable.","Temperature is in-situ ITS-90; salinity is practical PSS-78. Pressure is retained in dbar beside depth converted with GSW3.6.23. The source-history temperature-correction notice remains unresolved and is not reapplied.","Calculated readbacks use a declared precision for reproducibility. That precision is not observational uncertainty or an annual range. Original source values, masks and quality flags remain unchanged; the exact record pins the calculation rules."],"observation_kind":"direct_shipboard_adcp_velocity","observation_source_file":"research/aleutian-p14n-1993-native-vector-support.json","observation_times_utc":["1993-07-13T07:16:22Z","1993-07-18T20:40:20Z"],"original_url":"https://uhslc.soest.hawaii.edu/sadcp/DATABASE/00016.html","rank_eligible":false,"source_file":"research/aleutian-p14n-1993-component-spans.json","source_links":[{"document":"research/aleutian-p14n-1993-run-composite.json","label":"Inspect conditional run-composite means and all assumptions","pointer":""},{"document":"research/aleutian-p14n-1993-run-composite.json","label":"Inspect all run summaries, gap barriers and crossing cases","pointer":"/experiments"},{"document":"research/aleutian-p14n-1993-run-composite-figure.json","label":"Inspect conditional run-composite figure provenance","pointer":""},{"document":"research/aleutian-p14n-1993-underway-averages.json","label":"Inspect the unresolved native-averaging result","pointer":""},{"document":"research/aleutian-p14n-1993-underway-averages.json","label":"Inspect all nine averaging experiments and boundary cases","pointer":"/experiments"},{"document":"research/aleutian-p14n-1993-underway-averages-figure.json","label":"Inspect native-averaging figure provenance","pointer":""},{"document":"research/aleutian-p14n-1993-native-vector-support.json","label":"Inspect native vector means and ship motion","pointer":"/profiles"},{"document":"research/aleutian-p14n-1993-native-vector-support.json","label":"Inspect all three underway-run scenarios","pointer":"/run_sensitivity"},{"document":"research/aleutian-p14n-1993-native-vector-support.json","label":"Inspect recorded CTD-event intervals","pointer":"/ctd_event_
operators cannot be combined into an area, trend or seasonal range.","source_report_file":"research/norwegian-atlantic-slope-working-admission.json","source_url":"https://os.copernicus.org/articles/22/17/2026/","status":"working_scoped_source_report_admitted_not_historical_release","temporal_interpretation":"Static core defined from 30-year mean fields, not a mean of instantaneous widths. Uneven seasonal sampling retained; no monthly width series.","time_convention":"Static core defined from 30-year mean fields, not a mean of instantaneous widths. Uneven seasonal sampling retained; no monthly width series.","time_precision":"year_range","uncertainty_km":null,"unit":"km","whole_current_representative":false,"whole_current_width_km":null,"width_metric":"mean_core_horizontal_projection_extent","width_plane_depth_m":null,"width_range_km":null,"width_rank_eligible":false,"width_support_cast_count":null},{"admission_file":"research/norwegian-atlantic-slope-working-admission.json","annual_extrema_eligible":false,"annual_width_range_km":null,"approximate_width_km":40,"boundary_rule":"Author prose width of described annual-mean flow; edge cutoff and coordinates unspecified.","calendar_months":null,"current_id":"norwegian-atlantic-slope","extraction_method":"Direct factual prose extraction; not a midpoint of the30\u201350km regional description.","fixed_layer_bounds_m":null,"full_width_inference_eligible":false,"geographic_current_edges":null,"geographic_scope":"Svin\u00f8y section; not width along the full eastern shelf-edge branch.","historical_release_admitted":false,"id":"admitted-width:nwasc:orvik2003-mean-flow-description","independent_new_observation":false,"is_confidence_interval":false,"is_mean_field_geometry":true,"is_mean_of_widths":false,"layer":"Unspecified. The200\u2013900m isobaths describe slope bathymetry, not a fixed width layer.","measurement_type":"published_mean_flow_width_description","name":"Norwegian Atlantic Slope Current","observed_period":null,"phase_kind":"published_mean_flow_width_description","phase_label":"Svin\u00f8y \u00b7 undated annual-mean-flow description","physical_current_envelope_admitted":false,"range_interpretation":"One contextual approximate mean-flow width, not annual extrema or mean instantaneous width.","range_kind":null,"rank_eligible":false,"related_measurement_ids":["admitted-width:nwasc:norwegian-atlantic-slope-orvik-2001-regional-width"],"seasonal_playback_eligible":false,"section_geometry":null,"source_access":"Original publisher full-text prose inspected through web retrieval2026-10-22. Direct HTML/PDF403; no original2003 PDF or figure custody.","source_citation":"Orvik, K. A. and Skagseth, \u00d8. (2003), The impact of the wind stress curl in the North Atlantic on the Atlantic inflow to the Norwegian Sea toward the Arctic, Geophysical Research Letters, 30(17), 1884, doi:10.1029/2003GL017932.","source_file":"research/norwegian-atlantic-slope-working-admission.json","source_locator":"Introduction paragraph[4], Svin\u00f8y annual-mean description citing Orvik et al.(2001).","source_pointer":"/width_records/5","source_quality_note":"Cites earlier literature. Not independent corroboration of the related2001 width summary; bathymetry and transport periods are not width-layer or averaging metadata.","source_report_file":"research/norwegian-atlantic-slope-working-admission.json","source_report_type":"contextual_literature_mean_flow_description","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2003GL017932","status":"working_scoped_source_report_admitted_not_historical_release","time_convention":"Averaging dates unspecified. Width of annual-mean flow is not mean instantaneous width.","uncertainty_km":null,"unit":"km","whole_current_representative":false,"whole_current_width_km":null,"width_metric":"width_of_described_annual_mean_flow","width_range_km":null,"width_rank_eligible":false}],"working_length_assessments":[{"entity_id":"current:acc","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:acc","illustrated_span_km":8475,"illustrated_span_rank":1,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":"source:541670cca7b3e8d3","length_source_locator":"Section 1 Introduction, opening sentence (approximately 25,000 km)","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":25000,"published_rank":1,"rank_eligible":true,"scope":"Approximate circumpolar path; source calls it the longest wind-driven current.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:antarctic-coastal","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:antarctic-coastal","illustrated_span_km":5902,"illustrated_span_rank":4,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The East Wind Drift is westward near the Antarctic coast. Its continuity and start/end limits vary by sector; the four published map arrows do not supply a measured centerline or comparable whole-current length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:california","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:california","illustrated_span_km":3407,"illustrated_span_rank":8,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":"source:3144208e2fb35f77","length_source_locator":"PDF page 3, background box under California Current (California Current System extends 3,000 km)","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":3000,"published_rank":7,"rank_eligible":true,"scope":"Approximate California Current System extent from Baja California Sur to northern Vancouver Island; not a measured California Current core axis.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:gulf-stream-system","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:gulf-stream-system","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"NOAA's glossary defines a continuous system comprising the Florida Current, Gulf Stream, and North Atlantic Current. The whole system extends beyond the Grand Banks toward the British Isles, so no 3,000 km Florida-to-Grand-Banks span is treated as its complete length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:gulf-stream","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:gulf-stream","illustrated_span_km":2368,"illustrated_span_rank":18,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":"source:75c205c85db07281","length_source_locator":"Chapter 14, The Atlantic Ocean, PDF page 11 (printed page 239), paragraph beginning Recirculation of Gulf Stream water (next 2,500 km Gulf Stream proper)","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":2500,"published_rank":9,"rank_eligible":true,"scope":"Tomczak and Godfrey report approximately 2,500 km for the Gulf Stream proper as an open-ocean free jet downstream of Cape Hatteras toward the Newfoundland Rise/Grand Banks near 50\u00b0W. This excludes the Florida Current and North Atlantic Current; it is a textbook path-scale description, not a measured reference streamline. NOAA's glossary uses the same strict segment definition, while NASA and NOAA Coast Pilot sometimes use Gulf Stream more broadly.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:kuroshio","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:kuroshio","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":"source:a21500fd4390acaf","length_source_locator":"PDF page 3, Introduction opening paragraph (3,000 km journey from about 12\u00b0N to 35\u00b0N)","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":3000,"published_rank":7,"rank_eligible":true,"scope":"Approximate Kuroshio journey from about 12\u00b0N to 35\u00b0N in the western North Pacific; not a measured whole-current axis, and the Kuroshio Extension is separate.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:agulhas","evidence_status":"derived_lower_bound","gate_distance_method_source_id":"source:c6fba58548d92e28","gate_distance_sensitivity":{"geographic_span_rank_best":5,"geographic_span_rank_count":7,"geographic_span_rank_worst":5,"interpretation":"Finite gate-perturbation scenarios; not a statistical confidence interval, measured current path, or whole-current length range.","perturbation_basis":"OSW editorial sensitivity choice; not source-reported positional uncertainty.","perturbation_degrees":0.5,"rank_interpretation":"Possible position by geographic gate separation within these seven source-gated spans; excludes along-current length and the published-length ranking. Overlap does not establish equal current length.","scenario_count":9,"scenario_max_km":1552.8,"scenario_min_km":1331.0},"id":"length_assessment:agulhas","illustrated_span_km":2491,"illustrated_span_rank":16,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":"source:e60490bb3f4df65b","length_source_locator":"Section The Agulhas Current, opening paragraph (27\u201340\u00b0S); 1,400 km floor is OSW meridional gate geometry","lower_bound_km":1400,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The research description spans roughly 27\u00b0S\u201340\u00b0S; the coastal path is longer than its north\u2013south separation. Retroflection, leakage, and the eastward Agulhas Return Current are distinct from this boundary-current core. The derived floor is unranked. A 2021 review also describes a roughly 1,000 km coastal segment. That narrower usage conflicts with the broader 27\u00b0S\u201340\u00b0S derived floor, so the two numbers are displayed as source-specific scopes and neither is ranked as a common whole-current length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:agulhas-return","evidence_status":"derived_lower_bound","gate_distance_method_source_id":"source:c6fba58548d92e28","gate_distance_sensitivity":{"geographic_span_rank_best":1,"geographic_span_rank_count":7,"geographic_span_rank_worst":1,"interpretation":"Finite gate-perturbation scenarios; not a statistical confidence interval, measured current path, or whole-current length range.","perturbation_basis":"OSW editorial sensitivity choice; not source-reported positional uncertainty.","perturbation_degrees":0.5,"rank_interpretation":"Possible position by geographic gate separation within these seven source-gated spans; excludes along-current length and the published-length ranking. Overlap does not establish equal current length.","scenario_count":81,"scenario_max_km":3310.8,"scenario_min_km":3101.3},"id":"length_assessment:agulhas-return","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":"source:0623dc4aeee7fc02","length_source_locator":"PDF pages 20\u201322, Figure 14 and Section 6 Conclusions, Agulhas Return Current surveyed eastward from 18\u00b0E to 76\u00b0E; 3,000 km floor is OSW gate geometry","lower_bound_km":3000,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The hydrographic survey distinguishes the Agulhas Return Current from the Agulhas Current and traces its weakening eastward flow toward the Crozet Basin. This derived distance floor is not a measured streamline, whole-current length, or the length of the westward Agulhas Current.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:east-australian","evidence_status":"derived_lower_bound","gate_distance_method_source_id":"source:c6fba58548d92e28","gate_distance_sensitivity":{"geographic_span_rank_best":4,"geographic_span_rank_count":7,"geographic_span_rank_worst":4,"interpretation":"Finite gate-perturbation scenarios; not a statistical confidence interval, measured current path, or whole-current length range.","perturbation_basis":"OSW editorial sensitivity choice; not source-reported positional uncertainty.","perturbation_degrees":0.5,"rank_interpretation":"Possible position by geographic gate separation within these seven source-gated spans; excludes along-current length and the published-length ranking. Overlap does not establish equal current length.","scenario_count":9,"scenario_max_km":1993.6,"scenario_min_km":1772.1},"id":"length_assessment:east-australian","illustrated_span_km":6859,"illustrated_span_rank":2,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":"source:bc07ae7317e29ce9","length_source_locator":"Section 1 Introduction, opening EAC paragraph (15\u201332\u00b0S); 1,800 km floor is OSW meridional gate geometry","lower_bound_km":1800,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"A derived minimum north\u2013south span for the coherent shelf-break jet only; not a measured streamline or a published whole-current length. Separation and extension shift over time.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:tasman-front","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:tasman-front","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The East Australian Current separates eastward as the Tasman Front at a variable latitude, reported between 28\u00b0S and 37\u00b0S. The cited study does not give stable whole-front endpoints or an along-flow length; do not add this branch to the East Australian Current's coastal floor. A 2019 review found the front rarely distinct in instantaneous fields; a single stable path length would overstate that evidence.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:peru-humboldt","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:peru-humboldt","illustrated_span_km":6651,"illustrated_span_rank":3,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":"source:4e2cbe3e50eb054c","length_source_locator":"PDF page 65, embedded Purca et al. manuscript, Introduction opening paragraph (ca. 6,000 km belt); PDF page 66 distinguishes its 1,000 km Peru study area","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":6000,"published_rank":4,"rank_eligible":true,"scope":"Approximate 6,000 km Humboldt Current belt from southern Chile toward northern Peru and the Gal\u00e1pagos, reported in an embedded Purca et al. manuscript in Purca Cuicapusa's 2005 thesis. This is a broad eastern South Pacific current-system extent, not a measured core streamline or the Peru Coastal Current alone; the manuscript separately describes its 1,000 km Peru study area.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:benguela","evidence_status":"derived_lower_bound","gate_distance_method_source_id":"source:c6fba58548d92e28","gate_distance_sensitivity":{"geographic_span_rank_best":6,"geographic_span_rank_count":7,"geographic_span_rank_worst":7,"interpretation":"Finite gate-perturbation scenarios; not a statistical confidence interval, measured current path, or whole-current length range.","perturbation_basis":"OSW editorial sensitivity choice; not source-reported positional uncertainty.","perturbation_degrees":0.5,"rank_interpretation":"Possible position by geographic gate separation within these seven source-gated spans; excludes along-current length and the published-length ranking. Overlap does not establish equal current length.","scenario_count":9,"scenario_max_km":1329.2,"scenario_min_km":1107.7},"id":"length_assessment:benguela","illustrated_span_km":4250,"illustrated_span_rank":6,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":"source:21f756d2b07063f3","length_source_locator":"Section 3.1.3 and Figure 5, Benguela Current system at 30\u00b0S, 24\u00b0S, and 19\u00b0S; OSW WGS84 meridional gate calculation","lower_bound_km":1200,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The study identifies the Benguela Current system at 30\u00b0, 24\u00b0, and 19\u00b0S across decadal inverse solutions, with no continuity north of 19\u00b0S. The current and Benguela ecosystem have different extents. Section observations are from different cruises and do not establish a simultaneous centerline; the derived floor is unranked.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:canary","evidence_status":"section_only","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:canary","illustrated_span_km":2345,"illustrated_span_rank":19,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"A fall 2009 section at 29\u00b0N locates a westward extent across the section and separates transport by depth layer. It does not measure the current's along-flow length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:labrador","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:labrador","illustrated_span_km":3108,"illustrated_span_rank":9,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"No comparable path-length estimate admitted yet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:greenland-middle-atlantic-shelf-hypothesis","evidence_status":"proposed_system_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:greenland-middle-atlantic-shelf-hypothesis","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":"source:bcde6ef21698b592","length_source_locator":"Abstract, proposed 5,000 km buoyancy-driven coastal current from southern Greenland to the Middle Atlantic Bight","lower_bound_km":null,"proposed_system_length_km":5000,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"A 1989 paper hypothesizes a 5,000 km buoyancy-driven coastal connection from southern Greenland to the Middle Atlantic Bight based on limited oxygen-isotope evidence. This proposed system length is unranked and is not the length of the Labrador Current alone.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:brazil","evidence_status":"derived_lower_bound","gate_distance_method_source_id":"source:c6fba58548d92e28","gate_distance_sensitivity":{"geographic_span_rank_best":6,"geographic_span_rank_count":7,"geographic_span_rank_worst":7,"interpretation":"Finite gate-perturbation scenarios; not a statistical confidence interval, measured current path, or whole-current length range.","perturbation_basis":"OSW editorial sensitivity choice; not source-reported positional uncertainty.","perturbation_degrees":0.5,"rank_interpretation":"Possible position by geographic gate separation within these seven source-gated spans; excludes along-current length and the published-length ranking. Overlap does not establish equal current length.","scenario_count":9,"scenario_max_km":1329.2,"scenario_min_km":1107.7},"id":"length_assessment:brazil","illustrated_span_km":4391,"illustrated_span_rank":5,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":"source:21f756d2b07063f3","length_source_locator":"Section 3.1.2 and Figure 5, Brazil Current at 19\u00b0S, 24\u00b0S, and 30\u00b0S; OSW WGS84 meridional gate calculation","lower_bound_km":1200,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The study identifies southward Brazil Current transport at 19\u00b0, 24\u00b0, and 30\u00b0S. Confluence location and downstream identity vary. Section observations are from different cruises and do not establish a simultaneous centerline; the derived floor is unranked.","source_id":"source:803229fe82eb2360"},{"conditional_on_nominal_gates":true,"entity_id":"current:north-atlantic","evidence_status":"derived_lower_bound","gate_distance_method_source_id":"source:north-atlantic-nominal-gate-bound-v1","gate_distance_sensitivity":{"interpretation":"Finite editorial gate scenarios; not a physical error, confidence interval, annual range or source-reported gate-location uncertainty.","perturbation_degrees":0.5,"scenario_count":9,"scenario_max_km":1335.309667,"scenario_min_km":1112.76119},"guaranteed_physical_minimum":false,"id":"length_assessment:north-atlantic","illustrated_span_km":3776,"illustrated_span_rank":7,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":"source:21f756d2b07063f3","length_source_locator":"Sections 2 and 3.1.10; nominal NAC sections at 47\u00b0N and eastern 58\u00b0N; OSW WGS84 latitude separation","lower_bound_km":1200,"measurement_admission_file":"research/north-atlantic-nominal-gate-bound.json","measurement_id":"measurement:north-atlantic:nominal-section-floor","proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Conditional geographic floor between nominal 47\u00b0N and eastern 58\u00b0N sections identified as North Atlantic Current by Ca\u00ednzos et al. (2023). Station latitudes deviate from nominal sections; the northern section combines western 53\u00b0N and eastern 58\u00b0N portions. Cruises, sampled branches and density layers differ. No simultaneous connected axis, common fixed layer or actual geographic endpoints inferred. Not a whole-current length or guaranteed physical minimum.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:deep-western-boundary","evidence_status":"derived_lower_bound","gate_distance_method_source_id":"source:c6fba58548d92e28","gate_distance_sensitivity":{"geographic_span_rank_best":2,"geographic_span_rank_count":7,"geographic_span_rank_worst":2,"interpretation":"Finite gate-perturbation scenarios; not a statistical confidence interval, measured current path, or whole-current length range.","perturbation_basis":"OSW editorial sensitivity choice; not source-reported positional uncertainty.","perturbation_degrees":0.5,"rank_interpretation":"Possible position by geographic gate separation within these seven source-gated spans; excludes along-current length and the published-length ranking. Overlap does not establish equal current length.","scenario_count":9,"scenario_max_km":2607.5,"scenario_min_km":2385.6},"id":"length_assessment:deep-western-boundary","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":"source:21f756d2b07063f3","length_source_locator":"Section 3.2.3 and Figure 8, DWBC at 47\u00b0N, 36\u00b0N, and 24.5\u00b0N; OSW WGS84 meridional gate calculation","lower_bound_km":2400,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The study identifies southward deep western boundary flow at 47\u00b0, 36\u00b0, and 24.5\u00b0N in decadal inverse solutions. This is a North Atlantic segment only; sections from different cruises do not establish one simultaneous continuous path or a whole-Atlantic current length. The derived floor is unranked.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:azores","evidence_status":"section_only","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:azores","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The 110 km figure below is width across one 2009 meridional section at 24.5\u00b0W, not along-current length or a whole-current extent.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:azores-countercurrent","evidence_status":"section_only","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:azores-countercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The 110 km figure below is width across one 2009 meridional section at 24.5\u00b0W, not along-current length or a whole-current extent.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:portugal","evidence_status":"section_only","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:portugal","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The 2009 study identifies one zonal crossing at 37\u00b0N; its 13.5\u201314.8\u00b0W longitude band and transport do not establish a whole-current length. Keep the offshore Portugal Current distinct from coastal counterflows.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:mediterranean-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:mediterranean-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"RAFOS floats and hydrography track the undercurrent from the Gulf of C\u00e1diz around southwestern Portugal, where a roughly 30 km wide jet weakens and broadens northward. That width is cross-stream, not its length; branching and loss from the slope prevent a single measured endpoint here.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:east-adriatic","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:east-adriatic","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"2002\u20132003 measurements off the eastern Adriatic coast establish a variable current that strengthened in January\u2013February and again in May. Its Dalmatian coastal reach may overlap the older Dalmatian Current name, but that synonymy is not yet established; no full path length is admitted.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:black-sea-rim","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:black-sea-rim","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Copernicus Marine defines this basin-scale cyclonic flow and measures intensity in northern and southern slope sectors. Those sectors are monitoring windows, not a full current centerline or length. Older Caucasus and Southern Current names may describe sectors, but equivalence is unresolved.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:loop","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:loop","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The loop expands and retracts; its path length changes.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:florida","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:florida","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":"source:75c205c85db07281","length_source_locator":"Chapter 14, The Atlantic Ocean, PDF page 11 (printed page 239), paragraph beginning Recirculation of Gulf Stream water (1,200 km downstream to Cape Hatteras)","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":1200,"published_rank":12,"rank_eligible":true,"scope":"Tomczak and Godfrey report approximately 1,200 km from the Florida Straits along the coast to separation near Cape Hatteras. This is the Florida Current segment of the Gulf Stream System, not a whole-system length or a measured reference streamline. NOAA's glossary independently names the same segment; NASA and NOAA Coast Pilot sometimes use Gulf Stream more broadly for the Florida Straits flow.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:north-brazil","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:north-brazil","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Retroflection and rings need separate treatment.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:alaska","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:alaska","illustrated_span_km":3049,"illustrated_span_rank":10,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"No comparable path-length estimate admitted yet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:aleutian","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:aleutian","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The meteorological glossary identifies this as the southern eastward limb of the North Pacific subpolar gyre, also called the Subarctic Current. Its mixing with the North Pacific Current and variable frontal boundary leave no source-defined whole-current length for this ledger.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:antilles","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:antilles","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"NOAA's six sections near 28\u00b035\u2032N found variable northward and southward bands rather than the broad, persistent northward surface current shown on older charts. This section cannot establish a whole-current path or length and does not resolve flow farther south.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:davidson","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:davidson","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"A seasonal countercurrent, not a permanent jet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:east-greenland","evidence_status":"derived_lower_bound","gate_distance_method_source_id":"source:c6fba58548d92e28","gate_distance_sensitivity":{"geographic_span_rank_best":3,"geographic_span_rank_count":7,"geographic_span_rank_worst":3,"interpretation":"Finite gate-perturbation scenarios; not a statistical confidence interval, measured current path, or whole-current length range.","perturbation_basis":"OSW editorial sensitivity choice; not source-reported positional uncertainty.","perturbation_degrees":0.5,"rank_interpretation":"Possible position by geographic gate separation within these seven source-gated spans; excludes along-current length and the published-length ranking. Overlap does not establish equal current length.","scenario_count":9,"scenario_max_km":2286.5,"scenario_min_km":2063.5},"id":"length_assessment:east-greenland","illustrated_span_km":1950,"illustrated_span_rank":21,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":"source:8790d970dd742fd0","length_source_locator":"Section 2, paragraph defining East Greenland shelf from Fram Strait 78.5\u00b0N to Cape Farewell 59\u00b0N; 2,100 km floor is OSW meridional gate geometry","lower_bound_km":2100,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The study distinguishes the outer East Greenland Current from the coastal branch and assesses the system between the 78.5\u00b0N Fram Strait section and Cape Farewell. The coast-following route may be longer than the north\u2013south separation; no comparable whole-current centerline length is admitted, so this regional floor is unranked.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:east-greenland-coastal","evidence_status":"sampled_reach_only","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:east-greenland-coastal","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"A summer 2004 hydrographic and velocity survey identified this inner-shelf branch along the approximately 1,000 km southeast Greenland shelf south of Denmark Strait. That is a documented regional reach, not a measured whole-current path or a year-round length; the offshore East Greenland Current is distinct.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:falkland","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:falkland","illustrated_span_km":1802,"illustrated_span_rank":22,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":"source:df04e92fab7c4ca8","length_source_locator":"Page 1, opening sentence of EGU2009-12242 abstract (2000 km northward loop)","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":2000,"published_rank":10,"rank_eligible":true,"scope":"Source-reported approximate 2,000 km northward loop of the northern Antarctic Circumpolar Current branch in the Argentine Basin, from a 2009 EGU conference abstract. No reference centerline, endpoint coordinates, depth-defined length or uncertainty is supplied. Do not interpret this as a measured dated path, a shelf-break front length, or an independently specified Malvinas Return Current extent.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:guiana","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:guiana","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"No comparable path-length estimate admitted yet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:guinea","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:guinea","illustrated_span_km":1284,"illustrated_span_rank":24,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"No comparable path-length estimate admitted yet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:irminger","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:irminger","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"No comparable path-length estimate admitted yet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:kuroshio-extension","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:kuroshio-extension","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"A named continuation of the Kuroshio; keep separate from its core length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:monsoon","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:monsoon","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Seasonal reversal changes the path and direction.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:indonesian-throughflow","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:indonesian-throughflow","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"NASA names the Pacific-to-Indian freshwater passage through narrow gaps of the Maritime Continent but gives no single current centerline or whole-system length. This is a multi-channel flow, so no length enters the ranking.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:red-sea-saline-overflow","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:red-sea-saline-overflow","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"NASA identifies a saline overflow contribution from the Red Sea to the western Indian Ocean. The gateway at Bab el Mandeb is not a measured plume endpoint or a whole-flow centerline; the downstream pathway and seasonal strength require separate observations.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:persian-gulf-saline-overflow","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:persian-gulf-saline-overflow","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"NASA identifies a saline overflow contribution from the Persian Gulf to the western Indian Ocean. The Strait of Hormuz gateway is not a measured plume endpoint or a whole-flow centerline; dilution and circulation beyond the strait require separate observations.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:north-cape","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:north-cape","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"No comparable path-length estimate admitted yet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:north-equatorial","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:north-equatorial","illustrated_span_km":6226,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The same name is used in multiple basins; split into basin-specific records before measuring.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:north-pacific","evi
hed_rank":null,"rank_eligible":false,"scope":"Named section from eastern Great Australian Bight to western Bass Strait in the source's winter boundary-flow convention.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:zeehan","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:zeehan","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Named section off western Tasmania in the source's winter boundary-flow convention.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:caribbean","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:caribbean","illustrated_span_km":1675,"illustrated_span_rank":23,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"No source-defined whole-current path length admitted yet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:equatorial-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:equatorial-countercurrent","illustrated_span_km":4809,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Umbrella label for multiple eastward tropical countercurrents. North and South named families and basin-specific flows require separate boundaries and length estimates.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:north-equatorial-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:north-equatorial-countercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Atlantic and Pacific upper-ocean currents share a name but have distinct paths and seasonality. The family has no single measured length; this is distinct from the deeper North Equatorial Undercurrent.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:atlantic-north-equatorial-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:atlantic-north-equatorial-countercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Observed cores near 6.5\u00b0N and 8\u00b0N at 38\u00b0W in the 1998\u20132006 survey record, with marked seasonal variability. These cross-sections do not determine an along-current length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:pacific-north-equatorial-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:pacific-north-equatorial-countercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Repeated Pacific velocity sections identify a near-surface eastward core around 7\u00b0N at 140\u00b0W. The section locates the current but gives no comparable along-current length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:south-equatorial-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:south-equatorial-countercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Separate Atlantic, Pacific, and Indian eastward tropical flows share this name. Their seasonal expression and geographic limits differ; no cross-basin family length can be ranked.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:atlantic-south-equatorial-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:atlantic-south-equatorial-countercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Ship observations place a weak eastward flow in the 7\u20139\u00b0S belt near 30\u00b0W in some seasons, with westward flow in spring 1994. The western survey limit and intermittency prevent a defensible whole-current length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:pacific-south-equatorial-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:pacific-south-equatorial-countercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Argo-based analysis reports a boreal-spring band near 5\u201313\u00b0S from 150\u00b0E to 170\u00b0W, with seasonal changes in zonal reach and depth. That observed seasonal envelope is not a traced alongstream length and is unranked.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:indian-south-equatorial-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:indian-south-equatorial-countercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Repeated XBT shipping-line sections identify this flow, including a western line near 55\u00b0E with a variable trough around 5\u201310\u00b0S. Section transports and latitude bands are not an along-current length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:equatorial-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:equatorial-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"A shared subsurface name across three basins. The Indian Ocean expression is weaker and seasonal; component currents require separate boundaries and length estimates.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:pacific-equatorial-undercurrent","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:pacific-equatorial-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":"source:14f30cbbf1cd40e4","length_source_locator":"Section 1 Introduction, paragraph [2] (14,000 km pathway)","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":14000,"published_rank":3,"rank_eligible":true,"scope":"Approximate basin-wide eastward pathway from north of Papua New Guinea to the South American coast described in Grenier et al. (2011). The source's 14,000 km is a broad path estimate, not a traced instantaneous core or the length of the Atlantic or Indian Equatorial Undercurrent. A 0\u00b0N, 140\u00b0W mooring locates the current independently.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:atlantic-equatorial-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:atlantic-equatorial-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"A PIRATA ADCP observed the current at 0\u00b0N, 23\u00b0W in 2002; the station is not a whole-current length. Lomonosov is an established alternate name; Marine Regions spells it Lomonoscov.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:indian-equatorial-undercurrent","evidence_status":"section_only","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:indian-equatorial-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Observed across a 2\u00b0S\u20132\u00b0N section at 90\u00b0E on 1\u20133 March 2017; the reported ~13.5 Sv is section transport, not path length. A later review describes the Indian expression as weaker and seasonally varying; one campaign does not establish a permanent path.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:north-equatorial-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:north-equatorial-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The same name is used for separately observed Atlantic and Pacific subsurface flows with different latitude and depth settings. Do not rank a cross-basin family length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:atlantic-north-equatorial-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:atlantic-north-equatorial-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Direct observations near 5\u00b0N, 23\u00b0W cover a 65\u2013270 m subsurface layer; variability is dominated by intraseasonal events, and the mooring does not determine basin-wide length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:pacific-north-equatorial-undercurrent","evidence_status":"section_only","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:pacific-north-equatorial-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The 130\u00b0E mooring array measures eastward subsurface jets between 8.5\u00b0N and 17.5\u00b0N, with 5.1 Sv mean positive transport to 900 m under the study definition. This cross-section is not a path length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:south-equatorial-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:south-equatorial-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The same name appears in separate Atlantic and Indian observations, with different vertical reach and seasonality; a family has no single measured length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:atlantic-south-equatorial-undercurrent","evidence_status":"section_only","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:atlantic-south-equatorial-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The 35\u00b0W section identifies eastward flow between 2.5\u00b0S and 4\u00b0S at 200\u2013500 m, with 2.8 Sv mean transport under the study definition. Section transport is not whole-current length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:indian-south-equatorial-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:indian-south-equatorial-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"A 10\u00b0S, 87\u00b0E mooring and reanalysis identify a subsurface eastward jet beneath the westward South Equatorial Current; its deep reach and seasonality differ from the Atlantic flow. No comparable whole-current length is admitted.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:south-atlantic","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:south-atlantic","illustrated_span_km":2431,"illustrated_span_rank":17,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Named basin-spanning flow in the cited study; no source-defined whole-current path length admitted yet. Cartographic crossings remain separately pending review.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:south-indian","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:south-indian","illustrated_span_km":3013,"illustrated_span_rank":11,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Eastward subtropical-gyre flow near 40 degrees S in the cited study; no source-defined whole-current path length admitted. Do not conflate with the Agulhas Return Current or offshore West Australian Current. Cartographic crossings remain separately pending review.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:south-pacific","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:south-pacific","illustrated_span_km":2784,"illustrated_span_rank":14,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Named eastward current associated with the South Pacific subtropical front; map arrows do not measure its full length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:west-greenland","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:west-greenland","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"No comparable path-length estimate admitted yet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:west-spitsbergen","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:west-spitsbergen","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Marine Regions supplies one geographic point, not a centerline or endpoints; no comparable path-length estimate admitted yet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:jutland","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:jutland","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Marine Regions supplies one geographic point, not a current boundary or endpoints; no comparable path-length estimate admitted yet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:mindanao-current","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:mindanao-current","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The source describes flow southward along the Philippine Islands and supply to the Indonesian Throughflow, North Equatorial Countercurrent, and Pacific Equatorial Undercurrent. It gives no whole-current alongflow length or fixed endpoint gates.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:new-guinea-coastal-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:new-guinea-coastal-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The source describes northwestward flow along Papua New Guinea and through Vitiaz Strait into the Pacific Equatorial Undercurrent source region. It gives no comparable whole-current centerline length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:new-ireland-coastal-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:new-ireland-coastal-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The source describes flow along New Ireland's eastern coast, with branches joining the New Guinea Coastal Undercurrent or retroflecting toward the Pacific Equatorial Undercurrent. It gives no whole-current length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:solomon-island-coastal-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:solomon-island-coastal-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The source schematically names this equatorward flow along the Solomon Islands and says it may feed the New Ireland Coastal Undercurrent. Its continuity and whole-current length are unresolved.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:new-guinea-coastal-current","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:new-guinea-coastal-current","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Three years of moorings distinguish this upper-100 m current from the deeper New Guinea Coastal Undercurrent: it flows southeastward in boreal winter and northwestward in boreal summer. The observations do not define a whole-current alongflow length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:pacific-north-subsurface-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:pacific-north-subsurface-countercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"A Pacific section at 140\u00b0W locates this eastward jet near 4\u00b0N and 200 m; the section does not determine its complete alongflow route or length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:pacific-south-subsurface-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:pacific-south-subsurface-countercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The Pacific 140\u00b0W section resolves two south-side branches near 4.5\u00b0S at 200 m and 7\u00b0S at 250 m. These section positions do not supply a whole-current path length or a single branch-averaged centerline.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:hiri-current","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:hiri-current","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The literature uses Hiri Current for the northward branch after South Equatorial Current bifurcation off northeast Australia, with variable continuation around the Gulf of Papua. No one fixed path or endpoint pair is admitted for a whole-current length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:alaska-coastal-gulf","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:alaska-coastal-gulf","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":"source:48b84ff7f08f8e6e","length_source_locator":"Accepted manuscript, PDF page 2, Abstract, lines 25-28 (~1700 km, Seward to Samalga Pass); PDF page 3, Introduction, lines 51-59 defines the regional continuity scope.","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":1700,"published_rank":11,"rank_eligible":true,"scope":"Stabeno et al. (2016) report an approximate 1,700 km coastal system between Seward and Samalga Pass. This is the northern Gulf of Alaska/eastern Aleutian scope, separate from the offshore Alaska Current and Alaskan Stream. It does not cover every coastal flow sharing the Alaska Coastal Current name, including Arctic usage. The paper integrates intermittent observations from 1984-2014; this extent is not a measured simultaneous reference streamline or dated footprint.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:antarctic-slope","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:antarctic-slope","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":"source:c81191f8e01b20c1","length_source_locator":"Section 1.1 ASC Characteristics, first sentence; Figure 2 caption and following paragraph qualify continuity","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":21000,"published_rank":2,"rank_eligible":true,"scope":"Review-reported upper-continental-slope system span; not a measured reference streamline or dated footprint. The Antarctic Peninsula interrupts circumpolar continuity.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:southern-east-madagascar","evidence_status":"published_estimate","id":"length_assessment:southern-east-madagascar","length_source_id":"source:dddb5c5db92e5fe3","length_source_locator":"Introduction paragraph2","lower_bound_km":null,"measurement_admission_file":"research/southern-east-madagascar-prose-dimension-admissions.json","measurement_id":"measurement:southern-east-madagascar:reported-extent","proposed_system_length_km":null,"published_length_km":650,"published_rank":13,"rank_eligible":true,"scope":"Author-reported approximate southern branch extent from about 20\u00b0S to Cap Sainte Marie near 25\u00b030\u2032S. Contextual literature estimate citing Duncan (1970) and Lutjeharms (1988b), not a new April 2001 path measurement. Coordinates, reference axis, fixed layer, reference period and error unspecified.","source_dimension_file":"research/ocean-current-inventory-expansion-candidates.json","source_dimension_proposal_id":"southern-east-madagascar","source_id":"source:dddb5c5db92e5fe3"},{"entity_id":"current:norwegian-atlantic-slope","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:norwegian-atlantic-slope","illustrated_span_km":null,"illustrated_span_rank":null,"length_source_id":"source:nwasc-orvik-skagseth-2003","length_source_locator":"Introduction paragraph[3], eastern NwASC branch description.","lower_bound_km":null,"measurement_admission_file":"research/norwegian-atlantic-slope-working-admission.json","measurement_id":"measurement:norwegian-atlantic-slope:reported-extent","proposed_system_length_km":null,"published_length_km":3500,"published_rank":6,"rank_eligible":true,"scope":"Author-reported approximate3500km eastern shelf-edge branch extent in Orvik and Skagseth (2003). Historical broad branch geography from Shetland toward the Arctic west of Svalbard at80\u00b0N is described in Orvik and Niiler (2001), not an independent length measurement. This broad scope may overlap flow now named West Spitsbergen Current; not an additive component length or a modern regional axis. No fixed layer, reference period, paired endpoint coordinates, error or annual range supplied.","source_id":"source:nwasc-baumann-2026"}],"working_published_ranks":{"current:acc":1,"current:alaska-coastal-gulf":11,"current:antarctic-slope":2,"current:australian-west-south-boundary-flow":5,"current:california":7,"current:falkland":10,"current:florida":12,"current:gulf-stream":9,"current:kuroshio":7,"current:norwegian-atlantic-slope":6,"current:pacific-equatorial-undercurrent":3,"current:peru-humboldt":4,"current:southern-east-madagascar":13}},{"annual_extrema_admitted":false,"claim_id":"claim:width:east-india-coastal-wijesekera-2015-t24-21m-width","current_id":"east-india-coastal","entity_id":"current:east-india-coastal","external_scientific_review_claimed":false,"full_paper_scientifically_reviewed":false,"historical_source_stage_status_note":"Frozen source-stage reports remain unchanged. This is a separate later scoped admission, not a rewrite of their earlier pending status.","id":"current_measurement_admission:east-india-coastal:t24-2013","independent_observations_added":0,"method_source_id":"source:reported-current-width-evidence-v1","physical_edges_admitted":false,"protocol_file":"plans/published-prose-dimension-admission-protocol-v1.md","raw_width_samples_added":0,"schema":"osw.published-prose-width-admission.v1","scope":"About100km reported for the inbound T24 ship transect on23-24December2013, approximately along5.25N south of Sri Lanka, in the source description at21m. No paired edges, numerical cutoff or error specified. Not a whole-current width or annual range.","source_figures_digitized":false,"source_id":"source:eicc-width-wijesekera-2015","source_report_file":"research/eicc-wijesekera-2015-width-evidence-v1.json","source_statement_id":"width-evidence:eicc:wijesekera-2
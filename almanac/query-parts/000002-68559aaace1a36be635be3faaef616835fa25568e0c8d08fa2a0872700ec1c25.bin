ion:southern-east-madagascar","identity_evidence":{"access_mode":"publisher_full_HTML_inspected_original_PDF_unavailable","classification_basis":"Introduction identifies the western boundary current of the South Indian subtropical gyre. Abstract describes near-surface expression and1992\u20132005 altimetry with eddy and interannual variability.","decision":"The primary text explicitly identifies a southward East Madagascar Current. The southern qualifier distinguishes the named poleward branch from northward flow, the underlying equatorward undercurrent and offshore countercurrent.","global_aliases_admitted":[],"parent_relationships_admitted":[],"source_locator":"Title; Introduction paragraph2; abstract; Results3.1 paragraph17","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639"},"identity_figure_file":"figures/southern-east-madagascar-admitted-identity.svg","physical_edges_admitted":false,"proposal_id":"southern-east-madagascar","rank_eligible":false,"remaining_measurement_gates":["Acquire and visually review original figures before quantitative measurement admission.","Recover paired velocity boundaries, layer and error convention for width measurements.","Recover source-supported route geometry and repeat temporal support before annual ranges, seasonal animation or state intersections."],"review_type":"internal_editorial_identity_review_not_external_scientific_peer_review","route_planning_decision":{"candidate_ids":[],"component_inventory_status":"no_component_inventory_asserted","current_id":"southern-east-madagascar","existing_length_evidence_status":"reported_contextual_extent_pending_measurement_admission","existing_scope":"Southward branch identity admitted; no geographic axis or current-edge coordinates recovered.","known_component_currents":[],"ledger_kind":"current","name":"Southern East Madagascar Current","name_source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639","next_action":"Acquire source-supported route geometry with layer, start/end gates and time support; retain contextual extent separately.","planning_basis":"Source-supported southern current identity; no source-defined route geometry has been recovered.","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","published_length_rank_eligible":false,"reference_path_decision":"not_constructed","route_strategy_id":"source_gated_boundary_current","route_strategy_label":"Source-gated boundary-current route","strategy_next_action":"Recover a source-supported current-axis route with explicit layer, source period and endpoint convention."},"seasonal_playback_eligible":false,"source":{"authors":["J. J. Nauw","H. M. van Aken","A. Webb","J. R. E. Lutjeharms","W. P. M. de Ruijter"],"doi":"10.1029/2007JC004639","id":"source:dddb5c5db92e5fe3","kind":"external","label":"Observations of the southern East Madagascar Current and undercurrent and countercurrent system","material_use_class":"source_scoped_factual_claim","metadata_status":"Publisher full HTML and institutional publication record inspected; no original PDF acquired","path":null,"preferred_citation":"Nauw, van Aken, Webb, Lutjeharms and de Ruijter (2008), Observations of the southern East Madagascar Current and undercurrent and countercurrent system, JGR113, C08006, doi:10.1029/2007JC004639.","provider_asset_redistributed":false,"publication_date_parts":[2008,8,5],"publisher":"American Geophysical Union","repository_path":null,"rights_policy_url":"plans/current-identity-admission-protocol-v1.md","rights_review_date":"2026-10-21","rights_status":"Reviewed narrow factual use: original paraphrase and linked source; no article or figure redistributed","title":"Observations of the southern East Madagascar Current and undercurrent and countercurrent system","url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639","used_in_collections":["entities","names","length_assessments","current_identity_admissions"]},"source_dimensions":{"figure_file":"figures/southern-east-madagascar-reported-dimensions.svg","geographic_current_edges":null,"interpretation":"Separate source-reported dimensions, not the sides of a current footprint. April2001 width and contextual branch length must not be multiplied into an area. No seasonal range, dated axis, fixed width layer or annual mean inferred.","physical_annual_width_range_km":null,"records":[{"approximate":true,"dimension":"length","endpoint_coordinates_lon_lat":null,"fixed_layer_bounds_m":null,"id":"southern-east-madagascar-nauw2008-reported-extent","is_annual_extremum":false,"is_annual_mean":false,"metric":"author_reported_southern_branch_extent","observed_period":null,"rank_eligible":false,"source_locator":"Introduction paragraph2","support":"Southward branch from approximately20S to Cap Sainte Marie at approximately25deg30minS. Source cites Duncan1970 and Lutjeharms1988b; this is a contextual literature estimate, not a new length measured by the2001 cruise.","uncertainty_km":null,"value_km":650},{"approximate":true,"dimension":"width","endpoint_coordinates_lon_lat":null,"fixed_layer_bounds_m":null,"id":"southern-east-madagascar-nauw2008-survey-width","is_annual_extremum":false,"is_annual_mean":false,"metric":"author_reported_near_surface_survey_width","observed_period":"2001-04","rank_eligible":false,"source_locator":"Results3.1 paragraph17; abstract","support":"SectionsT5\u2013T8 in April2001 off southeast Madagascar. Near-surface current structure uses VMADCP mean velocity in the upper100m. Numeric edge cutoff, boundary coordinates and width uncertainty are not specified in this passage.","uncertainty_km":null,"value_km":120,"velocity_averaging_layer_is_verified_width_layer":false,"velocity_averaging_layer_m":[0,100]}],"reported_length_rank_eligible":false,"schema":"osw.proposed-current-reported-dimensions.v1","seasonal_playback_eligible":false,"source_citation":"Nauw, van Aken, Webb, Lutjeharms and de Ruijter (2008), Observations of the southern East Madagascar Current and undercurrent and countercurrent system, JGR113, C08006, doi:10.1029/2007JC004639.","source_license":"AGU/Wiley copyrighted publication; free access does not imply a redistribution license. Original factual summaries and OSW diagram only.","source_original_pdf_sha256":null,"source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639"},"status":"editorial_identity_admitted_measurements_separately_gated"},{"admission_date":"2026-10-22","annual_length_range_km":null,"annual_width_range_km":null,"canonical_measurements_admitted":true,"entity":{"almanac_url":"reference-routes.html#inventory-addition-norwegian-atlantic-slope","basin":"Norwegian Sea / Nordic Seas","catalogue_version":"0.3.0-draft-nwasc","id":"current:norwegian-atlantic-slope","identity_admission_id":"current_admission:norwegian-atlantic-slope","identity_level":"current","identity_scope_note":"Atlantic-water eastern slope branch along the Norwegian continental margin, with northern bifurcation. Distinct from ambiguous Norwegian Current, coastal current and western frontal branch. Parent Norwegian Atlantic Current remains a separately proposed identity.","label":"Norwegian Atlantic Slope Current","setting":"polar_or_subpolar_margin","source_id":"source:nwasc-baumann-2026","source_kind":"source-defined Atlantic-water slope current","source_record_id":"norwegian-atlantic-slope","time_behavior":"persistent_variable","type":"named_current"},"entity_id":"current:norwegian-atlantic-slope","external_scientific_review_claimed":false,"geometry":null,"id":"current_admission:norwegian-atlantic-slope","identity_evidence":[{"citation":"Baumann, Skagseth, Ingvaldsen and Mork (2026), Reduced cooling in the Norwegian Atlantic Slope Current: investigating mechanisms of change from 30 years of observations, Ocean Science 22, 17\u201329, doi:10.5194/os-22-17-2026.","locator":"Introduction paragraphs on two branches and northern bifurcation; sections 2.1 and 2.1.2 on section sampling and distinct current-core definitions.","source_access":"Publisher relevant introduction and methods read, not all article sections; figures not digitized.","source_license":"Creative Commons Attribution 4.0","source_retrieved_date":"2026-10-03","supports":"NwASC follows the Norwegian continental slope, with branches toward the Barents Sea and West Spitsbergen. Whole-current origin, termination and layer-specific geometry not extracted.","url":"https://os.copernicus.org/articles/22/17/2026/"},{"citation":"Mork, K. A. and Skagseth, O. (2010), A quantitative description of the Norwegian Atlantic Current by combining altimetry and hydrography, Ocean Science 6, 901-911, doi:10.5194/os-6-901-2010.","locator":"Introduction and Fig. 1; Sections 3 and 4.1.1, pp.904 and 906.","source_access":"Original eleven-page PDF acquired; methods/results/discussion and Figures 2-3 visually inspected. No raw ADT field or width boundaries digitized.","source_license":"CC BY 3.0","source_retrieved_date":"2026-10-08","supports":"Separate slope/front branch identities and method-dependent local widths; no total system width or annual envelope.","url":"https://os.copernicus.org/articles/6/901/2010/"}],"identity_figure_file":"figures/norwegian-atlantic-slope-admitted-dimensions.svg","physical_edges_admitted":false,"proposal_id":"norwegian-atlantic-slope","rank_eligible":true,"remaining_measurement_gates":["Acquire a layer- and time-defined axis before mapped length and physical joins.","Acquire comparable repeated dated dimensions before annual envelopes and seasonal animation."],"review_type":"internal_editorial_primary_source_review","route_planning_decision":{"candidate_ids":[],"component_inventory_status":"parent_and_downstream_name_boundaries_retained","current_id":"norwegian-atlantic-slope","existing_length_evidence_status":"published_estimate","existing_scope":"Author-reported approximate3500km eastern shelf-edge branch extent in Orvik and Skagseth (2003). His
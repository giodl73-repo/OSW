res_scientific_review","velocity_sampler_sha256":"abe0b95665a8f7e5fd05cb0920c70df5e8cd4655eaae05a03d7da5f17d239deb","whole_current_representative":false,"width_rank_eligible":false},"id":"diagnostic:gulf-stream-widths"},{"current_id":"gulf-stream","document":{"annual_width_range_km":null,"current_id":"gulf-stream","existing_current_records":[{"annual_extrema_eligible":false,"approximate_width_km":256,"boundary_rule":"Section 2.3: station pairs selected by consistent slope of eastward accumulated horizontal mass transport; vertical extent by the same integrated flow direction. No fixed speed cutoff or instantaneous velocity envelope inferred.","boundary_sides":"source_selected_station_limits","calendar_months":null,"current_id":"gulf-stream","extraction_file":"research/atlantic-cruise-section-width-extraction.json","extraction_method":"Publisher XLSX cells retained and distance transcribed directly; explicit section/cruise join. No map or longitude-to-distance conversion.","extraction_sha256":"c8f4e2e6211bff2caef9d0b41df0c027bee43aaee8c38b50c0b28b06e6c4d63b","fixed_layer_bounds_m":null,"full_width_inference_eligible":false,"geographic_scope":"Gulf Stream 36\u2218\u2009N; source longitude limits -71.7:-69.1 degrees east. Section track may deviate from nominal latitude near boundaries. Endpoint latitudes remain unextracted.","hydrographic_section_context":{"cruise_id":"74AB20050501","cruise_sampling_window":{"end":"2005-06-12","start":"2005-05-03"},"decade_group_is_time_average":false,"depth_extent_is_uniform_fixed_measurement_layer":false,"inverse_model_decade_group":"2000\u20132009","nominal_latitude_is_endpoint_latitude":false,"nominal_section_latitude_degrees_north":36.0,"sampling_window_role":"whole_section_sampling_window_not_exact_boundary_station_occupation","section_id":"A03","source_depth_extent_m":[0,891],"source_distance_is_recomputed_from_nominal_latitude":false,"source_group":"Gulf Stream 36\u2218\u2009N","source_layer_indices_label":"1:6","source_longitude_limits_degrees_east":[-71.7,-69.1],"source_station_range_label":"1:10","source_width_uncertainty_km":null,"station_index_convention":"publisher_table_label_not_reindexed_against_table_1_station_count","table_1_latitude_label":"36\u2218\u2009N","table_1_row":13,"table_2_row":59},"id":"cainzos-2023-t02-row-59-section-span","is_confidence_interval":false,"layer":"Publisher neutral-density layer indices 1:6; reported depth extent 0 to 891 m. Density surfaces are not a uniform fixed-depth slice.","measurement_type":"published_inverse_hydrographic_section_span","name":"Gulf Stream","observed_period":null,"phase_kind":"inverse_hydrographic_section_span","phase_label":"74AB20050501 \u00b7 36 degrees north","range_interpretation":"Publisher Table 2 distance rounded to kilometres. Width uncertainty is not reported. Transport uncertainty is a separate quantity. Separate cruises and layers are not an annual range.","remaining_gates":["Recover actual station coordinates before a geographic edge locator or state intersection.","Independent scientific admission and release review."],"seasonal_playback_eligible":false,"section_geometry":null,"section_orientation":"Nominally zonal hydrographic track; boundary/platform stations may deviate to cross the main flow. Exact boundary track orientation unresolved.","source_citation":"Ca\u00ednzos et al. (2023), Consistent picture of the horizontal circulation of the Atlantic Ocean over 3 decades, Ocean Science 19, 1009\u20131045, doi:10.5194/os-19-1009-2023.","source_evidence_kind":"published_inverse_model_hydrographic_cruise_snapshot","source_locator":"Table 2, Worksheet 1, row 59, columns A\u2013F; Table 1 row 13; Sections 2.1\u20132.3.","source_retrieved_date":"2026-10-07","source_url":"https://os.copernicus.org/articles/19/1009/2023/","status":"editorial_source_extraction_not_canonical","time_convention":"74AB20050501: section sampled 2005-05-03 to 2005-06-12; inverse-model group 2000\u20132009. Cruise snapshot, not a decade mean or seasonal composite.","whole_current_representative":false,"width_metric":"transport_diagnosed_hydrographic_section_span","width_metric_label":"transport-selected cruise-section span","width_range_km":null,"width_rank_eligible":false}],"measurements":[{"annual_extrema_eligible":false,"annual_width_range_km":null,"approximate_width_km":135,"boundary_rule":"Authors smooth transport-per-unit-width measurements and extend their curves to zero. No negative inshore transport was observed; inshore edges are extrapolated. Two complete crossings have offshore negative values, one offshore edge is also extended to zero.","calendar_months":null,"current_id":"gulf-stream","extraction_method":"Transcribed explicit author widths and mean; matched complete occupations using Figure2 and Table2. No curve digitization, geographic endpoints or width error inferred.","fixed_layer_bounds_m":null,"full_width_inference_eligible":false,"geographic_scope":"Cape Hatteras offshore fixed TR-038 baseline; three non-synoptic crossings in1967. Not the whole Gulf Stream or Gulf Stream System.","id":"gulf-stream-richardson-1967-transport-width-statistics","is_confidence_interval":false,"layer":"Transport per unit width integrated from surface to local bottom, with variable bathymetry. No fixed-depth width layer or surface-only speed boundary.","measurement_type":"published_campaign_transport_width_statistics","name":"Gulf Stream","observed_period":{"end":"1967-07-18","start":"1967-06-30"},"original_regional_context":{"all_paired_edges_observed_sign_reversals":false,"author_boundary_extrapolation_present":true,"baseline_bearing_degrees_true":135,"baseline_bearing_is_width":false,"campaign_context_period":{"end":"1967-07-18","start":"1967-06-26"},"comparison_figure":"figures/gulf-stream-published-width-definitions.svg","comparison_figure_label":"Compare published Gulf Stream width definitions","complete_crossing_occupations":[{"crossing_number":1,"id":"gulf-stream-1967-crossing-1","is_synoptic_snapshot":false,"observed_period":{"end":"1967-07-05","start":"1967-06-30"},"source_clock_timezone":null,"transport_sv":58,"width_km":145},{"crossing_number":3,"id":"gulf-stream-1967-crossing-3","is_synoptic_snapshot":false,"observed_period":{"end":"1967-07-15","start":"1967-07-11"},"source_clock_timezone":null,"transport_sv":67,"width_km":140},{"crossing_number":4,"id":"gulf-stream-1967-crossing-4","is_synoptic_snapshot":false,"observed_period":{"end":"1967-07-18","start":"1967-07-16"},"source_clock_timezone":null,"transport_sv":64,"width_km":120}],"description_kind":"gulf_stream_transport_float_complete_crossing_statistics","display_aria_label":"Gulf Stream off Cape Hatteras: three author zero-transport section widths145,140,120 km in1967; reported mean135 km and finite sample span120\u2013145 km. Author extrapolation is retained; no annual extrema or geographic edges.","display_caption":"Mean135 km; three complete1967 crossings span120\u2013145 km. Published zero-transport curve edges include extrapolation.","display_method_note":"Surface-to-local-bottom transport, fixed135-degree-true baseline; multi-day occupations and varying direction. Mean is not a fourth occupation; finite spread is not uncertainty or annual variability.","inshore_negative_transport_observed":false,"mean_is_independent_occupation":false,"occupation_range_is_uncertainty_or_annual_extrema":false,"offshore_negative_transport_observed_complete_crossing_count":2,"partial_crossing_without_width":2,"reported_mean_width_km":135,"source_curve_or_coordinates_digitized":false,"width_is_exact_flow_normal_projection":false},"phase_kind":"campaign_width_statistics","phase_label":"1967 three complete crossings \u00b7 zero-transport spans","range_interpretation":"Author mean135 km from three complete crossings with widths145,140,120 km. Finite campaign span120\u2013145 km; no fourth independent mean occupation, width error, confidence interval, seasonal or annual extrema.","range_kind":"finite_span_of_three_author_reported_crossing_widths","remaining_gates":["Recover geographic boundary coordinates and the original transport observations.","Quantify section-orientation, interpolation and sampling uncertainty.","Independent scientific admission before whole-current dimensions or annual variability."],"seasonal_playback_eligible":false,"section_geometry":null,"section_orientation":"Width along a baseline bearing135 degrees true; transport velocity is the component normal to that baseline. Recorded flow directions vary; no exact flow-normal projection applied.","source_citation":"Richardson, P. L. and Knauss, J. A. (1971), Gulf Stream and Western Boundary Undercurrent observations at Cape Hatteras, Deep-Sea Research18,1089\u20131109, doi:10.1016/0011-7471(71)90095-7.","source_evidence_kind":"published_original_transport_float_campaign_statistics","source_locator":"Methods printed1091/PDF3; Fig2 printed1093/PDF5; zero-edge construction printed1094\u20131095/PDF6\u20137; Table2 printed1105/PDF17; mean135 km printed1107/PDF19.","source_quality_note":"Inshore zero boundaries are author extrapolations, not observed sign reversals. Multi-day sampling and changing flow direction limit synoptic/flow-normal interpretation. Baseline135 degrees differs from mean135 km.","source_retrieved_date":"2026-10-14","source_url":"https://www2.whoi.edu/staff/prichardson/wp-content/uploads/sites/75/2018/11/Richardson-Knauss-1971-dsr.pdf","status":"editorial_source_extraction_not_canonical","time_convention":"Three complete crossings1,3,4:30June\u20135July,11\u201315July,16\u201318July1967. Campaign26June\u201318July is separate. Multi-day occupations, not simultaneous snapshots or continuous monthly/seasonal means; source clock timezone unspecified.","uncertainty_km":null,"whole_current_representative":false,"whole_current_width_km":null,"width_metric":"author_zero_transport_fixed_baseline_span","width_metric_label":"1967 transport-float sections: mean and sampled span","width_range_km":[120,145],"width_rank_eligible":false},{"annual_extrema_eligible":false,"annual_width_range_km":null,"approximate_width_km":300,"boundary_rule":"Author estimates mean width from the separation of100 and400 dbar contours on the sigma-theta26.50 isopycnal near70 W, rather than paired velocity edges.","calendar_months":null,"current_id":"gulf-stream","extraction_method":"Transcribed explicit about300 km contour span after original-page review. No contour digitization, depth conversion, exact local period or inferred instantaneous width.","fixed_layer_bounds_m":null,"full_width_inference_eligible":false,"geographic_scope":"Gulf Stream near70 W on the mean sigma-theta26.50 surface; not the entire current or its larger system.","id":"gulf-stream-lozier-1995-climatological-isopycnal-span","is_confidence_interval":false,"layer":"Potential-density-anomaly surface sigma-theta26.50. Width between100 and400 dbar pressure contours on that surface; these are not fixed100\u2013400 m depth bounds.","measurement_type":"published_climatological_isopycnal_contour_span","name":"Gulf Stream","observed_period":null,"original_regional_context":{"archive_available_as_of":"1990-04","basin_archive_years_are_exact_local_period":false,"basin_archive_years_context":[1904,1990],"comparison_figure":"figures/gulf-stream-published-width-definitions.svg","comparison_figure_label":"Compare published Gulf Stream width definitions","description_kind":"gulf_stream_historical_mean_isopycnal_contour_span","display_aria_label":"Gulf Stream near70 W: about300 km climatological separation of100 and400 dbar contours on sigma-theta26.50. Historical source cutoffApril1990; local averaging period unresolved. No fixed-depth width or annual range.","display_caption":"About300 km \u00b7 historical mean contour span on sigma-theta26.50 near70 W. Pressure levels are not fixed depths.","display_method_note":"Historical climatology; exact local dates and orientation unresolved. Source discusses meandering and smoothing separately; no instantaneous150 km record or135\u2013300 km range inferred.","factor_two_comparison_defines_instantaneous_measurement":false,"isopycnal_label":"sigma-theta26.50","meander_envelope_is_current_width_or_uncertainty":false,"pressure_contours_are_fixed_depth_bounds":false,"pressure_contours_dbar":[100,400],"source_curve_or_coordinates_digitized":false,"source_local_smoothing_context_km":100,"source_meander_envelope_context_km":500},"phase_kind":"climatological_isopycnal_span","phase_label":"Historical climatology \u00b7 near70 W contour span","range_interpretation":"One approximate author-reported mean contour span. Meander envelope500 km, smoothing scale100 km and factor-of-two comparison are separate context; no150 km inferred observation or combined135\u2013300 km range.","remaining_gates":["Recover exact local contribution dates, contour geography and orientation.","Assess smoothing, averaging and meandering effects independently.","Independent scientific admission before geographic footprint or physical annual dimensions."],"seasonal_playback_eligible":false,"section_geometry":null,"section_orientation":"Author contour separation near70 W; exact geographic endpoints and flow-normal orientation not extracted.","source_citation":"Lozier, M. S., Owens, W. B. and Curry, R. G. (1995), The climatology of the North Atlantic, Progress in Oceanography36,1\u201344, doi:10.1016/0079-6611(95)00013-5.","source_evidence_kind":"published_original_historical_isopycnal_climatology","source_locator":"Abstract printed1/PDF1; section2 printed3/PDF3; section5.1 printed14\u201317/PDF14\u201317; Figure7 printed15/PDF15; width and meandering discussion printed17/PDF17.","source_quality_note":"Mean pressure contours on an isopycnal differ from instantaneous transport or half-speed boundaries. Local period and width error unresolved; pressure levels are not fixed depths.","source_retrieved_date":"2026-10-14","source_url":"https://www.whoi.edu/science/po/people/rcurry/pdf_files/Lozier_etal.PiO1995.pdf","status":"editorial_source_extraction_not_canonical","time_convention":"Historical isopycnal climatology from the NODC archive available as of April1990. Basin-wide observations span1904\u20131990; exact local averaging dates and seasonal weights are unresolved. Publication1995 is not an observation date.","uncertainty_km":null,"whole_current_representative":false,"whole_current_width_km":null,"width_metric":"mean_isopycnal_pressure_contour_separation","width_metric_label":"Historical climatology: sigma-theta26.50 pressure contours","width_range_km":null,"width_rank_eligible":false}],"measurements_are_same_metric_or_period":false,"owner_scope_note":"Gulf Stream regional main-current sections only. Do not transfer to Gulf Stream System, Florida or North Atlantic Current. Existing inverse-model and surface-component diagnostics remain separate.","pooled_width_range_km":null,"protocol_file":"plans/gulf-stream-published-width-definitions-protocol-v1.md","protocol_sha256":"98f586953fed323038c3bbb1591235fe4650594847d2a3ebb4de33834fa6035f","schema":"osw.gulf-stream-published-width-definitions.v1","source_access":"Institutional originals retained; Richardson/Knauss PDF1\u20137,17,19 and Lozier PDF1\u20133,14\u201317 reviewed; core source pages rendered and visually inspected. No digitized curves or geographic boundary pairs.","source_license":"Copyright remains with publishers; no open license assigned. Original PDFs and figures excluded from Git.","sources":[{"acquisition_file":"research/source-data/richardson-gulf-stream-1971/acquisition.json","acquisition_sha256":"9f1c43685745d235a88d96a84f6e1cfb5e06131b34348c8f2f19f356e5a86c57","source_document_bytes":1242707,"source_document_file":"research/source-data/richardson-gulf-stream-1971/journal-article.pdf","source_document_sha256":"0bbe9c715e140af51575125c61aeae712912f283f15c1114646bc2b46c1ad31d","source_url":"https://www2.whoi.edu/staff/prichardson/wp-content/uploads/sites/75/2018/11/Richardson-Knauss-1971-dsr.pdf"},{"acquisition_file":"research/source-data/lozier-gulf-stream-1995/acquisition.json","acquisition_sha256":"ca60801b3710875bf63cecf94d7ea4dc281c7261bd397815844b2f9263bd36ea","source_document_bytes":3378622,"source_document_file":"research/source-data/lozier-gulf-stream-1995/journal-article.pdf","source_document_sha256":"daadf0d96ac221ba65f9b70330dd563b26888f8aeacce57c75d23bde8ea0bcd8","source_url":"https://www.whoi.edu/science/po/people/rcurry/pdf_files/Lozier_etal.PiO1995.pdf"}],"status":"editorial_source_extraction_not_canonical","whole_current_width_km":null},"entity_id":"current:gulf-stream","id":"diagnostic:gulf-stream-published-width-definitions","label":"Gulf Stream transport-float occupations and historical isopycnal width","rank_eligible":false,"source_file":"research/gulf-stream-published-width-definitions-scope-audit.json","source_file_sha256":"4e94e8b7f7a29deca11f3005b045d81966de99e967c82fd90f3ba2e4fac2060f","source_json":"{\n  \"schema\": \"osw.gulf-stream-published-width-definitions.v1\",\n  \"status\": \"editorial_source_extraction_not_canonical\",\n  \"current_id\": \"gulf-stream\",\n  \"source_access\": \"Institutional originals retained; Richardson/Knauss PDF1\u20137,17,19 and Lozier PDF1\u20133,14\u201317 reviewed; core source pages rendered and visually inspected. No digitized curves or geographic boundary pairs.\",\n  \"source_license\": \"Copyright remains with publishers; no open license assigned. Original PDFs and figures excluded from Git.\",\n  \"protocol_file\": \"plans/gulf-stream-published-width-definitions-protocol-v1.md\",\n  \"protocol_sha256\": \"98f586953fed323038c3bbb1591235fe4650594847d2a3ebb4de33834fa6035f\",\n  \"sources\": [\n    {\n      \"source_document_file\": \"research/source-data/richardson-gulf-stream-1971/journal-article.pdf\",\n      \"source_document_sha256\": \"0bbe9c715e140af51575125c61aeae712912f283f15c1114646bc2b46c1ad31d\",\n      \"source_document_bytes\": 1242707,\n      \"acquisition_file\": \"research/source-data/richardson-gulf-stream-1971/acquisition.json\",\n      \"acquisition_sha256\": \"9f1c43685745d235a88d96a84f6e1cfb5e06131b34348c8f2f19f356e5a86c57\",\n      \"source_url\": \"https://www2.whoi.edu/staff/prichardson/wp-content/uploads/sites/75/2018/11/Richardson-Knauss-1971-dsr.pdf\"\n    },\n    {\n      \"source_document_file\": \"research/source-data/lozier-gulf-stream-1995/journal-article.pdf\",\n      \"source_document_sha256\": \"daadf0d96ac221ba65f9b70330dd563b26888f8aeacce57c75d23bde8ea0bcd8\",\n      \"source_document_bytes\": 3378622,\n      \"acquisition_file\": \"research/source-data/lozier-gulf-stream-1995/acquisition.json\",\n      \"acquisition_sha256\": \"ca60801b3710875bf63cecf94d7ea4dc281c7261bd397815844b2f9263bd36ea\",\n      \"source_url\": \"https://www.whoi.edu/science/po/people/rcurry/pdf_files/Lozier_etal.PiO1995.pdf\"\n    }\n  ],\n  \"measurements\": [\n    {\n      \"current_id\": \"gulf-stream\",\n      \"name\": \"Gulf Stream\",\n      \"status\": \"editorial_source_extraction_not_canonical\",\n      \"section_geometry\": null,\n      \"whole_current_representative\": false,\n      \"width_rank_eligible\": false,\n      \"full_width_inference_eligible\": false,\n      \"annual_extrema_eligible\": false,\n      \"seasonal_playback_eligible\": false,\n      \"is_confidence_interval\": false,\n      \"calendar_months\": null,\n      \"fixed_layer_bounds_m\": null,\n      \"uncertainty_km\": null,\n      \"whole_current_width_km\": null,\n      \"annual_width_range_km\": null,\n      \"source_retrieved_date\": \"2026-10-14\",\n      \"id\": \"gulf-stream-richardson-1967-transport-width-statistics\",\n      \"measurement_type\": \"published_campaign_transport_width_statistics\",\n      \"width_metric\": \"author_zero_transport_fixed_baseline_span\",\n      \"width_metric_label\": \"1967 transport-float sections: mean and sampled span\",\n      \"approximate_width_km\": 135,\n      \"width_range_km\": [\n        120,\n        145\n      ],\n      \"range_kind\": \"finite_span_of_three_author_reported_crossing_widths\",\n      \"range_interpretation\": \"Author mean135 km from three complete crossings with widths145,140,120 km. Finite campaign span120\u2013145 km; no fourth independent mean occupation, width error, confidence interval, seasonal or annual extrema.\",\n      \"geographic_scope\": \"Cape Hatteras offshore fixed TR-038 baseline; three non-synoptic crossings in1967. Not the whole Gulf Stream or Gulf Stream System.\",\n      \"section_orientation\": \"Width along a baseline bearing135 degrees true; transport velocity is the component normal to that baseline. Recorded flow directions vary; no exact flow-normal projection applied.\",\n      \"layer\": \"Transport per unit width integrated from surface to local bottom, with variable bathymetry. No fixed-depth width layer or surface-only speed boundary.\",\n      \"time_convention\": \"Three complete crossings1,3,4:30June\u20135July,11\u201315July,16\u201318July1967. Campaign26June\u201318July is separate. Multi-day occupations, not simultaneous snapshots or continuous monthly/seasonal means; source clock timezone unspecified.\",\n      \"boundary_rule\": \"Authors smooth transport-per-unit-width measurements and extend their curves to zero. No negative inshore transport was observed; inshore edges are extrapolated. Two complete crossings have offshore negative values, one offshore edge is also extended to zero.\",\n      \"source_url\": \"https://www2.whoi.edu/staff/prichardson/wp-content/uploads/sites/75/2018/11/Richardson-Knauss-1971-dsr.pdf\",\n      \"source_citation\": \"Richardson, P. L. and Knauss, J. A. (1971), Gulf Stream and Western Boundary Undercurrent observations at Cape Hatteras, Deep-Sea Research18,1089\u20131109, doi:10.1016/0011-7471(71)90095-7.\",\n      \"source_locator\": \"Methods printed1091/PDF3; Fig2 printed1093/PDF5; zero-edge construction printed1094\u20131095/PDF6\u20137; Table2 printed1105/PDF17; mean135 km printed1107/PDF19.\",\n      \"source_evidence_kind\": \"published_original_transport_float_campaign_statistics\",\n      \"extraction_method\": \"Transcribed explicit author widths and mean; matched complete occupations using Figure2 and Table2. No curve digitization, geographic endpoints or width error inferred.\",\n      \"phase_label\": \"1967 three complete crossings \u00b7 zero-transport spans\",\n      \"phase_kind\": \"campaign_width_statistics\",\n      \"observed_period\": {\n        \"start\": \"1967-06-30\",\n        \"end\": \"1967-07-18\"\n      },\n      \"source_quality_note\": \"Inshore zero boundaries are author extrapolations, not observed sign reversals. Multi-day sampling and changing flow direction limit synoptic/flow-normal interpretation. Baseline135 degrees differs from mean135 km.\",\n      \"remaining_gates\": [\n        \"Recover geographic boundary coordinates and the original transport observations.\",\n        \"Quantify section-orientation, interpolation and sampling uncertainty.\",\n        \"Independent scientific admission before whole-current dimensions or annual variability.\"\n      ],\n      \"original_regional_context\": {\n        \"description_kind\": \"gulf_stream_transport_float_complete_crossing_statistics\",\n        \"complete_crossing_occupations\": [\n          {\n            \"id\": \"gulf-stream-1967-crossing-1\",\n            \"crossing_number\": 1,\n            \"observed_period\": {\n              \"start\": \"1967-06-30\",\n              \"end\": \"1967-07-05\"\n            },\n            \"width_km\": 145,\n            \"transport_sv\": 58,\n            \"source_clock_timezone\": null,\n            \"is_synoptic_snapshot\": false\n          },\n          {\n            \"id\": \"gulf-stream-1967-crossing-3\",\n            \"crossing_number\": 3,\n            \"observed_period\": {\n              \"start\": \"1967-07-11\",\n              \"end\": \"1967-07-15\"\n            },\n            \"width_km\": 140,\n            \"transport_sv\": 67,\n            \"source_clock_timezone\": null,\n            \"is_synoptic_snapshot\": false\n          },\n          {\n            \"id\": \"gulf-stream-1967-crossing-4\",\n            \"crossing_number\": 4,\n            \"observed_period\": {\n              \"start\": \"1967-07-16\",\n              \"end\": \"1967-07-18\"\n            },\n            \"width_km\": 120,\n            \"transport_sv\": 64,\n            \"source_clock_timezone\": null,\n            \"is_synoptic_snapshot\": false\n          }\n        ],\n        \"partial_crossing_without_width\": 2,\n        \"reported_mean_width_km\": 135,\n        \"mean_is_independent_occupation\": false,\n        \"campaign_context_period\": {\n          \"start\": \"1967-06-26\",\n          \"end\": \"1967-07-18\"\n        },\n        \"baseline_bearing_degrees_true\": 135,\n        \"baseline_bearing_is_width\": false,\n        \"width_is_exact_flow_normal_projection\": false,\n        \"author_boundary_extrapolation_present\": true,\n        \"inshore_negative_transport_observed\": false,\n        \"offshore_negative_transport_observed_complete_crossing_count\": 2,\n        \"all_paired_edges_observed_sign_reversals\": false,\n        \"source_curve_or_coordinates_digitized\": false,\n        \"occupation_range_is_uncertainty_or_annual_extrema\": false,\n        \"display_aria_label\": \"Gulf Stream off Cape Hatteras: three author zero-transport section widths145,140,120 km in1967; reported mean135 km and finite sample span120\u2013145 km. Author extrapolation is retained; no annual extrema or geographic edges.\",\n        \"display_caption\": \"Mean135 km; three complete1967 crossings span120\u2013145 km. Published zero-transport curve edges include extrapolation.\",\n        \"display_method_note\": \"Surface-to-local-bottom transport, fixed135-degree-true baseline; multi-day occupations and varying direction. Mean is not a fourth occupation; finite spread is not uncertainty or annual variability.\",\n        \"comparison_figure\": \"figures/gulf-stream-published-width-definitions.svg\",\n        \"comparison_figure_label\": \"Compare published Gulf Stream width definitions\"\n      }\n    },\n    {\n      \"current_id\": \"gulf-stream\",\n      \"name\": \"Gulf Stream\",\n      \"status\": \"editorial_source_extraction_not_canonical\",\n      \"section_geometry\": null,\n      \"whole_current_representative\": false,\n      \"width_rank_eligible\": false,\n      \"full_width_inference_eligible\": false,\n      \"annual_extrema_eligible\": false,\n      \"seasonal_playback_eligible\": false,\n      \"is_confidence_interval\": false,\n      \"calendar_months\": null,\n      \"fixed_layer_bounds_m\": null,\n      \"uncertainty_km\": null,\n      \"whole_current_width_km\": null,\n      \"annual_width_range_km\": null,\n      \"source_retrieved_date\": \"2026-10-14\",\n      \"id\": \"gulf-stream-lozier-1995-climatological-isopycnal-span\",\n      \"measurement_type\": \"published_climatological_isopycnal_contour_span\",\n      \"width_metric\": \"mean_isopycnal_pressure_contour_separation\",\n      \"width_metric_label\": \"Historical climatology: sigma-theta26.50 pressure contours\",\n      \"approximate_width_km\": 300,\n      \"width_range_km\": null,\n      \"range_interpretation\": \"One approximate author-reported mean contour span. Meander envelope500 km, smoothing scale100 km and factor-of-two comparison are separate context; no150 km inferred observation or combined135\u2013300 km range.\",\n      \"geographic_scope\": \"Gulf Stream near70 W on the mean sigma-theta26.50 surface; not the entire current or its larger system.\",\n      \"section_orientation\": \"Author contour separation near70 W; exact geographic endpoints and flow-normal orientation not extracted.\",\n      \"layer\": \"Potential-density-anomaly surface sigma-theta26.50. Width between100 and400 dbar pressure contours on that surface; these are not fixed100\u2013400 m depth bounds.\",\n      \"time_convention\": \"Historical isopycnal climatology from the NODC archive available as of April1990. Basin-wide observations span1904\u20131990; exact local averaging dates and seasonal weights are unresolved. Publication1995 is not an observation date.\",\n      \"boundary_rule\": \"Author estimates mean width from the separation of100 and400 dbar contours on the sigma-theta26.50 isopycnal near70 W, rather than paired velocity edges.\",\n      \"source_url\": \"https://www.whoi.edu/science/po/people/rcurry/pdf_files/Lozier_etal.PiO1995.pdf\",\n      \"source_citation\": \"Lozier, M. S., Owens, W. B. and Curry, R. G. (1995), The climatology of the North Atlantic, Progress in Oceanography36,1\u201344, doi:10.1016/0079-6611(95)00013-5.\",\n      \"source_locator\": \"Abstract printed1/PDF1; section2 printed3/PDF3; section5.1 printed14\u201317/PDF14\u201317; Figure7 printed15/PDF15; width and meandering discussion printed17/PDF17.\",\n      \"source_evidence_kind\": \"published_original_historical_isopycnal_climatology\",\n      \"extraction_method\": \"Transcribed explicit about300 km contour span after original-page review. No contour digitization, depth conversion, exact local period or inferred instantaneous width.\",\n      \"phase_label\": \"Historical climatology \u00b7 near70 W contour span\",\n      \"phase_kind\": \"climatological_isopycnal_span\",\n      \"observed_period\": null,\n      \"source_quality_note\": \"Mean pressure contours on an isopycnal differ from instantaneous transport or half-speed boundaries. Local period and width error unresolved; pressure levels are not fixed depths.\",\n      \"remaining_gates\": [\n        \"Recover exact local contribution dates, contour geography and orientation.\",\n        \"Assess smoothing, averaging and meandering effects independently.\",\n        \"Independent scientific admission before geographic footprint or physical annual dimensions.\"\n      ],\n      \"original_regional_context\": {\n        \"description_kind\": \"gulf_stream_historical_mean_isopycnal_contour_span\",\n        \"isopycnal_label\": \"sigma-theta26.50\",\n        \"pressure_contours_dbar\": [\n          100,\n          400\n        ],\n        \"pressure_contours_are_fixed_depth_bounds\": false,\n        \"archive_available_as_of\": \"1990-04\",\n        \"basin_archive_years_context\": [\n          1904,\n          1990\n        ],\n        \"basin_archive_years_are_exact_local_period\": false,\n        \"source_meander_envelope_context_km\": 500,\n        \"source_local_smoothing_context_km\": 100,\n        \"meander_envelope_is_current_width_or_uncertainty\": false,\n        \"factor_two_comparison_defines_instantaneous_measurement\": false,\n        \"source_curve_or_coordinates_digitized\": false,\n        \"display_aria_label\": \"Gulf Stream near70 W: about300 km climatological separation of100 and400 dbar contours on sigma-theta26.50. Historical source cutoffApril1990; local averaging period unresolved. No fixed-depth width or annual range.\",\n        \"display_caption\": \"About300 km \u00b7 historical mean contour span on sigma-theta26.50 near70 W. Pressure levels are not fixed depths.\",\n        \"display_method_note\": \"Historical climatology; exact local dates and orientation unresolved. Source discusses meandering and smoothing separately; no instantaneous150 km record or135\u2013300 km range inferred.\",\n        \"comparison_figure\": \"figures/gulf-stream-published-width-definitions.svg\",\n        \"comparison_figure_label\": \"Compare published Gulf Stream width definitions\"\n      }\n    }\n  ],\n  \"whole_current_width_km\": null,\n  \"annual_width_range_km\": null,\n  \"measurements_are_same_metric_or_period\": false,\n  \"pooled_width_range_km\": null,\n  \"owner_scope_note\": \"Gulf Stream regional main-current sections only. Do not transfer to Gulf Stream System, Florida or North Atlantic Current. Existing inverse-model and surface-component diagnostics remain separate.\",\n  \"existing_current_records\": [\n    {\n      \"id\": \"cainzos-2023-t02-row-59-section-span\",\n      \"current_id\": \"gulf-stream\",\n      \"name\": \"Gulf Stream\",\n      \"status\": \"editorial_source_extraction_not_canonical\",\n      \"measurement_type\": \"published_inverse_hydrographic_section_span\",\n      \"width_metric\": \"transport_diagnosed_hydrographic_section_span\",\n      \"width_metric_label\": \"transport-selected cruise-section span\",\n      \"approximate_width_km\": 256,\n      \"width_range_km\": null,\n      \"range_interpretation\": \"Publisher Table 2 distance rounded to kilometres. Width uncertainty is not reported. Transport uncertainty is a separate quantity. Separate cruises and layers are not an annual range.\",\n      \"geographic_scope\": \"Gulf Stream 36\u2218\u2009N; source longitude limits -71.7:-69.1 degrees east. Section track may deviate from nominal latitude near boundaries. Endpoint latitudes remain unextracted.\",\n      \"section_geometry\": null,\n      \"section_orientation\": \"Nominally zonal hydrographic track; boundary/platform stations may deviate to cross the main flow. Exact boundary track orientation unresolved.\",\n      \"layer\": \"Publisher neutral-density layer indices 1:6; reported depth extent 0 to 891 m. Density surfaces are not a uniform fixed-depth slice.\",\n      \"time_convention\": \"74AB20050501: section sampled 2005-05-03 to 2005-06-12; inverse-model group 2000\u20132009. Cruise snapshot, not a decade mean or seasonal composite.\",\n      \"boundary_rule\": \"Section 2.3: station pairs selected by consistent slope of eastward accumulated horizontal mass transport; vertical extent by the same integrated flow direction. No fixed speed cutoff or instantaneous velocity envelope inferred.\",\n      \"boundary_sides\": \"source_selected_station_limits\",\n      \"source_url\": \"https://os.copernicus.org/articles/19/1009/2023/\",\n      \"source_citation\": \"Ca\u00ednzos et al. (2023), Consistent picture of the horizontal circulation of the Atlantic Ocean over 3 decades, Ocean Science 19, 1009\u20131045, doi:10.5194/os-19-1009-2023.\",\n      \"source_locator\": \"Table 2, Worksheet 1, row 59, columns A\u2013F; Table 1 row 13; Sections 2.1\u20132.3.\",\n      \"source_retrieved_date\": \"2026-10-07\",\n      \"source_evidence_kind\": \"published_inverse_model_hydrographic_cruise_snapshot\",\n      \"extraction_method\": \"Publisher XLSX cells retained and distance transcribed directly; explicit section/cruise join. No map or longitude-to-distance conversion.\",\n      \"whole_current_representative\": false,\n      \"width_rank_eligible\": false,\n      \"annual_extrema_eligible\": false,\n      \"seasonal_playback_eligible\": false,\n      \"full_width_inference_eligible\": false,\n      \"is_confidence_interval\": false,\n      \"phase_kind\": \"inverse_hydrographic_section_span\",\n      \"phase_label\": \"74AB20050501 \u00b7 36 degrees north\",\n      \"observed_period\": null,\n      \"calendar_months\": null,\n      \"fixed_layer_bounds_m\": null,\n      \"hydrographic_section_context\": {\n        \"table_2_row\": 59,\n        \"table_1_row\": 13,\n        \"source_group\": \"Gulf Stream 36\u2218\u2009N\",\n        \"inverse_model_decade_group\": \"2000\u20132009\",\n        \"cruise_id\": \"74AB20050501\",\n        \"section_id\": \"A03\",\n        \"cruise_sampling_window\": {\n          \"start\": \"2005-05-03\",\n          \"end\": \"2005-06-12\"\n        },\n        \"sampling_window_role\": \"whole_section_sampling_window_not_exact_boundary_station_occupation\",\n        \"nominal_section_latitude_degrees_north\": 36.0,\n        \"table_1_latitude_label\": \"36\u2218\u2009N\",\n        \"source_station_range_label\": \"1:10\",\n        \"source_longitude_limits_degrees_east\": [\n          -71.7,\n          -69.1\n        ],\n        \"source_layer_indices_label\": \"1:6\",\n        \"source_depth_extent_m\": [\n          0,\n          891\n        ],\n        \"station_index_convention\": \"publisher_table_label_not_reindexed_against_table_1_station_count\",\n        \"nominal_latitude_is_endpoint_latitude\": false,\n        \"depth_extent_is_uniform_fixed_measurement_layer\": false,\n        \"decade_group_is_time_average\": false,\n        \"source_distance_is_recomputed_from_nominal_latitude\": false,\n        \"source_width_uncertainty_km\": null\n      },\n      \"remaining_gates\": [\n        \"Recover actual station coordinates before a geographic edge locator or state intersection.\",\n        \"Independent scientific admission and release review.\"\n      ],\n      \"extraction_file\": \"research/atlantic-cruise-section-width-extraction.json\",\n      \"extraction_sha256\": \"c8f4e2e6211bff2caef9d0b41df0c027bee43aaee8c38b50c0b28b06e6c4d63b\"\n    }\n  ]\n}\n","status":"editorial_source_extraction_not_canonical"},{"current_id":"loop","document":{"acquisition_file":"research/source-data/uhlhorn-loop-2008/acquisition.json","acquisition_sha256":"4b42179ee66328dc3b3c5e99ec1b8cefd4bc843bc366053c7ce2952ff03325a5","current_id":"loop","integrity_contract_file":"research/uhlhorn-loop-2008-thesis-integrity-contract.json","integrity_contract_sha256":"0ac16f5415f340304cfb72ec346935e3b72393c22da006272065cc1e059c4df7","measurement":{"annual_extrema_eligible":false,"annual_width_range_km":null,"approximate_width_km":100,"boundary_rule":"Author-reported cross-stream extent of geostrophic speeds at least0.4 m/s; preserve fixed cutoff. Approximate e-folding wording is source context, not an adopted relative threshold.","calendar_months":null,"current_id":"loop","extraction_method":"Transcribed explicit about100 km prose after original-page and section review; no curve digitization or reconstruction from longitude ticks.","fixed_layer_bounds_m":null,"full_width_inference_eligible":false,"geographic_scope":"Southeastern Gulf of Mexico, middle-grid-row cross section of the analyzed Loop Current; numerical boundary endpoints not extracted.","id":"loop-uhlhorn-2008-prelili-geostrophic-core","is_confidence_interval":false,"layer":"Geostrophic core cross section. Source describes structure mainly within upper300 m; depth at which prose100 km span is evaluated is not separately specified. Reference level is shallower of750 m and local bottom, not a width layer.","measurement_type":"published_campaign_geostrophic_core_span","name":"Loop Current","observed_period":{"end":"2002-09-23","start":"2002-09-19"},"original_regional_context":{"comparison_figure":"figures/loop-uhlhorn-2008-core-width.svg","comparison_figure_label":"Inspect the Loop Current core width definition","core_depth_context_is_uniform_width_slab":false,"description_kind":"loop_prestorm_fixed_speed_geostrophic_core","display_aria_label":"Loop Current: about100 km author-reported fixed0.4 m/s geostrophic core span,19-23September2002. Relative reference flow, exact evaluation depth and geographic edges unresolved; no annual range.","display_caption":"About100 km \u00b7 prestorm geostrophic core at fixed0.4 m/s cutoff.","display_method_note":"Thermal-wind density analysis relative to750 m or bottom. Upper300 m core context is not a uniform width layer. Source e-folding wording is not adopted; no width-error or seasonal interval.","general_flight_period_context":{"end":"2002-09-23","start":"2002-09-18"},"poststorm_current_change_is_width_change":false,"reference_condition":"zero geostrophic velocity at shallower of750 m and local bottom","reference_depth_is_width_layer":false,"reference_depth_limit_m":750,"source_curve_or_coordinates_digitized":false,"source_e_folding_wording_is_adopted_threshold":false,"source_local_peak_context_m_s":0.75,"source_speed_threshold_m_s":0.4,"source_threshold_to_prose_peak_ratio":0.5333333333333333,"source_width_period":{"end":"2002-09-23","start":"2002-09-19"},"speed_bias_is_width_error":false,"upper_core_depth_context_m":300},"phase_kind":"campaign_geos
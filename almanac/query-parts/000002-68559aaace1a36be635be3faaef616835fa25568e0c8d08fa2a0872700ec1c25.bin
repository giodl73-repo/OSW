ce_pdf_is_image_scan\": true\n  },\n  \"measurement\": {\n    \"id\": \"south-pacific-stramma-1990-03-relative-band-constraint\",\n    \"current_id\": \"south-pacific\",\n    \"name\": \"South Pacific Current\",\n    \"status\": \"editorial_source_extraction_not_canonical\",\n    \"measurement_type\": \"published_month_relative_geostrophic_band_width_constraint\",\n    \"width_metric\": \"author_reported_current_width\",\n    \"approximate_width_km\": null,\n    \"width_range_km\": null,\n    \"range_kind\": \"author_reported_dated_less_than_width_constraint\",\n    \"range_interpretation\": \"Reported enhanced eastward band less than200 km in one historical section. Representative width, lower bound, confidence limits, whole-current envelope and annual range remain unknown.\",\n    \"geographic_scope\": \"Western South Pacific near Chatham Rise; Baldrige section d at nominal170 W in March1990. Front station table gives170.6 W; exact width edges unresolved.\",\n    \"section_geometry\": null,\n    \"section_orientation\": \"Nominal meridional hydrographic section; no diagnosed flow-normal axis or paired width endpoints.\",\n    \"layer\": \"Enhanced eastward relative-geostrophic band in Figure3 upper1000 m context. Surface-intensified flow; exact width-evaluation depth unknown. No uniform vertical width slab.\",\n    \"time_convention\": \"March1990, late austral summer, from Table1(d) and Figure3 caption. Exact occupation days and annual coverage unavailable.\",\n    \"boundary_rule\": \"Author reports band less than200 km wide. No numeric edge cutoff or geographic edge pair supplied; peak/sampled velocities are context only.\",\n    \"source_url\": \"https://doi.org/10.1175/1520-0485(1995)025<0077:TSPC>2.0.CO;2\",\n    \"source_citation\": \"Stramma, L., R.G. Peterson and M. Tomczak (1995), The South Pacific Current, Journal of Physical Oceanography25,77-91.\",\n    \"source_locator\": \"Original p82 right column; Table1(d) p79, Table2(d) p83 and Figure3/caption p84. Rejected illustrative100 km assumption: p89.\",\n    \"source_retrieved_date\": \"2026-10-17\",\n    \"source_evidence_kind\": \"published_original_scan_reviewed_relative_geostrophic_band_constraint\",\n    \"extraction_method\": \"Source qualifier and context transcribed after visual review of original pages. No source curve or edge digitization.\",\n    \"whole_current_representative\": false,\n    \"width_rank_eligible\": false,\n    \"full_width_inference_eligible\": false,\n    \"annual_extrema_eligible\": false,\n    \"seasonal_playback_eligible\": false,\n    \"is_confidence_interval\": false,\n    \"phase_label\": \"Baldrige enhanced eastward band / March 1990\",\n    \"phase_kind\": \"month_dated_width_constraint\",\n    \"observed_period\": null,\n    \"calendar_months\": null,\n    \"fixed_layer_bounds_m\": null,\n    \"uncertainty_km\": null,\n    \"source_quality_note\": \"Original15-page scan retained unchanged and ignored. Full field curves, edge coordinates and width uncertainty have not been digitized or inferred. Frontal bracket differs from velocity width.\",\n    \"remaining_gates\": [\n      \"Recover author boundary definition and exact evaluation depth before paired physical edges.\",\n      \"Acquire compatible repeated sections before seasonal widths or annual extrema.\",\n      \"Independent scientific admission.\"\n    ],\n    \"original_regional_context\": {\n      \"source_quote\": \"less than 200 km wide\",\n      \"source_section\": \"d / RV Baldrige\",\n      \"observed_month\": \"1990-03\",\n      \"nominal_section_longitude_degrees_east\": -170,\n      \"front_table_longitude_degrees_east\": -170.6,\n      \"front_station_latitudes_degrees_north\": [\n        -43.5,\n        -42.5\n      ],\n      \"front_bracket_is_width_edges\": false,\n      \"relative_geostrophic_reference\": {\n        \"potential_density_symbol\": \"sigma_2\",\n        \"value_kg_m3\": 36.75,\n        \"source_reference_depth_range_m\": [\n          1800,\n          1840\n        ],\n        \"reference_is_width_layer\": false\n      },\n      \"source_velocity_context\": {\n        \"surface_peak_cm_s\": 7,\n        \"near_500m_cm_s\": 4,\n        \"velocities_are_width_cutoffs\": false\n      },\n      \"field_plot_depth_context_m\": [\n        0,\n        1000\n      ],\n      \"field_plot_context_is_uniform_width_layer\": false,\n      \"illustrative_transport_width_km\": 100,\n      \"illustrative_transport_width_is_observation\": false,\n      \"axis_to_ACC_separation_km\": {\n        \"operator\": \"gt\",\n        \"value\": 500,\n        \"is_current_width\": false\n      },\n      \"display_method_note\": \"One reported less-than band constraint; representative width, lower bound, numerical uncertainty, mapped edges and annual extrema remain unknown. March 1990 dates the observation; 1995 is publication. The 100 km transport assumption and greater-than-500 km separation from ACC flow are distinct contextual values.\",\n      \"display_aria_label\": \"South Pacific Current: the authors report an enhanced eastward band less than 200 km wide near nominal 170 W in March 1990. Relative geostrophic reference sigma2=36.75 kg/m3 at 1800-1840 m. Representative width, exact days, lower bound and error unknown. No 200 km point, zero-to-200 interval, geographic width band or annual range.\",\n      \"display_caption\": \"March 1990 / Baldrige section d near nominal 170 W. Source-reported constraint for an enhanced eastward relative-geostrophic band; representative width and paired edges unknown.\"\n    },\n    \"reported_width_constraint\": {\n      \"kind\": \"author_reported_dated_less_than\",\n      \"operator\": \"lt\",\n      \"reference_scale_km\": 200,\n      \"source_notation\": \"<200 km\",\n      \"is_rigorous_upper_bound\": false,\n      \"representative_width_km\": null,\n      \"lower_bound_km\": null,\n      \"numerical_uncertainty_km\": null\n    },\n    \"time_precision\": \"month\",\n    \"observed_month\": \"1990-03\"\n  },\n  \"remaining_scientific_gates\": [\n    \"Recover author boundary definition and exact evaluation depth before paired physical edges.\",\n    \"Acquire compatible repeated sections before seasonal widths or annual extrema.\",\n    \"Independent scientific admission.\"\n  ]\n}\n","status":"reviewed_original_source_constraint_for_editorial_integration"},{"current_id":"south-atlantic","document":{"acquisition_file":"research/source-data/stramma-south-atlantic-1990/acquisition.json","acquisition_sha256":"4cd5edc3bde7917fad14b48efcb4d73e45511906026b54a1a9502d8509c7953c","current_id":"south-atlantic","figure_file":"figures/south-atlantic-stramma-1983-secondary-band.svg","figure_sha256":"520d58dc2ae2bb2e9c217384e3f916ebf44763c6f09a10f1cb316d5faea8f521","measurement":{"annual_extrema_eligible":false,"approximate_width_km":200,"boundary_rule":"Source describes a200-km-wide band south of the primary surface front. No explicit numeric velocity edge rule or paired width coordinates. Secondary-core position and offset are separate.","calendar_months":null,"current_id":"south-atlantic","extraction_method":"Visual original page review; nominal breadth transcribed. No source curve, flow boundary or uncertainty digitized.","fixed_layer_bounds_m":null,"full_width_inference_eligible":false,"geographic_scope":"Knorr Ajax Leg1 section k at1 E, October1983; band south of primary surface Subtropical Front. Secondary core near39-40 S, not width endpoints.","id":"south-atlantic-stramma-1983-10-southern-band-width","is_confidence_interval":false,"layer":"Relative-geostrophic southern component band; Figure5d upper1000 m field and transport context. Exact width evaluation depth unresolved; no uniform depth slab.","measurement_type":"published_month_relative_geostrophic_subcomponent_band_width","name":"South Atlantic Current","observed_month":"1983-10","observed_period":null,"original_regional_context":{"component_role":"Southern SAC transport band south of the primary surface Subtropical Front; excludes the primary-front contribution.","core_offset_is_width":false,"description_kind":"historical_sac_southern_component_band","display_aria_label":"South Atlantic Current: authors report a200 km wide southern component band at1 E in October1983. The primary front carries additional SAC flow; total SAC width and secondary-core diameter unknown. Relative geostrophic reference sigma4=45.87 kg/m3 at3470-3560 m. Width depth, edges, exact days and error unknown; no annual range.","display_caption":"October 1983 / Knorr section k at 1 E. Source-reported southern component band breadth; additional SAC flow crosses the primary front. Total-current width unknown.","display_method_note":"200 km describes the southern band, not the entire SAC or the diameter of its secondary core. The similarly sized core offset is distinct. Width-evaluation depth, edge cutoff, paired geographic boundaries and numerical error remain unknown. No annual or seasonal inference.","display_title":"Historical southern component band","field_plot_context_is_uniform_width_layer":false,"field_plot_depth_context_m":[0,1000],"front_or_core_bracket_is_width_edges":false,"nominal_section_longitude_degrees_east":1,"observed_month":"1983-10","primary_surface_front_station_latitudes_degrees_north":[-38,-37],"relative_geostrophic_reference":{"potential_density_symbol":"sigma_4","reference_is_width_layer":false,"source_reference_depth_range_m":[3470,3560],"value_kg_m3":45.87},"secondary_core_latitudes_degrees_north":[-40,-39],"secondary_core_width_km":null,"source_approximate_core_offset_south_of_primary_front_km":200,"source_reported_band_breadth_km":200,"source_section":"k / Knorr Ajax Cruise Leg1","total_current_width_km":null,"transport_context":{"integration_depth_range_m":[0,1000],"source_rounded_sac_sv":17,"source_rounded_southern_band_sv":8,"table2_at_front_sv":8.8,"table2_north_of_front_sv":-1.4,"table2_southern_band_sv":8.3,"transport_is_width_uncertainty":false,"width_d
4,7774,7854,7927,7935,8083,8111,8169,8261,8453,8472,8934,8962,9212,9278,9840,10411,10420,10432,10557,10567,10696,10867,10882,10897,11065,11144,11187,11342,11476,11492,11512,11812,11828]},"inmin_lc":{"source_indices":53,"distinct_indices":53,"time_base":"htimef","indexing":"one_based_MATLAB","original_indices":[1415,1459,1467,1892,1920,1980,1996,2024,2095,2112,2120,3362,3401,3998,6377,6387,6393,6490,6915,7189,7198,7221,7231,7245,7429,7509,7579,8549,8586,8601,8611,8648,8668,8683,8715,8729,8742,8773,8776,8794,9355,9365,9401,9411,9429,9907,9931,10010,10021,10033,10061,10810,10988]}},"source_composite_axes":{"CurAxisPositive":{"source_rows":248,"paired_finite_rows":248,"longitude_only_finite_rows":0,"latitude_only_finite_rows":0,"all_missing_rows":0,"longitude_bounds":[-86.861656778744,-80.99341731895612],"latitude_bounds":[16.479700506180333,22.693409932940146]},"CurAxisNegative":{"source_rows":248,"paired_finite_rows":248,"longitude_only_finite_rows":0,"latitude_only_finite_rows":0,"all_missing_rows":0,"longitude_bounds":[-86.79443197825708,-81.01799208510319],"latitude_bounds":[16.472721536281295,23.141120242825313]}},"composite_axes_are_daily_paths":false,"source_axis_member_support_counts_available":false,"underlying_daily_axis_coordinates_available":false,"axis_member_time_association_independently_verified":false,"surface_composite_member_support_counts_available":false,"independent_original_cmems_canek_reproduction":false,"current_length_admitted":false,"width_measurement_admitted":false,"annual_physical_range_admitted":false,"source_file_sha256":"316daa53a45fc6b2817abfa4ba8da76344323d20c84c781bfa8705163235e073","source_numerical_data_are_author_processed":true,"metadata_strings_exposed_in_derived_schema":false},"research_evidence":{"current_id":"loop","label":"Loop Current","diagnostic_id":"diagnostic:current-research:loop","title":"Author surface composites and source coverage","finding":"Two processed surface-flow configurations are available. Separate gateway-connected contour paths measure about 1,400 km and 600 km. These conditional paths do not establish a ranked whole-current length or physical width; the supplied coordinate means remain incomplete.","facts":[{"label":"Processed surface configurations","value":"2 conditional composites"},{"label":"Source clocks","value":"4,111 / 4,111 / 11,902 entries"},{"label":"Coordinate points","value":"248 per composite; unjoined"},{"label":"Complete Loop path","value":"Not supplied"},{"label":"Nominal composite contour paths","value":"About 1,400 km positive / 600 km negative; unranked"}],"notes":["These are author-processed MCA phase composites, not dated snapshots, seasons or forecasts. Original daily Canek/CMEMS observations are not supplied in this compact archive.","The two coordinate means were formed with omitnan. Daily member coordinates and per-point support counts are unavailable; no full Loop axis or length is inferred.","The three source clocks are distinct. One tisp entry is missing at zero-based OSW position3462 (MATLAB index3463); it is not filled from tid. Original phase/grid selection indices remain one-based MATLAB indices. Calendar timezone is unspecified, and dates are source clocks rather than new current observations.","The area_loop and AMR_loop scalars remain unscaled under their original names. No width, length or occupied-current polygon is inferred from enclosed-area metrics.","The source API declares CC BY4.0 and version0. README retains a license-selection TODO, CITATION.cff says1.0.0, and the associated manuscript DOI is a placeholder; these documentary disagreements remain visible.","A separate fixed contour experiment measures the author-plotted absolute ADT guide between editorial gateways. All 54 level/gateway cases have one supported path; 18 disconnected closed-ring components are rejected. These conditional contour paths are not mean daily current lengths, annual extrema, confidence bounds or physical widths.","Calculated readbacks use a declared precision for reproducibility. That precision is not observational uncertainty or an annual range. Original source values, masks and quality flags remain unchanged; the exact record pins the calculation rules."],"next_evidence":"Recover complete daily Loop axes or a validated gateway-connected algorithm before route/length admission; establish exact composite-member support before physical interpretation.","figure_file":"figures/loop-durante-2026-source-view.svg","figure_label":"Source composites and separate clocks","figure_alt":"Two native-grid geostrophic-speed composites with direction arrows and all248unjoined coordinate means each, plus three separate source-clock coverage rows. Gray means missing source data. Coordinate means end below23.2N and do not form a complete Loop Current. No dimensions are admitted.","source_file":"research/source-data/loop-durante-2026-v0/quality.json","original_url":"https://zenodo.org/records/22652650","source_links":[{"label":"Exact source schema and quality","document":"research/source-data/loop-durante-2026-v0/quality.json","pointer":""},{"label":"Exact composite fields and masks","document":"research/loop-durante-2026-source-view.json","pointer":"/phases"},{"label":"All original clocks","document":"research/loop-durante-2026-source-view.json","pointer":"/clocks"},{"label":"Unscaled source area scalars","document":"research/loop-durante-2026-source-view.json","pointer":"/source_scalar_series"},{"label":"Source custody and release notes","document":"research/source-data/loop-durante-2026-v0/acquisition.json","pointer":""},{"label":"All 54 contour cases and complete velocity samples","document":"research/loop-durante-2026-composite-contour-paths.json","pointer":"/cases"},{"label":"Original contours before gateway clipping","document":"research/loop-durante-2026-composite-contour-paths.json","pointer":"/source_contours"},{"label":"Contour experiment phase summaries","document":"research/loop-durante-2026-composite-contour-paths.json","pointer":"/phase_summaries"},{"label":"Contour figure provenance","document":"research/loop-durante-2026-composite-contour-figure.json","pointer":""}],"table":{"caption":"Source clocks are not dates of complete current paths. Missing clocks remain missing; no timezone is inferred.","headers":["Original clock","Source entries","Finite calendar support","Missing times"],"rows":[["tid","4111","2011-05-11 to 2023-07-10","0"],["tisp","4111","2011-05-11 to 2023-07-10","1"],["htimef","11902","1993-01-01 to 2025-08-02","0"]]},"additional_tables":[{"caption":"Supplied coordinate means are incomplete for a full Loop path. Bounds describe source points, not current extent or uncertainty.","headers":["Original field","Paired finite points","Northernmost point","Full Loop path"],"rows":[["CurAxisPositive","248","22.69 N","Not supplied"],["CurAxisNegative","248","23.14 N","Not supplied"]]},{"caption":"All 54 declared composite contour cases. Lengths rounded to 100 km measure open contour arcs between editorial gates. Gate and level shifts are sensitivity choices, not uncertainty, seasons or annual limits. No reference-route or whole-current length admission.","headers":["Composite","ADT (m)","Entry latitude","Exit longitude","Outcome","Contour path"],"rows":[["Positive","0.50","21.750 N","81.625 W","unique supported path","About 1,400 km"],["Positive","0.50","21.750 N","81.500 W","unique supported path","About 1,400 km"],["Positive","0.50","21.750 N","81.375 W","unique supported path","About 1,400 km"],["Positive","0.50","21.875 N","81.625 W","unique supported path","About 1,400 km"],["Positive","0.50","21.875 N","81.500 W","unique supported path","About 1,400 km"],["Positive","0.50","21.875 N","81.375 W","unique supported path","About 1,400 km"],["Positive","0.50","22.000 N","81.625 W","unique supported path","About 1,400 km"],["Positive","0.50","22.000 N","81.500 W","unique supported path","About 1,400 km"],["Positive","0.50","22.000 N","81.375 W","unique supported 
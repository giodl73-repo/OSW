ltered regional width curve readings","entity_id":"current:kuroshio","current_id":"kuroshio","status":"editorial_source_plot_readings_scientific_review_pending","rank_eligible":false,"source_file":"research/kuroshio-ecs-filtered-width-time-series.json","source_file_sha256":"a075adc8efa9d9b5999a68b565cf114979a259ad3a738b2d500a1d50f2b199f6","source_json":"{\n  \"schema\": \"osw.filtered-current-width-plot-time-series.v1\",\n  \"current_id\": \"kuroshio\",\n  \"status\": \"editorial_source_plot_readings_scientific_review_pending\",\n  \"source_url\": \"https://www.sciencedirect.com/science/article/pii/S0967063711001968\",\n  \"source_citation\": \"Liu and Gan (2012), Variability of the Kuroshio in the East China Sea derived from satellite altimetry data, Deep-Sea Research I 59, 25-36, doi:10.1016/j.dsr.2011.10.008.\",\n  \"source_locator\": \"Figure7a and caption, printed page30/PDF6; section3.3 printed pages30–31; method section2.2.\",\n  \"input_sha256\": {\n    \"research/source-data/kuroshio-liu-gan-2012/figure7a-time-extraction.json\": \"05a0be59242a846390472334c834c71b24cfc93302d82327d43933f3ee2a0729\",\n    \"plans/kuroshio-filtered-width-time-series-protocol-v1.md\": \"b9bc5e3480d3917de88df916c6a1d1325c8950a7f6c853505266f62c028b7910\",\n    \"research/kuroshio-liu-gan-2012-stream-mean-width-scope-audit.json\": \"607924d8b2f54393fcb150bd29b6e08f5abc99616e72b9142f879a17ded83fcd\",\n    \"research/source-data/kuroshio-liu-gan-2012/acquisition.json\": \"3c067c722f79ee4688de6adb176849587ce40e1612e4cd035ba4f2993eafac0d\",\n    \"research/source-data/kuroshio-liu-gan-2012/journal-article.pdf\": \"a452007ff7f3b0051f811ba8172e9ae7932642ed1916a29c779db6335772203b\"\n  },\n  \"config_file\": \"research/source-data/kuroshio-liu-gan-2012/figure7a-time-extraction.json\",\n  \"protocol_file\": \"plans/kuroshio-filtered-width-time-series-protocol-v1.md\",\n  \"generator_file\": \"analysis/build_kuroshio_filtered_width_series.py\",\n  \"generator_sha256\": \"7ae9485fc37be7e6688c16dfc6f26d00ff589f64fd64c26d19ee9495d7e61beb\",\n  \"extraction_runtime\": {\n    \"pymupdf\": \"1.28.2\"\n  },\n  \"width_metric\": \"half_year_filtered_regional_mean_diagnosed_axis_normal_0.1m_s_threshold_width\",\n  \"units\": \"km\",\n  \"layer\": \"Surface absolute geostrophic diagnosis; no fixed-depth section boundaries extracted.\",\n  \"geographic_scope\": \"Source stream mean between122–130E in the East China Sea, not the whole Kuroshio.\",\n  \"source_study_period_years\": [\n    1993,\n    2008\n  ],\n  \"source_product\": \"AVISO updated merged absolute surface geostrophic velocity; ADT = SLA + MDT\",\n  \"source_temporal_resolution\": \"7-day averaged gridded product\",\n  \"source_method_context\": {\n    \"original_grid_degrees\": 0.3333333333333333,\n    \"analysis_interpolation_grid_degrees\": 0.1,\n    \"grid_interpolation_is_new_observation_resolution\": false,\n    \"averaging_order\": \"Stream-coordinate diagnostics including section width calculated every 7 days, then temporal and along-stream summaries; not width diagnosed from a seasonal mean velocity field.\",\n    \"source_quality_note\": \"Weekly averaged and smoothed surface geostrophic product; ageostrophic flow is not included in the width diagnosis. Interpolation to 0.1 degree does not add independent observation resolution. Exact spatial/temporal weighting and season-to-month convention remain unresolved.\"\n  },\n  \"source_temporal_filter\": {\n    \"source_label\": \"1/2 year filtered mean\",\n    \"kernel\": null,\n    \"window_alignment\": null,\n    \"endpoint_treatment\": null,\n    \"filter_reproduced\": false\n  },\n  \"sample_time_kind\": \"month_midpoint_positions_between_printed_year_ticks_not_exact_UTC_dates\",\n  \"plot_coordinate_allowance_years\": 0.05,\n  \"monthly_sampling_is_new_source_resolution\": false,\n  \"samples_are_raw_monthly_means\": false,\n  \"independent_sample_count\": null,\n  \"source_curve_segment_count\": 755,\n  \"source_curve_breaks\": [\n    {\
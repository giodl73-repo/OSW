_span\",\n  \"section\": {\n    \"fixed_axis\": \"latitude\",\n    \"fixed_coordinate\": -32,\n    \"varying_axis\": \"longitude\",\n    \"domain\": [\n      60,\n      116\n    ],\n    \"peak_search\": [\n      80,\n      105\n    ],\n    \"component\": \"northward\"\n  },\n  \"scope_note\": \"OSW selects a broad offshore zonal section at 32 S and a peak-search window well offshore of the coastal Leeuwin system. Neither the section domain nor the peak-search window is a published West Australian Current boundary. The strongest eligible monthly northward component may represent an eddy or another flow; association with the named current remains unverified.\",\n  \"source_url\": \"https://oceanwatch.pifsc.noaa.gov/erddap/griddap/yearly_336c_0b32_9cd3.csv?u%5B%282013-01-01T00%3A00%3A00Z%29%3A1%3A%282013-12-28T00%3A00%3A00Z%29%5D%5B%2815%29%5D%5B%28-32%29%5D%5B%2860%29%3A1%3A%28116%29%5D%2Cv%5B%282013-01-01T00%3A00%3A00Z%29%3A1%3A%282013-12-28T00%3A00%3A00Z%29%5D%5B%2815%29%5D%5B%28-32%29%5D%5B%2860%29%3A1%3A%28116%29%5D\",\n  \"provider\": \"Earth & Space Research / NOAA PIFSC ERDDAP mirror\",\n  \"product_version\": \"2017.0\",\n  \"source_license\": \"The data may be used and redistributed for free but is not intended\\nfor legal use, since it may contain inaccuracies. Neither the data\\nContributor, ERD, NOAA, nor the United States Government, nor any\\nof their employees or contractors, makes any warranty, express or\\nimplied, including warranties of merchantability and fitness for a\\nparticular purpose, or assumes any legal liability for the accuracy,\\ncompleteness, or usefulness, of this information.\",\n  \"layer\": \"Satellite-derived near-surface product with nominal 15 m coordinate, not direct depth-resolved observations.\",\n  \"time_convention\": \"72 nominal five-day archive samples with four six-day gaps, 2013-01-01 through 2013-12-26; not climatology.\",\n  \"monthly_width_is_mean_of_instantaneous_widths\": false,\n  \"current_association_verified\":
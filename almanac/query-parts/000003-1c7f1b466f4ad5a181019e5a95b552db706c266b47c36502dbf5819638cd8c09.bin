de88bf65d32003d708cd069f44071f4fb1d485bf826a94e7023a0fdc1","analysis/norkyst_continuous_source.py":"bd5aa0e7693030af275b7ecdf55875bd016a97d89f00a0d0cb23559646fecae5","plans/norkyst-ingoy-within-month-support-2026-10-17.md":"aac3cd4bc388e2c56b772e3d1878af75b8c60bd3d2504990b7d9104a7d94ef6f","plans/norkyst-ingoy-monthly-regional-map-rules-2026-10-17.md":"e08c49970f9382a45c0c6baf5ad2efdd61426aec1ee2db21d0a2b2ce78442394"},"generator_sha256":"0dd4f87859f508f36d2ed26debd2b3b0c151d82704a1e945345c039e2cea4193","regional_maps":{"file":"research/source-data/norkyst-ingoy-months-2024/regional-monthly-means-year.json","sha256":"c3cbba3c7568e45f0bc52255050b2e421b834d4d4dd55166041a66b4b8dbaf6b"},"interpretation":"Complete calendar sampling of model fields at one offshore fixed section and10m layer. Low-pass filtering attenuates tides and other high-frequency variation, not a complete harmonic tidal solution. The section does not establish coastal coverage, physical current identity or boundaries. Monthly distributions are not confidence intervals or annual physical width extrema.","new_width_record_admitted":false,"whole_current_width_km":null,"annual_width_range_km":null,"annual_extrema_eligible":false,"rank_eligible":false,"physical_geometry_admitted":false},"research_evidence":{"current_id":"norwegian-coastal","label":"Norwegian Coastal Current","diagnostic_id":"diagnostic:current-research:norwegian-coastal","title":"Complete 2024 model year: monthly maps and sections","finding":"All twelve months retain 8,784 hourly model fields at 10 m, with complete support at the 191 fixed section positions. This improves seasonal sampling in the offshore Ingoy region; the section is not a verified current axis or a current-width measurement.","facts":[{"label":"Calendar coverage","value":"12 months · 8,784 hours"},{"label":"Model layer","value":"10 m · 2024"},{"label":"Current width","value":"Unknown"},{"label":"Annual width range","value":"Unknown"}],"notes":["Monthly means use all calendar hours, including leap day. Source spacing is 800 m; retained spacing is 3.2 km. Interpolated section positions add no native resolution.","The 24/24/25-hour low-pass convolution attenuates tides and other high-frequency variability. It is not a harmonic tidal solution.","Temporal standard deviations and sample quantiles describe model variability, not confidence intervals or current-width uncertainty. Serial dependence remains.","This is a single model year at one layer, not observations, a climatology or a depth average. The offshore region does not establish coastal extent or physical current edges.","The declaration records prior exposure to twelve isolated snapshots; no fully blinded preregistration is claimed. Modified Norkyst data: MET Norway / Institute of Marine Research, CC BY 4.0.","Calculated readbacks use a declared precision for reproducibility. That precision is not observational uncertainty or an annual range. Original source values, masks and quality flags remain unchanged; the exact record pins the calculation rules."],"next_evidence":"Establish flow association and comparable paired physical boundaries before admitting a current width or annual width range.","figure_file":"figures/norkyst-ingoy-complete-year-maps.svg","figure_alt":"Twelve monthly low-pass model salinity maps at 10 m with mean velocity arrows and the fixed 24 degrees east section. These are regional model fields, not current boundaries.","additional_figures":[{"file":"figures/norkyst-ingoy-complete-year-sections.svg","alt":"Monthly raw and low-pass mean salinity and velocity sections for all twelve months."},{"file":"figures/norkyst-ingoy-complete-year-variability.svg","alt":"Monthly temporal model standard deviations, raw and low-pass. These are not uncertainty intervals."}],"source_file":"research/source-data/norkyst-ingoy-months-2024/section-diagnostic-year.json","source_pointer":"","source_links":[{"label":"Inspect monthly means, quantiles and support","document":"research/source-data/norkyst-ingoy-months-2024/section-diagnostic-year.json","pointer":"/months"},{"label":"Inspect complete-year acquisition","document":"research/source-data/norkyst-ingoy-months-2024/acquisition-year.json","pointer":""},{"label":"Inspect figure provenance","document":"research/source-data/norkyst-ingoy-months-2024/figure-year.json","pointer":""},{"label":"Inspect declared source and filtering rules","document":"research/source-data/norkyst-ingoy-months-2024/preflight.json","pointer":""},{"label":"Inspect monthly regional means","document":"research/source-data/norkyst-ingoy-months-2024/regional-monthly-means-year.json","pointer":"/months"}],"original_url":"https://thredds.met.no/thredds/catalog/romshindcast/norkyst_v3/zdepth/catalog.html","table":{"caption":"Complete hourly section support in each calendar month of 2024; current width remains unknown.","headers":["Month","Calendar hours","Current width"],"rows":[["2024-01","744","Unknown"],["2024-02","696","Unknown"],["2024-03","744","Unknown"],["2024-04","720","Unknown"],["2024-05","744","Unknown"],["2024-06","720","Unknown"],["2024-07","744","Unknown"],["2024-08","744","Unknown"],["2024-09","720","Unknown"],["2024-10","744","Unknown"],["2024-11","720","Unknown"],["2024-12","744","Unknown"]]},"kind":"current_research_evidence","rank_eligible":false,"new_width_record_admitted":false,"whole_current_width_km":null,"annual_width_range_km":null,"geometry_role":"research_evidence_no_current_axis_or_physical_width_geometry","figure_sha256":"a93829b63315edff1aa3ef0bdadfd9e8119c6578ecf7578863e13967f4c0797c"}},{"id":"diagnostic:current-research:pacific-north-equatorial-countercurrent","label":"Pacific North Equatorial Countercurrent research evidence","entity_id":"current:pacific-north-equatorial-countercurrent","current_id":"pacific-north-equatorial-countercurrent","status":"reviewed_research_evidence_pending_physical_measurement_admission","rank_eligible":false,"source_file":"research/pacific-necc-paired-vector-dir
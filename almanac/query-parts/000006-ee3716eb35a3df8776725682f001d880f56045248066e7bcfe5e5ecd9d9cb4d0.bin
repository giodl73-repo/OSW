urce_file_sha256":"99525c575faeca278bbca79377ff85df6a3c53ad2e71cf66fdea37e5a8ac917d"},{"current_id":"red-sea-saline-overflow","document":{"annual_width_range_admitted":false,"citation":"Özgökmen, T. M., W. E. Johns, H. Peters and S. Matt (2003), Turbulent Mixing in the Red Sea Outflow Plume from a High-Resolution Nonhydrostatic Model, Journal of Physical Oceanography 33, 1846–1869","cross_source_rule":{"prior_records_rewritten":false,"related_review":"research/red-sea-redsox-branch-reach-scope-audit.json","rule":"Do not combine the 3 km and prior 5 km channel descriptions into a current-width uncertainty or seasonal envelope. Matching sections, depth definitions, measurement methods and dates have not been established."},"current_id":"red-sea-saline-overflow","doi":"10.1175/2401.1","findings":[{"consequence":"Retain bathymetric context, not a whole-current dimension or paired velocity-edge measurement.","finding":"Approximately 100 km length and 3 km width at overflow depth describe the Northern Channel.","locator":"p. 1848, section 2; p. 1849, Figure 1"},{"consequence":"Neither dimension represents all Red Sea outflow branches or downstream spreading.","finding":"The winter investigation concerns one confined branch after the overflow splits.","locator":"p. 1846, abstract; p. 1848, section 2"},{"consequence":"Its two-dimensional solution does not recover lateral velocity boundaries.","finding":"The model resolves along-channel and vertical dynamics; lateral edge effects and canyon-wall intrusions are omitted.","locator":"p. 1850, section 3a–b"},{"consequence":"No observed current axis, footprint or length digitized from this figure.","finding":"The highlighted paths are schematic branch and station context.","locator":"p. 1849, Figure 1 and caption"}],"next_measurement_gate":"Recover dated cross-flow velocity sections with both lateral plume boundaries and depth/layer support; admit branch scope before attributing any result to the parent current.","physical_axis_a
w.flow-network.v1\",\n  \"id\": \"flow-network:indonesian-throughflow\",\n  \"entity_id\": \"current:indonesian-throughflow\",\n  \"current_id\": \"indonesian-throughflow\",\n  \"label\": \"Indonesian Throughflow passage network\",\n  \"status\": \"source_supported_conceptual_network_not_axis_or_canonical_admission\",\n  \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2008JC005257\",\n  \"source_citation\": \"Sprintall et al. (2009), Direct estimates of the Indonesian Throughflow entering the Indian Ocean: 2004–2006, doi:10.1029/2008JC005257.\",\n  \"source_access\": \"Introduction paragraphs 3–8, Tables 1 and 2, section 2.2 read from publisher full text. No figure, time series or velocity field digitized.\",\n  \"source_locator\": \"Introduction paragraphs 3–4: western/eastern inflow and Banda Sea exit pathways; Tables 1–2: transport support and moorings.\",\n  \"source_retrieved_date\": \"2026-10-04\",\n  \"source_use\": \"Attributed factual metadata and OSW schematic; no source figure or original velocity arrays packaged.\",\n  \"scope\": \"Selected source-described passage connections at differing depths. Not a complete exchange network, permanent one-way flow, particle itinerary or traced current axis.\",\n  \"layer\": \"Western upper-thermocline route and eastern deeper-water contribution remain distinct; mixed-layer pathways, not one uniform depth.\",\n  \"time_scope\": \"Regional pathway description with 2004–2006 mean exit transport context; arrows do not describe every date or depth.\",\n  \"length_km\": null,\n  \"width_km\": null,\n  \"annual_length_range_km\": null,\n  \"annual_width_range_km\": null,\n  \"rank_eligible\": false,\n  \"nodes\": [\n    {\n      \"id\": \"flow-node:itf:pacific\",\n      \"label\": \"Pacific Ocean\",\n      \"node_kind\": \"source_basin\",\n      \"schematic_xy\": [\n        50,\n        150\n      ],\n      \"coordinates_lon_lat\": null\n    },\n    {\n      \"id\": \"flow-node:itf:sulawesi\",\n 
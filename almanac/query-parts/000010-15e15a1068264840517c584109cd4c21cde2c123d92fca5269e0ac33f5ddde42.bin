log_file":"research/ocean-current-reference-path-candidates.json","source_catalog_sha256":"b06caed27655c39f8127ddda441cba0a856800f599ec52edcd5b30d2ad37b633","scope_reviews":[]},{"id":"route-decision:aleutian","entity_id":"current:aleutian","label":"Aleutian Current","current_id":"aleutian","strategy_id":"resolve_naming_scope","strategy_label":"Resolve naming or extent convention","construction_status":"editorial_candidate_present_scientific_review_pending","candidate_count":1,"route_ids":["aleutian-reach-reference-path-candidate"],"next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","scope":"The meteorological glossary identifies this as the southern eastward limb of the North Pacific subpolar gyre, also called the Subarctic Current. Its mixing with the North Pacific Current and variable frontal boundary leave no source-defined whole-current length for this ledger.","status":"editorial_planning_crosswalk_not_scientific_classification_approval","rank_eligible":false,"source_url":"https://glossary.ametsoc.org/wiki/aleutian-current/","source_decision":{"current_id":"aleutian","name":"Aleutian Current","existing_length_evidence_status":"no_numeric_length","existing_scope":"The meteorological glossary identifies this as the southern eastward limb of the North Pacific subpolar gyre, also called the Subarctic Current. Its mixing with the North Pacific Current and variable frontal boundary leave no source-defined whole-current length for this ledger.","name_source_url":"https://glossary.ametsoc.org/wiki/aleutian-current/","candidate_ids":["aleutian-reach-reference-path-candidate"],"reference_path_decision":"editorial_candidate_present_scientific_review_pending","published_length_rank_eligible":false,"ledger_kind":"eastward subpolar-gyre current","route_strategy_id":"resolve_naming_scope","route_strategy_label":"Resolve naming or extent convention","planning_status":"editorial_pla
tudes and intermediate vertices. These routes are broad editorial corridors, not diagnosed meandering axes or source-reported latitude limits.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      145,\r\n      35\r\n    ],\r\n    [\r\n      150,\r\n      35\r\n    ],\r\n    [\r\n      155,\r\n      36\r\n    ],\r\n    [\r\n      160,\r\n      37\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"southern_corridor\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          145,\r\n          33\r\n        ],\r\n        [\r\n          150,\r\n          34\r\n        ],\r\n        [\r\n          155,\r\n          34\r\n        ],\r\n        [\r\n          160,\r\n          35\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW southern corridor sensitivity; not a source-published current axis.\"\r\n    },\r\n    {\r\n      \"id\": \"northern_corridor\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          145,\r\n          37\r\n        ],\r\n        [\r\n          150,\r\n          38\r\n        ],\r\n        [\r\n          155,\r\n          38\r\n        ],\r\n        [\r\n          160,\r\n          39\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW northern corridor sensitivity; not a source-published current axis.\"\r\n    }\r\n  ],\r\n  \"scenario_rule\": \"Three latitude corridor choices with independent endpoint longitude shifts (-1/0/+1 degrees): nine gate combinations per corridor, 27 editorial scenarios. Longitudes vary around approximate glossary limits; no empirical error distribution implied.\",\r\n  \"longitude_offsets_degrees\": [\r\n    0\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    0\r\n  ],\r\n  \"start_longitude_offsets_degrees\": [\r\n    -1,\r\n    0,\r\n    1\r\n  ],\r\n  \"end_longitude_offsets_degrees\": [\r\n    -1,\r\n    0,\r\n    1\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_ap
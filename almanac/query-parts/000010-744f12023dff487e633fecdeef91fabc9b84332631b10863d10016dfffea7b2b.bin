\"https://svs.gsfc.nasa.gov/vis/a000000/a005500/a005505/perpetual_ocean2_EQUIREC_071_final_beauty_level0_A_1.mp4\",\r\n      \"source_id\": \"source:d4e82da0872ed45c\",\r\n      \"zoom\": 0,\r\n      \"nominal_display_route_fraction\": 1.0,\r\n      \"scenario_display_route_fraction_range\": [\r\n        1.0,\r\n        1.0\r\n      ],\r\n      \"complete_display_route_in_all_scenarios\": true,\r\n      \"interpretation\": \"Editorial reference-route/crop display overlap only; not physical current identification or dated event matching. Fraction measures equirectangular display line, not physical kilometres.\"\r\n    },\r\n    {\r\n      \"tile_id\": \"level0_B_1\",\r\n      \"url\": \"https://svs.gsfc.nasa.gov/vis/a000000/a005500/a005505/perpetual_ocean2_EQUIREC_071_final_beauty_level0_B_1.mp4\",\r\n      \"source_id\": \"source:d4e82da0872ed45c\",\r\n      \"zoom\": 0,\r\n      \"nominal_display_route_fraction\": 1.0,\r\n      \"scenario_display_route_fraction_range\": [\r\n        1.0,\r\n        1.0\r\n      ],\r\n      \"complete_display_route_in_all_scenarios\": true,\r\n      \"interpretation\": \"Editorial reference-route/crop display overlap only; not physical current identification or dated event matching. Fraction measures equirectangular display line, not physical kilometres.\"\r\n    }\r\n  ],\r\n  \"nasa_tiles_sha256\": \"52c6605c32e59f50aa4abde984489c7055c0e3e201e7323e30160a623c9666e0\",\r\n  \"recommended_nasa_tile_id\": \"level2_A_2\",\r\n  \"nasa_crop_recommendation_rule\": \"Highest zoom crop covering the entire display route in every retained scenario, with tile ID as deterministic tie-break. No physical identification asserted.\",\r\n  \"input_file\": \"research/antilles-northern-bahamas-reference-path-input.json\",\r\n  \"figure\": \"figures/antilles-northern-bahamas-reference-path-candidate.svg\"\r\n}\r\n","source_sha256":"f9558395b4eaf57de113559fe1e5e31ab1e110351faa76a925ed99d7e49c99c6"},"research/astrid-2000-radial-scale-scope-audit.json":{"source_json":"{\n  \"schema\": \"osw.named-eddy-radial-scale-audit.v1\",\n  \"as_of\": \"2026-10-08\",\n  \"status\": \"editorial_original_source_extraction_scientific_review_pending\",\n  \"entity_id\": \"eddy:geography:astrid-2000\",\n  \"source_url\": \"https://www.met.reading.ac.uk/~xv901096/research/Vanaken-2003.pdf\",\n  \"source_citation\": \"van Aken et al. (2003), Observations of a young Agulhas ring, Astrid, during MARE in March 2000, Deep-Sea Research II 50, 167-195, doi:10.1016/S0967-0645(02)00383-1.\",\n  \"source_document_file\": \"research/source-data/van-aken-astrid-2003/journal-article.pdf\",\n  \"source_document_sha256\": \"00f15a476e1584ae8666d3ab5198d4139b4b63da5d2c78ca7ddd179ee3836776\",\n  \"source_document_bytes\": 1136090,\n  \"acquisition_file\": \"research/source-data/van-aken-astrid-2003/acquisition.json\",\n  \"acquisition_sha256\": \"3c113b20f77018314255c7a625758d027b5a3834ad958db37549a683e38c2b29\",\n  \"source_access\": \"Full institutional-hosted original text inspected; original printed pages 190-191 rendered and Table 3 / definition visually inspected. Original retained locally, excluded from Git; no redistribution license established.\",\n  \"measurements\": [\n    {\n      \"id\": \"astrid-2000-maximum-speed-radius\",\n      \"entity_id\": \"eddy:geography:astrid-2000\",\n      \"name\": \"Agulhas Ring Astrid\",\n      \"value_km\": 120,\n      \"metric\": \"radius_of_maximum_tangential_velocity\",\n      \"definition\": \"Radius at maximum tangential velocity, from the source two-layer circularly symmetric ring model. Not an outer eddy boundary.\",\n      \"evidence_kind\": \"published_two_layer_diagnostic_model_scale\",\n      \"study_period_context\": \"March 2000 MARE-1 survey\",\n      \"observed_period\": null,\n      \"calendar_months\": null,\n      \"layer\": \"Two-layer diagnostic model whose thermocline follows the 10 C isotherm; primarily baroclinic component. Lower layer assumed at rest; actual LADCP flow extended to the bottom.\",\n      \"geometry\": null,\n      \"reported_uncertainty_km\": null,\n      \"annual_extrema_eligible\": false,\n      \"seasonal_playback_eligible\": false,\n      \"footprint_inference_eligible\": false,\n      \"diameter_inference_eligible\": false,\n      \"area_inference_eligible\": false,\n      \"source_locator\": \"Table 3, printed p. 191 (PDF page 25), Astrid row and footnotes b / final model note.\"\n    },\n    {\n      \"id\": \"astrid-2000-integration-radius\",\n      \"entity_id\": \"eddy:geography:astrid-2000\",\n      \"name\": \"Agulhas Ring Astrid\",\n      \"value_km\": 140,\n      \"metric\": \"thermocline_relaxation_integration_radius\",\n      \"definition\": \"Chosen integration limit where thermocline depth relaxes to surrounding value; not a mapped observed closed perimeter.\",\n      \"evidence_kind\": \"published_two_layer_diagnostic_model_scale\",\n      \"study_period_context\": \"March 2000 MARE-1 survey\",\n      \"observed_period\": null,\n      \"calendar_months\": null,\n      \"layer\": \"Two-layer diagnostic model whose thermocline follows the 10 C isotherm; primarily baroclinic component. Lower layer assumed at rest; actual LADCP flow extended to the bottom.\",\n      \"geometry\": null,\n      \"reported_uncertainty_km\": null,\n      \"annual_extrema_eligible\": false,\n      \"seasonal_playback_eligible\": false,\n      \"footprint_inference_eligible\": false,\n      \"diameter_inference_eligible\": false,\n      \"area_inference_eligible\": false,\n      \"source_locator\": \"Section 7.2, printed p. 191 (PDF page 25), paragraph immediately preceding Table 3 discussion.\"\n    }\n  ],\n  \"closed_footprint\": null,\n  \"annual_radius_range_km\": null,\n  \"nasa_individual_identity_claim\": false,\n  \"remaining_gates\": [\n    \"Recover dated contour coordinates and source boundary convention before footprint or state intersection.\",\n    \"Obtain compatible repeat observations before an annual range or animated season series.\",\n    \"Independent scientific and canonical admission.\"\n  ]\n}\n","source_sha256":"32fe3f9fa6c6958fdc78dbd1caa0347444d359e7af59b60d8ca42ca54bf4c90f"},"research/atlantic-euc-layer-island-scope-audit.json":{"source_json":"{\r\n  \"schema\": \"osw.current-source-scope-audit.v1\",\r\n  \"current_id\": \"atlantic-equatorial-undercurrent\",\r\n  \"as_of\": \"2026-10-08\",\r\n  \"status\": \"editorial_source_scope_audit_not_canonical\",\r\n  \"source_access\": [\r\n    {\r\n      \"url\": \"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/2022-11/010086132.pdf\",\r\n      \"status\": \"full_primary_institutional_pdf_read\",\r\n      \"doi\": \"10.1029/2021JC017999\",\r\n      \"supports\": \"Eastward equatorial subsurface jet encounters Sao Tome and bifurcates; model eddies and return flows remain distinct from named source identities.\"\r\n    },\r\n    {\r\n      \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2006JC003931\",\r\n      \"status\": \"full_primary_publisher_page_read\",\r\n      \"doi\": \"10.1029/2006JC003931\",\r\n      \"supports\": \"35 W equatorial observational section and approximately 100 m core; depth/time/model distinctions.\"\r\n    },\r\n    {\r\n      \"url\": \"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/cahiers/ocea_tro/15471.pdf\",\r\n      \"status\": \"institutional_original_pdf_visually_reviewed\",\r\n      \"supports\": \"Campaign core speed/depth and unresolved Table I/II date conflicts; Figure 2 dated velocity sections, not extracted horizontal widths.\"\r\n    }\r\n  ],\r\n  \"declared_gates\": {\r\n    \"west\": [\r\n      -35,\r\n      0\r\n    ],\r\n    \"east\": [\r\n      5,\r\n      0\r\n    ],\r\n    \"role\": \"editorial_truncation_not_whole_current_endpoints\"\r\n  },\r\n  \"whole_current_length_km\": null,\r\n  \"whole_current_width_km\": null,\r\n  \"annual_dimension_ranges\": null,\r\n  \"source_scope\": \"Subsurface equatorial/thermocline jet. At 35 W the reported mean observed core is about 100 m; eastern cores and isopycnal layers differ. No single depth is imposed on the route; surface SEC/NECC and deeper equatorial currents remain separate.\",\r\n  \"excluded_inferences\": [\r\n    \"Do not treat source transport changes or vertical thickness as horizontal width.\",\r\n    \"Do not transfer surface NASA swirls to thermocline current identification.\",\r\n    \"Do not identify modeled island-generated anticyclones as named registry eddies.\",\r\n    \"Do not compare this truncated reach directly with whole Pacific EUC length.\"\r\n  ],\r\n  \"remaining_gates\": [\r\n    \"Review 35 W and pre-island truncation; source retroflections and eastern branches are not represented.\",\r\n    \"Obtain compatible depth/time-resolved velocity axis before physical length or seasonal dimensions.\",\r\n    \"Resolve island interaction and return-flow topology without treating generated eddies as named identities.\",\r\n    \"No occupied footprint, route-buffer width or whole-basin system length inferred.\",\r\n    \"Resolve campaign 7910/7912 Table I/II date conflicts before dated frames.\",\r\n    \"Extract reproducible paired velocity edges from original sections before assigning local horizontal width.\"\r\n  ],\r\n  \"section_properties\": {\r\n    \"schema\": \"osw.atlantic-euc-section-properties.v1\",\r\n    \"current_id\": \"atlantic-equatorial-undercurrent\",\r\n    \"status\": \"editorial_source_extraction_not_canonical\",\r\n    \"source_url\": \"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/cahiers/ocea_tro/15471.pdf\",\r\n    \"source_document_file\": \"research/source-data/voituriez-atlantic-euc-1983/journal-article.pdf\",\r\n    \"source_document_sha256\": \"a1c4b1dfc46247cb9c7da90ea03aa1a240bc987bd26b21c9cdf49f027d457e0b\",\r\n    \"source_document_bytes\": 1887693,\r\n    \"acquisition_file\": \"research/source-data/voituriez-atlantic-euc-1983/acquisition.json\",\r\n    \"acquisition_sha256\": \"1734746902c37f4fe31bc0dbf2a39b6f173a96e0759aa7604257683cca32736b\",\r\n    \"protocol_file\": \"plans/atlantic-euc-section-properties-protocol-v1.md\",\r\n    \"protocol_sha256\": \"4d8ff5480aba2d14be3d3a082e805f9b90843c2db5fb6ef52bc46f1d596a068e\",\r\n    \"source_locator\": \"Printed pp165,167–168: Table I, Figure 2, Table II; methods pp164–165.\",\r\n    \"section_longitude_deg_e\": -4,\r\n    \"station_latitude_deg\": null,\r\n    \"velocity_reference_depth_m\": 500,\r\n    \"reference_assumption\": \"500 m assumed motionless; drifting-ship Aanderaa profiler.\",\r\n    \"transport_context\": {\r\n      \"eastward_speed_threshold_cm_s\": 20,\r\n      \"depth_bounds_m\": [\r\n        0,\r\n        200\r\n      ],\r\n      \"is_horizontal_width_definition\": false\r\n    },\r\n    \"uncertainty_cm_s\": null,\r\n    \"core_depth_uncertainty_m\": null,\r\n    \"whole_current_width_km\": null,\r\n    \"seasonal_playback_eligible\": false,\r\n    \"annual_extrema_eligible\": false,\r\n    \"width_inference_eligible\": false,\r\n    \"occupied_geometry_eligible\": false,\r\n    \"date_conflict_count\": 2,\r\n    \"display_caption\": \"Eight campaign core-property records at 4°W, in printed table order. Speed maxima and their depths are distinct from horizontal width. Hollow points have unresolved dates; no interpolated seasonal cycle.\",\r\n    \"records\": [\r\n      {\r\n        \"id\": \"atlantic-euc-cap-7701\",\r\n        \"campaign\": \"7701\",\r\n        \"station_label\": \"26\",\r\n        \"table_ii_date_text\": \"Jan 77\",\r\n        \"table_i_campaign_period\": \"January 1977\",\r\n        \"date_conflict\": false,\r\n        \"resolved_observation_date\": null,\r\n        \"maximum_eastward_speed_cm_s\": 98,\r\n        \"maximum_speed_depth_m\": 65\r\n      },\r\n      {\r\n        \"id\": \"atlantic-euc-cap-7706\",\r\n        \"campaign\": \"7706\",\r\n        \"station_label\": \"7\",\r\n        \"table_ii_date_text\": \"Jul 77\",\r\n        \"table_i_campaign_period\": \"July 1977\",\r\n        \"date_conflict\": false,\r\n        \"resolved_observation_date\": null,\r\n        \"maximum_eastward_speed_cm_s\": 30,\r\n        \"maximum_speed_depth_m\": 50\r\n      },\r\n      {\r\n        \"id\": \"atlantic-euc-cap-7802\",\r\n        \"campaign\": \"7802\",\r\n        \"station_label\": \"7\",\r\n        \"table_ii_date_text\": \"Août 78\",\r\n        \"table_i_campaign_period\": \"August–September 1978\",\r\n        \"date_conflict\": false,\r\n        \"resolved_observation_date\": null,\r\n        \"maximum_eastward_speed_cm_s\": 68,\r\n        \"maximum_speed_depth_m\": 65\r\n      },\r\n      {\r\n        \"id\": \"atlantic-euc-cap-7902\",\r\n        \"campaign\": \"7902\",\r\n        \"station_label\": \"48\",\r\n        \"table_ii_date_text\": \"Jan 79\",\r\n        \"table_i_campaign_period\": \"January–February 1979\",\r\n        \"date_conflict\": false,\r\n        \"resolved_observation_date\": null,\r\n        \"maximum_eastward_speed_cm_s\": 110,\r\n        \"maximum_speed_depth_m\": 65\r\n      },\r\n      {\r\n        \"id\": \"atlantic-euc-cap-7906\",\r\n        \"campaign\": \"7906\",\r\n        \"station_label\": \"8\",\r\n        \"table_ii_date_text\": \"Avr 79\",\r\n        \"table_i_campaign_period\": \"April 1979\",\r\n        \"date_conflict\": false,\r\n        \"resolved_observation_date\": null,\r\n        \"maximum_eastward_speed_cm_s\": 96,\r\n        \"maximum_speed_depth_m\": 55\r\n      },\r\n      {\r\n        \"id\": \"atlantic-euc-cap-7910\",\r\n        \"campaign\": \"7910\",\r\n        \"station_label\": \"4\",\r\n        \"table_ii_date_text\": \"Juin 79\",\r\n        \"table_i_campaign_period\": \"June 1980\",\r\n        \"date_conflict\": true,\r\n        \"resolved_observation_date\": null,\r\n        \"maximum_eastward_speed_cm_s\": 64,\r\n        \"maximum_speed_depth_m\": 60\r\n      },\r\n      {\r\n        \"id\": \"atlantic-euc-cap-7912\",\r\n        \"campaign\": \"7912\",\r\n        \"station_label\": \"82\",\r\n        \"table_ii_date_text\": \"Nov 74\",\r\n        \"table_i_campaign_period\": \"October–November 1979\",\r\n        \"date_conflict\": true,\r\n        \"resolved_observation_date\": null,\r\n        \"maximum_eastward_speed_cm_s\": 103,\r\n        \"maximum_speed_depth_m\": 70\r\n      },\r\n      {\r\n        \"id\": \"atlantic-euc-cap-8001\",\r\n        \"campaign\": \"8001\",\r\n        \"station_label\": \"2\",\r\n        \"table_ii_date_text\": \"Jan 80\",\r\n        \"table_i_campaign_period\": \"January 1980\",\r\n        \"date_conflict\": false,\r\n        \"resolved_observation_date\": null,\r\n        \"maximum_eastward_speed_cm_s\": 110,\r\n        \"maximum_speed_depth_m\": 65\r\n      }\r\n    ]\r\n  }\r\n}\r\n","source_sha256":"9683be878b57e68319774334107c58f225f394dd3a873caa05bd6fde91143768"},"research/atlantic-euc-reach-reference-path-candidate.json":{"source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"atlantic-equatorial-undercurrent\",\r\n  \"name\": \"Atlantic Equatorial Undercurrent\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Declared Atlantic equatorial subsurface-jet reach from the 35 W observational section to an OSW 5 E pre-island approach gate. Excludes western North Brazil retroflection source paths, island bifurcation near 6 E, downstream branches and westward returns. Not full source-to-termination length or an observed material trajectory.\",\r\n  \"layer\": \"Subsurface equatorial/thermocline jet. At 35 W the reported mean observed core is about 100 m; eastern cores and isopycnal layers differ. No single depth is imposed on the route; surface SEC/NECC and deeper equatorial currents remain separate.\",\r\n  \"time_convention\": \"Editorial geographic reach using Hormann and Brandt (2007) observations/model comparison and Napolitano et al. (2022) eastern-island study. Composite periods differ; no single dated or annual mean axis or seasonal geometry series.\",\r\n  \"source_url\": \"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/2022-11/010086132.pdf\",\r\n  \"source_locator\": \"Introduction pp. 1–2: eastward equatorial flow, eastern bifurcation/termination-site context between 5 E and continental margin, Sao Tome around 6.6 E; sections 2–3 distinguish observations and model experiments.\",\r\n  \"source_citation\": \"Napolitano, Alory, Dadou, Morel, Jouanno and Morvan (2022), Influence of the Gulf of Guinea Islands on the Atlantic Equatorial Undercurrent Circulation, JGR Oceans 127, e2021JC017999, doi:10.1029/2021JC017999.\",\r\n  \"source_license\": \"Source article states Creative Commons Attribution license. Attributed regional facts paraphrased; no source figure or model/ADCP field copied.\",\r\n  \"source_retrieved_date\": \"2026-10-03\",\r\n  \"coordinate_selection\": \"OSW connects a published 35 W equatorial current section with a declared pre-island gate at 5 E, before the modeled/observed island interaction context near 6 E. Rounded equatorial waypoints and off-equatorial bends are editor-selected. The gates truncate known source/branch pathways and do not assert the current begins at 35 W or terminates at 5 E. No velocity curve, mooring line or model particle trajectory digitized.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -35,\r\n      0\r\n    ],\r\n    [\r\n      -30,\r\n      0\r\n    ],\r\n    [\r\n      -23,\r\n      0\r\n    ],\r\n    [\r\n      -15,\r\n      0\r\n    ],\r\n    [\r\n      -10,\r\n      0\r\n    ],\r\n    [\r\n      0,\r\n      0\r\n    ],\r\n    [\r\n      5,\r\n      0\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"northern_bend_shorter_approach\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -35,\r\n          0\r\n        ],\r\n        [\r\n          -30,\r\n          0.2\r\n        ],\r\n        [\r\n          -23,\r\n          0.3\r\n        ],\r\n        [\r\n          -15,\r\n          0.2\r\n        ],\r\n        [\r\n          -10,\r\n          0.1\r\n        ],\r\n        [\r\n          0,\r\n          0.1\r\n        ],\r\n        [\r\n          4.5,\r\n          0\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW northward bend and shorter pre-island extent; not a seasonal observed axis or current width.\"\r\n    },\r\n    {\r\n      \"id\": \"southern_bend_longer_approach\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -35,\r\n          0\r\n        ],\r\n        [\r\n          -30,\r\n          -0.2\r\n        ],\r\n        [\r\n          -23,\r\n          -0.3\r\n        ],\r\n        [\r\n          -15,\r\n          -0.2\r\n        ],\r\n        [\r\n          -10,\r\n          -0.1\r\n        ],\r\n        [\r\n          0,\r\n          -0.1\r\n        ],\r\n        [\r\n          5.5,\r\n          0\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW southward bend and longer pre-island extent; no island branching or downstream return reconstructed.\"\r\n    }\r\n  ],\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"scenario_rule\": \"Three declared reach shapes crossed with uniform longitude offsets -0.25/0/+0.25 degrees and independent endpoint-latitude offsets -0.25/0/+0.25 degrees: 81 editorial cases, not width bounds, seasonal extremes or confidence limits.\",\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_studied_reach_routes\",\r\n  \"whole_system_length\": false,\r\n  \"remaining_gates\": [\r\n    \"Review 35 W and pre-island truncation; source retroflections and eastern branches are not represented.\",\r\n    \"Obtain compatible depth/time-resolved velocity axis before physical length or seasonal dimensions.\",\r\n    \"Resolve island interaction and return-flow topology without treating generated eddies as named identities.\",\r\n    \"No occupied footprint, route-buffer width or whole-basin system length inferred.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    605,\r\n    335,\r\n    315,\r\n    225\r\n  ],\r\n  \"map_label_size\": 4.2,\r\n  \"legend_line_spacing\": 7,\r\n  \"map_symbol_scale\": 1,\r\n  \"endpoint_labels\": [\r\n    \"35 W section\",\r\n    \"5 E pre-island approach\"\r\n  ],\r\n  \"figure_source_label\": \"Napolitano et al. (2022); Hormann & Brandt (2007)\",\r\n  \"route_extent_kind\": \"35 W to pre-island equatorial reach\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2006JC003931\",\r\n      \"citation\": \"Hormann and Brandt (2007), Atlantic Equatorial Undercurrent and associated cold tongue variability, JGR Oceans, doi:10.1029/2006JC003931.\",\r\n      \"locator\": \"Section 2.3.1.1 paragraph 14: observed 35 W current centered at equator with approximately 100 m core; paragraphs 16–18 distinguish 23 W and subsurface currents.\",\r\n      \"role\": \"Western observational section gate and layer/context distinction; no transport-to-length or depth-uniform inference.\"\r\n    }\r\n  ],\r\n  \"context_landmarks\": [\r\n    {\r\n      \"label\": \"Sao Tome\",\r\n      \"coordinates_lon_lat\": [\r\n        6.6,\r\n        0.2\r\n      ]\r\n    }\r\n  ],\r\n  \"input_sha256\": \"cccc9d8965a860f81125efba01afd8ad9bc6f69d90e29f987ecd4b3bf608fa03\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 4452.78,\r\n  \"repor
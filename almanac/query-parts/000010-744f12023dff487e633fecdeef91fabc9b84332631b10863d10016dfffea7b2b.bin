: \"52c6605c32e59f50aa4abde984489c7055c0e3e201e7323e30160a623c9666e0\",\r\n  \"recommended_nasa_tile_id\": \"level2_F_5\",\r\n  \"nasa_crop_recommendation_rule\": \"Highest zoom crop covering the entire display route in every retained scenario, with tile ID as deterministic tie-break. No physical identification asserted.\",\r\n  \"input_file\": \"research/leeuwin-reference-path-input.json\",\r\n  \"figure\": \"figures/leeuwin-reference-path-candidate.svg\"\r\n}\r\n","source_sha256":"fa33d759c41494c5db7cd06bda58f4e7d74e8dc373dd3f7f54b4314d08dbc239"},"research/ligurian-reach-reference-path-candidate.json":{"source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"ligurian\",\r\n  \"name\": \"Ligurian Current\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Declared coastal studied reach of the Northern Current from an OSW offshore Genoa neighborhood gate through the Imperia sector to an OSW Menton–Nice neighborhood gate. Ligurian is retained as the ledger regional segment classification, not a separate additive current system. Excludes Corsica feeder routes, basin-wide drifter loops and downstream Provencal/Catalan continuation. Gates are not whole-current endpoints.\",\r\n  \"layer\": \"Surface-flow geography in a study combining CODE drifters following the first metre and ARGOSPHERE drifters following the first 10–20 cm with unquantified wind slip. No full-depth or shelf-break axis diagnosed from the editorial route.\",\r\n  \"time_convention\": \"Source drifter sampling is intermittent during May–October 2007 and October 2008–January 2009. The selected reach is editorial geographic context, not one float trajectory, simultaneous observation, annual mean or seasonal path.\",\r\n  \"source_url\": \"https://mrea.sincem.unibo.it/images/reports/2011_Poulain_Aspects_of_the_surface_circulation.pdf\",\r\n  \"source_locator\": \"Poulain et al. (2012), Introduction pp. 261–263: NC formation and Italian/French coastal continuation; sections 2.1 and 4, pp. 264–266 and 274–276: surface sampling, Genoa, Imperia, Menton–Nice and current structure.\",\r\n  \"source_citation\": \"Poulain, Gerin, Rixen, Zanasca, Teixeira, Griffa, Molcard, de Marte and Pinardi (2012), Aspects of the surface circulation in the Liguro-Provencal basin and Gulf of Lion as observed by satellite-tracked drifters (2007–2009), Bollettino di Geofisica Teorica ed Applicata 53(2), 261–279, doi:10.4430/bgta0052.\",\r\n  \"source_license\": \"Source PDF states copyright 2012 OGS; university-hosted access does not establish an open reuse license. Attributed regional facts paraphrased; no trajectories, source figures or velocity fields copied.\",\r\n  \"source_retrieved_date\": \"2026-10-03\",\r\n  \"coordinate_selection\": \"OSW selects coarse offshore vertices along the source-described Genoa–Imperia–Menton/Nice coastal sequence. Start/end neighborhoods and their offsets are editorial truncations, not a formal Ligurian-name boundary, observed current origin/termination or source-diagnosed shelf-break axis. Narrow coastal placement and bathymetric fidelity require separate review. Source closed loops and feeder trajectories are not traced.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      8.95,\r\n      44.1\r\n    ],\r\n    [\r\n      8.45,\r\n      43.9\r\n    ],\r\n    [\r\n      8.05,\r\n      43.7\r\n    ],\r\n    [\r\n      7.65,\r\n      43.55\r\n    ],\r\n    [\r\n      7.35,\r\n      43.5\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"closer_coastal_sequence\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          8.95,\r\n          44.15\r\n        ],\r\n        [\r\n          8.45,\r\n          43.95\r\n        ],\r\n        [\r\n          8.05,\r\n          43.75\r\n        ],\r\n        [\r\n          7.65,\r\n          43.6\r\n        ],\r\n        [\r\n          7.45,\r\n          43.55\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW closer coastal detour and earlier western gate; not an observed seasonal path.\"\r\n    },\r\n    {\r\n      \"id\": \"farther_offshore_sequence\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          8.95,\r\n          44.0\r\n        ],\r\n        [\r\n          8.45,\r\n          43.8\r\n        ],\r\n        [\r\n          8.05,\r\n          43.6\r\n        ],\r\n        [\r\n          7.65,\r\n          43.45\r\n        ],\r\n        [\r\n          7.25,\r\n          43.4\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW offshore detour and later western gate; not a current edge or measured width.\"\r\n    }\r\n  ],\r\n  \"longitude_offsets_degrees\": [\r\n    -0.05,\r\n    0,\r\n    0.05\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.05,\r\n    0,\r\n    0.05\r\n  ],\r\n  \"scenario_rule\": \"Three declared coastal reach shapes crossed with uniform longitude shifts -0.05/0/+0.05 degrees and independent endpoint latitude shifts -0.05/0/+0.05 degrees: 81 editorial scenarios, not seasonal geometry, width or confidence interval.\",\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_studied_reach_routes\",\r\n  \"whole_system_length\": false,\r\n  \"remaining_gates\": [\r\n    \"Resolve the geographic Ligurian naming convention before whole-segment endpoint admission.\",\r\n    \"Review source sampling/layer and coastal path with finer bathymetry or compatible current data.\",\r\n    \"Keep overlapping Northern Current and Ligurian segment lengths separate; do not sum them.\",\r\n    \"Review local 20 km Menton–Nice profile-band extraction, mixed surface support and remaining Imperia coast-distance limit; no paired whole-current width inferred.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    822,\r\n    260,\r\n    28,\r\n    35\r\n  ],\r\n  \"map_label_size\": 0.55,\r\n  \"legend_line_spacing\": 1,\r\n  \"map_symbol_scale\": 0.3,\r\n  \"endpoint_labels\": [\r\n    \"Genoa gate\",\r\n    \"Menton–Nice gate\"\r\n  ],\r\n  \"figure_source_label\": \"Poulain et al. (2012), sec. 2/4\",\r\n  \"route_extent_kind\": \"coastal Genoa–Nice studied reach\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=3357\",\r\n      \"citation\": \"Marine Regions / VLIZ, MRGID 3357, Ligurian Current; ASFA thesaurus naming entry.\",\r\n      \"locator\": \"Place details: Proposed standard, Current, part of Mediterranean Sea; no current endpoint or length geometry supplied.\",\r\n      \"role\": \"Naming reference only; does not define this coastal reach or certify Northern Current segment boundaries.\"\r\n    },\r\n    {\r\n      \"url\": \"https://os.copernicus.org/articles/14/689/2018/\",\r\n      \"citation\": \"Berta et al. (2018), Wind-induced variability in the Northern Current (northwestern Mediterranean Sea) as depicted by a multi-platform observing system, Ocean Science 14, 689–710, doi:10.5194/os-14-689-2018.\",\r\n      \"locator\": \"Introduction: Liguro-Provencal-Catalan / Northern Current formed in Ligurian Sea and recognizable through Catalan Sea.\",\r\n      \"role\": \"Broader parent geography; whole-parent length and regional width summaries are not transferred to this segment.\"\r\n    }\r\n  ],\r\n  \"parent_current_id\": \"northern-mediterranean\",\r\n  \"parent_scope_note\": \"The ledger treats Ligurian Current as a Northern Current segment. This studied reach overlaps the broader current geography; do not add its length to the parent or count it as an independent parallel flow.\",\r\n  \"input_sha256\": \"9f27f636d7a4042b832bbe6ef15203d2f8f4713fbc111fea337a6e9427b8da24\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\
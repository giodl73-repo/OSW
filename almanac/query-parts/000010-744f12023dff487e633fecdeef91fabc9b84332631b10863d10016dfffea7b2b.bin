\"url\": \"https://www.pmel.noaa.gov/pubs/outstand/stab1878/stab1878.shtml\",\r\n          \"citation\": \"Stabeno, Schumacher and Ohtani (1999), The physical oceanography of the Bering Sea, Dynamics of the Bering Sea, pp. 1–28.\",\r\n          \"locator\": \"Mean Upper Ocean Circulation: Aleutian North Slope Current.\",\r\n          \"supports\": \"Regional support at 174–167 W; roughly 20 km author-described width belongs to ANSC, not Aleutian. Neither supplies whole-current endpoints.\",\r\n          \"source_access\": \"Relevant HTML circulation subsections and captions read; underlying surveys and figures not digitized.\"\r\n        },\r\n        {\r\n          \"url\": \"https://elischolar.library.yale.edu/journal_of_marine_research/2235/\",\r\n          \"citation\": \"Reed and Stabeno (1997), Long-term measurements of flow near the Aleutian Islands, Journal of Marine Research 55(3).\",\r\n          \"locator\": \"Repository abstract.\",\r\n          \"supports\": \"Thirteen-month moorings west/east of Amukta Pass show contrasting weak variable versus stronger eastward flow.\",\r\n          \"source_access\": \"Repository abstract read; full article not acquired.\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review independent identity admission and connection to Bering Slope Current.\",\r\n        \"Recover source-supported axes and paired width edges with time/layer support; do not join pass exchanges into an assumed uninterrupted route.\",\r\n        \"Integrate reviewed identity into canonical taxonomy and release before counting it among atlas currents.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"atlantic-north-equatorial\",\r\n      \"name\": \"Atlantic North Equatorial Current\",\r\n      \"basin\": \"Atlantic Ocean\",\r\n      \"proposed_kind\": \"basin-qualified member of a named current family\",\r\n      \"parent_current_id\": \"north-equatorial\",\r\n      \"identity_scope\": \"OSW basin-qualified proposal
\n  \"source_url\": \"https://www.cfoo.co.za/seaatlas/papers/agulhas_return_current.pdf\",\r\n  \"source_locator\": \"Printed p. 125, Section 3 paragraph before Figure 8: first clear evidence near 16 degrees E, meander near 25 degrees E, current progressively indistinct after 66 degrees E and absent in recognizable form by 70 degrees E. Printed p. 136, Conclusions: overall southward progression from 39 degrees 30 minutes S to 44 degrees 30 minutes S and separate naming downstream.\",\r\n  \"source_citation\": \"Lutjeharms, J.R.E., and Ansorge, I.J. (2001), The Agulhas Return Current, Journal of Marine Systems 30, 115–138.\",\r\n  \"source_license\": \"Copyright Elsevier 2001; factual geographic reference only; no paper figure or source geometry packaged.\",\r\n  \"coordinate_selection\": \"OSW reference sketch constrained by the paper’s broad regional descriptions. Intermediate vertices are OSW-selected approximations, not published coordinates, a digitized source curve or observed streamline.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      16,\r\n      -39.5\r\n    ],\r\n    [\r\n      21,\r\n      -40.5\r\n    ],\r\n    [\r\n      25,\r\n      -38\r\n    ],\r\n    [\r\n      30,\r\n      -39.5\r\n    ],\r\n    [\r\n      40,\r\n      -40\r\n    ],\r\n    [\r\n      50,\r\n      -41.5\r\n    ],\r\n    [\r\n      60,\r\n      -44.5\r\n    ],\r\n    [\r\n      68,\r\n      -44.5\r\n    ]\r\n  ],\r\n  \"scenario_rule\": \"Three OSW route shapes (nominal meander, reduced meander, amplified meander), three western-gate choices (16/18/20 degrees E), three eastern termination choices (66/68/70 degrees E), and independent endpoint latitude offsets (-0.5/0/+0.5 degrees): 243 finite scenarios. Eastern longitudes follow the source termination interval; western alternatives, latitude offsets and route shapes are OSW choices, not source error bars. Does not exhaust all actual meanders.\",\r\n  \"longitude_offsets_degrees\": [\r\n    0\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.5,\r\n    0,\r\n    0.5\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"remaining_gates\": [\r\n    \"Independent review of the source-defined western origin, eastern termination and source-specific flow identity.\",\r\n    \"Validate the editorial meander and regional waypoints against reproducible geographic or model geometry.\",\r\n    \"Canonical claim/measurement/geometry and atlas interface integration; retain source-specific scope.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    855,\r\n    550,\r\n    300,\r\n    130\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"16°E first clear evidence\",\r\n    \"68°E terminal-region midpoint\"\r\n  ],\r\n  \"figure_source_label\": \"Lutjeharms & Ansorge (2001), pp. 125, 136\",\r\n  \"route_extent_kind\": \"source-scoped extent route\",\r\n  \"whole_system_length\": false,\r\n  \"source_pdf_sha256\": \"9cc3b4ab639f90cf81f95dc3e5bbd1826c2326ba3db36cc7d1e60f5b277a0402\",\r\n  \"source_pdf_bytes\": 718135,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"start_longitude_offsets_degrees\": [\r\n    0,\r\n    2,\r\n    4\r\n  ],\r\n  \"end_longitude_offsets_degrees\": [\r\n    -2,\r\n    0,\r\n    2\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"reduced_plateau_meander\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          16,\r\n          -39.5\r\n        ],\r\n        [\r\n          21,\r\n          -40.5\r\n        ],\r\n        [\r\n          25,\r\n          -39.5\r\n        ],\r\n        [\r\n          30,\r\n          -39.5\r\n        ],\r\n        [\r\n          40,\r\n          -40\r\n        ],\r\n        [\r\n          50,\r\n          -41.5\r\n        ],\r\n        [\r\n          60,\r\n          -44.5\r\n        ],\r\n        [\r\n          68,\r\n          -44.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW lesser meridi
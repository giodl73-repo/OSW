    \"containment_assessment\": \"unresolved\",\n      \"nominal_display_area_fraction\": 0.28799651,\n      \"display_area_fraction_range\": [\n        0.26729441,\n        0.30764011\n      ]\n    }\n  ],\n  \"closed_pixel_loop_verified\": true,\n  \"physical_boundary_admitted\": false,\n  \"whole_eddy_state_relations\": [],\n  \"center_lon_lat\": null,\n  \"radius_km\": null,\n  \"area_km2\": null,\n  \"annual_extrema_eligible\": false,\n  \"seasonal_playback_eligible\": false,\n  \"nasa_individual_identity_claim\": false,\n  \"source_license\": \"CC BY 4.0\",\n  \"source_license_url\": \"https://creativecommons.org/licenses/by/4.0/\",\n  \"source_credit\": \"Adapted by OSW from Johnson Exley, Donohue, Watts, Tracey and Kennelly (2022), Figure 3; original authors retain copyright. Threshold tracing and figure-axis georeferencing are OSW transformations. Original complete source figure is available.\",\n  \"runtime\": {\n    \"opencv\": \"5.0.0\",\n    \"shapely\": \"2.1.2\",\n    \"numpy\": \"2.4.1\"\n  }\n}\n","source_sha256":"465f2a15cad95a782617ce9981fc0846514bbc0aa1c217472f788132fb59fd09"},"research/west-greenland-reference-path-candidate.json":{"source_json":"{\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"source_license\": \"Factual regional geography paraphrased with attribution; no source schematic, velocity field or model axis packaged.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"map_label_size\": 1.8,\r\n  \"legend_line_spacing\": 3,\r\n  \"map_symbol_scale\": 0.65,\r\n  \"remaining_gates\": [\r\n    \"Scientific review of regional naming extent, branch exclusions and endpoint conventions.\",\r\n    \"Compare offshore editorial vertices with reproducible bathymetry and suitable layer-specific current geometry.\",\r\n    \"Canonical admission and publication review; no uniform full-system length inferred.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"west-greenland\",\r\n  \"name\": \"West Greenland Current\",\r\n  \"scope\": \"Northward shelf-break West Greenland branch from an OSW Cape Farewell approach gate to an OSW Davis Strait gate near 67 N. Excludes the separate inshore West Greenland Coastal Current, the westward branch joining Labrador Current, shed Irminger Rings, fjords, upstream East Greenland/Irminger paths and continuation beyond the chosen Davis Strait gate. Not the whole bifurcating West Greenland Current system.\",\r\n  \"layer\": \"Shelf-break regional reference geography. Source top-50 m mean model analysis supports pathway convention; no model velocity axis, common depth or 500 m isobath is extracted.\",\r\n  \"time_convention\": \"Regional northward branch convention from Gou et al. (2022), whose model analysis covers 2008-2018. Drawn OSW route is not a measured/model-derived 2008-2018 axis or a simultaneous trajectory.\",\r\n  \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2022JC018404\",\r\n  \"source_locator\": \"Abstract and section 1.1: Cape Farewell to Davis Strait shelf-break WGC distinct from coastal WGCC. Section 3.1: bifurcation near Fylla Bank into westward major branch and narrower northward branch to Davis Strait/Baffin Bay; northward mean route near 500 m isobath.\",\r\n  \"source_citation\": \"Gou et al. (2022), The Changing Behavior of the West Greenland Current System in a Very High-Resolution Model, Journal of Geophysical Research: Oceans, doi:10.1029/2022JC018404.\",\r\n  \"coordinate_selection\": \"OSW selects Cape Farewell approach, shelf-break regional waypoints and Davis gates at 66/67/68 N. No source exact nomenclature endpoint or isobath geometry is digitized. Ending at Davis Strait is a comparison convention and does not assert absence of northward flow beyond it.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -45,\r\n      59.4\r\n    ],\r\n    [\r\n      -48,\r\n      60.5\r\n    ],\r\n    [\r\n      -50.5,\r\n      61.5\r\n    ],\r\n    [\r\n      -53,\r\n      63\r\n    ],\r\n    [\r\n      -55,\r\n      65\r\n    ],\r\n    [\r\n      -56,\r\n      67\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"southern_davis_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -45,\r\n          59.4\r\n        ],\r\n        [\r\n          -48,\r\n          60.5\r\n        ],\r\n        [\r\n          -50.5,\r\n          61.5\r\n        ],\r\n        [\r\n          -53,\r\n          63\r\n        ],\r\n        [\r\n          -55,\r\n          65\r\n        ],\r\n        [\r\n          -55.5,\r\n          66\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW southern Davis approach gate.\"\r\n    },\r\n    {\r\n      \"id\": \"northern_davis_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -45,\r\n          59.4\r\n        ],\r\n        [\r\n          -48,\r\n          60.5\r\n        ],\r\n        [\r\n          -50.5,\r\n          61.5\r\n        ],\r\n        [\r\n          -53,\r\n          63\r\n        ],\r\n        [\r\n          -55,\r\n          65\r\n        ],\r\n        [\r\n          -56,\r\n          67\r\n        ],\r\n        [\r\n          -57,\r\n          68\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW northern Davis gate; excludes further Baffin Bay continuation.\"\r\n    }\r\n  ],\r\n  \"scenario_rule\": \"Three Davis Strait gate conventions crossed with longitude and independent endpoint latitude offsets of -0.25/0/+0.25 degrees: 81 editorial scenarios, not empirical uncertainty.\",\r\n  \"map_view_box\": [\r\n    535,\r\n    135,\r\n    105,\r\n    105\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"Cape Farewell approach\",\r\n    \"Davis Strait gate\"\r\n  ],\r\n  \"figure_source_label\": \"Gou et al. (2022), sec. 3.1\",\r\n  \"route_extent_kind\": \"West Greenland northward shelf-break branch\",\r\n  \"input_sha256\": \"49f175fed79101a816454d180dffde58e65837f7ba4ab2ac4a58b3fa2a636ca0\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 1065.603,\r\n  \"reported_approximate_reference_path_km\": 1100,\r\n  \"scenario_range_km\": [\r\n    909.155,\r\n    1229.367\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    900,\r\n    1300\r\n  ],\r\n  \"scenario_count\": 81,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.25,\r\n      \"start_latitude_offset_degrees\": -0.25,\r\n      \"end_latitude_offset_degrees\": -0.25,\r\n      \"start_longitude_offset_degrees\": 0,\r\n      \"end_longitude_offset_degrees\": 0,\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -45.25,\r\n          59.15\r\n        ],\r\n        [\r\n          -48.25,\r\n          60.5\r\n        ],\r\n        [\r\n          -50.75,\r\n          61.5\r\n        ],\r\n        [\r\n          -53.25,\r\n          63\r\n        ],\r\n        [\r\n          -55.25,\r\n          65\r\n        ],\r\n        [\r\n          -56.25,\r\n          66.75\r\n        ]\r\n      ],\r\n      \"length_km\": 1056.435,\r\n      \"atlas_state_crossings\": [\r\n        \"NWCS\"\r\n      ]\r\n    },\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_
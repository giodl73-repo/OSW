/a005505/perpetual_ocean2_EQUIREC_071_final_beauty_level0_A_1.mp4\",\r\n      \"source_id\": \"source:d4e82da0872ed45c\",\r\n      \"zoom\": 0,\r\n      \"nominal_display_route_fraction\": 1.0,\r\n      \"scenario_display_route_fraction_range\": [\r\n        1.0,\r\n        1.0\r\n      ],\r\n      \"complete_display_route_in_all_scenarios\": true,\r\n      \"interpretation\": \"Editorial reference-route/crop display overlap only; not physical current identification or dated event matching. Fraction measures equirectangular display line, not physical kilometres.\"\r\n    },\r\n    {\r\n      \"tile_id\": \"level0_B_1\",\r\n      \"url\": \"https://svs.gsfc.nasa.gov/vis/a000000/a005500/a005505/perpetual_ocean2_EQUIREC_071_final_beauty_level0_B_1.mp4\",\r\n      \"source_id\": \"source:d4e82da0872ed45c\",\r\n      \"zoom\": 0,\r\n      \"nominal_display_route_fraction\": 1.0,\r\n      \"scenario_display_route_fraction_range\": [\r\n        1.0,\r\n        1.0\r\n      ],\r\n      \"complete_display_route_in_all_scenarios\": true,\r\n      \"interpretation\": \"Editorial reference-route/crop display overlap only; not physical current identification or dated event matching. Fraction measures equirectangular display line, not physical kilometres.\"\r\n    }\r\n  ],\r\n  \"nasa_tiles_sha256\": \"52c6605c32e59f50aa4abde984489c7055c0e3e201e7323e30160a623c9666e0\",\r\n  \"recommended_nasa_tile_id\": \"level2_F_5\",\r\n  \"nasa_crop_recommendation_rule\": \"Highest zoom crop covering the entire display route in every retained scenario, with tile ID as deterministic tie-break. No physical identification asserted.\",\r\n  \"input_file\": \"research/south-australian-reference-path-input.json\",\r\n  \"figure\": \"figures/south-australian-reference-path-candidate.svg\"\r\n}\r\n","source_sha256":"4b76e5d654f2056759137400733b4a68fe5326773eaf758e6bf21150d7d86ec3"},"research/south-indian-eastern-reach-reference-path-candidate.json":{"source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"south-indian\",\r\n  \"name\": \"South Indian Current\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Declared 70 E to 90 E eastern-name-convention regional reach. The west gate follows the later convention reserving South Indian Ocean Current for flow beyond the Agulhas Return Current near 70 E; the east gate is the approximate recirculation/splitting region described in historical hydrography. These are selected regional gates, not whole-current endpoints. Western Agulhas Return, northward recirculation, northeastern Australia continuation and ACC paths are not added. All route latitudes and connecting vertices are editorial.\",\r\n  \"layer\": \"Historical upper-1000 m geostrophic transport context, not a uniform-depth velocity axis or surface trajectory. Variable deep reference surfaces affect diagnosed transport; no layer-specific centerline reconstructed.\",\r\n  \"time_convention\": \"Editorial regional connection informed by historical hydrographic mean-flow context and source naming conventions. Not a simultaneous observation, monthly climatological axis or annual geometry.\",\r\n  \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/epdf/10.1029/96JC03455\",\r\n  \"source_locator\": \"Stramma and Lutjeharms (1997), section 3.2 / journal p. 5523 and Figure 7 caption: 90 E recirculation/split and upper-1000 m flow schematic. Later Grand et al. (2015), regional circulation discussion, journal p. 113: SIOC name beyond 70 E. Near-40 S context from Stramma (1992) publisher abstract; drawn latitudes are editorial.\",\r\n  \"source_citation\": \"Stramma and Lutjeharms (1997), The flow field of the subtropical gyre of the South Indian Ocean, JGR 102, 5513–5530, doi:10.1029/96JC03455.\",\r\n  \"source_license\": \"Published articles cited for paraphrased facts and naming conventions; no source images, fields or schematic curves copied.\",\r\n  \"source_retrieved_date\": \"2026-10-03\",\r\n  \"coordinate_selection\": \"OSW holds the selected longitude gates at 70 E and 90 E, using a nominal near-40 S connection with five-degree waypoints. Latitude bands and endpoint offsets are finite editorial sensitivities. No figure digitization, velocity-axis extraction or physical naming junction inferred.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      70,\r\n      -40\r\n    ],\r\n    [\r\n      75,\r\n      -40\r\n    ],\r\n    [\r\n      80,\r\n      -40\r\n    ],\r\n    [\r\n      85,\r\n      -40\r\n    ],\r\n    [\r\n      90,\r\n      -40\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"equatorward_editorial_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          70,\r\n          -40\r\n        ],\r\n        [\r\n          75,\r\n          -39\r\n        ],\r\n        [\r\n          80,\r\n          -39\r\n        ],\r\n        [\r\n          85,\r\n          -39\r\n        ],\r\n        [\r\n          90,\r\n          -40\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Selected latitude bend sensitivity; not a seasonal state or current edge.\"\r\n    },\r\n    {\r\n      \"id\": \"poleward_editorial_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          70,\r\n          -40\r\n        ],\r\n        [\r\n          75,\r\n          -41\r\n        ],\r\n        [\r\n          80,\r\n          -41\r\n        ],\r\n        [\r\n          85,\r\n          -41\r\n        ],\r\n        [\r\n          90,\r\n          -40\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Selected latitude bend sensitivity; not an ACC axis or confidence boundary.\"\r\n    }\r\n  ],\r\n  \"longitude_offsets_degrees\": [\r\n    0\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.5,\r\n    0,\r\n    0.5\r\n  ],\r\n  \"scenario_rule\": \"Three declared shapes crossed with fixed longitude gates and independent start/end latitude offsets -0.5/0/+0.5 degrees: 27 editorial cases. Longitude gates stay fixed to retain the declared naming-convention reach. No seasonal extrema, width bounds or confidence interval.\",\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_studied_reach_routes\",\r\n  \"whole_system_length\": false,\r\n  \"remaining_gates\": [\r\n    \"Review the longitude naming transition and exact regional layer against compatible velocity fields.\",\r\n    \"Resolve the distinction among South Indian Current, South Indian Ocean Current and Agulhas Return under each source convention.\",\r\n    \"Diagnose meanders and local latitude shifts; the near-40 S editorial connection is not an observed axis.\",\r\n    \"Resolve the 90 E branching and northeastern continuation independently before any whole-current length.\",\r\n    \"Recover matching seasonal axes and transverse boundaries before annual length/width ranges.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    1060,\r\n    510,\r\n    210,\r\n    170\r\n  ],\r\n  \"map_label_size\": 5.5,\r\n  \"legend_line_spacing\": 8,\r\n  \"map_symbol_scale\": 0.8,\r\n  \"endpoint_labels\": [\r\n    \"70 E gate\",\r\n    \"90 E gate\"\r\n  ],\r\n  \"figure_source_label\": \"Stramma/Lutjeharms 1997\",\r\n  \"route_extent_kind\": \"eastern regional reach\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://journals.ametsoc.org/abstract/journals/phoc/22/4/1520-0485_1992_022_0421_tsioc_2_0_co_2.xml\",\r\n      \"citation\": \"Stramma (1992), The South Indian Ocean Current, JPO 22, 421–430.\",\r\n      \"locator\": \"Publisher abstract only: near-40 S STF context and eastern separation beyond 100 E.\",\r\n      \"supports\": \"Broad earlier current name and approximate frontal geography; no source centerline digitized.\"\r\n    },\r\n    {\r\n      \"url\": \"https://www.sciencedirect.com/science/article/abs/p
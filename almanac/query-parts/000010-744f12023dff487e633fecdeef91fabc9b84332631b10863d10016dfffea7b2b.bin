ommendation_rule\": \"Highest zoom crop covering the entire display route in every retained scenario, with tile ID as deterministic tie-break. No physical identification asserted.\",\r\n  \"input_file\": \"research/south-atlantic-reach-reference-path-input.json\",\r\n  \"figure\": \"figures/south-atlantic-reach-reference-path-candidate.svg\"\r\n}\r\n","source_sha256":"7f6258f70942eead02f9c621b13b32db7effb641901e4933b50cbb51338647f2"},"research/south-australian-reference-path-candidate.json":{"source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"south-australian\",\r\n  \"name\": \"South Australian Current\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Winter South Australian component from the eastern Great Australian Bight region to the western approaches of Bass Strait under Ridgway and Condie's naming convention. Nominal offshore regional gates at 135.5 and 142.5 degrees E are OSW choices. Excludes Leeuwin flow west of the Bight, Zeehan continuation off Tasmania, gulf outflows and summer reversal. Does not allocate every transition region of the 5,500 km system.\",\r\n  \"layer\": \"Upper-ocean shelf-edge geography; no depth-averaged velocity axis diagnosed.\",\r\n  \"time_convention\": \"Austral-winter naming convention; editorial geography rather than an observed winter trajectory or year-round eastward current.\",\r\n  \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2003JC001921\",\r\n  \"source_locator\": \"Ridgway and Condie (2004), section 9 paragraph 57: South Australian component from eastern Great Australian Bight to western Bass Strait, mainly winter flow; paragraphs 56 and 58 distinguish adjacent components.\",\r\n  \"source_citation\": \"Ridgway and Condie (2004), The 5500-km-long boundary flow off western and southern Australia, Journal of Geophysical Research: Oceans 109, C04017, doi:10.1029/2003JC001921.\",\r\n  \"source_license\": \"Factual geography only; no source prose, figure, source curve or velocity field packaged.\",\r\n  \"coordinate_selection\": \"OSW approximates offshore gates and intermediate waypoints. The source defines named regional extent and winter flow; it does not publish these vertices or uniquely locate the handoff between component names.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      135.5,\r\n      -35.7\r\n    ],\r\n    [\r\n      138,\r\n      -36.5\r\n    ],\r\n    [\r\n      140,\r\n      -38\r\n    ],\r\n    [\r\n      142.5,\r\n      -39.5\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"broader_eastern_bight_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          133,\r\n          -34.5\r\n        ],\r\n        [\r\n          135.5,\r\n          -35.7\r\n        ],\r\n        [\r\n          138,\r\n          -36.5\r\n        ],\r\n        [\r\n          140,\r\n          -38\r\n        ],\r\n        [\r\n          142.5,\r\n          -39.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Broader OSW eastern-Bight start convention; not a published exact naming boundary.\"\r\n    }\r\n  ],\r\n  \"scenario_rule\": \"Two eastern-Bight regional start conventions, three longitude shifts (-0.15/0/+0.15 degrees) and independent endpoint latitude shifts (-0.25/0/+0.25 degrees): 54 editorial scenarios. Does not model seasonal path distributions.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.15,\r\n    0,\r\n    0.15\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"remaining_gates\": [\r\n    \"Scientific review of eastern-Bight and western Bass Strait naming gates and seasonal scope.\",\r\n    \"Validate shelf-edge route against suitable bathymetric or velocity geometry.\",\r\n    \"Canonical admission and publication review; do not sum component candidates into a measured system length.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    1280,\r\n    550,\r\n    180,\r\n    180\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"Eastern Bight gate\",\r\n    \"Western Bass Strait gate\"\r\n  ],\r\n  \"figure_source_label\": \"Ridgway & Condie (2004)\",\r\n  \"route_extent_kind\": \"winter South Australian component\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"input_sha256\": \"99821b64b7e9d5c17dd1d007f21b0acba8ecea937b40d868a2fb59eec1c21b91\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 759.042,\r\n  \"reported_approximate_reference_path_km\": 800,\r\n  \"scenario_range_km\": [\r\n    734.341,\r\n    1055.727\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    700,\r\n    1100\r\n  ],\r\n  \"scenario_count\": 54,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.15,\r\n      \"start_latitude_offset_degrees\": -0.25,\r\n      \"end_latitude_offset_degrees\": -0.25,\r\n      \"start_longitude_offset_degrees\": 0,\r\n      \"end_longitude_offset_degrees\": 0,\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          135.35,\r\n          -35.95\r\n        ],\r\n        [\r\n          137.85,\r\n          -36.5\r\n        ],\r\n        [\r\n          139.85,\r\n          -38\r\n        ],\r\n        [\r\n          142.35,\r\n          -39.75\r\n        ]\r\n      ],\r\n      \"length_km\": 767.385,\r\n      \"atlas_state_crossings\": [\r\n       
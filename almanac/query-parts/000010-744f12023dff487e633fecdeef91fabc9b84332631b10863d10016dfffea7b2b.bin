/a000000/a005500/a005505/perpetual_ocean2_EQUIREC_071_final_beauty_level0_B_1.mp4\",\r\n      \"source_id\": \"source:d4e82da0872ed45c\",\r\n      \"zoom\": 0,\r\n      \"nominal_display_route_fraction\": 1.0,\r\n      \"scenario_display_route_fraction_range\": [\r\n        1.0,\r\n        1.0\r\n      ],\r\n      \"complete_display_route_in_all_scenarios\": true,\r\n      \"interpretation\": \"Editorial reference-route/crop display overlap only; not physical current identification or dated event matching. Fraction measures equirectangular display line, not physical kilometres.\"\r\n    }\r\n  ],\r\n  \"nasa_tiles_sha256\": \"52c6605c32e59f50aa4abde984489c7055c0e3e201e7323e30160a623c9666e0\",\r\n  \"recommended_nasa_tile_id\": \"level2_E_5\",\r\n  \"nasa_crop_recommendation_rule\": \"Highest zoom crop covering the entire display route in every retained scenario, with tile ID as deterministic tie-break. No physical identification asserted.\",\r\n  \"input_file\": \"research/south-indian-eastern-reach-reference-path-input.json\",\r\n  \"figure\": \"figures/south-indian-eastern-reach-reference-path-candidate.svg\"\r\n}\r\n","source_sha256":"5ffe93eddca3a110dedfc3a0d2dfb589504d60422e24729e0820629b4a94eafe"},"research/south-pacific-eastern-front-reach-reference-path-candidate.json":{"source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"south-pacific\",\r\n  \"name\": \"South Pacific Current\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Declared 103 W to 88 W eastern regional studied reach between two reported Subtropical Front crossings associated with the SPC in the source regional surface circulation. Front locations are proxies, not diagnosed velocity-core endpoints, and were observed in different years. OSW connecting vertices and alternatives are editorial. Branch correspondence is unresolved. Excludes Chatham Rise/western basin, ACC export branch, Peru-Chile coastal flow, northward recirculation and independent split bands. Not a whole-current or simultaneous observed axis.\",\r\n  \"layer\": \"Surface drifter circulation context combined with separate hydrographic STF crossing locations. The 14 C at 150 m frontal criterion does not define a 150 m current axis; drifter velocities include ageostrophic flow. No fixed-depth velocity centerline reconstructed.\",\r\n  \"time_convention\": \"1979–2004 regional drifter mean is context; P18 frontal crossing was sampled February–April 1994 and P19 February–April 1993. This editorial connection does not combine them into one dated trajectory or infer seasonal geometry.\",\r\n  \"source_url\": \"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/2024-12/010047303.pdf\",\r\n  \"source_locator\": \"Chaigneau and Pizarro (2005), Data [4]–[5], surface circulation [7], STF [14]–[17] and Table 1: P18 at 103 W 33.8 S and P19 at 88 W 34.5 S. Source front/velocity distinction retained; fields and curves not digitized.\",\r\n  \"source_citation\": \"Chaigneau and Pizarro (2005), Surface circulation and fronts of the South Pacific Ocean, east of 120 W, Geophysical Research Letters 32, L08605, doi:10.1029/2004GL022070.\",\r\n  \"source_license\": \"AGU article copyright 2005. Source facts paraphrased and reported frontal crossings attributed; no source figure, curve or field copied.\",\r\n  \"source_retrieved_date\": \"2026-10-03\",\r\n  \"coordinate_selection\": \"Source reports two frontal crossing coordinates, observed in separate years. OSW connects them with intermediate vertices at 100 W 34 S, 96 W 34.2 S and 92 W 34.4 S. Latitude bends and endpoint offsets test drawing choices, not a measured current axis or uncertainty on the source observations.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -103,\r\n      -33.8\r\n    ],\r\n    [\r\n      -100,\r\n      -34\r\n    ],\r\n    [\r\n      -96,\r\n      -34.2\r\n    ],\r\n    [\r\n      -92,\r\n      -34.4\r\n    ],\r\n    [\r\n      -88,\r\n      -34.5\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"equatorward_editorial_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -103,\r\n          -33.8\r\n        ],\r\n        [\r\n          -100,\r\n          -33.5\r\n        ],\r\n        [\r\n          -96,\r\n          -33.7\r\n        ],\r\n        [\r\n          -92,\r\n          -33.9\r\n        ],\r\n        [\r\n          -88,\r\n          -34.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Editorial connecting bend; not a seasonal phase or separate northern branch.\"\r\n    },\r\n    {\r\n      \"id\": \"poleward_editorial_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -103,\r\n          -33.8\r\n        ],\r\n        [\r\n          -100,\r\n          -34.5\r\n        ],\r\n        [\r\n          -96,\r\n          -34.7\r\n        ],\r\n        [\r\n          -92,\r\n          -34.9\r\n        ],\r\n        [\r\n          -88,\r\n          -34.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Editorial connecting bend; not an ACC or southern-branch axis.\"\r\n    }\r\n  ],\r\n  \"longitude_offsets_degrees\": [\r\n    0\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"scenario_rule\": \"Three declared shapes crossed with fixed section longitudes and independent endpoint-latitude offsets -0.25/0/+0.25 degrees: 27 editorial cases. These test route drawing choices, not observation errors, current width or seasonal variation.\",\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_studied_reach_routes\",\r\n  \"whole_system_length\": false,\r\n  \"remaining_gates\": [\r\n    \"Diagnose a same-layer velocity axis; frontal proxy locations are not current-core locations.\",\r\n    \"Recover compatible simultaneous observations before a dated route or seasonal extrema.\",\r\n    \"Resolve two-band correspondence within the 115–85 W split region described by Stramma et al. (1995).\",\r\n    \"Test front-to-flow correspondence against the layered supergyre distinction in Ridgway and Dunn (2007).\",\r\n    \"Resolve western and eastern continuation independently before a whole-current length or annual width.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    345,\r\n    530,\r\n    140,\r\n    110\r\n  ],\r\n  \"map_label_size\": 3.5,\r\n  \"legend_line_spacing\": 5.5,\r\n  \"map_symbol_scale\": 0.7,\r\n  \"endpoint_labels\": [\r\n    \"P18 STF\",\r\n    \"P19 STF\"\r\n  ],\r\n  \"figure_source_label\": \"Chaigneau/Pizarro 2005\",\r\n  \"route_extent_kind\": \"STF-proxy regional reach\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://journals.ametsoc.org/view/journals/phoc/25/1/1520-0485_1995_025_0077_tspc_2_0_co_2.xml\",\r\n      \"citation\": \"Stramma, Peterson and Tomczak (1995), The South Pacific Current, JPO 25, 77–91.\",\r\n      \"locator\": \"Publisher-indexed abstract; direct article/PDF access unsuccessful.\",\r\n      \"supports\": \"SPC distinction from ACC, broad Chatham Rise context and possible splitting at 115–85 W. Does not assign a branch to this connection.\"\r\n    },\r\n    {\r\n      \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007GL030392\",\r\n      \"citation\": \"Ridgway and Dunn (2007), Observational evidence for a Southern Hemisphere oceanic supergyre, GRL 34, L13612.\",\r\n      \"locator\": \"Section 3.4 [15]: gyre return flow and STF relation.\",\r\n      \"supports\": \"Layered gyre return flow is not universally identified by the STF; no whole-current or intermediate-layer axis copied from surface/frontal proxies.\"\r\n    }\r\n  ],\r\n  \"context_landmarks\": [],\r\n  \"source_anchor_observations\": [\r\n    {\r\n      \"id\": \"p18-1994-stf-crossing\",\r\n      \"longitude_latitude\": 
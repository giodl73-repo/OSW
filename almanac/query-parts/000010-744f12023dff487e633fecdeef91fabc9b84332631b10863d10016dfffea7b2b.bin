  \"source_id\": \"source:d4e82da0872ed45c\",\r\n      \"zoom\": 0,\r\n      \"nominal_display_route_fraction\": 1.0,\r\n      \"scenario_display_route_fraction_range\": [\r\n        1.0,\r\n        1.0\r\n      ],\r\n      \"complete_display_route_in_all_scenarios\": true,\r\n      \"interpretation\": \"Editorial reference-route/crop display overlap only; not physical current identification or dated event matching. Fraction measures equirectangular display line, not physical kilometres.\"\r\n    },\r\n    {\r\n      \"tile_id\": \"level0_B_1\",\r\n      \"url\": \"https://svs.gsfc.nasa.gov/vis/a000000/a005500/a005505/perpetual_ocean2_EQUIREC_071_final_beauty_level0_B_1.mp4\",\r\n      \"source_id\": \"source:d4e82da0872ed45c\",\r\n      \"zoom\": 0,\r\n      \"nominal_display_route_fraction\": 1.0,\r\n      \"scenario_display_route_fraction_range\": [\r\n        1.0,\r\n        1.0\r\n      ],\r\n      \"complete_display_route_in_all_scenarios\": true,\r\n      \"interpretation\": \"Editorial reference-route/crop display overlap only; not physical current identification or dated event matching. Fraction measures equirectangular display line, not physical kilometres.\"\r\n    }\r\n  ],\r\n  \"nasa_tiles_sha256\": \"52c6605c32e59f50aa4abde984489c7055c0e3e201e7323e30160a623c9666e0\",\r\n  \"recommended_nasa_tile_id\": \"level2_G_4\",\r\n  \"nasa_crop_recommendation_rule\": \"Highest zoom crop covering the entire display route in every retained scenario, with tile ID as deterministic tie-break. No physical identification asserted.\",\r\n  \"input_file\": \"research/solomon-island-coastal-undercurrent-reference-path-input.json\",\r\n  \"figure\": \"figures/solomon-island-coastal-undercurrent-reference-path-candidate.svg\"\r\n}\r\n","source_sha256":"64c8f36d57216f978f94ed81debd6f4d8d95b74c985ee613870c3a41d2c7942d"},"research/somali-summer-southern-reference-path-candidate.json":{"source_json":"{\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"source_license\": \"Factual geography paraphrased with attribution; no source prose, figures, curves or model output packaged.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.15,\r\n    0,\r\n    0.15\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.1,\r\n    0,\r\n    0.1\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"remaining_gates\": [\r\n    \"Scientific review of seasonal regional gate conventions and separation from Somali undercurrents.\",\r\n    \"Verify coastal/slope correspondence with season-appropriate bathymetric and velocity evidence.\",\r\n    \"Canonical admission and publication review; no whole-system or annual-average length inferred.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"somali\",\r\n  \"name\": \"Somali Current\",\r\n  \"scope\": \"June-July southern Somali coastal limb from an OSW equatorial gate northward to an OSW separation gate at 3.5 N. Source describes offshore departure south of 4 N and limited exchange with the northern Great Whirl. Excludes the upstream East African Coast Current, offshore Southern Gyre return limb, Great Whirl, Socotra outflow and undercurrents. This is one seasonal component, not the full summer Somali Current system.\",\r\n  \"layer\": \"Upper-layer southern seasonal coastal geography; no fixed-depth or velocity-derived axis.\",\r\n  \"time_convention\": \"June-July monsoon-onset two-gyre convention. Does not assume rare late-summer gyre coalescence or persistent whole-coast continuity.\",\r\n  \"source_url\": \"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf\",\r\n  \"source_locator\": \"Section 4.1.1, printed page 38 (PDF index 37): June-July cross-equatorial limb departs the coast south of 4 N, partitions into offshore outflow/recirculation and has little exchange with Great Whirl. Printed pages 41-43 discuss non-universal gyre coalescence.\",\r\n  \"source_citation\": \"Schott and McCreary (2001), The monsoon circulation of the Indian Ocean, Progress in Oceanography 51, 1-123, doi:10.1016/S0079-6611(01)00083-0.\",\r\n  \"coordinate_selection\": \"OSW chooses equatorial bookkeeping gate and offshore coastal vertices. Source does not identify the equator as the physical current origin. Alternative 3/3.8 N terminal gates test the regional separation convention; no gyre perimeter is added. Offshore display offsets avoid the coarse atlas land mask; this does not verify shelf-break or current-core position.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      43.4,\r\n      0\r\n    ],\r\n    [\r\n      44.7,\r\n      1\r\n    ],\r\n    [\r\n      46,\r\n      2\r\n    ],\r\n    [\r\n      47.2,\r\n      3\r\n    ],\r\n    [\r\n      47.7,\r\n      3.5\r\n    ]\r\n  ],\r\n  \"scenario_rule\": \"Three southern-limb separation conventions crossed with longitude shifts and independent endpoint latitude shifts of -0.1/0/+0.1 degrees: 81 editorial scenarios, not empirical uncertainty.\",\r\n  \"map_view_box\": [\r\n    925,\r\n    370,\r\n    110,\r\n    130\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"Equatorial gate\",\r\n    \"3.5 N separation gate\"\r\n  ],\r\n  \"figure_source_label\": \"Schott & McCreary (2001)\",\r\n  \"route_extent_kind\": \"June-July southern coastal limb\",\r\n  \"map_label_size\": 1.7,\r\n  \"legend_line_spacing\": 2.7,\r\n  \"map_symbol_scale\": 0.65,\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"earlier_separation\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          43.4,\r\n          0\r\n        ],\r\n        [\r\n          44.7,\r\n          1\r\n        ],\r\n        [\r\n          46,\r\n          2\r\n        ],\r\n        [\r\n     
act transverse axis and paired edges unresolved.","source_citation":"Cresswell, G. (2000), Currents of the continental shelf and upper slope of Tasmania, Papers and Proceedings of the Royal Society of Tasmania 133(3):21–30, doi:10.26749/rstpp.133.3.21.","source_evidence_kind":"published_original_attributed_historical_regional_summary","source_locator":"Introduction, printed p21 / PDF page 1, paragraph on Baines et al. (1983). Separate Strahan sections: pp24–25 and Figure 5C p28 / PDF page 8.","source_quality_note":"The 40 km summary is attributed to Baines et al. (1983); March/December 1997 Strahan widths remain numerically unknown. Neither the survey depth nor later seasonal calendar supplies this width support.","source_retrieved_date":"2026-10-08","source_url":"https://eprints.utas.edu.au/13585/7/2000_Cresswell_Currents_rst.pdf","status":"editorial_source_extraction_not_canonical","time_convention":"Historical Baines et al. (1983) description repeated in Cresswell (2000); exact width occupation support unresolved.","uncertainty_km":null,"whole_current_representative":false,"width_metric":"author_reported_current_width","width_range_km":null,"width_rank_eligible":false},{"annual_extrema_eligible":false,"approximate_width_km":22,"boundary_rule":"Offshore modal amplitude exp(-gamma_1*y), relative to its coastal value; adopted exp(-3) decay criterion (approximately 5%). Printed gamma_1=1.3e-4 m^-1.","calendar_months":null,"current_id":"tsushima","extraction_method":"Manual original equation and context transcription with visual verification; independently calculate printed arithmetic, without digitizing current boundaries.","fixed_layer_bounds_m":null,"full_width_inference_eligible":false,"geographic_scope":"Nearshore branch over the continental shelf off the San’in coast, Japan Sea; not the entire Tsushima Current system.","id":"tsushima-matsuyama-1990-nearshore-modal-width","is_confidence_interval":false,"layer":"First baroclinic mode under summer density stratification; eastward above the seasonal thermocline and westward below. No fixed width slab extracted.","measurement_type":"published_campaign_modal_decay_estimate","modal_decay_context":{"arithmetic_discrepancy_unresolved":true,"audit_file":"research/tsushima-matsuyama-1990-modal-width-scope-audit.json","audit_sha256":"587cccbd45b3673137523241a2bbab07f3ee681e8f5549a7b44f0ae6ced90fb6","boundary_coordinates_extracted":false,"campaign_context":{"end":"1980-08-25","is_homogeneous_width_observation_period":false,"start":"1980-07-26"},"coastal_reference_amplitude":1,"coefficient_method":"Separation constant of density-profile eigenvalue problem (Eq7 with boundary conditions); least-squares fits current data to computed mode shapes, not an offshore velocity-coefficient fit.","common_current_mean_period":{"end":"1980-08-14","source_locator":"Printed p159, section4: common period for five-station time averages.","start":"1980-07-26"},"discrepancy_is_uncertainty_interval":false,"display_caption":"Coastal branch · reported modal width 22 km (summer 1980). Diagram illustrates the published exponential expression; its differential-equation sign remains unresolved. No mapped edge or seasonal range.","display_method_note":"The source adopts roughly 5% of coastal amplitude as the edge. Its printed coefficient gives 23.1 km; the paper reports 22 km and summarizes about 20 km. Arithmetic discrepancy unresolved; numerical uncertainty unknown.","edge_exponent":3,"edge_relative_amplitude":0.049787068367863944,"fitted_current_modes":["barotropic","first_baroclinic"],"hydrographic_profile_support":{"date":"1980-08-08","latitude_degrees_north":36.15,"longitude_degrees_east":134.13333333333333,"role":"Density profile input for computed vertical modes; not a current edge.","station":"H"},"instrument_context":{"bottom_offset_m":10,"is_fixed_width_layer":false,"sampling_interval_minutes":10,"surface_offset_m":10},"model_assumptions":["Hydrostatic and Boussinesq approximations","Flat bottom and rigid lid","Zero initial potential vorticity; coast-relative exponential offshore mode"],"normalized_amplitude_equation":"Y(y)/Y(0)=exp(-gamma_1*y)","offshore_equation_consistency":{"diagram_validates_printed_differential_equation":false,"finding_class":"editorial_mathematical_consistency_check_not_author_correction","inconsistent_for_real_positive_gamma":true,"printed_equation":"d2Y_n/dy2+gamma_n^2*Y_n=0","sign_resolution":null,"source_locator":"Printed p161 / PDF page 6, Eq8 and following solution statement; original visually verified.","stated_solution":"Y_n~exp(-gamma_n*y)"},"printed_gamma_per_m":0.00013,"recalculated_width_km":23.076923076923077,"separate_hydrographic_climatology":{"calendar_months":[7,8,9],"caption_longitude_degrees_east":134,"discussion_longitude_degrees_east":132,"end_year":1985,"is_1980_width_support":false,"longitude_conflict":true,"start_year":1964},"shelf_context":{"coast_to_200m_isobath_km":[15,20],"is_width_range":false},"source_reported_width_km":22,"source_rounded_relative_amplitude":0.05,"source_summary_width_km_approx":20,"station_B_modal_mean_period":{"end":"1980-08-25","source_locator":"Printed p162, Figure8 discussion: entire B record.","start":"1980-07-26"},"station_support":[{"end":"1980-08-25","source_reported_days":31,"start":"1980-07-26","station":"A"},{"end":"1980-08-25","source_reported_days":31,"start":"1980-07-26","station":"B"},{"end":"1980-08-14","source_reported_days":19,"start":"1980-07-26","station":"C"},{"end":"1980-08-14","source_reported_days":19,"start":"1980-07-26","station":"D"},{"end":"1980-08-14","source_reported_days":19,"start":"1980-07-26","station":"E"}],"summary_is_independent_measurement":false,"summer_campaign_is_recurring_calendar":false},"name":"Tsushima Current","observed_period":null,"phase_kind":"campaign_modal_decay_width","phase_label":"1980 coastal-branch modal estimate","range_interpretation":"Reported 22 km; summary approximately 20 km and recalculation 23.0769 km describe the same estimate. They do not define a measured range or numerical uncertainty.","range_kind":"reported_modal_estimate_with_unresolved_arithmetic_discrepancy","remaining_gates":["Resolve source differential-equation sign and arithmetic discrepancies; independent scientific admission.","Extract geographically located compatible boundaries and uncertainty.","Acquire repeat occupations before seasonal ranges or playback."],"seasonal_playback_eligible":false,"section_geometry":null,"section_orientation":"Offshore y direction approximately northward from the east–west coast in the source model; paired edge coordinates unresolved.","source_citation":"Matsuyama, M. (1990), The Structure of the Nearshore Branch of the Tsushima Current on the Shelf off the San’in Coast in Summer, Journal of the Oceanographical Society of Japan 46(4):156–166, doi:10.1007/BF02125576.","source_evidence_kind":"published_original_campaign_modal_diagnosis","source_locator":"Printed p165 / PDF page 10, Discussion decay equation and Summary(1); eigenvalue and fit method p161 / PDF page 6; station dates p158 and common average p159; separate Fig10 p164.","source_quality_note":"Reported 22 km disagrees with 3/(1.3e-4) m = 23.0769 km; cause unresolved. Approximately 20 km is a summary of the same estimate. Fig10 caption 134°E conflicts with Discussion 132°E; the climatological section is separate support. Printed Eq8 plus sign is inconsistent with the stated exponential solution for real positive gamma; no correction inferred.","source_retrieved_date":"2026-10-08","source_url":"https://www.jstage.jst.go.jp/article/kaiyou1942/46/4/46_4_156/_pdf","status":"editorial_source_extraction_not_canonical","time_convention":"Finite July–August 1980 campaign. Modal coefficient from the 8 August hydrographic profile; station and current-average durations differ. No homogeneous width occupation interval or recurring seasonal calendar assigned.","uncertainty_km":null,"whole_current_representative":false,"width_metric":"coast_to_modal_decay_threshold_distance","width_range_km":null,"width_rank_eligible":false},{"annual_extrema_eligible":false,"approximate_width_km":null,"boundary_rule":"Issuer-reported greater-than geographic breadth. No velocity threshold, core edges, finite outer limit or section orientation extracted.","calendar_months":null,"current_id":"west-australian","extraction_method":"Inequality transcribed from visually inspected original report prose. No contour digitization, current-axis diagnosis or conversion from the printed coordinate phrase.","fixed_layer_bounds_m":null,"full_width_inference_eligible":false,"geographic_scope":"Broad equatorward surface flow offshore of Leeuwin in the southeastern Indian Ocean; no reproducible cross-flow transect or paired endpoints supplied.","id":"west-australian-glenn-2008-offshore-breadth-constraint","is_confidence_interval":false,"layer":"Source describes equatorward surface current as shallow; no fixed numerical depth layer supplied for the breadth.","measurement_type":"published_regional_summary","name":"West Australian Current","observed_period":null,"original_regional_context":{"adjacent_summer_inflow_is_breadth_support":false,"audit_file":"research/west-australian-glenn-2008-breadth-scope-audit.json","audit_sha256":"cae64ac5000db69c62c1c8d7bb2b1785c28a7dcd3ddec7cd9277caac27b6851e","boundary_coordinates_extracted":false,"coordinate_conflict":{"coordinate_repaired":false,"coordinate_type_agrees_with_hemisphere_notation":false,"source_phrase":"latitude 60 E","used_for_kilometre_conversion":false},"display_caption":"West Australian Current: report describes offshore geographic breadth >1000 km. Not a measured 1000 km point, finite width interval, statistical bound or seasonal range.","display_method_note":"Government synthesis, not a defined velocity section. The latitude 60 E coordinate phrase is inconsistent and is not converted to kilometres. Figure 6.15 is schematic; older 100-200 km cyclonic-stream width is separate naming context. No mapped band or seasonal playback inferred.","finite_upper_width_extracted":false,"historical_stream_context":{"is_range_endpoint_for_this_record":false,"is_seasonal_width_extrema":false,"reported_width_km":[100,200],"scope":"Narrow cyclonic stream with poleward coastal turn, distinct source convention from broad offshore equatorward flow.","source_access":"Publisher-indexed abstract; original full article remains unreviewed.","source_citation":"Andrews (1977), doi:10.1016/0146-6291(77)90517-3"},"notation_is_rigorous_lower_bound":false,"protocol_file":"plans/west-australian-breadth-constraint-protocol-v1.md","protocol_sha256":"c180fd59c91f61b0b835bf0739cc9a8cc8db0c8a52654832ca46bb466393cdbc","publication_year_is_width_occupation":false,"quantity_scope":"offshore_geographic_breadth_not_velocity_core_width","reference_scale_is_point_width":false,"schematic_is_velocity_axis":false,"source_class":"government_environmental_synthesis","span_is_annual_range":false,"underlying_width_methods_reviewed":false,"width_passage_visually_inspected":true},"phase_kind":"regional_summary","phase_label":"Reported offshore geographic breadth","range_interpretation":"Reported offshore geographic breadth exceeds 1000 km in this synthesis. No representative width, finite upper end, statistical uncertainty, annual range or velocity-core boundaries extracted.","range_kind":"government_reported_greater_than_offshore_breadth","remaining_gates":["Recover the underlying velocity-based breadth definition and compatible layer/time support.","Resolve the printed coordinate-type conflict independently of the source inequality.","Review historical narrow-stream versus offshore-current naming without pooling dimensions.","Obtain repeated comparable sections before annual width ranges or map geometry.","Independent scientific and canonical admission."],"reported_width_constraint":{"is_rigorous_lower_bound":false,"kind":"issuer_reported_greater_than_geographic_breadth","numerical_uncertainty_km":null,"r
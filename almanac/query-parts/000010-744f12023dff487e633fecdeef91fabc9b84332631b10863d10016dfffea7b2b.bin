       \"peak_northward_m_s\": 0.7819400000000001,\r\n        \"offshore_span_km\": 37.352311,\r\n        \"full_width_km\": null,\r\n        \"metric\": \"sampled_peak_to_offshore_half_peak_boundary_not_full_width\",\r\n        \"nearshore_boundary_status\": \"not_diagnosed\",\r\n        \"is_confidence_interval\": false,\r\n        \"offshore_crossing_coordinates_lon_lat\": [\r\n          -76.46078353003232,\r\n          26.50855024149401\r\n        ],\r\n        \"bracketing_cast_ids\": [\r\n          \"AB0505_058\",\r\n          \"AB0505_057\"\r\n        ],\r\n        \"station_bracket_span_km\": [\r\n          34.547482125997675,\r\n          50.27229478845445\r\n        ]\r\n      }\r\n    }\r\n  ],\r\n  \"whole_current_length_km\": null,\r\n  \"whole_current_width_km\": null,\r\n  \"annual_length_range_km\": null,\r\n  \"annual_width_range_km\": null,\r\n  \"width_rank_eligible\": false,\r\n  \"seasonal_playback_eligible\": false,\r\n  \"remaining_gates\": [\r\n    \"Independent review of section membership, tide/error-velocity impact, threshold and sampled-peak representativeness.\",\r\n    \"Diagnose both depth-compatible boundaries and sampling sufficiency before full-width measurement.\",\r\n    \"Recover along-current axes and repeated annual support; two May occupations are not a seasonal cycle.\"\r\n  ],\r\n  \"inventory_file\": \"research/antilles-ab0505-ladcp-profile-inventory.json\",\r\n  \"inventory_sha256\": \"491fbe8feb7393600888455c26390d67fe0a734ab2e248d9a0474161a0437227\",\r\n  \"figure\": \"figures/antilles-ab0505-400m-section-diagnostic.svg\",\r\n  \"source_url\": \"https://www.aoml.noaa.gov/phod/wbts/data.php\"\r\n}\r\n","source_sha256":"79072600b051b181a17fea244d3b4de17fee8b5f5393e5cee6c87fef75c30bd5"},"research/antilles-northern-bahamas-reference-path-candidate.json":{"source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"antilles\",\r\n  \"name\": \"Antilles Current\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Conditional regional reference from OSW 26.5 N offshore-Abaco gate to OSW 28 N northwestward approach gate north of Little Bahama Bank. Both gates and all bends are editorial regional truncations, not observed current origins, terminations or a Gulf Stream junction. Southern Antilles, Florida Current, Gulf Stream, DWBC and eddy loops excluded.\",\r\n  \"layer\": \"Modern mean-flow naming context in the upper 1000 dbar with a subsurface peak near 400 dbar at 26.5 N. No fixed-pressure axis or depth-following trajectory diagnosed. Pressure is not converted to metres; NASA surface animation is only geographic context.\",\r\n  \"time_convention\": \"Undated conditional editorial connection around northern Bahamas. Meinen 2005-2015 mean evidence is local to 26.5 N; it does not date this full path. KN-200-4 (13 April-3 May 2011) did not detect the characteristic Antilles Current off Abaco while finding north-bank westward flow; these are not asserted to be one continuous observed current.\",\r\n  \"source_url\": \"https://repository.library.noaa.gov/view/noaa/20909/noaa_20909_DS1.pdf\",\r\n  \"source_locator\": \"Meinen et al. 2019, PDF pp1-3 and 18: regional naming, observation support and uncertainty. KN-200-4 report pp1/10: cruise dates, conditional modeled pathway and local non-detection.\",\r\n  \"source_citation\": \"Meinen et al. (2019), Structure and Variability of the Antilles Current at 26.5 N, doi:10.1029/2018JC014836; RAPID/MOCHA KN-200-4 cruise report (2011).\",\r\n  \"source_license\": \"Article identifies USA public-domain government status; cruise-report license not established. Original PDFs and page pixels excluded; only attributed facts and independent OSW geography packaged.\",\r\n  \"source_retrieved_date\": \"2026-10-14\",\r\n  \"coordinate_selection\": \"OSW selects both truncation gates and rounded intermediate bends for a conditional regional naming connection, with no diagnosed velocity axis. Alternative latitude bends and uniform longitude/independent endpoint-latitude offsets describe drawing choices, not current width, seasonal variability or source position errors.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -76.6,\r\n      26.5\r\n    ],\r\n    [\r\n      -76.65,\r\n      26.9\r\n    ],\r\n    [\r\n      -77.0,\r\n      27.3\r\n    ],\r\n    [\r\n      -77.5,\r\n      27.65\r\n    ],\r\n    [\r\n      -78.1,\r\n      28.0\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"southern_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -76.6,\r\n          26.5\r\n        ],\r\n        [\r\n          -76.65,\r\n          26.75\r\n        ],\r\n        [\r\n          -77.0,\r\n          27.150000000000002\r\n        ],\r\n        [\r\n          -77.5,\r\n          27.5\r\n        ],\r\n        [\r\n          -78.1,\r\n          28.0\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Finite editorial bend sensitivity, not a seasonal axis, observed track or current edge.\"\r\n    },\r\n    {\r\n      \"id\": \"northern_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -76.6,\r\n          26.5\r\n        ],\r\n        [\r\n          -76.65,\r\n          27.049999999999997\r\n        ],\r\n        [\r\n          -77.0,\r\n          27.45\r\n        ],\r\n        [\r\n          -77.5,\r\n          27.799999999999997\r\n        ],\r\n        [\r\n          -78.1,\r\n          28.0\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Finite editorial bend sensitivity, not a seasonal axis, observed track or current edge.\"\r\n    }\r\n  ],\r\n  \"longitude_offsets_degrees\": [\r\n    -0.1,\r\n    0,\r\n    0.1\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.15,\r\n    0,\r\n    0.15\r\n  ],\r\n  \"scenario_rule\": \"Three predeclared shapes crossed with three longitude shifts and independent three-value endpoint-latitude shifts: 81 retained editorial scenarios; no confidence or seasonal interpretation.\",\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_studied_reach_routes\",\r\n  \"whole_system_length\": false,\r\n  \"remaining_gates\": [\r\n    \"Independently review identity, gates, bathymetry, pressure/layer correspondence and conditional continuity.\",\r\n    \"Acquire longitudinal velocity support before an observed axis or physical full-current length.\",\r\n    \"Whole-current width, annual dimension ranges and scientific admission remain open.\",\r\n    \"No surface-NASA depth/date match, physical state containment or occupied polygon inferred.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    465,\r\n    330,\r\n    40,\r\n    44\r\n  ],\r\n  \"map_label_size\": 0.55,\r\n  \"legend_line_spacing\": 0.9,\r\n  \"map_symbol_scale\": 0.2,\r\n  \"endpoint_labels\": [\r\n    \"[-76.6, 26.5] OSW regional gate\",\r\n    \"[-78.1, 28.0] OSW regional gate\"\r\n  ],\r\n  \"figure_source_label\": \"Meinen 2019; KN-200-4 2011 conditional context\",\r\n  \"route_extent_kind\": \"conditional northern Bahamas reference reach\",\r\n  \"source_review_receipt\": {\r\n    \"source_document_file\": \"research/source-data/meinen-antilles-2019/journal-article.pdf\",\r\n    \"source_document_sha256\": \"d34432e1d29c59bc518978f31e71baa5cd55af9214d7465cebbcc0eaaea43e9a\",\r\n    \"acquisition_file\": \"research/source-data/meinen-antilles-2019/acquisition.json\",\r\n    \"acquisition_sha256\": \"88582bacc6c39bdcb7f534d3dc4989245742a139a34124bfc6f1d7ee9ffcef06\",\r\n    \"audit_file\": \"research/antilles-northern-bahamas-reference-scope-audit.json\",\r\n    \"audit_sha256\": \"cfe0a859c9643d89125c7fb77018ecb9c72561673d42dd0aac47b1928c550c4a\"\r\n  },\r\n  \"input_sha256\": \"4624944daa2ff0e74ace3da192019df1512fd9fc661e1aabd7792fa5b9618913\",\r\n  \"generator_file\": \
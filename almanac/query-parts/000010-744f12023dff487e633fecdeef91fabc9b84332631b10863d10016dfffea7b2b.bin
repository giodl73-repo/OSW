urrent reference route from nominal 14 degrees S origin to nominal 38 degrees S confluence; alternate origins 10/15 degrees S and terminal proxies 34.5/40.5 degrees S. Excludes North Brazil Current, Brazil Return Current recirculation, eastward South Atlantic Current and deep intermediate undercurrent. Confluence-proxy positions are endpoint assumptions, not instantaneous observed axes.\",\r\n  \"layer\": \"Upper-ocean poleward BC branch geographic reference only. No fixed vertical interval or undercurrent route diagnosed.\",\r\n  \"time_convention\": \"General geographic sketch using source-described origin and confluence variability. Neither the 2009–2015 mooring period nor the front proxy interval creates a contemporaneous full-current axis.\",\r\n  \"source_url\": \"https://doi.org/10.1029/2020JC017146\",\r\n  \"source_locator\": \"Introduction: SEC bifurcation and BC origin roughly 10–15 degrees S. Southern endpoint convention additionally uses Schmid and Majumder (2018), Sections 3 and 4.3: confluence/front separation proxy varies 34.5–40.5 degrees S and averages near 38 degrees S.\",\r\n  \"source_citation\": \"Chidichimo et al. (2021), Brazil Current Volume Transport Variability During 2009–2015 From a Long-Term Moored Array at 34.5°S, Journal of Geophysical Research: Oceans 126, e2020JC017146.\",\r\n  \"source_license\": \"Factual geographic references only; no source prose, figures, provider geometry or model data packaged.\",\r\n  \"coordinate_selection\": \"OSW selects coarse regional offshore waypoints. Sources define flow identity and broad endpoint geography, not these intermediate vertices or longitudes. The path is not a digitized source curve, observed axis, bathymetric contour or diagnosed velocity field.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -38,\r\n      -14\r\n    ],\r\n    [\r\n      -38.5,\r\n      -18\r\n    ],\r\n    [\r\n      -38.5,\r\n      -20\r\n    ],\r\n    [\r\n      -41,\r\n      -23\r\n    ],\r\n    [\r\n      -46,\r\n      -26\r\n    ],\r\n    [\r\n      -48,\r\n      -30\r\n    ],\r\n    [\r\n      -51,\r\n      -34\r\n    ],\r\n    [\r\n      -54,\r\n      -38\r\n    ]\r\n  ],\r\n  \"scenario_rule\": \"Nine paired origin/confluence routes (origins 10/14/15 degrees S; ends 34.5/38/40.5 degrees S) crossed with three uniform longitude shifts (-0.25/0/+0.25 degrees): 27 editorial scenarios. The origin and southern-proxy latitude ranges are source-described; chosen gate longitudes and intermediate vertices are OSW assumptions. This finite envelope is not a statistical interval or an exhaustive meander/seasonal model.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    0\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"remaining_gates\": [\r\n    \"Independent review of source-specific start/end conventions, branches and seasonal endpoint alternatives.\",\r\n    \"Check offshore waypoints against reproducible shelf/slope or velocity geometry at suitable resolution.\",\r\n    \"Canonical claim, geometry and measurement integration before public admission.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    525,\r\n    480,\r\n    155,\r\n    165\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"14°S nominal origin\",\r\n    \"38°S nominal confluence\"\r\n  ],\r\n  \"figure_source_label\": \"Chidichimo et al. (2021); Schmid & Majumder (2018)\",\r\n  \"route_extent_kind\": \"poleward-branch reference route\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://os.copernicus.org/articles/14/417/2018/\",\r\n      \"citation\": \"Schmid and Majumder (2018), Transport variability of the Brazil Current from observations and a data assimilation model, Ocean Science 14, 417–436.\",\r\n      \"locator\": \"Section 3 (shelf-break path and front separation proxy range) and Section 4.3 (average near 38 degrees S).\",\r\n      \"role\": \"Southern endpoint convention and shelf-break route interpretation.\"\r\n    }\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"nominal_northern_confluence\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -38,\r\n          -14\r\n        ],\r\n        [\r\n          -38.5,\r\n          -18\r\n        ],\r\n        [\r\n          -38.5,\r\n          -20\r\n        ],\r\n        [\r\n          -41,\r\n          -23\r\n        ],\r\n        [\r\n          -46,\r\n          -26\r\n        ],\r\n        [\r\n          -48,\r\n          -30\r\n        ],\r\n        [\r\n          -51,\r\n          -34\r\n        ],\r\n        [\r\n          -51,\r\n          -34.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW regional origin/confluence endpoint pairing; not an observed simultaneous streamline.\"\r\n    },\r\n    {\r\n      \"id\": \"nominal_southern_confluence\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -38,\r\n          -14\r\n        ],\r\n        [\r\n          -38.5,\r\n          -18\r\n        ],\r\n        [\r\n          -38.5,\r\n          -20\r\n        ],\r\n        [\r\n          -41,\r\n          -23\r\n        ],\r\n        [\r\n          -46,\r\n          -26\r\n        ],\r\n        [\r\n          -48,\r\n          -30\r\n        ],\r\n        [\r\n          -51,\r\n          -34\r\n        ],\r\n        [\r\n          -56,\r\n          -40.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW regional origin/confluence endpoint pairing; not an observed simultaneous streamline.\"\r\n    },\r\n    {\r\n      \"id\": \"northern_origin_nominal\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -34,\r\n          -10\r\n        ],\r\n        [\r\n          -38.5,\r\n          -18\r\n        ],\r\n        [\r\n          -38.5,\r\n        
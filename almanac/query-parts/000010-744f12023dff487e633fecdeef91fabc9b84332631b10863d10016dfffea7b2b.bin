ce_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"source_license\": \"Factual regional geography paraphrased with attribution; no source figures, model fields or particle tracks packaged.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"map_label_size\": 1.7,\r\n  \"legend_line_spacing\": 2.8,\r\n  \"map_symbol_scale\": 0.65,\r\n  \"remaining_gates\": [\r\n    \"Scientific review of regional extent, exclusions and endpoint conventions.\",\r\n    \"Verify coastal/ridge correspondence with reproducible bathymetry or suitable layer-specific velocity geometry.\",\r\n    \"Canonical admission and publication review; retain partial/regional scope.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"irminger\",\r\n  \"name\": \"Irminger Current\",\r\n  \"scope\": \"Northward eastern-Irminger-Sea reference branch along the western Reykjanes Ridge flank, from an OSW southern ridge gate at 56 N to an OSW pre-bifurcation gate near 65 N south of Denmark Strait. Excludes return flow toward Greenland, North Icelandic Irminger continuation, interior Irminger Gyre circuits, offshore eddies, opposite East Reykjanes Ridge Current and deep overflow currents. Gates are regional comparison choices, not established whole-current endpoints.\",\r\n  \"layer\": \"Upper-layer/surface-intensified regional branch geography. No fixed-depth or two-core velocity axis, ridge contour or deep-current route reconstructed.\",\r\n  \"time_convention\": \"Regional naming convention supported by 2011 and 2026 source introductions; not a dated measured or modeled axis, annual average or water-parcel trajectory.\",\r\n  \"source_url\": \"https://rpickart.whoi.edu/wp-content/uploads/sites/53/2016/02/DSR-The-Irminger-Gyre.pdf\",\r\n  \"source_locator\": \"Vage et al. (2011), section 1, printed pp. 590-592/PDF indices 0-2: northward ridge-flank Irminger Current, bifurcation south of Denmark Strait and return portion alongside EGC. Figure 2 distinguishes upper-layer and deep currents.\",\r\n  \"source_citation\": \"Vage et al. (2011), The Irminger Gyre: Circulation, convection, and interannual variability, Deep-Sea Research I 58, 590-614, doi:10.1016/j.dsr.2011.03.001.\",\r\n  \"coordinate_selection\": \"OSW chooses all coarse western-ridge-flank vertices and 56/65 N nominal gates. Alternatives use narrower 58/64 N or broader 55.5/65.5 N regional conventions. Sources do not fix these exact nomenclature limits. No source schematic or velocity core is digitized.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -36,\r\n      56\r\n    ],\r\n    [\r\n      -33,\r\n      58\r\n    ],\r\n    [\r\n      -31,\r\n      60\r\n    ],\r\n    [\r\n      -28,\r\n      62\r\n    ],\r\n    [\r\n      -26.5,\r\n      64\r\n    ],\r\n    [\r\n      -27,\r\n      65\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"inner_ridge_gates\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -33,\r\n          58\r\n        ],\r\n        [\r\n          -31,\r\n          60\r\n        ],\r\n        [\r\n          -28,\r\n          62\r\n        ],\r\n        [\r\n          -26.5,\r\n          64\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Shorter OSW ridge-flank regional gate convention.\"\r\n    },\r\n    {\r\n      \"id\": \"outer_ridge_gates\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -37,\r\n          55.5\r\n        ],\r\n        [\r\n          -36,\r\n          56\r\n        ],\r\n        [\r\n          -33,\r\n          58\r\n        ],\r\n        [\r\n          -31,\r\n          60\r\n        ],\r\n        [\r\n          -28,\r\n          62\r\n        ],\r\n        [\r\n          -26.5,\r\n          64\r\n        ],\r\n        [\r\n          -27,\r\n          65\r\n        ],\r\n        [\r\n          -27.5,\r\n          65.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Broader OSW ridge-flank convention, still stopping before downstream branch tracing.\"\r\n    }\r\n  ],\r\n  \"scenario_rule\": \"Three regional start/end conventions crossed with three longitude and independent endpoint latitude shifts of -0.25/0/+0.25 degrees: 81 editorial scenarios, not empirical uncertainty.\",\r\n  \"map_view_box\": [\r\n    625,\r\n    145,\r\n    115,\r\n    100\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"56 N ridge gate\",\r\n    \"65 N bifurcation approach\"\r\n  ],\r\n  \"figure_source_label\": \"Vage (2011); Fried (2026)\",\r\n  \"route_extent_kind\": \"Irminger northward ridge-flank branch\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://os.copernicus.org/articles/22/1763/2026/\",\r\n      \"citation\": \"Fried et al. (2026), On the fate of the Irminger Current water and its impact on the convection region in the Irminger Sea - a Lagrangian model study, Ocean Science 22, 1763, doi:10.5194/os-22-1763-2026.\",\r\n      \"locator\": \"Section 1: western ridge-flank current, North Icelandic branch, Greenland return and interior Irminger Gyre distinction.\",\r\n      \"role\": \"Regional topology and two-core context only; particle tracks and model percentages not used as OSW lengths.\"\r\n    }\r\n  ],\r\n  \"input_sha256\": \"278958937cd380e7d1c56a1c689d4adebe0e6292337300303c86d791b762784a\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW edito
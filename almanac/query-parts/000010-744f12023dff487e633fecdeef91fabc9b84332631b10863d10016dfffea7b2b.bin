osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Declared 17 N to 20 N offshore Mauritanian summer surface reference reach south of Cap Blanc (21 N). OSW selects both regional truncation gates and offshore vertices. Excludes bank circulation, Canary equatorward upwelling jet and the subsurface winter continuation toward Cape Bojador; not complete current endpoints.\",\r\n  \"layer\": \"Summer surface poleward circulation geography; no fixed-depth velocity axis or physical width extracted.\",\r\n  \"time_convention\": \"Source summer surface-flow convention south of Cap Blanc, without an explicit month window in this passage. Winter flow is subsurface; no winter surface counterpart or annual geometry is asserted.\",\r\n  \"source_url\": \"https://ocg.aori.u-tokyo.ac.jp/member/eoka/documents/Tomczak_Godfrey.pdf\",\r\n  \"source_locator\": \"Chapter 14, printed pp249-250 / PDF259-260: poleward surface flow south of Cap Blanc during summer; winter subsurface continuation is separate. Chapter version 1.2 September 2002. Cited pages visually inspected.\",\r\n  \"source_citation\": \"Tomczak, M. and J.S. Godfrey, Regional Oceanography: An Introduction (1994), university-hosted online compilation, chapter versions stated separately.\",\r\n  \"source_license\": \"No redistribution license established; original retained locally and ignored. Paraphrased factual annotations and independent OSW vertices only; no original image or curve copied.\",\r\n  \"source_retrieved_date\": \"2026-10-09\",\r\n  \"coordinate_selection\": \"OSW selects offshore regional gates and rounded vertices within the described geography. Alternative shapes shift intermediate latitudes by +/- 0.2 degree; longitude and independent endpoint-latitude shifts test drawing convention. These choices are not measured current boundaries, physical uncertainty or seasonal extrema.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -17.8,\r\n      17\r\n    ],\r\n    [\r\n      -17.8,\r\n      18\r\n    ],\r\n    [\r\n      -17.8,\r\n      19\r\n    ],\r\n    [\r\n      -17.7,\r\n      20\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"southern_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -17.8,\r\n          17\r\n        ],\r\n        [\r\n          -17.8,\r\n          17.8\r\n        ],\r\n        [\r\n          -17.8,\r\n          18.8\r\n        ],\r\n        [\r\n          -17.7,\r\n          20\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Alternative editorial shape between selected regional gates, not an observed axis or seasonal state.\"\r\n    },\r\n    {\r\n      \"id\": \"northern_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -17.8,\r\n          17\r\n        ],\r\n        [\r\n          -17.8,\r\n          18.2\r\n        ],\r\n        [\r\n          -17.8,\r\n          19.2\r\n        ],\r\n        [\r\n          -17.7,\r\n          20\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Alternative editorial shape between selected regional gates, not an observed axis or seasonal state.\"\r\n    }\r\n  ],\r\n  \"longitude_offsets_degrees\": [\r\n    -0.1,\r\n    0,\r\n    0.1\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.2,\r\n    0,\r\n    0.2\r\n  ],\r\n  \"scenario_rule\": \"Three declared shapes crossed with three uniform longitude shifts and independent three-value endpoint latitude shifts: 81 retained editorial scenarios, not confidence limits or seasonal ranges.\",\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_studied_reach_routes\",\r\n  \"whole_system_length\": false,\r\n  \"remaining_gates\": [\r\n    \"Independently review identity, layer, selected gates and fine coastline/bathymetry before physical admission.\",\r\n    \"Acquire dated velocity or suitable physical geometry before measuring a current axis or meander length.\",\r\n    \"Whole-current length, physical width and annual ranges remain unresolved.\",\r\n    \"No seasonal playback, occupied polygon, physical state containment or NASA current identity inferred.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    708,\r\n    351,\r\n    65,\r\n    62\r\n  ],\r\n  \"map_label_size\": 0.9,\r\n  \"legend_line_spacing\": 1.4400000000000002,\r\n  \"map_symbol_scale\": 0.3,\r\n  \"endpoint_labels\": [\r\n    \"[-17.8, 17] OSW gate\",\r\n    \"[-17.7, 20] OSW gate\"\r\n  ],\r\n  \"figure_source_label\": \"Tomczak and Godfrey, ch14 pp249-250\",\r\n  \"route_extent_kind\": \"Mauritanian summer surface reference reach\",\r\n  \"source_review_receipt\": {\r\n    \"source_document_file\": \"research/source-data/tomczak-regional-2005/journal-article.pdf\",\r\n    \"source_document_sha256\": \"35e36f9b834c9c31c2cee64abc36d0c687d71e3d388c2cf1c40bc026e613738b\",\r\n    \"acquisition_file\": \"research/source-data/tomczak-regional-2005/acquisition.json\",\r\n    \"acquisition_sha256\": \"c5e0760c94b3ce30765f09f09eeb5943c6553db78bf210b5d0fc3dce7f353664\",\r\n    \"audit_file\": \"research/mauritanian-summer-reach-scope-audit.json\",\r\n    \"audit_sha256\": \"bb4021db99fcb5695194b143c343cad6407618f8a7a5fbb11e3fc4ec30525261\"\r\n  },\r\n  \"input_sha256\": \"61ee3cc34b92bddaf44969e552429b397abc60f21e1d32dc7b14ffa23aed42ba\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 332.556,\r\n  \"reported_approximate_reference_path_km\": 300,\r\n  \"scenario_range_km\": [\r\n    288.282,\r\n    376.829\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    200,\r\n    400\r\n  ],\r\n  \"scenario_count\": 81,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_vari
 geography paraphrased with attribution; no source figures, model fields or particle tracks packaged.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.15,\r\n    0,\r\n    0.15\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.15,\r\n    0,\r\n    0.15\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-03\",\r\n  \"map_label_size\": 1.6,\r\n  \"legend_line_spacing\": 2.8,\r\n  \"map_symbol_scale\": 0.6,\r\n  \"remaining_gates\": [\r\n    \"Scientific review of naming limits, layer and regional gate conventions.\",\r\n    \"Verify bathymetric and velocity correspondence; coarse land clearance does not establish a current axis.\",\r\n    \"Canonical admission and publication review; retain regional scope and editorial provenance.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"hiri-current\",\r\n  \"name\": \"Hiri Current\",\r\n  \"scope\": \"Broad Hiri naming convention: northward Australian boundary branch from an OSW 15 S bifurcation approach, clockwise around the Gulf of Papua entrance, to an OSW eastern Louisiade approach. Excludes closed gyre return circuits, direct mid-basin Solomon inflow, EAC, downstream New Guinea currents and eddy excursions. Narrower literature uses Hiri only south of PNG and proposes Gulf of Papua Current for the connected boundary system; no alias merge or complete system extent admitted.\",\r\n  \"layer\": \"Upper-ocean regional geography; no fixed-depth current core or vertically integrated streamline reconstructed. Source northern bifurcation descriptions have different depth support.\",\r\n  \"time_convention\": \"Regional naming convention drawing on 2018 modeled context and 1993 circulation descriptions; not one simultaneous dated field, an annual mean route or seasonal length measurement.\",\r\n  \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2017JC013221\",\r\n  \"source_locator\": \"Section 1 and section 3.1.5: northward branch initiated near 15 S, clockwise Gulf of Papua circulation and depth dependence. Figure 1 separates upper 0-300 m and deeper modeled flows.\",\r\n  \"source_citation\": \"Wijeratne et al. (2018), Estimates of Surface and Subsurface Boundary Current Transport Around Australia, Journal of Geophysical Research: Oceans 123, 3444-3466, doi:10.1029/2017JC013221.\",\r\n  \"coordinate_selection\": \"OSW selects all offshore vertices and the eastern Louisiade gate. Nominal start near 15 S follows Wijeratne; alternative 18 S start follows the broader Oliver and Holbrook regional description. These are source-specific geographic conventions, not equivalent-depth observations or statistical endpoints. The route does not trace a source gyre or transit track.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      146.5,\r\n      -15\r\n    ],\r\n    [\r\n      144.5,\r\n      -13\r\n    ],\r\n    [\r\n      143.5,\r\n      -11\r\n    ],\r\n    [\r\n      143.8,\r\n      -10\r\n    ],\r\n    [\r\n      145,\r\n      -9.8\r\n    ],\r\n    [\r\n      147,\r\n      -10.4\r\n    ],\r\n    [\r\n      149,\r\n      -11.2\r\n    ],\r\n    [\r\n      152,\r\n      -12\r\n    ],\r\n    [\r\n      154,\r\n      -12\r\n    ],\r\n    [\r\n      155,\r\n      -11.5\r\n    ]\r\n  ],\r\n  \"scenario_rule\": \"Two source-specific origin conventions crossed with longitude and independent endpoint latitude offsets: 54 editorial scenarios, not statistical uncertainty.\",\r\n  \"map_view_box\": [\r\n    1345,\r\n    435,\r\n    135,\r\n    125\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"15 S branch approach\",\r\n    \"Louisiade approach\"\r\n  ],\r\n  \"figure_source_label\": \"Wijeratne (2018); Burrage (1993)\",\r\n  \"route_extent_kind\": \"broad Hiri regional route\",\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"broader_southern_origin\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          149,\r\n          -18\r\n        ],\r\n        [\r\n          148,\r\n          -16\r\n        ],\r\n        [\r\n          146.5,\r\n          -15\r\n        ],\r\n        [\r\n          144.5,\r\n          -13\r\n        ],\r\n        [\r\n          143.5,\r\n          -11\r\n        ],\r\n        [\r\n          143.8,\r\n          -10\r\n        ],\r\n        [\r\n          145,\r\n          -9.8\r\n        ],\r\n        [\r\n          147,\r\n          -10.4\r\n        ],\r\n        [\r\n          149,\r\n          -11.2\r\n        ],\r\n        [\r\n          152,\r\n          -12\r\n        ],\r\n        [\r\n          154,\r\n          -12\r\n        ],\r\n        [\r\n          155,\r\n          -11.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Broader 18 S regional origin convention; no inference of one fixed layer or seasonal transition.\"\r\n    }\r\n  ],\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://absa.asn.au/wp-content/uploads/2021/08/Cor-Vol-17-Pg135-145_CoralSeaCurrents.pdf\",\r\n      \"citation\": \"Burrage (1993), Coral Sea Currents, Corella 17(5), 135-145.\",\r\n      \"locator\": \"Introduction, printed pp. 136-137: northward branch around Gulf entrance, exit around Louisiades and broad Hiri naming.\",\r\n      \"role\": \"Regional path topology only; hydrographic figures not digitized.\"\r\n    },\r\n    {\r\n      \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1002/2013JC009591\",\r\n      \"citation\": \"Oliver and Holbrook (2014), Extending our understanding of South Pacific gyre spin-up: Modeling the East Australian Current in a future climate, doi:10.1002/2013JC009591.\",\r\n      \"locator\": \"Section 3: regional SEC bifurcation near 18 S and northward Hiri naming.\",\r\n      \"role\": \"Alternative regional origin convention, not a current-core track.\"\r\n    },\r\n    {\r\n      \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1002/2013JC009678\",\r\n      \"citation\": \"Ganachaud et al. (2014), The Southwest Pacific Ocean circulation and climate experiment (SPICE), doi:10.1002/2013JC009678.\",\r\n      \"locator\": \"Section 4.1: NQC, GBRUC and Hiri south of PNG; proposed unified Gulf of Papua Current nomenclature and depth-dependent connections.\",\r\n      \"role\": \"Naming-scope caution; does not authorize canonical alias merge.\"\r\n    }\r\n  ],\r\n  \"input_sha256\": \"1ad6c77115fd98aaea403e8176511f055882d9d0a2f1db02ac6ac1e1142192f1\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 1948.64,\r\n  \"reported_approximate_reference_path_km\": 1900,\r\n  \"scenario_range_km\": [\r\n    1930.457,\r\n    2412.986\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    1900,\r\n    2500\r\n  ],\r\n  \"scenario_count\": 54,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.15,\r\n      \"start_latitude_offset_degrees\": -0.15,\r\n      \"end_latitude_offset_degrees\": -0.15,\r\n      \"start_longitude_offset_degrees\": 0,\r\n      \"end_longitude_offset_degrees\": 0,\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          146.35,\r\n          -15.15\r\n        ],\r\n        [\r\n          144.35,\r\n          -13\r\n        ],\r\n        [\r\n          143.35,\r\n          -11\r\n        ],\r\n        [\r\n          143.65,\r\n          -10\r\n        ],\r\n        [\r\n          144.85,\r\n          -9.8\r\n        ],\r\n        [\r\n          146.85,\r\n          -10.4\r\n        ],\r\n        [\r\n          148.85,\r\n          -11.2\r\n        ],\r\
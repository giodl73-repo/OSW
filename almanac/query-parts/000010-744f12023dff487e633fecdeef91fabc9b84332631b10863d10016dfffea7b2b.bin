ion.","fixed_layer_bounds_m":null,"full_width_inference_eligible":false,"geographic_scope":"Textbook combined eastward flow south of the Alaskan Stream, from 30°N to some 200 km off the Alaskan coast; exact longitude support and paired flow boundaries unresolved.","id":"north-pacific-tomczak-2005-broad-flow-band","is_confidence_interval":false,"layer":"No fixed depth layer for the broad North Pacific band; adjacent Alaskan Stream upper-kilometer transport context is separate.","measurement_type":"published_regional_summary","name":"North Pacific Current","observed_period":null,"original_regional_context":{"adjacent_stream_context":{"identity":"alaskan-stream","is_north_pacific_width_support":false,"reported_width_span_km":[150,200],"source_citation":"Royer and Emery (1987), cited by textbook; original not acquired in this batch.","transport_layer_context_m":[0,1000]},"adjacent_stream_span_is_north_pacific_width":false,"adjacent_stream_transport_layer_is_width_layer":false,"alternative_43N_split_is_velocity_boundary":false,"audit_file":"research/north-pacific-tomczak-2005-broad-band-scope-audit.json","audit_sha256":"09ec3af553122962de08298c120113149d1c822857cd80fb3381fcc15c9e235a","cross_current_width_inheritance_eligible":false,"description_kind":"broad-combined-eastward-flow-band","display_aria_label":"North Pacific Current: source reports a broad combined eastward flow band more than 2000 kilometres wide. Textbook synthesis using a broad combined definition; representative width, paired boundaries, layer, observation dates and numerical uncertainty unknown. No finite or seasonal width range.","display_caption":"More than 2000 km · broad combined eastward flow band in the textbook’s North Pacific definition. Representative width and numerical uncertainty unknown; no selected 2000 km point, finite interval or annual range.","display_constraint_label":"Broad eastward flow band","display_method_note":"Original PDF p135 inspected, chapter page version March 2005. The source combines Kuroshio/Oyashio continuations and discusses an alternative North Pacific/Subarctic split. Adjacent Alaskan Stream 150–200 km and upper-kilometer transport layer are separate; no width boundaries or seasonal calendar extracted.","display_title":"Reported broad flow band","front_latitudes_are_width_edges":false,"full_book_reviewed":false,"map_buffer_eligible":false,"more_than_scale_is_representative_width":false,"more_than_scale_is_rigorous_bound":false,"naming_context":{"alaskan_stream_is_aleutian_alias":false,"alternative_definition":"Some authors split North Pacific south of about 43°N and Pacific Subarctic Current north of it. Source questions persistence of this separation across basin.","canonical_names_changed":false,"canonical_subarctic_current_id":"aleutian","combined_breadth_transfer_to_subarctic_eligible":false,"naming_audit_file":"research/aleutian-alaskan-stream-naming-scope-audit.json","naming_audit_sha256":"cba7e2ef24c3503ce5f9df057f84721001633db4c9c4d3095a0e9acac052c1fa","source_definition":"Combined eastward flow south of Alaska; Kuroshio and Oyashio continuations treated as the same broad current."},"nearby_SST_image_date_is_width_date":false,"page_version":"1.1 March 2005","paired_width_boundaries_extracted":false,"preface_history_version":"1.2 September 2002","publication_version_is_observation_date":false,"schematic_map_digitized":false,"schematic_projection_is_measurement_support":false,"seasonal_calendar_extracted":false,"source_band_is_flow_normal_transect":false,"underlying_width_methods_reviewed":false,"width_passage_visually_inspected":true},"phase_kind":"regional_summary","phase_label":"Broad combined eastward flow band","range_interpretation":"Reported more-than scale for a broadly defined eastward flow band; not a 2000 km point, rigorous lower bound, finite interval, uncertainty or seasonal range.","range_kind":"author_reported_greater_than_broad_flow_band","remaining_gates":["Recover the breadth method, observation period, layer and paired velocity boundaries.","Resolve compatibility of the source combined-flow definition with narrower North Pacific/Subarctic naming conventions.","Independent scientific admission; no ranked or seasonal dimension, buffer or physical state intersection."],"reported_width_constraint":{"is_rigorous_lower_bound":false,"kind":"author_reported_greater_than_broad_flow_band","lower_bound_km":null,"reference_scale_km":2000,"representative_width_km":null,"source_notation":"more than 2000 km","upper_bound_km":null},"seasonal_playback_eligible":false,"section_geometry":null,"section_orientation":"Broad geographic band description; no resolved cross-flow transect or paired velocity edges.","source_citation":"Tomczak, M. and J. S. Godfrey, Regional Oceanography: An Introduction, chapter 8 The Pacific Ocean, printed p125 / PDF p135, page version 1.1 March 2005; original 1994 Pergamon edition, university-hosted online compilation.","source_evidence_kind":"textbook_original_broad_combined_flow_synthesis","source_locator":"Printed p125 / PDF p135, paragraph beginning No transport estimates, North Pacific passage and alternative Subarctic split discussion; adjacent pp124–126 / PDF pp134–136. PDF pp2,7–9 version/preface/authorship.","source_quality_note":"Original textbook page reviewed; underlying breadth measurement/calculation unresolved. Broad combined definition differs from schemes separating North Pacific and Pacific Subarctic currents. Source page is March 2005, not a modern observed-width series.","source_retrieved_date":"2026-10-09","source_url":"https://ocg.aori.u-tokyo.ac.jp/member/eoka/documents/Tomczak_Godfrey.pdf","status":"editorial_source_extraction_not_canonical","time_convention":"Chapter 8 page version March 2005; no observation dates or width climatology assigned. Preface/version-history September 2002 and first edition 1994 are separate publication context.","uncertainty_km":null,"whole_current_representative":false,"width_metric":"author_reported_
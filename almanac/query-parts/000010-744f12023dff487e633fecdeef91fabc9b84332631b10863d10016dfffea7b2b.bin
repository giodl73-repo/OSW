    {\r\n      \"tile_id\": \"level0_B_1\",\r\n      \"url\": \"https://svs.gsfc.nasa.gov/vis/a000000/a005500/a005505/perpetual_ocean2_EQUIREC_071_final_beauty_level0_B_1.mp4\",\r\n      \"source_id\": \"source:d4e82da0872ed45c\",\r\n      \"zoom\": 0,\r\n      \"nominal_display_route_fraction\": 1.0,\r\n      \"scenario_display_route_fraction_range\": [\r\n        1.0,\r\n        1.0\r\n      ],\r\n      \"complete_display_route_in_all_scenarios\": true,\r\n      \"interpretation\": \"Editorial reference-route/crop display overlap only; not physical current identification or dated event matching. Fraction measures equirectangular display line, not physical kilometres.\"\r\n    }\r\n  ],\r\n  \"nasa_tiles_sha256\": \"52c6605c32e59f50aa4abde984489c7055c0e3e201e7323e30160a623c9666e0\",\r\n  \"recommended_nasa_tile_id\": \"level2_C_2\",\r\n  \"nasa_crop_recommendation_rule\": \"Highest zoom crop covering the entire display route in every retained scenario, with tile ID as deterministic tie-break. No physical identification asserted.\",\r\n  \"input_file\": \"research/balearic-reference-path-input.json\",\r\n  \"figure\": \"figures/balearic-reference-path-candidate.svg\"\r\n}\r\n","source_sha256":"52d27b7b19c49942626d49973358c7f2d5f428b310d85b9a03dd7ced1c464299"},"research/benguela-reference-path-candidate.json":{"source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"benguela\",\r\n  \"name\": \"Benguela Current\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Specified northward shelf-edge Benguela regional reference branch from an offshore Cape Agulhas regional gate to the nominal 15 degrees S Angola–Benguela front region. Excludes broad offshore Benguela extensions, Agulhas ring paths, southward undercurrent and the entire upwelling-ecosystem perimeter. Gate coordinates are OSW regional approximations; no continuous measured shelf-edge axis is inferred.\",\r\n  \"layer\": \"Northward shelf-edge branch reference geography; no fixed velocity layer diagnosed. Distinct from offshore/underlying circulation.\",\r\n  \"time_convention\": \"General editorial reference sketch; combines regional source descriptions, not a simultaneous 1997 or decadal inverse-model current axis.\",\r\n  \"source_url\": \"https://os.copernicus.org/articles/19/1009/2023/\",\r\n  \"source_locator\": \"Section 3.1.3: eastern boundary Benguela system and Cape Agulhas region; distinguish sampled sections from whole-path geography. Shelf-edge northern convention uses Lass et al. (2000), Introduction: cold northward shelf-edge current and Angola–Benguela confluence near 15 degrees S; observed front at 16.5 degrees S in the April–May 1997 survey.\",\r\n  \"source_citation\": \"Caínzos et al. (2023), Consistent picture of the horizontal circulation of the Atlantic Ocean over 3 decades, Ocean Science 19, 1009–1045.\",\r\n  \"source_license\": \"Factual geographic references only; no source prose, figures, provider geometry or model data packaged.\",\r\n  \"coordinate_selection\": \"OSW selects coarse regional offshore waypoints. Sources define flow identity and broad endpoint geography, not these intermediate vertices or longitudes. The path is not a digitized source curve, observed axis, bathymetric contour or diagnosed velocity field.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      19,\r\n      -35.5\r\n    ],\r\n    [\r\n      17,\r\n      -34\r\n    ],\r\n    [\r\n      15,\r\n      -31\r\n    ],\r\n    [\r\n      13,\r\n      -27\r\n    ],\r\n    [\r\n      11.5,\r\n      -23\r\n    ],\r\n    [\r\n      11,\r\n      -19\r\n    ],\r\n    [\r\n      11,\r\n      -15\r\n    ]\r\n  ],\r\n  \"scenario_rule\": \"Three uniform longitude shifts (-0.25/0/+0.25 degrees) crossed with independent endpoint latitude shifts (-0.5/0/+0.5 degrees): 54 editorial scenarios across two northern-gate conventions. No empirical positional error implied. The 1997 observed front at 16.5 degrees S is retained as a separate source-specific alternative route rather than treated as the universal front location.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.5,\r\n    0,\r\n    0.5\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"remaining_gates\": [\r\n    \"Independent review of source-specific start/end conventions, branches and seasonal endpoint alternatives.\",\r\n    \"Check offshore waypoints against reproducible shelf/slope or velocity geometry at suitable resolution.\",\r\n    \"Canonical claim, geometry and measurement integration before public admission.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    780,\r\n    465,\r\n    140,\r\n    175\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"Offshore Cape Agulhas gate\",\r\n    \"15°S nominal front gate\"\r\n  ],\r\n  \"figure_source_label\": \"Caínzos et al. (2023); Lass et al. (2000)\",\r\n  \"route_extent_kind\": \"shelf-edge branch reference route\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://journals.ametsoc.org/abstract/journals/phoc/30/10/1520-0485_2000_030_2589_hacmit_2.0.co_2.xml\",\r\n      \"citation\": \"Lass, Schmidt, Mohrholz and Nausch (2000), Hydrographic and Current Measurements in the Area of the Angola–Benguela Front, Journal of Physical Oceanography 30, 2589–2609.\",\r\n      \"locator\": \"Introduction (northward shelf-edge flow and confluence near 15 degrees S); abstract (front observed at 16.5 degrees S during April–May 1997).\",\r\n      \"role\": \"Source-specific northern branch/front convention; not an entire-current survey.\"\r\n    }\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"front_1997_latitude_convention\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          19,\r\n          -35.5\r\n        ],\r\n        [\r\n          17,\r\n          -34\r\n        ],\r\n        [\r\n          15,\r\n          -31\r\n        ],\r\n        [\r\n          13,\r\n          -27\r\n        ],\r\n        [\r\n          11.5,\r\n          -23\r\n        ],\r\n        [\r\n          11,\r\n          -19\r\n        ],\r\n        [\r\n          11,\r\n          -16.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Alternative northern gate using the source’s April–May 1997 front latitude; this sketch is not an observed 1997 whole-current path.\"\r\n    }\r\n  ],\r\n  \"input_sha256\": \"286f43bb02a975bbe02f68b12df22e30033f2d970133644186e39a1609dedff7\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 2470.589,\r\n  \"reported_approximate_reference_path_km\": 2500,\r\n  \"scenario_range_km\": [\r\n    2216.414,\r\n    2565.809\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    2200,\r\n    2600\r\n  ],\r\n  \"scenario_count\": 54,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.25,\r\n      \"start_latitude_offset_degrees\": -0.5,\r\n      \"end_latitude_offset_degrees\": -0.5,\r\n      \"start_longitude_offset_degrees\": 0,\r\n      \"end_longitude_offset_degrees\": 0,\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          18.75,\r\n          -36.0\r\n        ],\r\n        [\r\n          16.75,\r\n          -34\r\n        ],\r\n        [\r\n          14.75,\r\n          -31\r\n        ],\r\n        [\r\n        
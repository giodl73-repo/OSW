8–20 degrees E and eastward return-current distinction; broader/early retroflections discussed separately.\",\r\n  \"source_citation\": \"Russo, Veitch, Carr, Fearon and Whittle (2022), An Intercomparison of Global Reanalysis Products for Southern Africa’s Major Oceanographic Features, Frontiers in Marine Science 9, 837906.\",\r\n  \"source_license\": \"Factual geographic references only; no source prose, figure, provider geometry or model field packaged.\",\r\n  \"coordinate_selection\": \"OSW selects offshore regional waypoints and a nominal 19 degrees E turning gate. The source supports regional extent and flow identity, not these coordinates, a continuous measured axis, shelf contour or a unique current termination.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      33.5,\r\n      -27\r\n    ],\r\n    [\r\n      32,\r\n      -30\r\n    ],\r\n    [\r\n      29,\r\n      -33\r\n    ],\r\n    [\r\n      26,\r\n      -35\r\n    ],\r\n    [\r\n      23,\r\n      -37\r\n    ],\r\n    [\r\n      19,\r\n      -40\r\n    ]\r\n  ],\r\n  \"scenario_rule\": \"Three uniform longitude shifts (-0.25/0/+0.25 degrees), three independent endpoint latitude shifts (-0.5/0/+0.5 degrees) and three turning-gate longitude shifts (-1/0/+1 degrees): 81 assumption scenarios. These do not span every early retroflection or supply an empirical uncertainty distribution.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.5,\r\n    0,\r\n    0.5\r\n  ],\r\n  \"end_longitude_offsets_degrees\": [\r\n    -1,\r\n    0,\r\n    1\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"remaining_gates\": [\r\n    \"Independent review of regional extent versus coastal-jet naming and the retroflection/return handoff.\",\r\n    \"Validate offshore waypoints against reproducible bathymetric or velocity geometry; extend endpoint scenarios if warranted.\",\r\n    \"Canonical geometry/measurement integration and publication review before admission.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    805,\r\n    540,\r\n    145,\r\n    145\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"27°S regional gate\",\r\n    \"40°S turning gate\"\r\n  ],\r\n  \"figure_source_label\": \"Russo et al. (2022)\",\r\n  \"route_extent_kind\": \"regional extent to retroflection\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"input_sha256\": \"e7e372a3cfc9ff827f4dd6a7557dada35afd2f03ea242293bdcbf3e9928add3b\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 1988.494,\r\n  \"reported_approximate_reference_path_km\": 2000,\r\n  \"scenario_range_km\": [\r\n    1838.223,\r\n    2140.464\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    1800,\r\n    2200\r\n  ],\r\n  \"scenario_count\": 81,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.25,\r\n      \"start_latitude_offset_degrees\": -0.5,\r\n      \"end_latitude_offset_degrees\": -0.5,\r\n      \"start_longitude_offset_degrees\": 0,\r\n      \"end_longitude_offset_degrees\": -1,\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          33.25,\r\n          -27.5\r\n        ],\r\n        [\r\n          31.75,\r\n          -30\r\n        ],\r\n        [\r\n          28.75,\r\n          -33\r\n        ],\r\n        [\r\n          25.75,\r\n          -35\r\n        ],\r\n        [\r\n          22.75,\r\n          -37\r\n        ],\r\n        [\r\n          17.75,\r\n          -40.5\r\n        ]\r\n      ],\r\n      
se\": \"Source regional geography paraphrased with attribution; no source figures, curves or velocity data packaged.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.1,\r\n    0,\r\n    0.1\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.1,\r\n    0,\r\n    0.1\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"map_label_size\": 1,\r\n  \"legend_line_spacing\": 1.8,\r\n  \"map_symbol_scale\": 0.4,\r\n  \"remaining_gates\": [\r\n    \"Scientific review of named-flow gates and regional scope.\",\r\n    \"Verify shelf/slope correspondence with reproducible bathymetry or suitable velocity data.\",\r\n    \"Canonical admission and publication review; these are editorial route lengths.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"northern-mediterranean\",\r\n  \"name\": \"Northern Current\",\r\n  \"scope\": \"Regional Ligurian-to-Catalan Northern Current reference route ending at an OSW gate near the source-described 40.6 N bifurcation, with an earlier Catalan termination alternative. Excludes the Corsica feeder currents, downstream Ibiza and Balearic branches and offshore eddies. Exact gates and vertices are OSW choices; not the full western Mediterranean circulation.\",\r\n  \"layer\": \"Upper-limb regional reference geography; no fixed-depth or velocity-derived current axis.\",\r\n  \"time_convention\": \"Regional naming convention from source introductions; not the two-week December 2011 Toulon survey trajectory or a simultaneous whole-route observation.\",\r\n  \"source_url\": \"https://os.copernicus.org/articles/14/689/2018/\",\r\n  \"source_locator\": \"Berta et al. (2018), section 1: formation in the Ligurian Sea, southwestward continental-slope flow recognizable as far as the Catalan Sea. Aguiar et al. (2022), section 2.1: Iberian-slope continuation and bifurcation near 40.6 N.\",\r\n  \"source_citation\": \"Berta et al. (2018), Wind-induced variability in the Northern Current (northwestern Mediterranean Sea) as depicted by a multi-platform observing system, Ocean Science 14, 689-710, doi:10.5194/os-14-689-2018.\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2021JC017589\",\r\n      \"citation\": \"Aguiar et al. (2022), Strong Long-Lived Anticyclonic Mesoscale Eddies in the Balearic Sea: Formation, Intensification, and Thermal Impact, doi:10.1029/2021JC017589.\",\r\n      \"locator\": \"Section 2.1, Study Area: Northern Current splits near 40.6 N; one branch continues through Ibiza Channel, another contributes to Balearic Current.\"\r\n    }\r\n  ],\r\n  \"coordinate_selection\": \"OSW coarse offshore vertices represent the source-described regional sequence. Sources do not publish these coordinates as a full current axis or fix the exact Ligurian naming boundary. The Catalan terminal gates test naming extent, not cessation of all flow. Offshore waypoints are coarse display approximations; fine coastal and shelf-break correspondence remains unresolved.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      9.2,\r\n      43.5\r\n    ],\r\n    [\r\n      8,\r\n      43.3\r\n    ],\r\n    [\r\n      7,\r\n      43.1\r\n    ],\r\n    [\r\n      6,\r\n      42.8\r\n    ],\r\n    [\r\n      4.5,\r\n      42.7\r\n    ],\r\n    [\r\n      3.5,\r\n      42\r\n    ],\r\n    [\r\n      2.3,\r\n      41.2\r\n    ],\r\n    [\r\n      1.5,\r\n      40.6\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"earlier_catalan_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          9.2,\r\n          43.5\r\n        ],\r\n        [\r\n          8,\r\n          43.3\r\n        ],\r\n        [\r\n          7,\r\n          43.1\r\n        ],\r\n        [\r\n          6,\r\n          42.8\r\n        ],\r\n        [\r\n          4.5,\r\n          42.7\r\n        ],\r\n        [\r\n          3.5,\r\n          42\r\n        ],\r\n        [\r\n          2.5,\r\n          41.3\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Earlier OSW Catalan regional terminal gate; tests the breadth of the source regional nomenclature.\"\r\n    }\r\n  ],\r\n  \"scenario_rule\": \"Two terminal conventions crossed with three whole-route longitude offsets and independent start/end latitude offsets of -0.1/0/+0.1 degrees: 54 editorial scenarios; not empirical uncertainty.\",\r\n  \"map_view_box\": [\r\n    790,\r\n    254,\r\n    65,\r\n    65\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"Ligurian gate\",\r\n    \"Catalan split gate\"\r\n  ],\r\n  \"figure_source_label\": \"Berta (2018); Aguiar (2022)\",\r\n  \"route_extent_kind\": \"Ligurian-Catalan regional route\",\r\n  \"input_sha256\": \"b3e536840b99955992a2178af46108b8a9ef8ed7b7d036944e6b171af641cd7a\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 737.302,\r\n  \"reported_approximate_reference_path_km\": 700,\r\n  \"scenario_range_km\": [\r\n    613.553,\r\n    748.418\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    600,\r\n    800\r\n  ],\r\n  \"scenario_count\": 54,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.1,\r\n      \"start_latitude_offset_degrees\": -0.1,\r\n      \"end_latitude_offset_degrees\": -0.1,\r\n      \"start_longitude_offset_degrees\": 0,\r\n      \"end_longitude_offset_degrees\": 0,\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          9.1,\r\n          43.4\r\n        ],\r\n   
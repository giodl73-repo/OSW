\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-03\",\r\n  \"map_label_size\": 1.4,\r\n  \"legend_line_spacing\": 2.8,\r\n  \"map_symbol_scale\": 0.5,\r\n  \"remaining_gates\": [\r\n    \"Review source observational basis, current boundaries and historical applicability.\",\r\n    \"Validate coastal vertices and named-flow gates using bathymetry and suitable winter velocity fields.\",\r\n    \"No conditional Vancouver Island extension or deeper California Undercurrent merger.\",\r\n    \"Canonical admission and publication review; this is an editorial regional route length.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"davidson\",\r\n  \"name\": \"Davidson Current\",\r\n  \"scope\": \"California-Oregon winter coastal reference corridor between OSW gates at 35 N and 46 N. These are bookkeeping gates, not source-published current endpoints. Excludes conditional Vancouver Island penetration and the deeper California Undercurrent. No full-system length or width footprint.\",\r\n  \"layer\": \"Seasonal northward surface-current regional context; not the separately described California Undercurrent below 200 m or a reconstructed velocity axis.\",\r\n  \"time_convention\": \"October-March California-Oregon regional seasonal description in the February 1978 report; strongest flow described in January. Historical summary, not a dated trajectory, current-year observation or modern monthly climatology.\",\r\n  \"source_url\": \"https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/40591190_v2.pdf\",\r\n  \"source_locator\": \"Appendix II section II.1, printed II-1 to II-2 / PDF pages 12-13: northward seasonal surface strip along California and Oregon from October to March; Vancouver Island penetration is conditional.\",\r\n  \"source_citation\": \"Fisheries and Environment Canada, Working Group on West Coast Deepwater Oil Ports (1978), Potential Pacific Coast Oil Ports: A Comparative Environmental Risk Analysis, Volume II - Supplementary Appendices, February 1978.\",\r\n  \"supporting_sources\": [],\r\n  \"coordinate_selection\": \"OSW selects all coastal-offshore vertices and regional gates at 35 N and 46 N. Source supplies California-Oregon scope, northward surface flow and October-March season but no coordinate axis, exact origin/termination or measured length. Alternative 34 N/45.5 N gates test regional endpoint convention. Source approximate 64 km width is separate regional context, never a route buffer; 25/50 km off Tofino are station offsets. No source figure digitized.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -121.1,\r\n      35\r\n    ],\r\n    [\r\n      -122.55,\r\n      37\r\n    ],\r\n    [\r\n      -124.1,\r\n      39\r\n    ],\r\n    [\r\n      -124.65,\r\n      41\r\n    ],\r\n    [\r\n      -124.9,\r\n      43\r\n    ],\r\n    [\r\n      -124.9,\r\n      45\r\n    ],\r\n    [\r\n      -124.6,\r\n      46\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"southern_california_approach_shorter_oregon_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -120.2,\r\n          34\r\n        ],\r\n        [\r\n          -121.1,\r\n          35\r\n        ],\r\n        [\r\n          -122.55,\r\n          37\r\n        ],\r\n        [\r\n          -124.1,\r\n          39\r\n        ],\r\n        [\r\n          -124.65,\r\n          41\r\n        ],\r\n        [\r\n          -124.9,\r\n          43\r\n        ],\r\n        [\r\n          -124.9,\r\n          45\r\n        ],\r\n        [\r\n          -124.75,\r\n          45.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Alternative OSW California approach and northern Oregon gate; neither is a measured current boundary.\"\r\n    }\r\n  ],\r\n  \"scenario_rule\": \"Two regional gate conventions crossed with longitude and independent endpoint latitude offsets -0.05/0/+0.05 degrees: 54 editorial scenarios, not seasonal variation or observed endpoint/width uncertainty.\",\r\n  \"map_view_box\": [\r\n    240,\r\n    244,\r\n    115,\r\n    90\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"OSW California gate\",\r\n    \"OSW Oregon gate\"\r\n  ],\r\n  \"figure_source_label\": \"Fisheries and Environment Canada (1978)\",\r\n  \"route_extent_kind\": \"historical winter regional corridor\",\r\n  \"input_sha256\": \"1496927db9c17c0b882a277c7985cc555b7d52c5b7a68de177e2b6df5d1027c3\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 1303.86,\r\n  \"reported_approximate_reference_path_km\": 1300,\r\n  \"scenario_range_km\": [\r\n    1293.646,\r\n    1395.359\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    1200,\r\n    1400\r\n  ],\r\n  \"scenario_count\": 54,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.05,\r\n      \"start_latitude_offset_degrees\": -0.05,\r\n      \"end_latitude_offset_degrees\": -0.05,\r\n      \"start_longitude_offset_degrees\": 0,\r\n      \"end_longitude_offset_degrees\": 0,\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -121.14999999999999,\r\n          34.95\r\n        ],\r\n        [\r\n          -122.6,\r\n          37\r\n        ],\r\n        [\r\n          -124.14999999999999,\r\n          39\r\n        ],\r\n        [\r\n          -124.7,\r\n          41\r\n        ],\r\n        [\r\n          -124.95,\r\n          43\r\n        ],\r\n        [\r\n          -124.95,\r\n          45\r\n        ],\r\n        [\r\n          -124.64999999999999,\r\n          45.95\r\n        ]\r\n      ],\r\n      \"length_km\":
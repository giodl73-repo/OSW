59f50aa4abde984489c7055c0e3e201e7323e30160a623c9666e0\",\r\n  \"recommended_nasa_tile_id\": \"level2_D_4\",\r\n  \"nasa_crop_recommendation_rule\": \"Highest zoom crop covering the entire display route in every retained scenario, with tile ID as deterministic tie-break. No physical identification asserted.\",\r\n  \"input_file\": \"research/somali-summer-southern-reference-path-input.json\",\r\n  \"figure\": \"figures/somali-summer-southern-reference-path-candidate.svg\"\r\n}\r\n","source_sha256":"73efa37ee93f5a6985c891bb524fc2ec0d443d17807de420fc7a03a44ab5b295"},"research/somali-winter-reference-path-candidate.json":{"source_json":"{\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"source_license\": \"Factual geography paraphrased with attribution; no source prose, figures, curves or model output packaged.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.15,\r\n    0,\r\n    0.15\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"remaining_gates\": [\r\n    \"Scientific review of seasonal regional gate conventions and separation from Somali undercurrents.\",\r\n    \"Verify coastal/slope correspondence with season-appropriate bathymetric and velocity evidence.\",\r\n    \"Canonical admission and publication review; no whole-system or annual-average length inferred.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"somali\",\r\n  \"name\": \"Somali Current\",\r\n  \"scope\": \"Northeast-monsoon southward Somali coastal branch from an OSW northern gate at 7 N to an OSW confluence gate at 3 S. Source latitude ranges are 6-8 N for divergence and 2-4 S for confluence with East African Coast Current. Excludes the northward flow north of the divergence, offshore feeder, eastward continuation, undercurrents and gyre circuits. No year-round whole-current extent asserted.\",\r\n  \"layer\": \"Surface/upper-layer seasonal coastal reference geography; the source describes a shallow winter equatorial current, but no fixed-depth velocity axis is reconstructed.\",\r\n  \"time_convention\": \"Northeast winter monsoon convention; not a simultaneous dated observation or an annual-average route.\",\r\n  \"source_url\": \"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf\",\r\n  \"source_locator\": \"Section 4.2.1, printed pages 48-49 (PDF indices 47-48): southward surface flow reaches EACC confluence at 2-4 S; winter coastal divergence near 6-8 N. Section 4.2.2 distinguishes modeled coastal continuation and northern countercurrent.\",\r\n  \"source_citation\": \"Schott and McCreary (2001), The monsoon circulation of the Indian Ocean, Progress in Oceanography 51, 1-123, doi:10.1016/S0079-6611(01)00083-0.\",\r\n  \"coordinate_selection\": \"OSW chooses offshore coastal waypoints and nominal 7 N/3 S gates. Alternative endpoint combinations use the source-described 6/8 N and 2/4 S regional limits; exact longitudes are editorial. No source current-core coordinates or model streamline traced. Offshore display offsets avoid the coarse atlas land mask; this does not verify shelf-break or current-core position.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      50.2,\r\n      7\r\n    ],\r\n    [\r\n      48.9,\r\n      5\r\n    ],\r\n    [\r\n      47.2,\r\n      3\r\n    ],\r\n    [\r\n      44.7,\r\n      1\r\n    ],\r\n    [\r\n      43.4,\r\n      0\r\n    ],\r\n    [\r\n      42.2,\r\n      -1.5\r\n    ],\r\n    [\r\n      41.5,\r\n      -3\r\n    ]\r\n  ],\r\n  \"scenario_rule\": \"Three source-range winter endpoint conventions crossed with longitude and independent endpoint latitude shifts: 81 editorial scenarios, not empirical uncertainty.\",\r\n  \"map_view_box\": [\r\n    925,\r\n    370,\r\n    110,\r\n    130\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"7 N divergence gate\",\r\n    \"3 S confluence gate\"\r\n  ],\r\n  \"figure_source_label\": \"Schott & McCreary (2001)\",\r\n  \"route_extent_kind\": \"winter southward coastal branch\",\r\n  \"map_label_size\": 1.7,\r\n  \"legend_line_spacing\": 2.7,\r\n  \"map_symbol_scale\": 0.65,\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"inner_latitude_gates\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          49.6,\r\n          6\r\n        ],\r\n        [\r\n          48.9,\r\n          5\r\n        ],\r\n        [\r\n          47.2,\r\n          3\r\n        ],\r\n        [\r\n          44.7,\r\n          1\r\n        ],\r\n        [\r\n          43.4,\r\n          0\r\n        ],\r\n        [\r\n          42,\r\n          -2\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Shorter winter convention, divergence at 6 N and confluence at 2 S.\"\r\n    },\r\n    {\r\n      \"id\": \"outer_latitude_gates\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          50.6,\r\n          8\r\n        ],\r\n        [\r\n          48.9,\r\n          5\r\n        ],\r\n        [\r\n          47.2,\r\n          3\r\n        ],\r\n        [\r\n          44.7,\r\n          1\r\n        ],\r\n        [\r\n          43.4,\r\n          0\r\n        ],\r\n        [\r\n          42.2,\r\n          -1.5\r\n        ],\r\n        [\r\n          41.5,\r\n          -3\r\n        ],\r\n        [\r\n          41,\r\n          -4\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Broader winter convention, divergence at 8 N and confluence at 4 S.\"\r\n    }\r\n  ],\r\n  \"input_sha256\": \"1089dd9458efd064c5ddf087fd7ab3b5d15537eb0767d431bb9bfcf61473d48d\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693e
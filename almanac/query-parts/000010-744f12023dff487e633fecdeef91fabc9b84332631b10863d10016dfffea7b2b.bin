ermak-pass-branch\",\r\n      \"name\": \"Yermak Pass Branch\",\r\n      \"basin\": \"Fram Strait / northern Svalbard\",\r\n      \"proposed_kind\": \"named Atlantic-water current branch\",\r\n      \"identity_scope\": \"Atlantic-water route crossing Yermak Plateau and joining the Svalbard Branch north of Svalbard; not observed continuously at every time.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_branch_origin_rejoin_layer_and_time_gates\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2018JC014299\",\r\n          \"citation\": \"Menze et al. (2019), Atlantic Water Pathways Along the North-Western Svalbard Shelf Mapped Using Vessel-Mounted Current Profilers, doi:10.1029/2018JC014299.\",\r\n          \"locator\": \"Abstract, section 4.3 and Figure 6; summer 2014-2017 observational composite.\",\r\n          \"supports\": \"Explicit named pathway; composite does not establish continuous presence. No branch geometry or width extracted.\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review source-specific branch identity, aliases, layer and separation/rejoin gates.\",\r\n        \"Acquire dated or properly averaged route geometry; no parent current length borrowed.\",\r\n        \"Integrate reviewed identity, evidence, taxonomy, state joins and navigation before canonical admission.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"alaskan-stream\",\r\n      \"name\": \"Alaskan Stream\",\r\n      \"basin\": \"Subpolar North Pacific\",\r\n      \"proposed_kind\": \"westward slope boundary current\",\r\n      \"identity_scope\": \"Westward boundary flow south of Alaska and the Aleutian chain; distinct from the eastward Aleutian Current. Excludes Alaska Coastal Current and Aleutian North Slope Current.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_western_branch_and_layer_before_route_measurement\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://tidesandcurrents.noaa.gov/glossary\",\r\n          \"citation\": \"NOAA Tides and Currents Glossary, Alaskan Stream entry.\",\r\n          \"locator\": \"Alaskan Stream entry.\",\r\n          \"supports\": \"Westward flow south of the Aleutian Islands continues the Alaska Current.\",\r\n          \"source_access\": \"full_page_read_2026-10-03\"\r\n        },\r\n        {\r\n          \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1002/2016JC012302\",\r\n          \"citation\": \"Logan and Johnson (2017), Zonal evolution of Alaskan Stream structure and transport quantified with Argo data, doi:10.1002/2016JC012302.\",\r\n          \"locator\": \"Introduction opening paragraphs and Data and Methods.\",\r\n          \"supports\": \"Distinguishes the westward boundary stream and downstream splitting. The 140â€“175 W study interval is sampled coverage, not whole-current endpoints.\",\r\n          \"source_access\": \"full_page_read_2026-10-03\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review identity admission and distinguish the eastward Aleutian Current and north-slope flow.\",\r\n        \"Resolve western splitting, layer and representative time before any whole-current route or width.\",\r\n        \"Do not turn section spans, mapping-window widths or general introductory width into seasonal whole-current measurements.\",\r\n        \"Integrate reviewed identity and sources into canonical ledgers, release, taxonomy, atlas and tests.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"angola\",\r\n      \"name\": \"Angola Current\",\r\n      \"basin\": \"Southeast Atlantic\",\r\n      \"proposed_kind\": \"poleward eastern boundary current\",\r\n      \"identity_scope\": \"Mean poleward flow along the Angolan shelf and continental slope, with regional flow reversals and variable vertical structure. Distinguish the Angola Gyre, Gabon Congo Undercurrent, Benguela Coastal Current and thermal frontal zone.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_northern_feed_and_variable_southern_front_with_layer_time_support\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1002/2016JC012374\",\r\n          \"citation\": \"Kopte et al. (2017), The Angola Current: Flow and hydrographic characteristics as observed at 11 S, doi:10.1002/2016JC012374.\",\r\n          \"locator\": \"Abstract; sections 2.1, 2.4, 3.1 and 3.2; figures 4 and 5.\",\r\n          \"supports\": \"Regional moored velocities during July 2013â€“October 2015 support mean southward flow and reversals. The 15â€“90 km offshore box at 30â€“200 m is a mean-flow-based transport integration domain, not a seasonal physical width.\",\r\n          \"source_access\": \"full_page_read_2026-10-03\"\r\n        },\r\n        {\r\n          \"url\": \"https://os.copernicus.org/articles/19/121/2023/\",\r\n          \"citation\": \"Korner, Brandt and Dengler (2023), Seasonal cycle of sea surface temperature in the tropical Angolan Upwelling System, doi:10.5194/os-19-121-2023.\",\r\n          \"locator\": \"Introduction and figure 1.\",\r\n          \"supports\": \"Names the slope/shelf current and its encounter with Benguela Coastal Current. The 6 S ecosystem boundary and 15â€“18 S frontal region are contextual geography, not full-current measured endpoints.\",\r\n          \"source_access\": \"full_page_read_2026-10-03\"\r\n        },\r\n        {\r\n          \"url\": \"https://doi.pangaea.de/10.1594/PANGAEA.868684\",\r\n          \"citation\": \"Kopte et al. (2017), The Angola Current - flow and hydrographic characteristics as observed at 11 S, PANGAEA dataset publication series.\",\r\n          \"locator\": \"License, coverage and eight child datasets.\",\r\n          \"supports\": \"CC-BY-3.0 data acquisition lead for local velocity and hydrography; aggregate bounds include other cruise coverage and must not define a current footprint. No sample data acquired.\",\r\n          \"source_access\": \"metadata_page_read_2026-10-03\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review identity admission and regional aliases against current, undercurrent, gyre and frontal-zone names.\",\r\n        \"Choose a stated layer and time support before tracing northern feeding and southern termination; do not use ecosystem bounds as measured endpoints.\",\r\n        \"Diagnose cross-stream boundaries from dated velocity data; keep fixed transport integration domains separate from physical width.\",\r\n        \"Acquire and pin relevant PANGAEA child data before creating dated sections or seasonal animations.\",\r\n        \"Integrate reviewed identity, sources, taxonomy, OSW state joins and NASA navigation in a versioned inventory update.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"norwegian-atlantic\",\r\n      \"name\": \"Norwegian Atlantic Current\",\r\n      \"basin\": \"Norwegian Sea / Nordic Seas\",\r\n      \"proposed_kind\": \"Atlantic-water current system\",\r\n      \"identity_scope\": \"Source-defined Atlantic-water inflow with distinct slope and front branches; not automatically equivalent to the ambiguous Norwegian Current or the fresher Norwegian Coastal Current.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_name_branch_and_layer_before_route_measurement\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": 
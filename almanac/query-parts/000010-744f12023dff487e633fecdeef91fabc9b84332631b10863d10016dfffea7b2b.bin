_evidence_kind":"published_observational_analysis","source_locator":"Section 2 [7]; Section 3.2 [19]-[21] and Figure 7a.","source_quality_note":"Reported 0.1 m/s standard deviation describes velocity variability, not width uncertainty.","source_retrieved_date":"2026-10-03","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2001JC001007","status":"editorial_source_extraction_not_canonical","time_convention":"AMUSE ensemble; floats deployed May 1993-March 1994 and tracked up to 11 months. Launch dates are not observation end dates or an annual climatology.","whole_current_representative":false,"width_metric":"core_to_offshore_zero_crossing","width_metric_label":"one-sided core-to-offshore-edge span","width_range_km":null,"width_rank_eligible":false},{"approximate_width_km":10,"boundary_rule":"Source-reported approximately 10 km downstream flow band. Geostrophic velocity referenced to salinity minimum as level of no motion; no new universal threshold inferred.","boundary_sides":"source_reported_band","current_id":"mediterranean-undercurrent","extraction_method":"Approximate prose value transcribed with its detailed boundary definition; no figure digitized.","full_width_inference_eligible":false,"geographic_scope":"Portimao Canyon section 3 near 8.5 W; not the whole southern Portuguese slope.","id":"mediterranean-undercurrent-1993-section-band","layer":"Narrow downstream geostrophic velocity band centered about 1100 m; not every depth.","measurement_type":"published_synoptic_flow_band","name":"Mediterranean Undercurrent","observed_period":null,"phase_kind":"survey_summary","phase_label":"May 1993: Portimao section","range_interpretation":"No source-supplied width uncertainty. These different metrics and sampling supports do not establish a seasonal 10-30 km range.","remaining_gates":["Review boundary definition and regional/layer sampling.","Obtain comparable repeated observations before seasonal animation or annual range.","Canonical measurement admission and release review."],"section_geometry":null,"section_orientation":"Source hydrographic section across the slope; exact endpoints not digitized.","source_citation":"Bower, Serra and Ambar (2002), Structure of the Mediterranean Undercurrent and Mediterranean Water spreading around the southwestern Iberian Peninsula, doi:10.1029/2001JC001007.","source_evidence_kind":"published_observational_analysis","source_locator":"Section 2 [9]; Section 3.1 [16]-[18], Figure 5 caption and section 3.","source_quality_note":"A synoptic geostrophic band and an ensemble core-to-offshore-edge span use different methods and boundaries.","source_retrieved_date":"2026-10-03","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2001JC001007","status":"editorial_source_extraction_not_canonical","time_convention":"May 1993 AMUSE Oceanus hydrographic survey; exact section occupation day unavailable here. Not a spring climatology.","whole_current_representative":false,"width_metric":"geostrophic_downstream_flow_band","width_metric_label":"synoptic geostrophic flow-band width","width_range_km":null,"width_rank_eligible":false},{"approximate_width_km":64,"boundary_rule":"Author-reported approximate width; paired boundary coordinates, velocity threshold and sampling method are not specified.","calendar_months":[10,11,12,1,2,3],"calendar_source_locator":"Appendix II section II.1, printed II-2 / PDF page 13: October to March along California and Oregon coasts.","current_id":"davidson","extraction_method":"Approximate 64 km and October-March interval transcribed from full PDF prose. No figure digitized, route buffered or station distance interpreted as width.","geographic_scope":"California and Oregon coastal strip described by the 1978 report. Possible penetration into Vancouver Island waters is conditional and does not extend this width assignment.","historical_summary":true,"id":"davidson-historical-winter-width","layer":"Seasonal surface current; distinct from the separately described California Undercurrent below 200 m.","measurement_type":"published_regional_seasonal_summary","name":"Davidson Current","observed_period":null,"phase_kind":"seasonal_summary","phase_label":"October-March (1978 regional summary)","range_interpretation":"One approximate historical regional value; no numerical uncertainty, repeated seasonal widths or annual extrema supplied.","remaining_gates":["Review underlying observations, width boundaries and historical applicability.","Obtain regional repeated seasonal observations before annual variability or modern representative width.","Canonical measurement admission and release review."],"section_geometry":null,"section_orientation":"Not specified in this regional synthesis; no flow-normal section reconstructed.","source_citation":"Fisheries and Environment Canada, Working Group on West Coast Deepwater Oil Ports (1978), Potential Pacific Coast Oil Ports: A Comparative Environmental Risk Analysis, Volume II - Supplementary Appendices, February 1978.","source_document_sha256":"ea4f05cbba6f7b955ba26a93359e237dc041f6d3c2dcbb4cc6ea11ce455dd6c6","source_evidence_kind":"published_historical_regional_synthesis","source_locator":"Appendix II, section II.1, printed II-1 to II-2 (PDF pages 12-13), paragraph beginning The Davidson current; width and months on PDF page 13.","source_publication_year":1978,"source_quality_note":"Historical regional summary from 1978, not a present-day width measurement. Vancouver Island penetration is conditional; 25 and 50 km off Tofino are observation locations, not width boundaries. The separately described 50 km California Undercurrent is a different layer and current.","source_retrieved_date":"2026-10-03","source_url":"https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/40591190_v2.pdf","status":"editorial_source_extraction_not_canonical","time_convention":"October-March regional seasonal description in a February 1978 report; strongest flow described in January. Not a dated width survey, current-year observation or modern monthly climatology.","whole_current_representative":false,"width_metric":"author_reported_current_width","width_range_km":null,"width_rank_eligible":false},{"annual_extrema_eligible":false,"approximate_width_km":null,"boundary_rule":"Author-reported typical width; no paired boundary coordinates or reproducible velocity threshold supplied for the range.","calendar_months":null,"current_id":"gaspe","extraction_method":"Typical 10-20 km range transcribed from full thesis prose, with corroborating English upper-width statement. No figure digitized, midpoint manufactured or route buffered.","geographic_scope":"Gaspe Peninsula coastal jet described in thesis introductory regional synthesis; not a measured uniform width along the estuary-to-Magdalen reference corridor.","id":"gaspe-regional-typical-width-range","is_confidence_interval":false,"layer":"Upper coastal jet, described in the first approximately 40 m; range not assigned to every depth.","measurement_type":"published_regional_summary","name":"Gaspé Current","observed_period":null,"phase_kind":"regional_summary","phase_label":"Regional typical width (2022 synthesis)","range_interpretation":"Source-reported typical regional width span; no single midpoint or representative width selected. Not a confidence interval, matched seasonal pair or annual extrema.","range_kind":"reported_typical_regional_width_span","remaining_gates":["Review original observational definitions and temporal/along-route support behind the synthesis.","Obtain paired boundaries and compatible repeat sections before seasonal widths, annual ranges or representative width.","Canonical measurement admission and release review."],"section_geometry":null,"section_orientation":"Not specified for this typical regional prose range.","source_citation":"Leclercq, Théau (2022), Observations des remontées et des plongées des eaux en bordure du courant de Gaspé, master's thesis in oceanography, UQAR-ISMER, February 2022.","source_document_sha256":"b8244831f7e593b0f5da2861f44658ccc8e9c4822cb9fe3b122e2e1e5654ae25","source_evidence_kind":"published_regional_literature_summary","source_locator":"Printed page 5 / PDF page 21, paragraph on typical width 10-20 km; printed page 14 / PDF page 30, English introduction, width can reach 20 km.","source_publication_year":2022,"source_quality_note":"Literature summary in an observational thesis, not a new dated width measurement from its transects. Exact boundaries and uncertainty remain unspecified.","source_retrieved_date":"2026-10-03","source_url":"https://semaphore.uqar.ca/2055/1/Theau_Leclercq_fevrier2022.pdf","status":"editorial_source_extraction_not_canonical","time_convention":"Regional typical-width summary in February 2022 thesis introduction; the adjacent summer maximum-speed clause does not make this a measured summer width range. No matched winter/summer widths or dated survey interval assigned.","whole_current_representative":false,"width_metric":"author_reported_current_width","width_range_km":[10,20],"width_rank_eligible":false},{"annual_extrema_eligible":false,"approximate_width_km":8,"boundary_rule":"Source approximates the mean northward velocity profile by V(x)=17 exp(-(x/8)^2), x in km and V in cm/s, and calls 8 km mean effective width. OSW infers center-to-e-folding scale from the equation; no paired-edge full span is admitted.","boundary_sides":"fitted_center_to_e_folding_distance","calendar_months":null,"cruise_context_is_composite_sampling_bounds":false,"cruise_context_period":{"end":"2007-06-10","start":"2007-05-29"},"current_id":"north-cape","extraction_method":"Transcribed source fit scale and 15-crossing count; metric interpretation inferred algebraically from stated Gaussian equation. No figure digitized or converted full width added.","fixed_layer_bounds_m":null,"full_width_inference_eligible":false,"geographic_scope":"Northern branch near the western Hopen Deep / Spitsbergen Bank polar frontal zone, Barents 
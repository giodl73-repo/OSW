sbergen-selected-core-width-protocol-v1.md","protocol_sha256":"cbacbf19eb88313676c2cd550fa0af60da2c182ec8d3faca69600ef41b928cbe","audit_file":"research/west-spitsbergen-dundas-2026-selected-core-width-scope-audit.json","audit_sha256":"87e5c16c7ea5787e1224cc19b05e4f7b885356268062e6c997f1e09c28dc09fa","section_windows":[{"mission":1,"glider":"sg562","start":"2020-10-10","end":"2021-02-07","profiles":1250,"sections":7},{"mission":2,"glider":"sg560","start":"2021-08-14","end":"2022-02-20","profiles":1610,"sections":7},{"mission":3,"glider":"sg560","start":"2022-08-07","end":"2023-01-02","profiles":1430,"sections":8}],"figure_file":"figures/west-spitsbergen-selected-core-width.svg","figure_sha256":"533d636edf3137cf3290777a806d99e8882c4ac11efdcf2f9a5ce0b5c2026ac5"},"range_interpretation":"No width range is admitted. The separately reported 7 km standard deviation describes western-boundary variability, not minimum/maximum, confidence limits, measurement error or annual extrema.","source_file":"research/west-spitsbergen-dundas-2026-selected-core-width-scope-audit.json","source_pointer":"/measurement"},{"id":"cainzos-2023-t02-row-51-section-span","current_id":"antilles","name":"Antilles Current","status":"editorial_source_extraction_not_canonical","measurement_type":"published_inverse_hydrographic_section_span","width_metric":"transport_diagnosed_hydrographic_section_span","width_metric_label":"transport-selected cruise-section span","approximate_width_km":125,"width_range_km":null,"range_interpretation":"Publisher table distance in kilometres; width error unreported. Separate cruises are not an annual range; transport errors are not width errors.","geographic_scope":"Antilles Current, nominal A05 24.5 N section. Western station tracks deviate from nominal latitude; exact model boundary pairings remain unresolved. Incompatible Cape Hatteras prose is excluded from geography.","section_geometry":null,"section_orientation":"Nominally zonal hydrographic section; exact boundary-
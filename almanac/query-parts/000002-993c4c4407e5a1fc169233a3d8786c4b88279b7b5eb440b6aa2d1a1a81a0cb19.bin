ns remain unreviewed; no original PDF acquisition claimed.","source_scope_context":{"boundary_coordinates_supplied":false,"bathymetry_is_measurement_layer":false,"dataset_period_is_width_sampling_period":false,"full_original_inspected":false,"velocity_context_is_boundary_cutoff":false,"audit_file":"research/oyashio-2005-abstract-width-scope-audit.json","audit_sha256":"7fd3b4cfbe3249d7d7e4ea78242d3f809db99e6a9d2b6f8c2a7d5ea42693c605"},"regional_scalar_context":{"boundary_coordinates_supplied":false,"bathymetry_is_measurement_layer":false,"dataset_period_is_width_sampling_period":false,"full_original_inspected":false,"velocity_context_is_boundary_cutoff":false,"audit_file":"research/oyashio-2005-abstract-width-scope-audit.json","audit_sha256":"7fd3b4cfbe3249d7d7e4ea78242d3f809db99e6a9d2b6f8c2a7d5ea42693c605"}},{"id":"somali-schott-2001-march-may-coastal-width","current_id":"somali","name":"Somali Current","status":"editorial_source_extraction_not_canonical","measurement_type":"published_seasonal_regional_prose_width_span","width_metric":"author_reported_seasonal_regional_current_scale","approximate_width_km":null,"width_range_km":[50,100],"range_interpretation":"One seasonal regional prose span, not an annual range, probability interval or three monthly measurements. Other months have no compatible width evidence here.","geographic_scope":"Northern Somali coastal upwelling regime, farther north than the southern EACC extension that turns offshore near 3-4 N. Northern latitude limits unresolved; no width assigned to the southern gyre, Great Whirl or the entire Somali Current.","section_geometry":null,"section_orientation":"No reproducible section endpoints extracted from the original review prose.","layer":"Shallow northward coastal flow overlying a southward undercurrent; no numerical fixed layer or velocity threshold extracted for the width.","time_convention":"March-May seasonal synthesis in the 2001 review; no specific year, exact occupied section dates or monthly 
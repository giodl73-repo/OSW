derived_local_section_span\",\n    \"width_metric\": \"nominal_geodesic_span_of_published_current_section_limits\",\n    \"width_metric_label\": \"Published local section span; flow-normal and whole-current widths unknown\",\n    \"approximate_width_km\": 116,\n    \"width_range_km\": null,\n    \"range_kind\": null,\n    \"range_interpretation\": \"Nominal span calculated from source coordinates, not a source-reported kilometre width or physical uncertainty interval.\",\n    \"geographic_scope\": \"ORCA northern section at 37 N, Portugal band between 14.8 and 13.5 W, stations 19-23.\",\n    \"section_geometry\": {\n      \"type\": \"LineString\",\n      \"coordinates\": [\n        [\n          -14.8,\n          37\n        ],\n        [\n          -13.5,\n          37\n        ]\n      ]\n    },\n    \"section_orientation\": \"Nominal zonal source section; local flow obliquity and ship track not reconstructed.\",\n    \"layer\": \"Surface and thermocline flow in neutral density layers 1-4 (gamma_n < 27.3800 kg/m3). Fixed depth bounds are not supplied.\",\n    \"time_convention\": \"Fall 2009. The 15 October-11 November dates bound the cruise; exact section occupation days remain unknown.\",\n    \"boundary_rule\": \"Published current-band coordinate limits; no independently digitized velocity cutoff or physical edge.\",\n    \"source_url\": \"https://doi.org/10.1002/jgrc.20227\",\n    \"source_citation\": \"Perez-Hernandez et al. (2013), The source of the Canary current in fall 2009, JGR Oceans 118, 2874-2891.\",\n    \"source_locator\": \"Abstract; section6 paragraph32 and Figure14a; Table1; section7 paragraph40; section2 paragraph7.\",\n    \"source_retrieved_date\": \"2026-10-17\",\n    \"source_evidence_kind\": \"primary_fulltext_review_plus_frozen_local_source_coordinates_no_raw_pdf\",\n    \"extraction_method\": \"WGS84 inverse geodesic between previously curated source limits; display rounded to nearest kilometre. No figure digitization.\",\n    \"whole_current_representative\": false,\n    \"width_rank_eligible\": false,\n    \"full_width_inference_eligible\": false,\n    \"annual_extrema_eligible\": false,\n    \"seasonal_playback_eligible\": false,\n    \"is_confidence_interval\": false,\n    \"phase_label\": \"ORCA local section / fall 2009\",\n    \"phase_kind\": \"campaign_coordinate_derived_section_span\",\n    \"observed_period\": null,\n    \"calendar_months\": null,\n    \"fixed_layer_bounds_m\": null,\n    \"uncertainty_km\": null,\n    \"source_quality_note\": \"Source coordinate precision, datum, exact section dates, physical edges and obliquity remain unresolved. Cruise envelope is context only.\",\n    \"remaining_gates\": [\n      \"Recover original PDF bytes and review page images.\",\n      \"Recover exact section dates, station coordinates, layer-specific physical boundary criterion and uncertainty.\",\n      \"Obtain compatible repeat sections before seasonal or annual comparison.\"\n    ],\n    \"published_section_context\": {\n      \"source_event_id\": \"orca-2009-portugal-north-section\",\n      \"source_event\": {\n        \"current_id\": \"portugal\",\n        \"observation_event_id\": \"orca-2009-portugal-north-section\",\n        \"name\": \"Portugal Current\",\n        \"state_code\": \"NAST E\",\n        \"reported_locality\": \"ORCA 37°N section, 14.8–13.5°W\",\n        \"observation_start\": \"2009-10-15\",\n        \"observation_end\": \"2009-11-11\",\n        \"observation_type\": \"hydrographic_section_and_inverse_box_model\",\n        \"time_detail\": \"The dates bound the entire ORCA cruise; the exact occupation dates of this current band are not separately assigned here.\",\n        \"source_url\": \"https://doi.org/10.1002/jgrc.20227\",\n        \"source_locator\": \"Portugal Current discussion; 37°N ORCA section\",\n        \"spatial_basis\": \"The paper reports the Portugal Current between 14.8°W and 13.5°W along its 37°N section. This is a cross-stream band, not an along-curren
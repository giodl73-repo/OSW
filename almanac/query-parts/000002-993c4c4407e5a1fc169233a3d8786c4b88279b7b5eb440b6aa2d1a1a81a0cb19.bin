idate_not_scientifically_reviewed","comparison_group":"osw_studied_reach_routes","scope":"Declared western Hopen Deep Northern-branch study-area reach, from an OSW southern Hopen approach gate near 30 E, 75 N to the LS05 frontal/core neighborhood near 28.5 E, 77 N. Excludes Barents Sea entrance, Central branch, eastern continuations and cyclonic recirculation loops. Not the full North Cape Current or an observed trajectory.","route_extent_kind":"western Hopen Northern-branch reach","approximate_reference_path_km":200,"scenario_range_km":[200,300],"scenario_count":81,"source_url":"https://physical-oceanography.ru/repository/issues/2017/02/05/20170205.pdf","source_locator":"Stationary currents p. 38: Northern branch enters Hopen Deep and partially recirculates; Currents pp. 46–47, Fig. 1 and Fig. 9: western Hopen margin study area and LS05 current/front core near the 200 m isobath. Figures inspected for regional orientation, not digitized.","supporting_sources":[{"url":"https://www.hi.no/resources/publikasjoner/imrpinro/2009/imr-pinro_2009-1_til_web.pdf","citation":"Anon. (2009), Survey report from the joint Norwegian/Russian ecosystem survey in the Barents Sea August–October 2008, volume 1, IMR/PINRO Joint Report Series No. 1/2009.","locator":"Hydrographical conditions, pp. 20–21: Central branch south of Central Bank; Northern branch above 74°30 N on Vardo-North section, toward Hopen Trench.","role":"Independent branch distinction and broad geography; no section-width or date transfer to candidate."}],"candidate_file":"research/north-cape-northern-reach-reference-path-candidate.json","candidate_sha256":"47a6a36819f5395eb2aab9e11169cc538e08f3bed79cac1b33610551537dd77e","generator_sha256":"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240","figure":"figures/north-cape-northern-reach-reference-path-candidate.svg","nominal_atlas_state_crossings":["BPLR"],"recommended_nasa_tile_id":"level2_D_1","remaining_gates":["Validate editorial approach and LS05 core-n
:["PEQD","PNEC"],"recommended_nasa_tile_id":"level2_A_4","remaining_gates":["Review correspondence of historical mean-core sections to later primary/secondary labels; no branch aggregation inferred.","Review interpolation with compatible southern-jet velocity fields and independently resolve secondary-jet geometry.","Obtain month/depth axes before seasonal dimensions; source compilation years are not route observation dates.","Resolve western formation and eastern continuation; transport bands and PV-front spans must remain separate from current width."],"parent_current_id":null,"parent_scope_note":null,"ordering_sensitivity":null},{"id":"north-pacific-reference-path-candidate","current_id":"north-pacific","name":"North Pacific Current","status":"editorial_reference_path_candidate_not_scientifically_reviewed","comparison_group":"osw_approximate_reference_routes","scope":"NOAA glossary regional extent from about 160 degrees E to an OSW gate at 145 degrees W, somewhat beyond the source's approximate 150 degrees W region. Alternative ends at 150 degrees W. This convention excludes downstream Alaska/California branches and the Kuroshio Extension. It is not the entire Japan-to-North-America circulation or a universal naming extent; AMS describes a different western origin near 170 degrees W.","route_extent_kind":"NOAA North Pacific regional extent","approximate_reference_path_km":4700,"scenario_range_km":[3900,5000],"scenario_count":162,"source_url":"https://www.tidesandcurrents.noaa.gov/glossary.html","source_locator":"North Pacific Current entry: eastward flow from approximately 160 degrees E to beyond approximately 150 degrees W, continuing Kuroshio Extension and branching south. Kuroshio Extension entry separates the preceding component.","supporting_sources":[{"url":"https://glossary.ametsoc.org/wiki/north-pacific-current/","citation":"American Meteorological Society, Glossary of Meteorology, North Pacific Current entry.","locator":"Opening definition: northern subtropical-gyre limb, origin near 170 degrees W and mixing with Aleutian flow.","role":"Contrasting naming convention; not used to silently extend or redefine this NOAA-convention candidate."}],"candidate_file":"research/north-pacific-reference-path-candidate.json","candidate_sha256":"ee25ff511216b68828cc270c19499fd16dbeed200f1c2f387072a07813a05d87","generator_sha256":"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240","figure":"figures/north-pacific-reference-path-candidate.svg","nominal_atlas_state_crossings":["NPPF","NPSW","PSAE","PSAW"],"recommended_nasa_tile_id":"level2_H_2","remaining_gates":["Independent review of NOAA versus other naming conventions and current identity across the latitude corridors.","Replace editorial waypoints with suitable upper-ocean velocity geometry; review eastern branching gates.","Canonical admission and publication review; preserve date-line policy and scope."],"parent_current_id":null,"parent_scope_note":null,"ordering_sensitivity":{"overlapping_candidate_ids":["agulhas-return-extent-reference-path-candidate","brazil-reference-path-candidate"],"envelope_position_bounds":[1,3],"interpretation":"Conservative positions within retained rounded route envelopes, treating choices independently; touching envelopes overlap. Not a statistical rank interval or a uniform whole-current comparison."}},{"id":"agulhas-return-extent-reference-path-candidate","current_id":"agulhas-return","name":"Agulhas Return Current","status":"editorial_reference_path_candidate_not_scientifically_reviewed","comparison_group":"osw_approximate_reference_routes","scope":"Source-scoped named-current extent from first clear evidence near 16 degrees E to loss of a recognizable jet between 66 and 70 degrees E. Does not include the subsequent South Indian Ocean Current or northern leakage branches.","route_extent_kind":"source-scoped extent route","approximate_reference_path_km":4600,"scenario_range_km":[3900,4900],"scenario_count":243,"source_url":"https:/
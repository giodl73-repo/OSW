,"url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639","doi":"10.1029/2007JC004639","authors":["J. J. Nauw","H. M. van Aken","A. Webb","J. R. E. Lutjeharms","W. P. M. de Ruijter"],"publication_date_parts":[2008,8,5],"publisher":"American Geophysical Union","preferred_citation":"Nauw, van Aken, Webb, Lutjeharms and de Ruijter (2008), Observations of the southern East Madagascar Current and undercurrent and countercurrent system, JGR113, C08006, doi:10.1029/2007JC004639.","metadata_status":"Publisher full HTML and institutional publication record inspected; no original PDF acquired","material_use_class":"source_scoped_factual_claim","provider_asset_redistributed":false,"rights_status":"Reviewed narrow factual use: original paraphrase and linked source; no article or figure redistributed","rights_policy_url":"plans/current-identity-admission-protocol-v1.md","rights_review_date":"2026-10-21","path":null,"repository_path":null,"used_in_collections":["entities","names","length_assessments","current_identity_admissions"]},"status":"editorial_identity_admitted_measurements_separately_gated","admission_date":"2026-10-21","review_type":"internal_editorial_identity_review_not_external_scientific_peer_review","identity_evidence":{"source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639","source_locator":"Title; Introduction paragraph2; abstract; Results3.1 paragraph17","access_mode":"publisher_full_HTML_inspected_original_PDF_unavailable","decision":"The primary text explicitly identifies a southward East Madagascar Current. The southern qualifier distinguishes the named poleward branch from northward flow, the underlying equatorward undercurrent and offshore countercurrent.","classification_basis":"Introduction identifies the western boundary current of the South Indian subtropical gyre. Abstract describes near-surface expression and1992–2005 altimetry with eddy and interannual variability.","global_aliases_admitted":[],"parent_relationships_admitted":[]},"source_dimensions":{"schema":"osw.proposed-current-reported-dimensions.v1","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639","source_citation":"Nauw, van Aken, Webb, Lutjeharms and de Ruijter (2008), Observations of the southern East Madagascar Current and undercurrent and countercurrent system, JGR113, C08006, doi:10.1029/2007JC004639.","source_original_pdf_sha256":null,"source_license":"AGU/Wiley copyrighted publication; free access does not imply a redistribution license. Original factual summaries and OSW diagram only.","figure_file":"figures/southern-east-madagascar-reported-dimensions.svg","reported_length_rank_eligible":false,"physical_annual_width_range_km":null,"geographic_current_edges":null,"seasonal_playback_eligible":false,"records":[{"id":"southern-east-madagascar-nauw2008-reported-extent","dimension":"length","value_km":650,"approximate":true,"metric":"author_reported_southern_branch_extent","source_locator":"Introduction paragraph2","support":"Southward branch from approximately20S to Cap Sainte Marie at approximately25deg30minS. Source cites Duncan1970 and Lutjeharms1988b; this is a contextual literature estimate, not a new length measured by the2001 cruise.","observed_period":null,"fixed_layer_bounds_m":null,"endpoint_coordinates_lon_lat":null,"uncertainty_km":null,"is_annual_mean":false,"is_annual_extremum":false,"rank_eligible":false},{"id":"southern-east-madagascar-nauw2008-survey-width","dimension":"width","value_km":120,"approximate":true,"metric":"author_reported_near_surface_survey_width","source_locator":"Results3.1 paragraph17; abstract","support":"SectionsT5–T8 in April2001 off southeast Madagascar. Near-surface current structure uses VMADCP mean velocity in the upper100m. Numeric edge cutoff, boundary coordinates and width uncertainty are not specified in this passage.","observed_period":"2001-04","fixed_layer_bounds_m":null,"velocity_averaging_layer_m":[0,100],"velocity_a
390533af513f205764af63e4422","coordinates_lon_lat":[[77,4],[78.5,4],[80.5,4],[82,4.5],[83,6]],"comparability":{"current_id":"monsoon","annual_length_range_km":null,"annual_width_range_km":null,"annual_extrema_eligible":false,"reason":"Two source-defined seasonal phases with editorial 77–83 E regional drawings. Their different latitude choices and scenario envelopes are not observed annual length minima/maxima. March–May and October geometry and all seasonal widths remain unresolved; month labels do not provide monthly velocity fields."}},{"id":"monsoon-winter-sri-lanka","current_id":"monsoon","phase_label":"Northeast Monsoon Current · November–February westward regional reach","flow_direction":"westward","calendar_months":[11,12,1,2],"source_season_label":"winter","route_candidate_file":"research/monsoon-winter-sri-lanka-reference-path-candidate.json","route_candidate_sha256":"050f03273c082601dd425ad8221c6f038bcc152c4f2978e58dde9af6e60f4334","geometry_role":"osw_editorial_reference_route","width_measurement_ids":[],"time_convention":"Boreal winter source convention, November–February. Historical review and section context, not a simultaneous dated trajectory or current-year climatology.","layer":"Seasonal near-surface regional geography. Historical section evidence is shallow and depth dependent; no fixed-depth velocity axis reconstructed and undercurrents excluded.","source_url":"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf","source_locator":"Schott and McCreary (2001), section 5.1.5, printed pp. 63–65 / PDF indices 62–64: seasonal directions/months, Sri Lanka bottleneck and separate upper-layer/undercurrent flows. August 1993 and January 1991 sections provide local latitude context, not regional axis vertices.","entity_id":"current:monsoon","label":"Monsoon Current — Northeast Monsoon Current · November–February westward regional reach","status":"editorial_seasonal_route_associations_not_canonical","seasonal_inventory_file":"research/ocean-current-seas
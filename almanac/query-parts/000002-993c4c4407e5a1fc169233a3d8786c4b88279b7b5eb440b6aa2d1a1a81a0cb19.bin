upporting_sources":[{"url":"https://www.data.jma.go.jp/kaiyou/data/db/maizuru/knowledge/tsushima_current.html","citation":"Japan Meteorological Agency, What is the Tsushima Warm Current? (Japanese explanatory page), accessed 2026-10-03.","locator":"Opening paragraph and section Tsushima Warm Current pathway.","role":"Tsushima inflow, Tsugaru/Soya exits and often discontinuous flow context; not coordinates, a measured axis or branch length."},{"url":"https://link.springer.com/article/10.1007/s10872-023-00693-6","citation":"Ohshima and Kuga (2023), 50-year volume transport of the Soya Warm Current estimated from the sea-level difference and its relationship with the Tsushima and Tsugaru Warm Currents, doi:10.1007/s10872-023-00693-6.","locator":"Section 1, first paragraph.","role":"Japan Sea Throughflow inflow/outflow naming; no merger of Tsushima, Tsugaru and Soya lengths."},{"url":"https://link.springer.com/article/10.1007/s10872-024-00734-8","citation":"Yokomatsu and Kida (2025; online 2024), doi:10.1007/s10872-024-00734-8.","locator":"Section 2.1.","role":"Coastal versus offshore broad pathway classification; not a contradictory claim that every source uses exactly two branches."}],"candidate_file":"research/tsushima-coastal-reference-path-candidate.json","candidate_sha256":"9588d8456ce77e0963ecb38afe6deeec26482b88d1cbfcae3f05e71a94b680e5","generator_sha256":"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240","figure":"figures/tsushima-coastal-reference-path-candidate.svg","nominal_atlas_state_crossings":["CHIN","KURO"],"recommended_nasa_tile_id":"level2_F_2","remaining_gates":["Review branch continuity, inlet/outlet gate and island/bathymetric correspondence.","Resolve branch/system and Tsugaru/Soya continuation naming without alias mergers.","Obtain suitable dated upper-ocean velocity geometry before seasonal route or representative length claims.","Canonical admission and publication review; this is an editorial regional branch length."],"parent_c
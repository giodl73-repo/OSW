iles/Sutherland_EGCC_revised_withfigs_33743.pdf","source_citation":"Sutherland and Pickart (2008), The East Greenland Coastal Current: Structure, variability, and forcing. Accepted manuscript, Progress in Oceanography.","source_locator":"Section 2.1: July-August 2004 JR105; Section 2.3: absolute geostrophic velocity reference; Section 3.1, PDF pages 9-10: 15% lateral criterion and Cape Farewell wobs = 30 km.","source_retrieved_date":"2026-10-03","source_evidence_kind":"published_observational_analysis","extraction_method":"Author-reported prose width and threshold transcribed; no section figure or velocity field digitized.","whole_current_representative":false,"width_rank_eligible":false,"remaining_gates":["Review boundary definition and regional/layer sampling.","Obtain comparable repeated observations before seasonal animation or annual range.","Canonical measurement admission and release review."],"phase_label":"2004 Cape Farewell section","phase_kind":"survey_threshold_section","observed_period":null,"full_width_inference_eligible":false,"width_metric_label":"local section width at 15% of maximum inner jet velocity","boundary_sides":"paired_relative_velocity_boundaries","source_quality_note":"Source uses 3-5 km station spacing and 3 km by 10 m gridding. Reported 75 m frontal depth scale is separate; no fine boundary accuracy inferred.","velocity_threshold_fraction":0.15,"velocity_reference_statistic":"maximum_inner_jet_velocity","campaign_month_window":{"start_month":"2004-07","end_month":"2004-08"},"sampling_window_is_exact_section_dates":false,"calendar_months":null,"fixed_layer_bounds_m":null,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"is_confidence_interval":false},{"id":"atlantic-necc-hs5-mean-zero-contour-width","current_id":"atlantic-north-equatorial-countercurrent","name":"Atlantic North Equatorial Countercurrent","status":"editorial_source_extraction_not_canonical","measurement_type":"published_mean_section_width","width_metric":
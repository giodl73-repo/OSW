; 37°N ORCA section","spatial_basis":"The paper reports the Portugal Current between 14.8°W and 13.5°W along its 37°N section. This is a cross-stream band, not an along-current trace.","reported_section_endpoints_lon_lat":[[-14.8,37],[-13.5,37]],"state_assignment_method":"source_reported_section_intersects_approximate_osw_state_polygon","state_boundary_limit":"The reported cross-stream band intersects the approximate NAST E polygon; the state boundary and observed current extent are not surveyed together.","physical_relation":"observed_local_cross_stream_section_only_whole_current_passage_unresolved","geometry_status":"source_reported_section_bounds_not_current_axis"},"unrounded_geodesic_distance_km":115.71427424571638,"calculation_ellipsoid":"WGS84","ellipsoid_is_osw_assumption":true,"calculation_method":"pyproj.Geod(ellps=WGS84).inv; metres divided by1000","display_rounding_km":1,"distance_is_author_reported_km":false,"source_coordinate_datum":null,"source_coordinate_uncertainty_degrees":null,"cruise_context":{"start":"2009-10-15","end":"2009-11-11","is_exact_section_occupation":false},"neutral_density_context":{"layers":[1,2,3,4],"upper_bound_gamma_n_kg_m3":27.38,"is_fixed_depth_slab":false},"transport_uncertainty_is_width_uncertainty":false,"flow_normal_width_km":null,"whole_current_width_km":null,"source_review":{"publisher_html_reviewed":true,"institutional_pdf_parsed_text_reviewed":true,"raw_pdf_acquired":false,"raw_pdf_sha256":null,"page_images_reviewed":false},"audit_file":"research/portugal-perez-2013-orca-section-span-scope-audit.json","audit_sha256":"389d77f93a11e2b9cae6be934beba040f143bf7523c442b8bc27a6c491ea1b61"}},{"id":"west-spitsbergen-dundas-2026-selected-core-width-statistic","current_id":"west-spitsbergen","name":"West Spitsbergen Current","status":"editorial_source_extraction_not_canonical","measurement_type":"published_transport_selected_core_width_statistic","width_metric":"zonal_extent_of_selected_high_transport_core","approximate_width_km":2
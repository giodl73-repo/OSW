","whole_current_representative":false,"width_rank_eligible":false,"full_width_inference_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"is_confidence_interval":false,"phase_label":"Regional along-slope background synthesis","phase_kind":"regional_summary","observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"uncertainty_km":null,"source_quality_note":"Original publisher PDF and p148 visually inspected. Introductory width cites prior work, not an ABACUS width calculation. Underlying Testor et al. boundary method remains unreviewed.","remaining_gates":["Review the underlying width citation and paired boundary method.","Obtain compatible repeat sections before monthly or annual variation.","Independent scientific admission."],"original_regional_context":{"full_original_inspected":true,"underlying_width_source":"Testor et al. (2005), cited in section 1","underlying_width_methods_reviewed":false,"survey_years_are_width_occupations":false,"survey_depth_is_width_layer":false,"LIW_depth_is_width_layer":false,"eddy_diameter_is_current_width":false,"span_is_annual_range":false,"boundary_coordinates_extracted":false,"protocol_file":"plans/algerian-regional-width-protocol-v1.md","protocol_sha256":"e19cf5ac14c488820940035164fde4185138b777b4e389313d28737317617789","audit_file":"research/algerian-cotroneo-2019-regional-width-scope-audit.json","audit_sha256":"417252a69db47dd73f102c06408807ed43c14acc6fa6c81470ca8141aba3c600"}},{"id":"alaska-weingartner-2002-regional-width","current_id":"alaska","name":"Alaska Current","status":"editorial_source_extraction_not_canonical","measurement_type":"published_regional_summary","width_metric":"author_reported_current_width","approximate_width_km":300,"width_range_km":null,"range_kind":"approximate_regional_point_no_reported_interval","range_interpretation":"One approximate regional background value; no numerical uncertainty, range, confidence interval, annual extrema or seasonal observations supplied.","geographic_scope":"Eastern Gulf of Alaska boundary flow along the continental slope, distinct from the Alaskan Stream in the northwestern gulf and inner-shelf Alaska Coastal Current. No paired width edges or exact terminal gates supplied.","section_geometry":null,"section_orientation":"No reproducible transverse section endpoints supplied for the regional breadth description.","layer":"Regional current flow; fixed numerical width layer unspecified. Weak horizontal and vertical shears do not establish a depth interval.","time_convention":"Regional background synthesis in a 2002 article; no dated width occupation or width climatology. Year-round persistence and GLOBEC program dates are separate context.","boundary_rule":"Author-reported approximate regional breadth. No paired edge positions or velocity cutoff extracted. Sentence continues on p50 to contrast the Alaskan Stream and cite Reed and Schumacher (1986).","source_url":"https://tos.org/oceanography/article/the-northeast-pacific-globec-program-coastal-gulf-of-alaska","source_citation":"Weingartner et al. (2002), The Northeast Pacific GLOBEC Program: Coastal Gulf of Alaska, Oceanography 15(2), 48-63, doi:10.5670/oceanog.2002.21.","source_locator":"Physical Setting, printed p49 (PDF page 2), right column final paragraph; sentence continuation on p50 (PDF page 3), left column below Figure 1.","source_retrieved_date":"2026-10-08","source_evidence_kind":"published_original_regional_background_synthesis","extraction_method":"Approximate point transcribed from visually inspected publisher original prose; no current axis or map width digitization.","whole_current_representative":false,"width_rank_eligible":false,"full_width_inference_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"is_confidence_interval":false,"phase_label":"Regional eastern Gulf background synthesis","phase_kind":"regional_summary","observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"uncertainty_km":null,"source_quality_note":"Original publisher PDF and p49/p50 visually inspected. Approximate regional description, not a new GLOBEC width calculation. Underlying cited boundary method and attribution remain unreviewed.","remaining_gates":["Resolve the cited original width support and paired boundary method.","Obtain compatible repeat sections before monthly or annual variation.","Independent scientific admission."],"original_regional_context":{"width_passage_visually_inspected":true,"underlying_width_source":"Reed and Schumacher (1986) at the end of the sentence on p50; application to the Alaska breadth is not independently resolved.","underlying_width_methods_reviewed":false,"survey_years_are_width_occupations":false,"drifter_depth_is_width_layer":false,"forcing_climatologies_are_width_climatology":false,"year_round_persistence_is_monthly_width_series":false,"alaskan_stream_width_is_range_endpoint":false,"coastal_confinement_is_alaska_width":false,"shelf_breadth_is_current_width":false,"boundary_coordinates_extracted":false,"protocol_file":"plans/alaska-regional-width-protocol-v1.md","protocol_sha256":"21c30fc5f5de4b01ca8ff53e2ac382b2e55052a38618a935669b3729b460b553","display_caption":"Eastern Gulf of Alaska boundary current · one approximate 300 km regional background description. Numerical uncertainty, width range, fixed layer and observation dates unknown. GLOBEC survey dates, drifter depth and forcing climatologies do not define this width. No annual range, monthly samples or mapped edges inferred.","display_method_note":"Publisher p49 and its p50 sentence continuation inspected. The narrower Alaskan Stream and inner-shelf Alaska Coastal Current are separate features. The cited original boundary method remains unreviewed.","audit_file":"research/alaska-weingartner-2002-regional-width-scope-audit.json","audit_sha256":"475b2cbc7c21e6aac907e2a61153b50088fb77010053f0957e6f2cf44f5535ad"}},{"id":"pacific-euc-wang-2022-background-width","curre
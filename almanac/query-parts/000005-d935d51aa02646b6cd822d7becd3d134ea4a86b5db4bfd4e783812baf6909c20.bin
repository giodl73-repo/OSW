"boundary_rule\": \"Published current-band coordinate limits; no independently digitized velocity cutoff or physical edge.\",\n    \"source_url\": \"https://doi.org/10.1002/jgrc.20227\",\n    \"source_citation\": \"Perez-Hernandez et al. (2013), The source of the Canary current in fall 2009, JGR Oceans 118, 2874-2891.\",\n    \"source_locator\": \"Abstract; section6 paragraph32 and Figure14a; Table1; section7 paragraph40; section2 paragraph7.\",\n    \"source_retrieved_date\": \"2026-10-17\",\n    \"source_evidence_kind\": \"primary_fulltext_review_plus_frozen_local_source_coordinates_no_raw_pdf\",\n    \"extraction_method\": \"WGS84 inverse geodesic between previously curated source limits; display rounded to nearest kilometre. No figure digitization.\",\n    \"whole_current_representative\": false,\n    \"width_rank_eligible\": false,\n    \"full_width_inference_eligible\": false,\n    \"annual_extrema_eligible\": false,\n    \"seasonal_playback_eligible\": false,\n    \"is_confidence_interval\": false,\n    \"phase_label\": \"ORCA local section / fall 2009\",\n    \"phase_kind\": \"campaign_coordinate_derived_section_span\",\n    \"observed_period\": null,\n    \"calendar_months\": null,\n    \"fixed_layer_bounds_m\": null,\n    \"uncertainty_km\": null,\n    \"source_quality_note\": \"Source coordinate precision, datum, exact section dates, physical edges and obliquity remain unresolved. Cruise envelope is context only.\",\n    \"remaining_gates\": [\n      \"Recover original PDF bytes and review page images.\",\n      \"Recover exact section dates, station coordinates, layer-specific physical boundary criterion and uncertainty.\",\n      \"Obtain compatible repeat sections before seasonal or annual comparison.\"\n    ],\n    \"published_section_context\": {\n      \"source_event_id\": \"orca-2009-portugal-north-section\",\n      \"source_event\": {\n        \"current_id\": \"portugal\",\n        \"observation_event_id\": \"orca-2009-portugal-north-section\",\n 
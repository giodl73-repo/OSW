thods and width passage read; PDF65 visually inspected; adjoining section/maps and date context reviewed. No copied source curves or edge coordinates.\",\n  \"source_document_file\": \"research/source-data/uhlhorn-loop-2008/journal-article.pdf\",\n  \"source_document_sha256\": \"c86e4086c9d3242abe52e11e8702aba7af59fc76975ec3d1173b2d572accca84\",\n  \"source_document_bytes\": 4764365,\n  \"acquisition_file\": \"research/source-data/uhlhorn-loop-2008/acquisition.json\",\n  \"acquisition_sha256\": \"4b42179ee66328dc3b3c5e99ec1b8cefd4bc843bc366053c7ce2952ff03325a5\",\n  \"integrity_contract_file\": \"research/uhlhorn-loop-2008-thesis-integrity-contract.json\",\n  \"integrity_contract_sha256\": \"0ac16f5415f340304cfb72ec346935e3b72393c22da006272065cc1e059c4df7\",\n  \"protocol_file\": \"plans/loop-current-uhlhorn-core-width-protocol-v1.md\",\n  \"protocol_sha256\": \"98bc6c68ef40aced1af7d7ccc671f0a4c3ce5e80356e4586f9c62d3d5dbb4bfc\",\n  \"measurement\": {\n    \"status\": \"editorial_source_extraction_not_canonical\",\n    \"section_geometry\": null,\n    \"whole_current_representative\": false,\n    \"width_rank_eligible\": false,\n    \"full_width_inference_eligible\": false,\n    \"annual_extrema_eligible\": false,\n    \"seasonal_playback_eligible\": false,\n    \"is_confidence_interval\": false,\n    \"calendar_months\": null,\n    \"fixed_layer_bounds_m\": null,\n    \"uncertainty_km\": null,\n    \"whole_current_width_km\": null,\n    \"annual_width_range_km\": null,\n    \"source_retrieved_date\": \"2026-10-14\",\n    \"current_id\": \"loop\",\n    \"name\": \"Loop Current\",\n    \"id\": \"loop-uhlhorn-2008-prelili-geostrophic-core\",\n    \"measurement_type\": \"published_campaign_geostrophic_core_span\",\n    \"width_metric\": \"author_reported_fixed_speed_geostrophic_core_span\",\n    \"width_metric_label\": \"Pre-Lili survey: fixed0.4 m/s geostrophic core\",\n    \"approximate_width_km\": 100,\n    \"width_range_km\": null,\n    \"range_interpretation\": \"One approximate author-reported core span. No paired seasonal values, width error, pooled100-200 km range or annual extrema.\",\n    \"geographic_scope\": \"Southeastern Gulf of Mexico, middle-grid-row cross section of the analyzed Loop Current; numerical boundary endpoints not extracted.\",\n    \"section_orientation\": \"Source-labeled cross-stream middle grid row, southeast to northwest; no exact geographic section or perpendicular-angle reconstruction.\",\n    \"layer\": \"Geostrophic core cross section. Source describes structure mainly within upper300 m; depth at which prose100 km span is evaluated is not separately specified. Reference level is shallower of750 m and local bottom, not a width layer.\",\n    \"time_convention\": \"Width paragraph explicitly uses19-23September2002 prestorm fields. Broader flight context18-23September; no width inferred for2October or4October. No source clock timezone assigned.\",\n    \"boundary_rule\": \"Author-reported cross-stream extent of geostrophic speeds at least0.4 m/s; preserve fixed cutoff. Approximate e-folding wording is source context, not an adopted relative threshold.\",\n    \"source_url\": \"https://scholarship.miami.edu/esploro/outputs/doctoral/Gulf-of-Mexico-Loop-Current-Mechanical/991031447487802976\",\n    \"source_citation\": \"Uhlhorn, E. W. (2008), Gulf of Mexico Loop Current Mechanical Energy and Vorticity Response to a Tropical Cyclone, PhD dissertation, University of Miami, May2008.\",\n    \"source_locator\": \"Section2.5.2, printed35-37/PDF64-66; width paragraph printed36/PDF65; Figure2.28 printed38/PDF67. Date/flight context printed10-11/PDF39-40. PDF page numbers include repository cover.\",\n    \"source_evidence_kind\": \"original_dissertation_observational_density_analysis\",\n    \"extraction_method\": \"Transcribed explicit about100 km prose after original-page and section review; no curve digitization or reconstruction from longitude ticks.\",\n    \"phase_label\": \"19-23 September2002 \\u00b7 prestorm geostrophic core\",\n    \"phase_kind\": \"campaign_geostrophic_core\",\n    \"observed_period\": {\n      \"start\": \"2002-09-19\",\n      \"end\": \"2002-09-23\"\n    },\n    \"source_quality_note\": \"Thermal-wind velocity relative to an assumed zero-reference level can underestimate absolute speed. Source e-folding wording is not numerically identical to the stated fixed cutoff. Width error and exact edge geometry remain unknown.\",\n    \"remaining_gates\": [\n      \"Recover paired geographic edges, exact width evaluation depth and numerical density/velocity profiles.\",\n      \"Review reference-flow, curvature, mapping resolution and boundary sensitivity before independent physical admission.\",\n      \"Acquire compatible repeated sections for seasonal or whole-current dimensions.\"\n    ],\n    \"original_regional_context\": {\n      \"description_kind\": \"loop_prestorm_fixed_speed_geostrophic_core\",\n      \"source_speed_threshold_m_s\": 0.4,\n      \"source_local_peak_context_m_s\": 0.75,\n      \"source_e_folding_wording_is_adopted_threshold\": false,\n      \"source_threshold_to_prose_peak_ratio\": 0.5333333333333333,\n      \"reference_depth_limit_m\": 750,\n      \"reference_condition\": \"zero geostrophic velocity at shallower of750 m and local bottom\",\n      \"reference_depth_is_width_layer\": false,\n      \"upper_core_depth_context_m\": 300,\n      \"core_depth_context_is_uniform_width_slab\": false,\n      \"source_width_period\": {\n        \"start\": \"2002-09-19\",\n        \"end\": \"2002-09-23\"\n      },\n      \"general_flight_period_context\": {\n        \"start\": \"2002-09-18\",\n        \"end\": \"2002-09-23\"\n      },\n      \"poststorm_current_change_is_width_change\": false,\n      \"speed_bias_is_width_error\": false,\n      \"source_curve_or_coordinates_digitized\": false,\n      \"display_aria_label\": \"Loop Current: about100 km author-reported fixed0.4 m/s geostrophic core span,19-23September2002. Relative reference flow, exact evaluation depth and geographic edges unresolved; no annual range.\",\n      \"display_caption\": \"About100 km \\u00b7 prestorm geostrophic core at fixed0.4 m/s cutoff.\",\n      \"display_method_note\": \"Thermal-wind density analysis relative to750 m or bottom. Upper300 m core context is not a uniform width layer. Source e-folding wording is not adopted; no width-error or seasonal interval.\",\n      \"comparison_figure\": \"figures/loop-uhlhorn-2008-core-width.svg\",\n      \"comparison_figure_label\": \"Inspect the Loop Current core width definition\"\n    }\n  }\n}\n","document":{"schema":"osw.loop-uhlhorn-geostrophic-core-width.v1","status":"editorial_source_extraction_not_canonical","current_id":"loop","source_access":"Original downloaded institutional dissertation, relevant methods and width passage read; PDF65 visually inspected; adjoining section/maps and date context reviewed. No copied source curves or edge coordinates.","source_document_file":"research/source-data/uhlhorn-loop-2008/journal-article.pdf","source_document_sha256":"c86e4086c9d3242abe52e11e8702aba7af59fc76975ec3d1173b2d572accca84","source_document_bytes":4764365,"acquisition_file":"research/source-data/uhlhorn-loop-2008/acquisition.json","acquisition_sha256":"4b42179ee66328dc3b3c5e99ec1b8cefd4bc843bc366053c7ce2952ff03325a5","integrity_contract_file":"research/uhlhorn-loop-2008-thesis-integrity-contract.json","integrity_contract_sha256":"0ac16f5415f340304cfb72ec346935e3b72393c22da006272065cc1e059c4df7","protocol_file":"plans/loop-current-uhlhorn-core-width-protocol-v1.md","protocol_sha256":"98bc6c68ef40aced1af7d7ccc671f0a4c3ce5e80356e4586f9c62d3d5dbb4bfc","measurement":{"status":"editorial_source_extraction_not_canonical","section_geometry":null,"whole_current_representative":false,"width_rank_eligible":false,"full_width_inference_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"is_confidence_interval":false,"calendar_months":null,"fixed
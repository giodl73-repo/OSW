tion":"Study velocity-field context September 1999-August 2000. No exact width occupations, seasonal width series or annual extrema extracted.","boundary_rule":"Approximate regional current width reported in the abstract; paired edges and a width-defining velocity cutoff are not supplied there. Reported 0.2-0.4 m/s flow is velocity context, not an edge threshold.","source_url":"https://link.springer.com/article/10.1007/s10872-006-0004-3","source_citation":"Ohshima, K. I., Wakatsuchi, M. and Saitoh, S. I. (2005), Velocity Field of the Oyashio Region Observed with Satellite-Tracked Surface Drifters during 1999-2000, Journal of Oceanography 61, 845-855, doi:10.1007/s10872-006-0004-3.","source_locator":"Publisher abstract, regional current-width sentence.","source_retrieved_date":"2026-10-08","source_evidence_kind":"published_publisher_abstract","extraction_method":"Transcribed publisher abstract numerical description; full original methods and figures not inspected.","whole_current_representative":false,"width_rank_eligible":false,"full_width_inference_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"is_confidence_interval":false,"phase_label":"Publisher abstract regional description","phase_kind":"regional_scalar_summary","observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"remaining_gates":["Inspect full original methods and figures to recover the width convention, layer and spatial support.","Obtain compatible dated repeat sections before seasonal animation or annual ranges.","Independent scientific and canonical admission review."],"source_quality_note":"Source access: publisher abstract inspected (California via publisher-indexed text). Full original methods, figures and boundary definitions remain unreviewed; no original PDF acquisition claimed.","source_scope_context":{"boundary_coordinates_supplied":false,"bathymetry_is_measurement_layer":false,"dataset_period_is_width_sampling_period":false,"full_original_inspected":false,"velocity_context_is_boundary_cutoff":false,"audit_file":"research/oyashio-2005-abstract-width-scope-audit.json","audit_sha256":"7fd3b4cfbe3249d7d7e4ea78242d3f809db99e6a9d2b6f8c2a7d5ea42693c605"},"regional_scalar_context":{"boundary_coordinates_supplied":false,"bathymetry_is_measurement_layer":false,"dataset_period_is_width_sampling_period":false,"full_original_inspected":false,"velocity_context_is_boundary_cutoff":false,"audit_file":"research/oyashio-2005-abstract-width-scope-audit.json","audit_sha256":"7fd3b4cfbe3249d7d7e4ea78242d3f809db99e6a9d2b6f8c2a7d5ea42693c605"}},{"id":"somali-schott-2001-march-may-coastal-width","current_id":"somali","name":"Somali Current","status":"editorial_source_extraction_not_canonical","measurement_type":"published_seasonal_regional_prose_width_span","width_metric":"author_reported_seasonal_regional_current_scale","approximate_width_km":null,"width_range_km":[50,100],"range_interpretation":"One seasonal regional prose span, not an annual range, probability interval or three monthly measurements. Other months have no compatible width evidence here.","geographic_scope":"Northern Somali coastal upwelling regime, farther north than the southern EACC extension that turns offshore near 3-4 N. Northern latitude limits unresolved; no width assigned to the southern gyre, Great Whirl or the entire Somali Current.","section_geometry":null,"section_orientation":"No reproducible section endpoints extracted from the original review prose.","layer":"Shallow northward coastal flow overlying a southward undercurrent; no numerical fixed layer or velocity threshold extracted for the width.","time_convention":"March-May seasonal synthesis in the 2001 review; no specific year, exact occupied section dates or monthly width values supplied.","boundary_rule":"Author-reported order-of-magnitude width scale of the northern shallow coastal flow. Paired geographic edges and a speed cutoff are unextracted.","source_url":"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf","source_citation":"Schott, F. A. and McCreary, J. P. Jr. (2001), The monsoon circulation of the Indian Ocean, Progress in Oceanography 51, 1-123, doi:10.1016/S0079-6611(01)00083-0.","source_locator":"Section 4.1.1, printed p. 38 (PDF page 38), March-May paragraph, final sentence and preceding northern-flow context.","source_retrieved_date":"2026-10-08","source_evidence_kind":"published_seasonal_synthesis_of_prior_observations","extraction_method":"Numerical seasonal width scale transcribed from inspected full original prose; no contour, section or raw observation digitization.","whole_current_representative":false,"width_rank_eligible":false,"full_width_inference_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"is_confidence_interval":false,"phase_label":"March-May northern coastal flow","phase_kind":"seasonal_regional_width_range","observed_period":null,"calendar_months":[3,4,5],"fixed_layer_bounds_m":null,"remaining_gates":["Recover underlying dated northern coastal sections and boundary convention.","Obtain compatible repeat widths across the other nine months before a yearly cycle.","Independent scientific and canonical admission."],"source_quality_note":"Full original review inspected and printed p. 38 rendered. This is a seasonal synthesis; underlying width occupations and boundary methods remain unextracted.","range_kind":"author_reported_seasonal_regional_width_scale_span","calendar_source_locator":"Section 4.1.1, printed p. 38 (PDF page 38), March-May paragraph heading.","seasonal_regional_context":{"southern_turnoff_latitude_is_width_edge":false,"undercurrent_is_same_width_layer":false,"Great_Whirl_scale_is_coastal_width":false,"season_months_are_monthly_measurements":false,"boundary_coordinates_extracted":false,"full_original_inspected":true,"protocol_file":"plans/somali-seasonal-width-protocol-v1.md","protocol_sha256":"5182a21bd951600e62581469470a0cf3a2b74d2ab17a7475e93d070d7e90e53a",
_asserted"},"figure_file":"figures/southern-east-madagascar-admitted-dimensions.svg","working_ranked_length_count":12,"physical_edges_admitted":false,"annual_extrema_admitted":false,"external_scientific_review_claimed":false},{"schema":"osw.nwasc-working-admission.v1","version":"1","id":"current_measurement_admission:norwegian-atlantic-slope","entity_id":"current:norwegian-atlantic-slope","current_id":"norwegian-atlantic-slope","entity":{"id":"current:norwegian-atlantic-slope","label":"Norwegian Atlantic Slope Current","type":"named_current","source_record_id":"norwegian-atlantic-slope","source_id":"source:nwasc-baumann-2026","source_kind":"source-defined Atlantic-water slope current","identity_level":"current","setting":"polar_or_subpolar_margin","time_behavior":"persistent_variable","basin":"Norwegian Sea / Nordic Seas","identity_scope_note":"Atlantic-water eastern slope branch along the Norwegian continental margin, with northern bifurcation. Distinct from ambiguous Norwegian Current, coastal current and western frontal branch. Parent Norwegian Atlantic Current remains a separately proposed identity.","almanac_url":"reference-routes.html#inventory-addition-norwegian-atlantic-slope","catalogue_version":"0.3.0-draft-nwasc","identity_admission_id":"current_admission:norwegian-atlantic-slope"},"identity_entry":{"id":"current_admission:norwegian-atlantic-slope","proposal_id":"norwegian-atlantic-slope","entity_id":"current:norwegian-atlantic-slope","entity":{"id":"current:norwegian-atlantic-slope","label":"Norwegian Atlantic Slope Current","type":"named_current","source_record_id":"norwegian-atlantic-slope","source_id":"source:nwasc-baumann-2026","source_kind":"source-defined Atlantic-water slope current","identity_level":"current","setting":"polar_or_subpolar_margin","time_behavior":"persistent_variable","basin":"Norwegian Sea / Nordic Seas","identity_scope_note":"Atlantic-water eastern slope branch along the Norwegian continental margin, with northern bifurcation. Distinct from ambiguous Norwegian Current, coastal current and western frontal branch. Parent Norwegian Atlantic Current remains a separately proposed identity.","almanac_url":"reference-routes.html#inventory-addition-norwegian-atlantic-slope","catalogue_version":"0.3.0-draft-nwasc","identity_admission_id":"current_admission:norwegian-atlantic-slope"},"source":{"kind":"external","material_use_class":"source_scoped_factual_claim","used_in_collections":["entities","names","claims","measurements","widths","current_identity_admissions"],"metadata_status":"Original source context inspected; working editorial admission, no external scientific approval.","id":"source:nwasc-baumann-2026","label":"Baumann et al. (2026): Norwegian Atlantic Slope Current","title":"Reduced cooling in the Norwegian Atlantic Slope Current: investigating mechanisms of change from 30 years of observations","doi":"10.5194/os-22-17-2026","url":"https://os.copernicus.org/articles/22/17/2026/","publication_date":"2026-01-05","rights_status":"CC BY 4.0","provider_asset_redistributed":true,"repository_path":"research/source-data/baumann-nwasc-2026/article.pdf","credit_text":"Baumann, Skagseth, Ingvaldsen and Mork (2026), Ocean Science 22, 17–29, CC BY 4.0."},"status":"working_identity_and_separately_scoped_dimensions_admitted","admission_date":"2026-10-22","review_type":"internal_editorial_primary_source_review","identity_evidence":[{"url":"https://os.copernicus.org/articles/22/17/2026/","citation":"Baumann, Skagseth, Ingvaldsen and Mork (2026), Reduced cooling in the Norwegian Atlantic Slope Current: investigating mechanisms of change from 30 years of observations, Ocean Science 22, 17–29, doi:10.5194/os-22-17-2026.","locator":"Introduction paragraphs on two branches and northern bifurcation; sections 2.1 and 2.1.2 on section sampling and distinct current-core definitions.","supports":"NwASC follows the Norwegian continental slope, with branches toward the Barents Sea and West Spitsbergen. Whole-current origin, termination and layer-specific geometry not extracted.","source_access":"Publisher relevant introduction and methods read, not all article sections; figures not digitized.","source_license":"Creative Commons Attribution 4.0","source_retrieved_date":"2026-10-03"},{"url":"https://os.copernicus.org/articles/6/901/2010/","citation":"Mork, K. A. and Skagseth, O. (2010), A quantitative description of the Norwegian Atlantic Current by combining altimetry and hydrography, Ocean Science 6, 901-911, doi:10.5194/os-6-901-2010.","locator":"Introduction and Fig. 1; Sections 3 and 4.1.1, pp.904 and 906.","supports":"Separate slope/front branch identities and method-dependent local widths; no total system width or annual envelope.","source_access":"Original eleven-page PDF acquired; methods/results/discussion and Figures 2-3 visually inspected. No raw ADT field or width boundaries digitized.","source_license":"CC BY 3.0","source_retrieved_date":"2026-10-08"}],"canonical_measurements_admitted":true,"rank_eligible":true,"physical_edges_admitted":false,"geometry":null,"annual_width_range_km":null,"annual_length_range_km":null,"seasonal_playback_eligible":false,"external_scientific_review_claimed":false,"remaining_measurement_gates":["Acquire a layer- and time-defined axis before mapped length and physical joins.","Acquire comparable repeated dated dimensions before annual envelopes and seasonal animation."],"identity_figure_file":"figures/norwegian-atlantic-slope-admitted-dimensions.svg","route_planning_decision":{"current_id":"norwegian-atlantic-slope","name":"Norwegian Atlantic Slope Current","candidate_ids":[],"published_length_rank_eligible":true,"route_strategy_id":"source_gated_boundary_current","route_strategy_label":"Source-gated slope-current route","reference_path_decision":"not_constructed","next_action":"Recover a source-supported axis with branch, layer, endpoint and time conventions.","existing_scope":"Author-reported approximate3500km eastern shelf-edge branch extent in Orvik and Skagseth (2003). Historical broad branch geography from Shetland toward the Arctic west of Svalbard at80°N is described in Orvik and Niiler (2001), not an independent length measurement. This broad scope may overlap flow now named West Spitsbergen Current; not an additive component length or a modern regional axis. No fixed layer, reference period, paired endpoint coordinates, error or annual range supplied.","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","name_source_url":"https://os.copernicus.org/articles/22/17/2026/","existing_length_evidence_status":"published_estimate","ledger_kind":"current","planning_basis":"Reported branch extent and scoped local widths do not supply source geometry.","strategy_next_action":"Recover independent route geometry; do not trace a physical route from scalar prose.","known_component_currents":[],"component_inventory_status":"parent_and_downstream_name_boundaries_retained"}},"entries":[{"id":"current_admission:southern-east-madagascar","proposal_id":"southern-east-madagascar","entity_id":"current:southern-east-madagascar","entity":{"id":"current:southern-east-madagascar","label":"Southern East Madagascar Current","type":"named_current","source_record_id":"southern-east-madagascar","source_id":"source:dddb5c5db92e5fe3","source_kind":"source-defined southward western boundary current","identity_level":"current","setting":"western_boundary","time_behavior":"persistent_variable","vertical_setting":"surface_expression","basin":"Southwest Indian Ocean","identity_scope_note":"Southward East Madagascar Current along southeast Madagascar. This proposal resolves the southern branch explicitly; it does not include the northward branch, underlying equatorward East Madagascar Undercurrent, offshore South Indian Ocean Countercurrent, or downstream eddies.","almanac_url":"reference-routes.html#inventory-addition-southern-east-madagascar","catalogue_version":"0.2.0-draft","identity_admission_id":"current_admission:southern-east-madagascar"},"source":{"id":"source:dddb5c5db92e5fe3","kind":"external","label":"Observations of the southern East Madagascar Current and undercurrent and countercurrent system","title":"Observations of the southern East Madagascar Current and undercurrent and countercurrent system","url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639","doi":"10.1029/2007JC004639","authors":["J. J. Nauw","H. M. van Aken","A. Webb","J. R. E. Lutjeharms","W. P. M. de Ruijter"],"publication_date_parts":[2008,8,5],"publisher":"American Geophysical Union","preferred_citation":"Nauw, van Aken, Webb, Lutjeharms and de Ruijter (2008), Observations of the southern East Madagascar Current and undercurrent and countercurrent system, JGR113, C08006, doi:10.1029/2007JC004639.","metadata_status":"Publisher full HTML and institutional publication record inspected; no original PDF acquired","material_use_class":"source_scoped_factual_claim","provider_asset_redistributed":false,"rights_status":"Reviewed narrow factual use: original paraphrase and linked source; no article or figure redistributed","rights_policy_url":"plans/current-identity-admission-protocol-v1.md","rights_review_date":"2026-10-21","path":null,"repository_path":null,"used_in_collections":["entities","names","length_assessments","current_identity_admissions"]},"status":"editorial_identity_admitted_measurements_separately_gated","admission_date":"2026-10-21","review_type":"internal_editorial_identity_review_not_external_scientific_peer_review","identity_evidence":{"source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639","source_locator":"Title; Introduction paragraph2; abstract; Results3.1 paragraph17","access_mode":"publisher_full_HTML_inspected_original_PDF_unavailable","decision":"The primary text explicitly identifies a southward East Madagascar Current. The southern qualifier distinguishes the named poleward branch from northward flow, the underlying equatorward undercurrent and offshore countercurrent.","classification_basis":"Introduction identifies the western boundary current of the South Indian subtropical gyre. Abstract describes near-surface expression and1992–2005 altimetry with eddy and interannual variability.","global_aliases_admitted":[],"parent_relationships_admitted":[]},"source_dimensions":{"schema":"osw.proposed-current-reported-dimensions.v1","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639","source_citation":"Nauw, van Aken, Webb, Lutjeharms and de Ruijter (2008), Observations of the southern East Madagascar Current and undercurrent and countercurrent system, JGR113, C08006, doi:10.1029/2007JC004639.","source_original_pdf_sha256":null,"source_license":"AGU/Wiley copyrighted publication; free access does not imply a redistribution license. Original factual summaries and OSW diagram only.","figure_file":"figures/southern-east-madagascar-reported-dimensions.svg","reported_length_rank_eligible":false,"physical_annual_width_range_km":null,"geographic_current_edges":null,"seasonal_playback_eligible":false,"records":[{"id":"southern-east-madagascar-nauw2008-reported-extent","dimension":"length","value_km":650,"approximate":true,"metric":"author_reported_southern_branch_extent","source_locator":"Introduction paragraph2","support":"Southward branch from approximately20S to Cap Sainte Marie at approximately25deg30minS. Source cites Duncan1970 and Lutjeharms1988b; this is a contextual literature estimate, not a new length measured by the2001 cruise.","observed_period":null,"fixed_layer_bounds_m":null,"endpoint_coordinates_lon_lat":null,"uncertainty_km":null,"is_annual_mean":false,"is_annual_extremum":false,"rank_eligible":false},{"id":"southern-east-madagascar-nauw2008-survey-width","dimension":"width","value_km":120,"approximate":true,"metric":"author_reported_near_surface_survey_width","source_locator":"Results3.1 paragraph17; abstract","support":"SectionsT5–T8 in April2001 off southeast Madagascar. Near-surface current structure uses VMADCP mean velocity in the upper100m. Numeric edge cutoff, boundary coordinates and width uncertainty are not specified in this passage.","observed_period":"2001-04","fixed_layer_bounds_m":null,"velocity_averaging_layer_m":[0,100],"velocity_averaging_layer_is_verified_width_layer":false,"endpoint_coordinates_lon_lat":null,"uncertainty_km":null,"is_annual_mean":false,"is_annual_extremum":false,"rank_eligible":false}],"interpretation":"Separate source-reported dimensions, not the sides of a current footprint. April2001 width and contextual branch length must not be multiplied into an area. No seasonal range, dated axis, fixed width layer or annual mean inferred."},"canonical_measurements_admitted":false,"rank_eligible":false,"physical_edges_admitted":false,"geometry":null,"annual_width_range_km":null,"annual_length_range_km":null,"seasonal_playback_eligible":false,"external_scientific_review_claimed":false,"remaining_measurement_gates":["Acquire and visually review original figures before quantitative measurement admission.","Recover paired velocity boundaries, layer and error convention for width measurements.","Recover source-supported route geometry and repeat temporal support before annual ranges, seasonal animation or state intersections."],"identity_figure_file":"figures/southern-east-madagascar-admitted-identity.svg","route_planning_decision":{"current_id":"southern-east-madagascar","name":"Southern East Madagascar Current","candidate_ids":[],"published_length_rank_eligible":false,"route_strategy_id":"source_gated_boundary_current","route_strategy_label":"Source-gated boundary-current route","reference_path_decision":"not_constructed","next_action":"Acquire source-supported route geometry with layer, start/end gates and time support; retain contextual extent separately.","existing_scope":"Southward branch identity admitted; no geographic axis or current-edge coordinates recovered.","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","name_source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639","existing_length_evidence_status":"reported_contextual_extent_pending_measurement_admission","ledger_kind":"current","planning_basis":"Source-supported southern current identity; no source-defined route geometry has been recovered.","strategy_next_action":"Recover a source-supported current-axis route with explicit layer, source period and endpoint convention.","known_component_currents":[],"component_inventory_status":"no_component_inventory_asserted"}},{"id":"current_admission:norwegian-atlantic-slope","proposal_id":"norwegian-atlantic-slope","entity_id":"current:norwegian-atlantic-slope","entity":{"id":"current:norwegian-atlantic-slope","label":"Norwegian Atlantic Slope Current","type":"named_current","source_record_id":"norwegian-atlantic-slope","source_id":"source:nwasc-baumann-2026","source_kind":"source-defined Atlantic-water slope current","identity_level":"current","setting":"polar_or_subpolar_margin","time_behavior":"persistent_variable","basin":"Norwegian Sea / Nordic Seas","identity_scope_note":"Atlantic-water eastern slope branch along the Norwegian continental margin, with northern bifurcation. Distinct from ambiguous Norwegian Current, coastal current and western frontal branch. Parent Norwegian Atlantic Current remains a separately proposed identity.","almanac_url":"reference-routes.html#inventory-addition-norwegian-atlantic-slope","catalogue_version":"0.3.0-draft-nwasc","identity_admission_id":"current_admission:norwegian-atlantic-slope"},"source":{"kind":"external","material_use_class":"source_scoped_factual_claim","used_in_collections":["entities","names","claims","measurements","widths","current_identity_admissions"],"metadata_status":"Original source context inspected; working editorial admission, no external scientific approval.","id":"source:nwasc-baumann-2026","label":"Baumann et al. (2026): Norwegian Atlantic Slope Current","title":"Reduced cooling in the Norwegian Atlantic Slope Current: investigating mechanisms of change from 30 years of observations","doi":"10.5194/os-22-17-2026","url":"https://os.copernicus.org/articles/22/17/2026/","publication_date":"2026-01-05","rights_status":"CC BY 4.0","provider_asset_redistributed":true,"repository_path":"research/source-data/baumann-nwasc-2026/article.pdf","credit_text":"Baumann, Skagseth, Ingvaldsen and Mork (2026), Ocean Science 22, 17–29, CC BY 4.0."},"status":"working_identity_and_separately_scoped_dimensions_admitted","admission_date":"2026-10-22","review_type":"internal_editorial_primary_source_review","identity_evidence":[{"url":"https://os.copernicus.org/articles/22/17/2026/","citation":"Baumann, Skagseth, Ingvaldsen and Mork (2026), Reduced cooling in the Norwegian Atlantic Slope Current: investigating mechanisms of change from 30 years of observations, Ocean Science 22, 17–29, doi:10.5194/os-22-17-2026.","locator":"Introduction paragraphs on two branches and northern bifurcation; sections 2.1 and 2.1.2 on section sampling and distinct current-core definitions.","supports":"NwASC follows the Norwegian continental slope, with branches toward the Barents Sea and West Spitsbergen. Whole-current origin, termination and layer-specific geometry not extracted.","source_access":"Publisher relevant introduction and methods read, not all article sections; figures not digitized.","source_license":"Creative Commons Attribution 4.0","source_retrieved_date":"2026-10-03"},{"url":"https://os.copernicus.org/articles/6/901/2010/","citation":"Mork, K. A. and Skagseth, O. (2010), A quantitative description of the Norwegian Atlantic Current by combining altimetry and hydrography, Ocean Science 6, 901-911, doi:10.5194/os-6-901-2010.","locator":"Introduction and Fig. 1; Sections 3 and 4.1.1, pp.904 and 906.","supports":"Separate slope/front branch identities and method-dependent local widths; no total system width or annual envelope.","source_access":"Original eleven-page PDF acquired; methods/results/discussion and Figures 2-3 visually inspected. No raw ADT field or width boundaries digitized.","source_license":"CC BY 3.0","source_retrieved_date":"2026-10-08"}],"canonical_measurements_admitted":true,"rank_eligible":true,"physical_edges_admitted":false,"geometry":null,"annual_width_range_km":null,"annual_length_range_km":null,"seasonal_playback_eligible":false,"external_scientific_review_claimed":false,"remaining_measurement_gates":["Acquire a layer- and time-defined axis before mapped length and physical joins.","Acquire comparable repeated dated dimensions before annual envelopes and seasonal animation."],"identity_figure_file":"figures/norwegian-atlantic-slope-admitted-dimensions.svg","route_planning_decision":{"current_id":"norwegian-atlantic-slope","name":"Norwegian Atlantic Slope Current","candidate_ids":[],"published_length_rank_eligible":true,"route_strategy_id":"source_gated_boundary_current","route_strategy_label":"Source-gated slope-current route","reference_path_decision":"not_constructed","next_action":"Recover a source-supported axis with branch, layer, endpoint and time conventions.","existing_scope":"Author-reported approximate3500km eastern shelf-edge branch extent in Orvik and Skagseth (2003). Historical broad branch geography from Shetland toward the Arctic west of Svalbard at80°N is described in Orvik and Niiler (2001), not an independent length measurement. This broad scope may overlap flow now named West Spitsbergen Current; not an additive component length or a modern regional axis. No fixed layer, reference period, paired endpoint coordinates, error or annual range supplied.","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","name_source_url":"https://os.copernicus.org/articles/22/17/2026/","existing_length_evidence_status":"published_estimate","ledger_kind":"current","planning_basis":"Reported branch extent and scoped local widths do not supply source geometry.","strategy_next_action":"Recover independent route geometry; do not trace a physical route from scalar prose.","known_component_currents":[],"component_inventory_status":"parent_and_downstream_name_boundaries_retained"}}],"source_records":[{"kind":"external","material_use_class":"source_scoped_factual_claim","used_in_collections":["entities","names","claims","measurements","widths","current_identity_admissions"],"metadata_status":"Original source context inspected; working editorial admission, no external scientific approval.","id":"source:nwasc-baumann-2026","label":"Baumann et al. (2026): Norwegian Atlantic Slope Current","title":"Reduced cooling in the Norwegian Atlantic Slope Current: investigating mechanisms of change from 30 years of observations","doi":"10.5194/os-22-17-2026","url":"https://os.copernicus.org/articles/22/17/2026/","publication_date":"2026-01-05","rights_status":"CC BY 4.0","provider_asset_redistributed":true,"repository_path":"research/source-data/baumann-nwasc-2026/article.pdf","credit_text":"Baumann, Skagseth, Ingvaldsen and Mork (2026), Ocean Science 22, 17–29, CC BY 4.0."},{"kind":"external","material_use_class":"source_scoped_factual_claim","used_in_collections":["entities","names","claims","measurements","widths","current_identity_admissions"],"metadata_status":"Original source context inspected; working editorial admission, no external scientific approval.","id":"source:nwasc-orvik-skagseth-2003","label":"Orvik and Skagseth (2003): broad eastern shelf-edge branch extent","title":"The impact of the wind stress curl in the North Atlantic on the Atlantic inflow to the Norwegian Sea toward the Arctic","doi":"10.1029/2003GL017932","url":"https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2003GL017932","publication_date":"2003-09-04","rights_status":"Linked factual paraphrase; original article and figures not redistributed.","provider_asset_redistributed":false,"repository_path":null,"metadata_note":"Original publisher full-text prose inspected through web retrieval. Direct HTML/PDF returned403. No original2003 PDF or figure custody claimed."},{"kind":"external","material_use_class":"source_scoped_factual_claim","used_in_collections":["entities","names","claims","measurements","widths","current_identity_admissions"],"metadata_status":"Original source context inspected; working editorial admission, no external scientific approval.","id":"source:nwasc-orvik-niiler-2001-context","label":"Orvik and Niiler (2001): eastern branch geographic context","title":"Circulation of Atlantic water in the northern North Atlantic and Nordic Seas","doi":"10.17895/ices.pub.25636341.v1","url":"https://doi.org/10.17895/ices.pub.25636341.v1","publication_date":null,"original_publication_year":2001,"repository_deposit_date":"2024-04-25","rights_status":"ICES Custom Licence. Only factual metadata and OSW paraphrase redistributed.","provider_asset_redistributed":false,"repository_path":"research/source-data/orvik-niiler-ices-2001/acquisition.json","metadata_note":"Original17-page report verified against provider MD5 and locally inspected. Original PDF, rendered pages and abstract not redistributed; geographic context is not independent length measurement."}],"measurement":{"id":"measurement:norwegian-atlantic-slope:reported-extent","claim_id":"claim:measurement:norwegian-atlantic-slope:reported-extent","entity_id":"current:norwegian-atlantic-slope","quantity":"reported_length","value":3500,"unit":"km","approximate":true,"rank_eligible":true,"evidence_status":"published_estimate","source_id":"source:nwasc-orvik-skagseth-2003","source_locator":"Introduction paragraph[3], eastern NwASC branch description.","scope":"Author-reported approximate3500km eastern shelf-edge branch extent in Orvik and Skagseth (2003). Historical broad branch geography from Shetland toward the Arctic west of Svalbard at80°N is described in Orvik and Niiler (2001), not an independent length measurement. This broad scope may overlap flow now named West Spitsbergen Current; not an additive component length or a modern regional axis. No fixed layer, reference period, paired endpoint coordinates, error or annual range supplied.","geometry_id":null,"observation_time":null,"fixed_layer_bounds_m":null,"endpoint_coordinates_lon_lat":null,"reference_period":null,"uncertainty_km":null,"annual_length_range_km":null,"source_report_type":"contextual_broad_branch_extent_not_new_axis_measurement","supporting_source_ids":["source:nwasc-orvik-niiler-2001-context"],"historical_release_admitted":false},"claim":{"id":"claim:measurement:norwegian-atlantic-slope:reported-extent","subject_id":"current:norwegian-atlantic-slope","object_id":null,"predicate":"reported_length","value":3500,"unit":"km","target_collection":"measurements","target_id":"measurement:norwegian-atlantic-slope:reported-extent","source_id":"source:nwasc-orvik-skagseth-2003","source_locator":"Introduction paragraph[3], eastern NwASC branch description.","source_locator_status":"specific","source_date":"2003-09-04","source_snapshot_id":null,"support_claim_id":null,"evidence_class":"published_estimate","assertion_status":"reported_or_derived_measurement","scope":"Author-reported approximate3500km eastern shelf-edge branch extent in Orvik and Skagseth (2003). Historical broad branch geography from Shetland toward the Arctic west of Svalbard at80°N is described in Orvik and Niiler (2001), not an independent length measurement. This broad scope may overlap flow now named West Spitsbergen Current; not an additive component length or a modern regional axis. No fixed layer, reference period, paired endpoint coordinates, error or annual range supplied.","observation_time":null,"method":"Linked factual extraction; reported extent not a new path calculation.","method_source_id":"source:nwasc-orvik-skagseth-2003","method_status":"described","review_status":"not_individually_reviewed","reviewer":null,"review_date":n
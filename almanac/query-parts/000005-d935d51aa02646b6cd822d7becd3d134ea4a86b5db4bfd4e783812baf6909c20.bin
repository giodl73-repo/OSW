":"research/somali-winter-reference-path-candidate.json","route_candidate_sha256":"37cf752d61cfcfff451e3066e842e00f524b78400573b28ff731cf3ff12f4cda","geometry_role":"osw_editorial_reference_route","width_measurement_ids":[],"source_url":"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf","source_locator":"Section 4.2.1, printed pages 48-49 (PDF indices 47-48): southward surface flow reaches EACC confluence at 2-4 S; winter coastal divergence near 6-8 N. Section 4.2.2 distinguishes modeled coastal continuation and northern countercurrent.","entity_id":"current:somali","label":"Somali Current — Northeast winter monsoon","status":"editorial_seasonal_route_associations_not_canonical","seasonal_inventory_file":"research/ocean-current-seasonal-route-frames.json","seasonal_inventory_sha256":"5e2bbbcf1aa91253b8ca7d114765364640f62390533af513f205764af63e4422","coordinates_lon_lat":[[50.2,7],[48.9,5],[47.2,3],[44.7,1],[43.4,0],[42.2,-1.5],[41.5,-3]],"comparability":{"current_id":"somali","annual_length_range_km":null,"annual_width_range_km":null,"annual_extrema_eligible":false,"reason":"Winter coastal branch and June-July southern limb have different source-defined spatial scopes; their nominal lengths or scenario bounds do not define annual whole-current extrema."}},{"id":"somali-summer-southern","current_id":"somali","phase_label":"June-July southern limb","flow_direction":"northward","calendar_months":[6,7],"time_convention":"June-July monsoon-onset two-gyre convention. Does not assume rare late-summer gyre coalescence or persistent whole-coast continuity.","layer":"Upper-layer southern seasonal coastal geography; no fixed-depth or velocity-derived axis.","route_candidate_file":"research/somali-summer-southern-reference-path-candidate.json","route_candidate_sha256":"73efa37ee93f5a6985c891bb524fc2ec0d443d17807de420fc7a03a44ab5b295","geometry_role":"osw_editorial_reference_route","width_measurement_ids":[],"source_url":"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf","source_locator":"Section 4.1.1, printed page 38 (PDF index 37): June-July cross-equatorial limb departs the coast south of 4 N, partitions into offshore outflow/recirculation and has little exchange with Great Whirl. Printed pages 41-43 discuss non-universal gyre coalescence.","entity_id":"current:somali","label":"Somali Current — June-July southern limb","status":"editorial_seasonal_route_associations_not_canonical","seasonal_inventory_file":"research/ocean-current-seasonal-route-frames.json","seasonal_inventory_sha256":"5e2bbbcf1aa91253b8ca7d114765364640f62390533af513f205764af63e4422","coordinates_lon_lat":[[43.4,0],[44.7,1],[46,2],[47.2,3],[47.7,3.5]],"comparability":{"current_id":"somali","annual_length_range_km":null,"annual_width_range_km":null,"annual_extrema_eligible":false,"reason":"Winter coastal branch and June-July southern limb have different source-defined spatial scopes; their nominal lengths or scenario bounds do not define annual whole-current extrema."}},{"id":"davidson-historical-winter","current_id":"davidson","phase_label":"October-March (1978 regional summary)","flow_direction":"northward","calendar_months":[10,11,12,1,2,3],"route_candidate_file":"research/davidson-winter-reference-path-candidate.json","route_candidate_sha256":"ac2db281859e27e8903fb224f3fdde35b36f010ab111240e2a2c78e3c5a26609","geometry_role":"osw_editorial_reference_route","width_measurement_ids":["davidson-historical-winter-width"],"width_support_role":"regional_source_context_not_uniform_route_width","width_scope_note":"Approximate 64 km is historical California-Oregon regional context; it is not applied uniformly to the editorial route or used as an occupied footprint.","time_convention":"October-March California-Oregon regional seasonal description in the February 1978 report; strongest flow described in January. Historical summary, not a dated trajectory, current-year observation or modern monthly climatology.","layer":"Seasonal northward surface-current regional context; not the separately described California Undercurrent below 200 m or a reconstructed velocity axis.","source_url":"https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/40591190_v2.pdf","source_locator":"Appendix II section II.1, printed II-1 to II-2 / PDF pages 12-13: northward seasonal surface strip along California and Oregon from October to March; Vancouver Island penetration is conditional.","entity_id":"current:davidson","label":"Davidson Current — October-March (1978 regional summary)","status":"editorial_seasonal_route_associations_not_canonical","seasonal_inventory_file":"research/ocean-current-seasonal-route-frames.json","seasonal_inventory_sha256":"5e2bbbcf1aa91253b8ca7d114765364640f62390533af513f205764af63e4422","coordinates_lon_lat":[[-121.1,35],[-122.55,37],[-124.1,39],[-124.65,41],[-124.9,43],[-124.9,45],[-124.6,46]],"comparability":{"current_id":"davidson","annual_length_range_km":null,"annual_width_range_km":null,"annual_extrema_eligible":false,"reason":"Only historical October-March California-Oregon reference geography and width context are available. April-September width and seasonal route geometry remain unknown; no modern annual cycle, seasonal extrema or uniform width footprint established."}},{"id":"monsoon-summer-sri-lanka","current_id":"monsoon","phase_label":"Southwest Monsoon Current · June–September eastward regional reach","flow_direction":"eastward","calendar_months":[6,7,8,9],"source_season_label":"summer","route_candidate_file":"research/monsoon-summer-sri-lanka-reference-path-candidate.json","route_candidate_sha256":"1074de5de5d68f6ca753a8eafdb2fea5eaecd20204f008c6df156e3c21940f92","geometry_role":"osw_editorial_reference_route","width_measurement_ids":[],"time_convention":"Boreal summer source convention, June–September. Historical review and section context, not a simultaneous dated trajectory or current-year climatology.","layer":"Seasonal near-surface regional geography. Historical section evidence is shallow and depth dependent; no fixed-depth velocity axis reconstructed and undercurrents excluded.","source_url":"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf","source_locator":"Schott and McCreary (2001), section 5.1.5, printed pp. 63–65 / PDF indices 62–64: seasonal directions/months, Sri Lanka bottleneck and separate upper-layer/undercurrent flows. August 1993 and January 1991 sections provide local latitude context, not regional axis vertices.","entity_id":"current:monsoon","label":"Monsoon Current — Southwest Monsoon Current · June–September eastward regional reach","status":"editorial_seasonal_route_associations_not_canonical","seasonal_inventory_file":"research/ocean-current-seasonal-route-frames.json","seasonal_inventory_sha256":"5e2bbbcf1aa91253b8ca7d114765364640f62390533af513f205764af63e4422","coordinates_lon_lat":[[77,4],[78.5,4],[80.5,4],[82,4.5],[83,6]],"comparability":{"current_id":"monsoon","annual_length_range_km":null,"annual_width_range_km":null,"annual_extrema_eligible":false,"reason":"Two source-defined seasonal phases with editorial 77–83 E regional drawings. Their different latitude choices and scenario envelopes are not observed annual length minima/maxima. March–May and October geometry and all seasonal widths remain unresolved; month labels do not provide monthly velocity fields."}},{"id":"monsoon-winter-sri-lanka","current_id":"monsoon","phase_label":"Northeast Monsoon Current · November–February westward regional reach","flow_direction":"westward","calendar_months":[11,12,1,2],"source_season_label":"winter","route_candidate_file":"research/monsoon-winter-sri-lanka-reference-path-candidate.json","route_candidate_sha256":"050f03273c082601dd425ad8221c6f038bcc152c4f2978e58dde9af6e60f4334","geometry_role":"osw_editorial_reference_route","width_measurement_ids":[],"time_convention":"Boreal winter source convention, November–February. Historical review and section context, not a simultaneous dated trajectory or current-year climatology.","layer":"S
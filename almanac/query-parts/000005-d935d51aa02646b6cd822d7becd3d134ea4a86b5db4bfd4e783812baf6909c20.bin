e_time_indices":[427,428,429,430,431,432,433,434,435,436,437],"native_legs":[{"from_source_time_index":426,"to_source_time_index":427,"time_gap_minutes":60.0,"spacing_km":16.224956,"bearing_degrees_true":178.216093},{"from_source_time_index":427,"to_source_time_index":428,"time_gap_minutes":60.0,"spacing_km":8.640213,"bearing_degrees_true":176.039801},{"from_source_time_index":428,"to_source_time_index":429,"time_gap_minutes":60.0,"spacing_km":0.556008,"bearing_degrees_true":343.624669},{"from_source_time_index":429,"to_source_time_index":430,"time_gap_minutes":60.0,"spacing_km":0.741155,"bearing_degrees_true":223.967556},{"from_source_time_index":430,"to_source_time_index":431,"time_gap_minutes":60.0,"spacing_km":0.462705,"bearing_degrees_true":30.179646},{"from_source_time_index":431,"to_source_time_index":432,"time_gap_minutes":60.0,"spacing_km":0.646792,"bearing_degrees_true":168.156243},{"from_source_time_index":432,"to_source_time_index":433,"time_gap_minutes":60.0,"spacing_km":1.027758,"bearing_degrees_true":186.073678},{"from_source_time_index":433,"to_source_time_index":434,"time_gap_minutes":60.0,"spacing_km":0.846735,"bearing_degrees_true":141.916506},{"from_source_time_index":434,"to_source_time_index":435,"time_gap_minutes":60.0,"spacing_km":0.294971,"bearing_degrees_true":145.830992},{"from_source_time_index":435,"to_source_time_index":436,"time_gap_minutes":59.0,"spacing_km":4.376522,"bearing_degrees_true":169.959327},{"from_source_time_index":436,"to_source_time_index":437,"time_gap_minutes":59.0,"spacing_km":16.006881,"bearing_degrees_true":180.803537},{"from_source_time_index":437,"to_source_time_index":438,"time_gap_minutes":60.0,"spacing_km":17.646595,"bearing_degrees_true":181.812468}],"bracketing_observation_elapsed_hours":11.966666666666667,"track_length_between_crossings_km":58.425868,"track_length_to_endpoint_distance_ratio":1.04464824,"northward_steps_including_brackets":2,"largest_native_spacing_km":17.646595,"endpoint_distance_in_largest_native_spacings":3.16937902,"fewer_than_four_native_spacings":true,"bracket_endpoint_combination_distances_km":[31.131968,48.745325,47.355828,64.969178],"bracket_endpoint_combination_spread_km":[31.131968,64.969178],"bracket_spread_is_error_or_confidence_bounds":false}],"complete_boundary_choice_envelope_km":[60,90],"peak_at_window_sample_edge":false,"status":"evaluated"}],"current_association_verified":false,"new_width_record_admitted":false,"whole_current_width_km":null,"annual_width_range_km":null,"width_rank_eligible":false,"physical_edge_geometry_admitted":false,"seasonal_playback_supported":false,"sensitivity_is_confidence_interval":false,"observed_track_reordered_by_latitude":false,"interpretation":["Source paper places branches near 45 N and 42 N and an eddy near 41.5 N. Its same-cruise interpretation does not validate these OSW component boundaries.","Acquisition order includes CTD occupations and northward steps. These means are not exclusively underway cross-track velocities.","Threshold-choice and velocity-perturbation scenarios are separate finite sensitivities, not annual ranges or total measurement uncertainty.","CTD companion retains quality codes, nominal-bottom pairing ambiguity and unresolved historical temperature-correction notice. No new water-mass classification is made."],"calculation_readback_protocol":"plans/scientific-calculation-readback-protocol-v1.md"},"research_evidence":{"current_id":"aleutian","label":"Aleutian / Subarctic Current","diagnostic_id":"diagnostic:current-research:aleutian","title":"July 1993 observed section: paired current velocities","finding":"The July 1993 observations resolve local eastward-component spans of about 100 km in the northern branch window and 80 km in the southern window. Threshold-choice envelopes are 90–110 km and 60–90 km. Temporal crossings, velocity sensitivity and nearby eddy flow prevent treating these as verified physical current widths.","facts":[{"label":"Observed sampling","value":"132 profiles · 13–18 July 1993"},{"label":"Joint vector support","value":"4,030 / 4,092 positions"},{"label":"Primary depth layer","value":"100–300 m"},{"label":"Supported layer means","value":"131 / 132 profiles"},{"label":"Companion hydrography","value":"17 casts · 84 candidate profile pairs"},{"label":"Local 50% component spans","value":"North ≈100 km · south ≈80 km"},{"label":"Complete declared scenarios","value":"14 / 14 resolved"},{"label":"Native regional support","value":"1,585 profiles · 1,582 layer means"},{"label":"Native underway eligibility","value":"568 profiles · 19 runs at ≥2 m/s"},{"label":"Native averaging boundary tests","value":"126 / 126 unresolved"},{"label":"Conditional run-composite tests","value":"18 / 126 sensitivity cases resolve; all nominal 50% cases unresolved"},{"label":"Physical current width","value":"Unknown"}],"notes":["Hourly archive means at 10 m depth levels are reduced products, not the native five-minute ensembles or four-metre acquisition bins.","Layer means use midpoint cell thickness clipped to 100–300 m, joint u/v validity and at least 160 m valid support. Missing velocities remain missing; no vertical interpolation or component-to-speed substitution.","The source track has 16 northward latitude steps and one two-hour gap. Points remain in acquisition order. The plot breaks the mean curve at the long gap; it does not silently fit a monotone current crossing.","The paper places Subarctic branches near 42 N and 45 N. Fixed 41–43 N and 44–46 N windows are search context, not physical edges. The westward Alaskan Stream and Bering-side Aleutian North Slope Current are distinct.","Provider metadata describe GPS selective availability, heading correction and CTD wire interference editing. Per-cell native editing history is not included in this reduced archive.","One July 1993 transect is not a seasonal climatology or annual width range. No current-edge geometry, full width, uncertainty interval or seasonal playback is admitted. The separate 2013 OSCAR component diagnostic is retained.","A separate whole-run composite explicitly tests interpolation between summary positions under 3/6/12 hour gap caps, a 25 km unobserved-distance cap and unchanged source-order/quality barriers. All 18 nominal half-peak cases remain unresolved. Only northern 60% and positive threshold-offset cases resolve with 6/12 hour caps: 18 of 126 cases. Their about 80–140 km separations are different assumptions, not a width range. Their full bracketing observations span about 23 hours; temporal comparability and physical branch identity remain unverified. This does not replace the earlier no-bridge negative result.","A separate exploratory OSW operator averages native supported layer means within each contiguous underway run, using fixed 30/60/150 minute windows and 1/2/3 m/s ship-speed cutoffs. Overlapping ensemble time is counted once and boundary analysis requires at least 80% of the full window duration. All 54 relative-peak and 72 velocity-sensitivity cases lack two resolved crossings. No station gap is bridged; run ends and incomplete windows cannot substitute for boundaries.","The separate native products retain 1,585 regional ensemble profiles and 190,200 depth cells in their original files. There are 1,582 supported 100–300 m means and 182,081 jointly finite unflagged vectors. CODAS editing bits are distinct from CTD WOCE quality codes.","Fixed ship-speed eligibility at 1/2/3 m/s gives 623/568/532 profiles in 42/19/19 contiguous runs. Every run remains available, including short ones. Source gaps, missing support and ineligible profiles break runs; no latitude sorting or station-gap bridge is applied.","All 685 profiles whose nominal ensemble intervals overlap recorded CTD BE–EN events fall outside the ≥2 m/s eligibility class. This event/speed agreement is context, not proof of depth-specific simultaneity or a new CTD-wire interference flag.","Short-product ocean velocities already include ship motion; numerical correspondence with the long relative-water/absolute-ship fields is checked. Actual ensemble durations are 300 seconds; timestamps and positions refer to ensemble end, and depths are nominal bin centres. OSW applies no further temporal ocean-velocity averaging in this audit.","All 14 declared component scenarios resolve within the original fixed windows. Nominal half-peak endpoint separations are about 100 km north and 80 km south; 40/50/60% envelopes are 90–110 km and 60–90 km, not error bounds or annual ranges.","The northern first crossing bracket spans only 0.34 km in one hour near a CTD occupation. Nominal bracketing observations span about 13 hours north and 14 hours south. Temporal change can masquerade as a spatial edge.","Separate ±0.02 and ±0.06 m/s threshold-comparator scenarios yield roughly 43–152 km north and 56–90 km south. They explore GPS-related hourly velocity sensitivity; they are not a total error budget or a confidence interval. No rotation to a flow-normal width is applied.","Companion CCHDO hydrography retains 17 casts and all 84 qualifying cast-to-hourly-profile pairs within three hours of nominal cast-bottom time and 15 km. No nearest-only selection or interpolation is applied. Forty-eight hourly velocity profiles have no qualifying pair.","All 17 nominal timestamps agree with unique BO (bottom) events in the original station log. This does not establish simultaneous sampling at 100–300 m. Cast beginning/end events and actual offsets remain inspectable.","Of 3,009 upper-ocean property cells, 2,525 meet joint WOCE QC2. Raw edited/despiked code7 and questionable code3 values remain available; other codes are not silently relabeled missing or acceptable.","Temperature is in-situ ITS-90; salinity is practical PSS-78. Pressure is retained in dbar beside depth converted with GSW3.6.23. The source-history temperature-correction notice remains unresolved and is not reapplied.","Calculated readbacks use a declared precision for reproducibility. That precision is not observational uncertainty or an annual range. Original source values, masks and quality flags remain unchanged; the exact record pins the calculation rules."],"next_evidence":"The separate declared run composite does not recover nominal half-peak boundaries under any tested gap cap. Eighteen other threshold cases resolve only under temporal-comparability assumptions and about 23 hours of bracketing observations. Independent repeated sections, branch/eddy attribution and transverse boundary support remain required; do not tune thresholds to replace the unresolved nominal result.","figure_file":"figures/aleutian-p14n-1993-observed-vectors.svg","figure_label":"Observed velocity section","additional_figures":[{"file":"figures/aleutian-p14n-1993-hydrography-correspondence.svg","label":"CTD properties and pairing offsets","alt":"Measured in-situ ITS-90 temperature and PSS-78 salinity at 17 casts; QC2 cells and other quality codes distinguished; original velocity profiles and 84 candidate timing/distance offsets. No interpolated physical current edges."},{"file":"figures/aleutian-p14n-1993-component-spans.svg","label":"Component spans and sensitivity","alt":"Both branch windows show actual vector means, half-peak crossings and native brackets; fourteen finite threshold and velocity scenarios remain separate. North about 100 km and south about 80 km are local component spans, not physical widths or annual ranges."},{"file":"figures/aleutian-p14n-1993-native-vector-support.svg","label":"Native vectors and ship-motion support","alt":"Actual native observation latitude, ship-speed magnitude and both 100–300 m ocean velocity components against UTC ensemble end. Recorded CTD begin/end intervals and fixed ship-speed scenarios remain distinct. Source editing flags, gaps and uncertainty do not define physical current edges."},{"file":"figures/aleutian-p14n-1993-underway-averages.svg","label":"Native averages: unresolved boundaries","alt":"Six panels compare northern and southern 100–300 m eastward means for fixed 30, 60 and 150 minute windows and all three ship-speed cutoffs. Horizontal bars are contributor latitude footprints, not uncertainty or edges. Hollow markers have less than 80% time coverage. All 54 relative-peak and 72 velocity-sensitivity scenarios remain unresolved. Station gaps are not bridged; no physical width or annual range is admitted."},{"file":"figures/aleutian-p14n-1993-run-composite.svg","label":"Conditional run composite: gap assumptions","alt":"Whole-run eastward means and spatial footprints remain in source order. Dashed links assume temporal comparability across eligible gaps, not measured velocities inside them. The complete 126-case matrix retains all 18 unresolved nominal half-peak cases and 18 successful sensitivity cases under other thresholds. Successful northern spans of about 80–140 km use roughly 23 hours of bracketing observations; these are separate assumptions, not a physical width range or uncertainty interval."}],"figure_alt":"Unconnected P14N sampling locations; observed eastward and northward velocity by latitude and depth; 100–300 m layer means with a gap break. Missing values are marked and no physical current boundaries are drawn.","source_file":"research/aleutian-p14n-1993-component-spans.json","source_pointer":"","observation_kind":"direct_shipboard_adcp_velocity","observation_source_file":"research/aleutian-p14n-1993-native-vector-support.json","observation_times_utc":["1993-07-13T07:16:22Z","1993-07-18T20:40:20Z"],"support_source_sha256":{"research/aleutian-p14n-1993-native-product-metadata.json":"6b5050ba8c1aeaf08667df95ad432c1ab5faa63b563b8161f40dbb3d3906c859","research/aleutian-p14n-1993-native-vector-support-figure.json":"735caa73ef432edbc392325df4f9c541e7143659b3b4134ba0a0422e93df3118","research/aleutian-p14n-1993-native-vector-support.json":"d72cd5f1b01b02857029d325d32d59f84cf0559054e044290bafdcc29f11eeae","research/source-data/jasadcp-p14n-1993-native/acquisition.json":"be53aa
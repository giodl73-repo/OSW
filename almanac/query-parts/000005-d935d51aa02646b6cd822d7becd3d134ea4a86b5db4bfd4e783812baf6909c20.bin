 phrase.","whole_current_representative":false,"width_rank_eligible":false,"full_width_inference_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"is_confidence_interval":false,"phase_label":"Reported offshore geographic breadth","phase_kind":"regional_summary","observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"uncertainty_km":null,"source_quality_note":"Government environmental synthesis, not a primary width-section analysis. The report cites Schott and McCreary (2001); identical named-current numeric wording was not found in inspected review text. Printed latitude 60 E mixes coordinate type and hemisphere notation.","remaining_gates":["Recover the underlying velocity-based breadth definition and compatible layer/time support.","Resolve the printed coordinate-type conflict independently of the source inequality.","Review historical narrow-stream versus offshore-current naming without pooling dimensions.","Obtain repeated comparable sections before annual width ranges or map geometry.","Independent scientific and canonical admission."],"original_regional_context":{"width_passage_visually_inspected":true,"source_class":"government_environmental_synthesis","quantity_scope":"offshore_geographic_breadth_not_velocity_core_width","underlying_width_methods_reviewed":false,"reference_scale_is_point_width":false,"notation_is_rigorous_lower_bound":false,"finite_upper_width_extracted":false,"span_is_annual_range":false,"publication_year_is_width_occupation":false,"adjacent_summer_inflow_is_breadth_support":false,"schematic_is_velocity_axis":false,"boundary_coordinates_extracted":false,"coordinate_conflict":{"source_phrase":"latitude 60 E","coordinate_type_agrees_with_hemisphere_notation":false,"coordinate_repaired":false,"used_for_kilometre_conversion":false},"historical_stream_context":{"source_citation":"Andrews (1977), doi:10.1016/0146-6291(77)90517-3","source_access":"Publisher-indexed abstract; original full articl
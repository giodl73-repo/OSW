ation.","boundary_rule":"Author-reported order-of-magnitude less-than band size. Exceeding 80 cm/s describes speed, not an adopted width-edge cutoff.","source_url":"https://oceanrep.geomar.de/1816/1/news34.pdf","source_citation":"Zenk, W., G. Siedler, J. Holfort and O. Boebel (1999), Float Observations Showing the Equatorial Crossing of Antarctic Intermediate Water in the Western Pacific, International WOCE Newsletter 34 (March), pp10–14, printed p13. Unpublished manuscript / work-in-progress newsletter report.","source_locator":"Printed/PDF p13 first column, continuation from p10; article pp10–14. Copyright PDF page 44. Figure 3 cruise-label conflict on p13.","source_retrieved_date":"2026-10-08","source_evidence_kind":"published_original_local_doppler_band_size_constraint","extraction_method":"Qualifier and reference size transcribed from visually inspected original; no profile digitization, exact crossing pairing or doubled downstream value.","whole_current_representative":false,"width_rank_eligible":false,"full_width_inference_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"is_confidence_interval":false,"phase_label":"Vitiaz exit Doppler band size constraint","phase_kind":"regional_summary","observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"uncertainty_km":null,"source_quality_note":"Work-in-progress newsletter report, not a peer-reviewed width series. Cruise 113 in prose conflicts with cruise 133 in Figure 3 caption. Salinity sections and float trajectories do not supply width boundaries.","remaining_gates":["Recover Doppler crossings, exact width layer and paired boundary rule.","Resolve cruise-label conflict and occupation support before dated widths.","Recover independently measured downstream dimensions; no factor-of-two arithmetic admission.","Independent scientific admission."],"original_regional_context":{"width_passage_visually_inspected":true,"underlying_width_source":"Zenk et al. (1999), p13; cited SONNE report inspected for ADCP context, not a resolved paired width definition.","underlying_width_methods_reviewed":false,"reference_scale_is_point_width":false,"notation_is_rigorous_upper_bound":false,"zero_to_reference_is_width_range":false,"downstream_doubling_is_numeric_width":false,"downstream_widening_is_seasonal_range":false,"speed_exceedance_is_width_cutoff":false,"core_depth_is_fixed_width_layer":false,"adcp_depth_coverage_is_fixed_width_layer":false,"salinity_section_is_width_boundary":false,"cruise_dates_are_width_occupations":false,"publication_month_is_width_observation":false,"float_dates_are_width_occupations":false,"boundary_coordinates_extracted":false,"cruise_context":{"prose_cruise_number":"113","figure_3_caption_cruise_number":"133","cruise_number_conflict":true,"voyage_start":"1996-10-10","voyage_end":"1996-11-19","is_width_measurement_support":false},"downstream_context":{"reported_core_widening_factor":2,"location":"central Bismarck Sea","derived_width_km":null,"is_seasonal_variation":false},"method_context":{"local_speed_exceeds_cm_s":80,"core_depth_context_m":200,"adcp_coverage_context_m":[350,400],"is_width_boundary_method":false},"supporting_report":{"source_url":"https://oceanrep.geomar.de/id/eprint/2244/1/IFM-BER_288.pdf","source_locator":"Printed p16 / PDF page 17, ADCP subsection; printed pp3 and 8–10 voyage context; no paired width extraction.","source_document_file":"research/source-data/siedler-sonne-1997/journal-article.pdf","source_document_bytes":4094903,"source_document_sha256":"cc9e293b98a47581b9d162c63781af1e5842d6aa0de403a7f06941ea7e6f4cca","acquisition_file":"research/source-data/siedler-sonne-1997/acquisition.json","acquisition_sha256":"31672631b098531dc6d707525055183e08b3b04e25c43381722bb6f6941653b3","is_independent_width_measurement":false},"protocol_file":"plans/ngcu-reported-width-constraint-protocol-v1.md","protocol_sha256":"ff0d0e46f03a9054a69bc06205063064c235d9ac70d640401a4191aeaf76f3c2","display_caption":"Vi
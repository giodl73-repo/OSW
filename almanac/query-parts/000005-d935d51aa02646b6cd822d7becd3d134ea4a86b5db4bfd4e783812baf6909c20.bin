o_velocity_climatology_years":[1994,2013],"source_locator":"Sections 2.1–2.2, equation 6 and Figures 1/2, printed pp3–4","is_width_measurement_support":false},"protocol_file":"plans/pacific-euc-background-width-protocol-v1.md","protocol_sha256":"ef339570824337ee7a398ffd18a4aaba5e151c177912ce74da958222b09eec1b","display_caption":"Pacific eastward subsurface jet · one approximate 400 km background width. Numerical uncertainty, width range, fixed measurement layer and observation dates unknown. Transport and velocity seasonal cycles do not supply monthly widths. No annual range or mapped edges inferred.","display_method_note":"Publisher p1 width prose and p4 transport context inspected. About 200 m thickness and 50–200 m core depths are separate descriptions. The 3°S–3°N transport box is not a width observation. Historical boundary method remains unreviewed; no transfer to other basin currents.","audit_file":"research/pacific-euc-wang-2022-background-width-scope-audit.json","audit_sha256":"9be49243e762e82c9a7ce0e0348a3a8e29c4c8973b34f4773a4ebdb49799c998"}},{"id":"atlantic-euc-gouriou-1988-background-width","current_id":"atlantic-equatorial-undercurrent","name":"Atlantic Equatorial Undercurrent","status":"editorial_source_extraction_not_canonical","measurement_type":"published_regional_summary","width_metric":"author_reported_current_width","approximate_width_km":200,"width_range_km":null,"range_kind":"approximate_regional_point_no_reported_interval","range_interpretation":"One approximate regional background value; no numerical uncertainty, range, confidence interval, annual extrema or seasonal observations supplied.","geographic_scope":"Atlantic eastward subsurface equatorial jet, called Lomonosov current; Brazil to Gulf of Guinea background description without paired boundary coordinates or a specified transverse section.","section_geometry":null,"section_orientation":"No reproducible transverse section endpoints supplied for the regional breadth description.","layer":"Subsurface current background. Adjacent 150 m thickness and 50–125 m core depths do not define a fixed width measurement layer.","time_convention":"1988 French synthesis; no dated width occupation. Compilation years, dated example sections and transport occupations are separate supports.","boundary_rule":"Approximate author-reported background width; no paired edges or boundary threshold directly resolved. Transport cutoff is not adopted as this width method.","source_url":"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/divers11-10/34183.pdf","source_citation":"Y. Gouriou (1988), chapter III, section 3.3.2, printed p16, in Fonteneau and Marcille (eds.), FAO Fisheries Technical Paper 292 (French edition), ISBN 92-5-202652-5.","source_locator":"Printed p16 / PDF page 31, section 3.3.2; title/copyright PDF pages 2–3; Figure 3.4 printed p18 / PDF page 33.","source_retrieved_date":"2026-10-08","source_evidence_kind":"published_original_regional_background_synthesis","extraction_method":"Approximate breadth transcribed from visually inspected institutional original; no contour, transport or coordinate digitization.","whole_current_representative":false,"width_rank_eligible":false,"full_width_inference_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"is_confidence_interval":false,"phase_label":"Atlantic subsurface jet background synthesis","phase_kind":"regional_summary","observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"uncertainty_km":null,"source_quality_note":"Original French volume confirms 200 km prose. Exact historical paired-boundary support remains unresolved. The later English OCR version and dated Voituriez sections are not independent 200 km width observations.","remaining_gates":["Resolve historical background-width boundary method and exact attribution.","Extract compatible repeated transverse sections before seasonal dimensions.","Independent scientific admission."],"original_regional_context":{"width_passage_visually_inspected":true,"underlying_width_source":"Voituriez (1983) cited near the description; its source sections were reviewed separately, without directly establishing this regional 200 km boundary method.","underlying_width_methods_reviewed":false,"thickness_is_fixed_width_layer":false,"core_depths_are_fixed_width_layer":false,"core_position_oscillation_is_width_range":false,"compilation_years_are_width_occupations":false,"figure_section_dates_are_background_width_dates":false,"garp_transport_dates_are_width_occupations":false,"transport_cutoff_is_background_width_boundary":false,"translation_is_independent_width_observation":false,"cross_basin_width_inheritance_eligible":false,"boundary_coordinates_extracted":false,"protocol_file":"plans/atlantic-euc-background-width-protocol-v1.md","protocol_sha256":"f37545d040de00e884348a6aee729c18db00f40cc7db65beb903003459298279","display_caption":"Atlantic eastward subsurface jet · one approximate 200 km background width. Fixed width layer, numerical uncertainty, paired edges and observation dates unknown. No annual range or seasonal width series inferred.","display_method_note":"Original French FAO p16 inspected. 150 m thickness, 50–125 m core depths and core-position oscillations are separate descriptions. The 1988 synthesis and 1993 English version are not two width samples; dated sections and transport thresholds do not date or define this background breadth.","audit_file":"research/atlantic-euc-gouriou-1988-background-width-scope-audit.json","audit_sha256":"f6881f5090e36b3ae3b82459b52d9b5fd06fb93a23cd25ffc3202beb94a80433"}},{"id":"kuroshio-extension-sasaki-2013-monthly-field-width","current_id":"kuroshio-extension","name":"Kuroshio Extension","status":"editorial_source_extraction_not_canonical","measurement_type":"published_regional_summary","width_metric":"author_reported_current_width","approximate_width_km":100,"width_range_km":null,"range_kind":"approximate_regional_point_no_reported_interval","range_interpretation":"One approximate regional background value; no numerical uncertainty, range, confidence interval, annual extrema or seasonal observations supplied.","geographic_scope":"Intense Kuroshio Extension jet in monthly mean fields, extending eastward from Japan to the date line; no transverse boundary coordinates extracted.","section_geometry":null,"section_orientation":"Author-reported meridional width; not assumed normal to the meandering jet.","layer":"Surface SSH and geostrophic velocity context; no fixed vertical width layer supplied.","time_convention":"Monthly mean fields summarized in source prose; no dated width series extracted. January 2005 is the illustrative Figure 1b field.","boundary_rule":"Author-reported meridional jet width. Continuous SSH contours and peak velocity locate the axis; no paired width edges or threshold resolved.","source_url":"https://eprints.lib.hokudai.ac.jp/repo/huscap/all/52934/jpo-d-12-096.1.pdf","source_citation":"Sasaki, Y. N., S. Minobe and N. Schneider (2013), Decadal Response of the Kuroshio Extension Jet to Rossby Waves: Observation and Thin-Jet Theory, JPO 43(2):442–456, doi:10.1175/JPO-D-12-096.1.","source_locator":"Printed p445 / PDF page 5, section 3 first paragraph; data/methods pp443–444; Figure 1 printed p444 / PDF page 4.","source_retrieved_date":"2026-10-08","source_evidence_kind":"published_original_regional_monthly_field_summary","extraction_method":"Approximate width transcribed from visually inspected original; no contour, coordinate or velocity-profile digitization.","whole_current_representative":false,"width_rank_eligible":false,"full_width_inference_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"is_confidence_interval":false,"phase_label":"Meridional jet width in monthly mean fields","phase_kind":"regional_summary","observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"uncertainty_km":null,"source_quality_note":"Monthly mean is a temporal operator, not a recovered month-by-month width series. The separate 200 km climatological meridional scale has different support; it is not an interval endpoint.","remaining_gates":["Resolve a reproducible meridional width boundary rule and exact transverse support.","Extract dated compatible sections before seasonal dimensions or playback.","Independent scientific admission."],"original_regional_context":{"width_passage_visually_inspected":true,"underlying_width_source":"Original section 3 and Figure 1; axis method inspected separately from unresolved paired width method.","underlying_width_methods_reviewed":false,"monthly_mean_is_dated_width_series":false,"illustrative_figure_date_is_width_occupation":false,"analysis_period_is_width_occupation":false,"climatological_scale_is_width_range_endpoint":false,"jet_displacement_is_width_variation":false,"axis_search_contours_are_width_edges":false,"eof_anomaly_scale_is_width_measurement":false,"low_pass_shading_is_monthly_width_series":false,"meridional_width_is_flow_normal_width":false,"boundary_coordinates_extracted":false,"temporal_operator":"monthly_mean","illustrative_figure_month":"2005-01","analysis_period_context":{"start":"1993-01","end":"2010-12","is_width_measurement_support":false},"data_context":{"product":"AVISO monthly absolute dynamic height and surface geostrophic velocities","grid":"1/3 degree Mercator","mean_dynamic_topography":"Rio and Hernandez (2004)","low_pass_context":"9-month running mean for low-frequency analyses; Figure 1a standard deviations explicitly filtered; Figure 1b monthly mean distinct."},"climatological_scale_context":{"meridional_scale_km":200,"temporal_operator":"climatological_mean","geographic_scope":"Japan coast near 35°N to 165°E","source_locator":"Printed p445, section 3 first paragraph / Figure 1a","is_width_sample":false,"is_range_endpoint":false,"uncertainty_km":null},"protocol_file":"plans/kuroshio-extension-width-averaging-protocol-v1.md","protocol_sha256":"bac96
11\",\n        \"is_exact_section_occupation\": false\n      },\n      \"neutral_density_context\": {\n        \"layers\": [\n          1,\n          2,\n          3,\n          4\n        ],\n        \"upper_bound_gamma_n_kg_m3\": 27.38,\n        \"is_fixed_depth_slab\": false\n      },\n      \"transport_uncertainty_is_width_uncertainty\": false,\n      \"flow_normal_width_km\": null,\n      \"whole_current_width_km\": null,\n      \"source_review\": {\n        \"publisher_html_reviewed\": true,\n        \"institutional_pdf_parsed_text_reviewed\": true,\n        \"raw_pdf_acquired\": false,\n        \"raw_pdf_sha256\": null,\n        \"page_images_reviewed\": false\n      }\n    }\n  }\n}\n","document":{"schema":"osw.portugal-orca-section-span-scope-audit.v1","status":"source_reviewed_coordinate_derived_local_section_not_whole_width","current_id":"portugal","source_event_file":"research/named-current-published-observations.json","source_event_file_sha256":"67ca74fa0a6acbe6d450e8f76f6e4b160a0ffc9ac31e48d158865f7a8c4936c0","protocol_file":"plans/portugal-orca-section-span-protocol-v1.md","protocol_sha256":"3bea64469224047731e0ebcf08ed228a5ac2e696334104530deed522c8344a43","figure_file":"figures/portugal-orca-2009-section-span.svg","figure_sha256":"b36d9ba1bab10f47558528eddef4407b5ec8cdcd3524e28b779a845f019efa88","reviewed_primary_urls":["https://agupubs.onlinelibrary.wiley.com/doi/full/10.1002/jgrc.20227","https://accedacris.ulpgc.es/bitstream/10553/50053/1/Source_Canary_current.pdf"],"measurement":{"id":"portugal-perez-2009-orca-source-section-span","current_id":"portugal","name":"Portugal Current","status":"editorial_source_extraction_not_canonical","measurement_type":"published_coordinate_derived_local_section_span","width_metric":"nominal_geodesic_span_of_published_current_section_limits","width_metric_label":"Published local section span; flow-normal and whole-current widths unknown","approximate_width_km":116,"width_range_km":null,"range_kind":null,"range_inter
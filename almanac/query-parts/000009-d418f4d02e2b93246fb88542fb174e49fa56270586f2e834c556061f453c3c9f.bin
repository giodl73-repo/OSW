],"measurement_ids":[],"nasa_links":1,"object_url":"object.html?id=current%3Apacific-south-subsurface-countercurrent","published_length_km":null,"recorded_claims":56,"route_decision_ids":["route-decision:pacific-south-subsurface-countercurrent"],"route_ids":["pacific-sscc-mean-reach-reference-path-candidate"],"route_url":"reference-routes.html#pacific-sscc-mean-reach-reference-path-candidate","scope_notes":[{"audit_file":"research/pacific-sscc-mean-reach-branch-width-scope-audit.json","current_id":"pacific-south-subsurface-countercurrent","label":"Historical southern mean cores versus primary/secondary jets","observed_period":null,"source_locator":"Sections 2-3 and Table 1: south SSCC peaks at 155 W 3.5 S/250 m and 110 W 5.5 S/160 m. Latitude integration bands are not widths. Rowe et al. (2000), introduction and section 3e/Fig. 10 caption, distinguish primary and secondary southern jets.","source_url":"https://www.pmel.noaa.gov/pubs/outstand/john1806/john1806.shtml","summary":"The 155 W to 110 W historical southern mean-core reach is one editorial connection, not a combined primary/secondary axis. Rowe et al. distinguish primary SSCC and secondary SSCC but leave independent origin versus splitting unresolved. Local 250 m/160 m mean cores do not define a uniform layer; transport integration bands and a roughly 40 km PV front are not current width or seasonal ranges. A separate Rowe et al. general 2-degree meridional width summary is now retained as approximately 220 km; the two jet records share one source claim, not independent observations or annual extrema."}],"season_url":"seasons.html?current=pacific-south-subsurface-countercurrent","section_fingerprints":{"claims":"0e0c05a5d40952d9c2c97313b1d6ab731b38dead749fd38cf5c17ec5ff77e35f","identity":"b7414bf443e8963a5b28ca403c015f93dda386b06a5e6fe57a874c0e5c244f15","measurements":"09913ea1ed86149f222febf291858e761589867e603167c0564914aca98c925b","media":"58afbefd1dab0d7d6c48803e676a9db2cb525a9c221574435bb52c2a5c6e12b4",
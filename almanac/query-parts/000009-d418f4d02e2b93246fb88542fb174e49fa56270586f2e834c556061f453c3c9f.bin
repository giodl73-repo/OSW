orted_ensemble_angular_width":{"annual_range_supported":false,"boundary_method":"Neutral-layer zonal-velocity sign transition where available; subjective local minimum when adjacent eastward currents merge. Paired edges underlying the general 2-degree statement are not extracted.","branch_assignment":"NSCC","core_position_variation_is_width_range":false,"exact_section_geometry":null,"fixed_depth_bounds_m":null,"independent_jet_measurements":false,"latitude_span_degrees":2,"observed_period":null,"pv_front_width_is_current_width":false,"sampling_note":"Stream-coordinate averaging; spatial bins have uneven time coverage and depth-dependent sampling.","scope":"General meridional SCC width in discussion of stream-coordinate averages; not a separate regional value for each jet.","shared_source_claim":true,"source_claim_id":"rowe-2000-scc-general-two-degree-width","source_locator":"Section 3b, printed 1179 / PDF index 7; boundary methodology section 2, printed 1175.","source_pdf_url":"https://floats.pmel.noaa.gov/sites/default/files/atoms/files/gcj_1y.pdf","source_url":"https://journals.ametsoc.org/view/journals/phoc/30/6/1520-0485_2000_030_1172_pescvt_2.0.co_2.xml"},"route_construction_status":"editorial_studied_reach_constructed","schema":"osw.current-source-scope-audit.v1","scope":"Declared northern Tsuchiya Jet studied reach from the 155 W mean-section core to the 110 W mean-section core. Western formation and basin continuation east of 110 W are excluded. The section gates truncate a larger current; interpolating bends are editor-selected, not a measured continuous centerline or particle path.","source_access":"Relevant abstract/introduction, data methods, section 3 and text Table 1 read from NOAA-hosted full HTML. No figure digitization, historical CTD extraction or full annual-field reconstruction. Added inspection of Rowe et al. section 2 sampling/boundary methods and section 3b general width statement in NOAA PDF, confirmed in publisher full text; no figures or paired edges digitized.","source_citation":"Johnson and Moore (1997), The Pacific Subsurface Countercurrents and an Inertial Model, Journal of Physical Oceanography 27, 2448-2459.","source_core_depths_are_uniform_route_layer":false,"source_core_support":[{"latitude":3.5,"local_peak_depth_m":220,"longitude":-155},{"latitude":4.5,"local_peak_depth_m":130,"longitude":-110}],"source_ensemble_period_is_route_date":false,"source_ensemble_years":[1967,1996],"source_geostrophic_reference_dbar":700,"source_locator":"Sections 2-3 and Table 1: north SSCC peaks at 155 W 3.5 N/220 m and 110 W 4.5 N/130 m. Transport integration latitude limits and 700-dbar reference are separately defined; they are not route width or a uniform axis layer.","source_reference_is_axis_depth":false,"source_transport_integration_bounds":[{"latitude_range":[2,5],"longitude":-155},{"latitude_range":[3,6],"longitude":-110}],"source_url":"https://www.pmel.noaa.gov/pubs/outstand/john1806/john1806.shtml","status":"editorial_source_scope_audit_not_canonical","transport_integration_bounds_are_current_width":false,"whole_current_length_km":null,"whole_current_width_km":null},"note":{"audit_file":"research/pacific-nscc-reach-layer-section-scope-audit.json","current_id":"pacific-north-subsurface-countercurrent","label":"Northern Tsuchiya mean cores and integration limits","observed_period":null,"source_locator":"Sections 2-3 and Table 1: north SSCC peaks at 155 W 3.5 N/220 m and 110 W 4.5 N/130 m. Transport integration latitude limits and 700-dbar reference are separately defined; they are not route width or a uniform axis layer.","source_url":"https://www.pmel.noaa.gov/pubs/outstand/john1806/john1806.shtml","summary":"155 W to 110 W is an editorial northern Tsuchiya studied reach. Local mean cores shoal from 220 m to 130 m; no uniform axis depth inferred. Transport integration latitude limits are not width. Historical compilation dates do not date the route, and the 130 E NEUC identity is kept separate. A separat
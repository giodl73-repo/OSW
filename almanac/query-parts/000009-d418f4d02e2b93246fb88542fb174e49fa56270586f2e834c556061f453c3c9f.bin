ion"],"field_context":{"altimetry_period":"1992-10 through 2006-12","cars":"Historical in situ profiles; 0.5 degree grid; poor western/southern winter sampling. No common occupation period assigned.","cmdt_mean_period":"1993–1999","layer":"Surface seasonal fields and shelf/slope interpretation; exact current depth bounds unresolved.","numeric_current_edges":null,"seasonal_operator":"Annual and semiannual least-squares harmonic reconstruction of SLA and SST; Figure 7 combines CMDT mean with reconstructed monthly SLA.","sst_mean_figure_2_period":"1993–2004"},"protocol_file":"plans/qualitative-current-calendar-protocol-v1.md","protocol_sha256":"6a47a168fa94d9a998a97c5f0ef05c6fd9d30d4227e9601e8ebc3e2364b805fc","schema":"osw.current-qualitative-seasonal-scope-audit.v1","seasonal_calendar":{"annual_dimension_extrema_eligible":false,"claims":[{"id":"summer-indication","kind":"indirect_property_indication","label":"Weak southward flow indicated","locator":"Section 6, paragraph 29","months":[10,11,12,1,2,3],"reference_state":"seasonal property fields","summary":"Seasonal property fields suggest weak southward flow; the inshore edge is unresolved."},{"id":"april-transition","kind":"regional_transition","label":"Coastal transition","locator":"Section 6, paragraph 30","months":[4],"reference_state":"seasonal coastal steric height","summary":"Rising western coastal sea level favors southward alongshore flow."},{"id":"may-development","kind":"development","label":"Warm-water flow develops","locator":"Section 9, paragraph 45","months":[5],"reference_state":"seasonal warm-water flow","summary":"Continuous shelf-edge warm-water flow develops in May."},{"id":"winter-peak","kind":"qualitative_peak","label":"Reported peak","locator":"Section 6, paragraph 30; Section 9, paragraph 45","months":[6,7],"reference_state":"seasonal boundary flow","summary":"Flow intensifies and peaks in June–July; numerical strength is unspecified."},{"endpoint_qualifier":"at_least","id":"winter-persistence",
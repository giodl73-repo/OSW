.json.","rank_eligible":false,"route_ids":[],"scope":"No comparable path-length estimate admitted yet.","scope_reviews":[{"document":{"annual_length_range_km":null,"annual_width_range_km":null,"as_of":"2026-10-03","current_id":"spitsbergen-atlantic","name_equivalence_admitted":false,"observed_period":null,"related_current_ids":["west-spitsbergen"],"remaining_gates":["Resolve naming convention using direct source definitions before transferring route geometry.","Retain distinct salinity, layer, branch and temporal scope.","No numeric dimensions, footprint or seasonal cycle inferred from nearby currents."],"route_construction_status":"identity_scope_unresolved","schema":"osw.current-source-scope-audit.v1","source_access":"Relevant current glossary entries read; not full glossary read.","source_locator":"Norwegian Current, North Atlantic Current and Spitsbergen Atlantic Current entries.","source_url":"https://tidesandcurrents.noaa.gov/glossary","status":"editorial_source_scope_audit_not_canonical","summary":"NOAA Spitsbergen Atlantic Current describes northwestward flow off southwest Spitsbergen. The modern West Spitsbergen Current is a northward Atlantic-water continuation toward Fram Strait. Regional overlap does not establish identical names, branches or endpoints; no existing West Spitsbergen route length is transferred.","supporting_sources":[{"citation":"Baumann, Skagseth, Ingvaldsen and Mork (2026), Reduced cooling in the Norwegian Atlantic Slope Current: investigating mechanisms of change from 30 years of observations, Ocean Science 22, 17–29, doi:10.5194/os-22-17-2026.","locator":"Introduction: two Atlantic branches and northern bifurcation; sections 2.1–2.1.2: sampling/core criteria.","source_access":"Relevant introduction and methods read.","source_license":"CC BY 4.0","url":"https://os.copernicus.org/articles/22/17/2026/"}],"whole_current_length_km":null,"whole_current_width_km":null},"note":{"audit_file":"research/spitsbergen-atlantic-naming-branch-scope-a
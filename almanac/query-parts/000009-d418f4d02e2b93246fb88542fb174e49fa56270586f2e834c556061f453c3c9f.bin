nel_axes_pixels":[1121,1383,674,894],"source_snapshot_id":"source:814dda03fd8926bd","state_assessments":[{"containment_assessment":"unresolved","display_area_fraction_range":[0.69235989,0.73270559],"intersection_assessment":"robust_across_tested_calibrations","nominal_display_area_fraction":0.71200349,"state_id":"state:CAMR"},{"containment_assessment":"unresolved","display_area_fraction_range":[0.26729441,0.30764011],"intersection_assessment":"robust_across_tested_calibrations","nominal_display_area_fraction":0.28799651,"state_id":"state:CARB"}],"state_geometry_sha256":"5999bbad0e49209b2609a20a52a3e6310aa749224b574cb2f6cbcac0e68db032"}],"named_eddy_source_observations":[{"claim_id":"claim:named_eddy_source_observation:001","entity_id":"eddy:published:kraken-2013","evidence_type":"named_altimetry_boundary_with_independent_ocean_color_and_drifter_support","geometry_status":"figure_red_pixels_georeferenced_no_closed_boundary","id":"named_eddy_source_observation:001","interpretation":"The authors identify the Loop Current ring as Kraken and analyze a resilient material core during this interval. OSW georeferences selected red Figure 2 curve pixels as a state-location candidate; the authors' closed boundary coordinates are not reconstructed.","name_origin":null,"near_center_mooring":null,"observation_end":"2013-12-15","observation_start":"2013-05-29","observed_center":null,"physical_state_relation":"unresolved_without_reusable_dated_geometry","reported_measure":"Approximately 100 km mean radius of the coherent core, a definition distinct from the outer instantaneous SSH footprint.","source_id":"source:8a85446449036671","source_locator":"Results; Figures 2–4","source_snapshot_id":"source:174ea4945580f696"},{"claim_id":"claim:named_eddy_source_observation:002","entity_id":"eddy:published:thor-2020","evidence_type":"named_loop_current_eddy_event_with_dated_maps","geometry_status":"published_figure_not_digitized","id":"named_eddy_source_observation:002","interpretation":"The authors map the Thor shedding event in January–June 2020 and describe detachment, reattachment, final separation, and westward propagation. The date bounds describe the paper's figure window, not a measured lifetime.","name_origin":null,"near_center_mooring":null,"observation_end":"2020-06-30","observation_start":"2020-01-01","observed_center":null,"physical_state_relation":"unresolved_without_reusable_dated_geometry","reported_measure":null,"source_id":"source:905e5cc303aaceab","source_locator":"Section 3.1; Figure 2","source_snapshot_id":"source:174ea4945580f696"},{"claim_id":"claim:named_eddy_source_observation:003","entity_id":"eddy:published:thor-2020","event_stage":"separation_confirmed_by_date","evidence_type":"independent_published_dated_event","geometry_status":"source_reported_event_no_named_eddy_footprint","id":"named_eddy_source_observation:003","interpretation":"Satellite SST and concurrent drifter velocities support Thor being separated by this date; this does not establish that every later detachment was final.","observation_end":"2020-01-27","observation_start":"2020-01-27","physical_state_relation":"unresolved_without_reusable_dated_geometry","reported_measure":null,"source_id":"source:e5cc996fb82aae2f","source_locator":"Section 3.2; Figure 2; NOAA-hosted PDF page 4","source_snapshot_id":"source:174ea4945580f696"},{"claim_id":"claim:named_eddy_source_observation:004","entity_id":"eddy:published:thor-2020","event_stage":"deformed_and_nearly_split","evidence_type":"independent_published_dated_event","geometry_status":"source_reported_event_no_named_eddy_footprint","id":"named_eddy_source_observation:004","interpretation":"Thor had deformed and nearly split into two eddies by this date; near-splitting is not a verified division into two independently named rings.","observation_end":"2020-03-23","observation_start":"2020-03-23","physical_state_relation":"unresolved_without_reusable_dated_geometry","reported_measure":null,"source_id":"source:e5cc996fb82aae2f","source_locator":"Abstract; Sections 3.2 and 3.5; Figure 2","source_snapshot_id":"source:174ea4945580f696"},{"claim_id":"claim:named_eddy_source_observation:005","entity_id":"eddy:published:ursa-2021","evidence_type":"named_loop_current_eddy_event_with_dated_maps","geometry_status":"published_figure_not_digitized","id":"named_eddy_source_observation:005","interpretation":"The authors map the Ursa shedding event in January–May 2021, including temporary detachment and reattachment. The date bounds describe the paper's figure window, not a measured lifetime or independent final separation date.","name_origin":null,"near_center_mooring":null,"observation_end":"2021-05-31","observation_start":"2021-01-01","observed_center":null,"physical_state_relation":"unresolved_without_reusable_dated_geometry","reported_measure":null,"source_id":"source:905e5cc303aaceab","source_locator":"Section 3.2; Figure 3","source_snapshot_id":"source:174ea4945580f696"},{"claim_id":"claim:named_eddy_source_observation:006","entity_id":"eddy:published:ursa-2021","event_stage":"temporary_detachment","evidence_type":"independent_published_dated_event","geometry_status":"source_reported_event_no_named_eddy_footprint","id":"named_eddy_source_observation:006","interpretation":"The later paper identifies a brief first separation followed by reattachment.","observation_end":"2021-03-08","observation_start":"2021-03-08","physical_state_relation":"unresolved_without_reusable_dated_geometry","reported_measure":null,"source_id":"source:e5cc996fb82aae2f","source_locator":"Section 3.6; Figure 19; NOAA-hosted PDF page 18","source_snapshot_id":"source:174ea4945580f696"},{"claim_id":"claim:named_eddy_source_observation:007","entity_id":"eddy:published:ursa-2021","event_stage":"final_detachment_reported","evidence_type":"independent_published_dated_event","geometry_status":"source_reported_event_no_named_eddy_footprint","id":"named_eddy_source_observation:007","interpretation":"The later paper reports final Ursa separation on this date; the date is source-reported, not a geometric reconstruction by OSW.","observation_end":"2021-04-26","observation_start":"2021-04-26","physical_state_relation":"unresolved_without_reusable_dated_geometry","reported_measure":null,"source_id":"source:e5cc996fb82aae2f","source_locator":"Section 3.6; Figure 20; NOAA-hosted PDF pages 18–19","source_snapshot_id":"source:174ea4945580f696"},{"claim_id":"claim:named_eddy_source_observation:008","entity_id":"eddy:published:cameron-2009-observed","evidence_type":"moored_currents_and_altimetry_dated_named_eddy_observation","geometry_status":"published_figure_not_digitized","id":"named_eddy_source_observation:008","interpretation":"The authors locate Cameron's center approximately at mooring A on January 20 and describe its later west-southwest translation and deformation through March 1. These are western Gulf observations, not initial separation or whole-lifetime dates.","name_origin":"Horizon Marine attribution stated in observing paper; measurements and dated interpretation originate with the paper","near_center_mooring":null,"observation_end":"2009-03-01","observation_start":"2009-01-20","observed_center":{"coordinate_lon_lat":[-95.0,22.5],"coordinate_precision":"approximately at mooring A; source rounds coordinates to 0.1 degree latitude and whole-degree longitude","date":"2009-01-20","source_locator":"Section 4.1.1, paragraph 32; Figure 6a"},"physical_state_relation":"unresolved_without_reusable_dated_geometry","reported_measure":"About 300 km diameter on 2009-01-20, as assessed by the authors from the altimetric eddy field.","source_id":"source:6694d73532f024d7","source_locator":"Section 4.1.1, paragraphs 32–35; Figure 6; Table 2 footnote for name origin","source_snapshot_id":"source:174ea4945580f696"},{"claim_id":"claim:named_eddy_source_observation:009","entity_id":"eddy:published:darwin-2009-observed","evidence_type":"moored_currents_and_altimetry_dated_named_eddy_observation","geometry_status":"published_figure_not_digitized","id":"named_eddy_source_observation:009","interpretation":"The authors locate Darwin northeast of moorings L, A and K on July 25, with its southwestern edge across the array; mooring A is near its center on August 5. These western Gulf observations do not establish its initial separation date or a full footprint.","name_origin":"Horizon Marine attribution stated in observing paper; measurements and dated interpretation originate with the paper","near_center_mooring":{"date":"2009-08-05","mooring_coordinate_from_table_1":"22°30.33′N, 95°01.29′W (July 2009–July 2010 deployment)","mooring_id":"A","relation":"mooring_near_eddy_center_not_exact_center","source_locator":"Section 4.1.2, paragraph 37; Figure 7b; Table 1 for mooring coordinates"},"observation_end":"2009-09-05","observation_start":"2009-07-25","observed_center":null,"physical_state_relation":"unresolved_without_reusable_dated_geometry","reported_measure":"About 200 km diameter on 2009-07-25, as assessed by the authors from the altimetric eddy field.","source_id":"source:6694d73532f024d7","source_locator":"Section 4.1.2, paragraphs 36–40; Figure 7; Table 2 footnote for name origin","source_snapshot_id":"source:174ea4945580f696"}],"named_eddy_state_assessments":[{"claim_id":"claim:named_eddy_state:eddy:horizon:loop-81-primary:state:ALSK","dated_ssh_contour_area_fraction_range":null,"dated_ssh_contour_assessment":null,"dated_ssh_contour_nominal_area_fraction":null,"dated_ssh_contour_observation_date":null,"eddy_id":"eddy:horizon:loop-81-primary","evidence_status":"unresolved","figure_axis_sensitivity_fraction":null,"figure_observation_dates":null,"id":"named_eddy_state:eddy:horizon:loop-81-primary:state:ALSK","observed_center_date":null,"physical_relation":"unknown_no_dated_eddy_footprint","point_evidence_types":[],"reported_center_lon_lat":null,"source_id":"source:7487b9a234864d2d","source_locator":null,"source_record_id":"loop-81-primary","state_id":"state:ALSK"},{"clai
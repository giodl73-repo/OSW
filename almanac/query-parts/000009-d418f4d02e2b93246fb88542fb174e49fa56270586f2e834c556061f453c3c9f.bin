ent width.","Do not admit doubled e-folding span or Gaussian FWHM as sourced widths."],"layer_scope":"Composite vertical support unresolved. Fig. 9 specifies a 20–80 m average for LS05; Fig. 10 does not explicitly establish that same fixed layer for all 15 crossings. Instrument generally sampled from about 20 m to 150 m or 15 m above bottom.","numeric_evidence":{"annual_width_range_km":null,"crossing_count":15,"full_width_km":null,"metric_interpretation":"OSW center-to-e-folding inference from the published Gaussian formula","record_id":"north-cape-northern-2007-profile-scale","source_effective_width_km":8},"remaining_gates":["Resolve exact composite depth averaging and crossing dates from underlying data.","Define comparable paired boundaries before any full-width comparison.","Review branch identity and along-route support; canonical admission remains pending."],"route_context_note":"Western Hopen Northern-branch studied reach has OSW-selected gates, distinct from full current system and transverse LS05 ship track.","route_geometry":null,"schema":"osw.current-source-scope-audit.v1","source_access":"full_primary_pdf_read","source_document_sha256":"76cdf260067540a0102d7f40d5f1220f7e6f3884f7f543d4deda6bef77612eaf","source_figures_inspected":["Fig. 1 PDF page 2","Fig. 9 PDF page 11"],"source_url":"https://physical-oceanography.ru/repository/issues/2017/02/05/20170205.pdf","status":"editorial_source_scope_audit_not_canonical","temporal_scope":{"composite_description":"summer expeditions of 2007","dates_are_not_interchangeable":true,"described_cruise":{"end":"2007-06-10","start":"2007-05-29"},"exact_composite_dates":null,"figure_1_track_label":{"end":"2007-06-09","start":"2007-05-30"}},"whole_current_length_km":null,"whole_current_width_km":null},"note":{"audit_file":"research/north-cape-branch-profile-scope-audit.json","current_id":"north-cape","label":"Northern-branch fitted scale versus whole North Cape system","observed_period":null,"source_locator":"Stationary curr
ope":"No comparable path-length estimate admitted yet.","scope_reviews":[{"document":{"annual_length_range_km":null,"annual_width_range_km":null,"assessment":"Guiana/Guyana identity requires an explicit nomenclature convention before independent route estimation. No alias merge or fixed physical boundary admitted.","continuity_assessment":{"annual_geometry_playback_eligible":false,"decision":"retain_source_specific_named_flow_no_universal_axis_or_alias_merge","full_year_observed":false,"local_non_detection_implies_global_absence":false,"local_observed_period":{"end":"2004-02-18","start":"2003-10-06"},"observation_depth_scope":"22 m and deeper; unmeasured upper layer remains a possibility","ring_translation_is_current_axis":false,"tracer_boundary_is_current_edge":false},"current_id":"guiana","current_ids":["guiana","north-brazil"],"current_ledger_file":"research/ocean-current-almanac.json","current_ledger_sha256":"6c8a143208c0953512875f222154a819d5f56b7326daa6816f0609e61b4f261e","date":"2026-10-03","name":"Guiana Current","nomenclature_conventions":[{"extent_convention":"Northwestward northeastern South American coastal flow; numeric endpoints unspecified.","name":"Guiana Current","physical_endpoint_boundary_established":false,"source_url":"https://www.tidesandcurrents.noaa.gov/glossary.html"},{"extent_convention":"Introduction names non-retroflected NBC continuation north of 10 N, with seasonal NEC contribution.","name":"Guyana Current","physical_endpoint_boundary_established":false,"source_url":"https://os.copernicus.org/articles/19/251/2023/os-19-251-2023.html"},{"extent_convention":"Historical coastal-continuity interpretation tested against local shelf moorings and offshore mesoscale context.","name":"Guyana current","physical_endpoint_boundary_established":false,"source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2006JC003520"}],"rank_eligible":false,"remaining_work":["Review historical and modern Guiana/Guyana naming against local shelf and offshore circulation.","Define entry and Caribbean transition gates and season/layer; establish whether a distinct path is defensible.","Keep NBC route, ring tracks and downstream Caribbean route separate; do not sum shared named segments.","Resolve source convention and layer, obtain upper-layer observations and distinguish shelf flow from offshore ring passage before any annual axis or width."],"schema":"osw.current-naming-scope-audit.v1","source_access":"Existing NOAA/Dimoune review retained. Baklouti relevant sections read 2026-10-03; AMS 2002 full-page fetch failed and indexed excerpt is not full-text review. No figures or data digitized.","sources":[{"evidence":"Northwestward northeast-South-American coastal current; no endpoint pair.","locator":"Guiana Current definition","url":"https://www.tidesandcurrents.noaa.gov/glossary.html"},{"evidence":"Named Guyana continuation of non-retroflected NBC with seasonal NEC contribution; regional naming convention rather than universal boundary.","locator":"Section 1, paragraph beginning North of 10 N","url":"https://os.copernicus.org/articles/19/251/2023/os-19-251-2023.html"},{"access":"relevant_full_text_sections_read_not_source_data_or_figure_digitization","citation":"Baklouti et al. (2007), New insights in the French Guiana continental shelf circulation and its relation to the North Brazil Current retroflection, JGR Oceans 112, doi:10.1029/2006JC003520","evidence":"French Guiana observations from 2003-10-06 to 2004-02-18: variable earlier flow, later northwestward flow; transition depends on site/depth. Non-detection of persistent flow at 22 m and below leaves upper-20-m flow possible; not basin-wide absence. Mooring distances, ring size and tracer boundaries are not current width.","locator":"Abstract; introduction paragraphs 2-9; mooring description; sections 3.1-3.2; discussion paragraphs 46-47; conclusion paragraphs 50-55","url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2006JC003520"}],"status":"editorial_scope_review_not_canonical_taxonomy_admission","whole_current_length_km":null,"whole_current_width_km":null},"note":{"audit_file":"research/guiana-north-brazil-naming-scope-audit.json","current_id":"guiana","label":"Guiana/Guyana extent and continuity conventions","observed_period":{"end":"2004-02-18","start":"2003-10-06"},"related_current_ids":["north-brazil"],"source_locator":"Mooring description, sections 3.1-3.2, discussion paragraph 46 and conclusion paragraph 52","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2006JC003520","summary":"Guiana/Guyana limits vary by source. Local French Guiana shelf observations do not establish continuous flow in every layer; North Brazil continuation and detached ring motion remain separate. No universal endpoint, current width or annual axis established."},"source_sha256":"f2894454ae49faf517035bfb19209c8dfd1654570c44af02d76105af97f2a160"}],"source_catalog_file":"research/ocean-current-reference-path-candidates.json","source_catalog_sha256":"b06caed27655c39f8127ddda441cba0a856800f599ec52edcd5b30d2ad37b633","source_decision":{"candidate_ids":["guiana-reference-path-candidate"],"component_inventory_status":"not_assessed_by_this_planning_crosswalk","current_id":"guiana","existing_length_evidence_status":"no_numeric_length","existing_scope":"No comparable path-length estimate admitted yet.","known_component_currents":[],"ledger_kind":"regional current","name":"Guiana Current","name_source_url":"https://www.tidesandcurrents.noaa.gov/glossary.html","next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","planning_basis":"No comparable path-length estimate admitted yet.","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","published_length_rank_eligible":false,"reference_path_decision":"editorial_candidate_present_scientific_review_pending","route_strategy_id":"resolve_naming_s
:"https://www.pmel.noaa.gov/pubs/outstand/john1806/john1806.shtml","summary":"155 W to 110 W is an editorial northern Tsuchiya studied reach. Local mean cores shoal from 220 m to 130 m; no uniform axis depth inferred. Transport integration latitude limits are not width. Historical compilation dates do not date the route, and the 130 E NEUC identity is kept separate. A separate Rowe et al. general 2-degree meridional width summary is now retained as approximately 220 km; the two jet records share one source claim, not independent observations or annual extrema."}],"season_url":"seasons.html?current=pacific-north-subsurface-countercurrent","section_fingerprints":{"claims":"be88bd40aae00fe7b3b08290c404279245d5128228dc2c60900bf58fdfd7e075","identity":"b1c8906a25ad6ad587804f04466099547cae753c541712481dc5ef4cd479533d","measurements":"9cc777503333f87728722fd998dece80c22178c9381c50e1d29176923c64d18f","media":"a98ff48b248288b17b237c4497a6a7ea45a0719a7fde48843331fcc9f237f5b4","routes_geometry":"5b81546f18eaaa4e47d986f05b41a1acc2a572033eec0d6f51aebb2f0e9bf882","sources":"3a8e02fd0bf8b562ae4d8bbeaba84aea67b798490a5b40994a03a6751b758022","time_evidence":"8d86da8229951992c802d517eaeaeeb84a4b5f1a3e916ecd7944f448135387bd"},"series":[],"setting":"equatorial","source_ids":["source:4dc5fc618c26565f","source:4f7441b953be4651","source:803229fe82eb2360","source:b038491b0e5a3967","source:df8a86f107aba236"],"source_kind":"eastward subsurface jet north of the Equatorial Undercurrent","state_codes":[],"state_evidence":[],"time_behavior":"persistent_variable","type":"named_current","velocity_sample_ids":[],"width_ids":["pacific-north-subsurface-countercurrent-rowe-2000-general-angular-width"],"width_sample_ids":[]},{"basin":"Tropical South Pacific","capabilities":{"dated_diagnostics":0,"flow_network":0,"geometry":0,"observed_velocity":0,"passage_transport":0,"radius_evidence":0,"reference_route":1,"reported_length":0,"scope_notes":2,"scoped_width":1,"source_connectivity":0,"time_samples":0,"w
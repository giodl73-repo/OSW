e regional atlas point is not a measured centerline or length endpoint.","name_source_url":"https://www.marineregions.org/gazetteer.php?p=details&id=56789","candidate_ids":["western-adriatic-reference-path-candidate"],"reference_path_decision":"editorial_candidate_present_scientific_review_pending","published_length_rank_eligible":false,"ledger_kind":"southeastward coastal current","route_strategy_id":"source_gated_regional_route","route_strategy_label":"Establish a sourced regional route","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","planning_basis":"Drifter evidence identifies a fast, coastally confined southeastward flow along the Italian Adriatic coast; the regional atlas point is not a measured centerline or length endpoint.","next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","strategy_next_action":"Read primary geographic definitions, choose explicit endpoint/branch/layer/time conventions, and measure a reviewed route with alternatives; naming points alone are insufficient.","known_component_currents":[],"component_inventory_status":"not_assessed_by_this_planning_crosswalk"},"source_catalog_file":"research/ocean-current-reference-path-candidates.json","source_catalog_sha256":"b06caed27655c39f8127ddda441cba0a856800f599ec52edcd5b30d2ad37b633","scope_reviews":[]},{"id":"route-decision:zeehan","entity_id":"current:zeehan","label":"Zeehan Current","current_id":"zeehan","strategy_id":"seasonal_routes","strategy_label":"Construct seasonal routes","construction_status":"editorial_candidate_present_scientific_review_pending","candidate_count":1,"route_ids":["zeehan-reference-path-candidate"],"next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","scope":"Named section off western Tasmania in the source's winter boundary-flow convention.","status":"editorial_planning_crosswalk_not_scientific_classification_approval","rank_eligible":false,"source_url":"https://doi.org/10.1029/2003JC001921","source_decision":{"current_id":"zeehan","name":"Zeehan Current","existing_length_evidence_status":"no_numeric_length","existing_scope":"Named section off western Tasmania in the source's winter boundary-flow convention.","name_source_url":"https://doi.org/10.1029/2003JC001921","candidate_ids":["zeehan-reference-path-candidate"],"reference_path_decision":"editorial_candidate_present_scientific_review_pending","published_length_rank_eligible":false,"ledger_kind":"shelf-edge current segment","route_strategy_id":"seasonal_routes","route_strategy_label":"Construct seasonal routes","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","planning_basis":"Named section off western Tasmania in the source's winter boundary-flow convention.","next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","strategy_next_action":"Choose sourced season, direction and layer; construct each supported seasonal path separately and preserve missing seasons.","known_component_currents":[],"component_inventory_status":"not_assessed_by_this_planning_crosswalk"},"source_catalog_file":"research/ocean-current-reference-path-candidates.json","source_catalog_sha256":"b06caed27655c39f8127ddda441cba0a856800f599ec52edcd5b30d2ad37b633","scope_reviews":[{"note":{"current_id":"zeehan","label":"Source-supported qualitative seasonal calendar","audit_file":"research/zeehan-ridgway-2007-seasonal-scope-audit.json","summary":"May development, June–July peak and persistence through at least September; summer property indications and flow anomalies retain separate reference states. Numerical seasonal dimensions remain unresolved.","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2006JC003898","source_locator":"Sections 6 and 9, paragraphs 29, 30, 45 and 47; methods paragraphs 9–13 and Figure 7.","observed_period":null},"document":{"schema":"osw.current-qualitative-seasonal-scope-audit.v1","current_id":"zeehan","status":"editorial_primary_html_extraction_pending_independent_review","source":{"author":"K. R. Ridgway","year":2007,"title":"Seasonal circulation around Tasmania: An interface between eastern and western boundary dynamics","doi":"10.1029/2006JC003898","url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2006JC003898","access":"Complete publisher HTML read; original response bytes not pinned. Direct download returned HTTP 403.","reviewed_on":"2026-10-08","original_response_sha256":null,"redistribution_license":null},"protocol_file":"plans/qualitative-current-calendar-protocol-v1.md","protocol_sha256":"6a47a168fa94d9a998a97c5f0ef05c6fd9d30d4227e9601e8ebc3e2364b805fc","seasonal_calendar":{"time_convention":"Gregorian months; recurring qualitative climatological interpretation, no representative year","claims":[{"id":"summer-indication","months":[10,11,12,1,2,3],"kind":"indirect_property_indication","label":"Weak southward flow indicated","summary":"Seasonal property fields suggest weak southward flow; the inshore edge is unresolved.","locator":"Section 6, paragraph 29","reference_state":"seasonal property fields"},{"id":"april-transition","months":[4],"kind":"regional_transition","label":"Coastal transition","summary":"Rising western coastal sea level favors southward alongshore flow.","locator":"Section 6, paragraph 30","reference_state":"seasonal coastal steric height"},{"id":"may-development","months":[5],"kind":"development","label":"Warm-water flow develops","summary":"Continuous shelf-edge warm-water flow develops in May.","locator":"Section 9, paragraph 45","reference_state":"seasonal warm-water flow"},{"id":"winter-peak","months":[6,7],"kind":"qualitative_peak","label":"Reported peak","summary":"Flow intensifies and peaks in June–July; numerical strength is unspecified.","locator":"Section 6, paragraph 30; Section 9, paragraph 45","reference_state":"seasonal boundary flow"},{"id":"winter-persistence","months":[5,6,7,8,9],"kind":"qualified_persistence","label":"Persists through at least September","summary":"May development and persistence through at least September do not establish an October disappearance.","locator":"Section 6, paragraph 30; Section 9, paragraph 45","reference_state":"seasonal Zeehan boundary flow","endpoint_qualifier":"at_least","month_assignment":"Continuous May–September interval inferred from development and persistence statements."},{"id":"summer-anomaly","months":[10,11,12,1,2,3,4],"kind":"anomaly_direction","label":"Equatorward shelf-edge anomaly","summary":"The summer anomaly opposes mean southward slope flow; it does not establish reversal of the whole current.","locator":"Section 9, paragraph 47","reference_state":"anomaly relative to mean flow"}],"months":[{"month":1,"claim_ids":["summer-indication","summer-anomaly"]},{"month":2,"claim_ids":["summer-indication","summer-anomaly"]},{"month":3,"claim_ids":["summer-indication","summer-anomaly"]},{"month":4,"claim_ids":["april-transition","summer-anomaly"]},{"month":5,"claim_ids":["may-development","winter-persistence"]},{"month":6,"claim_ids":["winter-peak","winter-persistence"]},{"month":7,"claim_ids":["winter-peak","winter-persistence"]},{"month":8,"claim_ids":["winter-persistence"]},{"month":9,"claim_ids":["winter-persistence"]},{"month":10,"claim_ids":["summer-indication","summer-anomaly"]},{"month":11,"claim_ids":["summer-indication","summer-anomaly"]},{"month":12,"claim_ids":["summer-indication","summer-anomaly"]}],"observation_dates":null,"speed_values":null,"width_values":null,"length_values":null,"occupied_geometry":null,"annual_dimension_extrema_eligible":false,"dimension_rank_eligible":false,"seasonal_geometry_playback_eligible":false,"map_context":{"route_id":"zeehan-reference-path-candidate","source_doi":"10.1029/2003JC001921"
ure or original velocity arrays packaged.\",\n  \"scope\": \"Selected source-described passage connections at differing depths. Not a complete exchange network, permanent one-way flow, particle itinerary or traced current axis.\",\n  \"layer\": \"Western upper-thermocline route and eastern deeper-water contribution remain distinct; mixed-layer pathways, not one uniform depth.\",\n  \"time_scope\": \"Regional pathway description with 2004–2006 mean exit transport context; arrows do not describe every date or depth.\",\n  \"length_km\": null,\n  \"width_km\": null,\n  \"annual_length_range_km\": null,\n  \"annual_width_range_km\": null,\n  \"rank_eligible\": false,\n  \"nodes\": [\n    {\n      \"id\": \"flow-node:itf:pacific\",\n      \"label\": \"Pacific Ocean\",\n      \"node_kind\": \"source_basin\",\n      \"schematic_xy\": [\n        50,\n        150\n      ],\n      \"coordinates_lon_lat\": null\n    },\n    {\n      \"id\": \"flow-node:itf:sulawesi\",\n      \"label\": \"Sulawesi Sea\",\n      \"node_kind\": \"interior_basin\",\n      \"schematic_xy\": [\n        190,\n        70\n      ],\n      \"coordinates_lon_lat\": null\n    },\n    {\n      \"id\": \"flow-node:itf:makassar\",\n      \"label\": \"Makassar Strait\",\n      \"node_kind\": \"inflow_gateway\",\n      \"schematic_xy\": [\n        330,\n        70\n      ],\n      \"coordinates_lon_lat\": null\n    },\n    {\n      \"id\": \"flow-node:itf:flores\",\n      \"label\": \"Flores Sea\",\n      \"node_kind\": \"interior_basin\",\n      \"schematic_xy\": [\n        470,\n        70\n      ],\n      \"coordinates_lon_lat\": null\n    },\n    {\n      \"id\": \"flow-node:itf:maluku\",\n      \"label\": \"Maluku Sea\",\n      \"node_kind\": \"interior_basin\",\n      \"schematic_xy\": [\n        190,\n        230\n      ],\n      \"coordinates_lon_lat\": null\n    },\n    {\n      \"id\": \"flow-node:itf:lifamatola\",\n      \"label\": \"Lifamatola Passage\",\n      \"node_kind\": \"deep_inflow_gateway\
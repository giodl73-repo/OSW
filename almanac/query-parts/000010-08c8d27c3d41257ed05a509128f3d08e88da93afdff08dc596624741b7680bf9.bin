0X-2017-2-36-50","branch_scope":"Northern branch, distinct from Central branch; partial cyclonic recirculation described, not a single whole-system axis.","numeric_evidence":{"record_id":"north-cape-northern-2007-profile-scale","source_effective_width_km":8,"crossing_count":15,"metric_interpretation":"OSW center-to-e-folding inference from the published Gaussian formula","full_width_km":null,"annual_width_range_km":null},"temporal_scope":{"composite_description":"summer expeditions of 2007","exact_composite_dates":null,"described_cruise":{"start":"2007-05-29","end":"2007-06-10"},"figure_1_track_label":{"start":"2007-05-30","end":"2007-06-09"},"dates_are_not_interchangeable":true},"layer_scope":"Composite vertical support unresolved. Fig. 9 specifies a 20–80 m average for LS05; Fig. 10 does not explicitly establish that same fixed layer for all 15 crossings. Instrument generally sampled from about 20 m to 150 m or 15 m above bottom.","excluded_inferences":["Do not use the 0.5 km thermal-front scale as current width.","Do not transfer LS05 20–80 m averaging to all Fig. 10 crossings.","Do not turn BarKode annual salinity variability into annual current width.","Do not admit doubled e-folding span or Gaussian FWHM as sourced widths."],"whole_current_length_km":null,"whole_current_width_km":null,"route_geometry":null,"remaining_gates":["Resolve exact composite depth averaging and crossing dates from underlying data.","Define comparable paired boundaries before any full-width comparison.","Review branch identity and along-route support; canonical admission remains pending."],"source_document_sha256":"76cdf260067540a0102d7f40d5f1220f7e6f3884f7f543d4deda6bef77612eaf","source_figures_inspected":["Fig. 1 PDF page 2","Fig. 9 PDF page 11"],"route_context_note":"Western Hopen Northern-branch studied reach has OSW-selected gates, distinct from full current system and transverse LS05 ship track."},"source_sha256":"68eb7e1aa063d2cdf736ac1470387d94b78096f2c87981edfb71fac1d051dc02"}]
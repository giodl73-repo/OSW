714f1550a2796c160a9f8415868129c17ca53f6"}]},{"id":"route-decision:mediterranean-undercurrent","entity_id":"current:mediterranean-undercurrent","label":"Mediterranean Undercurrent","current_id":"mediterranean-undercurrent","strategy_id":"layer_specific_route","strategy_label":"Construct layer-specific paths","construction_status":"editorial_candidate_present_scientific_review_pending","candidate_count":1,"route_ids":["mediterranean-undercurrent-reach-reference-path-candidate"],"next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","scope":"RAFOS floats and hydrography track the undercurrent from the Gulf of Cádiz around southwestern Portugal, where a roughly 30 km wide jet weakens and broadens northward. That width is cross-stream, not its length; branching and loss from the slope prevent a single measured endpoint here.","status":"editorial_planning_crosswalk_not_scientific_classification_approval","rank_eligible":false,"source_url":"https://doi.org/10.1029/2001JC001007","source_decision":{"current_id":"mediterranean-undercurrent","name":"Mediterranean Undercurrent","existing_length_evidence_status":"no_numeric_length","existing_scope":"RAFOS floats and hydrography track the undercurrent from the Gulf of Cádiz around southwestern Portugal, where a roughly 30 km wide jet weakens and broadens northward. That width is cross-stream, not its length; branching and loss from the slope prevent a single measured endpoint here.","name_source_url":"https://doi.org/10.1029/2001JC001007","candidate_ids":["mediterranean-undercurrent-reach-reference-path-candidate"],"reference_path_decision":"editorial_candidate_present_scientific_review_pending","published_length_rank_eligible":false,"ledger_kind":"intermediate-depth boundary undercurrent","route_strategy_id":"layer_specific_route","route_strategy_label":"Construct layer-specific paths","planning_status":"editorial_planning_crosswalk_not
inelibrary.wiley.com/doi/full/10.1029/2006JC003520","source_locator":"Mooring description, sections 3.1-3.2, discussion paragraph 46 and conclusion paragraph 52","observed_period":{"start":"2003-10-06","end":"2004-02-18"},"related_current_ids":["north-brazil"]},"document":{"schema":"osw.current-naming-scope-audit.v1","status":"editorial_scope_review_not_canonical_taxonomy_admission","date":"2026-10-03","current_ids":["guiana","north-brazil"],"assessment":"Guiana/Guyana identity requires an explicit nomenclature convention before independent route estimation. No alias merge or fixed physical boundary admitted.","sources":[{"url":"https://www.tidesandcurrents.noaa.gov/glossary.html","locator":"Guiana Current definition","evidence":"Northwestward northeast-South-American coastal current; no endpoint pair."},{"url":"https://os.copernicus.org/articles/19/251/2023/os-19-251-2023.html","locator":"Section 1, paragraph beginning North of 10 N","evidence":"Named Guyana continuation of non-retroflected NBC with seasonal NEC contribution; regional naming convention rather than universal boundary."},{"url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2006JC003520","citation":"Baklouti et al. (2007), New insights in the French Guiana continental shelf circulation and its relation to the North Brazil Current retroflection, JGR Oceans 112, doi:10.1029/2006JC003520","locator":"Abstract; introduction paragraphs 2-9; mooring description; sections 3.1-3.2; discussion paragraphs 46-47; conclusion paragraphs 50-55","access":"relevant_full_text_sections_read_not_source_data_or_figure_digitization","evidence":"French Guiana observations from 2003-10-06 to 2004-02-18: variable earlier flow, later northwestward flow; transition depends on site/depth. Non-detection of persistent flow at 22 m and below leaves upper-20-m flow possible; not basin-wide absence. Mooring distances, ring size and tracer boundaries are not current width."}],"remaining_work":["Review historical and modern Guiana/Guyana naming against local shelf and offshore circulation.","Define entry and Caribbean transition gates and season/layer; establish whether a distinct path is defensible.","Keep NBC route, ring tracks and downstream Caribbean route separate; do not sum shared named segments.","Resolve source convention and layer, obtain upper-layer observations and distinguish shelf flow from offshore ring passage before any annual axis or width."],"whole_current_length_km":null,"rank_eligible":false,"current_ledger_file":"research/ocean-current-almanac.json","current_ledger_sha256":"6c8a143208c0953512875f222154a819d5f56b7326daa6816f0609e61b4f261e","source_access":"Existing NOAA/Dimoune review retained. Baklouti relevant sections read 2026-10-03; AMS 2002 full-page fetch failed and indexed excerpt is not full-text review. No figures or data digitized.","current_id":"guiana","name":"Guiana Current","nomenclature_conventions":[{"source_url":"https://www.tidesandcurrents.noaa.gov/glossary.html","name":"Guiana Current","extent_convention":"Northwestward northeastern South American coastal flow; numeric endpoints unspecified.","physical_endpoint_boundary_established":false},{"source_url":"https://os.copernicus.org/articles/19/251/2023/os-19-251-2023.html","name":"Guyana Current","extent_convention":"Introduction names non-retroflected NBC continuation north of 10 N, with seasonal NEC contribution.","physical_endpoint_boundary_established":false},{"source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2006JC003520","name":"Guyana current","extent_convention":"Historical coastal-continuity interpretation tested against local shelf moorings and offshore mesoscale context.","physical_endpoint_boundary_established":false}],"continuity_assessment":{"decision":"retain_source_specific_named_flow_no_universal_axis_or_alias_merge","local_observed_period":{"start":"2003-10-06","end":"2004-02-18"},"observation_depth_scope":"22 m and deeper; unmeasured upper layer remains a possibility","full_year_observed":false,"local_non_detection_implies_global_absence":false,"ring_translation_is_current_axis":false,"tracer_boundary_is_current_edge":false,"annual_geometry_playback_eligible":false},"whole_current_width_km":null,"annual_length_range_km":null,"annual_width_range_km":null},"source_sha256":"f2894454ae49faf517035bfb19209c8dfd1654570c44af02d76105af97f2a160"}]},{"id":"route-decision:guinea","entity_id":"current:guinea","label":"Guinea Current","current_id":"guinea","strategy_id":"source_gated_regional_route","strategy_label":"Establish a sourced regional route","construction_status":"editorial_candidate_present_scientific_review_pending","candidate_count":1,"route_ids":["guinea-reference-path-candidate"],"next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","scope":"No comparable path-length estimate admitted yet.","status":"editorial_planning_crosswalk_not_scientific_classification_approval","rank_eligible":false,"source_url":"https://www.tidesandcurrents.noaa.gov/glossary.html","source_decision":{"current_id":"guinea","name":"Guinea Current","existing_length_evidence_status":"no_numeric_length","existing_scope":"No comparable path-length estimate admitted yet.","name_source_url":"https://www.tidesandcurrents.noaa.gov/glossary.html","candidate_ids":["guinea-reference-path-candidate"],"reference_path_decision":"editorial_candidate_present_scientific_review_pending","published_length_rank_eligible":false,"ledger_kind":"regional current","route_strategy_id":"source_gated_regional_route","route_strategy_label":"Establish a sourced regional route","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","planning_basis":"No comparable path-length estimate admitted yet.","next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","strategy_next_action":"Read primary geographic definitions, choose explicit endpoint/branch/layer/time conventions, and measure a reviewed route with alternatives; naming points alone are insufficient.","known_component_currents":[],"component_inventory_status":"not_assessed_by_this_planning_crosswalk"},"source_catalog_file":"research/ocean-current-reference-path-candidates.json","source_catalog_sha256":"b06caed27655c39f8127ddda441cba0a856800f599ec52edcd5b30d2ad37b633","scope_reviews":[]},{"id":"route-decision:gulf-stream-system","entity_id":"current:gulf-stream-system","label":"Gulf Stream System","current_id":"gulf-stream-system","strategy_id":"system_route_graph","strategy_label":"Define system and branch graph","construction_status":"reference_path_not_constructed","candidate_count":0,"route_ids":[],"next_action":"Specify the source-defined system, branch connectivity, depth and non-overlapping component gates; retain study reaches separately.","scope":"NOAA's glossary defines a continuous system comprising the Florida Current, Gulf Stream, and North Atlantic Current. The whole system extends beyond the Grand Banks toward the British Isles, so no 3,000 km Florida-to-Grand-Banks span is treated as its complete length.","status":"editorial_planning_crosswalk_not_scientific_classification_approval","rank_eligible":false,"source_url":"https://www.tidesandcurrents.noaa.gov/glossary.html","source_decision":{"current_id":"gulf-stream-system","name":"Gulf Stream System","existing_length_evidence_status":"no_numeric_length","existing_scope":"NOAA's glossary defines a continuous system comprising the Florida Current, Gulf Stream, and North Atlantic Current. The whole system extends beyond the Grand Banks toward the British Isles, so no 3,000 km Florida-to-Grand-Banks span is treated as its complete length.","name_source_url":"https://www.tidesandcurrents.noaa.gov/glossary.html","candidate_ids":[],"reference_path_decision":"reference_path_not_constructed","published_length_rank_eligible":false,"ledger_kind":"multi-segment current system","route_strategy_id":"system_route_graph","route_strategy_label":"Define system and branch graph","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","planning_basis":"NOAA's glossary defines a continuous system comprising the Florida Current, Gulf Stream, and North Atlantic Current. The whole system extends beyond the Grand Banks toward the British Isles, so no 3,000 km Florida-to-Grand-Banks span is treated as its complete length.","next_action":"Specify the source-defined system, branch connectivity, depth and non-overlapping component gates; retain study reaches separately.","strategy_next_action":"Specify the source-defined system, branch connectivity, depth and non-overlapping component gates; retain study reaches separately.","known_component_currents":[{"current_id":"florida","name":"Florida Current"},{"current_id":"gulf-stream","name":"Gulf Stream"},{"current_id":"north-atlantic","name":"North Atlantic Current"}],"component_inventory_status":"known_component_records_not_complete_census"},"source_catalog_file":"research/ocean-current-reference-path-candidates.json","source_catalog_sha256":"b06caed27655c39f8127ddda441cba0a856800f599ec52edcd5b30d2ad37b633","scope_reviews":[]},{"id":"route-decision:hiri-current","entity_id":"current:hiri-current","label":"Hiri Current","current_id":"hiri-current","strategy_id":"resolve_naming_scope","strategy_label":"Resolve naming or extent convention","construction_status":"editorial_candidate_present_scientific_review_pending","candidate_count":1,"route_ids":["hiri-reference-path-candidate"],"next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","scope":"The literature uses Hiri Current for the northward branch after South Equatorial Current bifurcation off northeast Australia, with variable continuation around the Gulf of Papua. No one fixed path or endpoint pair is admitted for a whole-current length.","status":"editorial_planning_crosswalk_not_scientific_classification_approval","rank_eligible":false,"source_url":"https://doi.org/10.1002/2013JC009591","source_decision":{"current_id":"hiri-current","name":"Hiri Current","existing_length_evidence_status":"no_numeric_length","existing_scope":"The literature uses Hiri Current for the northward branch after South Equatorial Current bifurcation off northeast Australia, with variable continuation around the Gulf of Papua. No one fixed path or endpoint pair is admitted for a whole-current length.","name_source_url":"https://doi.org/10.1002/2013JC009591","candidate_ids":["hiri-reference-path-candidate"],"reference_path_decision":"editorial_candidate_present_scientific_review_pending","published_length_rank_eligible":false,"ledger_kind":"northward western boundary branch and Gulf of Papua circulation","route_strategy_id":"resolve_naming_scope","route_strategy_label":"Resolve naming or extent convention","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","planning_basis":"The literature uses Hiri Current for the northward branch after South Equatorial Current bifurcation off northeast Australia, with variable continuation around the Gulf of Papua. No one fixed path or endpoint pair is admitted for a whole-current length.","next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","strategy_next_action":"Read competing definitions, resolve aliases versus distinct flows, and retain source-convention routes without merging their extents.","known_component_currents":[],"component_inventory_status":"not_assessed_by_this_planning_crosswalk"},"source_catalog_file":"research/ocean-current-reference-path-candidates.json","source_catalog_sha256":"b06caed27655c39f8127ddda441cba0a856800f599ec52edcd5b30d2ad37b633","scope_reviews":[]},{"id":"route-decision:indian-equatorial-undercurrent","entity_id":"current:indian-equatorial-undercurrent","label":"Indian Ocean Equatorial Undercurrent","current_id":"indian-equatorial-undercurrent","strategy_id":"seasonal_routes","strategy_label":"Construct seasonal routes","construction_status":"editorial_candidate_present_scientific_review_pending","candidate_count":1,"route_ids":["indian-euc-spring-observation-reach-reference-path-candidate"],"next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","scope":"Observed across a 2°S–2°N section at 90°E on 1–3 March 2017; the reported ~13.5 Sv is section transport, not path length. A later review describes the Indian expression as weaker and seasonally varying; one campaign does not establish a permanent path.","status":"editorial_planning_crosswalk_not_scientific_classification_approval","rank_eligible":false,"source_url":"https://repository.library.noaa.gov/view/noaa/64055","source_decision":{"current_id":"indian-equatorial-undercurrent","name":"Indian Ocean Equatorial Undercurrent","existing_length_evidence_status":"section_only","existing_scope":"Observed across a 2°S–2°N section at 90°E on 1–3 March 2017; the reported ~13.5 Sv is section transport, not path length. A later review describes the Indian expression as weaker and seasonally varying; one campaign does not establish a permanent path.","name_source_url":"https://repository.library.noaa.gov/view/noaa/64055","candidate_ids":["indian-euc-spring-observation-reach-reference-path-candidate"],"reference_path_decision":"editorial_candidate_present_scientific_review_pending","published_length_rank_eligible":false,"ledger_kind":"seasonal eastward subsurface jet","route_strategy_id":"seasonal_routes","route_strategy_label":"Construct seasonal routes","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","planning_basis":"Observed across a 2°S–2°N section at 90°E on 1–3 March 2017; the reported ~13.5 Sv is section transport, not path length. A later review describes the Indian expression as weaker and seasonally varying; one campaign does not establish a permanent path.","next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","strategy_next_action":"Choose sourced season, direction and layer; construct each supported seasonal path separately and preserve missing seasons.","known_component_currents":[],"component_inventory_status":"not_assessed_by_this_planning_crosswalk"},"source_catalog_file":"research/ocean-current-reference-path-candidates.json","source_catalog_sha256":"b06caed27655c39f8127ddda441cba0a856800f599ec52edcd5b30d2ad37b633","scope_reviews":[{"note":{"current_id":"indian-equatorial-undercurrent","label":"Dated subsurface band and transient undercurrent definition","audit_file":"research/indian-euc-dated-band-layer-season-scope-audit.json","summary":"The 1–3 March 2017 section at 90 E describes a roughly 300 km meridional current/salinity band span in the 80–150 m depth range. This is a local descriptive metric, not full width at every depth or along the current. Historical longitudinal samples do not establish one simultaneous axis; overlying flow, transient structure and seasonal exceptions need separate review.","source_url":"https://repository.library.noaa.gov/view/noaa/64055/noaa_64055_DS1.pdf","source_locator":"Data and Methods p. 3; Results p. 4 and Conclusions p. 5. Historical interpretation: Schott/McCreary (2001), sections 3.2–3.2.2, printed pp. 28–31.","observed_period":{"start":"2017-03-01","end":"2017-03-03"}},"document":{"schema":"osw.current-source-scope-audit.v1","current_id":"indian-equatorial-undercurrent","as_of":"2026-10-03","status":"editorial_source_scope_audit_not_canonical","source_url":"https://repository.library.noaa.gov/view/noaa/64055/noaa_64055_DS1.pdf","source_citation":"Siswanto, Kusmanto and McPhaden (2019), Estimated transport of Equatorial Undercurrent observed at 90 E during the Indonesia Prima 2017 campaign, doi:10.1088/1755-1315/303/1/012005.","source_locator":"Data and Methods p. 3; Results p. 4 and Conclusions p. 5. Historical interpretation: Schott/McCreary (2001), sections 3.2–3.2.2, printed pp. 28–31.","source_access":"2019 original six-page PDF text read, including Methods/Results/Conclusions and figure captions; no figure digitized. 2001 original review sections 3.2–3.2.2 and Figure 25 caption read. Original Taft (1967) source not inspected; 2015 Chen et al. full publisher page returned 403 and not used as full-paper evidence.","scope":"Dated local section at 90 E; historical basin observations remain separate from a connected current axis.","layer":"2017 reported strong saline eastward band within 80–150 m; not a uniform axis layer or full width at every depth. Historical upper-thermocline definitions can depend on overlying flow.","time_convention":"Local 1–3 March 2017 section, not recurring seasonal geometry. Historical February–May 1994 and August 1994 occurrences at 80.5 E remain separate evidence.","observed_period":{"start":"2017-03-01","end":"2017-03-03"},"local_band":{"measurement_id":"indian-euc-2017-03-described-subsurface-band","source_latitude_limits_degrees":[-1.2,1.5],"source_depth_range_m":[80,150],"approximate_meridional_span_km":300,"unrounded_meridional_span_km":298.5511199778176,"velocity_threshold_m_s":null,"span_is_full_width_at_every_depth":false,"latitude_limits_are_route_endpoints":false,"survey_latitude_support_degrees":[-2,2],"transport_salinity_domains_are_width_edges":false},"historical_definition_review":{"source_url":"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf","source_locator":"Sections 3.2–3.2.2, printed pp. 28–31; Figure 25 caption p. 30.","sampled_longitude_context_east":[53,91],"sampled_period":"March–April 1963, as described from Taft (1967)","sampled_positions_establish_simultaneous_connected_axis":false,"local_50_150m_1994_depth_context_applies_to_1963_basin_route":false,"mean_or_instantaneous_definition_requires_review":true,"eastward_subsurface_flow_alone_always_has_undercurrent_structure":false,"august_1994_occurrence_is_universal_season":false},"whole_current_length_km":null,"whole_current_width_km":null,"annual_length_range_km":null,"annual_width_range_km":null,"route_construction_status":"reference_path_not_constructed_pending_longitudinal_geometry","remaining_gates":["Define undercurrent using both subsurface and overlying profiles at each sampled longitude/time.","Recover compatible longitudinal axes before connecting historical positions or measuring whole-current length.","Diagnose transverse velocity edges; reported current/water-mass band limits are a different metric.","Recover repeated compatible dates and sections before seasonal dimensions; one local occurrence cannot define an annual cycle."]},"source_sha256":"c2a0afab6656131ca34d2fee5515258962043c8e7a090d369c24e4cd87ccaf88"}]},{"id":"route-decision:indian-south-equatorial-countercurrent","entity_id":"current:indian-south-equatorial-countercurrent","label":"Indian Ocean South Equatorial Countercurrent","current_id":"indian-south-equatorial-countercurrent","strategy_id":"seasonal_routes","strategy_label":"Construct seasonal routes","construction_status":"editorial_candidate_present_scientific_review_pending","candidate_count":1,"route_ids":["indian-secc-winter-reach-reference-path-candidate"],"next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","scope":"Repeated XBT shipping-line sections identify this flow, including a western line near 55°E with a variable trough around 5–10°S. Section transports and latitude bands are not an along-current length.","status":"editorial_planning_crosswalk_not_scientific_classification_approval","rank_eligible":false,"source_url":"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_6/b_fdi_45-46/010007560.pdf","source_decision":{"current_id":"indian-south-equatorial-countercurrent","name":"Indian Ocean South Equatorial Countercurrent","existing_length_evidence_status":"no_numeric_length","existing_scope":"Repeated XBT shipping-line sections identify this flow, including a western line near 55°E with a variable trough around 5–10°S. Section transports and latitude bands are not an along-current length.","name_source_url":"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_6/b_fdi_45-46/010007560.pdf","candidate_ids":["indian-secc-winter-reach-reference-path-candidate"],"reference_path_decision":"editorial_candidate_present_scientific_review_pending","published_length_rank_eligible":false,"ledger_kind":"eastward tropical countercurrent","route_strategy_id":"seasonal_routes","route_strategy_label":"Construct seasonal routes","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","planning_basis":"Repeated XBT shipping-line sections identify this flow, including a western line near 55°E with a variable trough around 5–10°S. Section transports and latitude bands are not an along-current length.","next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","strategy_next_action":"Choose sourced season, direction and layer; construct each supported seasonal path separately and preserve missing seasons.","known_component_currents":[],"component_inventory_status":"not_assessed_by_this_planning_crosswalk"},"source_catalog_file":"research/ocean-current-reference-path-candidates.json","source_catalog_sha256":"b06caed27655c39f8127ddda441cba0a856800f599ec52edcd5b30d2ad37b633","scope_reviews":[{"note":{"current_id":"indian-south-equatorial-countercurrent","label":"Winter surface reach versus spectral section regions","audit_file":"research/indian-secc-winter-surface-frequency-scope-audit.json","summary":"December-March surface drifter context supports the editorial 50-90 E studied reach. A 6-2.5 S frequency/phase classification band at 80.5 E is not paired-edge width. Surface flow stays distinct from the deeper SEUC; whole-current and annual dimensions remain unresolved.","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2019JC015483","source_locator":"Sections 2.1-2.2: drifter support, 1993-2018 selection, fitted seasonal fields and December-March winter. Section 3 seasonal discussion after Figures 5-6: eastward SECC reaches about 90 E before recirculating into SEC; Figure 13 caption.","observed_period":null,"related_current_ids":["indian-south-equatorial-undercurrent"],"supporting_sources":[{"label":"Section frequency and phase classification: Huang et al. (2023)","url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2022JC019147","locator":"Sections 2.1 and 3.1, Figure 2 caption","access":"Relevant full-text sections inspected; no current edge or width geometry extracted."}]},"document":{"schema":"osw.current-source-scope-audit.v1","current_id":"indian-south-equatorial-countercurrent","as_of":"2026-10-03","status":"editorial_source_scope_audit_not_canonical","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2019JC015483","source_citation":"Wu, Du, Qian, Cheng, Wang, Zhang and Peng (2020), Structure and Seasonal Variation of the Indian Ocean Tropical Gyre Based on Surface Drifters, Journal of Geophysical Research: Oceans, doi:10.1029/2019JC015483.","source_locator":"Sections 2.1-2.2: drifter support, 1993-2018 selection, fitted seasonal fields and December-March winter. Section 3 seasonal discussion after Figures 5-6: eastward SECC reaches about 90 E before recirculating into SEC; Figure 13 caption.","source_access":"Full publisher sections 2 and relevant section 3 seasonal discussion, Figure 5/13 captions and Conclusion inspected. No figure digitized, fitted field acquired or source trajectories traced.","scope":"Declared 50-90 E eastward winter surface reach. The 50 E start is an OSW offshore truncation beyond the western confluence, and 90 E follows approximate recirculation context. Neither is a diagnosed whole-current terminus. Excludes Somali/East African source legs, the southern return into SEC, South Java continuation, equatorial Wyrtki jets and subsurface SEUC.","layer":"Surface drifter climatology with GDP drogue support near 15 m and wind-slip-corrected undrogued observations; not a uniform fixed-depth current axis or full vertical extent. OSCAR upper-layer and deeper current diagnostics remain separate.","time_convention":"Source boreal winter December-March convention; Gauss-Markov seasonal climatology using 1993-2018 drifter context. Not a dated trajectory or complete annual route series.","observed_period":null,"sampling_context":{"selection_start_month":"1993-01","selection_end_month":"2018-10","months_are_exact_observation_dates":false,"drogue_support_depth_m":15,"mapped_grid_spacing_degrees":0.25,"bin_radius_degrees":1,"simple_bin_average_is_seasonally_unbiased":false,"source_figure_2_sampling_start_discrepancy":"Data selection states 1993 while Figure 2 caption states 1995; retained as unresolved source description."},"route_candidate_file":"research/indian-secc-winter-reach-reference-path-candidate.json","width_source_review":{"url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2022JC019147","citation":"Huang et al. (2023), Meridional-Width Variability of Near-Equatorial Zonal Currents Along 80.5 E on Seasonal to Interannual Timescales in the Indian Ocean, doi:10.1029/2022JC019147.","access":"Full publisher Introduction, sections 2.1/2.3/2.4/3.1 and Figure 2 caption inspected; no data/contours acquired.","locator":"Section 3.1 and Figure 2; OSCAR definition in 2.1.","latitude_limits_degrees":[-6,-2.5],"section_longitude_degrees_east":80.5,"role":"frequency_amplitude_phase_classification_region_not_paired_velocity_edges","numeric_current_width_km":null,"width_edges_diagnosed":false,"frequency_domain_span_is_full_width":false,"source_period_years":[1995,2016],"OSCAR_depth_support_m":[0,30],"ORAS5_text_caption_depth_conflict":"Methods says upper 30 m; Figure 2 caption says 0-40 m. No common fixed-depth width assigned.","strongest_eastward_month_context":[3,4],"late_summer_backflow_implies_same_annual_axis":false},"whole_current_length_km":null,"whole_current_width_km":null,"annual_length_range_km":null,"annual_width_range_km":null,"seasonal_route_playback_supported":false,"remaining_gates":["Extract the fitted winter velocity field and diagnose current-axis and gate locations.","Resolve source-flow confluence and eastern recirculation/continuation before whole-current length.","Retain drifter sampling bias and uncertainty; drawing offsets do not estimate those errors.","Recover comparable transverse velocity edges and repeat seasonal axes before width or annual extrema."]},"source_sha256":"3f0f00456c54814cfde2c00b97bfa7f34de0c9dace9c293318bfc02327b58606"}]},{"id":"route-decision:indian-south-equatorial-undercurrent","entity_id":"current:indian-south-equatorial-undercurrent","label":"Indian Ocean South Equatorial Undercurrent","current_id":"indian-south-equatorial-undercurrent","strategy_id":"seasonal_routes","strategy_label":"Construct seasonal routes","construction_status":"editorial_candidate_present_scientific_review_pending","candidate_count":1,"route_ids":["indian-seuc-mam-reach-reference-path-candidate"],"next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","scope":"A 10°S, 87°E mooring and reanalysis identify a subsurface eastward jet beneath the westward South Equatorial Current; its deep reach and seasonality differ from the Atlantic flow. No comparable whole-current length is admitted.","status":"editorial_planning_crosswalk_not_scientific_classification_approval","rank_eligible":false,"source_url":"https://doi.org/10.1029/2022GL098163","source_decision":{"current_id":"indian-south-equatorial-undercurrent","name":"Indian Ocean South Equatorial Undercurrent","existing_length_evidence_status":"no_numeric_length","existing_scope":"A 10°S, 87°E mooring and reanalysis identify a subsurface eastward jet beneath the westward South Equatorial Current; its deep reach and seasonality differ from the Atlantic flow. No comparable whole-current length is admitted.","name_source_url":"https://doi.org/10.1029/2022GL098163","candidate_ids":["indian-seuc-mam-reach-reference-path-candidate"],"reference_path_decision":"editorial_candidate_present_scientific_review_pending","published_length_rank_eligible":false,"ledger_kind":"seasonal deep-penetrating eastward jet","route_strategy_id":"seasonal_routes","route_strategy_label":"Construct seasonal routes","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","planning_basis":"A 10°S, 87°E mooring and reanalysis identify a subsurface eastward jet beneath the westward South Equatorial Current; its deep reach and seasonality differ from the Atlantic flow. No comparable whole-current length is admitted.","next_action":"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.","strategy_next_action":"Choose sourced season, direction and layer; construct each supported seasonal path separately and preserve missing seasons.","known_component_currents":[],"component_inventory_status":"not_assessed_by_this_planning_crosswalk"},"source_catalog_file":"research/ocean-current-reference-path-candidates.json","source_catalog_sha256":"b06caed27655c39f8127ddda441cba0a856800f599ec52edcd5b30d2ad37b633","scope_reviews":[{"note":{"current_id":"indian-south-equatorial-undercurrent","label":"March-May modeled reach and threshold-core spatial width","audit_file":"research/indian-seuc-mam-layer-core-scope-audit.json","summary":"March-May BRAN climatology supports a subsurface reach with OSW connecting vertices. Reported threshold-core widths vary across longitudes, not across seasons; density-layer context is separate from the three-dimensional core extent. Whole-current and annual dimensions remain unresolved. Source latitude and mooring-end-month inconsistencies are retained in the audit.","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2022GL098163","source_locator":"Sections 2-4 and Figure 2-3 captions","observed_period":null},"document":{"schema":"osw.current-source-scope-audit.v1","current_id":"indian-south-equatorial-undercurrent","as_of":"2026-10-03","status":"editorial_source_scope_audit_not_canonical","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2022GL098163","source_citation":"Chen, Han, Zu, Chu and Chen (2022), The Deep-Penetrating South Equatorial Undercurrent in the Tropical South Indian Ocean, Geophysical Research Letters 49, e2022GL098163, doi:10.1029/2022GL098163.","source_locator":"Sections 2-4, Figures 1-3 captions and Erratum.","source_access":"Full publisher HTML relevant text and captions inspected; no figure digitized, BRAN field acquired or Supporting Information inspected.","scope":"Declared 60-105 E March-May subsurface geographic reach. Approximate source longitude limits and west/east latitude context guide an OSW connecting path; not diagnosed whole-current endpoints. Surface SEC/SECC, equatorial EUC, ridge circulation loops and western/eastern extensions excluded.","layer":"BRAN2020 representative isopycnal context 27.9-28.7 sigma0. Source converts this to roughly 300-420 m at the mooring only; not a fixed-depth route throughout the basin.","time_convention":"March-May monthly climatological context from 2001-2018 BRAN2020. Not a dated observed axis, annual geometry or a reconstruction of the anomalous 2020 current.","observed_period":null,"route_candidate_file":"research/indian-seuc-mam-reach-reference-path-candidate.json","model_context":{"product":"BRAN2020","horizontal_resolution_degrees":0.1,"monthly_climatology_years":[2001,2018],"season_months":[3,4,5],"reference_density_range_sigma0":[27.9,28.7],"mooring_depth_conversion_is_uniform_basin_layer":false},"core_width_context":{"measurement_id":"indian-seuc-bran-mam-core-spatial-summary","velocity_component":"eastward_zonal_u","strict_threshold_m_s":0.1,"statistic":"median_across_longitudes","reported_median_km":169,"reported_spatial_range_km":[26,294],"annual_extrema_eligible":false,"fixed_depth_width":false},"source_consistency_notes":["One Results paragraph prints 10 N; abstract, mooring location and reach discussion give southern latitude. Typo retained as source conflict, not silently corrected.","Methods gives mooring August 2019-May 2020; Figure 1 caption says June 2020. No exact observation endpoint assigned.","Main occurrence January-June and weakening July-August differ from the Discussion January-August wording; this candidate uses March-May only.","Erratum supplies missing Figure 2 units; corrected HTML consulted."],"whole_current_length_km":null,"whole_current_width_km":null,"annual_length_range_km":null,"annual_width_range_km":null,"seasonal_route_playback_supported":false,"remaining_gates":["Extract compatible BRAN density-layer core geometry and review ridge-scale continuity before interpreting the connecting line as an axis.","Resolve source latitude typo (10 N in one paragraph versus 8-10 S elsewhere); southern context is used explicitly.","Review endpoint definitions and extensions before whole-current length.","Recover repeated matched axes and core boundaries before annual length/width extrema or seasonal playback."]},"source_sha256":"ee9f1525d6a8c0613bcd27f12d70265f0cf953f7f9815c3e625a4cf7b53a7627"}]},{"id":"route-decision:indonesian-throughflow","entity_id":"current:indonesian-throughflow","label":"Indonesian Throughflow","current_id":"indonesian-throughflow","strategy_id":"system_route_graph","strategy_label":"Define system and branch graph","construction_status":"reference_path_not_constructed","candidate_count":0,"route_ids":[],"next_action":"Use the source-described network in research/indonesian-throughflow-network-input.json to select individual layer-compatible branches and independently justify gateway/axis conventions. Twelve nodes and fourteen conceptual connections are queryable, with separate exit observations. No sum of branch lengths, scalar whole-system length or physical width follows from connectivity.","scope":"NASA names the Pacific-to-Indian freshwater passage through narrow gaps of the Maritime Continent but gives no single current centerline or whole-system length. This is a multi-channel flow, so no length enters the ranking.","status":"editorial_planning_crosswalk_not_scientific_classification_approval","rank_eligible":false,"source_url":"https://svs.gsfc.nasa.gov/5425","source_decision":{"current_id":"indonesian-throughflow","name":"Indonesian Throughflow","existing_length_evidence_status":"no_numeric_length","existing_scope":"NASA names the Pacific-to-Indian freshwater passage through narrow gaps of the Maritime Continent but gives no single current centerline or whole-system length. This is a multi-channel flow, so no length enters the ranking.","name_source_url":"https://svs.gsfc.nasa.gov/5425","candidate_ids":[],"reference_path_decision":"reference_path_not_constructed","published_length_rank_eligible":false,"ledger_kind":"interbasin passage system","route_strategy_id":"system_route_graph","route_strategy_label":"Define system and branch graph","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","planning_basis":"NASA names the Pacific-to-Indian freshwater passage through narrow gaps of the Maritime Continent but gives no single current centerline or whole-system length. This is a multi-channel flow, so no length enters the ranking.","next_action":"Use the source-described network in research/indonesian-throughflow-network-input.json to select individual layer-compatible branches and independently justify gateway/axis conventions. Twelve nodes and fourteen conceptual connections are queryable, with separate exit observations. No sum of branch lengths, scalar whole-system length or physical width follows from connectivity.","strategy_next_action":"Specify the source-defined system, branch connectivity, depth and non-overlapping component gates; retain study reaches separately.","known_component_currents":[],"component_inventory_status":"not_assessed_by_this_planning_crosswalk"},"source_catalog_file":"research/ocean-current-reference-path-candidates.json","source_catalog_sha256":"b06caed27655c39f8127ddda441cba0a856800f599ec52edcd5b30d2ad37b633","scope_reviews":[{"note":{"current_id":"indonesian-throughflow","label":"Source-described passage network and exit observations","audit_file":"research/indonesian-throughflow-network-scope-audit.json","summary":"Twelve conceptual nodes and fourteen selected passage connections; three 2004–2006 exit transport means and eight published mooring sites. No whole-system length, geographic graph edges or transfer of integration widths to physical current width.","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2008JC005257","source_locator":"Introduction paragraphs 3–4, Tables 1–2 and section 2.2","observed_period":{"start_year":2004,"end_year":2006,"precision":"year"}},"document":{"schema":"osw.current-source-scope-audit.v1","current_id":"indonesian-throughflow","as_of":"2026-10-04","status":"source_supported_conceptual_network_not_scientific_taxonomy_admission","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2008JC005257","source_access":"Publisher Introduction paragraphs 3–8, Tables 1–2 and section 2.2 read; no figure, field or transport time-series digitized.","source_locator":"Introduction paragraphs 3–4; Tables 1–2; section 2.2.","network_file":"research/indonesian-throughflow-network-input.json","summary":"Selected western/eastern inflow and three main exit pathways represented as twelve conceptual nodes and fourteen connections. Three exit transport means retain 2004–2006 support, processing-choice intervals and eight published first-deployment mooring positions. No geographic network edges, full system length, current width, annual extrema or instantaneous one-way-flow claim.","observed_period":{"start_year":2004,"end_year":2006,"precision":"year"},"source_time_caution":"Abstract mentions January 2003; Table 1 explicitly reports 2004–2006 averages. Individual mooring deployment dates differ, including an August 2003 Ombai deployment. Preserve these distinctions.","integration_width_caution":"35/35/160 km are transport-integration widths, not current widths. Ombai geographic width is discussed as 37 km in paragraph 8, while transport calculations use 35 km. Neither provides a uniform current footprint.","whole_current_length_km":null,"whole_current_width_km":null,"annual_length_range_km":null,"annual_width_range_km":null,"rank_eligible":false,"canonical_taxonomy_admitted":false,"remaining_gates":["Assess full passage/depth coverage and reversals; no complete network asserted.","Recover axes and scientifically justify branch gates before measuring lengths.","Keep upstream and downstream transport budgets separate; no sum over graph edges.","Review original processing and observation gaps before new derived dimensions."]},"source_sha256":"a857f6be29353bfb10f79fb91f51466049fc3324cd769d56de44af60e1506a0a"},{"note":{"current_id":"indonesian-throughflow","label":"Measurement object scope: passage network","audit_file":"research/current-measurement-scopes/indonesian-throughflow.json","summary":"Measure each passage with explicit depth, period and boundary rules. Channel and transport-integration spans are not current-width boundaries.","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2008JC005257","source_locator":"Existing cited current ledger entry and explicit component links; retained source-scope audit research/indonesian-throughflow-network-scope-audit.json","observed_period":null,"measurement_scope_assessment":true,"related_current_ids":[],"related_proposed_current_ids":[]},"document":{"schema":"osw.current-measurement-object-scope.v1","current_id":"indonesian-throughflow","name":"Indonesian Throughflow","status":"editorial_measurement_scope_assessment_not_physical_taxonomy_admission","scope_kind":"passage_network","summary":"Measure each passage with explicit depth, period and boundary rules. Channel and transport-integration spans are not current-width boundaries.","members":[],"source_registry_file":"research/current-measurement-object-scope-index.json","basis_object_sha256":"6f438c549817bd4f0099f727b6244b62fc99ad4a9607e1f3ed1bc89f655e360e","generator_file":"analysis/build_current_measurement_scopes.py","generator_sha256":"1357a690e4780eff266db7e95c1998498df88f1e76fdff570b2676d78528534f","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2008JC005257","source_locator":"Existing cited current ledger entry and explicit component links; retained source-scope audit research/indonesian-throughflow-network-scope-audit.json","source_access":"Existing cited ledger and retained scope evidence reviewed; no new field or original-page extraction claimed.","prior_scope_audit_file":"research/indonesian-throughflow-network-scope-audit.json","prior_width_decision":"width_not_assessed","parent_width_km":null,"annual_width_range_km":null,"new_width_record_admitted":false,"member_measurements_inherited":false,"aliases_resolved":false,"physical_taxonomy_admitted":false,"physical_edge_geometry_admitted":false,"observation_date_inherited":false,"figure":"figures/current-measurement-scopes/indonesian-throughflow.svg","figure_alt":"Measure each passage with explicit depth, period and boundary rules. Channel and transport-integration spans are 
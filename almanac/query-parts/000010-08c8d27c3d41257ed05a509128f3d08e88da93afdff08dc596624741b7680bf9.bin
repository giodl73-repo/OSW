n-naming-branch-scope-audit.json","summary":"NOAA Norwegian Current is a broad northeastward off-Norway naming convention. The modern Norwegian Atlantic Current, with separate slope and front branches, is not automatically this ledger identity or the Norwegian Coastal Current. Name equivalence remains unresolved; whole-current dimensions remain unknown.","related_current_ids":["norwegian-coastal"],"source_url":"https://tidesandcurrents.noaa.gov/glossary","source_locator":"Norwegian Current, North Atlantic Current and Spitsbergen Atlantic Current entries.","observed_period":null},"document":{"schema":"osw.current-source-scope-audit.v1","current_id":"norwegian","as_of":"2026-10-03","status":"editorial_source_scope_audit_not_canonical","source_url":"https://tidesandcurrents.noaa.gov/glossary","source_access":"Relevant current glossary entries read; not full glossary read.","source_locator":"Norwegian Current, North Atlantic Current and Spitsbergen Atlantic Current entries.","supporting_sources":[{"url":"https://os.copernicus.org/articles/22/17/2026/","citation":"Baumann, Skagseth, Ingvaldsen and Mork (2026), Reduced cooling in the Norwegian Atlantic Slope Current: investigating mechanisms of change from 30 years of observations, Ocean Science 22, 17–29, doi:10.5194/os-22-17-2026.","locator":"Introduction: two Atlantic branches and northern bifurcation; sections 2.1–2.1.2: sampling/core criteria.","source_access":"Relevant introduction and methods read.","source_license":"CC BY 4.0"}],"summary":"NOAA Norwegian Current is a broad northeastward off-Norway naming convention. The modern Norwegian Atlantic Current, with separate slope and front branches, is not automatically this ledger identity or the Norwegian Coastal Current. Name equivalence remains unresolved; whole-current dimensions remain unknown.","related_current_ids":["norwegian-coastal"],"name_equivalence_admitted":false,"whole_current_length_km":null,"whole_current_width_km":null,"annual_length_range_km":null,"a
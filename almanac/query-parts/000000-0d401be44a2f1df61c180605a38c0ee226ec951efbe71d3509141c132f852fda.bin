_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"source_license\": \"Factual regional geography paraphrased with attribution; no source figures, model fields or particle tracks packaged.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.15,\r\n    0,\r\n    0.15\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.15,\r\n    0,\r\n    0.15\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-03\",\r\n  \"map_label_size\": 1.5,\r\n  \"legend_line_spacing\": 2.7,\r\n  \"map_symbol_scale\": 0.55,\r\n  \"remaining_gates\": [\r\n    \"Scientific review of naming limits, layer and regional gate conventions.\",\r\n    \"Verify bathymetric and velocity correspondence; coarse land clearance does not establish a current axis.\",\r\n    \"Canonical admission and publication review; retain regional scope and editorial provenance.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"mindanao-current\",\r\n  \"name\": \"Mindanao Current\",\r\n  \"scope\": \"Southward Philippine eastern-boundary regional route from a near-surface NEC bifurcation gate at 14.3 N to an OSW southern Mindanao approach gate at 5.5 N. Excludes downstream Indonesian Throughflow, NECC and EUC routes, Mindanao and Halmahera eddy circuits, and Mindanao Undercurrent. The southern gate is an editorial regional limit, not an established whole-current endpoint.\",\r\n  \"layer\": \"Near-surface gate convention only; excludes the northward undercurrent and deeper bifurcation latitudes. No fixed-depth core traced.\",\r\n  \"time_convention\": \"Northern gates use near-surface annual mean and May/September climatological model conventions from 1982-1998. Alternatives change the gate, not the full seasonal velocity axis; not a measured annual length distribution.\",\r\n  \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2003jc002013\",\r\n  \"source_locator\": \"Kim et al. (2004), section 3.1 paragraphs 12-14: model climatology, near-surface 14.3 N mean and 13.2 N May/15.1 N September gates; distinguish deeper gates and undercurrent.\",\r\n  \"source_citation\": \"Kim et al. (2004), Seasonal and interannual variations of the North Equatorial Current bifurcation in a high-resolution OGCM, Journal of Geophysical Research: Oceans, doi:10.1029/2003JC002013.\",\r\n  \"coordinate_selection\": \"OSW chooses all offshore waypoints and the 5.5 N southern gate. Only the northern latitude conventions come from model prose. Offshore longitudes are schematic, not extracted model zero-velocity positions. Seasonal alternatives retain the same downstream vertices. Neither the 8.098 N interception section in Grenier nor deeper 500 m bifurcation gates define this route.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      125.5,\r\n      14.3\r\n    ],\r\n    [\r\n      126.5,\r\n      12\r\n    ],\r\n    [\r\n      127,\r\n      10\r\n    ],\r\n    [\r\n      127,\r\n      8\r\n    ],\r\n    [\r\n      126.5,\r\n      6\r\n    ],\r\n    [\r\n      126,\r\n      5.5\r\n    ]\r\n  ],\r\n  \"scenario_rule\": \"Three near-surface northern gate conventions crossed with three longitude and independent endpoint latitude shifts: 81 editorial scenarios, not empirical uncertainty.\",\r\n  \"map_view_box\": [\r\n    1285,\r\n    355,\r\n    100,\r\n    100\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"14.3 N surface gate\",\r\n    \"5.5 N regional gate\"\r\n  ],\r\n  \"figure_source_label\": \"Kim (2004); Grenier (2011)\",\r\n  \"route_extent_kind\": \"Mindanao near-surface branch\",\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"may_surface_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          125.8,\r\n          13.2\r\n        ],\r\n        [\r\n          126.5,\r\n          12\r\n        ],\r\n        [\r\n          127,\r\n          10\r\n        ],\r\n        [\r\n          127,\r\n          8\r\n        ],\r\n        [\r\n          126.5,\r\n          6\r\n        ],\r\n        [\r\n          126,\r\n          5.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"May near-surface model gate; remaining vertices are unchanged OSW geography.\"\r\n    },\r\n    {\r\n      \"id\": \"september_surface_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          125,\r\n          15.1\r\n        ],\r\n        [\r\n          126.5,\r\n          12\r\n        ],\r\n        [\r\n          127,\r\n          10\r\n        ],\r\n        [\r\n          127,\r\n          8\r\n        ],\r\n        [\r\n          126.5,\r\n          6\r\n        ],\r\n        [\r\n          126,\r\n          5.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"September near-surface model gate; not the deep winter bifurcation.\"\r\n    }\r\n  ],\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2011JC007477\",\r\n      \"citation\": \"Grenier et al. (2011), From the western boundary currents to the Pacific Equatorial Undercurrent: Modeled pathways and water mass evolutions, doi:10.1029/2011JC007477.\",\r\n      \"locator\": \"Introduction paragraph 5 and Table 1: southward Philippine boundary current, downstream feeds and a separate 8.098 N model interception section.\",\r\n      \"role\": \"Topology only; interception section, particle tracks and transport are not whole-current length.\"\r\n    }\r\n  ],\r\n  \"input_sha256\": \"c3f0380f6f65609a5b6611a24980d36a5839ffa0f4cd2a6175f977a66aef4b4b\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is 
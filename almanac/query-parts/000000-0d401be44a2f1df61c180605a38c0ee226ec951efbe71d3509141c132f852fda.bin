\"input_file\": \"research/tsushima-coastal-reference-path-input.json\",\r\n  \"figure\": \"figures/tsushima-coastal-reference-path-candidate.svg\"\r\n}\r\n"},"research/baffin-reach-reference-path-candidate.json":{"source_sha256":"338a63586cbe455413482b1f3065068ccb994e2f78d488118a9d036c844c22b4","source_json":"{\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"source_license\": \"Factual study geography paraphrased with attribution; no source prose, figures or drifter trajectories packaged.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.1,\r\n    0,\r\n    0.1\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_studied_reach_routes\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"map_label_size\": 1.6,\r\n  \"legend_line_spacing\": 2.6,\r\n  \"map_symbol_scale\": 0.65,\r\n  \"remaining_gates\": [\r\n    \"Scientific review of regional extent, exclusions and endpoint conventions.\",\r\n    \"Verify coastal/ridge correspondence with reproducible bathymetry or suitable layer-specific velocity geometry.\",\r\n    \"Canonical admission and publication review; retain partial/regional scope.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"baffin\",\r\n  \"name\": \"Baffin Current\",\r\n  \"scope\": \"Summer western-Baffin-Bay external coastal reference reach between OSW gates near the source-observed Lady Ann Strait latitude (76 N) and Cape Dyer latitude (67 N). Omits the Lancaster Sound intrusion and return, upstream Arctic strait feeders, transient eddies and continuation through southern Davis Strait. Source says at least these latitude limits; they are not whole-current endpoints. Exact offshore vertices are OSW choices, not a digitized observed trajectory.\",\r\n  \"layer\": \"Summer near-surface regional reach; source uses drifters, CTD and current meters at differing depths. No common-depth current axis reconstructed.\",\r\n  \"time_convention\": \"Summer 1978/1979 geographic reach convention; editorial route does not represent one continuous observed dated trajectory or winter flow.\",\r\n  \"source_url\": \"https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/63268.pdf\",\r\n  \"source_locator\": \"Fissel, Lemon and Birch (1982), abstract, printed p. 180/PDF index 0: observed at least Lady Ann Strait 76 N to Cape Dyer 67 N; strong Lancaster intrusion. Results, p. 183/PDF index 3: western Baffin Bay flow into Davis Strait.\",\r\n  \"source_citation\": \"Fissel, Lemon and Birch (1982), Major Features of the Summer Near-Surface Circulation of Western Baffin Bay, 1978 and 1979, Arctic 35(1), 180-200.\",\r\n  \"coordinate_selection\": \"OSW selects external coastal waypoints and exact longitude gates. Lancaster Sound intrusion is explicitly omitted rather than silently inferred across unresolved narrow channels. Longitude alternatives test the offshore display corridor; the study latitude range is a reach bound, not full named-current origin/termination.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -76,\r\n      76\r\n    ],\r\n    [\r\n      -75,\r\n      74.5\r\n    ],\r\n    [\r\n      -73,\r\n      73\r\n    ],\r\n    [\r\n      -70,\r\n      71.5\r\n    ],\r\n    [\r\n      -67,\r\n      70\r\n    ],\r\n    [\r\n      -64,\r\n      68.5\r\n    ],\r\n    [\r\n      -61,\r\n      67\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"alternative_external_corridor\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -77,\r\n          76\r\n        ],\r\n        [\r\n          -76,\r\n          74.5\r\n        ],\r\n        [\r\n          -74,\r\n          73\r\n        ],\r\n        [\r\n   
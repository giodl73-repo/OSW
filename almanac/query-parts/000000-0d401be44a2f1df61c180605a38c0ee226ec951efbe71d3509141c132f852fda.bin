.json\",\r\n          \"observed_period\": null,\r\n          \"measurement_scope_assessment\": true,\r\n          \"related_current_ids\": [\r\n            \"norwegian-coastal\"\r\n          ],\r\n          \"related_proposed_current_ids\": []\r\n        }\r\n      ],\r\n      \"evidence_links\": [\r\n        {\r\n          \"label\": \"Proposed Atlantic slope branch widths · separate identity\",\r\n          \"url\": \"query.html?q=%7B%22collection%22%3A%22proposed_widths%22%2C%22filters%22%3A%5B%7B%22field%22%3A%22proposed_current_id%22%2C%22op%22%3A%22eq%22%2C%22value%22%3A%22norwegian-atlantic-slope%22%7D%5D%2C%22limit%22%3A20%7D#query-chart-section\"\r\n        }\r\n      ],\r\n      \"object_url\": \"object.html?id=current%3Anorwegian\",\r\n      \"route_url\": null,\r\n      \"season_url\": \"seasons.html?current=norwegian\",\r\n      \"scope_audits\": [\r\n        {\r\n          \"schema\": \"osw.current-source-scope-audit.v1\",\r\n          \"current_id\": \"norwegian\",\r\n          \"as_of\": \"2026-10-03\",\r\n          \"status\": \"editorial_source_scope_audit_not_canonical\",\r\n          \"source_url\": \"https://tidesandcurrents.noaa.gov/glossary\",\r\n          \"source_access\": \"Relevant current glossary entries read; not full glossary read.\",\r\n          \"source_locator\": \"Norwegian Current, North Atlantic Current and Spitsbergen Atlantic Current entries.\",\r\n          \"supporting_sources\": [\r\n            {\r\n              \"url\": \"https://os.copernicus.org/articles/22/17/2026/\",\r\n              \"citation\": \"Baumann, Skagseth, Ingvaldsen and Mork (2026), Reduced cooling in the Norwegian Atlantic Slope Current: investigating mechanisms of change from 30 years of observations, Ocean Science 22, 17–29, doi:10.5194/os-22-17-2026.\",\r\n              \"locator\": \"Introduction: two Atlantic branches and northern bifurcation; sections 2.1–2.1.2: sampling/core criteria.\",\r\n              \"source_access\": \"Relevant introductio
phy paraphrased with attribution; no source figures, model fields or particle tracks packaged.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.15,\r\n    0,\r\n    0.15\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.15,\r\n    0,\r\n    0.15\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-03\",\r\n  \"map_label_size\": 1.7,\r\n  \"legend_line_spacing\": 2.9,\r\n  \"map_symbol_scale\": 0.65,\r\n  \"remaining_gates\": [\r\n    \"Scientific review of naming limits, layer and regional gate conventions.\",\r\n    \"Verify bathymetric and velocity correspondence; coarse land clearance does not establish a current axis.\",\r\n    \"Canonical admission and publication review; retain regional scope and editorial provenance.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"north-brazil\",\r\n  \"name\": \"North Brazil Current\",\r\n  \"scope\": \"Northwestward surface North Brazil regional branch from an OSW gate near the source-described 5 S origin to a nominal 7 N retroflection approach. Alternative terminal conventions stop at 5 or 9 N. Excludes upstream North Brazil Undercurrent, offshore retroflected return branch, NECC/EUC continuations, Guiana continuation and detached ring tracks or perimeters. No whole circulation-system length asserted.\",\r\n  \"layer\": \"Surface/upper-layer regional geography after the upstream undercurrent surfaces; no fixed-depth core or velocity contour extracted.\",\r\n  \"time_convention\": \"Regional surface naming and retroflection gate conventions; not a dated axis, annual average or model-derived seasonal length distribution.\",\r\n  \"source_url\": \"https://os.copernicus.org/articles/19/251/2023/os-19-251-2023.html\",\r\n  \"source_locator\": \"Section 1: surface origin near 5 S, NBUC surfacing near 5-6 S, retroflection region 5-9 N / 45-50 W and named Guyana continuation north of 10 N.\",\r\n  \"source_citation\": \"Dimoune et al. (2023), Revisiting the tropical Atlantic western boundary circulation from a 25-year time series of satellite altimetry data, Ocean Science 19, 251-268, doi:10.5194/os-19-251-2023.\",\r\n  \"coordinate_selection\": \"OSW selects all longitudes and route vertices. Start latitude uses the source surface-origin convention; 5/7/9 N terminal gates sample the source retroflection region. Offshore departure position and curve are not traced from altimetry. NOAA describes a wider 4-10 N retroflection range, outside this finite scenario set.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -34.5,\r\n      -5\r\n    ],\r\n    [\r\n      -35.5,\r\n      -3\r\n    ],\r\n    [\r\n      -38,\r\n      -1\r\n    ],\r\n    [\r\n      -41,\r\n      0.5\r\n    ],\r\n    [\r\n      -44,\r\n      2\r\n    ],\r\n    [\r\n      -47,\r\n      4\r\n    ],\r\n    [\r\n      -49.5,\r\n      7\r\n    ]\r\n  ],\r\n  \"scenario_rule\": \"Three terminal-region conventions crossed with longitude and independent endpoint latitude offsets: 81 editorial scenarios; not statistical uncertainty or all observed retroflections.\",\r\n  \"map_view_box\": [\r\n    575,\r\n    380,\r\n    110,\r\n    135\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"5 S surface-origin gate\",\r\n    \"7 N retroflection approach\"\r\n  ],\r\n  \"figure_source_label\": \"Dimoune (2023); NOAA/AOML\",\r\n  \"route_extent_kind\": \"North Brazil surface branch\",\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"early_retreflection_approach\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -34.5,\r\n          -5\r\n        ],\r\n        [\r\n          -35.5,\r\n          -3\r\n        ],\r\n        [\r\n          -38,\r\n          -1\r\n        ],\r\n        [\r\n          -41,\r\n          0.5\r\n        ],\r\n        [\r\n          -44,\r\n          2\r\n        ],\r\n        [\r\n          -47,\r\n          4\r\n        ],\r\n        [\r\n          -48,\r\n          5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Earlier 5 N regional departure convention; no offshore return branch included.\"\r\n    },\r\n    {\r\n      \"id\": \"late_retreflection_approach\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -34.5,\r\n          -5\r\n        ],\r\n        [\r\n          -35.5,\r\n          -3\r\n        ],\r\n        [\r\n          -38,\r\n          -1\r\n        ],\r\n        [\r\n          -41,\r\n          0.5\r\n        ],\r\n        [\r\n          -44,\r\n          2\r\n        ],\r\n        [\r\n          -47,\r\n          4\r\n        ],\r\n        [\r\n          -49.5,\r\n          7\r\n        ],\r\n        [\r\n          -50,\r\n          9\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Later 9 N offshore approach convention; not continuation to Caribbean.\"\r\n    }\r\n  ],\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://www.aoml.noaa.gov/phod/altimetry/cvar/nbc/\",\r\n      \"citation\": \"NOAA/AOML, North Brazil Current overview.\",\r\n      \"locator\": \"Overview: northeast Brazil boundary current and retroflection between 4 and 10 N; separate northwestward rings.\",\r\n      \"role\": \"Broader endpoint variability context; rings are not added to route length.\"\r\n    }\r\n  ],\r\n  \"input_sha256\": \"4e17b86e8a7980aa3dc01853241a770ddd852bdfa778417ad40ec9421b3d26f8\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 2180.806,\r\n  \"reported_approximate_reference_path_km\": 2200,\r\n  \"scenario_range_km\": [\r\n    1879.361,\
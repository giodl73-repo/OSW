etry extracted.\"\r\n            }\r\n          ]\r\n        }\r\n      ],\r\n      \"evidence_links\": [\r\n        {\r\n          \"label\": \"View current research evidence\",\r\n          \"url\": \"query.html?q=%7B%22collection%22%3A%22diagnostics%22%2C%22filters%22%3A%5B%7B%22field%22%3A%22id%22%2C%22op%22%3A%22eq%22%2C%22value%22%3A%22diagnostic%3Acurrent-research%3Aindian-south-equatorial-countercurrent%22%7D%5D%2C%22limit%22%3A100%7D#query-chart-section\"\r\n        },\r\n        {\r\n          \"label\": \"1995–2016 calendar-month climatology at 80.333 E profiles\",\r\n          \"url\": \"../figures/indian-secc-80p333e-1995-2016-monthly-component-profiles.svg\"\r\n        },\r\n        {\r\n          \"label\": \"1995–2016 calendar-month climatology at 80.667 E profiles\",\r\n          \"url\": \"../figures/indian-secc-80p667e-1995-2016-monthly-component-profiles.svg\"\r\n        },\r\n        {\r\n          \"label\": \"1995–2016 year-by-year monthly section spans\",\r\n          \"url\": \"../figures/indian-secc-1995-2016-yearly-monthly-spans.svg\"\r\n        }\r\n      ],\r\n      \"object_url\": \"object.html?id=current%3Aindian-south-equatorial-countercurrent\",\r\n      \"route_url\": \"reference-routes.html#indian-secc-winter-reach-reference-path-candidate\",\r\n      \"season_url\": \"seasons.html?current=indian-south-equatorial-countercurrent\"\r\n    },\r\n    {\r\n      \"id\": \"current:indian-south-equatorial-undercurrent\",\r\n      \"label\": \"Indian Ocean South Equatorial Undercurrent\",\r\n      \"type\": \"named_current\",\r\n      \"identity_level\": \"current\",\r\n      \"source_kind\": \"seasonal deep-penetrating eastward jet\",\r\n      \"setting\": \"equatorial\",\r\n      \"time_behavior\": \"seasonal\",\r\n      \"basin\": \"South Indian Ocean\",\r\n      \"capabilities\": {\r\n        \"observed_velocity\": 0,\r\n        \"radius_evidence\": 0,\r\n        \"reported_length\": 0,\r\n        \"reference_route\": 1,\r\n        \"s
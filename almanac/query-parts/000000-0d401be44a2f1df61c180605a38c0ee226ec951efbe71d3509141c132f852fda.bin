ependent endpoint latitude shifts (-0.25/0/+0.25 degrees): 54 editorial scenarios, not empirical uncertainty.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.15,\r\n    0,\r\n    0.15\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"remaining_gates\": [\r\n    \"Scientific review of Zeehan component gates and southern east-coast continuation.\",\r\n    \"Check shelf/slope correspondence with reproducible bathymetric or velocity data.\",\r\n    \"Canonical admission and publication review; retain changing seasonal scope and separate system measurement.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    1300,\r\n    560,\r\n    180,\r\n    180\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"Western Bass approach\",\r\n    \"Southern east-coast gate\"\r\n  ],\r\n  \"figure_source_label\": \"Ridgway & Condie (2004)\",\r\n  \"route_extent_kind\": \"winter Zeehan component\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"input_sha256\": \"ceb337756ebc6ec247712f761c08aad4ff9ea84e9e179fc30c544a0650af9162\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 789.7,\r\n  \"reported_approximate_reference_path_km\": 800,\r\n  \"scenario_range_km\": [\r\n    567.086,\r\n    843.072\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    500,\r\n    900\r\n  ],\r\n  \"scenario_count\": 54,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.15,\r\n      \"st
 ],\r\n        [\r\n          -102.25,\r\n          6\r\n        ],\r\n        [\r\n          -94.75,\r\n          7\r\n        ]\r\n      ],\r\n      \"length_km\": 5002.187,\r\n      \"atlas_state_crossings\": [\r\n        \"CAMR\",\r\n        \"PEQD\",\r\n        \"PNEC\"\r\n      ]\r\n    },\r\n    {\r\n      \"route_variant_id\": \"southern_editorial_bend\",\r\n      \"longitude_offset_degrees\": 0.25,\r\n      \"start_latitude_offset_degrees\": 0.25,\r\n      \"end_latitude_offset_degrees\": 0.25,\r\n      \"start_longitude_offset_degrees\": 0,\r\n      \"end_longitude_offset_degrees\": 0,\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -139.75,\r\n          7.25\r\n        ],\r\n        [\r\n          -132.25,\r\n          7\r\n        ],\r\n        [\r\n          -124.75,\r\n          7.5\r\n        ],\r\n        [\r\n          -117.25,\r\n          6.5\r\n        ],\r\n        [\r\n          -109.75,\r\n          5.5\r\n        ],\r\n        [\r\n          -102.25,\r\n          6\r\n        ],\r\n        [\r\n          -94.75,\r\n          7.25\r\n        ]\r\n      ],\r\n      \"length_km\": 5006.076,\r\n      \"atlas_state_crossings\": [\r\n        \"CAMR\",\r\n        \"PEQD\",\r\n        \"PNEC\"\r\n      ]\r\n    }\r\n  ],\r\n  \"map_land_check\": \"All 81 routes, geodesically densified at spacing no greater than 10 km, avoid the coarse OSW atlas land mask in display coordinates. This is not a shelf-break, reef, bathymetric or high-resolution land-clearance verification.\",\r\n  \"state_relation_role\": \"Editorial line/display-region crossing; physical current passage unresolved.\",\r\n  \"atlas_map_sha256\": \"5999bbad0e49209b2609a20a52a3e6310aa749224b574cb2f6cbcac0e68db032\",\r\n  \"nominal_atlas_state_crossings\": [\r\n    \"CAMR\",\r\n    \"PEQD\",\r\n    \"PNEC\"\r\n  ],\r\n  \"nasa_movie_context\": [\r\n    {\r\n      \"tile_id\": \"level2_A_3\",\r\n      \"url\": \"https://svs.gsfc.nasa.gov/vis/a000000/a005500/a005505/perpetual_oc
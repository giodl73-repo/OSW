gates\": [\r\n        \"Review exact temporal/spatial averaging weights and season calendar membership.\",\r\n        \"Independent scientific measurement admission; geographic boundaries remain unextracted.\"\r\n      ],\r\n      \"stream_mean_context\": {\r\n        \"audit_file\": \"research/kuroshio-liu-gan-2012-stream-mean-width-scope-audit.json\",\r\n        \"audit_sha256\": \"607924d8b2f54393fcb150bd29b6e08f5abc99616e72b9142f879a17ded83fcd\",\r\n        \"source_pdf_sha256\": \"a452007ff7f3b0051f811ba8172e9ae7932642ed1916a29c779db6335772203b\",\r\n        \"velocity_threshold_m_s\": 0.1,\r\n        \"velocity_component\": \"along_stream_parallel_to_diagnosed_axis\",\r\n        \"section_orientation\": \"normal_to_diagnosed_jet_axis\",\r\n        \"study_period_years\": [\r\n          1993,\r\n          2008\r\n        ],\r\n        \"season\": null,\r\n        \"temporal_statistic\": \"study_period_mean_of_weekly_diagnosed_section_widths\",\r\n        \"boundary_detection_precedes_averaging\": true,\r\n        \"width_of_mean_velocity_field\": false,\r\n        \"averaging_weight_detail_resolved\": false,\r\n        \"season_month_membership_resolved\": false,\r\n        \"paired_edges_extracted\": false,\r\n        \"isobath_is_measurement_layer\": false,\r\n        \"intrusive_reach_is_mainstream_width\": false\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"agulhas-act-eulerian-mean-section-width\",\r\n      \"current_id\": \"agulhas\",\r\n      \"name\": \"Agulhas Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_eulerian_mean_section_span\",\r\n      \"width_metric\": \"coast_to_author_reported_mean_zero_isotach\",\r\n      \"width_metric_label\": \"ACT coast-to-mean-zero-isotach span\",\r\n      \"approximate_width_km\": 219,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"No width uncertainty or annual range reported. Other arrays, periods and model products are not seasonal limits.\",\r\n      \"geographic_scope\": \"ACT section near 34 S off South Africa; not the whole Agulhas Current.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Author cross-track ACT section; exact endpoints and normal angle not extracted.\",\r\n      \"layer\": \"Mean jet depth extent about 3000 m is context; no fixed width measurement layer assigned.\",\r\n      \"time_convention\": \"April 2010-February 2013 averaging period, month precision; no instantaneous or seasonal width series extracted.\",\r\n      \"boundary_rule\": \"Author-reported fixed offshore distance from the coast to the time-mean zero-velocity isotach; negative cross-track flow denotes southwestward jet.\",\r\n      \"source_url\": \"https://journals.ametsoc.org/view/journals/phoc/45/5/jpo-d-14-0119.1.xml\",\r\n      \"source_citation\": \"Beal, Elipot, Houk and Leber (2015), JPO 45, 1302-1324, doi:10.1175/JPO-D-14-0119.1.\",\r\n      \"source_locator\": \"Abstract and section 4; section 2a array period; section 3b boundary-layer transport definition (coast to time-mean zero isotach).\",\r\n      \"source_retrieved_date\": \"2026-10-04\",\r\n      \"source_evidence_kind\": \"published_moored_eulerian_mean_section\",\r\n      \"extraction_method\": \"Transcribed author-reported scalar and boundary convention; no coordinates or raw velocities digitized.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"remaining_gates\": [\r\n        \"Inspect original source PDF and averaging convention.\",\r\n        \"Recover matched dated boundary coordinates and layer-supported seasonal widths.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"phase_label\": \"ACT mean section, April 2010-February 2013\",\r\n      \"phase_kind\": \"eulerian_mean_section_span\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n     
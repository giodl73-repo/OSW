     \"reported_length\": 0,\r\n        \"reference_route\": 1,\r\n        \"scoped_width\": 1,\r\n        \"geometry\": 0,\r\n        \"time_samples\": 0,\r\n        \"source_connectivity\": 0,\r\n        \"scope_notes\": 1,\r\n        \"dated_diagnostics\": 0,\r\n        \"flow_network\": 0,\r\n        \"passage_transport\": 0\r\n      },\r\n      \"recorded_claims\": 56,\r\n      \"nasa_links\": 1,\r\n      \"fingerprint\": \"09e94855b1dd5a0a18cf348ce6e66150717083b57deedc216e39472459eb6bd9\",\r\n      \"series\": [],\r\n      \"section_fingerprints\": {\r\n        \"identity\": \"b1c8906a25ad6ad587804f04466099547cae753c541712481dc5ef4cd479533d\",\r\n        \"sources\": \"8820055e02efaf1d936f716d20ff65f7282b16bf3c839f9f9cb6eb586e78bcce\",\r\n        \"claims\": \"be88bd40aae00fe7b3b08290c404279245d5128228dc2c60900bf58fdfd7e075\",\r\n        \"measurements\": \"9cc777503333f87728722fd998dece80c22178c9381c50e1d29176923c64d18f\",\r\n        \"routes_geometry\": \"5b81546f18eaaa4e47d986f05b41a1acc2a572033eec0d6f51aebb2f0e9bf882\",\r\n        \"media\": \"a98ff48b248288b17b237c4497a6a7ea45a0719a7fde48843331fcc9f237f5b4\",\r\n        \"time_evidence\": \"8d86da8229951992c802d517eaeaeeb84a4b5f1a3e916ecd7944f448135387bd\"\r\n      },\r\n      \"latest_observation_date\": null,\r\n      \"claim_review_counts\": {\r\n        \"not_individually_reviewed\": 56\r\n      },\r\n      \"linked_source_count\": 3,\r\n      \"map_features\": [\r\n        {\r\n          \"geometry\": {\r\n            \"coordinates\": [\r\n              -140,\r\n              4\r\n            ],\r\n            \"type\": \"Point\"\r\n          },\r\n          \"role\": \"editorial_locator\",\r\n          \"note\": \"Study-reported approximate 140°W section core at 4°N near 200 m; one cross-stream section does not define a basin-wide current route.\"\r\n        },\r\n        {\r\n          \"geometry\": {\r\n            \"type\": \"LineString\",\r\n            \"coordinates\": [\r\n              [\r\n                -155,\r\n                3.5\r\n              ],\r\n              [\r\n                -140,\r\n                3.8\r\n              ],\r\n              [\r\n                -125,\r\n                4.2\r\n              ],\r\n              [\r\n                -110,\r\n                4.5\r\n              ]\r\n            ]\r\n          },\r\n          \"role\": \"editorial_reference_route\",\r\n          \"note\": \"Declared northern Tsuchiya Jet studied reach from the 155 W mean-section core to the 110 W mean-section core. Western formation and basin continuation east of 110 W are excluded. The section gates truncate a larger current; interpolating bends are editor-selected, not a measured continuous centerline or particle path.\"\r\n        }\r\n      ],\r\n      \"state_evidence\": [],\r\n      \"connections\": [],\r\n      \"scope_notes\": [\r\n        {\r\n          \"current_id\": \"pacific-north-subsurface-countercurrent\",\r\n          \"label\": \"Northern Tsuchiya mean cores and integration limits\",\r\n          \"audit_file\": \"research/pacific-nscc-reach-layer-section-scope-audit.json\",\r\n          \"summary\": \"155 W to 110 W is an editorial northern Tsuchiya studied reach. Local mean cores shoal from 220 m to 130 m; no uniform axis depth inferred. Transport integration latitude limits are not width. Historical compilation dates do not date the route, and the 130 E NEUC identity is kept separate. A separate Rowe et al. general 2-degree meridional width summary is now retained as approximately 220 km; the two jet records share one source claim, not independent observations or annual extrema.\",\r\n          \"source_url\": \"https://www.pmel.noaa.gov/pubs/outstand/john1806/john1806.shtml\",\r\n          \"source_locator\": \"Sections 2-3 and Table 1: north SSCC peaks at 155 W 3.5 N/220 m and 110 W 4.5 N/130 m. Transport integration latitude limits and 700-dbar reference are separately defined; they are not route width or a uniform axis layer.\",\r\n          \"observed_period\": null\r\n        }\r\n      ],\r\n      \"evidence_links\": [],\r\n      \"object_url\": \"object.html?id=current%3Apacific-north-subsurface-countercurrent\",\r\n      \"route_url\": \"reference-routes.html#pacific-nscc-reach-reference-path-candidate\",\r\n      \"season_url\": \"seasons.html?current=pacific-north-subsurface-countercurrent\"\r\n    },\r\n    {\r\n      \"id\": \"current:pacific-south-equatorial-countercurrent\",\r\n      \"label\": \"Pacific South Equatorial Countercurrent\",\r\n      \"type\": \"named_current\",\r\n      \"identity_level\": \"current\",\r\n      \"source_kind\": \"seasonally varying eastward countercurrent\",\r\n      \"setting\": \"equatorial\",\r\n      \"time_behavior\": \"seasonal\",\r\n      \"basin\": \"Tropical South Pacific\",\r\n      \"capabilities\": {\r\n        \"observed_velocity\": 0,\r\n        \"radius_evidence\": 0,\r\n        \"reported_length\": 0,\r\n        \"reference_route\": 0,\r\n        \"scoped_width\": 1,\r\n        \"geometry\": 0,\r\n        \"time_samples\": 0,\r\n        \"source_connectivity\": 0,\r\n        \"scope_notes\": 2,\r\n        \"dated_diagnostics\": 0,\r\n        \"flow_network\": 0,\r\n        \"passage_transport\": 0\r\n      },\r\n      \"recorded_claims\": 56,\r\n      \"nasa_links\": 1,\r\n      \"fingerprint\": \"9df275d8ad33da61ba16e7116f8e767d7371b474c8a2a2e282c6e46c23e1bc20\",\r\n      \"series\": [],\r\n      \"section_fingerprints\": {\r\n        \"identity\": \"0a7c9e3aeadc47415d4d10a028f9175f4ae733f8e295ba3a97a4b47de019c4a4\",\r\n        \"sources\": \"c01001fb290345298b71eb8eb2cf5e545d46f5360685b9be789d23ec6f4d6b4b\",\r\n        \"claims\": \"a2260e85e85cdaacd05696a2bbc881fb6f1e636ebc87bed5300f637bf643449c\",\r\n        \"measurements\": \"48898dff5dc1c51f0d87ec135947e45563dfef5209883cd906076bda24075e23\",\r\n        \"routes_geometry\": \"74aeb995dc693bc0f23130b0cba8251d723d2686090deea7764749eca886698f\",\r\n        \"media\":
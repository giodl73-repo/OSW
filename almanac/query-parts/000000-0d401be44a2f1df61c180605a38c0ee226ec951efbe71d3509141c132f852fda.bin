cific Current\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"longitude_seam_policy\": \"shortest_geodesic_periodic_display\",\r\n  \"scope\": \"NOAA glossary regional extent from about 160 degrees E to an OSW gate at 145 degrees W, somewhat beyond the source's approximate 150 degrees W region. Alternative ends at 150 degrees W. This convention excludes downstream Alaska/California branches and the Kuroshio Extension. It is not the entire Japan-to-North-America circulation or a universal naming extent; AMS describes a different western origin near 170 degrees W.\",\r\n  \"layer\": \"Upper-ocean regional reference geography; no depth-specific velocity axis extracted.\",\r\n  \"time_convention\": \"Undated glossary-convention sketch; no simultaneous or climatological current axis inferred.\",\r\n  \"source_url\": \"https://www.tidesandcurrents.noaa.gov/glossary.html\",\r\n  \"source_locator\": \"North Pacific Current entry: eastward flow from approximately 160 degrees E to beyond approximately 150 degrees W, continuing Kuroshio Extension and branching south. Kuroshio Extension entry separates the preceding component.\",\r\n  \"source_citation\": \"NOAA Center for Operational Oceanographic Products and Services, Tides and Currents Glossary, North Pacific Current entry (accessed 2026-10-02).\",\r\n  \"source_license\": \"Factual geography only; no provider curves, map imagery or velocity field packaged.\",\r\n  \"coordinate_selection\": \"OSW selects all latitudes, intermediate vertices and the 145 degrees W terminal gate. NOAA's glossary supplies broad longitudinal limits and identity, not these coordinates or a measured flow axis. Three broad latitude conventions and two eastern gates expose some of that underdetermination.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      160,\r\n      38\r\n    ],\r\n    [\r\n      175,\r\n      40\r\n    ],\r\n    [\r\n      -170,\r\n      42\r\n    ],\r\n    [\r\n      -155,\r\n      42\r\n    ],\r\n    [\r\n      -145,\r\n      42\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"southern_corridor\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          160,\r\n          35\r\n        ],\r\n        [\r\n          175,\r\n          37\r\n        ],\r\n        [\r\n          -170,\r\n          38\r\n        ],\r\n        [\r\n          -155,\r\n          38\r\n        ],\r\n        [\r\n          -145,\r\n          38\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW southern latitude convention; not a source-diagnosed current axis.\"\r\n    },\r\n    {\r\n      \"id\": \"northern_corridor\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          160,\r\n          42\r\n        ],\r\n        [\r\n          175,\r\n          44\r\n        ],\r\n        [\r\n          -170,\r\n          45\r\n        ],\r\n        [\r\n          -155,\r\n          45\r\n        ],\r\n        [\r\n          -145,\r\n          45\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW northern latitude convention; mixed frontal identity requires review.\"\r\n    },\r\n    {\r\n      \"id\": \"near_150w_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          160,\r\n          38\r\n        ],\r\n        [\r\n          175,\r\n          40\r\n        ],\r\n        [\r\n          -170,\r\n          42\r\n        ],\r\n        [\r\n          -155,\r\n          42\r\n        ],\r\n        [\r\n          -150,\r\n          42\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Shorter eastern reference gate at the approximate longitude named by NOAA.\"\r\n    },\r\n    {\r\n      \"id\": \"southern_near_150w_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          160,\r\n          35\r\n        ],\r\n        [\r\n          175,\r\n          37\r\n        ],\r\n        [\r\n          -170,\r\n          38\r\n        ],\r\n        [\r\n          -155,\r\n          38\r\n        ],\r\n        [\r\n          -150,\r\n          38\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Southern OSW corridor with shorter eastern gate.\"\r\n    },\r\n    {\r\n      \"id\": \"northern_near_150w_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          160,\r\n          42\r\n        ],\r\n        [\r\n          175,\r\n          44\r\n        ],\r\n        [\r\n          -170,\r\n          45\r\n        ],\r\n        [\r\n          -155,\r\n          45\r\n        ],\r\n        [\r\n          -150,\r\n          45\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Northern OSW corridor with shorter eastern gate.\"\r\n    }\r\n  ],\r\n  \"scenario_rule\": \"Six corridor/gate combinations, three uniform longitude shifts (-0.5/0/+0.5 degrees) and independent endpoint latitude shifts (-0.5/0/+0.5 degrees): 162 editorial scenarios. These ranges are assumptions, not empirical positional errors.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.5,\r\n    0,\r\n    0.5\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.5,\r\n    0,\r\n    0.5\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"remaining_gates\": [\r\n    \"Independent review of NOAA versus other naming conventions and current identity across the latitude corridors.\",\r\n    \"Replace editorial waypoints with suitable upper-ocean velocity geometry; review eastern branching gates.\",\r\n    \"Canonical admission and publication review; preserve date-line policy and scope.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    1400,\r\n    185,\r\n    380,\r\n    200\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"160°E glossary gate\",\r\n    \"145°W OSW terminal gate\"\r\n  ],\r\n  \"figure_source_label\": \"NOAA currents glossary\",\r\n  \"route_extent_kind\": \"NOAA Nort
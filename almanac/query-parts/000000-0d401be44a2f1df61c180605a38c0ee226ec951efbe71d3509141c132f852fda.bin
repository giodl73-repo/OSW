"map_features\": [\r\n        {\r\n          \"geometry\": {\r\n            \"coordinates\": [\r\n              -42,\r\n              63\r\n            ],\r\n            \"type\": \"Point\"\r\n          },\r\n          \"role\": \"editorial_locator\",\r\n          \"note\": \"Editorial point along the 2004 surveyed inner southeast Greenland shelf; not a surveyed jet core or path endpoint. Distinct from the shelfbreak East Greenland Current.\"\r\n        },\r\n        {\r\n          \"geometry\": {\r\n            \"type\": \"LineString\",\r\n            \"coordinates\": [\r\n              [\r\n                -34.5,\r\n                66\r\n              ],\r\n              [\r\n                -38,\r\n                65.3\r\n              ],\r\n              [\r\n                -40,\r\n                64.5\r\n              ],\r\n              [\r\n                -40.3,\r\n                63.5\r\n              ],\r\n              [\r\n                -41.3,\r\n                62.8\r\n              ],\r\n              [\r\n                -42,\r\n                62\r\n              ],\r\n              [\r\n                -42.5,\r\n                61\r\n              ],\r\n              [\r\n                -42.9,\r\n                60\r\n              ]\r\n            ]\r\n          },\r\n          \"role\": \"editorial_reference_route\",\r\n          \"note\": \"Declared southeast Greenland coastal study-area reach from an OSW offshore gate near 66 N to a Cape Farewell offshore gate near 60 N. Excludes the weak northern 68 N identification, EGC shelfbreak path, Irminger Current, offshore diversions and West Greenland continuation. Not the full EGCC or the source-reported approximately 1000 km surveyed shelf. Near 63 N, the coastal and shelfbreak flows approach or merge; the line does not establish uninterrupted independent coastal flow. The local 30 km Cape Farewell width is not a buffer around this reach.\"\r\n        }\r\n      ],\r\n      \"state_evidence\": [],\r\n      \"connections\": [],\r\n      \"scope_notes\": [\r\n        {\r\n          \"current_id\": \"east-greenland-coastal\",\r\n          \"label\": \"Coastal studied reach, northern uncertainty and local threshold width\",\r\n          \"audit_file\": \"research/east-greenland-coastal-reach-scope-audit.json\",\r\n          \"summary\": \"The 66 N to Cape Farewell editorial reach is separate from the source approximately 1000 km shelf survey. Weak northern identification and merging near 63 N limit continuity claims. The 30 km Cape Farewell width uses a 15% inner-jet velocity threshold and cannot buffer this whole route or supply annual margins.\",\r\n          \"source_url\": \"https://www.whoi.edu/cms/files/Sutherland_EGCC_revised_withfigs_33743.pdf\",\r\n          \"source_locator\": \"Sutherland and Pickart (2008), section 3: Cape Farewell and 66 N section geography; section 3.5: weak assumed northern jet near 68 N; sections 8-9: merging near 63 N and approximately 1000 km shelf survey description. Relevant text inspected, no current-axis figure digitized.\",\r\n          \"observed_period\": null\r\n        }\r\n      ],\r\n      \"evidence_links\": [],\r\n      \"object_url\": \"object.html?id=current%3Aeast-greenland-coastal\",\r\n      \"route_url\": \"reference-routes.html#east-greenland-coastal-reach-reference-path-candidate\",\r\n      \"season_url\": \"seasons.html?current=east-greenland-coastal\"\r\n    },\r\n    {\r\n      \"id\": \"current:east-greenland\",\r\n      \"label\": \"East Greenland Current\",\r\n      \"type\": \"named_current\",\r\n      \"identity_level\": \"current\",\r\n      \"source_kind\": \"polar boundary current\",\r\n      \"setting\": \"polar_or_subpolar_margin\",\r\n      \"time_behavior\": \"persistent_variable\",\r\n      \"basin\": \"Arctic / North Atlantic\",\r\n      \"capabilities\": {\r\n        \"observed_velocity\": 0,\r\n        \"radius_evidence\": 0,\r\n        \"reported_length\": 0,\r\n        \"reference_rou
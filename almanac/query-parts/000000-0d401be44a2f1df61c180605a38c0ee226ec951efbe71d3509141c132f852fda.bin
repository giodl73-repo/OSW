an-atlantic\",\r\n      \"section_width_evidence\": [\r\n        {\r\n          \"name\": \"Norwegian Atlantic Slope Current\",\r\n          \"status\": \"editorial_width_evidence_for_proposed_identity_not_canonical\",\r\n          \"section_geometry\": null,\r\n          \"source_url\": \"https://os.copernicus.org/articles/16/685/2020/os-16-685-2020.pdf\",\r\n          \"source_citation\": \"Fer, I., Bosse, A., and Dugstad, J. (2020), Norwegian Atlantic Slope Current along the Lofoten Escarpment, Ocean Sci., 16, 685–701, doi:10.5194/os-16-685-2020.\",\r\n          \"source_retrieved_date\": \"2026-10-14\",\r\n          \"source_evidence_kind\": \"published_original_hydrographic_section_width\",\r\n          \"extraction_method\": \"Transcribed published numerical widths after original-page visual review; no field or edge-coordinate digitization.\",\r\n          \"whole_current_representative\": false,\r\n          \"width_rank_eligible\": false,\r\n          \"full_width_inference_eligible\": false,\r\n          \"annual_extrema_eligible\": false,\r\n          \"seasonal_playback_eligible\": false,\r\n          \"is_confidence_interval\": false,\r\n          \"observed_period\": null,\r\n          \"calendar_months\": null,\r\n          \"fixed_layer_bounds_m\": null,\r\n          \"uncertainty_km\": null,\r\n          \"whole_current_width_km\": null,\r\n          \"annual_width_range_km\": null,\r\n          \"remaining_gates\": [\r\n            \"Resolve catalog-name equivalence without transferring branch dimensions.\",\r\n            \"Extract exact section dates, layer support and paired edge coordinates before mapped or seasonal widths.\",\r\n            \"Independent scientific admission.\"\r\n          ],\r\n          \"id\": \"norwegian-fer-2020-gimsoy-relative-geostrophic-span\",\r\n          \"source_feature_name\": \"Norwegian Atlantic Slope Current\",\r\n          \"phase_kind\": \"campaign_relative_geostrophic_section_span\",\r\n          \"phase_label\": \"Gimsøy four-occupation relative-geostrophic span\",\r\n          \"measurement_type\": \"published_campaign_relative_geostrophic_span\",\r\n          \"width_metric\": \"relative_geostrophic_transport_density_twenty_percent_span\",\r\n          \"approximate_width_km\": null,\r\n          \"width_range_km\": [\r\n            25,\r\n            30\r\n          ],\r\n          \"range_kind\": \"author_reported_characteristic_section_span\",\r\n          \"range_interpretation\": \"Author-reported characteristic width span from the four-occupation analysis. No midpoint, per-date widths, confidence bounds or annual extrema.\",\r\n          \"geographic_scope\": \"Gimsøy hydrographic section near the Lofoten Escarpment; source-defined Norwegian Atlantic Slope Current, not Norwegian Coastal Current.\",\r\n          \"section_orientation\": \"Source hydrographic section across the continental slope; no reconstructed geographic edge coordinates.\",\r\n          \"layer\": \"Depth-integrated relative geostrophic current. Exact vertical integration limits for the width paragraph are unspecified; nearby mooring/transport layers are not assigned to width.\",\r\n          \"time_convention\": \"Four Gimsøy occupations: 2016-07-30, 2016-11-19, 2017-03-08, 2017-06-07. Source reports one characteristic range, not a width value for each date.\",\r\n          \"support_dates\": [\r\n            \"2016-07-30\",\r\n            \"2016-11-19\",\r\n            \"2017-03-08\",\r\n            \"2017-06-07\"\r\n          ],\r\n          \"boundary_rule\": \"Lateral depth-integrated relative geostrophic current reduced to 20% of its maximum; geostrophic reference is surface pressure.\",\r\n          \"source_locator\": \"Section 2.2, printed p688/PDF p4; Section 5, printed p692/PDF p8, right-column Gimsøy paragraph.\",\r\n          \"source_quality_note\": \"Width integration bounds and numerical width uncertainty unspecified. Effective 20.1 km mooring integration width and assumed 4 km error are different quantities. Catalog naming ambiguity remains.\",\r\n          \"original_regional_context\": {\r\n            \"description_kind\": \"gimsoy_relative_geostrophic_span\",\r\n            \"relative_threshold_fraction\": 0.2,\r\n            \"geostrophic_reference\": \"surface_pressure\",\r\n            \"exact_vertical_bounds_specified\": false,\r\n            \"catalogue_identity_ambiguity_retained\": true,\r\n            \"neighboring_transport_layer_is_width_layer\": false,\r\n            \"effective_transport_width_is_current_width\": false,\r\n            \"effective_transport_width_km\": 20.1,\r\n            \"effective_transport_width_error_km\": 4,\r\n            \"effective_transport_error_is_width_uncertainty\": false,\r\n            \"per_occupation_width_values_available\": false,\r\n            \"display_aria_label\": \"Source-defined Norwegian Atlantic Slope Current at Gimsøy: reported 25 to 30 km relative-geostrophic span, no midpoint or annual extrema. Catalog naming ambiguity retained.\",\r\n            \"display_caption\": \"Gimsøy: author-reported 25–30 km span at 20% of peak depth-integrated relative geostrophic current. Four occupations, not four dated numerical widths.\",\r\n            \"display_method_note\": \"Surface-pressure reference; width integration limits unspecified. The 20.1 km effective mooring integration width and its 4 km assumed error are separate. Norwegian Current naming remains unresolved.\",\r\n            \"comparison_figure\": \"figures/norwegian-fer-2020-section-width.svg\",\r\n            \"audit_file\": \"research/norwegian-fer-2020-gimsoy-width-scope-audit.json\",\r\n            \"audit_sha256\": \"084f2ab755c06589ab5985e362621e44eb1f08ec684d74e1086b65ede3c8c8bb\",\r\n            \"audit_pointer\": \"/measurements/0\"\r\n          },\r\n          \"proposed_current_id\": \"norwegian-atlantic-slope\",\r\n          \"canonical_current_id\": null,\r\n          \"canonical_transfer_eligible\": false,\
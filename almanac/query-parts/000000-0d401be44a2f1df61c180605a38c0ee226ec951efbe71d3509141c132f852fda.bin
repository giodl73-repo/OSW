file\": \"research/south-indian-eastern-reach-reference-path-input.json\",\r\n  \"figure\": \"figures/south-indian-eastern-reach-reference-path-candidate.svg\"\r\n}\r\n"},"research/tasman-historical-connection-reach-reference-path-candidate.json":{"source_sha256":"f6f60ba8fee67cf1f8163b6f616f664c674e2a7977d36c0d420c0e9c8407a80d","source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"tasman-front\",\r\n  \"name\": \"Tasman Front\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Historical Tasman Front naming convention represented by an OSW offshore 154 E to 172 E near-34 S regional connection. Gates truncate the Australia-northern-New-Zealand geography; neither coastal endpoints nor a continuously identifiable jet is claimed. Excludes coastal EAC, southern extension and East Auckland coastal continuation.\",\r\n  \"layer\": \"Historical upper-ocean thermal/front circulation context, not a fixed-depth velocity core. No temperature contour or measured meander digitized.\",\r\n  \"time_convention\": \"Undated historical reference connection. The source discusses separate September-October 1979 hydrography and March 1982-April 1985 SST statistics; neither supplies this drawn route. Later Oke et al. (2019) disputes a commonly continuous zonal jet.\",\r\n  \"source_url\": \"https://ocg.aori.u-tokyo.ac.jp/member/eoka/documents/Tomczak_Godfrey.pdf\",\r\n  \"source_locator\": \"Chapter 8, printed pp127-129 / PDF137-139: Australia-New Zealand connection near 34 S, meanders and statistically defined average position. Version 1.1 March 2005. Cited pages and Figure 8.23 visually inspected.\",\r\n  \"source_citation\": \"Tomczak, M. and J.S. Godfrey, Regional Oceanography: An Introduction (1994), university-hosted online compilation, chapter versions stated separately.\",\r\n  \"source_license\": \"No redistribution license established; original retained locally and ignored. Paraphrased factual annotations and independent OSW vertices only; no original image or curve copied.\",\r\n  \"source_retrieved_date\": \"2026-10-09\",\r\n  \"coordinate_selection\": \"OSW selects offshore regional gates and rounded vertices within the described geography. Alternative shapes shift intermediate latitudes by +/- 0.5 degree; longitude and independent endpoint-latitude shifts test drawing convention. These choices are not measured current boundaries, physical uncertainty or seasonal extrema.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      154,\r\n      -34\r\n    ],\r\n    [\r\n      158,\r\n      -34\r\n    ],\r\n    [\r\n      162,\r\n      -34\r\n    ],\r\n    [\r\n      166,\r\n      -34\r\n    ],\r\n    [\r\n      170,\r\n      -34\r\n    ],\r\n    [\r\n      172,\r\n      -34\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"southern_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          154,\r\n          -34\r\n        ],\r\n        [\r\n          158,\r\n          -34.5\r\n        ],\r\n        [\r\n          162,\r\n          -34.5\r\n        ],\r\n        [\r\n          166,\r\n          -34.5\r\n        ],\r\n        [\r\n          170,\r\n          -34.5\r\n        ],\r\n        [\r\n          172,\r\n          -34\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Alternative editorial shape between selected regional gates, not an observed axis or seasonal state.\"\r\n    },\r\n    {\r\n      \"id\": \"northern_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          154,\r\n          -34\r\n        ],\r\n        [\r\n          158,\r\n          -33.5\r\n        ],\r\n        [\r\n          162,\r\n          -33.5\r\n        ],\r\n        [\r\n          166,\r\n          -33.5\r\n        ],\r\n        [\r\n          170,\r\n          -33.5\r\n        ],\r\n        [\r\n          172,\r\n          -34\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Alternative editorial shape between selected regional gates, not an observed axis or seasonal state.\"\r\n    }\r\n  ],\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.5,\r\n    0,\r\n    0.5\r\n  ],\r\n  \"scenario_rule\": \"Three declared shapes crossed with three uniform longitude shifts and independent three-value endpoint latitude shifts: 81 retained editorial scenarios, not confidence limits or seasonal ranges.\",\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_studied_reach_routes\",\r\n  \"whole_system_length\": false,\r\n  \"remaining_gates\": [\r\n    \"Independently review identity, layer, selected gates and fine coastline/bathymetry before physical admission.\",\r\n    \"Acquire dated velocity or suitable physical geometry before measuring a current axis or meander length.\",\r\n    \"Whole-current length, physical width and annual ranges remain unresolved.\",\r\n    \"No seasonal playback, occupied polygon, physical state containment or NASA current identity inferred.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    1420,\r\n    540,\r\n    112,\r\n    75\r\n  ],\r\n  \"map_label_size\": 1.5,\r\n  \"legend_line_spacing\": 2.4000000000000004,\r\n  \"map_symbol_scale\": 0.3,\r\n  \"endpoint_labels\": [\r\n    \"[154, -34] OSW gate\",\r\n    \"[172, -34] OSW gate\"\r\n  ],\r\n  \"figure_source_label\": \"Tomczak and Godfrey, ch8 pp127-129\",\r\n  \"route_extent_kind\": \"historical Tasman reference connection\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"label\": \"Oke et al. (2019), A search for the Tasman Front, doi:10.1016/j.jmarsys.2019.103217\",\r\n      \"url\": \"https://researchportalplus.anu.edu.au/en/publications/a-search-for-the-tasman-front/\",\r\n      \"locator\": \"Author institutional abstract, retrieved 2026-10-13\",\r\n      \"access\": \"Abstract read; full 2019 article not acquired. Original temperature-data reinterpretation, reanalysis and drifters suggest discontinuous streams/eddy field; continuous zonal flow less common than conceptual models imply.\"\r\n    }\r\n  ],\r\n  \"source_review_receipt\": {\r\n    \"source_document_file\": \"research/source-data/tomczak-regional-2005/journal-article.pdf\",\r\n    \"source_document_sha256\": \"35e36f9b834c9c31c2cee64abc36d0c687d71e3d388c2cf1c40bc026e613738b\",\r\n    \"acquisition_file\": \"research/source-data/tomczak-regional-2005/acquisition.json\",\r\n    \"acquisition_sha256\": \"c5e0760c94b3ce30765f09f09eeb5943c6553db78bf210b5d0fc3dce7f353664\",\r\n    \"audit_file\": \"research/tasman-historical-connection-reach-scope-audit.json\",\r\n    \"audit_sha256\": \"b2031b345eaa864705ec98059f8691b4c23b9d26793e8e48c1e2ab5798070d6c\"\r\n  },\r\n  \"input_sha256\": \"bdc1d4d75a6e82adedd4ba8c62d7f45bec91bee1ff2e314800e9907a93d98330\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 1662.829,\r\n  \"reported_approximate_reference_path_km\": 1700,\r\n  \"scenario_range_km\": [\r\n    1653.021,\r\n    1716.296\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    1600,\r\n    1800\r\n  ],\r\n  \"scenario_count\": 81,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.25,\r\n      \"start_latitude_offset_degrees\": -0.5,\r\n      \"end_latitude_offset_degrees\": -0.5,\r\n      \"start_longitude_offset_degrees\": 0,\r\n      \"end_longitude_offset_degrees\": 0,\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          153.75,\r\n          -34.5\r\n  
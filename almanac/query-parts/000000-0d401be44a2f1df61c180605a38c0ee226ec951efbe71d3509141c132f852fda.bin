nds are editorial.\",\r\n  \"layer\": \"Altimetry-derived surface geostrophic context; no fixed-depth velocity core, parcel trajectory or depth-uniform axis inferred.\",\r\n  \"time_convention\": \"Editorial route guided by the 1993-2017 boreal-summer climatological context (July-August-September). Not a dated axis, monthly mean measured centerline or year-round route.\",\r\n  \"source_url\": \"https://os.copernicus.org/articles/19/251/2023/os-19-251-2023.html\",\r\n  \"source_locator\": \"Sections 2.1, 3 and 4.2 identify HS5 at 42 W and HS6 at 32 W; section 6 / Fig. 8 caption defines summer JAS. The explicit east-of-38-W branch joining description concerns fall, not a verified summer connection. All route latitudes and bends are editorial.\",\r\n  \"source_citation\": \"Dimoune et al. (2023), Revisiting the tropical Atlantic western boundary circulation from a 25-year time series of satellite altimetry data, Ocean Science 19, 251-268, doi:10.5194/os-19-251-2023.\",\r\n  \"source_license\": \"Open-access source, CC BY 4.0; facts paraphrased with attribution. No source images or velocity arrays packaged.\",\r\n  \"source_retrieved_date\": \"2026-10-03\",\r\n  \"coordinate_selection\": \"Source section longitudes bound the reach. OSW selects nominal gates 42 W 6 N and 32 W 6.5 N and intermediate 38 W 6.2 N, 35 W 6.4 N. No figure digitization or field-derived axis; branch correspondence and interpolation require review.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -42,\r\n      6\r\n    ],\r\n    [\r\n      -38,\r\n      6.2\r\n    ],\r\n    [\r\n      -35,\r\n      6.4\r\n    ],\r\n    [\r\n      -32,\r\n      6.5\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"equatorward_editorial_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -42,\r\n          6\r\n        ],\r\n        [\r\n          -38,\r\n          5.7\r\n        ],\r\n        [\r\n          -35,\r\n          5.9\r\n        ],\r\n        [\r\n          -32,\r\n          6.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Editorial bend sensitivity, not season or edge.\"\r\n    },\r\n    {\r\n      \"id\": \"poleward_editorial_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -42,\r\n          6\r\n        ],\r\n        [\r\n          -38,\r\n          6.7\r\n        ],\r\n        [\r\n          -35,\r\n          6.9\r\n        ],\r\n        [\r\n          -32,\r\n          6.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Editorial bend sensitivity, not northern-branch geometry.\"\r\n    }\r\n  ],\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"scenario_rule\": \"Three declared shapes crossed with uniform longitude offsets -0.25/0/+0.25 and independent endpoint-latitude offsets -0.25/0/+0.25 degrees: 81 editorial cases, not width bounds, seasonal extrema or confidence intervals.\",\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_studied_reach_routes\",\r\n  \"whole_system_length\": false,\r\n  \"remaining_gates\": [\r\n    \"Review chosen latitude gates and interpolation against compatible summer velocity fields.\",\r\n    \"Resolve branch correspondence in summer; source fall merging cannot be transferred to summer. Do not aggregate northern branches.\",\r\n    \"Obtain month-specific axes and matched width boundaries before annual ranges.\",\r\n    \"Extend west/east endpoints separately; this studied reach remains outside comparable whole-length rankings.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    595,\r\n    382,\r\n    150,\r\n    110\r\n  ],\r\n  \"map_label_size\": 2.8,\r\n  \"legend_line_spacing\": 4.3,\r\n  \"map_symbol_scale\": 0.7,\r\n  \"endpoint_labels\": [\r\n    \"42 W\",\r\n    \"32 W\"\r\n  ],\r\n  \"figure_source_label\": \"Dimoune et al. (2023)\",\r\n  \"route_extent_kind\": \"42 W to 32 W western summer study reach\",\r\n  \"supporting_sources\": [],\r\n  \"context_landmarks\": [],\r\n  \"source_season_convention\": {\r\n    \"label_basis\": \"boreal\",\r\n    \"role\": \"source_observation_labels_only\",\r\n    \"months_by_label\": {\r\n      \"summer\": [\r\n        7,\r\n        8,\r\n        9\r\n      ]\r\n    },\r\n    \"source_locator\": \"Fig. 8 caption: source defines boreal summer as JAS (July-August-September).\",\r\n    \"supports_annual_route_geometry\": false\r\n  },\r\n  \"input_sha256\": \"de3c5b6a426e308970466bd1136a599c12bb70d04491cfcbda7e0c54bfa981ce\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 1108.057,\r\n  \"reported_approximate_reference_path_km\": 1100,\r\n  \"scenario_range_km\": [\r\n    1107.436,\r\n    1126.793\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    1100,\r\n    1200\r\n  ],\r\n  \"scenario_count\": 81,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.25,\r\n      \"start_latitude_offset_degrees\": -0.25,\r\n      \"end_latitude_offset_degrees\": -0.25,\r\n      \"start_longitude_offset_degrees\": 0,\r\n      \"end_longitude_offset_degrees\": 0,\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -42.25,\r\n          5.75\r\n        ],\r\n        [\r\n          -38.25,\r\n          6.2\r\n        ],\r\n        [\r\n          -35.25,\r\n          6.4\r\n        ],\r\n        [\r\n          -32.25,\r\n          6.25\r\n        ]\r\n      ],\r\n      \"length_km\": 1110.703,\r\n      \"atlas_state_crossings\": [\r\n        \"WTRA\"\r\n      ]\r\n    },\r\n    {\r\n      \"rou
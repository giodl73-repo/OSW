  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"agulhas-return\",\r\n  \"name\": \"Agulhas Return Current\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Studied 21–60 degrees E reach only; excludes the western genesis and downstream termination. Not a whole-current length.\",\r\n  \"layer\": \"Hydrographic frontal/jet geography; study geostrophic velocities referenced to 1500 m. No velocity axis extracted here.\",\r\n  \"time_convention\": \"Source combines cruises over roughly twenty years, mostly austral summer; CTD data 1983–1991. The sketch is not a simultaneous or climatological observed centerline.\",\r\n  \"source_url\": \"https://www.cfoo.co.za/seaatlas/papers/agulhas_return_current.pdf\",\r\n  \"source_locator\": \"Section 3 (geographic location and hydrographic sections); source-described peak near 21 degrees E and downstream mean 44 degrees 30 minutes S at 60 degrees E. OSW intermediate vertices retained from the existing editorial atlas sketch.\",\r\n  \"source_citation\": \"Lutjeharms, J.R.E., and Ansorge, I.J. (2001), The Agulhas Return Current, Journal of Marine Systems 30, 115–138.\",\r\n  \"source_license\": \"Copyright Elsevier 2001; factual geographic reference only; no paper figure or source geometry packaged.\",\r\n  \"coordinate_selection\": \"OSW reference sketch constrained by the paper’s broad regional descriptions. Intermediate vertices are OSW-selected approximations, not published coordinates, a digitized source curve or observed streamline.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      21,\r\n      -40.5\r\n    ],\r\n    [\r\n      25,\r\n      -39.5\r\n    ],\r\n    [\r\n      40,\r\n      -41\r\n    ],\r\n    [\r\n      60,\r\n      -44.5\r\n    ]\r\n  ],\r\n  \"scenario_rule\": \"Three uniform longitude offsets (-0.5, 0, +0.5 degrees) crossed with independent endpoint latitude offsets (-0.5, 0, +0.5 degrees): 27 editorial scenarios, not source-reported positional errors.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.5,\r\n    0,\r\n    0.5\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.5,\r\n    0,\r\n    0.5\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_studied_reach_routes\",\r\n  \"remaining_gates\": [\r\n    \"Independent review of the source-defined western origin, eastern termination and source-specific flow identity.\",\r\n    \"Validate the editorial meander and regional waypoints against reproducible geographic or model geometry.\",\r\n    \"Canonical claim/measurement/geometry and atlas interface integration; retain source-specific scope.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    855,\r\n    550,\r\n    300,\r\n    130\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"21°E study gate\",\r\n    \"60°E study gate\"\r\n  ],\r\n  \"figure_source_label\": \"Lutjeharms & Ansorge (2001), pp. 125, 136\",\r\n  \"route_extent_kind\": \"studied-reach reference route\",\r\n  \"whole_system_length\": false,\r\n  \"source_pdf_sha256\": \"9cc3b4ab639f90cf81f95dc3e5bbd1826c2326ba3db36cc7d1e60f5b277a0402\",\r\n  \"source_pdf_bytes\": 718135,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"input_sha256\": \"2f52365e043d8936aae2a19dde5ecfdc862a6c6072e5bc2446c21d1f10df15f5\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 3322.857,\r\n  \"reported_approximate_reference_path_km\": 3300,\r\n  \"scenario_range_km\": [\r\n    3305.682,\r\n    3349.647\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n
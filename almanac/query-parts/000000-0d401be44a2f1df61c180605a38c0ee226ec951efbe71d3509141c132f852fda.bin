ean2_EQUIREC_071_final_beauty_level0_B_1.mp4\",\r\n      \"source_id\": \"source:d4e82da0872ed45c\",\r\n      \"zoom\": 0,\r\n      \"nominal_display_route_fraction\": 1.0,\r\n      \"scenario_display_route_fraction_range\": [\r\n        1.0,\r\n        1.0\r\n      ],\r\n      \"complete_display_route_in_all_scenarios\": true,\r\n      \"interpretation\": \"Editorial reference-route/crop display overlap only; not physical current identification or dated event matching. Fraction measures equirectangular display line, not physical kilometres.\"\r\n    }\r\n  ],\r\n  \"nasa_tiles_sha256\": \"52c6605c32e59f50aa4abde984489c7055c0e3e201e7323e30160a623c9666e0\",\r\n  \"recommended_nasa_tile_id\": \"level2_C_2\",\r\n  \"nasa_crop_recommendation_rule\": \"Highest zoom crop covering the entire display route in every retained scenario, with tile ID as deterministic tie-break. No physical identification asserted.\",\r\n  \"input_file\": \"research/western-adriatic-reference-path-input.json\",\r\n  \"figure\": \"figures/western-adriatic-reference-path-candidate.svg\"\r\n}\r\n"},"research/new-guinea-coastal-undercurrent-reference-path-candidate.json":{"source_sha256":"3b1ab727292638925f04f615b6a4e82abfb7087c72185a959db297dfc76a0f3b","source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"new-guinea-coastal-undercurrent\",\r\n  \"name\": \"New Guinea Coastal Undercurrent\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Declared north-Papua New Guinea regional reach from an OSW offshore Vitiaz-downstream approach gate near 147 E, 4.5 S to the 142 E, 2.5 S mooring neighborhood. Excludes passage through Vitiaz Strait itself, upstream Solomon Sea coastal branches, New Britain and St Georges branches, and the cross-equatorial EUC connection. Gates do not establish whole-current origin or termination.\",\r\n  \"layer\": \"Subsurface thermocline flow. Ueki et al. report a local northwestward core generally at 150–250 m near the moorings; the core shoals during El Nino. This local depth support is not a fixed-depth axis assigned along the entire editorial reach. Surface New Guinea Coastal Current remains a separate identity.\",\r\n  \"time_convention\": \"Editorial regional geographic reach informed by Ueki et al. mooring observations during 1995–2000 and Grenier et al. background/model pathways. The source reports seasonal and ENSO variations locally; this static route is not a dated observation, annual axis or observed seasonal length/width footprint. Source seasons use boreal labels: winter January–March, summer July–September, fall October–December. Unlisted months are not inferred flow absence.\",\r\n  \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2002JC001611\",\r\n  \"source_locator\": \"Ueki et al. (2003), Introduction [2]–[7]: separate surface and thermocline flows, northern PNG coast and gateway relations; Data [8]: 142 E moorings; Results 3.1 [17]–[18]: local 150–250 m core and El Nino shoaling. Relevant text inspected; no current axis digitized.\",\r\n  \"source_citation\": \"Ueki, Kashino and Kuroda (2003), Observation of current variations off the New Guinea coast including the 1997–1998 El Nino period and their relationship with Sverdrup transport, Journal of Geophysical Research: Oceans, doi:10.1029/2002JC001611.\",\r\n  \"source_license\": \"Publisher full text accessible; no explicit open reuse license inspected. Attributed regional facts paraphrased; source current profiles, figures and ADCP fields are not copied.\",\r\n  \"source_retrieved_date\": \"2026-10-03\",\r\n  \"coordinate_selection\": \"OSW selects coarse offshore vertices along northern Papua New Guinea between a declared downstream approach to the Vitiaz outflow and the source mooring neighborhood at 142 E, 2.5 S. Mooring coordinate is a local observational location, not current termination. Intermediate vertices are not source-provided measurements or a digitized bathymetric axis. Strait passages and branch junctions are not traced.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      147,\r\n      -4.5\r\n    ],\r\n    [\r\n      146,\r\n      -4.1\r\n    ],\r\n    [\r\n      145,\r\n      -3.5\r\n    ],\r\n    [\r\n      143.7,\r\n      -3.1\r\n    ],\r\n    [\r\n      142,\r\n      -2.5\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"closer_coastal_sequence\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          147,\r\n          -4.6\r\n        ],\r\n        [\r\n          146,\r\n          -4.199999999999999\r\n        ],\r\n        [\r\n          145,\r\n          -3.6\r\n        ],\r\n        [\r\n          143.7,\r\n          -3.2\r\n        ],\r\n        [\r\n          142,\r\n          -2.6\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW coarse lateral alternative; not an observed seasonal path, current edge or width.\"\r\n    },\r\n    {\r\n      \"id\": \"farther_offshore_sequence\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          147,\r\n          -4.4\r\n        ],\r\n        [\r\n          146,\r\n          -3.9999999999999996\r\n        ],\r\n        [\r\n          145,\r\n          -3.4\r\n        ],\r\n        [\r\n          143.7,\r\n          -3.0\r\n        ],\r\n        [\r\n          142,\r\n          -2.4\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW coarse lateral alternative; not an observed seasonal path, current edge or width.\"\r\n    }\r\n  ],\r\n  \"longitude_offsets_degrees\": [\r\n    -0.05,\r\n    0,\r\n    0.05\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.05,\r\n    0,\r\n    0.05\r\n  ],\r\n  \"scenario_rule\": \"Three declared regional shapes crossed with uniform longitude shifts -0.05/0/+0.05 degrees and independent endpoint latitude shifts -0.05/0/+0.05 degrees: 81 editorial scenarios. Not current width, seasonal extent or a confidence interval.\",\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_studied_reach_routes\",\r\n  \"whole_system_length\": false,\r\n  \"remaining_gates\": [\r\n    \"Review finer coastline and bathymetry before claiming a subsurface coastal axis.\",\r\n    \"Resolve upstream branch convention, gateway passages and downstream equatorial connection separately.\",\r\n    \"Local 150–250 m core cannot establish a uniform fixed-depth path, and surface monsoon reversal cannot be transferred to the undercurrent.\",\r\n    \"Obtain comparable dated geometry or cross-flow sections before annual length/width margins.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    1360,\r\n    448,\r\n    60,\r\n    50\r\n  ],\r\n  \"map_label_size\": 0.9,\r\n  \"legend_line_spacing\": 1.5,\r\n  \"map_symbol_scale\": 0.3,\r\n  \"endpoint_labels\": [\r\n    \"Vitiaz-downstream approach\",\r\n    \"142 E mooring neighborhood\"\r\n  ],\r\n  \"figure_source_label\": \"Ueki et al. (2003), intro / sec. 2–3\",\r\n  \"route_extent_kind\": \"northern PNG subsurface regional reach\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2011JC007477\",\r\n      \"citation\": \"Grenier et al. (2011), From the western boundary currents to the Pacific Equatorial Undercurrent: Modeled pathways and water mass evolutions.\",\r\n      \"locator\": \"Introduction [5] and model validation [15].\",\r\n      \"role\": \"Northwestward NGCU along PNG and Vitiaz connection; modeled core near 142 E poorly resolved. Does not provide editorial coordinates or observed seasonal footprint.\"\r\n    }\r\n  ],\r\n  \"source_season_convention\": {\r\n    \"label_basis\": \"boreal\",\r\n    \"role\": \"source_observation_labels_only\",\r\n    \"months_by_label\": {\r\n      \"winter\": [\r\n        1,\r\n        2,\r\n        3\r\n      ],\r\n      \"summer\": [\r\n        7,\r\n        8,\r\n        9\r\n      ],\r\n      \"fall\": [\r\n        10,\r\n        11,\r\n        12\r\n      ]\r\n    },\r\n    \"source_locator\": \"Ueki et al. (2003), Data [10], Table 1 footnote: source defines Northern Hemisphere season labels and month windows.\",\r\n    \"supports_annual_route_geometry\": false\r\n  },\r\n  \"input_sha256\": \"56df70794a8941a39973c4a4627baa8a18eb91e2c3029d00eb03c9da5493fca8\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 600.298,\r\n  \"reported_approximate_reference_path_km\": 600,\r\n  \"scenario_range_km\": [\r\n    596.546,\r\n    604.403\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    500,\r\n    700\r\n  ],\r\n  \"scenario_count\": 81,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.05,\r\n      \"start_latitude_offset_degrees\": -0.05,\r\n      \"end_latitude_offset_degrees\": -0.05,\r\n      \"start_longitude_offset_degrees\": 0,\r\n      \"end_longitude_offset_degrees\": 0,\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          146.95,\r\n          -4.55\r\n        ],\r\n        [\r\n          145.95,\r\n          -4.1\r\n        ],\r\n        [\r\n          144.95,\r\n          -3.5\r\n        ],\r\n        [\r\n          143.64999999999998,\r\n          -3.1\r\n        ],\r\n        [\r\n          141.95,\r\n          -2.55\r\n        ]\r\n      ],\r\n      \"length_km\": 600.683,\r\n      \"atlas_state_crossings\": [\r\n        \"ARCH\"\r\n      ]\r\n    },\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.05,\r\n      \"start_latitude_o
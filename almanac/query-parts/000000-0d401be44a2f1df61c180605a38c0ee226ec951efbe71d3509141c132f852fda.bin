     \"current_id\": \"somali\",\r\n      \"phase_label\": \"Northeast winter monsoon\",\r\n      \"flow_direction\": \"southward\",\r\n      \"calendar_months\": null,\r\n      \"time_convention\": \"Northeast winter monsoon convention; not a simultaneous dated observation or an annual-average route.\",\r\n      \"layer\": \"Surface/upper-layer seasonal coastal reference geography; the source describes a shallow winter equatorial current, but no fixed-depth velocity axis is reconstructed.\",\r\n      \"route_candidate_file\": \"research/somali-winter-reference-path-candidate.json\",\r\n      \"route_candidate_sha256\": \"37cf752d61cfcfff451e3066e842e00f524b78400573b28ff731cf3ff12f4cda\",\r\n      \"geometry_role\": \"osw_editorial_reference_route\",\r\n      \"width_measurement_ids\": [],\r\n      \"source_url\": \"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf\",\r\n      \"source_locator\": \"Section 4.2.1, printed pages 48-49 (PDF indices 47-48): southward surface flow reaches EACC confluence at 2-4 S; winter coastal divergence near 6-8 N. Section 4.2.2 distinguishes modeled coastal continuation and northern countercurrent.\"\r\n    },\r\n    {\r\n      \"id\": \"somali-summer-southern\",\r\n      \"current_id\": \"somali\",\r\n      \"phase_label\": \"June-July southern limb\",\r\n      \"flow_direction\": \"northward\",\r\n      \"calendar_months\": [\r\n        6,\r\n        7\r\n      ],\r\n      \"time_convention\": \"June-July monsoon-onset two-gyre convention. Does not assume rare late-summer gyre coalescence or persistent whole-coast continuity.\",\r\n      \"layer\": \"Upper-layer southern seasonal coastal geography; no fixed-depth or velocity-derived axis.\",\r\n      \"route_candidate_file\": \"research/somali-summer-southern-reference-path-candidate.json\",\r\n      \"route_candidate_sha256\": \"73efa37ee93f5a6985c891bb524fc2ec0d443d17807de420fc7a03a44ab5b295\",\r\n      \"geometry_role\": \"osw_editorial_reference_route\",\r\n      \"width_measurement_ids\": [],\r\n      \"source_url\": \"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf\",\r\n      \"source_locator\": \"Section 4.1.1, printed page 38 (PDF index 37): June-July cross-equatorial limb departs the coast south of 4 N, partitions into offshore outflow/recirculation and has little exchange with Great Whirl. Printed pages 41-43 discuss non-universal gyre coalescence.\"\r\n    },\r\n    {\r\n      \"id\": \"davidson-historical-winter\",\r\n      \"current_id\": \"davidson\",\r\n      \"phase_label\": \"October-March (1978 regional summary)\",\r\n      \"flow_direction\": \"northward\",\r\n      \"calendar_months\": [\r\n        10,\r\n        11,\r\n        12,\r\n        1,\r\n        2,\r\n        3\r\n      ],\r\n      \"route_candidate_file\": \"research/davidson-winter-reference-path-candidate.json\",\r\n      \"route_candidate_sha256\": \"ac2db281859e27e8903fb224f3fdde35b36f010ab111240e2a2c78e3c5a26609\",\r\n      \"geometry_role\": \"osw_editorial_reference_route\",\r\n      \"width_measurement_ids\": [\r\n        \"davidson-historical-winter-width\"\r\n      ],\r\n      \"width_support_role\": \"regional_source_context_not_uniform_route_width\",\r\n      \"width_scope_note\": \"Approximate 64 km is historical California-Oregon regional context; it is not applied uniformly to the editorial route or used as an occupied footprint.\",\r\n      \"time_convention\": \"October-March California-Oregon regional seasonal description in the February 1978 report; strongest flow described in January. Historical summary, not a dated trajectory, current-year observation or modern monthly climatology.\",\r\n      \"layer\": \"Seasonal northward surface-current regional context; not the separately described California Undercurrent below 200 m or a reconstructed velocity axis.\",\r\n      \"source_url\": \"https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/40591190_v2.pdf\",\r\n      \"source_locator\": \"Appendix II section II.1, printed II-1 to II-2 / PDF pages 12-13: northward seasonal surface strip along California and Oregon from October to March; Vancouver Island penetration is conditional.\"\r\n    },\r\n    {\r\n      \"id\": \"monsoon-summer-sri-lanka\",\r\n      \"current_id\": \"monsoon\",\r\n      \"phase_label\": \"Southwest Monsoon Current · June–September eastward regional reach\",\r\n      \"flow_direction\": \"eastward\",\r\n      \"calendar_months\": [\r\n        6,\r\n        7,\r\n        8,\r\n        9\r\n      ],\r\n      \"source_season_label\": \"summer\",\r\n      \"route_candidate_file\": \"research/monsoon-summer-sri-lanka-reference-path-candidate.json\",\r\n      \"route_candidate_sha256\": \"1074de5de5d68f6ca753a8eafdb2fea5eaecd20204f008c6df156e3c21940f92\",\r\n      \"geometry_role\": \"osw_editorial_reference_route\",\r\n      \"width_measurement_ids\": [],\r\n      \"time_convention\": \"Boreal summer source convention, June–September. Historical review and section context, not a simultaneous dated trajectory or current-year climatology.\",\r\n      \"layer\": \"Seasonal near-surface regional geography. Historical section evidence is shallow and depth dependent; no fixed-depth velocity axis reconstructed and undercurrents excluded.\",\r\n      \"source_url\": \"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf\",\r\n      \"source_locator\": \"Schott and McCreary (2001), section 5.1.5, printed pp. 63–65 / PDF indices 62–64: seasonal directions/months, Sri Lanka bottleneck and separate upper-layer/undercurrent flows. August 1993 and January 1991 sections provide local latitude context, not regional axis vertices.\"\r\n    },\r\n    {\r\n      \"id\": \"monsoon-winter-sri-lanka\",\r\n      \"current_id\": \"monsoon\",\r\n      \"phase_label\": \"Northeast Monsoon Current · November–February westward regional reach\",\r\n      \"flow_direction\": \"westward\",\r\n      \"calendar_months\": [\r\n        11,\r\n        12,\r\n        1,\r\n        2\r\n      ],\r\n      \"source_season_label\": \"winter\",\r\n      \"route_candidate_file\": \"research/monsoon-winter-sri-lanka-reference-path-candidate.json\",\r\n      \"route_candidate_sha256\": \"050f03273c082601dd425ad8221c6f038bcc152c4f2978e58dde9af6e60f4334\",\r\n      \"geometry_role\": \"osw_editorial_reference_route\",\r\n      \"width_measurement_ids\": [],\r\n      \"time_convention\": \"Boreal winter source convention, November–February. Historical review and section context, not a simultaneous dated trajectory or current-year climatology.\",\r\n      \"layer\": \"Seasonal near-surface regional geography. Historical section evidence is shallow and depth dependent; no fixed-depth velocity axis reconstructed and undercurrents excluded.\",\r\n      \"source_url\": \"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf\",\r\n      \"source_locator\": \"Schott and McCreary (2001), section 5.1.5, printed pp. 63–65 / PDF indices 62–64: seasonal directions/months, Sri Lanka bottleneck and separate upper-layer/undercurrent flows. August 1993 and January 1991 sections provide local latitude context, not regional axis vertices.\"\r\n    },\r\n    {\r\n      \"id\": \"indian-secc-winter-reach\",\r\n      \"current_id\": \"indian-south-equatorial-countercurrent\",\r\n      \"phase_label\": \"December-March eastward surface reach\",\r\n      \"flow_direction\": \"eastward\",\r\n      \"calendar_months\": [\r\n        12,\r\n        1,\r\n        2,\r\n        3\r\n      ],\r\n      \"source_season_label\": \"winter\",\r\n      \"route_candidate_file\": \"research/indian-secc-winter-reach-reference-path-candidate.json\",\r\n      \"route_candidate_sha256\": \"f4012b04e98fbddadd0d2af6636d18d04b5f89f84bbdd07cd069abdec6875ab7\",\r\n      \"geometry_role\": \"osw_editorial_reference_route\",\r\n      \"width_measurement_ids\": [],\r\n      \"time_convention\": \"Source boreal winter December-March convention; Gauss-Markov seasonal climatology using 1993-2018 drifter context. Not a dated trajectory or complete annual route series.\",\r\n      \"layer\": \"Surface drifter climatology with GDP drogue support near 15 m and wind-slip-corrected undrogued observations; not a uniform fixed-depth current axis or full vertical extent. OSCAR upper-layer and deeper current diagnostics remain separate.\",\r\n      \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2019JC015483\",\r\n      \"source_locator\": \"Sections 2.1-2.2: drifter support, 1993-2018 selection, fitted seasonal fields and December-March winter. Section 3 seasonal discussion after Figures 5-6: eastward SECC reaches about 90 E before recirculating into SEC; Figure 13 caption.\"\r\n    }\r\n  ],\r\n  \"comparability\": [\r\n    {\r\n      \"current_id\": \"somali\",\r\n      \"annual_length_range_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"annual_extrema_eligible\": false,\r\n      \"reason\": \"Winter coastal branch and June-July southern limb have different source-defined spatial scopes; their nominal lengths or scenario bounds do not define annual whole-current extrema.\"\r\n    },\r\n    {\r\n      \"current_id\": \"davidson\",\r\n      \"annual_length_range_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"annual_extrema_eligible\": false,\r\n      \"reason\": \"Only historical October-March California-Oregon reference geography and width context are available. April-September width and seasonal route geometry remain unknown; no modern annual cycle, seasonal extrema or uniform width footprint established.\"\r\n    },\r\n    {\r\n      \"current_id\": \"monsoon\",\r\n      \"annual_length_range_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"annual_extrema_eligible\": false,\r\n      \"reason\": \"Two source-defined seasonal phases with editorial 77–83 E regional drawings. Their different latitude choices and scenario envelopes are not observed annual length minima/maxima. March–May and October geometry and all seasonal widths remain unresolved; month labels do not provide monthly velocity fields.\"\r\n    },\r\n    {\r\n      \"current_id\": \"indian-south-equatorial-countercurrent\",\r\n      \"annual_length_range_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"annual_extrema_eligible\": false,\r\n      \"reason\": \"One December-March surface studied reach with editorial gates and vertices. Other seasonal axes and paired-edge widths are unavailable. Its 4400-4500 km drawing envelope is not annual length variation.\"\r\n    }\r\n  ],\r\n  \"width_inventory_file\": \"research/ocean-current-width-inventory.json\",\r\n  \"width_inventory_sha256\": \"929527ad7c4a500eca26d495c59e6eadd3d62e82b3bc9b9cd1ff57084b1aacb8\"\r\n}\r\n"},"directions":{"source_file":"research/new-guinea-coastal-current-seasonal-direction-scope-audit.json","source_sha256":"8b5fc2d62a5a7c777b69106aa7875260d52bbdff9a2059fbe06d6a1d364652fc","source_json":"{\r\n  \"schema\": \"osw.current-seasonal-direction-scope-audit.v1\",\r\n  \"current_id\": \"new-guinea-coastal-current\",\r\n  \"as_of\": \"2026-10-03\",\r\n  \"status\": \"editorial_source_summary_not_canonical\",\r\n  \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2020JC016242\",\r\n  \"source_citation\": \"Zhang et al. (2020), Seasonal and Interannual Variability of the Currents off the New Guinea Coast From Mooring Measurements, doi:10.1029/2020JC016242.\",\r\n  \"source_access\": \"Publisher abstract, Introduction, Data and Method, sections 3.1–3.3 and figure captions read. No figure, velocity field or axis digitized.\",\r\n  \"observed_period\": {\r\n    \"start\": \"2015-11\",\r\n    \"end\": \"2018-12\"\r\n  },\r\n  \"time_precision\": \"month\",\r\n  \"scope\": \"Local alongshore direction at the 141.4 E, 1.7 S mooring; monthly composite of three cycles, with interannual contamination and instrument gaps. Not a whole-current monthly path.\",\r\n  \"sampling_note\": \"Data above 30 m removed; upper-400 m instrument outage July 2016–March 2017. Monthly averages; three cycles provide limited independence.\",\r\n  \"interpretation\": \"November–April southeastward and May–October northwestward describe the short-record composite. In the 2015/2016 El Niño interval the eastward NGCC disappears as NGCUC shoals. Exception is selectable separately and excluded from seasonal playback.\",\r\n  \"whole_current_length_km\": null,\r\n  \"whole_current_width_km\": null,\r\n  \"annual_length_range_km\": null,\r\n  \"annual_width_range_km\": null,\r\n  \"route_construction_status\": \"not_constructed\",\r\n  \"phases\": [\r\n    {\r\n      \"current_id\": \"new-guinea-coastal-current\",\r\n      \"geometry_role\": \"local_direction_symbol_not_current_axis\",\r\n      \"site_lon_lat\": [\r\n        141.4,\r\n        -1.7\r\n      ],\r\n      \"layer\": \"Upper-100 m NGCC context; ADCP measurements above 30 m excluded. No uniform layer assigned along a route.\",\r\n      \"length_km\": null,\r\n      \"width_km\": null,\r\n      \"route_coordinates\": null,\r\n      \"annual_length_range_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2020JC016242\",\r\n      \"id\": \"ngcc-november-april\",\r\n      \"phase_label\": \"November–April · three-cycle composite\",\r\n      \"flow_direction\": \"southeastward\",\r\n      \"calendar_months\": [\r\n        11,\r\n        12,\r\n        1,\r\n        2,\r\n        3,\r\n        4\r\n      ],\r\n      \"phase_kind\": \"seasonal_direction_composite\",\r\n      \"playback_eligible\": true,\r\n      \"observed_period\": {\r\n        \"start\": \"2015-11\",\r\n        \"end\": \"2018-12\"\r\n      },\r\n      \"source_locator\": \"Section 3.2 / Figure 4 caption\"\r\n    },\r\n    {\r\n      \"current_id\": \"new-guinea-coastal-current\",\r\n      \"geometry_role\": \"local_direction_symbol_not_current_axis\",\r\n      \"site_lon_lat\": [\r\n        141.4,\r\n        -1.7\r\n      ],\r\n      \"layer\": \"Upper-100 m NGCC context; ADCP measurements above 30 m excluded. No uniform layer assigned along a route.\",\r\n      \"length_km\": null,\r\n      \"width_km\": null,\r\n      \"route_coordinates\": null,\r\n      \"annual_length_range_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2020JC016242\",\r\n      \"id\": \"ngcc-may-october\",\r\n      \"phase_label\": \"May–October · three-cycle composite\",\r\n      \"flow_direction\": \"northwestward\",\r\n      \"calendar_months\": [\r\n        5,\r\n        6,\r\n        7,\r\n        8,\r\n        9,\r\n        10\r\n      ],\r\n      \"phase_kind\": \"seasonal_direction_composite\",\r\n      \"playback_eligible\": true,\r\n      \"observed_period\": {\r\n        \"start\": \"2015-11\",\r\n        \"end\": \"2018-12\"\r\n      },\r\n      \"source_locator\": \"Section 3.2 / Figure 4 caption\"\r\n    },\r\n    {\r\n      \"current_id\": \"new-guinea-coastal-current\",\r\n      \"geometry_role\": \"local_direction_symbol_not_current_axis\",\r\n      \"site_lon_lat\": [\r\n        141.4,\r\n        -1.7\r\n      ],\r\n      \"layer\": \"Upper-100 m NGCC context; ADCP measurements above 30 m excluded. No uniform layer assigned along a route.\",\r\n      \"length_km\": null,\r\n      \"width_km\": null,\r\n      \"route_coordinates\": null,\r\n      \"annual_length_range_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2020JC016242\",\r\n      \"id\": \"ngcc-el-nino-2015-2016\",\r\n      \"phase_label\": \"2015/2016 El Niño exception\",\r\n      \"flow_direction\": \"southeastward NGCC absent; northwestward undercurrent shoals\",\r\n      \"calendar_months\": null,\r\n      \"phase_kind\": \"event_exception\",\r\n      \"playback_eligible\": false,\r\n      \"observed_period\": {\r\n        \"start\": \"2015-11\",\r\n        \"end\": \"2016-06\"\r\n      },\r\n      \"source_locator\": \"Section 3.3 / Figure 9 caption\"\r\n    }\r\n  ],\r\n  \"remaining_gates\": [\r\n    \"Recover cross-flow boundaries and alongshore axes before seasonal dimensions.\",\r\n    \"Resolve calendar dependence across ENSO states and a longer record.\",\r\n    \"Keep NGCC, NGCUC and newly named intermediate flow distinct.\"\r\n  ]\r\n}\r\n"}},"dashboard_receipt":{"source_file":"research/ocean-motion-dashboard.json","source_sha256":"68a186adbc79ee6f157b00ff0b09c4b387e983c43b606d7499e63827df54fa36","source_json":"{\r\n  \"schema\": \"osw.motion-dashboard.v1\",\r\n  \"status\": \"local_research_coverage_not_scientific_approval\",\r\n  \"counts\": {\r\n    \"named_current\": 101,\r\n    \"named_eddy\": 136,\r\n    \"operational_eddy_detection\": 4\r\n  },\r\n  \"proposed_current_additions\": 28,\r\n  \"input_sha256\": {\r\n    \"figures/osw-province-atlas-interactive.svg\": \"5999bbad0e49209b2609a20a52a3e6310aa749224b574cb2f6cbcac0e68db032\",\r\n    \"almanac/release/v0.1.0/entities.json\": \"aa2e66c1c344b67ba53c6b5735740de9c1e9888587f72a95842a3a53487f9d59\",\r\n    \"almanac/release/v0.1.0/measurements.json\": \"7d4c38d0413280b19edf0e108b7917c38f0277a7401c160c9f729abc86baec12\",\r\n    \"almanac/release/v0.1.0/geometries.json\": \"e8e8837af6f050efbf4ba6bf761315927301163df3da162aa8f21c2dfa86adcf\",\r\n    \"almanac/release/v0.1.0/claims.json\": \"c687eb920a612eaa403bc46e095f0b0829498487bef5a0ba88771c376e1fd7da\",\r\n    \"almanac/release/v0.1.0/media.json\": \"5b3ae2e0aea28056027854f439e0a3444c5ade5c6a2708e74776c3f718596397\",\r\n    \"almanac/release/v0.1.0/sources.json\": \"f4ea71b324f4fa9aa1cba56f2eb47ff40c63543ec5260346303908c494bfc841\",\r\n    \"plans/current-identity-admission-protocol-v1.md\": \"259a30f54e4e975ad9d7f85794e14a3d46e70eb6b9060c18093ae72670f6f25a\",\r\n    \"research/ocean-current-inventory-expansion-candidates.json\": \"0d0c4b707c70a50494151ca6c2d672eec7711bf7e
r\n              [\r\n                -125,\r\n                8\r\n              ],\r\n              [\r\n                -117.5,\r\n                7\r\n              ],\r\n              [\r\n                -110,\r\n                6\r\n              ],\r\n              [\r\n                -102.5,\r\n                6.5\r\n              ],\r\n              [\r\n                -95,\r\n                7\r\n              ]\r\n            ]\r\n          },\r\n          \"role\": \"editorial_reference_route\",\r\n          \"note\": \"Declared east-central Pacific study reach from 140 W to 95 W. Gates truncate a larger current; western Pacific inflow and coastal redistribution east of 95 W are excluded. Intermediate bends are editorial connections among section descriptions, not a reconstructed continuous axis or parcel trajectory.\"\r\n        }\r\n      ],\r\n      \"state_evidence\": [],\r\n      \"connections\": [],\r\n      \"scope_notes\": [\r\n        {\r\n          \"current_id\": \"pacific-north-equatorial-countercurrent\",\r\n          \"label\": \"Mean section connection versus seasonal surface expression\",\r\n          \"audit_file\": \"research/pacific-necc-reach-seasonal-section-scope-audit.json\",\r\n          \"summary\": \"140 W to 95 W is an editorial studied reach, not a whole-current axis. Near 110 W the source surface expression is absent in December-February and peaks in August; this does not establish absence at all depths. Source ensemble dates do not date this route; width and annual ranges remain unresolved.\",\r\n          \"source_url\": \"https://www.pmel.noaa.gov/pubs/outstand/john2337/zonal_velocity.shtml\",\r\n          \"source_locator\": \"Section 3.1: 140 W near-surface core around 7 N, 125 W around 8 N, southward shift at 110 W and northward rebuilding at 95 W; section 3.2.3 separates seasonal surface expression near 110 W.\",\r\n          \"observed_period\": null\r\n        }\r\n      ],\r\n      \"evidence_links\": [\r\n      
ska-reference-path-candidate.json":{"source_sha256":"2424028bad238cb7b940726818ab93ce6509f01de4f52013d837099329f426da","source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"alaska\",\r\n  \"name\": \"Alaska Current\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Regional northward Alaska Current branch offshore British Columbia and southeast Alaska, using OSW latitude gates at 48 and 58.5 degrees N. Excludes the northern/northwestern Alaskan Stream, the distinct nearshore Alaska Coastal Current, individual fjords and offshore eddy excursions. Gate alternatives vary the regional reach; not the entire counterclockwise Gulf of Alaska gyre or an observed continuous shelf-edge jet.\",\r\n  \"layer\": \"Regional upper-ocean flow geography; no common fixed depth or measured current core diagnosed.\",\r\n  \"time_convention\": \"Undated regional sketch using the source's naming convention. The 1977 Kodiak observations support a distinction between current names, not this full route or a simultaneous 1977 northern branch path.\",\r\n  \"source_url\": \"https://www.pmel.noaa.gov/pubs/PDF/schu323/schu323.pdf\",\r\n  \"source_locator\": \"Section 1.1, printed page 1 (PDF page index 4): Alaska Current northward off British Columbia/southeast Alaska; Alaskan Stream on northern/northwestern gyre arm. Section 2.1 gives Kodiak observations of the separate stream rather than a whole Alaska Current axis.\",\r\n  \"source_citation\": \"Schumacher, Reed, Grigsby and Dreves (1979), Circulation and hydrography near Kodiak Island, September to November 1977, NOAA Technical Memorandum ERL PMEL-13.\",\r\n  \"source_license\": \"Factual geography and naming only; no source prose, charts, figures, provider geometry or observational arrays packaged.\",\r\n  \"coordinate_selection\": \"OSW selects offshore regional gates and every waypoint. The primary source supports northward branch identity and the stream distinction, not these coordinates, exact latitude limits or a diagnosed bathymetric contour. The route does not trace the distinct nearshore Alaska Coastal Current.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -130,\r\n      48\r\n    ],\r\n    [\r\n      -132,\r\n      51\r\n    ],\r\n    [\r\n      -135,\r\n      54\r\n    ],\r\n    [\r\n      -139,\r\n      57\r\n    ],\r\n    [\r\n      -141,\r\n      58.5\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"shorter_southeast_branch\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -132,\r\n          50\r\n        ],\r\n        [\r\n          -135,\r\n          54\r\n        ],\r\n        [\r\n          -138,\r\n          56.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Shorter OSW southeast-Alaska regional gate convention; no source-published exact termination implied.\"\r\n    },\r\n    {\r\n      \"id\": \"broader_eastern_gulf_branch\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -128.5,\r\n          47\r\n        ],\r\n        [\r\n          -132,\r\n          51\r\n        ],\r\n        [\r\n          -135,\r\n          54\r\n        ],\r\n        [\r\n          -139,\r\n          57\r\n        ],\r\n        [\r\n          -143,\r\n          58.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Broader offshore British Columbia/eastern Gulf convention; does not continue along northern/northwestern stream arm.\"\r\n    }\r\n  ],\r\n  \"scenario_rule\": \"Three regional reach/gate conventions crossed with three longitude shifts (-0.25/0/+0.25 degrees) and independent endpoint latitude shifts (-0.25/0/+0.25 degrees): 81 editorial scenarios. These do not represent an empirical axis-position distribution.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"remaining_gates\": [\r\n    \"Scientific review of regional gates and distinctions among Alaska Current, Alaskan Stream and Alaska Coastal Current.\",\r\n    \"Compare offshore sketch against reproducible upper-ocean circulation geometry and deep/shelf distinctions.\",\r\n    \"Canonical admission and publication review; no whole-gyre or nearshore current length inferred.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    170,\r\n    170,\r\n    180,\r\n    190\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"48°N offshore BC gate\",\r\n    \"58.5°N southeast gate\"\r\n  ],\r\n  \"figure_source_label\": \"NOAA PMEL-13 (1979)\",\r\n  \"route_extent_kind\": \"northward Alaska regional branch\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://www.tidesandcurrents.noaa.gov/glossary.html\",\r\n      \"citation\": \"NOAA Tides and Currents Glossary, Alaska Current and Alaskan Stream entries.\",\r\n      \"locator\": \"Alaska Current regional Gulf of Alaska description; Alaskan Stream extension along southern Aleutian Islands.\",\r\n      \"role\": \"General identity context; primary-source convention distinguishes the northward branch from the stream.\"\r\n    }\r\n  ],\r\n  \"input_sha256\": \"f269b2057ab05dff904b93392a5412d29909b970e5acd3806a28a22a08b22ff9\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 1378.587,\r\n  \"reported_approximate_reference
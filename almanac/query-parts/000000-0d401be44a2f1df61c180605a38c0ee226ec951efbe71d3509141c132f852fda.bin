a_tiles_sha256\": \"52c6605c32e59f50aa4abde984489c7055c0e3e201e7323e30160a623c9666e0\",\r\n  \"recommended_nasa_tile_id\": \"level2_E_4\",\r\n  \"nasa_crop_recommendation_rule\": \"Highest zoom crop covering the entire display route in every retained scenario, with tile ID as deterministic tie-break. No physical identification asserted.\",\r\n  \"input_file\": \"research/indian-secc-winter-reach-reference-path-input.json\",\r\n  \"figure\": \"figures/indian-secc-winter-reach-reference-path-candidate.svg\"\r\n}\r\n"},"research/pacific-neuc-southern-reach-reference-path-candidate.json":{"source_sha256":"f8c944ceb23570d6c4a0e74eaccf148e9ec95899fbe807001cbbb5db600bfe77","source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"pacific-north-equatorial-undercurrent\",\r\n  \"name\": \"Pacific NEUC - southern jet\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Declared western-to-central southern NEUC component reach between OSW 135 E and 175 E gates. Near-western latitude context is 8 N; all connecting latitudes and bends are editorial. Excludes other NEUC components, 3 N SCC/Tsuchiya jet, western source paths and eastern continuation. Not a whole-component or parent-system length.\",\r\n  \"layer\": \"Argo P-vector absolute geostrophic zonal velocity on 27.0 sigma-theta (kg/m3), spatially varying depth. Not LICOM/SODA velocity, uniform depth, or the 3 N Tsuchiya jet.\",\r\n  \"time_convention\": \"2004-2014 Argo climatological mean, year precision; not a dated observed axis or monthly geometry. Model periods 1969-2007 are not transferred.\",\r\n  \"source_url\": \"https://doi.org/10.1038/s41598-018-35469-2\",\r\n  \"source_locator\": \"Li et al. (2018) complete JATS Results / Mean Structures of NEUCs: three Argo jets near 8/13/18 N at 130-135 E, tilting southwest-northeast. Figure 1(a) r
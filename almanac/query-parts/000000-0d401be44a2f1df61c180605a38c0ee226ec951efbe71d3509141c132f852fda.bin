y_level0_B_1.mp4\",\r\n      \"source_id\": \"source:d4e82da0872ed45c\",\r\n      \"zoom\": 0,\r\n      \"nominal_display_route_fraction\": 1.0,\r\n      \"scenario_display_route_fraction_range\": [\r\n        1.0,\r\n        1.0\r\n      ],\r\n      \"complete_display_route_in_all_scenarios\": true,\r\n      \"interpretation\": \"Editorial reference-route/crop display overlap only; not physical current identification or dated event matching. Fraction measures equirectangular display line, not physical kilometres.\"\r\n    }\r\n  ],\r\n  \"nasa_tiles_sha256\": \"52c6605c32e59f50aa4abde984489c7055c0e3e201e7323e30160a623c9666e0\",\r\n  \"recommended_nasa_tile_id\": \"level2_E_4\",\r\n  \"nasa_crop_recommendation_rule\": \"Highest zoom crop covering the entire display route in every retained scenario, with tile ID as deterministic tie-break. No physical identification asserted.\",\r\n  \"input_file\": \"research/indian-seuc-mam-reach-reference-path-input.json\",\r\n  \"figure\": \"figures/indian-seuc-mam-reach-reference-path-candidate.svg\"\r\n}\r\n"},"research/pacific-necc-reach-reference-path-candidate.json":{"source_sha256":"0df217ce291f5e8d4804a2fa25f86a2bb8a6fdd5101f00abe2401583ec00df01","source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"pacific-north-equatorial-countercurrent\",\r\n  \"name\": \"Pacific North Equatorial Countercurrent\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Declared east-central Pacific study reach from 140 W to 95 W. Gates truncate a larger current; western Pacific inflow and coastal redistribution east of 95 W are excluded. Intermediate bends are editorial connections among section descriptions, not a reconstructed continuous axis or parcel trajectory.\",\r\n  \"layer\": \"Near-surface and upper-ocean eastward countercurrent; maxima can be slightly subsurface. Separate from equatorial EUC and deeper NSCC/Tsuchiya Jet; no uniform depth imposed.\",\r\n  \"time_convention\": \"Editorial connection of mean section descriptions from Johnson et al. (2002). Source ensemble June 1985 through December 2000; exact regional acquisition dates and a dated route axis are not extracted. Near 110 W the source reports no eastward surface expression in December-February and an August surface maximum; this line does not imply continuous year-round flow.\",\r\n  \"source_url\": \"https://www.pmel.noaa.gov/pubs/outstand/john2337/zonal_velocity.shtml\",\r\n  \"source_locator\": \"Section 3.1: 140 W near-surface core around 7 N, 125 W around 8 N, southward shift at 110 W and northward rebuilding at 95 W; section 3.2.3 separates seasonal surface expression near 110 W.\",\r\n  \"source_citation\": \"Johnson, Sloyan, Kessler and McTaggart (2002), Direct measurements of upper ocean currents and water properties across the tropical Pacific during the 1990s, Progress in Oceanography 52, 31-61, doi:10.1016/S0079-6611(02)00021-6.\",\r\n  \"source_license\": \"NOAA-hosted article states Elsevier copyright and prohibits further electronic distribution. Geographic facts paraphrased; source figures and CTD/ADCP fields not packaged.\",\r\n  \"source_retrieved_date\": \"2026-10-03\",\r\n  \"coordinate_selection\": \"OSW uses the published 140 W and 125 W section core neighborhoods, selects rounded 110 W 6 N and 95 W 7 N points to illustrate the reported southward then northward change, and inserts intermediate vertices. The latter latitudes and interpolating bends are editorial, not numeric positions extracted from the source. No current origin, termination, section width or dated axis asserted.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -140,\r\n      7\r\n    ],\r\n    [\r\n      -132.5,\r\n      7.5\r\n    ],\r\n    [\r\n      -125,\r\n      8\r\n    ],\r\n    [\r\n      -117.5,\r\n      7\r\n    ],\r\n    [\r\n      -110,\r\n      6\r\n    ],\r\n    [\r\n      -102.5,\r\n      6.5\r\n    ],\r\n    [\r\n      -95,\r\n      7\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"northern_editorial_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -140,\r\n          7\r\n        ],\r\n        [\r\n          -132.5,\r\n          8\r\n        ],\r\n        [\r\n          -125,\r\n          8.5\r\n        ],\r\n        [\r\n          -117.5,\r\n          7.5\r\n        ],\r\n        [\r\n          -110,\r\n          6.5\r\n        ],\r\n        [\r\n          -102.5,\r\n          7\r\n        ],\r\n        [\r\n          -95,\r\n          7\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW northward connection assumption, not a seasonal axis or width edge.\"\r\n    },\r\n    {\r\n      \"id\": \"southern_editorial_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -140,\r\n          7\r\n        ],\r\n        [\r\n          -132.5,\r\n          7\r\n        ],\r\n        [\r\n          -125,\r\n          7.5\r\n        ],\r\n        [\r\n          -117.5,\r\n          6.5\r\n        ],\r\n        [\r\n          -110,\r\n          5.5\r\n        ],\r\n        [\r\n          -102.5,\r\n          6\r\n        ],\r\n        [\r\n          -95,\r\n          7\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW southward connection assumption, not a seasonal axis or width edge.\"\r\n    }\r\n  ],\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"scenario_rule\": \"Three declared shapes crossed with uniform longitude offsets -0.25/0/+0.25 and independent endpoint-latitude offsets -0.25/0/+0.25 degrees: 81 editorial cases, not width bounds, seasonal extrema or confidence intervals.\",\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_studied_reach_routes\",\r\n  \"whole_system_length\": false,\r\n  \"remaining_gates\": [\r\n    \"Review editor-selected 110 W/95 W latitudes and interpolating continuity against compatible velocity fields.\",\r\n    \"Extract depth and month-specific axes before length or width seasonal ranges.\",\r\n    \"Keep weak or absent surface flow near 110 W separate from subsurface eastward flow; no annual continuous path inferred.\",\r\n    \"Resolve western inflow and coastal redistribution separately from this truncated studied reach.\"\r\n  ],\r\n  \"map_view_box\": [\r\n    195,\r\n    320,\r\n    245,\r\n    150\r\n  ],\r\n  \"map_label_size\": 3.3,\r\n  \"legend_line_spacing\": 5.8,\r\n  \"map_symbol_scale\": 1,\r\n  \"endpoint_labels\": [\r\n    \"140 W section neighborhood\",\r\n    \"95 W study limit\"\r\n  ],\r\n  \"figure_source_label\": \"Johnson et al. (2002)\",\r\n  \"route_extent_kind\": \"140 W to 95 W study reach\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://www.pmel.noaa.gov/pubs/outstand/john2337/data.shtml\",\r\n      \"citation\": \"Johnson et al. (2002), section 2, Data and fitting.\",\r\n      \"locator\": \"172 sections June 1985-December 2000, ten nominal longitude lines; ADCP mapping and annual-harmonic/SOI fitting.\",\r\n      \"role\": \"Sampling and transformation context; does not date the editorial route.\"\r\n    }\r\n  ],\r\n  \"context_landmarks\": [],\r\n  \"input_sha256\": \"41529892cbcf38629a8854b109a4894c988ad626c03a7cc4ece1b54e1a2725c5\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 4994.045,\r\n  \"reported_approximate_reference_path_km\": 5000,\r\n  \"scenario_range_km\": [\r\n  
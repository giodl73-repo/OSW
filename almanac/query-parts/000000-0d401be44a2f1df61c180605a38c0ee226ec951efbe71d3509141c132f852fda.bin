,\r\n      \"name\": \"Hiri Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"width_metric\": \"author_reported_e_folding_scale\",\r\n      \"width_metric_label\": \"local e-folding scale\",\r\n      \"approximate_width_km\": 50,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"dated_local_point_descriptor_not_temporal_range\",\r\n      \"range_interpretation\": \"Author-reported local descriptor. No statistical error, full-current inference or annual range supplied.\",\r\n      \"geographic_scope\": \"A87 northern transect near Rossel Island, southern Papua coast, looking from the east.\",\r\n      \"layer\": \"Thermal-wind cross-section context; no numerical fixed-depth width layer. Transport integration to 1500 dbar does not define the width support.\",\r\n      \"time_convention\": \"July 1987 cruise occupation; exact day unresolved. Different reaches and years are not a recurring seasonal series.\",\r\n      \"boundary_rule\": \"Author e-folding scaling width; lateral fit, reference velocity and paired velocity edges not independently reconstructed. No theoretical full-width multiplier.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Author cross-section descriptor; no independent perpendicular correction or paired edge extraction.\",\r\n      \"source_url\": \"https://researchonline.jcu.edu.au/46216/1/46216-hughes-1993-thesis.pdf\",\r\n      \"source_citation\": \"Hughes, R.D. (1993), An Investigation of the Coral Sea with an Ocean General Circulation Model, PhD thesis, James Cook University of North Queensland, December 1993.\",\r\n      \"source_locator\": \"Printed p70 / PDF86; Figure 3.15 printed p69 / PDF85; methods pp65-67 / PDF81-83.\",\r\n      \"source_retrieved_date\": \"2026-10-13\",\r\n      \"source_evidence_kind\": \"primary_thesis_author_reported_local_geost
  \"seasonal_playback_eligible\": false\n        }\n      ]\n    }\n  ]\n}\n"},"research/zeehan-ridgway-2007-seasonal-scope-audit.json":{"source_sha256":"42c3accb4c576c4fa5b23bc412391106d999745e44d8005bbd601477ed440895","source_json":"{\n  \"schema\": \"osw.current-qualitative-seasonal-scope-audit.v1\",\n  \"current_id\": \"zeehan\",\n  \"status\": \"editorial_primary_html_extraction_pending_independent_review\",\n  \"source\": {\n    \"author\": \"K. R. Ridgway\",\n    \"year\": 2007,\n    \"title\": \"Seasonal circulation around Tasmania: An interface between eastern and western boundary dynamics\",\n    \"doi\": \"10.1029/2006JC003898\",\n    \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2006JC003898\",\n    \"access\": \"Complete publisher HTML read; original response bytes not pinned. Direct download returned HTTP 403.\",\n    \"reviewed_on\": \"2026-10-08\",\n    \"original_response_sha256\": null,\n    \"redistribution_license\": null\n  },\n  \"protocol_file\": \"plans/qualitative-current-calendar-protocol-v1.md\",\n  \"protocol_sha256\": \"6a47a168fa94d9a998a97c5f0ef05c6fd9d30d4227e9601e8ebc3e2364b805fc\",\n  \"seasonal_calendar\": {\n    \"time_convention\": \"Gregorian months; recurring qualitative climatological interpretation, no representative year\",\n    \"claims\": [\n      {\n        \"id\": \"summer-indication\",\n        \"months\": [\n          10,\n          11,\n          12,\n          1,\n          2,\n          3\n        ],\n        \"kind\": \"indirect_property_indication\",\n        \"label\": \"Weak southward flow indicated\",\n        \"summary\": \"Seasonal property fields suggest weak southward flow; the inshore edge is unresolved.\",\n        \"locator\": \"Section 6, paragraph 29\",\n        \"reference_state\": \"seasonal property fields\"\n      },\n      {\n        \"id\": \"april-transition\",\n        \"months\": [\n          4\n        ],\n        \"kind\": \"regional_transition\",\n        \"label\": \"Coastal transition\",\n        \"summary\": \"Rising western coastal sea level favors southward alongshore flow.\",\n        \"locator\": \"Section 6, paragraph 30\",\n        \"reference_state\": \"seasonal coastal steric height\"\n      },\n      {\n        \"id\": \"may-development\",\n        \"months\": [\n          5\n        ],\n        \"kind\": \"development\",\n        \"label\": \"Warm-water flow develops\",\n        \"summary\": \"Continuous shelf-edge warm-water flow develops in May.\",\n        \"locator\": \"Section 9, paragraph 45\",\n        \"reference_state\": \"seasonal warm-water flow\"\n      },\n      {\n        \"id\": \"winter-peak\",\n        \"months\": [\n          6,\n          7\n        ],\n        \"kind\": \"qualitative_peak\",\n        \"label\": \"Reported peak\",\n        \"summary\": \"Flow intensifies and peaks in June–July; numerical strength is unspecified.\",\n        \"locator\": \"Section 6, paragraph 30; Section 9, paragraph 45\",\n        \"reference_state\": \"seasonal boundary flow\"\n      },\n      {\n        \"id\": \"winter-persistence\",\n        \"months\": [\n          5,\n          6,\n          7,\n          8,\n          9\n        ],\n        \"kind\": \"qualified_persistence\",\n        \"label\": \"Persists through at least September\",\n        \"summary\": \"May development and persistence through at least September do not establish an October disappearance.\",\n        \"locator\": \"Section 6, paragraph 30; Section 9, paragraph 45\",\n        \"reference_state\": \"seasonal Zeehan boundary flow\",\n        \"endpoint_qualifier\": \"at_least\",\n        \"month_assignment\": \"Continuous May–September interval inferred from development and persistence statements.\"\n      },\n      {\n        \"id\": \"summer-anomaly\",\n        \"months\": [\n          10,\n          11,\n          12,\n          1,\n          2,\n          3,\n          4\n        ],\n        \"kind\": \"anomaly_direction\",\n        \"label\": \"Equatorward shelf-edge anomaly\",\n        \"summary\": \"The summer anomaly opposes mean southward slope flow; it does not establish reversal of the whole current.\",\n        \"locator\": \"Section 9, paragraph 47\",\n        \"reference_state\": \"anomaly relative to mean flow\"\n      }\n    ],\n    \"months\": [\n      {\n        \"month\": 1,\n        \"claim_ids\": [\n          \"summer-indication\",\n          \"summer-anomaly\"\n        ]\n      },\n      {\n        \"month\": 2,\n        \"claim_ids\": [\n          \"summer-indication\",\n          \"summer-anomaly\"\n        ]\n      },\n      {\n        \"month\": 3,\n        \"claim_ids\": [\n          \"summer-indication\",\n          \"summer-anomaly\"\n        ]\n      },\n      {\n        \"month\": 4,\n        \"claim_ids\": [\n          \"april-transition\",\n          \"summer-anomaly\"\n        ]\n      },\n      {\n        \"month\": 5,\n        \"claim_ids\": [\n          \"may-development\",\n          \"winter-persistence\"\n        ]\n      },\n      {\n        \"month\": 6,\n        \"claim_ids\": [\n          \"winter-peak\",\n          \"winter-persistence\"\n        ]\n      },\n      {\n        \"month\": 7,\n        \"claim_ids\": [\n          \"winter-peak\",\n          \"winter-persistence\"\n        ]\n      },\n      {\n        \"month\": 8,\n        \"claim_ids\": [\n          \"winter-persistence\"\n        ]\n      },\n      {\n        \"month\": 9,\n        \"claim_ids\": [\n          \"winter-persistence\"\n        ]\n      },\n      {\n        \"month\": 10,\n        \"claim_ids\": [\n          \"summer-indication\",\n          \"summer-anomaly\"\n        ]\n      },\n      {\n        \"month\": 11,\n        \"claim_ids\": [\n          \"summer-indication\",\n          \"summer-anomaly\"\n        ]\n      },\n      {\n        \"month\": 12,\n        \"claim_ids\": [\n          \"summer-indication\",\n          \"summer-anomaly\"\n        ]\n      }\n    ],\n    \"observation_dates\": null,\n    \"speed_values\": null,\n    \"width_values\": null,\n    \"length_values\": null,\n    \"occupied_geometry\": null,\n    \"annual_dimension_extrema_eligible\": false,\n    \"dimension_rank_eligible\": false,\n    \"seasonal_geometry_playback_eligible\": false,\n    \"map_context\": {\n      \"route_id\": \"zeehan-reference-path-candidate\",\n      \"source_doi\": \"10.1029/2003JC001921\",\n      \"role\": \"existing_static_editorial_reference_path\",\n      \"month_changes_geometry\": false\n    }\n  },\n  \"field_context\": {\n    \"altimetry_period\": \"1992-10 through 2006-12\",\n    \"seasonal_operator\": \"Annual and semiannual least-squares harmonic reconstruction of SLA and SST; Figure 7 combines CMDT mean with reconstructed monthly SLA.\",\n    \"cmdt_mean_period\": \"1993–1999\",\n    \"sst_mean_figure_2_period\": \"1993–2004\",\n    \"cars\": \"Historical in situ profiles; 0.5 degree grid; poor western/southern winter sampling. No common occupation period assigned.\",\n    \"layer\": \"Surface seasonal fields and shelf/slope interpretation; exact current depth bounds unresolved.\",\n    \"numeric_current_edges\": null\n  },\n  \"excluded_dimension_proxies\": [\n    \"120 km filter cutoff\",\n    \"200 km loess radius\",\n    \"200–220 km interpolation correlation scales\",\n    \"more than 300 km WTL offshore extent\",\n    \"400 km temperature wavefront propagation\",\n    \"200 km offshore net transport location\"\n  ],\n  \"unresolved\": [\n    \"Numerical seasonal length and width ranges\",\n    \"Monthly speed amplitudes\",\n    \"Occupied seasonal current geometry\",\n    \"Exact onset and disappearance dates\",\n    \"Subsurface seasonal structure\"\n  ]\n}\n"},"research/atlantic-euc-layer-island-scope-audit.json":{"source_sha256":"9683be878b57e68319774334107c58f225f394dd3a873caa05bd6fde91143768","source_json":"{\r\n  \"schema\": \"osw.current-source-scope-audit.v1\",\r\n  \"current_id\": \"atlantic-equatorial-undercurrent\",\r\n  \"as_of\": \"2026-10-08\",\r\n  \"status\": \"editorial_source_scope_audit_not_canonical\",\r\n  \"source_access\": [\r\n    {\r\n      \"url\": \"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/2022-11/010086132.pdf\",\r\n      \"status\": \"full_primary_institutional_pdf_read\",\r\n      \"doi\": \"10.1029/2021JC017999\",\r\n      \"supports\": \"Eastward equatorial subsurface jet encounters Sao Tome and bifurcates; model eddies and return flows remain distinct from named source identities.\"\r\n    },\r\n    {\r\n      \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2006JC003931\",\r\n      \"status\": \"full_primary_publisher_page_read\",\r\n      \"doi\": \"10.1029/2006JC003931\",\r\n      \"supports\": \"35 W equatorial observational section and approximately 100 m core; depth/time/model distinctions.\"\r\n    },\r\n    {\r\n      \"url\": \"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/cahiers/ocea_tro/15471.pdf\",\r\n      \"status\": \"institutional_original_pdf_visually_reviewed\",\r\n      \"supports\": \"Campaign core speed/depth and unresolved Table I/II date conflicts; Figure 2 dated velocity sections, not extracted horizontal widths.\"\r\n    }\r\n  ],\r\n  \"declared_gates\": {\r\n    \"west\": [\r\n      -35,\r\n      0\r\n    ],\r\n    \"east\": [\r\n      5,\r\n      0\r\n    ],\r\n    \"role\": \"editorial_truncation_not_whole_current_endpoints\"\r\n  },\r\n  \"whole_current_length_km\": null,\r\n  \"whole_current_width_km\": null,\r\n  \"annual_dimension_ranges\": null,\r\n  \"source_scope\": \"Subsurface equatorial/thermocline jet. At 35 W the reported mean observed core is about 100 m; eastern cores and isopycnal layers differ. No single depth is imposed on the route; surface SEC/NECC and deeper equatorial currents remain separate.\",\r\n  \"excluded_inferences\": [\r\n    \"Do not treat source transport changes or vertical thickness as horizontal width.\",\r\n    \"Do not transfer surface NASA swirls to thermocline current identification.\",\r\n    \"Do not identify modeled island-generated anticyclones as named registry eddies.\",\r\n    \"Do not compare this truncated reach directly with whole Pacific EUC length.\"\r\n  ],\r\n  \"remaining_gates\": [\r\n    \"Review 35 W and pre-island truncation; source retroflections and eastern branches are not represented.\",\r\n    \"Obtain compatible depth/time-resolved velocity axis before physical length or seasonal dimensions.\",\r\n    \"Resolve island interaction and return-flow topology without treating generated eddies as named identities.\",\r\n    \"No occupied footprint, route-buffer width or whole-basin system length inferred.\",\r\n    \"Resolve campaign 7910/7912 Table I/II date conflicts before dated frames.\",\r\n    \"Extract reproducible paired velocity edges from original sections before assigning local horizontal width.\"\r\n  ],\r\n  \"section_properties\": {\r\n    \"schema\": \"osw.atlantic-euc-section-properties.v1\",\r\n    \"current_id\": \"atlantic-equatorial-undercurrent\",\r\n    \"status\": \"editorial_source_extraction_not_canonical\",\r\n    \"source_url\": \"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/cahiers/ocea_tro/15471.pdf\",\r\n    \"source_document_file\": \"research/source-data/voituriez-atlantic-euc-1983/journal-article.pdf\",\r\n    \"source_document_sha256\": \"a1c4b1dfc46247cb9c7da90ea03aa1a240bc987bd26b21c9cdf49f027d457e0b\",\r\n    \"source_document_bytes\": 1887693,\r\n    \"acquisition_file\": \"research/source-data/voituriez-atlantic-euc-1983/acquisition.json\",\r\n    \"acquisition_sha256\": \"1734746902c37f4fe31bc0dbf2a39b6f173a96e0759aa7604257683cca32736b\",\r\n    \"protocol_file\": \"plans/atlantic-euc-section-properties-protocol-v1.md\",\r\n    \"protocol_sha256\": \"4d8ff5480aba2d14be3d3a082e805f9b90843c2db5fb6ef52bc46f1d596a068e\",\r\n    \"source_locator\": \"Printed pp165,167–168: Table I, Figure 2, Table II; methods pp164–165.\",
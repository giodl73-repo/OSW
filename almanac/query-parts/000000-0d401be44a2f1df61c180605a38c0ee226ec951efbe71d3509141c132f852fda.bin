merge or complete system extent admitted.\"\r\n        }\r\n      ],\r\n      \"state_evidence\": [],\r\n      \"connections\": [],\r\n      \"scope_notes\": [],\r\n      \"evidence_links\": [],\r\n      \"object_url\": \"object.html?id=current%3Ahiri-current\",\r\n      \"route_url\": \"reference-routes.html#hiri-reference-path-candidate\",\r\n      \"season_url\": \"seasons.html?current=hiri-current\"\r\n    },\r\n    {\r\n      \"id\": \"current:indian-equatorial-undercurrent\",\r\n      \"label\": \"Indian Ocean Equatorial Undercurrent\",\r\n      \"type\": \"named_current\",\r\n      \"identity_level\": \"current\",\r\n      \"source_kind\": \"seasonal eastward subsurface jet\",\r\n      \"setting\": \"equatorial\",\r\n      \"time_behavior\": \"seasonal\",\r\n      \"basin\": \"Equatorial Indian Ocean\",\r\n      \"capabilities\": {\r\n        \"observed_velocity\": 0,\r\n        \"radius_evidence\": 0,\r\n        \"reported_length\": 0,\r\n        \"reference_route\": 1,\r\n        \"scoped_width\": 1,\r\n        \"geometry\": 0,\r\n        \"time_samples\": 0,\r\n        \"source_connectivity\": 0,\r\n        \"scope_notes\": 1,\r\n        \"dated_diagnostics\": 0,\r\n        \"flow_network\": 0,\r\n        \"passage_transport\": 0\r\n      },\r\n      \"recorded_claims\": 56,\r\n      \"nasa_links\": 1,\r\n      \"fingerprint\": \"938cf3341636e50f83ca06bea442e3638753a4874244e085f7a776bc1fff0f26\",\r\n      \"series\": [],\r\n      \"section_fingerprints\": {\r\n        \"identity\": \"927f755b2f792485d395af72cb32f634a79bbbf82e940bc3cf96eaff83a492c0\",\r\n        \"sources\": \"aaad186b73b87e9fca65daa3d317057235144df85933d14a93e4f6c0ca2ac1ba\",\r\n        \"claims\": \"3272df0d3d4fc04d3558c46b969c155a09b38c7ac839d648c81be622543c8cd1\",\r\n        \"measurements\": \"57410032b52d804e9f91fb438ebc96ff71e2fe91b7f3a7a5620fcde1b87c128a\",\r\n        \"routes_geometry\": \"4d8d7be23cf4e40225d6218af4cd7c1343369fc587f83bdaac3b11a02b0399e7\",\r\n        \"media\": \"d
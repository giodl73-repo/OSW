6":"b032ee03a0b2174c4e16fa1328e516d244d408413f464a24c90dc327cb4c0132","source_json":"{\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"indian-equatorial-undercurrent\",\r\n  \"name\": \"Indian Equatorial Undercurrent - spring reference reach\",\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"scope\": \"Declared53 E to91 E spring Indian EUC reference corridor. Longitude gates follow the reviewed 1963 observational domain; OSW chooses the equatorial line, connecting vertices and alternatives. Excludes Wyrtki surface jets, westward undercurrent conventions, anomalous fall episodes and whole-basin endpoints.\",\r\n  \"layer\": \"Upper-thermocline eastward undercurrent geography. No uniform fixed depth reconstructed; 80.5 E, 50-150 m observations in 1994 are a different local occupation, not this route layer.\",\r\n  \"time_convention\": \"Spring eastward convention. Review reports several observations between 53 E and 91 E during March-April 1963; those stations do not establish a simultaneous continuous axis or annual recurrence.\",\r\n  \"source_url\": \"https://www.whoi.edu/cms/files/schott_mccreary_41948.pdf#page=29\",\r\n  \"source_locator\": \"Schott and McCreary (2001), section3.2.1 printed/PDF29: eastward spring observations at several positions 53-91 E in March-April 1963; displacement and transient structure. Sections 3.2.1-3.2.2 pp29-31 distinguish moorings, years and models. Cited pages reviewed, not source axis digitization.\",\r\n  \"source_citation\": \"Schott and McCreary (2001), The monsoon circulation of the Indian Ocean, Progress in Oceanography 51, 1-123, doi:10.1016/S0079-6611(01)00083-0.\",\r\n  \"source_license\": \"Elsevier original retained locally; independent attributed geographic annotations only. No source figures/fields reproduced.\",\r\n  \"source_retrieved_date\": \"2026-10-13\",\r\n  \"coordinate_selection\": \"Source supports the declared regional geography or study-domain convention. OSW selects all gates, rounded connecting vertices and alternative bends; no velocity axis or source trajectory reconstructed. Independent longitude and endpoint-latitude shifts describe drawing choices, not current width, source position errors or seasonal extrema.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      53,\r\n      0\r\n    ],\r\n    [\r\n      63,\r\n      0\r\n    ],\r\n    [\r\n      73,\r\n      0\r\n    ],\r\n    [\r\n      83,\r\n      0\r\n    ],\r\n    [\r\n      91,\r\n      0\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"southern_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          53,\r\n          0\r\n        ],\r\n        [\r\n          63,\r\n          -0.5\r\n        ],\r\n        [\r\n          73,\r\n          -0.5\r\n        ],\r\n        [\r\n          83,\r\n          -0.5\r\n        ],\r\n        [\r\n          91,\r\n          0\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Alternative editorial bend between the declared regional gates; not a measured seasonal state.\"\r\n    },\r\n    {\r\n      \"id\": \"northern_bend\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          53,\r\n          0\r\n        ],\r\n        [\r\n          63,\r\n          0.5\r\n        ],\r\n        [\r\n          73,\r\n          0.5\r\n        ],\r\n        [\r\n          83,\r\n          0.5\r\n        ],\r\n        [\r\n          91,\r\n          0\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Alternative editorial bend between the declared regional gates; not a measured seasonal state.\"\r\n    }\r\n  ],\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.5,\r\n    0,\r\n    0.5\r\n  ],\r\n  \"scenario_rule\": \"Three declared shapes with three longitude shifts and independen
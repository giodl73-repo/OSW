nd_line_spacing\": 1.7,\r\n  \"map_symbol_scale\": 0.3,\r\n  \"remaining_gates\": [\r\n    \"Review lower-estuary formation and downstream naming gate conventions.\",\r\n    \"Validate coastal core, island and bathymetric correspondence; coarse map is insufficient.\",\r\n    \"Retain meandering, detachment and feeder variability without parcel-continuity claims.\",\r\n    \"Canonical admission and publication review; no width buffer or annual extrema inferred.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"gaspe\",\r\n  \"name\": \"Gaspé Current\",\r\n  \"scope\": \"OSW southern lower-estuary offshore approach near Pointe-des-Monts latitude, along the Gaspe Peninsula and toward a gate north of the Magdalen Islands. Excludes upstream river/estuary length, episodic north-shore feeder, Anticosti Gyre circuit, Chaleur Bay recirculation and Cabot Strait/Scotian downstream routes. No full connected-system length.\",\r\n  \"layer\": \"Upper-layer coastal jet naming context; typical regional summary describes approximately upper 40 m. No depth-specific velocity core or uniform transverse footprint reconstructed.\",\r\n  \"time_convention\": \"Regional reference informed by February 2022 thesis introduction and a 2024 coastal circulation-model description. Not a dated observed path, annual mean axis or continuous trajectory through all meanders and detachments.\",\r\n  \"source_url\": \"https://semaphore.uqar.ca/2055/1/Theau_Leclercq_fevrier2022.pdf\",\r\n  \"source_locator\": \"Printed page 14 / PDF page 30, chapter 2.2 Introduction: lower-estuary origin near Pointe-des-Monts and extension toward Magdalen Islands; printed page 5 / PDF page 21 describes eastward peninsula coastal jet and episodic feeder/Anticosti influence.\",\r\n  \"source_citation\": \"Leclercq, Théau (2022), Observations des remontées et des plongées des eaux en bordure du courant de Gaspé, master's thesis in oceanography, UQAR-ISMER, February 2022.\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://link.springer.com/article/10.1007/s10236-024-01634-7\",\r\n      \"citation\": \"Paquin et al. (2024), A new high-resolution Coastal Ice-Ocean Prediction System for the East Coast of Canada, Ocean Dynamics 74, 799-826, doi:10.1007/s10236-024-01634-7.\",\r\n      \"locator\": \"Section 2, spectral-nudging discussion: buoyancy-driven south-shore current, detachment and Anticosti recirculation; fine current meanders are not deterministically constrained.\",\r\n      \"role\": \"Continuity caveat; source used only for named-flow/detachment context, not digitized numerical-model route.\"\r\n    }\r\n  ],\r\n  \"coordinate_selection\": \"Every offshore vertex and approach gate is OSW-selected. Thesis supplies named origin/region/extension but not these coordinates, precise current endpoints or a measured length. Alternative lower-estuary and Magdalen approach gates test regional convention. No source track or front digitized. Reported 10-20 km width range is separate regional context, not a route buffer. Approximate context markers are not coast outlines or clearance evidence.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -67.05,\r\n      49.13\r\n    ],\r\n    [\r\n      -66.1,\r\n      49.35\r\n    ],\r\n    [\r\n      -65.5,\r\n      49.35\r\n    ],\r\n    [\r\n      -64.85,\r\n      49.2\r\n    ],\r\n    [\r\n      -64.2,\r\n      48.95\r\n    ],\r\n    [\r\n      -63.9,\r\n      48.6\r\n    ],\r\n    [\r\n      -63.4,\r\n      48.15\r\n    ],\r\n    [\r\n      -62.5,\r\n      47.8\r\n    ],\r\n    [\r\n      -61.75,\r\n      47.6\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"shorter_estuary_magdalen_approaches\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -66.7,\r\n          49.2\r\n        ],\r\n        [\r\n          -66.1,\r\n          49.35\r\n        ],\r\n        [\r\n          -65.5,\r\n          49.35\r\n        ],\r\n        [\r\n          -64.8
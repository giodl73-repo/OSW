otes\": [\r\n        {\r\n          \"current_id\": \"south-pacific\",\r\n          \"label\": \"Frontal proxies, separate-year sections and layered flow\",\r\n          \"audit_file\": \"research/south-pacific-eastern-front-reach-layer-time-scope-audit.json\",\r\n          \"summary\": \"The 103–88 W studied reach connects reported STF crossings sampled in 1994 and 1993. Frontal proxies are not velocity cores or simultaneous geometry. The 150 m temperature criterion does not define an axis depth; branch correspondence and whole-current dimensions remain unresolved. Layered gyre flow cannot be identified universally by the STF.\",\r\n          \"source_url\": \"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/2024-12/010047303.pdf\",\r\n          \"source_locator\": \"Chaigneau and Pizarro (2005), Data [5], Table 1 and STF [14]–[17]; Ridgway and Dunn (2007), section 3.4 [15].\",\r\n          \"observed_period\": null\r\n        }\r\n      ],\r\n      \"evidence_links\": [\r\n        {\r\n          \"label\": \"March 1990 reported band width constraint\",\r\n          \"url\": \"../figures/south-pacific-stramma-1990-band-constraint.svg\"\r\n        },\r\n        {\r\n          \"label\": \"Monthly section profiles and resolution flags\",\r\n          \"url\": \"../figures/south-pacific-100w-2013-monthly-component-profiles.svg\"\r\n        },\r\n        {\r\n          \"label\": \"1995–2016 calendar-month climatology at 100 W profiles\",\r\n          \"url\": \"../figures/south-pacific-100w-1995-2016-monthly-component-profiles.svg\"\r\n        },\r\n        {\r\n          \"label\": \"1995–2016 year-by-year monthly section spans\",\r\n          \"url\": \"../figures/southern-basin-1995-2016-yearly-monthly-spans.svg\"\r\n        }\r\n      ],\r\n      \"object_url\": \"object.html?id=current%3Asouth-pacific\",\r\n      \"route_url\": \"reference-routes.html#south-pacific-eastern-front-reach-reference-path-candidate\",\r\n      \"season_url\": \"seasons.html?c
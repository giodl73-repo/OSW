ull,\r\n      \"time_convention\": \"Synoptic August 2015 cruise context, 12-21 August; exact section dates unextracted. Three sections span about five days, not seasonal phases.\",\r\n      \"boundary_rule\": \"Tube 1: first transport-density drop on either side of core below AW thickness times 0.04 m/s; C offshore edge x=-11 km from SADCP. Separate 0.02/0.08 m/s sensitivity cases.\",\r\n      \"source_url\": \"https://os.copernicus.org/articles/14/1603/2018/\",\r\n      \"source_citation\": \"Kolas, E. and Fer, I. (2018), Hydrography, transport and mixing of the West Spitsbergen Current: the Svalbard Branch in summer 2015, Ocean Science 14, 1603-1618, doi:10.5194/os-14-1603-2018.\",\r\n      \"source_locator\": \"Table 2, printed p.1611, Width (km), section A, stream tube 1; methods sections 3.2-3.3, pp.1606-1608.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_synoptic_section_diagnostic\",\r\n      \"extraction_method\": \"Transcribed original PDF Table 2 cells after rendering and visual inspection; numeric methods read. No new inversion or geographic edge digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"calendar_months\": null,\r\n      \"observed_period\": null,\r\n      \"phase_label\": \"Section A / tube 1 / August 2015 snapshot\",\r\n      \"phase_kind\": \"synoptic_stream_tube_section\",\r\n      \"source_current_label\": \"West Spitsbergen Current; locally constrained stream tube\",\r\n      \"boundary_sides\": \"paired_along_section_stream_tube_limits\",\r\n      \"source_quality_note\": \"Original Table 2 and methods inspected. Brackets are threshold sensitivity; exact occupation dates and geographic width edges are unextracted. A1/A2 share one source tube.\",\r\n      \"remaining_gates\": 
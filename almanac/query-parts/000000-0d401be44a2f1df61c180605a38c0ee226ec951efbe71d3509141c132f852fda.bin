3202beb94a80433\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"kuroshio-extension-sasaki-2013-monthly-field-width\",\r\n      \"current_id\": \"kuroshio-extension\",\r\n      \"name\": \"Kuroshio Extension\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": 100,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"approximate_regional_point_no_reported_interval\",\r\n      \"range_interpretation\": \"One approximate regional background value; no numerical uncertainty, range, confidence interval, annual extrema or seasonal observations supplied.\",\r\n      \"geographic_scope\": \"Intense Kuroshio Extension jet in monthly mean fields, extending eastward from Japan to the date line; no transverse boundary coordinates extracted.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Author-reported meridional width; not assumed normal to the meandering jet.\",\r\n      \"layer\": \"Surface SSH and geostrophic velocity context; no fixed vertical width layer supplied.\",\r\n      \"time_convention\": \"Monthly mean fields summarized in source prose; no dated width series extracted. January 2005 is the illustrative Figure 1b field.\",\r\n      \"boundary_rule\": \"Author-reported meridional jet width. Continuous SSH contours and peak velocity locate the axis; no paired width edges or threshold resolved.\",\r\n      \"source_url\": \"https://eprints.lib.hokudai.ac.jp/repo/huscap/all/52934/jpo-d-12-096.1.pdf\",\r\n      \"source_citation\": \"Sasaki, Y. N., S. Minobe and N. Schneider (2013), Decadal Response of the Kuroshio Extension Jet to Rossby Waves: Observation and Thin-Jet Theory, JPO 43(2):442–456, doi:10.1175/JPO-D-12-096.1.\",\r\n      \"source_locator\": \"Printed p445 / PDF page 5, section 3 first paragraph; data/methods pp443–444; Figure 1 printed p444 / PDF page 4.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_original_regional_monthly_field_summary\",\r\n      \"extraction_method\": \"Approximate width transcribed from visually inspected original; no contour, coordinate or velocity-profile digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Meridional jet width in monthly mean fields\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Monthly mean is a temporal operator, not a recovered month-by-month width series. The separate 200 km climatological meridional scale has different support; it is not an interval endpoint.\",\r\n      \"remaining_gates\": [\r\n        \"Resolve a reproducible meridional width boundary rule and exact transverse support.\",\r\n        \"Extract dated compatible sections before seasonal dimensions or playback.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_source\": \"Original section 3 and Figure 1; axis method inspected separately from unresolved paired width method.\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"monthly_mean_is_dated_width_series\": false,\r\n        \"illustrative_figure_date_is_width_occupation\": false,\r\n        \"analysis_period_is_width_occupation\": false,\r\n        \"climatological_scale_is_width_range_endpoint\": false,\r\n        \"jet_displacement_is_width_variation\": false,\r\n        \"axis_search_contours_are_width_edges\": false,\r\n        \"eof_anomaly_scale_is_width_measurement\": false,\r\n        \"low_pass_shading_is_monthly_width_series\": false,\r\n        \"meridional_width_is_flow_normal_width\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"temporal_operator\": \"monthly_mean\",\r\n        \"illustrative_figure_month\": \"2005-01\",\r\n        \"analysis_period_context\": {\r\n          \"start\": \"1993-01\",\r\n          \"end\": \"2010-12\",\r\n          \"is_width_measurement_support\": false\r\n        },\r\n        \"data_context\": {\r\n          \"product\": \"AVISO monthly absolute dynamic height and surface geostrophic velocities\",\r\n          \"grid\": \"1/3 degree Mercator\",\r\n          \"mean_dynamic_topography\": \"Rio and Hernandez (2004)\",\r\n          \"low_pass_context\": \"9-month running mean for low-frequency analyses; Figure 1a standard deviations explicitly filtered; Figure 1b monthly mean distinct.\"\r\n        },\r\n        \"climatological_scale_context\": {\r\n          \"meridional_scale_km\": 200,\r\n          \"temporal_operator\": \"climatological_mean\",\r\n          \"geographic_scope\": \"Japan coast near 35°N to 165°E\",\r\n          \"source_locator\": \"Printed p445, section 3 first paragraph / Figure 1a\",\r\n          \"is_width_sample\": false,\r\n          \"is_range_endpoint\": false,\r\n          \"uncertainty_km\": null\r\n        },\r\n        \"protocol_file\": \"plans/kuroshio-extension-width-averaging-protocol-v1.md\",\r\n        \"protocol_sha256\": \"bac962694f1a0f2e0560218ace30240e3f0f8716ef5e4a8edef53c0bd7f99d79\",\r\n        \"display_caption\": \"Monthly mean fields · approximate 100 km meridional jet width, extending to the date line. No dated width series, numerical uncertainty, paired edges or annual range extracted.\",\r\n        \"display_method_note\": \"Separate context: the climatological jet has a reported 200 km meridional scale from Japan to 165°E. Different temporal and geographic supports; no 100–200 km seasonal range. Farther downstream, shifts of the narrow jet broaden its long-term mean. January 2005 illustrates a monthly SSH field; 60–120 cm contours locate the axis search region, not width edges.\",\r\n        \"audit_file\": \"research/kuroshio-extension-sasaki-2013-width-averaging-scope-audit.json\",\r\n        \"audit_sha256\": \"dfa44d57f053ac0cd8af32abcfdb0c5dcbdc63a3937c64abf14c79a2cb9370c7\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"ngcu-zenk-1999-vitiaz-width-constraint\",\r\n      \"current_id\": \"new-guinea-coastal-undercurrent\",\r\n      \"name\": \"New Guinea Coastal Undercurrent\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": null,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"author_reported_order_of_magnitude_less_than_scale\",\r\n      \"range_interpretation\": \"Source O(<20 km) preserves an approximate less-than size description; not a measured 20 km point, rigorous hard bound, 0–20 km interval, uncertainty or seasonal extrema.\",\r\n      \"geographic_scope\": \"Local bands near the western exit of Vitiaz Strait; downstream central Bismarck Sea widening retained as context, not a whole-current dimension.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Local Doppler band breadth; exact transverse orientation and paired coordinates unresolved.\",\r\n      \"layer\": \"Subsurface slope-parallel current described near 200 m. No fixed width layer or paired depth-specific edges extracted.\",\r\n      \"time_convention\": \"SONNE cruise 113 context (10 October–19 November 1996); exact Doppler width occupations unresolved. March 1999 is publication, not observation.\",\r\n      \"boundary_rule\": \"Author-reported order-of-magnitude less-than band size. Exceeding 80 cm/s describes speed, not an adopted width-edge cutoff.\",\r\n      \"source_url\": \"https://oceanrep.geomar.de/1816/1/news34.pdf\",\r\n      \"source_citation\": \"Zenk, W., G. Siedler, J. Holfort and O. Boebel (1999), Float Observations Showing the Equatorial Crossing of Antarctic Intermediate Water in the Western Pacific, International WOCE Newsletter 34 (March), pp10–14, printed p13. Unpublished manuscript / work-in-progress newsletter report.\",\r\n      \"source_locator\": \"Printed/PDF p13 first column, continuation from p10; article pp10–14. Copyright PDF page 44. Figure 3 cruise-label conflict on p13.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_original_local_doppler_band_size_constraint\",\r\n      \"extraction_method\": \"Qualifier and reference size transcribed from visually inspected original; no profile digitization, exact crossing pairing or doubled downstream value.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Vitiaz exit Doppler band size constraint\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Work-in-progress newsletter report, not a peer-reviewed width series. Cruise 113 in prose conflicts with cruise 133 in Figure 3 caption. Salinity sections and float trajectories do not supply width boundaries.\",\r\n      \"remaining_gates\": [\r\n        \"Recover Doppler crossings, exact width layer and paired boundary rule.\",\r\n        \"Resolve cruise-label conflict and occupation support before dated widths.\",\r\n        \"Recover independently measured downstream dimensions; no factor-of-two arithmetic admission.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_source\": \"Zenk et al. (1999), p13; cited SONNE report inspected for ADCP context, not a resolved paired width definition.\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"reference_scale_is_point_width\": false,\r\n        \"notation_is_rigorous_upper_bound\": false,\r\n        \"zero_to_reference_is_width_range\": false,\r\n        \"downstream_doubling_is_numeric_width\": false,\r\n        \"downstream_widening_is_seasonal_range\": false,\r\n        \"speed_exceedance_is_width_cutoff\": false,\r\n        \"core_depth_is_fixed_width_layer\": false,\r\n        \"adcp_depth_coverage_is_fixed_width_layer\": false,\r\n        \"salinity_section_is_width_boundary\": false,\r\n        \"cruise_dates_are_width_occupations\": false,\r\n        \"publication_month_is_width_observation\": false,\r\n        \"float_dates_are_width_occupations\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"cruise_context\": {\r\n          \"prose_cruise_number\": \"113\",\r\n          \"figure_3_caption_cruise_number\": \"133\",\r\n          \"cruise_number_conflict\": true,\r\n          \"voyage_start\": \"1996-10-10\",\r\n          \"voyage_end\": \"1996-11-19\",\r\n          \"is_width_measurement_support\": false\r\n        },\r\n        \"downstream_context\": {\r\n          \"reported_core_widening_factor\": 2,\r\n          \"location\": \"central Bismarck Sea\",\r\n          \"derived_width_km\": null,\r\n          \"is_seasonal_variation\": false\r\n        },\r\n        \"method_context\": {\r\n          \"local_speed_exceeds_cm_s\": 80,\r\n          \"core_depth_context_m\": 200,\r\n          \"adcp_coverage_context_m\": [\r\n            350,\r\n            400\r\n          ],\r\n          \"is_width_boundary_method\": false\r\n        },\r\n        \"supporting_report\": {\r\n          \"source_url\": \"https://oceanrep.geomar.de/id/eprint/2244/1/IFM-BER_288.pdf\",\r\n          \"source_locator\": \"Printed p16 / PDF page 17, ADCP subsection; printed pp3 and 8–10 voyage context; no paired width extraction.\",\r\n          \"source_document_file\": \"research/source-data/siedler-sonne-1997/journal-article.pdf\",\r\n          \"source_document_bytes\": 4094903,\r\n          \"source_document_sha256\": \"cc9e293b98a47581b9d162c63781af1e5842d6aa0de403a7f06941ea7e6f4cca\",\r\n          \"acquisition_file\": \"research/source-data/siedler-sonne-1997/acquisition.json\",\r\n          \"acquisition_sha256\": \"31672631b098531dc6d707525055183e08b3b04e25c43381722bb6f6941653b3\",\r\n          \"is_independent_width_measurement\": false\r\n        },\r\n        \"protocol_file\": \"plans/ngcu-reported-width-constraint-protocol-v1.md\",\r\n        \"protocol_sha256\": \"ff0d0e46f03a9054a69bc06205063064c235d9ac70d640401a4191aeaf76f3c2\",\r\n        \"display_caption\": \"Vitiaz exit subsurface Doppler bands · source reports O(<20 km). Approximate size constraint, not a 20 km measured point or a 0–20 km range. Exact representative width, numerical uncertainty, dates and paired edges unresolved.\",\r\n        \"display_method_note\": \"Core widening by a factor of two in the central Bismarck Sea describes spatial change; no 40 km width or seasonal cycle inferred. The 200 m core, 350–400 m ADCP coverage, salinity section and speeds above 80 cm/s do not define paired width edges. Cruise 113 in the prose conflicts with 133 in Figure 3 caption; exact width occupations remain unresolved.\",\r\n        \"audit_file\": \"research/ngcu-zenk-1999-width-constraint-scope-audit.json\",\r\n        \"audit_sha256\": \"f7aaac4169046b43f85affa40bbf711b50be1278bf72079777cf6292d3b5a13d\"\r\n      },\r\n      \"reported_width_constraint\": {\r\n        \"kind\": \"author_order_of_magnitude_less_than\",\r\n        \"reference_scale_km\": 20,\r\n        \"source_notation\": \"O(<20 km)\",\r\n        \"is_rigorous_upper_bound\": false,\r\n        \"representative_width_km\": null,\r\n        \"lower_bound_km\": null,\r\n        \"numerical_uncertainty_km\": null\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"zeehan-cresswell-2000-historical-slope-width\",\r\n      \"current_id\": \"zeehan\",\r\n      \"name\": \"Zeehan Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": 40,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"approximate_regional_point_no_reported_interval\",\r\n      \"range_interpretation\": \"One approximate regional background value; no numerical uncertainty, range, confidence interval, annual extrema or seasonal observations supplied.\",\r\n      \"geographic_scope\": \"Continental slope at the western entrance of Bass Strait; attributed historical estimate, not all western Tasmanian shelf flow.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Regional cross-current description; exact transverse axis and paired edges unresolved.\",\r\n      \"layer\": \"Warm baroclinic slope-current context; fixed width depth bounds unresolved.\",\r\n      \"time_convention\": \"Historical Baines et al. (1983) description repeated in Cresswell (2000); exact width occupation support unresolved.\",\r\n      \"boundary_rule\": \"Attributed author approximate width; no numerical threshold or paired edge coordinates extracted.\",\r\n      \"source_url\": \"https://eprints.utas.edu.au/13585/7/2000_Cresswell_Currents_rst.pdf\",\r\n      \"source_citation\": \"Cresswell, G. (2000), Currents of the continental shelf and upper slope of Tasmania, Papers and Proceedings of the Royal Society of Tasmania 133(3):21–30, doi:10.26749/rstpp.133.3.21.\",\r\n      \"source_locator\": \"Introduction, printed p21 / PDF page 1, paragraph on Baines et al. (1983). Separate Strahan sections: pp24–25 and Figure 5C p28 / PDF page 8.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_original_attributed_historical_regional_summary\",\r\n      \"extraction_method\": \"Approximate width from visually reviewed original paragraph; qualitative section comparison transcribed separately, no velocity-contour digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Attributed historical Bass Strait slope width\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"The 40 km summary is attributed to Baines et al. (1983); March/December 1997 Strahan widths remain numerically unknown. Neither the survey depth nor later seasonal calendar supplies this width support.\",\r\n      \"remaining_gates\": [\r\n        \"Resolve original width boundary operator, layer and occupation support.\",\r\n        \"Extract compatible dated paired boundaries before numerical seasonal ranges.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_source\": \"Baines, Edwards & Fandry (1983), doi:10.1071/MF9830155, as attributed in Cresswell Introduction.\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"historical_width_is_1997_section_width\": false,\r\n        \"two_occupations_are_annual_extrema\": false,\r\n        \"survey_months_are_width_calendar\": false,\r\n        \"adcp_depth_coverage_is_fixed_width_layer\": false,\r\n        \"mooring_isobaths_are_width_layer\": false,\r\n        \"drifter_drogue_is_width_layer\": false,\r\n        \"velocity_sign_contours_are_admitted_paired_edges\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"original_width_source_access\": {\r\n          \"doi\": \"10.1071/MF9830155\",\r\n          \"archive_url\": \"https://citeseerx.ist.psu.edu/document?doi=82056fb29ae09eb8f42aa4b8174a95a3c70b533c&repid=rep1&type=pdf\",\r\n          \"access\": \"Three-page archived article text readable through web PDF extraction; original bytes not acquired or visually inspected. Publisher download 403; direct archive request 404.\",\r\n          \"source_response_sha256\": null,\r\n          \"is_independent_width_record\": false\r\n        },\r\n        \"method_context\": {\r\n          \"ship_adcp_frequency_khz\": 150,\r\n          \"ship_depth_coverage_m\": 300,\r\n          \"lowest_water_column_fraction_excluded\": 0.15,\r\n          \"mooring_isobaths_m\": [\r\n            100,\r\n            200\r\n          ],\r\n          \"drifter_drogue_depth_m\": 15,\r\n          \"is_historical_width_layer\": false,\r\n          \"december_flow_extends_beyond_adcp_depth_coverage\": true\r\n        },\r\n        \"section_comparison\": {\r\n          \"site\": \"Strahan, western Tasmania\",\r\n          \"source_locator\": \"Printed p25, Strahan December paragraph; Figure 5C printed p28 / PDF page 8.\",\r\n          \"comparison_kind\": \"author_qualitative_between_two_occupations\",\r\n          \"width_relation\": \"December narrower than March\",\r\n          \"strength_relation\": \"December slightly stronger than March\",\r\n          \"numerical_width_ratio\": null,\r\n          \"annual_range_eligible\": false,\r\n          \"monthly_climatology_eligible\": false,\r\n          \"occupied_geometry_eligible\": false,\r\n          \"records\": [\r\n            {\r\n              \"id\": \"strahan-1997-03\",\r\n              \"observed_month\": \"1997-03\",\r\n              \"station_label\": \"19:27\",\r\n              \"width_km\": null,\r\n              \"width_range_km\": null,\r\n              \"width_description\": \"Broader of the two reported occupations\",\r\n              \"strength_description\": \"Reported southward speeds up to 0.2 m/s in prose\",\r\n              \"whole_voyage_context\": {\r\n                \"start\": \"1997-03-19\",\r\n                \"end\": \"1997-03-27\",\r\n                \"is_exact_section_support\": false\r\n              }\r\n            },\r\n            {\r\n              \"id\": \"strahan-1997-12\",\r\n              \"observed_month\": \"1997-12\",\r\n              \"station_label\": \"41–49\",\r\n              \"width_km\": null,\r\n              \"width_range_km\": null,\r\n              \"width_description\": \"Narrower than March\",\r\n              \"strength_description\": \"Slightly stronger than March; maximum not transcribed\",\r\n              \"whole_voyage_context\": {\r\n                \"start\": \"1997-12-01\",\r\n                \"end\": \"1997-12-09\",\r\n                \"is_exact_section_support\": false\r\n              }\r\n            }\r\n          ]\r\n        },\r\n        \"protocol_file\": \"plans/zeehan-width-source-separation-protocol-v1.md\",\r\n        \"protocol_sha256\": \"fadd4e4eff23f524ccdd16aaa6e1f906bb46c9b2bc23dca8cc082c7865f82411\",\r\n        \"display_caption\": \"Approximate 40 km historical slope-current width near western Bass Strait, attributed to Baines et al. (1983). Numerical uncertainty and paired edges unknown; not a 1997 Strahan section width.\",\r\n        \"display_method_note\": \"Separate 1997 Strahan evidence: December is described as narrower and slightly stronger than March. Neither section has a numerical width here. Two occupations do not establish annual extrema or a monthly climatology; 300 m ADCP coverage is not the historical width layer.\",\r\n        \"audit_file\": \"research/zeehan-cresswell-2000-width-section-scope-audit.json\",\r\n        \"audit_sha256\": \"83b7c97d7d30ff2b2044bfc12316d99806b3005da5709afbf385a7f485c1f0c5\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"tsushima-matsuyama-1990-nearshore-modal-width\",\r\n      \"current_id\": \"tsushima\",\r\n      \"name\": \"Tsushima Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_campaign_modal_decay_estimate\",\r\n      \"width_metric\": \"coast_to_modal_decay_threshold_distance\",\r\n      \"approximate_width_km\": 22,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"reported_modal_estimate_with_unresolved_arithmetic_discrepancy\",\r\n      \"range_interpretation\": \"Reported 22 km; summary approximately 20 km and recalculation 23.0769 km describe the same estimate. They do not define a measured range or numerical uncertainty.\",\r\n      \"geographic_scope\": \"Nearshore branch over the continental shelf off the San’in coast, Japan Sea; not the entire Tsushima Current system.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Offshore y direction approximately northward from the east–west coast in the source model; paired edge coordinates unresolved.\",\r\n      \"layer\": \"First baroclinic mode under summer density stratification; eastward above the seasonal thermocline and westward below. No fixed width slab extracted.\",\r\n      \"time_convention\": \"Finite July–August 1980 campaign. Modal coefficient from the 8 August hydrographic profile; station and current-average durations differ. No homogeneous width occupation interval or recurring seasonal calendar assigned.\",\r\n      \"boundary_rule\": \"Offshore modal amplitude exp(-gamma_1*y), relative to its coastal value; adopted exp(-3) decay criterion (approximately 5%). Printed gamma_1=1.3e-4 m^-1.\",\r\n      \"source_url\": \"https://www.jstage.jst.go.jp/article/kaiyou1942/46/4/46_4_156/_pdf\",\r\n      \"source_citation\": \"Matsuyama, M. (1990), The Structure of the Nearshore Branch of the Tsushima Current on the Shelf off the San’in Coast in Summer, Journal of the Oceanographical Society of Japan 46(4):156–166, doi:10.1007/BF02125576.\",\r\n      \"source_locator\": \"Printed p165 / PDF page 10, Discussion decay equation and Summary(1); eigenvalue and fit method p161 / PDF page 6; station dates p158 and common average p159; separate Fig10 p164.\",\r\n      \"source_retrieved_date\": \"2026-10-08\",\r\n      \"source_evidence_kind\": \"published_original_campaign_modal_diagnosis\",\r\n      \"extraction_method\": \"Manual original equation and context transcription with visual verification; independently calculate printed arithmetic, without digitizing current boundaries.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"1980 coastal-branch modal estimate\",\r\n      \"phase_kind\": \"campaign_modal_decay_width\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Reported 22 km disagrees with 3/(1.3e-4) m = 23.0769 km; cause unresolved. Approximately 20 km is a summary of the same estimate. Fig10 caption 134°E conflicts with Discussion 132°E; the climatological section is separate support. Printed Eq8 plus sign is inconsistent with the stated exponential solution for real positive gamma; no correction inferred.\",\r\n      \"remaining_gates\": [\r\n        \"Resolve source differential-equation sign and arithmetic discrepancies; independent scientific admission.\",\r\n        \"Extract geographically located compatible boundaries and uncertainty.\",\r\n        \"Acquire repeat occupations before seasonal ranges or playback.\"\r\n      ],\r\n      \"modal_decay_context\": {\r\n        \"normalized_amplitude_equation\": \"Y(y)/Y(0)=exp(-gamma_1*y)\",\r\n        \"coastal_reference_amplitude\": 1,\r\n        \"printed_gamma_per_m\": 0.00013,\r\n        \"edge_exponent\": 3,\r\n        \"edge_relative_amplitude\": 0.049787068367863944,\r\n        \"source_rounded_relative_amplitude\": 0.05,\r\n        \"source_reported_width_km\": 22,\r\n        \"source_summary_width_km_approx\": 20,\r\n        \"recalculated_width_km\": 23.076923076923077,\r\n        \"arithmetic_discrepancy_unresolved\": true,\r\n        \"summary_is_independent_measurement\": false,\r\n        \"discrepancy_is_uncertainty_interval\": false,\r\n        \"coefficient_method\": \"Separation constant of density-profile eigenvalue problem (Eq7 with boundary conditions); least-squares fits current data to computed mode shapes, not an offshore velocity-coefficient fit.\",\r\n        \"model_assumptions\": [\r\n          \"Hydrostatic and Boussinesq approximations\",\r\n          \"Flat bottom and rigid lid\",\r\n          \"Zero initial potential vorticity; coast-relative exponential offshore mode\"\r\n        ],\r\n        \"fitted_current_modes\": [\r\n          \"barotropic\",\r\n          \"first_baroclinic\"\r\n        ],\r\n        \"campaign_context\": {\r\n          \"start\": \"1980-07-26\",\r\n          \"end\": \"1980-08-25\",\r\n          \"is_homogeneous_width_observation_period\": false\r\n        },\r\n        \"station_support\": [\r\n          {\r\n            \"station\": \"A\",\r\n            \"start\": \"1980-07-26\",\r\n            \"end\": \"1980-08-25\",\r\n            \"source_reported_days\": 31\r\n          },\r\n          {\r\n            \"station\": \"B\",\r\n            \"start\": \"1980-07-26\",\r\n            \"end\": \"1980-08-25\",\r\n            \"source_reported_days\": 31\r\n          },\r\n          {\r\n            \"station\": \"C\",\r\n            \"start\": \"1980-07-26\",\r\n            \"end\": \"1980-08-14\",\r\n            \"source_reported_days\": 19\r\n          },\r\n          {\r\n            \"station\": \"D\",\r\n            \"start\": \"1980-07-26\",\r\n            \"end\": \"1980-08-14\",\r\n            \"source_reported_days\": 19\r\n          },\r\n          {\r\n            \"station\": \"E\",\r\n            \"start\": \"1980-07-26\",\r\n            \"end\": \"1980-08-14\",\r\n            \"source_reported_days\": 19\r\n          }\r\n        ],\r\n        \"common_current_mean_period\": {\r\n          \"start\": \"1980-07-26\",\r\n          \"end\": \"1980-08-14\",\r\n          \"source_locator\": \"Printed p159, section4: common period for five-station time averages.\"\r\n        },\r\n        \"station_B_modal_mean_period\": {\r\n          \"start\": \"1980-07-26\",\r\n          \"end\": \"1980-08-25\",\r\n          \"source_locator\": \"Printed p162, Figure8 discussion: entire B record.\"\r\n        },\r\n        \"hydrographic_profile_support\": {\r\n          \"station\": \"H\",\r\n          \"date\": \"1980-08-08\",\r\n          \"latitude_degrees_north\": 36.15,\r\n          \"longitude_degrees_east\": 134.13333333333333,\r\n          \"role\": \"Density profile input for computed vertical modes; not a current edge.\"\r\n        },\r\n        \"instrument_context\": {\r\n          \"surface_offset_m\": 10,\r\n          \"bottom_offset_m\": 10,\r\n          \"sampling_interval_minutes\": 10,\r\n          \"is_fixed_width_layer\": false\r\n        },\r\n        \"shelf_context\": {\r\n          \"coast_to_200m_isobath_km\": [\r\n            15,\r\n            20\r\n          ],\r\n          \"is_width_range\": false\r\n        },\r\n        \"separate_hydrographic_climatology\": {\r\n          \"start_year\": 1964,\r\n          \"end_year\": 1985,\r\n          \"calendar_months\": [\r\n            7,\r\n            8,\r\n            9\r\n          ],\r\n          \"caption_longitude_degrees_east\": 134,\r\n          \"discussion_longitude_degrees_east\": 132,\r\n          \"longitude_conflict\": true,\r\n          \"is_1980_width_support\": false\r\n        },\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"summer_campaign_is_recurring_calendar\": false,\r\n        \"display_caption\": \"Coastal branch · reported modal width 22 km (summer 1980). Diagram illustrates the published exponential expression; its differential-equation sign remains unresolved. No mapped edge or seasonal range.\",\r\n        \"display_method_note\": \"The source adopts roughly 5% of coastal amplitude as the edge. Its printed coefficient gives 23.1 km; the paper reports 22 km and summarizes about 20 km. Arithmetic discrepancy unresolved; numerical uncertainty unknown.\",\r\n        \"offshore_equation_consistency\": {\r\n          \"source_locator\": \"Printed p161 / PDF page 6, Eq8 and following solution statement; original visually verified.\",\r\n          \"printed_equation\": \"d2Y_n/dy2+gamma_n^2*Y_n=0\",\r\n          \"stated_solution\": \"Y_n~exp(-gamma_n*y)\",\r\n          \"finding_class\": \"editorial_mathematical_consistency_check_not_author_correction\",\r\n          \"inconsistent_for_real_positive_gamma\": true,\r\n          \"sign_resolution\": null,\r\n          \"diagram_validates_printed_differential_equation\": false\r\n        },\r\n        \"audit_file\": \"research/tsushima-matsuyama-1990-modal-width-scope-audit.json\",\r\n        \"audit_sha256\": \"587cccbd45b3673137523241a2bbab07f3ee681e8f5549a7b44f0ae6ced90fb6\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"west-australian-glenn-2008-offshore-breadth-constraint\",\r\n      \"current_id\": \"west-australian\",\r\n      \"name\": \"West Australian Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": null,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"government_reported_greater_than_offshore_breadth\",\r\n      \"range_interpretation\": \"Reported offshore geographic breadth exceeds 1000 km in this synthesis. No representative width, finite upper end, statistical uncertainty, annual range or velocity-core boundaries extracted.\",\r\n      \"geographic_scope\": \"Broad equatorward surface flow offshore of Leeuwin in the southeastern Indian Ocean; no reproducible cross-flow transect or paired endpoints supplied.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Offshore geographic breadth in government synthesis, not a defined transverse velocity section.\",\r\n      \"layer\": \"Source describes equatorward surface current as shallow; no fixed numerical depth layer supplied for the breadth.\",\r\n      \"time_convention\": \"Undated geographic synthesis published 2008; publication year and adjacent summer inflow discussion do not date or season the breadth statement.\",\r\n      \"boundary_rule\": \"Issuer-reported greater-than geographic breadth. No velocity threshold, core edges, finite outer limit or section orientation extracted.\",\r\n      \"source_url\": \"https://www.ga.gov.au/bigobj/GA13412.pdf\",\r\n      \"source_citation\": \"Glenn, Nichol, Pattiaratchi, Daniell, Anderson, Borissova, Heap, Griffin and Fellows (2008), Vlaming Sub-Basin and Mentelle Basin: Environmental Summary, Geoscience Australia Record 2008/20, GeoCat 66577.\",\r\n      \"source_locator\": \"Section 6.3.5, printed pp71-72 / PDF pp87-88, offshore WAC paragraph; Figure 6.15 printed p66 / PDF p82 is schematic; copyright printed pii / PDF p3.\",\r\n      \"source_retrieved_date\": \"2026-10-09\",\r\n      \"source_evidence_kind\": \"government_geographic_synthesis_constraint_citing_prior_review\",\r\n      \"extraction_method\": \"Inequality transcribed from visually inspected original report prose. No contour digitization, current-axis diagnosis or conversion from the printed coordinate phrase.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Reported offshore geographic breadth\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Government environmental synthesis, not a primary width-section analysis. The report cites Schott and McCreary (2001); identical named-current numeric wording was not found in inspected review text. Printed latitude 60 E mixes coordinate type and hemisphere notation.\",\r\n      \"remaining_gates\": [\r\n        \"Recover the underlying velocity-based breadth definition and compatible layer/time support.\",\r\n        \"Resolve the printed coordinate-type conflict independently of the source inequality.\",\r\n        \"Review historical narrow-stream versus offshore-current naming without pooling dimensions.\",\r\n        \"Obtain repeated comparable sections before annual width ranges or map geometry.\",\r\n        \"Independent scientific and canonical admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"width_passage_visually_inspected\": true,\r\n        \"source_class\": \"government_environmental_synthesis\",\r\n        \"quantity_scope\": \"offshore_geographic_breadth_not_velocity_core_width\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"reference_scale_is_point_width\": false,\r\n        \"notation_is_rigorous_lower_bound\": false,\r\n        \"finite_upper_width_extracted\": false,\r\n        \"span_is_annual_range\": false,\r\n        \"publication_year_is_width_occupation\": false,\r\n        \"adjacent_summer_inflow_is_breadth_support\": false,\r\n        \"schematic_is_velocity_axis\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"coordinate_conflict\": {\r\n          \"source_phrase\": \"latitude 60 E\",\r\n          \"coordinate_type_agrees_with_hemisphere_notation\": false,\r\n          \"coordinate_repaired\": false,\r\n          \"used_for_kilometre_conversion\": false\r\n        },\r\n        \"historical_stream_context\": {\r\n          \"source_citation\": \"Andrews (1977), doi:10.1016/0146-6291(77)90517-3\",\r\n          \"source_access\": \"Publisher-indexed abstract; original full article remains unreviewed.\",\r\n          \"reported_width_km\": [\r\n            100,\r\n            200\r\n          ],\r\n          \"scope\": \"Narrow cyclonic stream with poleward coastal turn, distinct source convention from broad offshore equatorward flow.\",\r\n          \"is_range_endpoint_for_this_record\": false,\r\n          \"is_seasonal_width_extrema\": false\r\n        },\r\n        \"protocol_file\": \"plans/west-australian-breadth-constraint-protocol-v1.md\",\r\n        \"protocol_sha256\": \"c180fd59c91f61b0b835bf0739cc9a8cc8db0c8a52654832ca46bb466393cdbc\",\r\n        \"display_caption\": \"West Australian Current: report describes offshore geographic breadth >1000 km. Not a measured 1000 km point, finite width interval, statistical bound or seasonal range.\",\r\n        \"display_method_note\": \"Government synthesis, not a defined velocity section. The latitude 60 E coordinate phrase is inconsistent and is not converted to kilometres. Figure 6.15 is schematic; older 100-200 km cyclonic-stream width is separate naming context. No mapped band or seasonal playback inferred.\",\r\n        \"audit_file\": \"research/west-australian-glenn-2008-breadth-scope-audit.json\",\r\n        \"audit_sha256\": \"cae64ac5000db69c62c1c8d7bb2b1785c28a7dcd3ddec7cd9277caac27b6851e\"\r\n      },\r\n      \"reported_width_constraint\": {\r\n        \"kind\": \"issuer_reported_greater_than_geographic_breadth\",\r\n        \"reference_scale_km\": 1000,\r\n        \"source_notation\": \">1000 km\",\r\n        \"is_rigorous_lower_bound\": false,\r\n        \"representative_width_km\": null,\r\n        \"upper_bound_km\": null,\r\n        \"numerical_uncertainty_km\": null\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"humboldt-fuenzalida-2008-core-width\",\r\n      \"current_id\": \"peru-humboldt\",\r\n      \"name\": \"Peru (Humboldt) Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": 250,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"approximate_regional_point_no_reported_interval\",\r\n      \"range_interpretation\": \"One reported description with its own scope. No 250-350 km or 250-800 km range, representative whole-current width, uncertainty, confidence interval or annual extrema inferred.\",\r\n      \"geographic_scope\": \"Core described in seasonal surface-geostrophic fields; numerical summer and winter widths are not separately supplied.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Regional prose description; no exact transverse section endpoints recovered.\",\r\n      \"layer\": \"Sea-surface geostrophic flow; hydrographic reference pressure is not a current-width depth slab.\",\r\n      \"time_convention\": \"Study surface-geostrophic fields: 1993-2005 excluding July 1997-June 1998. No dated width occupations or numeric seasonal width samples extracted.\",\r\n      \"boundary_rule\": \"Author-reported descriptive width; paired velocity edges and reproducible cutoff unresolved.\",\r\n      \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004684\",\r\n      \"source_citation\": \"Fuenzalida et al. (2008), Satellite altimetry data reveal jet-like dynamics of the Humboldt Current, JGR 113 C07043, doi:10.1029/2007JC004684.\",\r\n      \"source_locator\": \"Section 3.3 paragraph 23\",\r\n      \"source_retrieved_date\": \"2026-10-09\",\r\n      \"source_evidence_kind\": \"primary_publisher_html_regional_width_description\",\r\n      \"extraction_method\": \"Reported regional width transcribed from primary publisher HTML prose. No PDF, figure or velocity-boundary digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Seasonal-climatology core description\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Primary HTML text inspected; publisher PDF returned HTTP 403 and figures remain uninspected. Core 250 km versus summary jet about 350 km remains unresolved; coarse 800 km mean-flow band is separate support.\",\r\n      \"remaining_gates\": [\r\n        \"Recover original figures and raw fields for reproducible paired boundaries.\",\r\n        \"Resolve core/jet relationship without selecting a preferred value.\",\r\n        \"Obtain compatible numeric seasonal widths and independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"source_access\": \"primary_publisher_html_text_only\",\r\n        \"description_kind\": \"core\",\r\n        \"study_operator\": \"surface_geostrophic_velocity_from_filtered_msla_plus_cmdt\",\r\n        \"study_
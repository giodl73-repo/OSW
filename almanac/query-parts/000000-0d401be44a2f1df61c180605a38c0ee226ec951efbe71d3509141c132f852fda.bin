=current%3Aantilles\",\r\n      \"route_url\": \"reference-routes.html#antilles-northern-bahamas-reference-path-candidate\",\r\n      \"season_url\": \"seasons.html?current=antilles\"\r\n    },\r\n    {\r\n      \"id\": \"current:atlantic-equatorial-undercurrent\",\r\n      \"label\": \"Atlantic Equatorial Undercurrent\",\r\n      \"type\": \"named_current\",\r\n      \"identity_level\": \"current\",\r\n      \"source_kind\": \"eastward subsurface jet\",\r\n      \"setting\": \"equatorial\",\r\n      \"time_behavior\": \"persistent_variable\",\r\n      \"basin\": \"Equatorial Atlantic\",\r\n      \"capabilities\": {\r\n        \"observed_velocity\": 0,\r\n        \"radius_evidence\": 0,\r\n        \"reported_length\": 0,\r\n        \"reference_route\": 1,\r\n        \"scoped_width\": 1,\r\n        \"geometry\": 0,\r\n        \"time_samples\": 0,\r\n        \"source_connectivity\": 0,\r\n        \"scope_notes\": 1,\r\n        \"dated_diagnostics\": 0,\r\n        \"flow_network\": 0,\r\n        \"passage_transport\": 0\r\n      },\r\n      \"recorded_claims\": 56,\r\n      \"nasa_links\": 1,\r\n      \"fingerprint\": \"2f95ebe88c733ab7888968fd9fec61f01b1cbb7c9cea20ed0e123b2f7f447a14\",\r\n      \"series\": [],\r\n      \"section_fingerprints\": {\r\n        \"identity\": \"f2661ed822a26e78ea5dfcfd8e0255c9a406465bc6cc707f24130c6e7aa374cc\",\r\n        \"sources\": \"27fd05685f1a6301ae279f9a1965a57c22fb4d27ee072bb1ef7b459dd14a9f4d\",\r\n        \"claims\": \"4596239c4e29e2d0b46d205abb05fd8392ee7ce52f393f4996d3ece6eaada5fd\",\r\n        \"measurements\": \"241dcef3385d519294fa381e12344a82c4bcfbc729fbcc2fd8383e9db4e9a0d8\",\r\n        \"routes_geometry\": \"e18d10a5faa8e1ec89922679e2bcab3c71fc119d7db08fd8c08f88cf096d15b9\",\r\n        \"media\": \"b0556ffd93050ce3fe0c15f1c37557d6ce7226a81eef07d525173db45eb012ef\",\r\n        \"time_evidence\": \"1fd6d5c3c545ddcde87436270b31ac578eb5a8ba5a0025600b7e7dd441b0ce4a\"\r\n      },\r\n      \"latest_observation_date\": null,\r\n  
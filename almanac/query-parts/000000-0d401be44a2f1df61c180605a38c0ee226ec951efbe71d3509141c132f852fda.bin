rce-data/natural-earth-land-10m-5.1.1/ne_10m_land.zip\": \"e547d749445eaa0964aba76738090ec88f5e63c4585122170f98c67a7ea922dc\",\n    \"research/source-data/natural-earth-land-10m-5.1.1/acquisition.json\": \"4de004f15c27c98658e9f11d02a8f958261282889606b1a669c4a6ee63cd6089\",\n    \"requirements-geography.txt\": \"ce3628224554b251eca3be64c9c26042262bc9bec2ac3f958681727858680532\",\n    \"requirements-test.txt\": \"78c44043345533a400e3f1c9ddbedf1f2471b913e3e2eec99cdb6434640dcb04\",\n    \"research/southern-east-madagascar-prose-dimension-admissions.json\": \"c939b93d3cac439cff5b814df203822158d2eec3dad2f6e80985c42a1142b435\",\n    \"almanac/release/v0.1.0/tiles.json\": \"52c6605c32e59f50aa4abde984489c7055c0e3e201e7323e30160a623c9666e0\"\n  },\n  \"figure\": \"figures/southern-east-madagascar-coastal-reference-curve.svg\",\n  \"map_view_box\": [\n    972.6666666667,\n    534,\n    41.1111111111,\n    41.1111111111\n  ],\n  \"figure_aspect_ratio\": 1.2,\n  \"coordinate_selection\": \"Natural Earth coastline, projected offshore offsets and explicit eastern/southern gates. This is reproducible geographic construction, not current-position extraction.\",\n  \"scenario_rule\": \"All27 combinations of10/25/50km projected offset,19.9/20.0/20.1S start and45.2/45.3/45.4E end. No current-width, annual-range or confidence interpretation.\"\n}\n"},"research/west-spitsbergen-reference-path-candidate.json":{"source_sha256":"cd6c83f417d6aa8c73303be20ad3d2472f67769c43141e08e6619ca5b996fdfa","source_json":"{\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"source_license\": \"Source regional geography paraphrased with attribution; no source figures, curves or velocity data packaged.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.05,\r\n    0,\r\n    0.05\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.05,\r\n    0,\r\n    0.05\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-03\",\r\n  \"map_label_size\": 1.6,\r\n  \"legend_line_spacing\": 3,\r\n  \"map_symbol_scale\": 0.5,\r\n  \"remaining_gates\": [\r\n    \"Review southern Barents departure and northern pre-branch naming gates before length admission.\",\r\n    \"Validate the corridor against shelf/slope bathymetry, velocity fields and finer coastlines; coarse land clearance alone is insufficient.\",\r\n    \"Resolve Spitsbergen Atlantic naming and northern branch identities separately; no aliases or branch lengths admitted.\",\r\n    \"Obtain dated geometry and consistent width boundaries before seasonal playback, annual ranges or current-state footprint joins.\",\r\n    \"Canonical admission and publication review.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"west-spitsbergen\",\r\n  \"name\": \"West Spitsbergen Current\",\r\n  \"scope\": \"OSW reference corridor from a selected Barents Sea opening northward-departure approach at 73 N, west of Bear Island and Svalbard, to a selected pre-branching gate near 79.6 N. Excludes upstream Norwegian Atlantic routes, eastward Barents inflow, offshore Front Current feeder, westward recirculation, shelf/fjord intrusions and downstream Svalbard/Yermak/Yermak Pass branches. No whole connected Arctic pathway length.\",\r\n  \"layer\": \"Atlantic-water boundary-flow naming context, with upper-slope and lower-slope components distinguished in source. Menze et al. mapped 20-500 m depth-averaged summer flow near the northern branch region; no depth-specific axis or uniform full-width footprint reconstructed.\",\r\n  \"time_convention\": \"Regional geography from 2018/2019 papers. Northern pathway observations span summers 2014-2017; this selected approach route is not a dated summer track, annual mean axis or seasonal geometry.\",\r\n  \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/10.1002/2017JC013553\",\r\n  \"source_locator\": \"Introduction and Figure 1: Atlantic flow splits between Scandinavia and Svalbard into Barents inflow via Bear Island Trough and northward WSC continuation; shelf/slope components differ.\",\r\n  \"source_citation\": \"Goszczko, Ingvaldsen and Onarheim (2018), Wind-Driven Cross-Shelf Exchange—West Spitsbergen Current as a Source of Heat and Salt for the Adjacent Shelf in Arctic Winters, JGR Oceans, doi:10.1002/2017JC013553.\",\r\n  \"supporting_sources\": [\r\n    {\r\n      \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2018JC014299\",\r\n      \"citation\": \"Menze et al. (2019), Atlantic Water Pathways Along the North-Western Svalbard Shelf Mapped Using Vessel-Mounted Current Profilers, JGR Oceans, doi:10.1029/2018JC014299.\",\r\n      \"locator\": \"Abstract; sections 4.3 and 6: northward boundary flow at 79-80 N / 5-10 E, splitting into Svalbard, Yermak and Yermak Pass branches.\",\r\n      \"role\": \"Northern branch-region context; summer composite does not establish all branches at every time.\"\r\n    },\r\n    {\r\n      \"url\": \"https://os.copernicus.org/articles/22/1003/2026/\",\r\n      \"citation\": \"Dundas and Fer (2026), Atlantic Water flow through Fram Strait to the Arctic Ocean measured by repeated glider transects, Ocean Science 22, 1003-1021.\",\r\n      \"locator\": \"Introduction; sections 2.1-2.2 and code/data availability: separate slope/front branches, 77.25 N target section and limited season coverage.\",\r\n      \"role\": \"Source-specific naming and section/season caveats; transect distances are not current length or width.\"\r\n    }\r\n  ],\r\n  \"coordinate_selection\": \"Every vertex is OSW-selected. Source describes regional bifurcation, not a 73 N exact origin; selected 72.5/73/73.5 N approaches test departure naming. Northern 79.5-79.8 N gates stop within the branch region. Longitudes and bends are editorial; no bathymetric contour, source arrow, velocity field or track digitized.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      15,\r\n      73\r\n    ],\r\n    [\r\n      13.5,\r\n      74\r\n    ],\r\n    [\r\n      12,\r\n      75\r\n    ],\r\n    [\r\n      10,\r\n      76\r\n    ],\r\n    [\r\n      9,\r\n      77\r\n    ],\r\n    [\r\n      8.5,\r\n      78\r\n    ],\r\n    [\r\n      8,\r\n      79\r\n    ],\r\n    [\r\n      7.5,\r\n      79.6\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"shorter_departure_prebranch_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          14.5,\r\n          73.5\r\n        ],\r\n        [\r\n          13.5,\r\n          74\r\n        ],\r\n        [\r\n          12,\r\n          75\r\n        ],\r\n        [\r\n          10,\r\n          76\r\n        ],\r\n        [\r\n          9,\r\n          77\r\n        ],\r\n        [\r\n          8.5,\r\n          78\r\n        ],\r\n        [\r\n          8,\r\n          79\r\n        ],\r\n        [\r\n          7.8,\r\n          79.5\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Shorter selected departure/branch-region convention; not seasonal contraction.\"\r\n    },\r\n    {\r\n      \"id\": \"longer_departure_prebranch_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          15.5,\r\n          72.5\r\n        ],\r\n        [\r\n          13.5,\r\n          74\r\n        ],\r\n        [\r\n          12,\r\n          75\r\n        ],\r\n        [\r\n          10,\r\n          76\r\n        ],\r\n        [\r\n          9,\r\n          77\r\n        ],\r\n        [\r\n          8.5,\r\n          78\r\n        ],\r\n        [\r\n          8,\r\n          79\r\n        ],\r\n        [\r\n          7,\r\n          79.8\r\n        ]\r\n      ],\r\n      \"interpretation\": \"Longer selected departure/branch-region convention; not seasonal extension.\"\r\n    }\r\n  ],\r\n  \"scenario_rule\": \"Three selected Barents departure/northern branch-gate conventions crossed with longitude and independent endpoint latitude offsets -0.05/0/+0.05 degrees: 81 editorial scenarios, not seasonal variation or confidence bounds.\",\r\n  \"map_view_box\": [\r\n    808,\r\n    100,\r\n    110,\r\n    85\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"73 N departure approach\",\r\n    \"79.6 N pre-branch gate\"\r\n  ],\r\n  \"figure_source_label\": \"Goszczko et al. (2018), introduction\",\r\n  \"route_extent_kind\": \"West Spitsbergen approach corridor\",\r\n  \"context_landmarks\": [\r\n    {\r\n      \"label\": \"Spitsbergen\",\r\n      \"coordinates_lon_lat\": [\r\n        16,\r\n        78\r\n      ]\r\n    },\r\n    {\r\n      \"label\": \"Bear Island\",\r\n      \"coordinates_lon_lat\": [\r\n        19,\r\n        74.5\r\n      ]\r\n    }\r\n  ],\r\n  \"input_sha256\": \"bb80463527d097137f678b6d739b436e7b7dd52b1ee88781e813475e753f9fa3\",\r\n  \"generator_file\": \"analysis/build_current_reference_path_candidate.py\",\r\n  \"generator_sha256\": \"1362693ec7075e014d065691923248db455a5c3cd78c9a94880b3b472594d240\",\r\n  \"method\": \"Sum shortest WGS84 geodesic distances between successive OSW editorial vertices; no velocity field or current core is reconstructed.\",\r\n  \"nominal_reference_path_km\": 773.303,\r\n  \"reported_approximate_reference_path_km\": 800,\r\n  \"scenario_range_km\": [\r\n    693.744,\r\n    865.869\r\n  ],\r\n  \"reported_scenario_range_km\": [\r\n    600,\r\n    900\r\n  ],\r\n  \"scenario_count\": 81,\r\n  \"scenarios\": [\r\n    {\r\n      \"route_variant_id\": \"nominal\",\r\n      \"longitude_offset_degrees\": -0.05,\r\n      \"start_latitude_offset_degrees\": -0.05,\r\n      \"end_latitude_offset_degrees\": -0.05,\r\n      \"start_longitude_offset_degrees\": 0,\r\n      \"end_longitude_offset_degrees\": 0,\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          14.95,\r\n          72.95\r\n     
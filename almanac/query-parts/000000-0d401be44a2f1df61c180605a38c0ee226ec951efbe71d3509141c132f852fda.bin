      \"reported_uncertainty_km\": null,\r\n          \"radius_range_km\": null,\r\n          \"geometry\": null,\r\n          \"annual_extrema_eligible\": false,\r\n          \"seasonal_playback_eligible\": false,\r\n          \"footprint_inference_eligible\": false,\r\n          \"diameter_inference_eligible\": false,\r\n          \"area_inference_eligible\": false,\r\n          \"rank_eligible\": false,\r\n          \"evidence_kind\": \"published_altimetric_radius_source_claims_not_canonical\",\r\n          \"source_url\": \"https://www.frontiersin.org/journals/marine-science/articles/10.3389/fmars.2022.958733/full\"\r\n        }\r\n      ],\r\n      \"closed_footprint\": null,\r\n      \"annual_radius_range_km\": null\r\n    }\r\n  },\r\n  \"nasa_individual_identity_claim\": false,\r\n  \"remaining_gates\": [\r\n    \"Resolve original caption/table conflicts before a single radius/date for Eliza February and January slots.\",\r\n    \"Recover dated contour coordinates and boundary convention before occupied footprint or state intersection.\",\r\n    \"Obtain compatible repeats before annual extrema or seasons; independent scientific and canonical admission.\"\r\n  ]\r\n}\r\n"},"research/astrid-2000-radial-scale-scope-audit.json":{"source_sha256":"32fe3f9fa6c6958fdc78dbd1caa0347444d359e7af59b60d8ca42ca54bf4c90f","source_json":"{\n  \"schema\": \"osw.named-eddy-radial-scale-audit.v1\",\n  \"as_of\": \"2026-10-08\",\n  \"status\": \"editorial_original_source_extraction_scientific_review_pending\",\n  \"entity_id\": \"eddy:geography:astrid-2000\",\n  \"source_url\": \"https://www.met.reading.ac.uk/~xv901096/research/Vanaken-2003.pdf\",\n  \"source_citation\": \"van Aken et al. (2003), Observations of a young Agulhas ring, Astrid, during MARE in March 2000, Deep-Sea Research II 50, 167-195, doi:10.1016/S0967-0645(02)00383-1.\",\n  \"source_document_file\": \"research/source-data/van-aken-astrid-2003/journal-article.pdf\",\n  \"source_document_sha256\": \"00f15a476e1584ae8666d3ab5198d4139b4b63da5d2c78ca7ddd179ee3836776\",\n  \"source_document_bytes\": 1136090,\n  \"acquisition_file\": \"research/source-data/van-aken-astrid-2003/acquisition.json\",\n  \"acquisition_sha256\": \"3c113b20f77018314255c7a625758d027b5a3834ad958db37549a683e38c2b29\",\n  \"source_access\": \"Full institutional-hosted original text inspected; original printed pages 190-191 rendered and Table 3 / definition visually inspected. Original retained locally, excluded from Git; no redistribution license established.\",\n  \"measurements\": [\n    {\n      \"id\": \"astrid-2000-maximum-speed-radius\",\n      \"entity_id\": \"eddy:geography:astrid-2000\",\n      \"name\": \"Agulhas Ring Astrid\",\n      \"value_km\": 120,\n      \"metric\": \"radius_of_maximum_tangential_velocity\",\n      \"definition\": \"Radius at maximum tangential velocity, from the source two-layer circularly symmetric ring model. Not an outer eddy boundary.\",\n      \"evidence_kind\": \"published_two_layer_diagnostic_model_scale\",\n      \"study_period_context\": \"March 2000 MARE-1 survey\",\n      \"observed_period\": null,\n      \"calendar_months\": null,\n      \"layer\": \"Two-layer diagnostic model whose thermocline follows the 10 C isotherm; primarily baroclinic component. Lower layer assumed at rest; actual LADCP flow extended to the bottom.\",\n      \"geometry\": null,\n      \"reported_uncertainty_km\": null,\n      \"annual_extrema_eligible\": false,\n      \"seasonal_playback_eligible\": false,\n      \"footprint_inference_eligible\": false,\n      \"diameter_inference_eligible\": false,\n      \"area_inference_eligible\": false,\n      \"source_locator\": \"Table 3, printed p. 191 (PDF page 25), Astrid row and footnotes b / final model note.\"\n    },\n    {\n      \"id\": \"astrid-2000-integration-radius\",\n      \"entity_id\": \"eddy:geography:astrid-2000\",\n      \"name\": \"Agulhas Ring Astrid\",\n      \"value_km\": 140,\n      \"metric\": \"thermocline_relaxation_integration_radius\",\n      \"definition\": \"Chosen integration limit where thermocline depth relaxes to surrounding value; not a mapped observed closed perimeter.\",\n      \"evidence_kind\": \"published_two_layer_diagnostic_model_scale\",\n      \"study_period_context\": \"March 2000 MARE-1 survey\",\n      \"observed_period\": null,\n      \"calendar_months\": null,\n      \"layer\": \"Two-layer diagnostic model whose thermocline follows the 10 C isotherm; primarily baroclinic component. Lower layer assumed at rest; actual LADCP flow extended to the bottom.\",\n      \"geometry\": null,\n      \"reported_uncertainty_km\": null,\n      \"annual_extrema_eligible\": false,\n      \"seasonal_playback_eligible\": false,\n      \"footprint_inference_eligible\": false,\n      \"diameter_inference_eligible\": false,\n      \"area_inference_eligible\": false,\n      \"source_locator\": \"Section 7.2, printed p. 191 (PDF page 25), paragraph immediately preceding Table 3 discussion.\"\n    }\n  ],\n  \"closed_footprint\": null,\n  \"annual_radius_range_km\": null,\n  \"nasa_individual_identity_claim\": false,\n  \"remaining_gates\": [\n    \"Recover dated contour coordinates and source boundary convention before footprint or state intersection.\",\n    \"Obtain compatible repeat observations before an annual range or animated season series.\",\n    \"Independent scientific and canonical admission.\"\n  ]\n}\n"},"research/ocean-current-inventory-expansion-candidates.json":{"source_sha256":"0d0c4b707c70a50494151ca6c2d672eec7711bf7ea273d5f56df6849ee56893c","source_json":"{\r\n  \"schema\": \"osw.current-inventory-expansion-candidates.v1\",\r\n  \"as_of\": \"2026-10-14\",\r\n  \"status\": \"editorial_inventory_candidates_not_canonical\",\r\n  \"scope\": \"Source-backed proposed additions beyond the current 100-name ledger. Not an exhaustive gap census; no canonical counts or published ranking changed.\",\r\n  \"current_ledger_sha256\": \"6c8a143208c0953512875f222154a819d5f56b7326daa6816f0609e61b4f261e\",\r\n  \"entries\": [\r\n    {\r\n      \"proposed_id\": \"mozambique\",\r\n      \"name\": \"Mozambique Current\",\r\n      \"basin\": \"Indian Ocean\",\r\n      \"proposed_kind\": \"intermittent coastal current regime\",\r\n      \"identity_scope\": \"Historically named southward Mozambique Channel boundary flow; continuous shelf-edge episodes must be distinguished from channel eddies and mean throughflow.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"dated_event_or_regional_convention_required\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://journals.sajs.aosis.co.za/index.php/sajs/article/view/428/992\",\r\n          \"citation\": \"Lutjeharms et al. (2012), On the discontinuous nature of the Mozambique Current, South African Journal of Science.\",\r\n          \"locator\": \"Abstract and Results/discussion; MODIS image 13 July 2006, figure 1; NEMO example 7 February 1994, figure 2a.\",\r\n          \"supports\": \"Intermittent continuous episodes; source reports a roughly 1500 km thermal plume in one dated image, not a persistent whole-current length. SST plume is not a measured velocity axis.\"\r\n        },\r\n        {\r\n          \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2008JC004846\",\r\n          \"citation\": \"Harlander et al. (2009), Long-term observations of transport, eddies, and Rossby waves in the Mozambique Channel, doi:10.1029/2008JC004846.\",\r\n          \"locator\": \"Abstract: two-and-a-half-year mooring record.\",\r\n          \"supports\": \"No continuous upper-layer boundary current in this record; episodic eddy-dominated transport. Does not prove continuous flow can never occur.\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review name admission and distinguish intermittent current episodes, channel throughflow, undercurrent and eddy families.\",\r\n        \"Acquire reproducible dated velocity geometry before measuring an event route.\",\r\n        \"Integrate reviewed identity and sources into canonical ledgers, taxonomy, release, atlas and tests.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"west-greenland-coastal\",\r\n      \"name\": \"West Greenland Coastal Current\",\r\n      \"basin\": \"North Atlantic\",\r\n      \"proposed_kind\": \"coastal shelf current\",\r\n      \"identity_scope\": \"Inshore shelf current off southwest/west Greenland, distinct from the offshore shelf-break West Greenland Current. Splits and loses water to shelf-break flow; no full shared route or length assumed.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_shelf_branch_extent_before_route_measurement\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2022JC018404\",\r\n          \"citation\": \"Gou et al. (2022), The Changing Behavior of the West Greenland Current System in a Very High-Resolution Model, doi:10.1029/2022JC018404.\",\r\n          \"locator\": \"Abstract and sections 1.2/3.1: WGCC versus WGC, shelf branches and northward continuation.\",\r\n          \"supports\": \"Separate coastal and shelf-break current identities. The model-derived pathway is not digitized here.\"\r\n        },\r\n        {\r\n          \"url\": \"https://journals.ametsoc.org/view/journals/phoc/53/11/JPO-D-23-0104.1.xml\",\r\n          \"citation\": \"Moored Observations of the West Greenland Coastal Current along the Southwest Greenland Shelf (2023), Journal of Physical Oceanography, doi:10.1175/JPO-D-23-0104.1.\",\r\n          \"locator\": \"Article title and publisher-indexed introduction excerpt; full publisher page returned HTTP 403 during retrieval.\",\r\n          \"supports\": \"Title/indexed excerpt identifies a distinct named coastal current and observational study; no full-current endpoint or numeric extent admitted from this access.\",\r\n          \"source_access\": \"publisher_indexed_excerpt_only_full_page_blocked\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review identity admission and resolve the coastal branches and northern extent.\",\r\n        \"Acquire shelf-appropriate geographic or velocity geometry; avoid reusing the offshore WGC reference route.\",\r\n        \"Integrate reviewed identity and sources into canonical ledgers, taxonomy, release, atlas and tests.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"north-icelandic-irminger\",\r\n      \"name\": \"North Icelandic Irminger Current\",\r\n      \"basin\": \"North Atlantic / Nordic Seas\",\r\n      \"proposed_kind\": \"regional Atlantic-water boundary current\",\r\n      \"identity_scope\": \"Named Atlantic-water current through Denmark Strait toward the north Iceland shelf, distinct from the measured OSW Irminger ridge-flank reference branch. Source-water connections require independent review; not all waters follow one continuous upstream parcel route.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_denmark_strait_and_north_iceland_shelf_gates\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://os.copernicus.org/articles/22/1763/2026/\",\r\n          \"citation\": \"Fried et al. (2026), On the fate of the Irminger Current water and its impact on the convection region in the Irminger Sea - a Lagrangian model study, doi:10.5194/os-22-1763-2026.\",\r\n          \"locator\": \"Section 1 names NIIC through Denmark Strait; discussion notes its source waters may differ from the selected OSNAP IC particle release region.\",\r\n          \"supports\": \"Distinct named current identity and need to avoid equating nomenclature with fixed water-parcel continuity. No complete north-Iceland route or length extracted.\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review identity admission and distinct northern-Iceland extent.\",\r\n        \"Source full regional gates and shelf path without borrowing Irminger ridge-flank geometry.\",\r\n        \"Integrate reviewed identity and sources into canonical ledgers, taxonomy, release, atlas and tests.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"gulf-of-papua\",\r\n      \"name\": \"Gulf of Papua Current\",\r\n      \"basin\": \"Coral Sea / Gulf of Papua\",\r\n      \"proposed_kind\": \"connected western boundary current system\",\r\n      \"identity_scope\": \"SPICE proposed unified name for North Queensland Current, Great Barrier Reef Undercurrent and Hiri south of PNG. Resolve system/member/layer relationships rather than equating every regional name as an interchangeable alias.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_system_member_layer_and_naming_gates\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1002/2013JC009678\",\r\n          \"citation\": \"Ganachaud et al. (2014), The Southwest Pacific Ocean circulation and climate experiment (SPICE), doi:10.1002/2013JC009678.\",\r\n          \"locator\": \"Section 4.1, paragraph beginning An important outcome of SPICE: regional names, GBRUC beneath NQC, unified GPC proposal; next paragraph distinguishes depth-dependent connections.\",\r\n          \"supports\": \"Source supports named identities and a proposed connected-system nomenclature; not identical extents, all-depth parcel continuity or lengths. Full text read 2026-10-03.\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review canonical name admission and system/member/layer relations with Hiri, including narrower and broader naming conventions.\",\r\n        \"Establish source-defined geographic and layer-specific gates before route measurement; do not borrow the broad Hiri route length.\",\r\n        \"Integrate reviewed identity, sources, taxonomy, atlas navigation and release tests.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"north-queensland\",\r\n      \"name\": \"North Queensland Current\",\r\n      \"basin\": \"Coral Sea / Gulf of Papua\",\r\n      \"proposed_kind\": \"regional northward boundary current\",\r\n      \"identity_scope\": \"Northward Australian boundary segment in SPICE nomenclature, distinguished from Hiri south of PNG. Regional continuity does not make its geographic extent or length identical to the whole Gulf of Papua system.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_system_member_layer_and_naming_gates\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1002/2013JC009678\",\r\n          \"citation\": \"Ganachaud et al. (2014), The Southwest Pacific Ocean circulation and climate experiment (SPICE), doi:10.1002/2013JC009678.\",\r\n          \"locator\": \"Section 4.1, paragraph beginning An important outcome of SPICE: regional names, GBRUC beneath NQC, unified GPC proposal; next paragraph distinguishes depth-dependent connections.\",\r\n          \"supports\": \"Source supports named identities and a proposed connected-system nomenclature; not identical extents, all-depth parcel continuity or lengths. Full text read 2026-10-03.\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review canonical name admission and system/member/layer relations with Hiri, including narrower and broader naming conventions.\",\r\n        \"Establish source-defined geographic and layer-specific gates before route measurement; do not borrow the broad Hiri route length.\",\r\n        \"Integrate reviewed identity, sources, taxonomy, atlas navigation and release tests.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"great-barrier-reef-undercurrent\",\r\n      \"name\": \"Great Barrier Reef Undercurrent\",\r\n      \"basin\": \"Coral Sea / Gulf of Papua\",\r\n      \"proposed_kind\": \"subsurface boundary current\",\r\n      \"identity_scope\": \"Deeper boundary current beneath North Queensland Current in SPICE nomenclature. Distinguish layer and extent from upper-ocean Hiri and connected Gulf of Papua system.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_system_member_layer_and_naming_gates\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1002/2013JC009678\",\r\n          \"citation\": \"Ganachaud et al. (2014), The Southwest Pacific Ocean circulation and climate experiment (SPICE), doi:10.1002/2013JC009678.\",\r\n          \"locator\": \"Section 4.1, paragraph beginning An important outcome of SPICE: regional names, GBRUC beneath NQC, unified GPC proposal; next paragraph distinguishes depth-dependent connections.\",\r\n          \"supports\": \"Source supports named identities and a proposed connected-system nomenclature; not identical extents, all-depth parcel continuity or lengths. Full text read 2026-10-03.\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review canonical name admission and system/member/layer relations with Hiri, including narrower and broader naming conventions.\",\r\n        \"Establish source-defined geographic and layer-specific gates before route measurement; do not borrow the broad Hiri route length.\",\r\n        \"Integrate reviewed identity, sources, taxonomy, atlas navigation and release tests.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"guinea-countercurrent\",\r\n      \"name\": \"Guinea Counter Current\",\r\n      \"basin\": \"Gulf of Guinea / tropical Atlantic\",\r\n      \"proposed_kind\": \"coastal westward countercurrent\",\r\n      \"identity_scope\": \"Coastward westward flow above Guinea Under Current, distinct from eastward near-surface Guinea Current in the source section. Full alongshore extent unresolved.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_layer_and_alongshore_extent_before_route_measurement\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://www.frontiersin.org/journals/marine-science/articles/10.3389/fmars.2020.607216/full\",\r\n          \"citation\": \"Alory et al. (2021), Coastal Upwelling Limitation by Onshore Geostrophic Flow in the Gulf of Guinea Around the Niger River Plume, Frontiers in Marine Science 7, 607216, doi:10.3389/fmars.2020.607216. Published 8 January 2021.\",\r\n          \"locator\": \"Results and Discussion, Subsurface Conditions; figure 2C.\",\r\n          \"supports\": \"Distinct named vertical circulation features. Cross-shore section does not establish along-current length. Full text read 2026-10-03.\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review canonical name, spelling, layer and possible aliases.\",\r\n        \"Acquire source-defined alongshore geographic gates and depth-specific geometry; do not borrow Guinea surface route.\",\r\n        \"Integrate reviewed identity, sources, taxonomy, atlas and release tests.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"guinea-undercurrent\",\r\n      \"name\": \"Guinea Under Current\",\r\n      \"basin\": \"Gulf of Guinea / tropical Atlantic\",\r\n      \"proposed_kind\": \"subsurface current\",\r\n      \"identity_scope\": \"Named subsurface current beneath Guinea Counter Current in the source section. This evidence does not establish full extent, uniform direction or a shared surface route.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_layer_and_alongshore_extent_before_route_measurement\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://www.frontiersin.org/journals/marine-science/articles/10.3389/fmars.2020.607216/full\",\r\n          \"citation\": \"Alory et al. (2021), Coastal Upwelling Limitation by Onshore Geostrophic Flow in the Gulf of Guinea Around the Niger River Plume, Frontiers in Marine Science 7, 607216, doi:10.3389/fmars.2020.607216. Published 8 January 2021.\",\r\n          \"locator\": \"Results and Discussion, Subsurface Conditions; figure 2C.\",\r\n          \"supports\": \"Distinct named vertical circulation features. Cross-shore section does not establish along-current length. Full text read 2026-10-03.\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review canonical name, spelling, layer and possible aliases.\",\r\n        \"Acquire source-defined alongshore geographic gates and depth-specific geometry; do not borrow Guinea surface route.\",\r\n        \"Integrate reviewed identity, sources, taxonomy, atlas and release tests.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"tsugaru-warm\",\r\n      \"name\": \"Tsugaru Warm Current\",\r\n      \"basin\": \"Sea of Japan / adjacent seas\",\r\n      \"proposed_kind\": \"regional strait outflow current\",\r\n      \"identity_scope\": \"Named Japan Sea outflow through Tsugaru Strait toward the Pacific. Distinct from Tsushima coastal approach corridor and Soya outflow; no downstream limit or length admitted.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_strait_and_downstream_naming_gates\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://link.springer.com/article/10.1007/s10872-023-00693-6\",\r\n          \"citation\": \"Ohshima and Kuga (2023), 50-year volume transport of the Soya Warm Current estimated from the sea-level difference and its relationship with the Tsushima and Tsugaru Warm Currents, doi:10.1007/s10872-023-00693-6.\",\r\n          \"locator\": \"Section 1, first paragraph and Figure 1 caption.\",\r\n          \"supports\": \"Separately named Japan Sea Throughflow inflow and outflow currents; not interchangeable aliases or one shared current length. Full text read 2026-10-03.\"\r\n        }\r\n      ],\r\n      \"remaining_gates\": [\r\n        \"Review identity admission and strait/downstream boundaries independently of Tsushima naming.\",\r\n        \"Acquire suitable geographic or velocity route geometry; transport series does not supply a length or width.\",\r\n        \"Integrate reviewed identity, sources, taxonomy, release, state joins and atlas navigation.\"\r\n      ]\r\n    },\r\n    {\r\n      \"proposed_id\": \"soya-warm\",\r\n      \"name\": \"Soya Warm Current\",\r\n      \"basin\": \"Sea of Japan / adjacent seas\",\r\n      \"proposed_kind\": \"regional strait outflow current\",\r\n      \"identity_scope\": \"Named Japan Sea outflow through Soya/La Perouse Strait toward the Sea of Okhotsk. Distinct from Tsugaru outflow and Tsushima inflow; no coastal continuation length admitted.\",\r\n      \"inventory_decision\": \"missing_from_current_name_ledger\",\r\n      \"length_decision\": \"resolve_strait_and_downstream_naming_gates\",\r\n      \"whole_current_length_km\": null,\r\n      \"rank_eligible\": false,\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://link.springer.com/a
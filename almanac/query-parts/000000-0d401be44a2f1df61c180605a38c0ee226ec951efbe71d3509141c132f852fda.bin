ion_orientation\": \"Broad geographic band description; no resolved cross-flow transect or paired velocity edges.\",\r\n      \"layer\": \"No fixed depth layer for the broad North Pacific band; adjacent Alaskan Stream upper-kilometer transport context is separate.\",\r\n      \"time_convention\": \"Chapter 8 page version March 2005; no observation dates or width climatology assigned. Preface/version-history September 2002 and first edition 1994 are separate publication context.\",\r\n      \"boundary_rule\": \"Author describes a broad band of eastward flow more than 2000 km wide; paired velocity cutoff and calculation unresolved.\",\r\n      \"source_url\": \"https://ocg.aori.u-tokyo.ac.jp/member/eoka/documents/Tomczak_Godfrey.pdf\",\r\n      \"source_citation\": \"Tomczak, M. and J. S. Godfrey, Regional Oceanography: An Introduction, chapter 8 The Pacific Ocean, printed p125 / PDF p135, page version 1.1 March 2005; original 1994 Pergamon edition, university-hosted online compilation.\",\r\n      \"source_locator\": \"Printed p125 / PDF p135, paragraph beginning No transport estimates, North Pacific passage and alternative Subarctic split discussion; adjacent pp124–126 / PDF pp134–136. PDF pp2,7–9 version/preface/authorship.\",\r\n      \"source_retrieved_date\": \"2026-10-09\",\r\n      \"source_evidence_kind\": \"textbook_original_broad_combined_flow_synthesis\",\r\n      \"extraction_method\": \"More-than qualifier and combined-flow definition transcribed from visually inspected original textbook page; no map or velocity boundary digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Broad combined eastward flow band\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Original textbook page reviewed; underlying breadth measurement/calculation unresolved. Broad combined definition differs from schemes separating North Pacific and Pacific Subarctic currents. Source page is March 2005, not a modern observed-width series.\",\r\n      \"remaining_gates\": [\r\n        \"Recover the breadth method, observation period, layer and paired velocity boundaries.\",\r\n        \"Resolve compatibility of the source combined-flow definition with narrower North Pacific/Subarctic naming conventions.\",\r\n        \"Independent scientific admission; no ranked or seasonal dimension, buffer or physical state intersection.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"width_passage_visually_inspected\": true,\r\n        \"description_kind\": \"broad-combined-eastward-flow-band\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"full_book_reviewed\": false,\r\n        \"page_version\": \"1.1 March 2005\",\r\n        \"preface_history_version\": \"1.2 September 2002\",\r\n        \"publication_version_is_observation_date\": false,\r\n        \"more_than_scale_is_representative_width\": false,\r\n        \"more_than_scale_is_rigorous_bound\": false,\r\n        \"paired_width_boundaries_extracted\": false,\r\n        \"source_band_is_flow_normal_transect\": false,\r\n        \"adjacent_stream_transport_layer_is_width_layer\": false,\r\n        \"adjacent_stream_span_is_north_pacific_width\": false,\r\n        \"alternative_43N_split_is_velocity_boundary\": false,\r\n        \"front_latitudes_are_width_edges\": false,\r\n        \"nearby_SST_image_date_is_width_date\": false,\r\n        \"schematic_map_digitized\": false,\r\n        \"schematic_projection_is_measurement_support\": false,\r\n        \"seasonal_calendar_extracted\": false,\r\n        \"map_buffer_eligible\": false,\r\n        \"cross_current_width_inheritance_eligible\": false,\r\n        \"naming_context\": {\r\n          \"source_definition\": \"Combined eastward flow south of Alaska; Kuroshio and Oyashio continuations treated as the same broad current.\",\r\n          \"alternative_definition\": \"Some authors split North Pacific south of about 43°N and Pacific Subarctic Current north of it. Source questions persistence of this separation across basin.\",\r\n          \"canonical_subarctic_current_id\": \"aleutian\",\r\n          \"naming_audit_file\": \"research/aleutian-alaskan-stream-naming-scope-audit.json\",\r\n          \"naming_audit_sha256\": \"cba7e2ef24c3503ce5f9df057f84721001633db4c9c4d3095a0e9acac052c1fa\",\r\n          \"combined_breadth_transfer_to_subarctic_eligible\": false,\r\n          \"alaskan_stream_is_aleutian_alias\": false,\r\n          \"canonical_names_changed\": false\r\n        },\r\n        \"adjacent_stream_context\": {\r\n          \"identity\": \"alaskan-stream\",\r\n          \"reported_width_span_km\": [\r\n            150,\r\n            200\r\n          ],\r\n          \"transport_layer_context_m\": [\r\n            0,\r\n            1000\r\n          ],\r\n          \"source_citation\": \"Royer and Emery (1987), cited by textbook; original not acquired in this batch.\",\r\n          \"is_north_pacific_width_support\": false\r\n        },\r\n        \"display_constraint_label\": \"Broad eastward flow band\",\r\n        \"display_title\": \"Reported broad flow band\",\r\n        \"display_aria_label\": \"North Pacific Current: source reports a broad combined eastward flow band more than 2000 kilometres wide. Textbook synthesis using a broad combined definition; representative width, paired boundaries, layer, observation dates and numerical uncertainty unknown. No finite or seasonal width range.\",\r\n        \"display_caption\": \"More than 2000 km · broad combined eastward flow band in the textbook’s North Pacific definition. Representative width and numerical uncertainty unknown; no selected 2000 km point, finite interval or annual range.\",\r\n        \"display_method_note\": \"Original PDF p135 inspected, chapter page version March 2005. The source combines Kuroshio/Oyashio continuations and discusses an alternative North Pacific/Subarctic split. Adjacent Alaskan Stream 150–200 km and upper-kilometer transport layer are separate; no width boundaries or seasonal calendar extracted.\",\r\n        \"audit_file\": \"research/north-pacific-tomczak-2005-broad-band-scope-audit.json\",\r\n        \"audit_sha256\": \"09ec3af553122962de08298c120113149d1c822857cd80fb3381fcc15c9e235a\"\r\n      },\r\n      \"reported_width_constraint\": {\r\n        \"kind\": \"author_reported_greater_than_broad_flow_band\",\r\n        \"reference_scale_km\": 2000,\r\n        \"source_notation\": \"more than 2000 km\",\r\n        \"is_rigorous_lower_bound\": false,\r\n        \"representative_width_km\": null,\r\n        \"lower_bound_km\": null,\r\n        \"upper_bound_km\": null\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"acc-park-2019-udintsev-major-front-separation\",\r\n      \"current_id\": \"acc\",\r\n      \"name\": \"Antarctic Circumpolar Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_climatological_major_front_separation\",\r\n      \"approximate_width_km\": 170,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"no_interval_author_approximate_local_climatological_quantity\",\r\n      \"range_interpretation\": \"Approximate local climatological major-front separation; no uncertainty interval, seasonal range or pooled 170-500 km interval.\",\r\n      \"geographic_scope\": \"Udintsev Fracture Zone entrance at 144 degrees W; local meridional contour separation.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Meridional distance between source-defined MDT contours; not a recovered flow-normal transect.\",\r\n      \"layer\": \"Surface geostrophic climatological MDT contour support; no fixed-depth width slab. Hydrographic and bottom-referenced transport layers are separate.\",\r\n      \"time_convention\": \"CNES-CLS18 MDT reference period 1993-2012. Assimilated observations 1993-2016, Argo validation 2001-2017, and cruises February 2016/December 2017 are separate supports; no dated width occupation or monthly widths.\",\r\n      \"boundary_rule\": \"Source-defined SAF to SACCF meridional separation at 144 degrees W, MDT contours [-0.1, -1.0] m; no adopted velocity cutoff.\",\r\n      \"source_url\": \"https://repository.kopri.re.kr/bitstream/201206/10947/1/2019-0214.pdf\",\r\n      \"source_citation\": \"Park, Y.-H. et al. (2019), Observations of the Antarctic Circumpolar Current Over the Udintsev Fracture Zone, the Narrowest Choke Point in the Southern Ocean, JGR Oceans 124, 4511-4528, doi:10.1029/2019JC015024.\",\r\n      \"source_locator\": \"PDF p7 / printed 4517; definitions pp3,5-6 / printed 4513,4515-4516; Figure 5 p8 / printed 4518.\",\r\n      \"source_retrieved_date\": \"2026-10-09\",\r\n      \"source_evidence_kind\": \"original_article_climatological_mdt_contour_description\",\r\n      \"extraction_method\": \"Approximate quantity transcribed from original p4517; selected methods and Figure 5 visually reviewed. No contour-coordinate extraction or recomputation.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Major-front separation · Udintsev\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"u
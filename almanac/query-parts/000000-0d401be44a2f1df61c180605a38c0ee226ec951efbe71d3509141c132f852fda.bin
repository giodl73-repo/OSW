r\n  ],\r\n  \"seasonal_summaries\": [\r\n    {\r\n      \"current_id\": \"northern-mediterranean\",\r\n      \"measurement_ids\": [\r\n        \"northern-mediterranean-winter-width\",\r\n        \"northern-mediterranean-summer-width\"\r\n      ],\r\n      \"reported_seasonal_value_span_km\": [\r\n        25,\r\n        40\r\n      ],\r\n      \"range_kind\": \"span_of_reported_seasonal_typical_values\",\r\n      \"interpretation\": \"Winter about 25 km; summer about 40 km. Span between these published regional seasonal descriptions, not absolute annual extrema, statistical uncertainty or a matched continuous time series.\"\r\n    },\r\n    {\r\n      \"current_id\": \"azores\",\r\n      \"measurement_ids\": [\r\n        \"azores-carracedo-2014-spring-core-width\",\r\n        \"azores-carracedo-2014-autumn-core-width\"\r\n      ],\r\n      \"range_kind\": \"span_of_reported_seasonal_typical_values\",\r\n      \"reported_seasonal_value_span_km\": [\r\n        240,\r\n        400\r\n      ],\r\n      \"scope\": \"Regional WOA09 inverse-model >2 cm/s core. Author-reported model-climatological extremes; whole-current annual physical range unknown.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"interpretation\": \"About 240 km in WOA09 spring (April-June) and 400 km in autumn (October-December). Author-reported regional inverse-model core seasonal extrema; width uncertainty and whole-current annual physical range remain unknown.\"\r\n    }\r\n  ],\r\n  \"protocol_sha256\": \"1d4d577d8f3b422cf3252b973280cb7073bad7e3234bc40a2808bc16bda974bb\",\r\n  \"comparability_notes\": [\r\n    {\r\n      \"current_id\": \"mediterranean-undercurrent\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"The 30 km one-sided ensemble span and 10 km synoptic flow band have different boundaries, methods and sampling support. They are not seasonal phases and do not establish a 10-30 km annual range.\"\r\n    },\r\n    {\r\n      \"current_id\": \"davidson\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"Only an October-March historical California-Oregon summary is available. April-September width and seasonal route geometry remain unknown; missing phases are not zero. No modern annual cycle or width range established.\"\r\n    },\r\n    {\r\n      \"current_id\": \"gaspe\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"10-20 km is one reported typical regional range, not a measured winter/summer pair. No midpoint, confidence interval or annual extrema established.\"\r\n    },\r\n    {\r\n      \"current_id\": \"north-cape\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"2007 Northern-branch Gaussian scale is not a seasonal pair, full paired span, Central-branch width or whole-current width.\"\r\n    },\r\n    {\r\n      \"current_id\": \"atlantic-north-equatorial-undercurrent\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"February 1993 and April 1996 are two separate historical survey months. Each source-reported meridional span converts to about 220 km; they do not establish seasonal states, annual extrema, persistence or an uncertainty range. Exact observation days and boundary threshold remain unresolved.\"\r\n    },\r\n    {\r\n      \"current_id\": \"ligurian\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"The Menton–Nice local profile-band span is about 20 km between 15 and 35 km from coast, using intermittent mixed surface-drifter sampling in 2007/2008. Coast positions are not a width range; no seasonal cycle, full-current width, annual extrema or confidence interval follows. Parent Northern Current seasonal widths remain separate.\"\r\n    },\r\n    {\r\n      \"current_id\": \"east-greenland-coastal\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"One July-August 2004 Cape Farewell section, 30 km at a 15% inner-jet velocity threshold. Campaign months are not a summer climatology; no annual range or whole-current width follows.\"\r\n    },\r\n    {\r\n      \"current_id\": \"indian-south-equatorial-undercurrent\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"169 km is a median across longitudes; 26-294 km is spatial variation of March-May climatological threshold-core extents. Annual length/width ranges and measurement uncertainty remain unavailable. No monthly width or route interpolation supported.\"\r\n    },\r\n    {\r\n      \"current_id\": \"indian-south-equatorial-countercurrent\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"Only December-March editorial surface geography is present. Other season routes, comparable widths and annual extrema remain unresolved; spectral classification latitude domains do not supply current widths.\"\r\n    },\r\n    {\r\n      \"current_id\": \"mauritanian\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"annual_width_range_km\": null,\r\n      \"reason\": \"Only the December–April mean undercurrent width span is recorded. May–July surface-reaching width and other seasons remain unresolved; 30–40 km is not annual variation or instantaneous width uncertainty.\"\r\n    },\r\n    {\r\n      \"current_id\": \"atlantic-south-equatorial-countercurrent\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"annual_width_range_km\": null,\r\n      \"reason\": \"March 1994 described band span is a local, vertically complex section. Other dates, paired depth-specific widths and annual extrema remain unresolved; nearby non-detection is not basin-wide absence.\"\r\n    },\r\n    {\r\n      \"current_id\": \"persian-gulf-saline-overflow\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"Six local salinity-core records combine section locations and occupations; they are not a seasonal sequence. Annual width range and whole-current velocity width remain unavailable.\"\r\n    },\r\n    {\r\n      \"current_id\": \"pacific-north-subsurface-countercurrent\",\r\n      \"reason\": \"General source width summary, shared across northern and main southern Tsuchiya jets; not independent observations or annual extrema. Seasonal playback unsupported.\",\r\n      \"measurement_ids\": [\r\n        \"pacific-north-subsurface-countercurrent-rowe-2000-general-angular-width\"\r\n      ],\r\n      \"seasonal_playback_eligible\": false\r\n    },\r\n    {\r\n      \"current_id\": \"pacific-south-subsurface-countercurrent\",\r\n      \"reason\": \"General source width summary, shared across northern and main southern Tsuchiya jets; not independent observations or annual extrema. Seasonal playback unsupported.\",\r\n      \"measurement_ids\": [\r\n        \"pacific-south-subsurface-countercurrent-rowe-2000-general-angular-width\"\r\n      ],\r\n      \"seasonal_playback_eligible\": false\r\n    },\r\n    {\r\n      \"current_id\": \"east-australian\",\r\n      \"reason\": \"Typical current width of 30 km and strong-influence width of 100 km have unverified, incompatible boundaries; not a 30-100 km seasonal range. Typical 200 m depth extent is not a fixed width measurement layer.\",\r\n      \"measurement_ids\": [\r\n        \"east-australian-imos-typical-regional-width\"\r\n      ],\r\n      \"seasonal_playback_eligible\": false\r\n    },\r\n    {\r\n      \"current_id\": \"leeuwin\",\r\n      \"reason\": \"Only April and September climatological fitted widths extracted at a101; other months unresolved. Values are local means of per-cycle fitted widths, not widths of mean fields, annual extrema or confidence bounds. Seasonal playback remains unavailable.\",\r\n      \"measurement_ids\": [\r\n        \"leeuwin-a101-monthly-fit-04\",\r\n        \"leeuwin-a101-monthly-fit-09\"\r\n      ],\r\n      \"seasonal_playback_eligible\": false\r\n    },\r\n    {\r\n      \"current_id\": \"kuroshio\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"218 km winter and 207 km summer are regional means of weekly diagnosed widths; 210 km is the study-period mean, not a third seasonal state. Spring/autumn values, calendar membership and seasonal map geometry remain unextracted. No 207–218 km physical annual range or full-current width inferred.\"\r\n    },\r\n    {\r\n      \"current_id\": \"agulhas\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"ACT 219 km is an author-reported mean section span for April 2010-February 2013; seasonal width range and uncertainty remain unknown. Other arrays and model widths are not annual limits.\"\r\n    },\r\n    {\r\n      \"current_id\": \"florida\",\r\n      \"seasonal_playback_eligible\": false,\r\n      \"reason\": \"Mean 59 km; observed filtered time-series minimum/maximum 41-76 km across 2005-2006. Standard deviation 6 km and reported mean confidence allowance +/-2 km are separate statistics; confidence percentage is unresolved. These are not per-year or seasonal extrema. A separate chart supplies approximate monthly graph readings; year-specific monthly values, variability bands and geographic boundaries remain unresolved.\"\r\n    }\r\n  ],\r\n  \"derived_width_series_candidates\": [\r\n    {\r\n      \"current_id\": \"gulf-stream-system\",\r\n      \"file\": \"research/gulf-stream-section-width-series.json\",\r\n      \"sha256\": \"0659a4bb43c89369e3732bdddb0ec82ce7f7e4e6c8f1bae5b231420a7c70992b\",\r\n      \"status\": \"derived_width_candidate_requires_scientific_review\"\r\n    },\r\n    {\r\n      \"current_id\": \"pacific-north-equatorial-countercurrent\",\r\n      \"file\": \"research/pacific-necc-oscar-2013-section-diagnostic.json\",\r\n      \"sha256\": \"7b05a062f2303202946f67dfcdd73f754560eb5fe8dbe15b87f8f70f9863aa74\",\r\n      \"status\": \"derived_width_candidate_requires_scientific_review\",\r\n      \"visual_url\": \"necc-section.html\"\r\n    }\r\n  ],\r\n  \"review_assessments\": [\r\n    {\r\n      \"current_id\": \"antilles\",\r\n      \"decision\": \"sources_reviewed_no_comparable_numeric_current_width\",\r\n      \"whole_current_width_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"source_retrieved_date\": \"2026-10-03\",\r\n      \"reason\": \"The fixed 49.4 km coast-to-site-B transport integration domain does not identify instantaneous lateral current boundaries or annual width extrema.\",\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://repository.library.noaa.gov/view/noaa/20909/noaa_20909_DS1.pdf\",\r\n          \"citation\": \"Meinen et al. (2019), doi:10.1029/2018JC014836\",\r\n          \"locator\": \"Table 3 and section 3.1\",\r\n          \"supports\": \"Integration boundary, regional mean-flow structure and variability; no whole-current width admitted.\"\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"current_id\": \"red-sea-saline-overflow\",\r\n      \"decision\": \"sources_reviewed_no_comparable_numeric_current_width\",\r\n      \"whole_current_width_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"source_retrieved_date\": \"2026-10-04\",\r\n      \"reason\": \"The 5 km dimension describes a bathymetric channel. No paired current velocity boundaries extracted from inspected passages. Plume thickness is vertical, not horizontal width.\",\r\n      \"evidence\": [\r\n        {\r\n          \"url\": \"https://www2.whoi.edu/site/bower-lab/wp-content/uploads/sites/12/2018/03/Peters_2005_MixingEntrainment.pdf\",\r\n          \"citation\": \"Peters et al. (2005), doi:10.1175/JPO2679.1\",\r\n          \"locator\": \"Abstract; sections 2, 3a and 5a.\",\r\n          \"supports\": \"Channel description and winter velocity-supported reach; spanwise plume structure left for separate analysis.\"\r\n        }\r\n      ]\r\n    }\r\n  ],\r\n  \"section_span_diagnostics\": [\r\n    {\r\n      \"current_id\": \"indian-south-equatorial-countercurrent\",\r\n      \"status\": \"local_component_section_diagnostic_requires_scientific_review\",\r\n      \"metric\": \"fixed_orientation_half_peak_eastward_component_span\",\r\n      \"whole_current_width_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"width_rank_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"visual_url\": \"query.html?q=%7B%22collection%22%3A%22width_samples%22%2C%22filters%22%3A%5B%7B%22field%22%3A%22current_id%22%2C%22op%22%3A%22eq%22%2C%22value%22%3A%22indian-south-equatorial-countercurrent%22%7D%5D%2C%22sort%22%3A%7B%22field%22%3A%22month%22%2C%22direction%22%3A%22asc%22%7D%2C%22limit%22%3A100%7D#query-chart-section\",\r\n      \"scope_note\": \"Two separate native columns bracket80.5 E. 1995–2016 equal-year calendar-month component climatology; 528 yearly monthly profiles retained. No current identification, physical annual extrema or pooled longitude uncertainty.\",\r\n      \"sources\": [\r\n        {\r\n          \"file\": \"research/indian-secc-80p333e-1995-2016-climatological-component-spans.json\",\r\n          \"sha256\": \"4213a1f5530f6d37714b0c3dd2e878349c8410b6d7dd5c4552a7bd2afbf09051\"\r\n        },\r\n        {\r\n          \"file\": \"research/indian-secc-80p667e-1995-2016-climatological-component-spans.json\",\r\n          \"sha256\": \"f25b5c40e8af6ba40b176280e998130dd399bb6d60822bb7c4d277d2a9cab5d6\"\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"current_id\": \"loop\",\r\n      \"status\": \"local_component_section_diagnostic_requires_scientific_review\",\r\n      \"metric\": \"zonal_half_peak_northward_velocity_section_span\",\r\n      \"whole_current_width_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"width_rank_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"visual_url\": \"query.html?q=%7B%22collection%22%3A%22width_samples%22%2C%22filters%22%3A%5B%7B%22field%22%3A%22current_id%22%2C%22op%22%3A%22eq%22%2C%22valu
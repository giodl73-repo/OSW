 \"name_source_url\": \"https://www.tidesandcurrents.noaa.gov/glossary.html\",\r\n      \"candidate_ids\": [],\r\n      \"reference_path_decision\": \"reference_path_not_constructed\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"regional current\",\r\n      \"route_strategy_id\": \"resolve_naming_scope\",\r\n      \"route_strategy_label\": \"Resolve naming or extent convention\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"No comparable path-length estimate admitted yet.\",\r\n      \"next_action\": \"Resolve source naming and branch extent before route construction; no transfer of neighboring current dimensions. See research/spitsbergen-atlantic-naming-branch-scope-audit.json.\",\r\n      \"strategy_next_action\": \"Read competing definitions, resolve aliases versus distinct flows, and retain source-convention routes without merging their extents.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"tasman-front\",\r\n      \"name\": \"Tasman Front\",\r\n      \"existing_length_evidence_status\": \"no_numeric_length\",\r\n      \"existing_scope\": \"The East Australian Current separates eastward as the Tasman Front at a variable latitude, reported between 28°S and 37°S. The cited study does not give stable whole-front endpoints or an along-flow length; do not add this branch to the East Australian Current's coastal floor. A 2019 review found the front rarely distinct in instantaneous fields; a single stable path length would overstate that evidence.\",\r\n      \"name_source_url\": \"https://doi.org/10.1002/2017JC013097\",\r\n      \"candidate_ids\": [\r\n        \"tasman-historical-connection-reach-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"eastward frontal current downstream of the East Australian Current\",\r\n      \"route_strategy_id\": \"dated_geometry\",\r\n      \"route_strategy_label\": \"Construct dated or regime-specific geometry\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"The East Australian Current separates eastward as the Tasman Front at a variable latitude, reported between 28°S and 37°S. The cited study does not give stable whole-front endpoints or an along-flow length; do not add this branch to the East Australian Current's coastal floor. A 2019 review found the front rarely distinct in instantaneous fields; a single stable path length would overstate that evidence.\",\r\n      \"next_action\": \"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.\",\r\n      \"strategy_next_action\": \"Use dated or explicitly averaged geometry, distinguish an open loop from a closed circuit, and compare repeated regimes before summarizing.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"tsushima\",\r\n      \"name\": \"Tsushima Current\",\r\n      \"existing_length_evidence_status\": \"no_numeric_length\",\r\n      \"existing_scope\": \"A segment of the Kuroshio system in NOAA's glossary.\",\r\n      \"name_source_url\": \"https://www.tidesandcurrents.noaa.gov/glossary.html\",\r\n      \"candidate_ids\": [\r\n        \"tsushima-coastal-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"regional current\",\r\n      \"route_strategy_id\": \"source_gate
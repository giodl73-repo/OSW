n    \"Scientific review of naming limits, layer and regional gate conventions.\",\r\n    \"Verify bathymetric and velocity correspondence; coarse land clearance does not establish a current axis.\",\r\n    \"Canonical admission and publication review; retain regional scope and editorial provenance.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"hiri-current\",\r\n  \"name\": \"Hiri Current\",\r\n  \"scope\": \"Broad Hiri naming convention: northward Australian boundary branch from an OSW 15 S bifurcation approach, clockwise around the Gulf of Papua entrance, to an OSW eastern Louisiade approach. Excludes closed gyre return circuits, direct mid-basin Solomon inflow, EAC, downstream New Guinea currents and eddy excursions. Narrower literature uses Hiri only south of PNG and proposes Gulf of Papua Current for the connected boundary system; no alias merge or complete system extent admitted.\",\r\n  \"layer\": \"Upper-ocean regional geography; no fixed-depth current core or vertically integrated streamline reconstructed. Source northern bifurcation descriptions have different depth support.\",\r\n  \"time_convention\": \"Regional naming convention drawing on 2018 modeled context and 1993 circulation descriptions; not one simultaneous dated field, an annual mean route or seasonal length measurement.\",\r\n  \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2017JC013221\",\r\n  \"source_locator\": \"Section 1 and section 3.1.5: northward branch initiated near 15 S, clockwise Gulf of Papua circulation and depth dependence. Figure 1 separates upper 0-300 m and deeper modeled flows.\",\r\n  \"source_citation\": \"Wijeratne et al. (2018), Estimates of Surface and Subsurface Boundary Current Transport Around Australia, Journal of Geophysical Research: Oceans 123, 3444-3466, doi:10.1029/2017JC013221.\",\r\n  \"coordinate_selection\": \"OSW selects all offshore vertices and the eastern Louisiade gate. Nominal start near 15 S follows Wijeratne; alternative 18 S start follows the broader Oliver and Holbrook regional description. These are source-specific geographic conventions, not equivalent-depth observations or statistical endpoints. The route does not trace a source gyre or transit track.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      146.5,\r\n      -15\r\n    ],\r\n    [\r\n      144.5,\r\n      -13\r\n    ],\r\n    [\r\n      143.5,\r\n      -11\r\n    ],\r\n    [\r\n      143.8,\r\n      -10\r\n    ],\r\n    [\r\n      145,\r\n      -9.8\r\n    ],\r\n    [\r\n      147,\r\n      -10.4\r\n    ],\r\n    [\r\n      149,\r\n      -11.2\r\n    ],\r\n    [\r\n      152,\r\n      -12\r\n    ],\r\n    [\r\n      154,\r\n      -12\r\n    ],\r\n    [\r\n      155,\r\n      -11.5\r\n    ]\r\n  ],\r\n  \"scenario_rule\": \"Two source-specific origin conventions crossed with longitude and independent endpoint latitude offsets: 54 editorial scenarios, not statistical uncertainty.\",\r\n  \"map_view_box\": [\r\n    1345,\r\n    435,\r\n    135,\r\n    125\r\n  ],\r\n  \"endpoint_labels\": [\r\n    \"15 S branch approach\",\r\n    \"Louisiade approach\"\r\n  ],\r\n  \"figure_source_label\": \"Wijeratne (2018); Burrage (1993)\",\r\n  \"route_extent_kind\": \"broad Hiri regional route\",\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"broader_southern_origin\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          149,\r\n          -18\r\n        ],\r\n        [\r\n          148,\r\n          -16\r\n        ],\r\n        [\r\n          146.5,\r\n          -15\r\n        ],\r\n        [\r\n          144.5,\r\n          -13\r\n        ],\r\n        [\r\n          143.5,\r\n          -11\r\n        ],\r\n        [\r\n          143.8,\r\n          -10\r\n        ],\r\n        [\r\n          145,\r\n          -9.8\r\n        ],\r\n        [\r\n          147,\r\n          -10.4\r\n        ],\r\n        [\r\n          149,\r\n          -11.2\r\n        ],\r\n       
\",\r\n      \"zoom\": 0,\r\n      \"nominal_display_route_fraction\": 1.0,\r\n      \"scenario_display_route_fraction_range\": [\r\n        1.0,\r\n        1.0\r\n      ],\r\n      \"complete_display_route_in_all_scenarios\": true,\r\n      \"interpretation\": \"Editorial reference-route/crop display overlap only; not physical current identification or dated event matching. Fraction measures equirectangular display line, not physical kilometres.\"\r\n    },\r\n    {\r\n      \"tile_id\": \"level0_B_1\",\r\n      \"url\": \"https://svs.gsfc.nasa.gov/vis/a000000/a005500/a005505/perpetual_ocean2_EQUIREC_071_final_beauty_level0_B_1.mp4\",\r\n      \"source_id\": \"source:d4e82da0872ed45c\",\r\n      \"zoom\": 0,\r\n      \"nominal_display_route_fraction\": 1.0,\r\n      \"scenario_display_route_fraction_range\": [\r\n        1.0,\r\n        1.0\r\n      ],\r\n      \"complete_display_route_in_all_scenarios\": true,\r\n      \"interpretation\": \"Editorial reference-route/crop display overlap only; not physical current identification or dated event matching. Fraction measures equirectangular display line, not physical kilometres.\"\r\n    }\r\n  ],\r\n  \"nasa_tiles_sha256\": \"52c6605c32e59f50aa4abde984489c7055c0e3e201e7323e30160a623c9666e0\",\r\n  \"recommended_nasa_tile_id\": \"level2_B_3\",\r\n  \"nasa_crop_recommendation_rule\": \"Highest zoom crop covering the entire display route in every retained scenario, with tile ID as deterministic tie-break. No physical identification asserted.\",\r\n  \"input_file\": \"research/atlantic-necc-western-summer-reference-path-input.json\",\r\n  \"figure\": \"figures/atlantic-necc-western-summer-reference-path-candidate.svg\"\r\n}\r\n"},"research/west-greenland-reference-path-candidate.json":{"source_sha256":"5b6ab40d9ffb94513da97e8216fda6f57516f4c7c2f88c4eae9af7351a8e1b59","source_json":"{\r\n  \"status\": \"editorial_reference_path_candidate_not_scientifically_reviewed\",\r\n  \"geometry_role\": \"osw_editorial_reference_route\",\r\n  \"crs\": \"OGC:CRS84\",\r\n  \"source_license\": \"Factual regional geography paraphrased with attribution; no source schematic, velocity field or model axis packaged.\",\r\n  \"longitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"endpoint_latitude_offsets_degrees\": [\r\n    -0.25,\r\n    0,\r\n    0.25\r\n  ],\r\n  \"report_rounding_km\": 100,\r\n  \"rank_eligible_published_estimates\": false,\r\n  \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\r\n  \"whole_system_length\": false,\r\n  \"source_retrieved_date\": \"2026-10-02\",\r\n  \"map_label_size\": 1.8,\r\n  \"legend_line_spacing\": 3,\r\n  \"map_symbol_scale\": 0.65,\r\n  \"remaining_gates\": [\r\n    \"Scientific review of regional naming extent, branch exclusions and endpoint conventions.\",\r\n    \"Compare offshore editorial vertices with reproducible bathymetry and suitable layer-specific current geometry.\",\r\n    \"Canonical admission and publication review; no uniform full-system length inferred.\"\r\n  ],\r\n  \"schema\": \"osw.current-reference-path-input.v1\",\r\n  \"current_id\": \"west-greenland\",\r\n  \"name\": \"West Greenland Current\",\r\n  \"scope\": \"Northward shelf-break West Greenland branch from an OSW Cape Farewell approach gate to an OSW Davis Strait gate near 67 N. Excludes the separate inshore West Greenland Coastal Current, the westward branch joining Labrador Current, shed Irminger Rings, fjords, upstream East Greenland/Irminger paths and continuation beyond the chosen Davis Strait gate. Not the whole bifurcating West Greenland Current system.\",\r\n  \"layer\": \"Shelf-break regional reference geography. Source top-50 m mean model analysis supports pathway convention; no model velocity axis, common depth or 500 m isobath is extracted.\",\r\n  \"time_convention\": \"Regional northward branch convention from Gou et al. (2022), whose model analysis covers 2008-2018. Drawn OSW route is not a measured/model-derived 2008-2018 axis or a simultaneous trajectory.\",\r\n  \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2022JC018404\",\r\n  \"source_locator\": \"Abstract and section 1.1: Cape Farewell to Davis Strait shelf-break WGC distinct from coastal WGCC. Section 3.1: bifurcation near Fylla Bank into westward major branch and narrower northward branch to Davis Strait/Baffin Bay; northward mean route near 500 m isobath.\",\r\n  \"source_citation\": \"Gou et al. (2022), The Changing Behavior of the West Greenland Current System in a Very High-Resolution Model, Journal of Geophysical Research: Oceans, doi:10.1029/2022JC018404.\",\r\n  \"coordinate_selection\": \"OSW selects Cape Farewell approach, shelf-break regional waypoints and Davis gates at 66/67/68 N. No source exact nomenclature endpoint or isobath geometry is digitized. Ending at Davis Strait is a comparison convention and does not assert absence of northward flow beyond it.\",\r\n  \"coordinates_lon_lat\": [\r\n    [\r\n      -45,\r\n      59.4\r\n    ],\r\n    [\r\n      -48,\r\n      60.5\r\n    ],\r\n    [\r\n      -50.5,\r\n      61.5\r\n    ],\r\n    [\r\n      -53,\r\n      63\r\n    ],\r\n    [\r\n      -55,\r\n      65\r\n    ],\r\n    [\r\n      -56,\r\n      67\r\n    ]\r\n  ],\r\n  \"alternative_routes\": [\r\n    {\r\n      \"id\": \"southern_davis_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -45,\r\n          59.4\r\n        ],\r\n        [\r\n          -48,\r\n          60.5\r\n        ],\r\n        [\r\n          -50.5,\r\n          61.5\r\n        ],\r\n        [\r\n          -53,\r\n          63\r\n        ],\r\n        [\r\n          -55,\r\n          65\r\n        ],\r\n        [\r\n          -55.5,\r\n          66\r\n        ]\r\n      ],\r\n      \"interpretation\": \"OSW southern Davis approach gate.\"\r\n    },\r\n    {\r\n      \"id\": \"northern_davis_gate\",\r\n      \"coordinates_lon_lat\": [\r\n        [\r\n          -45,\r\n          59.4\r\n      
.\",\n      \"density_averaging_source_values_kg_m3\": [\n        26.7,\n        27.3\n      ],\n      \"fixed_layer_bounds_m\": null,\n      \"boundary_rule\": \"North/south extent of eastward absolute zonal geostrophic velocity in the source density averaging context.\",\n      \"orientation\": \"meridional section span, not independently diagnosed flow-normal width\",\n      \"observed_period\": null,\n      \"reference_period\": {\n        \"start_month\": \"2009-06\",\n        \"end_month\": \"2014-01\",\n        \"interpretation\": \"Study observation window; extrema dates and annual/seasonal extrema are not supplied.\"\n      },\n      \"calendar_months\": null,\n      \"time_statistic\": \"source_reported_range_across_repeat_sections\",\n      \"extrema_dates\": null,\n      \"source_zero_lower_bound\": false,\n      \"source_file\": \"research/neuc-glider-2015-width-admissions.json\",\n      \"source_pointer\": \"/width_records/0\",\n      \"source_id\": \"source:neuc-schonau-rudnick-2015\",\n      \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/10.1002/2014JC010595\",\n      \"source_locator\": \"Section3.1, paragraphs discussing undercurrent widths after Figure6; Figure6b caption. Abstract and section2 for study support.\",\n      \"whole_current_representative\": false,\n      \"rank_eligible\": false,\n      \"annual_extrema_eligible\": false,\n      \"seasonal_playback_eligible\": false,\n      \"physical_edges_admitted\": false,\n      \"full_width_inference_eligible\": false,\n      \"independent_new_observation\": false\n    },\n    {\n      \"id\": \"neuc-glider-2015-northern-jet-range\",\n      \"current_id\": \"pacific-north-equatorial-undercurrent\",\n      \"name\": \"Pacific North Equatorial Undercurrent\",\n      \"jet\": \"northern\",\n      \"status\": \"editorial_source_extraction_not_historical_release\",\n      \"measurement_type\": \"published_regional_summary\",\n      \"phase_kind\": \"multi_year_jet_width_range\",\n    
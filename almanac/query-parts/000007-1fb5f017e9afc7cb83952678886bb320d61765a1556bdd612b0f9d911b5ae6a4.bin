s\": [\n      -0.1,\n      0,\n      0.1\n    ],\n    \"endpoint_latitude_offsets_degrees\": [\n      -0.1,\n      0,\n      0.1\n    ],\n    \"scenario_rule\": \"All27 predeclared cartographic scenarios: three common longitude shifts and three independent latitude choices at each endpoint. Retain every scenario; no fitted geometry or statistical uncertainty inferred.\",\n    \"report_rounding_km\": 100,\n    \"rank_eligible_published_estimates\": false,\n    \"candidate_comparison_group\": \"osw_approximate_reference_routes\",\n    \"whole_system_length\": false,\n    \"route_extent_kind\": \"southern-branch offshore reference corridor\",\n    \"map_view_box\": [\n      960,\n      495,\n      78,\n      98\n    ],\n    \"map_label_size\": 1.65,\n    \"legend_line_spacing\": 2.8,\n    \"map_symbol_scale\": 0.55,\n    \"endpoint_labels\": [\n      \"20S offshore approach\",\n      \"Cape Sainte Marie offshore approach\"\n    ],\n    \"figure_source_label\": \"Nauw et al.2008, Introduction2/6; OSW vertices\",\n    \"remaining_gates\": [\n      \"Review exact offshore vertices against suitable bathymetry; coarse land clearance is insufficient.\",\n      \"Recover dated layer-specific current axes before claiming a physical route or annual geometry.\",\n      \"Compare the editorial polyline length with the separate published650km report without calibrating either quantity to the other.\",\n      \"Keep downstream branches, undercurrent, rings and SICC distinct; no physical state passage or width envelope inferred.\",\n      \"External scientific route review and canonical geometry admission remain pending.\"\n    ],\n    \"rejected_experiment_files\": [\n      \"plans/southern-east-madagascar-reference-route-protocol-v1.md\",\n      \"research/southern-east-madagascar-reference-route-v1-rejected-input.json\",\n      \"research/southern-east-madagascar-reference-route-v1-rejection.json\"\n    ],\n    \"input_sha256\": \"0659cf6f0bc872a164f3c569083091df26ddb913036eb7d63
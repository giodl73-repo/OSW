an_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Marine Regions supplies one geographic point, not a current boundary or endpoints; no comparable path-length estimate admitted yet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:mindanao-current","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:mindanao-current","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The source describes flow southward along the Philippine Islands and supply to the Indonesian Throughflow, North Equatorial Countercurrent, and Pacific Equatorial Undercurrent. It gives no whole-current alongflow length or fixed endpoint gates.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:new-guinea-coastal-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:new-guinea-coastal-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The source describes northwestward flow along Papua New Guinea and through Vitiaz Strait into the Pacific Equatorial Undercurrent source region. It gives no comparable whole-current centerline length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:new-ireland-coastal-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:new-ireland-coastal-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The source describes flow along New Ireland's eastern coast, with branches joining the New Guinea Coastal Undercurrent or retroflecting toward the Pacific Equatorial Undercurrent. It gives no whole-current length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:solomon-island-coastal-undercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:solomon-island-coastal-undercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The source schematically names this equatorward flow along the Solomon Islands and says it may feed the New Ireland Coastal Undercurrent. Its continuity and whole-current length are unresolved.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:new-guinea-coastal-current","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:new-guinea-coastal-current","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Three years of moorings distinguish this upper-100 m current from the deeper New Guinea Coastal Undercurrent: it flows southeastward in boreal winter and northwestward in boreal summer. The observations do not define a whole-current alongflow length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:pacific-north-subsurface-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:pacific-north-subsurface-countercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"A Pacific section at 140\u00b0W locates this eastward jet near 4\u00b0N and 200 m; the section does not determine its complete alongflow route or length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:pacific-south-subsurface-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:pacific-south-subsurface-countercurrent","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The Pacific 140\u00b0W section resolves two south-side branches near 4.5\u00b0S at 200 m and 7\u00b0S at 250 m. These section positions do not supply a whole-current path length or a single branch-averaged centerline.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:hiri-current","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:hiri-current","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"The literature uses Hiri Current for the northward branch after South Equatorial Current bifurcation off northeast Australia, with variable continuation around the Gulf of Papua. No one fixed path or endpoint pair is admitted for a whole-current length.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:alaska-coastal-gulf","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:alaska-coastal-gulf","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":"source:48b84ff7f08f8e6e","length_source_locator":"Accepted manuscript, PDF page 2, Abstract, lines 25-28 (~1700 km, Seward to Samalga Pass); PDF page 3, Introduction, lines 51-59 defines the regional continuity scope.","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":1700,"published_rank":11,"rank_eligible":true,"scope":"Stabeno et al. (2016) report an approximate 1,700 km coastal system between Seward and Samalga Pass. This is the northern Gulf of Alaska/eastern Aleutian scope, separate from the offshore Alaska Current and Alaskan Stream. It does not cover every coastal flow sharing the Alaska Coastal Current name, including Arctic usage. The paper integrates intermittent observations from 1984-2014; this extent is not a measured simultaneous reference streamline or dated footprint.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:antarctic-slope","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:antarctic-slope","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":"source:c81191f8e01b20c1","length_source_locator":"Section 1.1 ASC Characteristics, first sentence; Figure 2 caption and following paragraph qualify continuity","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":21000,"published_rank":2,"rank_eligible":true,"scope":"Review-reported upper-continental-slope system span; not a measured reference streamline or dated footprint. The Antarctic Peninsula interrupts circumpolar continuity.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:southern-east-madagascar","evidence_status":"published_estimate","id":"length_assessment:southern-east-madagascar","length_source_id":"source:dddb5c5db92e5fe3","length_source_locator":"Introduction paragraph2","lower_bound_km":null,"measurement_admission_file":"research/southern-east-madagascar-prose-dimension-admissions.json","measurement_id":"measurement:southern-east-madagascar:reported-extent","proposed_system_length_km":null,"published_length_km":650,"published_rank":13,"rank_eligible":true,"scope":"Author-reported approximate southern branch extent from about 20\u00b0S to Cap Sainte Marie near 25\u00b030\u2032S. Contextual literature estimate citing Duncan (1970) and Lutjeharms (1988b), not a new April 2001 path measurement. Coordinates, reference axis, fixed layer, reference period and error unspecified.","source_dimension_file":"research/ocean-current-inventory-expansion-candidates.json","source_dimension_proposal_id":"southern-east-madagascar","source_id":"source:dddb5c5db92e5fe3"},{"entity_id":"current:norwegian-atlantic-slope","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:norwegian-atlantic-slope","illustrated_span_km":null,"illustrated_span_rank":null,"length_source_id":"source:nwasc-orvik-skagseth-2003","length_source_locator":"Introduction paragraph[3], eastern NwASC branch description.","lower_bound_km":null,"measurement_admission_file":"research/norwegian-atlantic-slope-working-admission.json","measurement_id":"measurement:norwegian-atlantic-slope:reported-extent","proposed_system_length_km":null,"published_length_km":3500,"published_rank":6,"rank_eligible":true,"scope":"Author-reported approximate3500km eastern shelf-edge branch extent in Orvik and Skagseth (2003). Historical broad branch geography from Shetland toward the Arctic west of Svalbard at80\u00b0N is described in Orvik and Niiler (2001), not an independent length measurement. This broad scope may overlap flow now named West Spitsbergen Current; not an additive component length or a modern regional axis. No fixed layer, reference period, paired endpoint coordinates, error or annual range supplied.","source_id":"source:nwasc-baumann-2026"},{"entity_id":"current:west-india-coastal","evidence_status":"identity_only_dimensions_not_admitted","id":"length_assessment:west-india-coastal","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Separately named current; identity admission supplies no length, width, observed axis or annual envelope.","source_id":"source:indian-coastal-identities-vinayachandran-2021","source_locator":"Sections2.7.1 and2.7.3; printed5989 and5992 / PDF23 and26"},{"entity_id":"current:east-india-coastal","evidence_status":"identity_only_dimensions_not_admitted","id":"length_assessment:east-india-coastal","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Separately named current; identity admission supplies no length, width, observed axis or annual envelope.","source_id":"source:indian-coastal-identities-vinayachandran-2021","source_locator":"Section2.9.1; printed5996 / PDF30"},{"entity_id":"current:east-african-coastal","evidence_status":"identity_only_dimensions_not_admitted","id":"length_assessment:east-african-coastal","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Separately named current; identity admission supplies no length, width, observed axis or annual envelope.","source_id":"source:indian-coastal-identities-vinayachandran-2021","source_locator":"Section2.4.1; printed5983 / PDF17"},{"entity_id":"current:south-java","evidence_status":"identity_only_dimensions_not_admitted","id":"length_assessment:south-java","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Separately named current; identity admission supplies no length, width, observed axis or annual envelope.","source_id":"source:indian-coastal-identities-vinayachandran-2021","source_locator":"Section2.10.3; printed6000 / PDF34"}],"measurements":[{"claim_id":"claim:measurement:0001","entity_id":"current:acc","evidence_status":"published_estimate","id":"measurement:0001","quantity":"reported_length","rank_eligible":true,"scope":"Approximate circumpolar path; source calls it the longest wind-driven current.","source_id":"source:541670cca7b3e8d3","source_locator":"Section 1 Introduction, opening sentence (approximately 25,000 km)","unit":"km","value":25000},{"claim_id":"claim:measurement:0002","entity_id":"current:acc","evidence_status":"source_specific_variant","id":"measurement:0002","quantity":"alternate_reported_length","rank_eligible":false,"scope":"NASA/JPL's 2019 overview says the Antarctic Circumpolar Current spans about 13,000 miles (21,000 km). It does not specify a reference streamline or contour, so this alternate whole-current approximation is retained separately from the ranked 25,000 km research estimate.","source_id":"source:aea8e8e51d3f578f","source_locator":"NASA/JPL article, paragraph beginning The Antarctic Circumpolar Current flows in a loop (13,000 miles / 21,000 km)","unit":"km","value":21000},{"claim_id":"claim:measurement:0003","entity_id":"current:california","evidence_status":"published_estimate","id":"measurement:0003","quantity":"reported_length","rank_eligible":true,"scope":"Approximate California Current System extent from Baja California Sur to northern Vancouver Island; not a measured California Current core axis.","source_id":"source:3144208e2fb35f77","source_locator":"PDF page 3, background box under California Current (California Current System extends 3,000 km)","unit":"km","value":3000},{"claim_id":"claim:measurement:0004","entity_id":"current:gulf-stream","evidence_status":"published_estimate","id":"measurement:0004","quantity":"reported_length","rank_eligible":true,"scope":"Tomczak and Godfrey report approximately 2,500 km for the Gulf Stream proper as an open-ocean free jet downstream of Cape Hatteras toward the Newfoundland Rise/Grand Banks near 50\u00b0W. This excludes the Florida Current and North Atlantic Current; it is a textbook path-scale description, not a measured reference streamline. NOAA's glossary uses the same strict segment definition, while NASA and NOAA Coast Pilot sometimes use Gulf Stream more broadly.","source_id":"source:75c205c85db07281","source_locator":"Chapter 14, The Atlantic Ocean, PDF page 11 (printed page 239), paragraph beginning Recirculation of Gulf Stream water (next 2,500 km Gulf Stream proper)","unit":"km","value":2500},{"claim_id":"claim:measurement:0005","entity_id":"current:gulf-stream","evidence_status":"section_or_sample_only","id":"measurement:0005","quantity":"sampled_alongflow_reach","rank_eligible":false,"scope":"sampled_reach","source_id":"source:227f937c2cf51b0d","source_locator":"PDF page 3, Section 2.1 Underwater Glider Data and Methods, paragraph on 52 missions sampling a roughly 2,000 km Gulf Stream reach","unit":"km","value":2000},{"claim_id":"claim:measurement:0006","entity_id":"current:kuroshio","evidence_status":"published_estimate","id":"measurement:0006","quantity":"reported_length","rank_eligible":true,"scope":"Approximate Kuroshio journey from about 12\u00b0N to 35\u00b0N in the western North Pacific; not a measured whole-current axis, and the Kuroshio Extension is separate.","source_id":"source:a21500fd4390acaf","source_locator":"PDF page 3, Introduction opening paragraph (3,000 km journey from about 12\u00b0N to 35\u00b0N)","unit":"km","value":3000},{"claim_id":"claim:measurement:0007","direct_gate_distance_km":1441.9,"entity_id":"current:agulhas","evidence_status":"derived_lower_bound","gate_type":"source_latitude_span","id":"measurement:0007","method_source_id":"source:c6fba58548d92e28","quantity":"length_lower_bound","rank_eligible":false,"scope":"The research description spans roughly 27\u00b0S\u201340\u00b0S; the coastal path is longer than its north\u2013south separation. Retroflection, leakage, and the eastward Agulhas Return Current are distinct from this boundary-current core. The derived floor is unranked. A 2021 review also describes a roughly 1,000 km coastal segment. That narrower usage conflicts with the broader 27\u00b0S\u201340\u00b0S derived floor, so the two numbers are displayed as source-specific scopes and neither is ranked as a common whole-current length.","source_id":"source:e60490bb3f4df65b","source_locator":"Section The Agulhas Current, opening paragraph (27\u201340\u00b0S); 1,400 km floor is OSW meridional gate geometry","unit":"km","value":1400},{"claim_id":"claim:measurement:0008","entity_id":"current:agulhas","evidence_status":"source_specific_variant","id":"measurement:0008","quantity":"alternate_reported_length","rank_eligible":false,"scope":"Coastal western boundary current along southeastern Africa; narrower than the 27\u00b0S\u201340\u00b0S span used for the existing broad lower bound. End gates and centerline are not specified.","source_id":"source:ef2c46e173e203ae","source_locator":"Section 2.1.1 Background, opening paragraph (1,000 km western boundary current)","unit":"km","value":1000},{"claim_id":"claim:measurement:0009","direct_gate_distance_km":3205.5,"entity_id":"current:agulhas-return","evidence_status":"derived_lower_bound","gate_type":"approximate_source_gate_pair","id":"measurement:0009","method_source_id":"source:c6fba58548d92e28","quantity":"length_lower_bound","rank_eligible":false,"scope":"The hydrographic survey distinguishes the Agulhas Return Current from the Agulhas Current and traces its weakening eastward flow toward the Crozet Basin. This derived distance floor is not a measured streamline, whole-current length, or the length of the westward Agulhas Current.","source_id":"source:0623dc4aeee7fc02","source_locator":"PDF pages 20\u201322, Figure 14 and Section 6 Conclusions, Agulhas Return Current surveyed eastward from 18\u00b0E to 76\u00b0E; 3,000 km floor is OSW gate geometry","unit":"km","value":3000},{"claim_id":"claim:measurement:0010","direct_gate_distance_km":1882.9,"entity_id":"current:east-australian","evidence_status":"derived_lower_bound","gate_type":"source_latitude_span","id":"measurement:0010","method_source_id":"source:c6fba58548d92e28","quantity":"length_lower_bound","rank_eligible":false,"scope":"A derived minimum north\u2013south span for the coherent shelf-break jet only; not a measured streamline or a published whole-current length. Separation and extension shift over time.","source_id":"source:bc07ae7317e29ce9","source_locator":"Section 1 Introduction, opening EAC paragraph (15\u201332\u00b0S); 1,800 km floor is OSW meridional gate geometry","unit":"km","value":1800},{"claim_id":"claim:measurement:0011","entity_id":"current:peru-humboldt","evidence_status":"published_estimate","id":"measurement:0011","quantity":"reported_length","rank_eligible":true,"scope":"Approximate 6,000 km Humboldt Current belt from southern Chile toward northern Peru and the Gal\u00e1pagos, reported in an embedded Purca et al. manuscript in Purca Cuicapusa's 2005 thesis. This is a broad eastern South Pacific current-system extent, not a measured core streamline or the Peru Coastal Current alone; the manuscript separately describes its 1,000 km Peru study area.","source_id":"source:4e2cbe3e50eb054c","source_locator":"PDF page 65, embedded Purca et al. manuscript, Introduction opening paragraph (ca. 6,000 km belt); PDF page 66 distinguishes its 1,000 km Peru study area","unit":"km","value":6000},{"claim_id":"claim:measurement:0012","entity_id":"current:greenland-middle-atlantic-shelf-hypothesis","evidence_status":"proposed_system_length","id":"measurement:0012","quantity":"proposed_system_length","rank_eligible":false,"scope":"A 1989 paper hypothesizes a 5,000 km buoyancy-driven coastal connection from southern Greenland to the Middle Atlantic Bight based on limited oxygen-isotope evidence. This proposed system length is unranked and is not the length of the Labrador Current alone.","source_id":"source:bcde6ef21698b592","source_locator":"Abstract, proposed 5,000 km buoyancy-driven coastal current from southern Greenland to the Middle Atlantic Bight","unit":"km","value":5000},{"claim_id":"claim:measurement:0013","entity_id":"current:azores","evidence_status":"section_or_sample_only","id":"measurement:0013","quantity":"section_cross_stream_width","rank_eligible":false,"scope":"section_observation","source_id":"source:0567b05988a08497","source_locator":"Abstract [1] and Section 4 Discussion and Conclusions [15], October 2009 section at 24.5\u00b0W; each current has 110 km meridional width","unit":"km","value":110},{"claim_id":"claim:measurement:0014","entity_id":"current:azores-countercurrent","evidence_status":"section_or_sample_only","id":"measurement:0014","quantity":"section_cross_stream_width","rank_eligible":false,"scope":"section_observation","source_id":"source:0567b05988a08497","source_locator":"Abstract [1] and Section 4 Discussion and Conclusions [15], October 2009 section at 24.5\u00b0W; each current has 110 km meridional width","unit":"km","value":110},{"claim_id":"claim:measurement:0015","entity_id":"current:florida","evidence_status":"published_estimate","id":"measurement:0015","quantity":"reported_length","rank_eligible":true,"scope":"Tomczak and Godfrey report approximately 1,200 km from the Florida Straits along the coast to separation near Cape Hatteras. This is the Florida Current segment of the Gulf Stream System, not a whole-system length or a measured reference streamline. NOAA's glossary independently names the same segment; NASA and NOAA Coast Pilot sometimes use Gulf Stream more broadly for the Florida Straits flow.","source_id":"source:75c205c85db07281","source_locator":"Chapter 14, The Atlantic Ocean, PDF page 11 (printed page 239), paragraph beginning Recirculation of Gulf Stream water (1,200 km downstream to Cape Hatteras)","unit":"km","value":1200},{"claim_id":"claim:measurement:0016","direct_gate_distance_km":2175.0,"entity_id":"current:east-greenland","evidence_status":"derived_lower_bound","gate_type":"source_latitude_span","id":"measurement:0016","method_source_id":"source:c6fba58548d92e28","quantity":"length_lower_bound","rank_eligible":false,"scope":"The study distinguishes the outer East Greenland Current from the coastal branch and assesses the system between the 78.5\u00b0N Fram Strait section and Cape Farewell. The coast-following route may be longer than the north\u2013south separation; no comparable whole-current centerline length is admitted, so this regional floor is unranked.","source_id":"source:8790d970dd742fd0","source_locator":"Section 2, paragraph defining East Greenland shelf from Fram Strait 78.5\u00b0N to Cape Farewell 59\u00b0N; 2,100 km floor is OSW meridional gate geometry","unit":"km","value":2100},{"claim_id":"claim:measurement:0017","entity_id":"current:east-greenland-coastal","evidence_status":"section_or_sample_only","id":"measurement:0017","quantity":"sampled_alongflow_reach","rank_eligible":false,"scope":"sampled_reach","source_id":"source:04dec95aff3639e3","source_locator":"PDF page 36, Conclusions opening paragraph (current along entire 1,000 km southeast Greenland shelf)","unit":"km","value":1000},{"claim_id":"claim:measurement:0018","direct_gate_distance_km":null,"entity_id":"current:leeuwin","evidence_status":"published_lower_bound","gate_type":null,"id":"measurement:0018","method_source_id":null,"quantity":"length_lower_bound","rank_eligible":false,"scope":"Published lower bound for southward flow along Western Australia's continental shelf, from tropical to cool-temperate coasts; distinct from the northward West Australian Current offshore. A lower bound is not a ranked whole-current estimate.","source_id":"source:a0cafa9c716a91f6","source_locator":"PDF page 108 (viewer page including cover); source states more than 2,000 km","unit":"km","value":2000},{"claim_id":"claim:measurement:0019","entity_id":"current:australian-west-south-boundary-flow","evidence_status":"published_estimate","id":"measurement:0019","quantity":"reported_length","rank_eligible":true,"scope":"Continuous austral-winter shelf-edge flow from North West Cape to southern Tasmania, comprising the Leeuwin, South Australian, and Zeehan currents; not the length of Leeuwin alone.","source_id":"source:5c227482b3435824","source_locator":"Abstract [1] and Section 9 Discussion and Conclusion [53] (5,500 km winter boundary-flow system)","unit":"km","value":5500},{"claim_id":"claim:measurement:0020","entity_id":"current:pacific-equatorial-undercurrent","evidence_status":"published_estimate","id":"measurement:0020","quantity":"reported_length","rank_eligible":true,"scope":"Approximate basin-wide eastward pathway from north of Papua New Guinea to the South American coast described in Grenier et al. (2011). The source's 14,000 km is a broad path estimate, not a traced instantaneous core or the length of the Atlantic or Indian Equatorial Undercurrent. A 0\u00b0N, 140\u00b0W mooring locates the current independently.","source_id":"source:14f30cbbf1cd40e4","source_locator":"Section 1 Introduction, paragraph [2] (14,000 km pathway)","unit":"km","value":14000},{"claim_id":"claim:measurement:0021","entity_id":"current:pacific-equatorial-undercurrent","evidence_status":"source_specific_variant","id":"measurement:0021","quantity":"alternate_reported_length","rank_eligible":false,"scope":"A later wave\u2013current dynamics paper describes the Pacific EUC as traversing the equatorial Pacific over about 13,000 km. It does not define the same exact core or gates as Grenier et al.; retained as a source-specific whole-basin approximation rather than an independent rank.","source_id":"source:0194e5536644376d","source_locator":"Introduction, opening Equatorial Undercurrent description, entire Pacific equatorial length about 13,000 km","unit":"km","value":13000},{"claim_id":"claim:measurement:0022","entity_id":"eddy:geography:lilian-2006","evidence_status":"source_reported","id":"measurement:0022","quantity":"travel_lower_bound","rank_eligible":false,"scope":"source-specific individual eddy","source_id":"source:7e657de5446043ac","source_locator":"PDF page 7, paragraph before Section 4 Conclusions (3.5-year lifetime and journey of more than 5,500 km); Section 3.2 and Figure 1 identify Ring Lilian","unit":"km","value":5500},{"claim_id":"claim:measurement:0023","entity_id":"eddy:geography:lilian-2006","evidence_status":"source_reported","id":"measurement:0023","quantity":"reported_lifetime","rank_eligible":false,"scope":"source-specific individual eddy","source_id":"source:7e657de5446043ac","source_locator":"PDF page 7, paragraph before Section 4 Conclusions (3.5-year lifetime and journey of more than 5,500 km); Section 3.2 and Figure 1 identify Ring Lilian","unit":"years","value":3.5},{"claim_id":"claim:measurement:0024","entity_id":"current:gulf-stream-system","evidence_status":"dated_diagnosed_partial_reach","geometry_id":"geometry:0148","id":"measurement:0024","observation_date":"2026-09-25","quantity":"dated_geostrophic_streamline_reach","rank_eligible":false,"scope":"partial_dated_geostrophic_streamline_reach_not_whole_current_length","source_id":"source:80d0bf24c139328c","source_locator":"NetCDF ugos/vgos[time=0], 2026-09-25 daily field; see pinned subset and integration method","source_snapshot_id":"source:d65455d9259bb212","unit":"km","value":2277.3},{"claim_id":"claim:measurement:0025","direct_gate_distance_km":1218.4,"entity_id":"current:benguela","evidence_status":"derived_lower_bound","gate_type":"source_latitude_span","id":"measurement:0025","method_source_id":"source:c6fba58548d92e28","quantity":"length_lower_bound","rank_eligible":false,"scope":"The study identifies the Benguela Current system at 30\u00b0, 24\u00b0, and 19\u00b0S across decadal inverse solutions, with no continuity north of 19\u00b0S. The current and Benguela ecosystem have different extents. Section observations are from different cruises and do not establish a simultaneous centerline; the derived floor is unranked.","source_id":"source:21f756d2b07063f3","source_locator":"Section 3.1.3 and Figure 5, Benguela Current system at 30\u00b0S, 24\u00b0S, and 19\u00b0S; OSW WGS84 meridional gate calculation","unit":"km","value":1200},{"claim_id":"claim:measurement:0026","direct_gate_distance_km":1218.4,"entity_id":"current:brazil","evidence_status":"derived_lower_bound","gate_type":"source_latitude_span","id":"measurement:0026","method_source_id":"source:c6fba58548d92e28","quantity":"length_lower_bound","rank_eligible":false,"scope":"The study identifies southward Brazil Current transport at 19\u00b0, 24\u00b0, and 30\u00b0S. Confluence location and downstream identity vary. Section observations are from different cruises and do not establish a simultaneous centerline; the derived floor is unranked.","source_id":"source:21f756d2b07063f3","source_locator":"Section 3.1.2 and Figure 5, Brazil Current at 19\u00b0S, 24\u00b0S, and 30\u00b0S; OSW WGS84 meridional gate calculation","unit":"km","value":1200},{"claim_id":"claim:measurement:0027","direct_gate_distance_km":2496.6,"entity_id":"current:deep-western-boundary","evidence_status":"derived_lower_bound","gate_type":"source_latitude_span","id":"measurement:0027","method_source_id":"source:c6fba58548d92e28","quantity":"length_lower_bound","rank_eligible":false,"scope":"The study identifies southward deep western boundary flow at 47\u00b0, 36\u00b0, and 24.5\u00b0N in decadal inverse solutions. This is a North Atlantic segment only; sections from different cruises do not establish one simultaneous continuous path or a whole-Atlantic current length. The derived floor is unranked.","source_id":"source:21f756d2b07063f3","source_locator":"Section 3.2.3 and Figure 8, DWBC at 47\u00b0N, 36\u00b0N, and 24.5\u00b0N; OSW WGS84 meridional gate calculation","unit":"km","value":2400},{"claim_id":"claim:measurement:0028","entity_id":"current:alaska-coastal-gulf","evidence_status":"published_estimate","id":"measurement:0028","quantity":"reported_length","rank_eligible":true,"scope":"Stabeno et al. (2016) report an approximate 1,700 km coastal system between Seward and Samalga Pass. This is the northern Gulf of Alaska/eastern Aleutian scope, separate from the offshore Alaska Current and Alaskan Stream. It does not cover every coastal flow sharing the Alaska Coastal Current name, including Arctic usage. The paper integrates intermittent observations from 1984-2014; this extent is not a measured simultaneous reference streamline or dated footprint.","source_id":"source:48b84ff7f08f8e6e","source_locator":"Accepted manuscript, PDF page 2, Abstract, lines 25-28 (~1700 km, Seward to Samalga Pass); PDF page 3, Introduction, lines 51-59 defines the regional continuity scope.","unit":"km","value":1700},{"claim_id":"claim:measurement:0029","entity_id":"current:antarctic-slope","evidence_status":"published_estimate","id":"measurement:0029","method":"Source review's approximate system-span statement, retained with its Antarctic Peninsula continuity limit; no route digitization or instantaneous path measurement","quantity":"reported_length","rank_eligible":true,"scope":"Review-reported upper-continental-slope system span; not a measured reference streamline or dated footprint. The Antarctic Peninsula interrupts circumpolar continuity.","source_id":"source:c81191f8e01b20c1","source_locator":"Section 1.1 ASC Characteristics, first sentence; Figure 2 caption and following paragraph qualify continuity","unit":"km","value":21000},{"claim_id":"claim:measurement:0030","entity_id":"current:falkland","evidence_status":"published_estimate","id":"measurement:0030","method":"Source-reported conference-abstract loop extent; no centerline digitization, endpoint coordinates, depth-defined length or error interval is supplied","quantity":"reported_length","rank_eligible":true,"scope":"Source-reported approximate 2,000 km northward loop of the northern Antarctic Circumpolar Current branch in the Argentine Basin, from a 2009 EGU conference abstract. No reference centerline, endpoint coordinates, depth-defined length or uncertainty is supplied. Do not interpret this as a measured dated path, a shelf-break front length, or an independently specified Malvinas Return Current extent.","source_id":"source:df04e92fab7c4ca8","source_locator":"Page 1, opening sentence of EGU2009-12242 abstract (2000 km northward loop)","unit":"km","value":2000},{"approximate":true,"claim_id":"claim:measurement:southern-east-madagascar:reported-extent","endpoint_coordinates_lon_lat":null,"entity_id":"current:southern-east-madagascar","evidence_status":"published_estimate","fixed_layer_bounds_m":null,"geometry_id":null,"historical_release_admitted":false,"id":"measurement:southern-east-madagascar:reported-extent","observation_time":null,"quantity":"reported_length","rank_eligible":true,"reference_period":null,"scope":"Author-reported approximate southern branch extent from about 20\u00b0S to Cap Sainte Marie near 25\u00b030\u2032S. Contextual literature estimate citing Duncan (1970) and Lutjeharms (1988b), not a new April 2001 path measurement. Coordinates, reference axis, fixed layer, reference period and error unspecified.","source_id":"source:dddb5c5db92e5fe3","source_locator":"Introduction paragraph2","source_report_type":"contextual_literature_estimate_not_new_cruise_path_measurement","uncertainty_km":null,"unit":"km","value":650},{"annual_length_range_km":null,"claim_id":"claim:measurement:north-atlantic:nominal-section-floor","conditional_on_nominal_gates":true,"direct_gate_distance_km":1224.035663,"endpoint_coordinates_lon_lat":null,"entity_id":"current:north-atlantic","evidence_status":"derived_lower_bound","fixed_layer_bounds_m":null,"gate_type":"source_latitude_span","geometry_id":null,"guaranteed_physical_minimum":false,"historical_release_admitted":false,"id":"measurement:north-atlantic:nominal-section-floor","method_file":"plans/north-atlantic-nominal-gate-bound-protocol-v1.md","method_source_id":"source:north-atlantic-nominal-gate-bound-v1","observation_time":null,"quantity":"length_lower_bound","rank_eligible":false,"scope":"Conditional geographic floor between nominal 47\u00b0N and eastern 58\u00b0N sections identified as North Atlantic Current by Ca\u00ednzos et al. (2023). Station latitudes deviate from nominal sections; the northern section combines western 53\u00b0N and eastern 58\u00b0N portions. Cruises, sampled branches and density layers differ. No simultaneous connected axis, common fixed layer or actual geographic endpoints inferred. Not a whole-current length or guaranteed physical minimum.","source_id":"source:21f756d2b07063f3","source_locator":"Sections 2 and 3.1.10; nominal NAC sections at 47\u00b0N and eastern 58\u00b0N; OSW WGS84 latitude separation","uncertainty_km":null,"unit":"km","value":1200,"whole_current_representative":false},{"annual_length_range_km":null,"approximate":true,"claim_id":"claim:measurement:norwegian-atlantic-slope:reported-extent","endpoint_coordinates_lon_lat":null,"entity_id":"current:norwegian-atlantic-slope","evidence_status":"published_estimate","fixed_layer_bounds_m":null,"geometry_id":null,"historical_release_admitted":false,"id":"measurement:norwegian-atlantic-slope:reported-extent","observation_time":null,"quantity":"reported_length","rank_eligible":true,"reference_period":null,"scope":"Author-reported approximate3500km eastern shelf-edge branch extent in Orvik and Skagseth (2003). Historical broad branch geography from Shetland toward the Arctic west of Svalbard at80\u00b0N is described in Orvik and Niiler (2001), not an independent length measurement. This broad scope may overlap flow now named West Spitsbergen Current; not an additive component length or a modern regional axis. No fixed layer, reference period, paired endpoint coordinates, error or annual range supplied.","source_id":"source:nwasc-orvik-skagseth-2003","source_locator":"Introduction paragraph[3], eastern NwASC branch description.","source_report_type":"contextual_broad_branch_extent_not_new_axis_measurement","supporting_source_ids":["source:nwasc-orvik-niiler-2001-context"],"uncertainty_km":null,"unit":"km","value":3500},{"annual_length_range_km":null,"claim_id":"claim:measurement:labrador:described-latitude-floor","conditional_on_nominal_gates":true,"direct_gate_distance_km":1891.352935,"endpoint_coordinates_lon_lat":null,"entity_id":"current:labrador","evidence_status":"derived_lower_bound","fixed_layer_bounds_m":null,"gate_type":"source_latitude_span","geometry_id":null,"guaranteed_physical_minimum":false,"historical_release_admitted":false,"id":"measurement:labrador:described-latitude-floor","method_file":"plans/labrador-latitude-gate-bound-protocol-v1.md","method_source_id":"source:labrador-latitude-gate-bound-v1","observation_time":null,"quantity":"length_lower_bound","rank_eligible":false,"scope":"Conditional WGS84 geographic floor between described regional latitude gates. Hudson Strait and the tail of Grand Bank delimit a shelf/slope prose description; onshore branches and Flemish Cap bifurcation differ. No dated connected axis, precise geographic endpoints or common fixed layer is established. Not a measured whole-current length or guaranteed physical minimum.","source_id":"source:labrador-thompson-2009-selected-original","source_locator":"Thompson et al. (2009), section4.2 paragraph29, PDF pages6\u20137; regional 43\u201360\u00b0N description","uncertainty_km":null,"unit":"km","value":1800,"whole_current_representative":false},{"allowance_kind":"Editorial graph-reading allowances, not physical errors or confidence intervals.","annual_length_range_km":null,"claim_id":"claim:measurement:ke-qiu-2023:regional-plot-length-range","entity_id":"current:kuroshio-extension","evidence_status":"regional_plot_series","fixed_layer_bounds_m":null,"fractional_year_reading_allowance":0.1,"geographic_centerline":null,"historical_release_admitted":false,"id":"measurement:ke-qiu-2023:regional-plot-length-range","length_reading_allowance_km":50,"method_file":"plans/kuroshio-extension-plot-pathlength-protocol-v4.md","method_source_id":"source:ke-qiu-plot-pathlength-v4","observation_time":null,"quantity":"regional_plotted_length_range","rank_eligible":false,"scientific_report_file":"research/ke-qiu-regional-plot-pathlength-v4.json","scope":"Editorial readings of the published upstream141E\u2013153E pathlength graphic. The graphic range includes retained original knots and bounded cubic graph readings, not extra observations. Approximate graph years have no recovered calendar dates or verified sample cadence. Not a whole-current length, physical annual extrema, seasonal envelope, geographic centerline or width.","series_id":"current_length_series:kuroshio-extension:qiu-2023-figure2a:v4","source_id":"source:ke-qiu-2023-figure2a-original","source_locator":"Qiu, Chen and Oka2023, Figure2a and caption, original PDF page4; sections2 and3.1, PDF page3.","uncertainty_km":null,"unit":"km","value":[1120,4660],"whole_current_representative":false},{"annual_length_range_km":null,"claim_id":"claim:measurement:baffin:described-latitude-floor","conditional_on_nominal_gates":true,"direct_gate_distance_km":1004.206947,"endpoint_coordinates_lon_lat":null,"entity_id":"current:baffin","evidence_status":"derived_lower_bound","fixed_layer_bounds_m":null,"gate_type":"source_latitude_span","geometry_id":null,"guaranteed_physical_minimum":false,"historical_release_admitted":false,"id":"measurement:baffin:described-latitude-floor","length_bound_admission_id":"current_length_bound_admission:baffin:described-latitudes-v1","method_file":"plans/baffin-latitude-gate-bound-protocol-v1.md","method_source_id":"source:baffin-latitude-gate-bound-v1","observation_time":null,"quantity":"length_lower_bound","rank_eligible":false,"scope":"Conditional WGS84 geographic floor between the source-described 67 and 76 degrees N gates. Summer near-surface observations in 1978 and 1979; exact gate dates and common fixed layer unknown. The author extends historical Baffin Current naming north to Lady Ann Strait. No simultaneous connected axis, whole-current length or guaranteed physical minimum established. Lancaster Sound intrusion and meanders are not reconstructed.","source_id":"source:baffin-fissel-1982-length-selected-original","source_locator":"Abstract, printed page 180 / PDF page 1; Results opening paragraph spans the two columns of printed page 183 / PDF page 4.","uncertainty_km":null,"unit":"km","value":1000,"whole_current_representative":false}],"media":[{"entity_id":"current:acc","id":"media:0001","relation":"geographic_crop_navigation_only","source_id":"source:4f7441b953be4651","tile_id":"level2_D_6","url":"https://svs.gsfc.nasa.gov/vis/a000000/a005500/a005505/perpetual_ocean2_EQUIREC_071_final_beauty_level2_D_6.mp4"},{"entity_id":"current:antarctic-coastal","id":"media:0002","relation":"geographic_crop_navigation_only","source_id":"source:4f7441b953be4651","tile_id":"level2_B_7","url":"https://svs.gsfc.nasa.gov/vis/a000000/a005500/a005505/perpetual_ocean2_EQUIREC_071_final_beauty_level2_B_7.mp4"},{"entity_id":"current:california","id":"media:0003","relation":"geographic_crop_navigation_only","source_id":"source:4f7441b953be4651","tile_id":"level2_A_2","url":"https://svs.gsfc.nasa.gov/vis/a000000/a005500/a005505/perpetual_ocean2_EQUIREC_071_final_beauty_level2_A_2.mp4"},{"entity_id":"current:gulf-stream-system","id":"media:0004","relation":"geographic_crop_navigation_only","source_id":"source:4f7441b953be4651","tile_id":"level2_B_3","url":"https://svs.gsfc.nasa.gov/vis/a000000/a005500/a005505/perpetual_ocean2_EQUIREC_071_final_beauty_level2_B_3.mp4"},{"entity_id":"current:gulf-stream","id":"media:0
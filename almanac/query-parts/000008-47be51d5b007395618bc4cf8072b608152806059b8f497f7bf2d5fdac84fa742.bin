ished_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Published lower bound for southward flow along Western Australia's continental shelf, from tropical to cool-temperate coasts; distinct from the northward West Australian Current offshore. A lower bound is not a ranked whole-current estimate.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:australian-west-south-boundary-flow","evidence_status":"published_estimate","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:australian-west-south-boundary-flow","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":"source:5c227482b3435824","length_source_locator":"Abstract [1] and Section 9 Discussion and Conclusion [53] (5,500 km winter boundary-flow system)","lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":5500,"published_rank":5,"rank_eligible":true,"scope":"Continuous austral-winter shelf-edge flow from North West Cape to southern Tasmania, comprising the Leeuwin, South Australian, and Zeehan currents; not the length of Leeuwin alone.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:south-australian","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:south-australian","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Named section from eastern Great Australian Bight to western Bass Strait in the source's winter boundary-flow convention.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:zeehan","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:zeehan","illustrated_span_km":null,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":null,"length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"Named section off western Tasmania in the source's winter boundary-flow convention.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:caribbean","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:caribbean","illustrated_span_km":1675,"illustrated_span_rank":23,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea75135bdc7c41","length_source_id":null,"length_source_locator":null,"lower_bound_km":null,"proposed_system_length_km":null,"published_length_km":null,"published_rank":null,"rank_eligible":false,"scope":"No source-defined whole-current path length admitted yet.","source_id":"source:803229fe82eb2360"},{"entity_id":"current:equatorial-countercurrent","evidence_status":"no_numeric_length","gate_distance_method_source_id":null,"gate_distance_sensitivity":null,"id":"length_assessment:equatorial-countercurrent","illustrated_span_km":4809,"illustrated_span_rank":null,"illustration_ledger_source_id":"source:3e0c99ee52e26d36","illustration_limit":"Drawn map-arrow span, not a physical current length or lower bound","illustration_source_id":"source:1dea7
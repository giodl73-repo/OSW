02d517eaeaeeb84a4b5f1a3e916ecd7944f448135387bd\"\n      },\n      \"latest_observation_date\": null,\n      \"claim_review_counts\": {\n        \"not_individually_reviewed\": 56\n      },\n      \"linked_source_count\": 5,\n      \"map_features\": [\n        {\n          \"geometry\": {\n            \"coordinates\": [\n              8,\n              64\n            ],\n            \"type\": \"Point\"\n          },\n          \"role\": \"editorial_locator\",\n          \"note\": \"Approximate editorial locator points place a name in a recognizable region on the OSW equirectangular map. Points are neither observed cores nor endpoints or length measurements. Multi-basin family names have one point per basin and must be split into separate records before quantitative comparison.\",\n          \"geometry_id\": \"geometry:0061\",\n          \"coordinate_reference_system\": \"OGC:CRS84\",\n          \"positional_uncertainty\": \"not quantified; no observed current core or path\",\n          \"source_id\": \"source:4dc5fc618c26565f\"\n        }\n      ],\n      \"state_evidence\": [],\n      \"connections\": [],\n      \"scope_notes\": [\n        {\n          \"current_id\": \"norwegian\",\n          \"label\": \"Naming convention and Atlantic branch scope\",\n          \"audit_file\": \"research/norwegian-naming-branch-scope-audit.json\",\n          \"summary\": \"NOAA Norwegian Current is a broad northeastward off-Norway naming convention. The modern Norwegian Atlantic Current, with separate slope and front branches, is not automatically this ledger identity or the Norwegian Coastal Current. Name equivalence remains unresolved; whole-current dimensions remain unknown.\",\n          \"related_current_ids\": [\n            \"norwegian-coastal\"\n          ],\n          \"source_url\": \"https://tidesandcurrents.noaa.gov/glossary\",\n          \"source_locator\": \"Norwegian Current, North Atlantic Current and Spitsbergen Atlantic Current entries.\",\n          \"observed_period\": null\n        },\n        {\n          \"current_id\": \"norwegian\",\n          \"label\": \"Measurement object scope: unresolved name\",\n          \"audit_file\": \"research/current-measurement-scopes/norwegian.json\",\n          \"summary\": \"Resolve the source-specific name and branch convention before attaching a width. Related records are not confirmed aliases or members.\",\n          \"source_url\": \"https://tidesandcurrents.noaa.gov/glossary\",\n          \"source_locator\": \"Existing cited current ledger entry and explicit component links; retained source-scope audit research/norwegian-naming-branch-scope-audit.json\",\n          \"observed_period\": null,\n          \"measurement_scope_assessment\": true,\n          \"related_current_ids\": [\n            \"norwegian-coastal\"\n          ],\n          \"related_proposed_current_ids\": []\n        }\n      ],\n      \"evidence_links\": [\n        {\n          \"label\": \"Norwegian Atlantic Slope Current widths · separate identity\",\n          \"url\": \"query.html?q=%7B%22collection%22%3A%22widths%22%2C%22filters%22%3A%5B%7B%22field%22%3A%22current_id%22%2C%22op%22%3A%22eq%22%2C%22value%22%3A%22norwegian-atlantic-slope%22%7D%5D%2C%22limit%22%3A20%7D#query-chart-section\"\n        }\n      ],\n      \"object_url\": \"object.html?id=current%3Anorwegian\",\n      \"route_url\": null,\n      \"season_url\": \"seasons.html?current=norwegian\",\n      \"scope_audits\": [\n        {\n          \"schema\": \"osw.current-source-scope-audit.v1\",\n          \"current_id\": \"norwegian\",\n          \"as_of\": \"2026-10-03\",\n          \"status\": \"editorial_source_scope_audit_not_canonical\",\n          \"source_url\": \"https://tidesandcurrents.noaa.gov/glossary\",\n          \"source_access\": \"Relevant current glossary entries read; not full glossary read.\",\n          \"source_locator\": \"Norwegian Current, North Atlantic Current and Spitsbergen Atlantic Current entries.\",\n          \"supporting_sources\": [\n            {\n              \"url\": \"https://os.copernicus.org/articles/22/17/2026/\",\n              \"citation\": \"Baumann, Skagseth, Ingvaldsen and Mork (2026), Reduced cooling in the Norwegian Atlantic Slope Current: investigating mechanisms of change from 30 years of observations, Ocean Science 22, 17–29, doi:10.5194/os-22-17-2026.\",\n              \"locator\": \"Introduction: two Atlantic branches and northern bifurcation; sections 2.1–2.1.2: sampling/core criteria.\",\n              \"source_access\": \"Relevant introduction and methods read.\",\n              \"source_license\": \"CC BY 4.0\"\n            }\n          ],\n          \"summary\": \"NOAA Norwegian Current is a broad northeastward off-Norway naming convention. The modern Norwegian Atlantic Current, with separate slope and front branches, is not automatically this ledger identity or the Norwegian Coastal Current. Name equivalence remains unresolved; whole-current dimensions remain unknown.\",\n          \"related_current_ids\": [\n            \"norwegian-coastal\"\n          ],\n          \"name_equivalence_admitted\": false,\n          \"whole_current_length_km\": null,\n          \"whole_current_width_km\": null,\n          \"annual_length_range_km\": null,\n          \"annual_width_range_km\": null,\n          \"observed_period\": null,\n          \"route_construction_status\": \"identity_scope_unresolved\",\n          \"remaining_gates\": [\n            \"Resolve naming convention using direct source definitions before transferring route geometry.\",\n            \"Retain distinct salinity, layer, branch and temporal scope.\",\n            \"No numeric dimensions, footprint or seasonal cycle inferred from nearby currents.\"\n          ],\n          \"proposed_identity_ids\": [\n            \"norwegian-atlantic\",\n            \"norwegian-atlantic-slope\",\n            \"norwegian-atlantic-front\"\n          ],\n          \"source_sampling_context\": \"1993–2022 repeated CTD sections plus satellite surface geostrophic reference; not an observation date for the ambiguous Norwegian Current.\",\n          \"source_metric_caveats\": \"Source 50 km heat-budget box width is a modeling choice; 750 km Gimsøy–Bjørnøya path is a segment convention. Neither transferred to the Norwegian Current. Static 50%-mean-transport core differs from a dated full-current width.\"\n        },\n        {\n          \"schema\": \"osw.current-measurement-object-scope.v1\",\n          \"current_id\": \"norwegian\",\n          \"name\": \"Norwegian Current\",\n          \"status\": \"editorial_measurement_scope_assessment_not_physical_taxonomy_admission\",\n          \"scope_kind\": \"unresolved_name\",\n          \"summary\": \"Resolve the source-specific name and branch convention before attaching a width. Related records are not confirmed aliases or members.\",\n          \"members\": [\n            {\n              \"id\": \"norwegian-coastal\",\n              \"label\": \"Norwegian Coastal Current\",\n              \"record_status\": \"released\",\n              \"relationship\": \"related_name_not_equated\",\n              \"scoped_width_record_count\": 1,\n              \"width_values_inherited_by_parent\": false\n            }\n          ],\n          \"source_registry_file\": \"research/current-measurement-object-scope-index.json\",\n          \"basis_object_sha256\": \"854038e0d691b2719599b8a63bee7b1251f7bc7be29d4d6a37d943d9255877b5\",\n          \"generator_file\": \"analysis/build_current_measurement_scopes.py\",\n          \"generator_sha256\": \"1357a690e4780eff266db7e95c1998498df88f1e76fdff570b2676d78528534f\",\n          \"source_url\": \"https://tidesandcurrents.noaa.gov/glossary\",\n          \"source_locator\": \"Existing cited current ledger entry and explicit component links; retained source-scope audit research/norwegian-naming-branch-scope-audit.json\",\n          \"source_access\": \"Existing cited ledger and retained scope evidence re
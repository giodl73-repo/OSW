9\r\n        ],\r\n        \"section_longitude_degrees_east\": null,\r\n        \"section_endpoints_lon_lat\": null,\r\n        \"averaging_period_months\": {\r\n          \"start\": \"1993-01\",\r\n          \"end\": \"2017-12\"\r\n        },\r\n        \"velocity_boundary_m_s\": 0,\r\n        \"averaging_before_boundary_detection\": true,\r\n        \"is_mean_of_instantaneous_widths\": false,\r\n        \"audit_file\": \"research/north-brazil-guiana-oblique-mean-width-scope-audit.json\",\r\n        \"audit_sha256\": \"8deddb91cf6f4ff46710374d9304b6e323a42b38427235d5514a94e23bb1328b\"\r\n      },\r\n      \"source_quality_note\": \"0.25-degree geostrophic product omits ageostrophic contributions. Oblique section span cannot be converted from latitude as if meridional. Source labels NBC3 and names the Guyana continuation north of 10 N. Mapping retained by source convention; no canonical alias merge or fixed physical boundary.\"\r\n    },\r\n    {\r\n      \"id\": \"east-australian-imos-typical-regional-width\",\r\n      \"current_id\": \"east-australian\",\r\n      \"name\": \"East Australian Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_scalar_width_summary\",\r\n      \"width_metric\": \"author_reported_regional_current_scale\",\r\n      \"width_metric_label\": \"typical current; institutional regional prose summary\",\r\n      \"approximate_width_km\": 30,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"No annual extrema or numerical uncertainty interval supplied.\",\r\n      \"geographic_scope\": \"Southern Coral Sea and northern New South Wales boundary-current description; no specific width section or endpoints supplied.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Unspecified in institutional prose; no occupied section extracted.\",\r\n      \"layer\": \"Source describes a typical 200 m depth extent; this does not specify a fixed depth or vertically averaged layer for the 30 km width.\",\r\n      \"time_convention\": \"Undated typical description in a plan dated 25 September 2014 for 2015-25. These are document dates, not width observation dates or a seasonal cycle.\",\r\n      \"boundary_rule\": \"Typical current-width description without paired edges, a speed threshold or a specified occupied section.\",\r\n      \"source_url\": \"https://imos.org.au/wp-content/uploads/2024/07/NSW-IMOS_Node_Plan_2015-25_Final.pdf\",\r\n      \"source_citation\": \"Robertson, Ingleton, Doblin, Suthers and Roughan, NSW-IMOS Node Science and Implementation Plan 2015-25, edited Robin Robertson, dated 25 September 2014, section 3.3.1.\",\r\n      \"source_locator\": \"Section 3.3.1, printed page 23 (PDF page index 22), first paragraph; plan date on printed page 2: 25 September 2014.\",\r\n      \"source_retrieved_date\": \"2026-10-04\",\r\n      \"source_evidence_kind\": \"institutional_science_plan_prose_synthesis\",\r\n      \"extraction_method\": \"Approximate scalar transcribed from institutional PDF text; no figure, influence envelope, array span or route buffer measured.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Typical current width in NSW-IMOS plan\",\r\n      \"phase_kind\": \"regional_scalar_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"regional_scalar_context\": {\r\n        \"audit_file\": \"research/east-australian-imos-regional-width-scope-audit.json\",\r\n        \"audit_sha256\": \"c051be2ee7863179fc447a22a9055f7ff501ed8dcc0ed5f104f390d3343e4b40\",\r\n        \"boundary_coordinates_supplied\": false,\r\n        \"bathymetry_is_measurement_layer\": false,\r\n        \"reported_depth_extent_is_fixed_measurement_layer\": false\r\n      },\r\n      \"remaining_gates\": [\r\n        \"Inspect Mata et al. (2000) and Ridgway and Dunn (2003) for the width convention and support.\",\r\n        \"Recover compatible layer-specific cross-flow sections and observations through seasons.\",\r\n        \"Independent scientific claim admission.\"\r\n      ],\r\n      \"source_quality_note\": \"Underlying width convention remains unverified. CSIRO describes a separate 100 km strong-influence width, which is not combined with the 30 km typical current summary into a seasonal range. The 240 km mooring array and 200 km eddy diameters are different quantities. Institutional PDF text was inspected; screenshot acquisition failed.\"\r\n    },\r\n    {\r\n      \"id\": \"leeuwin-a101-monthly-fit-04\",\r\n      \"current_id\": \"leeuwin\",\r\n      \"name\": \"Leeuwin Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_monthly_mean_fitted_width\",\r\n      \"width_metric\": \"source_fitted_cross_flow_width\",\r\n      \"width_metric_label\": \"a101; mean of source fitted widths\",\r\n      \"approximate_width_km\": 132,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"Two extracted monthly climatological values do not establish a full annual range or a confidence interval.\",\r\n      \"geographic_scope\": \"TOPEX/Poseidon ascending track a101 crossing near 26 S, west of Western Australia. No monthly lateral-edge coordinates extracted.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Source cross-flow width corrected from oblique satellite track using theta=43.45 degrees.\",\r\n      \"layer\": \"Surface geostrophic diagnostic from absolute SSH minus AUSGeoid98. The 80 m layer is a transport assumption, not the width measurement layer.\",\r\n      \"time_convention\": \"Calendar-month composite of per-cycle fitted widths. Section 3.3 says January 1993-July 2002; Fig. 7 caption says through August 2002. Exact combined period unresolved; no single-year occupation inferred.\",\r\n      \"boundary_rule\": \"Source w=1.89*L*cos(theta), described as about 50% of maximum fitted velocity; preserve approximate source coefficient rather than exact half-maximum conversion.\",\r\n      \"source_url\": \"https://pdfs.semanticscholar.org/21be/8b2802335b0f945b23cde6ece4d5e3647f09.pdf\",\r\n      \"source_citation\": \"Deng, Hwang, Coleman and Featherstone (2008), Seasonal and Interannual Variations of the Leeuwin Current off Western Australia from TOPEX/Poseidon Satellite Altimetry, TAO 19, 135-149, doi:10.3319/TAO.2008.19.1-2.135(SA).\",\r\n      \"source_locator\": \"Section 3.3, printed page 143, paragraph discussing current width at a101; Fig. 7d on page 144; section 2.2 equations 1-3 on page 138 and angle convention on page 139.\",\r\n      \"source_retrieved_date\": \"2026-10-04\",\r\n      \"source_evidence_kind\": \"published_altimetry_fitted_monthly_width\",\r\n      \"extraction_method\": \"Approximate April/September values transcribed from source prose and visually checked against Fig. 7d; no other monthly points inferred.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"April climatological fitted width\",\r\n      \"phase_kind\": \"monthly_climatological_fit\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": [\r\n        4\r\n      ],\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"remaining_gates\": [\r\n        \"Extract all 12 months with plot calibration and extraction margins before annual display.\",\r\n        \"Reconcile July/August period labels, fitting model and approximate half-maximum convention.\",\r\n        \"Review near-coastal gaps, Gaussian filtering and current-angle assumptions.\",\r\n        \"Independent scientific claim admission.\"\r\n      ],\r\n      \"source_quality_note\": \"50 km filter window is not current width. Table 1 gives 105 km mean with 35 km RMS variability, not a confidence interval. Source period labels disagree at July/August 2002; near-coastal gaps, fitted symmetry and angle assumptions remain review gates.\",\r\n      \"calendar_source_locator\": \"Section 3.3, printed page 143, paragraph discussing current width at a101; Fig. 7d on page 144; section 2.2 equations 1-3 on page 138 and angle convention on page 139.\",\r\n      \"monthly_fit_context\": {\r\n        \"audit_file\": \"research/leeuwin-deng-2008-monthly-fitted-width-scope-audit.json\",\r\n        \"audit_sha256\": \"7763e18ade30bb2b82004e4a11e4cfca12b1fbc04d24158a81e350b9f54e11e3\",\r\n        \"source_pdf_sha256\": \"7e26241e96d5047542f59ee3038f594625b37f5d5216ebeae77c7da51123ae64\",\r\n        \"track_id\": \"a101\",\r\n        \"calendar_month\": 4,\r\n        \"source_width_coefficient\": 1.89,\r\n        \"track_angle_degrees\": 43.45,\r\n        \"mean_width_is_width_of_mean_profile\": false,\r\n        \"exact_combined_averaging_period_resolved\": false,\r\n        \"complete_monthly_curve_extracted\": false,\r\n        \"transport_layer_is_width_measurement_layer\": false,\r\n        \"rms_is_confidence_interval\": false\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"leeuwin-a101-monthly-fit-09\",\r\n      \"current_id\": \"leeuwin\",\r\n      \"name\": \"Leeuwin Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_monthly_mean_fitted_width\",\r\n      \"width_metric\": \"source_fitted_cross_flow_width\",\r\n      \"width_metric_label\": \"a101; mean of source fitted widths\",\r\n      \"approximate_width_km\": 89,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"Two extracted monthly climatological values do not establish a full annual range or a confidence interval.\",\r\n      \"geographic_scope\": \"TOPEX/Poseidon ascending track a101 crossing near 26 S, west of Western Australia. No monthly lateral-edge coordinates extracted.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Source cross-flow width corrected from oblique satellite track using theta=43.45 degrees.\",\r\n      \"layer\": \"Surface geostrophic diagnostic from absolute SSH minus AUSGeoid98. The 80 m layer is a transport assumption, not the width measurement layer.\",\r\n      \"time_convention\": \"Calendar-month composite of per-cycle fitted widths. Section 3.3 says January 1993-July 2002; Fig. 7 caption says through August 2002. Exact combined period unresolved; no single-year occupation inferred.\",\r\n      \"boundary_rule\": \"Source w=1.89*L*cos(theta), described as about 50% of maximum fitted velocity; preserve approximate source coefficient rather than exact half-maximum conversion.\",\r\n      \"source_url\": \"https://pdfs.semanticscholar.org/21be/8b2802335b0f945b23cde6ece4d5e3647f09.pdf\",\r\n      \"source_citation\": \"Deng, Hwang, Coleman and Featherstone (2008), Seasonal and Interannual Variations of the Leeuwin Current off Western Australia from TOPEX/Poseidon Satellite Altimetry, TAO 19, 135-149, doi:10.3319/TAO.2008.19.1-2.135(SA).\",\r\n      \"source_locator\": \"Section 3.3, printed page 143, paragraph discussing current width at a101; Fig. 7d on page 144; section 2.2 equations 1-3 on page 138 and angle convention on page 139.\",\r\n      \"source_retrieved_date\": \"2026-10-04\",\r\n      \"source_evidence_kind\": \"published_altimetry_fitted_monthly_width\",\r\n      \"extraction_method\": \"Approximate April/September values transcribed from source prose and visually checked against Fig. 7d; no other monthly points inferred.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"September climatological fitted width\",\r\n      \"phase_kind\": \"monthly_climatological_fit\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": [\r\n        9\r\n      ],\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"remaining_gates\": [\r\n        \"Extract all 12 months with plot calibration and extraction margins before annual display.\",\r\n        \"Reconcile July/August period labels, fitting model and approximate half-maximum convention.\",\r\n        \"Review near-coastal gaps, Gaussian filtering and current-angle assumptions.\",\r\n        \"Independent scientific claim admission.\"\r\n      ],\r\n      \"source_quality_note\": \"50 km filter window is not current width. Table 1 gives 105 km mean with 35 km RMS variability, not a confidence interval. Source period labels disagree at July/August 2002; near-coastal gaps, fitted symmetry and angle assumptions remain review gates.\",\r\n      \"calendar_source_locator\": \"Section 3.3, printed page 143, paragraph discussing current width at a101; Fig. 7d on page 144; section 2.2 equations 1-3 on page 138 and angle convention on page 139.\",\r\n      \"monthly_fit_context\": {\r\n        \"audit_file\": \"research/leeuwin-deng-2008-monthly-fitted-width-scope-audit.json\",\r\n        \"audit_sha256\": \"7763e18ade30bb2b82004e4a11e4cfca12b1fbc04d24158a81e350b9f54e11e3\",\r\n        \"source_pdf_sha256\": \"7e26241e96d5047542f59ee3038f594625b37f5d5216ebeae77c7da51123ae64\",\r\n        \"track_id\": \"a101\",\r\n        \"calendar_month\": 9,\r\n        \"source_width_coefficient\": 1.89,\r\n        \"track_angle_degrees\": 43.45,\r\n        \"mean_width_is_width_of_mean_profile\": false,\r\n        \"exact_combined_averaging_period_resolved\": false,
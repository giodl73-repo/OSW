idth_is_observation\": false,\r\n        \"axis_to_ACC_separation_km\": {\r\n          \"operator\": \"gt\",\r\n          \"value\": 500,\r\n          \"is_current_width\": false\r\n        },\r\n        \"display_method_note\": \"One reported less-than band constraint; representative width, lower bound, numerical uncertainty, mapped edges and annual extrema remain unknown. March 1990 dates the observation; 1995 is publication. The 100 km transport assumption and greater-than-500 km separation from ACC flow are distinct contextual values.\",\r\n        \"display_aria_label\": \"South Pacific Current: the authors report an enhanced eastward band less than 200 km wide near nominal 170 W in March 1990. Relative geostrophic reference sigma2=36.75 kg/m3 at 1800-1840 m. Representative width, exact days, lower bound and error unknown. No 200 km point, zero-to-200 interval, geographic width band or annual range.\",\r\n        \"display_caption\": \"March 1990 / Baldrige section d near nominal 170 W. Source-reported constraint for an enhanced eastward relative-geostrophic band; representative width and paired edges unknown.\",\r\n        \"audit_file\": \"research/south-pacific-stramma-1995-width-constraint-scope-audit.json\",\r\n        \"audit_sha256\": \"5d86b40f0c1029535542b843dd5b1451d6111b1ddcd16e82a6a02d438d1c7578\"\r\n      },\r\n      \"reported_width_constraint\": {\r\n        \"kind\": \"author_reported_dated_less_than\",\r\n        \"operator\": \"lt\",\r\n        \"reference_scale_km\": 200,\r\n        \"source_notation\": \"<200 km\",\r\n        \"is_rigorous_upper_bound\": false,\r\n        \"representative_width_km\": null,\r\n        \"lower_bound_km\": null,\r\n        \"numerical_uncertainty_km\": null\r\n      },\r\n      \"time_precision\": \"month\",\r\n      \"observed_month\": \"1990-03\"\r\n    },\r\n    {\r\n      \"id\": \"south-atlantic-stramma-1983-10-southern-band-width\",\r\n      \"current_id\": \"south-atlantic\",\r\n      \"name\": \"South A
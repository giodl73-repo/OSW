boundary variability of the selected core-width estimate; not confidence limits, physical-boundary error, annual extrema or seasonal range.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"geographic_scope\": \"Local WSC core at the 77.25 N glider target transect west of Svalbard; selected high-transport sections, not the entire WSC system.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Zonal target section; northward geostrophic component is section-normal. No flow-vector correction or geographic width-edge pair extracted.\",\r\n      \"layer\": \"Vertically integrated Q across the sampled water column, independent of water-mass classification; gliders sample to 1000 m or above local seabed. Not a fixed-depth width.\",\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"time_convention\": \"Table 1 target-section windows across three missions; discontinuous occupations, primarily autumn/winter. Individual width-selection membership unextracted.\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"phase_label\": \"Selected high-transport core / 2020-2023 glider missions\",\r\n      \"phase_kind\": \"selected_section_core_width_statistics\",\r\n      \"boundary_rule\": \"Published selected-core transport threshold operator; Q maxima east of x=275 km and section selection above their 60th percentile. Exact numerical threshold and selected count unextracted.\",\r\n      \"boundary_sides\": \"author_reported_zonal_core_extent_no_geographic_edge_pair\",\r\n      \"source_url\": \"https://os.copernicus.org/articles/22/1003/2026/\",\r\n      \"source_citation\": \"Dundas, V. and Fer, I. (2026), Atlantic Water flow through Fram Strait to the Arctic Ocean measured by repeated glider transects, Ocean Science 22, 1003-1021, doi:10.5194/os-22-1003-2026.\",\r\n      \"source_locator\": \"Section 3.1, printed p.1008 (PDF page 6), right column; methods sections 2.1-2.5, pp.1005-1008; Table 1 p.1006.\",\r\n      \"source_retrieved_date\": \"2026-10-17\",\r\n      \"source_evidence_kind\": \"published_selected_section_core_width_statistic\",\r\n      \"extraction_method\": \"Published point and standard deviation transcribed after visual PDF inspection; no per-section reconstruction or boundary digitization.\",\r\n      \"source_quality_note\": \"Rounded source statistic for selected sections. Objective mapping and satellite reference are method components; not direct edge observations or independent seasonal coverage.\",\r\n      \"remaining_gates\": [\r\n        \"Independent scientific admission.\",\r\n        \"Recover the authors exact selection, estimator, per-section widths and geographical edges for reproducibility and physical map bands.\",\r\n        \"Obtain comparable observations across missing seasons before annual extrema or seasonal geometry.\"\r\n      ],\r\n      \"selected_core_context\": {\r\n        \"selected_section_count\": null,\r\n        \"per_section_widths_km\": null,\r\n        \"numeric_transport_threshold\": null,\r\n        \"boundary_coordinates\": null,\r\n        \"study_section_count\": 22,\r\n        \"incomplete_study_sections\": 5,\r\n        \"maximum_search_minimum_distance_km\": 275,\r\n        \"distance_origin_longitude_degrees_east\": -2,\r\n        \"target_latitude_degrees_north\": 77.25,\r\n        \"target_longitude_bounds_degrees_east\": [\r\n          -2,\r\n          12\r\n        ],\r\n        \"section_selection_percentile\": 60,\r\n        \"selection_percentile_is_peak_fraction\": false,\r\n        \"fixed_wsc_transport_region_boundary_km\": 300,\r\n        \"fixed_region_span_is_core_width\": false,\r\n        \"uses_Q_not_QAW\": true,\r\n        \"width_standard_deviation_km\": 7,\r\n        \"standard_deviation_is_width_measurement_error\": false,\r\n        \"standard_deviation_is_annual_range\": false,\r\n        \"source_grid_horizontal_km\": 2,\r\n        \"source_grid_vertical_dbar\": 2,\r\n        \"objective_mapping_horizontal_scale_km\": 40,\r\n        \"objective_mapping_vertical_scale_m\": 40,\r\n        \"mean_native_profile_spacing_km\": 3.5,\r\n        \"native_profile_spacing_standard_deviation_km\": 2.3,\r\n        \"absolute_velocity_reference\": \"satellite_surface_geostrophic_currents_for_all_sections\",\r\n        \"glider_dac_affected_sections\": [\r\n          7,\r\n          8,\r\n          9,\r\n          10\r\n        ],\r\n        \"width_estimator_reproduced\": false,\r\n        \"whole_current_width_km\": null,\r\n        \"annual_width_range_km\": null,\r\n        \"protocol_file\": \"plans/west-spitsbergen-selected-core-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"cbacbf19eb88313676c2cd550fa0af60da2c182ec8d3faca69600ef41b928cbe\",\r\n        \"audit_file\": \"research/west-spitsbergen-dundas-2026-selected-core-width-scope-audit.json\",\r\n        \"audit_sha256\": \"87e5c16c7ea5787e1224cc19b05e4f7b885356268062e6c997f1e09c28dc09fa\",\r\n        \"section_windows\": [\r\n          {\r\n            \"mission\": 1,\r\n            \"glider\": \"sg562\",\r\n            \"start\": \"2020-10-10\",\r\n            \"end\": \"2021-02-07\",\r\n            \"profiles\": 1250,\r\n            \"sections\": 7\r\n          },\r\n          {\r\n            \"mission\": 2,\r\n            \"glider\": \"sg560\",\r\n            \"start\": \"2021-08-14\",\r\n            \"end\": \"2022-02-20\",\r\n            \"profiles\": 1610,\r\n            \"sections\": 7\r\n          },\r\n          {\r\n            \"mission\": 3,\r\n            \"glider\": \"sg560\",\r\n            \"start\": \"2022-08-07\",\r\n            \"end\": \"2023-01-02\",\r\n            \"profiles\": 1430,\r\n            \"sections\": 8\r\n          }\r\n        ],\r\n        \"figure_file\": \"figures/w
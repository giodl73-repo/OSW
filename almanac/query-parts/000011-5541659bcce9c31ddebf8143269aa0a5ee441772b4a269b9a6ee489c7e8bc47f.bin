effective_depth_is_fixed_layer\": false,\r\n        \"width_is_tidal_model_prediction\": false,\r\n        \"grid_spacing_is_width_uncertainty\": false,\r\n        \"radar_range_is_current_width\": false,\r\n        \"site_coordinates_are_width_edges\": false,\r\n        \"paired_width_boundaries_extracted\": false,\r\n        \"velocity_confidence_ellipses_are_width_intervals\": false,\r\n        \"tidal_discrepancy_band_km\": 20,\r\n        \"tidal_discrepancy_is_current_width\": false,\r\n        \"peak_speed_context_cm_s\": 12,\r\n        \"peak_offshore_position_context_km\": 10,\r\n        \"peak_speed_is_width_cutoff\": false,\r\n        \"peak_position_is_width\": false,\r\n        \"widths_at_two_sites_are_seasonal_range\": false,\r\n        \"numeric_seasonal_widths\": null,\r\n        \"seasonal_velocity_changes_are_width_series\": false,\r\n        \"velocity_running_medians_days\": [\r\n          3,\r\n          30\r\n        ],\r\n        \"running_medians_are_width_filter\": false,\r\n        \"source_sign_conventions\": {\r\n          \"figure_14_southeastward\": \"positive\",\r\n          \"figure_15_southeastward\": \"negative\",\r\n          \"merged_or_repaired\": false\r\n        },\r\n        \"full_article_reviewed\": false,\r\n        \"protocol_file\": \"plans/western-adriatic-radar-width-support-protocol-v1.md\",\r\n        \"protocol_sha256\": \"414f8d0932a78aa20da7bbc302efbf1f4337065d4c61b6bf8b5aa9f08f741332\",\r\n        \"display_caption\": \"Pesaro: 50 km reported width of a mean surface-flow profile. Southern section BB-prime. Two locations do not establish a 40-50 km seasonal range. No mapped width edges.\",\r\n        \"display_method_note\": \"Observed radar mean flow, separate from tidal-model predictions. Deployment spans October 2002-October 2004 with site-specific gaps; identical averaging times and weights unresolved. Effective depth, grid spacing and velocity confidence are not a width slab or width error. Seasonal velocity changes do not supply seasonal widths.\",\r\n        \"display_aria_label\": \"Pesaro: 50 km reported width of a mean surface-flow profile. Southern section BB-prime. Two locations do not establish a 40-50 km seasonal range. No mapped width edges.\",\r\n        \"audit_file\": \"research/western-adriatic-chavanne-2007-mean-width-scope-audit.json\",\r\n        \"audit_sha256\": \"61d4d2dfdccb2c51c70d0487ab393a7359bb5b75b8ac5d0d89e7c8adf12ee9fa\",\r\n        \"audit_pointer\": \"/measurements/1\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"jutland-skov-2019-coastal-water-mass-breadth\",\r\n      \"current_id\": \"jutland\",\r\n      \"name\": \"Jutland Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": null,\r\n      \"width_range_km\": [\r\n        10,\r\n        20\r\n      ],\r\n      \"range_kind\": \"reported_typical_regional_width_span\",\r\n      \"range_interpretation\": \"Report describes a 10-20 km surface-water-mass breadth in a regional geographic synthesis. Not paired velocity boundaries, a confidence interval, annual extrema or a whole-current width.\",\r\n      \"geographic_scope\": \"Surface water mass along the west Jutland coast from Henne Strand north of Horns Rev to Skagen; Wadden Sea offshore traceability and habitat zones have separate support.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Reported coastal water-mass breadth; no transverse velocity section or paired geographic edges extracted.\",\r\n      \"layer\": \"Surface water mass; fixed numerical depth bounds not supplied for this breadth.\",\r\n      \"time_convention\": \"Undated regional synthesis in a report approved September 2019. December 2018 modeled maps and seasonal seabird distributions do not date the width statement.\",\r\n      \"boundary_rule\": \"Report-provided water-mass breadth citing Nielsen (1999); salinity threshold, paired edges and underlying width method remain unresolved.\",\r\n      \"source_url\": \"https://ens.dk/media/5628/download/\",\r\n      \"source_citation\": \"Skov, Mortensen and Tuhuteru (2019), Site selection for offshore wind farms in Danish waters: Investigations of bird distribution and abundance, DHI for Energistyrelsen / Danish Energy Agency, project 11823165, final approved 18 September 2019.\",\r\n      \"source_locator\": \"Section 2.3, printed p15 / PDF p27 (10-20 km); PDF p26 preceding oceanographic context; Figure 6 PDF p28; section 3.1.1.1 printed pp23-24 / PDF pp35-36 distinguishes habitat and alternate reach; title/credits PDF pp1,3.\",\r\n      \"source_retrieved_date\": \"2026-10-09\",\r\n      \"source_evidence_kind\": \"government_water_mass_geographic_synthesis_citing_prior_source\",\r\n      \"extraction_method\": \"Reported breadth span transcribed from visually inspected original prose. No map digitization, salinity contour diagnosis or velocity-core inference.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Coastal surface-water-mass breadth\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Agency-hosted DHI geographic water-mass synthesis. Nielsen thesis reprint now inspected at selected pages: separate 40, 25 and 20-25 km satellite-image estimates cite Aarup (1994a). Exact DHI 10-20 km phrase not confirmed in the reviewed Nielsen width passage. Original imagery methods and North/South label relations remain unresolved.\",\r\n      \"remaining_gates\": [\r\n        \"Recover Nielsen (1999) and the underlying water-mass boundary definition.\",\r\n        \"Resolve North/South Jutland label relations independently of this regional breadth.\",\r\n        \"Recover compatible repeated sections, dates, depth and geographic edges before seasonal widths or mapped bands.\",\r\n        \"Independent scientific and canonical admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"source_access\": \"unchanged_agency_pdf_selected_pages_reviewed\",\r\n        \"description_kind\": \"water-mass-breadth\",\r\n        \"source_class\": \"agency_hosted_environmental_synthesis\",\r\n        \"quantity_scope\": \"surface_water_mass_breadth_not_velocity_core_width\",\r\n        \"source_current_label\": \"Jutland Current / Continental Coastal Water\",\r\n        \"underlying_source_citation\": \"Nielsen, Mads Hvid (2000), Dynamisk beskrivelse og hydrografisk klassifikation af Den Jyske Kyststrom, DMI Scientific Report 00-15, ISBN 87-7478-425-0. Reprint of April 1999 University of Copenhagen master thesis; reprint preface October 2000.; satellite-image width passage in section 2.4 cites Aarup (1994a), whose original remains unreviewed.\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"salinity_threshold_extracted\": false,\r\n        \"paired_width_boundaries_extracted\": false,\r\n        \"surface_label_is_fixed_depth_layer\": false,\r\n        \"width_occupation_dates_resolved\": false,\r\n        \"publication_year_is_width_occupation\": false,\r\n        \"modeled_map_month\": \"2018-12\",\r\n        \"modeled_map_date_is_width_occupation\": false,\r\n        \"model_map_is_width_measurement\": false,\r\n        \"offshore_context\": {\r\n          \"location\": \"Wadden Sea\",\r\n          \"traceability_almost_km\": 100,\r\n          \"core_typically_within_km\": 40,\r\n          \"are_paired_width_edges\": false,\r\n          \"are_range_endpoints\": false\r\n        },\r\n        \"habitat_context\": {\r\n          \"location\": \"just north of Horns Rev\",\r\n          \"zone_around_km\": 40,\r\n          \"depth_zone_m\": [\r\n            15,\r\n            30\r\n          ],\r\n          \"higher_density_cutoff_birds_km2\": 0.75,\r\n          \"is_current_width\": false,\r\n          \"bathymetry_is_width_layer\": false,\r\n          \"bird_seasonality_is_width_series\": false\r\n        },\r\n        \"alternate_geographic_context\": {\r\n          \"source_locator\": \"printed p23 / PDF p35\",\r\n          \"reported_breadth_km\": 20,\r\n          \"reach\": \"Ringkobing Fjord to Skagen\",\r\n          \"is_preferred_width\": false,\r\n          \"is_dated_width_sample\": false,\r\n          \"is_independent_measurement\": false\r\n        },\r\n        \"naming_context\": {\r\n          \"naming_audit_file\": \"research/jutland-current-naming-scope-audit.json\",\r\n          \"naming_audit_sha256\": \"4520258deb2ac71bae2269b2c4cf78bf6c47d4c7c20057d68aa08acb89c6d350\",\r\n          \"north_south_aliases_resolved\": false,\r\n          \"canonical_alias_admitted\": false,\r\n          \"norwegian_coastal_width_inheritance_eligible\": false\r\n        },\r\n        \"span_is_annual_range\": false,\r\n        \"full_report_reviewed\": false,\r\n        \"protocol_file\": \"plans/jutland-water-mass-breadth-protocol-v1.md\",\r\n        \"protocol_sha256\": \"e687f7c05ab6febeea1d8e6180a24bca4a34c09b7d72a37612628eb95d65a4d1\",\r\n        \"display_caption\": \"Jutland: reported 10-20 km coastal surface-water-mass breadth from Henne Strand to Skagen. Not a velocity-core width, confidence interval or seasonal range. No mapped width edges.\",\r\n        \"display_method_note\": \"Surface-water-mass synthesis. The inspected Nielsen thesis gives separate site-specific satellite estimates citing unreviewed Aarup (1994a); this review does not corroborate the exact 10-20 km phrase. Offshore traceability, core confinement, bird habitat and December 2018 model maps remain separate support. No pooled seasonal range or resolved North/South aliases.\",\r\n        \"display_aria_label\": \"Jutland: reported 10-20 km coastal surface-water-mass breadth from Henne Strand to Skagen. Not a velocity-core width, confidence interval or seasonal range. No mapped width edges.\",\r\n        \"supporting_original_review\": {\r\n          \"source_document_file\": \"research/source-data/nielsen-jutland-2000/journal-article.pdf\",\r\n          \"source_document_sha256\": \"29e027afd56877b6acec02382a8a6a2e5b2ecce24572171c2e15c1f1ae071525\",\r\n          \"source_document_bytes\": 4292648,\r\n          \"acquisition_file\": \"research/source-data/nielsen-jutland-2000/acquisition.json\",\r\n          \"acquisition_sha256\": \"ee96523fe882310b4bc2a72c14b04df6d1985c977739551b0b4779bbda8e28da\",\r\n          \"source_citation\": \"Nielsen, Mads Hvid (2000), Dynamisk beskrivelse og hydrografisk klassifikation af Den Jyske Kyststrom, DMI Scientific Report 00-15, ISBN 87-7478-425-0. Reprint of April 1999 University of Copenhagen master thesis; reprint preface October 2000.\",\r\n          \"selected_pages_reviewed\": [\r\n            1,\r\n            3,\r\n            7,\r\n            22,\r\n            23,\r\n            71,\r\n            140\r\n          ],\r\n          \"reprint_link_established\": true,\r\n          \"exact_10_20_phrase_confirmed_in_reviewed_width_passage\": false,\r\n          \"primary_satellite_methods_reviewed\": false,\r\n          \"is_independent_corroborating_measurement\": false\r\n        },\r\n        \"audit_file\": \"research/jutland-skov-2019-water-mass-breadth-scope-audit.json\",\r\n        \"audit_sha256\": \"c3fdcff1113465b8a14a0cc78bcee043beed088979a6de8b3e7d6767a76956ad\",\r\n        \"audit_pointer\": \"/measurements/0\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"jutland-nielsen-2000-thyboron-cited-satellite-width\",\r\n      \"current_id\": \"jutland\",\r\n      \"name\": \"Jutland Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": 40,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"reported_typical_regional_width_span\",\r\n      \"range_interpretation\": \"One site-specific width description attributed to satellite imagery. Not a dated image diagnosis, paired velocity width, confidence interval, annual extrema or range across sites; no midpoint selected.\",\r\n      \"geographic_scope\": \"Off Thyboron, Jutland Coastal Current, eastern North Sea / Skagerrak; geographic section coordinates not extracted.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Reported satellite-image current breadth at a named coastal site; no flow-normal transect orientation recovered.\",\r\n      \"layer\": \"Satellite-image description; measurement depth not recovered. Mixed-water and local bathymetry context do not fix a width layer.\",\r\n      \"time_convention\": \"Undated image-derived estimate summarized in the April 1999 thesis reprinted October 2000, citing Aarup 1994a. Publication and hydrographic-study years are not width occupation dates.\",\r\n      \"boundary_rule\": \"Author-reported width attributed to satellite imagery; image classification threshold, sensor and exact edge rule not recovered.\",\r\n      \"source_url\": \"https://www.dmi.dk/fileadmin/Rapporter/SR/sr00-15.pdf\",\r\n      \"source_citation\": \"Nielsen, Mads Hvid (2000), Dynamisk beskrivelse og hydrografisk klassifikation af Den Jyske Kyststrom, DMI Scientific Report 00-15, ISBN 87-7478-425-0. Reprint of April 1999 University of Copenhagen master thesis; reprint preface October 2000.\",\r\n      \"source_locator\": \"Section 2.4 / 2.4.1, printed p14 / PDF p22; mixed-water context printed p15 / PDF p23; qualitative widening printed p63 / PDF p71; references printed p132 / PDF p140; reprint preface PDF p3.\",\r\n      \"source_retrieved_date\": \"2026-10-09\",\r\n      \"source_evidence_kind\": \"original_thesis_regional_summary_citing_satellite_estimate\",\r\n      \"extraction_method\": \"Danish width sentence translated and numerals/site order transcribed from visually inspected original prose. No original Aarup image acquisition or contour digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Thyboron cited satellite width\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Inspected original thesis cites Aarup (1994a) for image widths. Sensor, image dates, threshold, uncertainty and paired edges unresolved. Hydrographic and wind analyses are separate support; no pooled seasonal interval.\",\r\n      \"remaining_gates\": [\r\n        \"Recover Aarup (1994a), Havforskning 42, imagery, sensor, dates and width definition.\",\r\n        \"Recover compatible layer/time/edge support for comparison to velocity-based sections and DHI water-mass breadth.\",\r\n        \"Independent scientific/canonical review and resolution of North/South naming.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"source_access\": \"unchanged_agency_thesis_selected_pages_reviewed\",\r\n        \"description_kind\": \"cited-satellite-width\",\r\n        \"source_class\": \"thesis_geographic_synthesis_citing_prior_satellite_images\",\r\n        \"quantity_scope\": \"cited_image_width_not_recovered_velocity_core_width\",\r\n        \"site_label\": \"Thyboron\",\r\n        \"original_text_language\": \"Danish\",\r\n        \"translation_kind\": \"OSW_editorial_translation_not_independent_observation\",\r\n        \"underlying_source_citation\": \"Aarup, T. (1994a), Satellitbilleder af danske havomrader, Havforskning fra Miljostyrelsen 42. Listed separately from series 52 English thesis in bibliography.\",\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"original_satellite_images_acquired\": false,\r\n        \"satellite_sensor_resolved\": false,\r\n        \"image_dates_resolved\": false,\r\n        \"image_threshold_resolved\": false,\r\n        \"paired_width_boundaries_extracted\": false,\r\n        \"image_resolution_is_width_uncertainty\": false,\r\n        \"freshwater_definition_is_image_threshold\": false,\r\n        \"mixed_water_description_is_fixed_depth_slab\": false,\r\n        \"publication_year_is_width_occupation\": false,\r\n        \"hydrographic_years_are_image_dates\": false,\r\n        \"numeric_seasonal_widths\": null,\r\n        \"qualitative_widening_context\": {\r\n          \"source_locator\": \"section 7.3.3, printed p63 / PDF p71\",\r\n          \"site_labels\": [\r\n            \"Hanstholm\",\r\n            \"Hirtshals\"\r\n          ],\r\n          \"source_time_phrase\": \"midt pa sommeren (midsummer)\",\r\n          \"interpretation\": \"Author infers widening when German Bight-water fraction peaks become similar at three coast distances; underlying station comparison not shown in this passage.\",\r\n          \"is_numeric_width_series\": false,\r\n          \"is_satellite_width_occupation\": false,\r\n          \"calendar_months_assigned\": null,\r\n          \"coast_distance_sampling_is_paired_width_edges\": false\r\n        },\r\n        \"sites_form_annual_range\": false,\r\n        \"cross_source_span_is_annual_range\": false,\r\n        \"naming_context\": {\r\n          \"naming_audit_file\": \"research/jutland-current-naming-scope-audit.json\",\r\n          \"naming_audit_sha256\": \"4520258deb2ac71bae2269b2c4cf78bf6c47d4c7c20057d68aa08acb89c6d350\",\r\n          \"north_south_aliases_resolved\": false,\r\n          \"canonical_alias_admitted\": false,\r\n          \"norwegian_coastal_width_inheritance_eligible\": false\r\n        },\r\n        \"full_report_reviewed\": false,\r\n        \"protocol_file\": \"plans/jutland-satellite-width-support-protocol-v1.md\",\r\n        \"protocol_sha256\": \"7e509171da27e804a3b1d081d0ec93718a90ea7463025b0146d13bb6b2eca70e\",\r\n        \"display_caption\": \"Thyboron: 40 km reported satellite-image width estimate, cited by Nielsen from Aarup (1994a). Image dates and boundary methods unknown. Sites and sources do not establish a 10-40 km seasonal range; no mapped edges.\",\r\n        \"display_method_note\": \"Satellite-image estimate cited in thesis prose; original Aarup images, dates, sensor and edge threshold unreviewed. Mostly mixed-water/bathymetry descriptions do not define image depth. Midsummer widening is qualitative water-mass evidence, not dated numeric satellite widths.\",\r\n        \"display_aria_label\": \"Thyboron: 40 km reported satellite-image width estimate, cited by Nielsen from Aarup (1994a). Image dates and boundary methods unknown. Sites and sources do not establish a 10-40 km seasonal range; no mapped edges.\",\r\n        \"audit_file\": \"research/jutland-nielsen-2000-cited-satellite-width-scope-audit.json\",\r\n        \"audit_sha256\": \"7e5b8d9899ca5eea3664c83ffc3f7f6457dc65934505285032ad04a64f9d7121\",\r\n        \"audit_pointer\": \"/measurements/0\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"jutland-nielsen-2000-hanstholm-cited-satellite-width\",\r\n      \"current_id\": \"jutland\",\r\n      \"name\": \"Jutland Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": 25,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"reported_typical_regional_width_span\",\r\n      \"range_interpretation\": \"One site-specific width description attributed to satellite imagery. Not a dated image diagnosis, paired velocity width, confidence interval, annual extrema or range across sites; no midpoint selected.\",\r\n      \"geographic_scope\": \"Off Hanstholm, Jutland Coastal Current, eastern North Sea / Skagerrak; geographic section coordinates not extracted.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Reported satellite-image current breadth at a named coastal site; no flow-normal transect orientation recovered.\",\r\n      \"layer\": \"Satellite-image description; measurement depth not recovered. Mixed-water and local bathymetry context do not fix a width layer.\",\r\n      \"time_convention\": \"Undated image-derived estimate summarized in the April 1999 thesis reprinted October 2000, citing Aarup 1994a. Publication and hydrographic-study years are not width occupation dates.\",\r\n      \"boundary_rule\": \"Author-reported width attributed to satellite imagery; image classification threshold, sensor and exact edge rule not recovered.\",\r\n      \"source_url\": \"https://www.dmi.dk/fileadmin/Rapporter/SR/sr00-15.pdf\",\r\n      \"source_citation\": \"Nielsen, Mads Hvid (2000), Dynamisk beskrivelse og hydrografisk klassifikation af Den Jyske Kyststrom, DMI Scientific Report 00-15, ISBN 87-7478-425-0. Reprint of April 1999 University of Copenhagen master thesis; reprint preface October 2000.\",\r\n      \"source_locator\": \"Section 2.4 / 2.4.1, printed p14 / PDF p22; mixed-water context printed p15 / PDF p23; qualitative widening printed p63 / PDF p71; references printed p132 / PDF p140; reprint preface PDF p3.\",\r\n      \"source_retrieved_date\": \"2026-10-09\",\r\n      \"source_evidence_kind\": \"original_thesis_regional_summary_citing_satellite_estimate\",\r\n      \"extraction_method\": \"Danish width sentence translated and numerals/site order transcribed from visually inspected original prose. No original Aarup image acquisition or contour digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Hanstholm cited satellite width\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Inspected original thesis cites Aarup (1994a) for image widths. Sensor, image dates, threshold, uncertainty and paired edges unresolved. Hydrographic and wind analyses are separate support; no pooled seasonal interval.\",\r\n      \"remaining_gates\": [\r\n        \"Recover Aarup (1994a), Havforskning 42, imagery, sensor, dates and width definition.\",\r\n        \"Recover compatible layer/time/edge support for comparison to velocity-based sections and DHI water-mass breadth.\",\r\n        \"Independent scientific/canonical review and resolution of North/South naming.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"source_access\": \"unchanged_agency_thesis_selected_pages_reviewed\",\r\n        \"description_kind\": \"cited-satellite-width\",\r\n        \"source_class\": \"thesis_geographic_synthesis_citing_prior_satellite_images\",\r\n        \"quantity_scope\": \"cited_image_width_not_recovered_velocity_core_width\",\r\n        \"site_label\": \"Hanstholm\",\r\n        \"original_text_language\": \"Danish\",\r\n        \"translation_kind\": \"OSW_editorial_translation_not_independent_observation\",\r\n        \"underlying_source_citation\": \"Aarup, T. (1994a), Satellitbilleder af danske havomrader, Havforskning fra Miljostyrels
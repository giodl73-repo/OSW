us.org/articles/14/689/2018/\",\r\n      \"candidate_ids\": [\r\n        \"northern-mediterranean-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"coastal boundary current\",\r\n      \"route_strategy_id\": \"source_gated_regional_route\",\r\n      \"route_strategy_label\": \"Establish a sourced regional route\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"The named flow is described from the Ligurian Sea along the Provençal and Catalan coasts. The cited paper reports widths and local sections, not a comparable whole-current alongstream length.\",\r\n      \"next_action\": \"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.\",\r\n      \"strategy_next_action\": \"Read primary geographic definitions, choose explicit endpoint/branch/layer/time conventions, and measure a reviewed route with alternatives; naming points alone are insufficient.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"norwegian-coastal\",\r\n      \"name\": \"Norwegian Coastal Current\",\r\n      \"existing_length_evidence_status\": \"section_only\",\r\n      \"existing_scope\": \"A source identifies the current along the Norwegian coast and represents it with stations 1 and 5 nautical miles off Torungen; this is a section location, not a whole-current length. Its relation to the name Norwegian Current is convention-dependent.\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=2364\",\r\n      \"candidate_ids\": [\r\n        \"norwegian-coastal-reference-path-candidate\"\r\n      ],\r\n      \"refe
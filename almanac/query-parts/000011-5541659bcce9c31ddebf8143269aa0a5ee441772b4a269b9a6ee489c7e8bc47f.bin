lanning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"benguela\",\r\n      \"name\": \"Benguela Current\",\r\n      \"existing_length_evidence_status\": \"derived_lower_bound\",\r\n      \"existing_scope\": \"The study identifies the Benguela Current system at 30°, 24°, and 19°S across decadal inverse solutions, with no continuity north of 19°S. The current and Benguela ecosystem have different extents. Section observations are from different cruises and do not establish a simultaneous centerline; the derived floor is unranked.\",\r\n      \"name_source_url\": \"https://www.vos.noaa.gov/docs/marine_info_guide.pdf\",\r\n      \"candidate_ids\": [\r\n        \"benguela-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"eastern boundary current system\",\r\n      \"route_strategy_id\": \"source_gated_regional_route\",\r\n      \"route_strategy_label\": \"Establish a sourced regional route\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"The study identifies the Benguela Current system at 30°, 24°, and 19°S across decadal inverse solutions, with no continuity north of 19°S. The current and Benguela ecosystem have different extents. Section observations are from different cruises and do not establish a simultaneous centerline; the derived floor is unranked.\",\r\n      \"next_action\": \"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.\",\r\n      \"strategy_next_action\": \"Read primary geographic definitions, choose explicit endpoint/branch/layer/time conventions, and measure a reviewed route with alternatives; naming points alone are insufficient.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"black-sea-rim\",\r\n      \"name\": \"Black Sea Rim Current\",\r\n      \"existing_length_evidence_status\": \"no_numeric_length\",\r\n      \"existing_scope\": \"Copernicus Marine defines this basin-scale cyclonic flow and measures intensity in northern and southern slope sectors. Those sectors are monitoring windows, not a full current centerline or length. Older Caucasus and Southern Current names may describe sectors, but equivalence is unresolved.\",\r\n      \"name_source_url\": \"https://data.marine.copernicus.eu/product/OMI_CIRCULATION_BOUNDARY_BLKSEA_rim_current_index/description\",\r\n      \"candidate_ids\": [\r\n        \"black-sea-rim-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"cyclonic basin-margin current system\",\r\n      \"route_strategy_id\": \"dated_geometry\",\r\n      \"route_strategy_label\": \"Construct dated or regime-specific geometry\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"Copernicus Marine defines this basin-scale cyclonic flow and measures intensity in northern and southern slope sectors. Those sectors are monitoring windows, not a full current centerline or length. Older Caucasus and Southern Current names may describe sectors, but equivalence is unresolved.\",\r\n      \"next_action\": \"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.\",\r\n      \"strategy_next_action\": \"Use dated or explicitly averaged geometry, distinguish an open loop from a closed circuit, and compare repeated regimes before summarizing.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"brazil\",\r\n      \"name\": \"Brazil Current\",\r\n      \"existing_length_evidence_status\": \"derived_lower_bound\",\r\n      \"existing_scope\": \"The study identifies southward Brazil Current transport at 19°, 24°, and 30°S. Confluence location and downstream identity vary. Section observations are from different cruises and do not establish a simultaneous centerline; the derived floor is unranked.\",\r\n      \"name_source_url\": \"https://www.vos.noaa.gov/docs/marine_info_guide.pdf\",\r\n      \"candidate_ids\": [\r\n        \"brazil-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"western boundary current\",\r\n      \"route_strategy_id\": \"source_gated_regional_route\",\r\n      \"route_strategy_label\": \"Establish a sourced regional route\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"The study identifies southward Brazil Current transport at 19°, 24°, and 30°S. Confluence location and downstream identity vary. Section observations are from different cruises and do not establish a simultaneous centerline; the derived floor is unranked.\",\r\n      \"next_action\": \"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.\",\r\n      \"strategy_next_action\": \"Read primary geographic definitions, choose explicit endpoint/branch/layer/time conventions, and measure a reviewed route with alternatives; naming points alone are insufficient.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"canary\",\r\n      \"name\": \"Canary Current\",\r\n      \"existing_length_evidence_status\": \"section_only\",\r\n      \"existing_scope\": \"A fall 2009 section at 29°N locates a westward extent across the section and separates transport by depth layer. It does not measure the current's along-flow length.\",\r\n      \"name_source_url\": \"https://www.vos.noaa.gov/docs/marine_info_guide.pdf\",\r\n      \"candidate_ids\": [\r\n        \"canary-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"eastern boundary current\",\r\n      \"route_strategy_id\": \"expand_section_evidence\",\r\n      \"route_strategy_label\": \"Extend evidence beyond sections\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"A fall 2009 section at 29°N locates a westward extent across the section and separates transport by depth layer. It does not measure the current's along-flow length.\",\r\n      \"next_action\": \"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.\",\r\n      \"strategy_next_action\": \"Find sourced upstream/downstream gates and continuity between sections; preserve widths and section transports as different measurements.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"caribbean\",\r\n      \"name\": \"Caribbean Current\",\r\n      \"existing_length_evidence_status\": \"no_numeric_length\",\r\n      \"existing_scope\": \"No source-defined whole-current path length admitted yet.\",\r\n      \"name_source_url\": \"https://repository.library.noaa.gov/view/noaa/4711/noaa_4711_DS1.pdf\",\r\n      \"candidate_ids\": [\r\n        \"caribbean-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"regional current\",\r\n      \"route_strategy_id\": \"source_gated_regional_route\",\r\n      \"route_strategy_label\": \"Establish a sourced regional route\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"No source-defined whole-current path length admitted yet.\",\r\n      \"next_action\": \"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.\",\r\n      \"strategy_next_action\": \"Read primary geographic definitions, choose explicit endpoint/branch/layer/time conventions, and measure a reviewed route with alternatives; naming points alone are insufficient.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"davidson\",\r\n      \"name\": \"Davidson Current\",\r\n      \"existing_length_evidence_status\": \"no_numeric_length\",\r\n      \"existing_scope\": \"A seasonal countercurrent, not a permanent jet.\",\r\n      \"name_source_url\": \"https://www.tidesandcurrents.noaa.gov/glossary.html\",\r\n      \"candidate_ids\": [\r\n        \"davidson-winter-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"seasonal coastal current\",\r\n      \"route_strategy_id\": \"seasonal_routes\",\r\n      \"route_strategy_label\": \"Construct seasonal routes\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"A seasonal countercurrent, not
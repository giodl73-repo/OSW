    [\n                -110.0,\n                4.5\n              ]\n            ]\n          },\n          \"spatial_geometry_method\": \"WGS84 geodesic legs densified at <=10 km as in the existing reference-route state join; planar relation to coarse masked OSW display polygons.\"\n        }\n      ],\n      \"state_evidence\": [],\n      \"connections\": [],\n      \"scope_notes\": [\n        {\n          \"current_id\": \"pacific-north-subsurface-countercurrent\",\n          \"label\": \"Northern Tsuchiya mean cores and integration limits\",\n          \"audit_file\": \"research/pacific-nscc-reach-layer-section-scope-audit.json\",\n          \"summary\": \"155 W to 110 W is an editorial northern Tsuchiya studied reach. Local mean cores shoal from 220 m to 130 m; no uniform axis depth inferred. Transport integration latitude limits are not width. Historical compilation dates do not date the route, and the 130 E NEUC identity is kept separate. A separate Rowe et al. general 2-degree meridional width summary is now retained as approximately 220 km; the two jet records share one source claim, not independent observations or annual extrema.\",\n          \"source_url\": \"https://www.pmel.noaa.gov/pubs/outstand/john1806/john1806.shtml\",\n          \"source_locator\": \"Sections 2-3 and Table 1: north SSCC peaks at 155 W 3.5 N/220 m and 110 W 4.5 N/130 m. Transport integration latitude limits and 700-dbar reference are separately defined; they are not route width or a uniform axis layer.\",\n          \"observed_period\": null\n        }\n      ],\n      \"evidence_links\": [],\n      \"object_url\": \"object.html?id=current%3Apacific-north-subsurface-countercurrent\",\n      \"route_url\": \"reference-routes.html#pacific-nscc-reach-reference-path-candidate\",\n      \"season_url\": \"seasons.html?current=pacific-north-subsurface-countercurrent\",\n      \"dashboard_search\": \"Pacific North Subsurface Countercurrent Equatorial North Pacific\",\n      \"width_ids\": [\n        \"pacific-north-subsurface-countercurrent-rowe-2000-general-angular-width\"\n      ],\n      \"measurement_ids\": [],\n      \"route_ids\": [\n        \"pacific-nscc-reach-reference-path-candidate\"\n      ],\n      \"source_ids\": [\n        \"source:4dc5fc618c26565f\",\n        \"source:4f7441b953be4651\",\n        \"source:803229fe82eb2360\",\n        \"source:b038491b0e5a3967\",\n        \"source:df8a86f107aba236\"\n      ],\n      \"state_codes\": [],\n      \"published_length_km\": null,\n      \"width_sample_ids\": [],\n      \"route_decision_ids\": [\n        \"route-decision:pacific-north-subsurface-countercurrent\"\n      ],\n      \"current_section_ids\": [],\n      \"velocity_sample_ids\": []\n    },\n    {\n      \"id\": \"current:pacific-south-equatorial-countercurrent\",\n      \"label\": \"Pacific South Equatorial Countercurrent\",\n      \"type\": \"named_current\",\n      \"identity_level\": \"current\",\n      \"source_kind\": \"seasonally varying eastward countercurrent\",\n      \"setting\": \"equatorial\",\n      \"time_behavior\": \"seasonal\",\n      \"basin\": \"Tropical South Pacific\",\n      \"capabilities\": {\n        \"dated_diagnostics\": 0,\n        \"flow_network\": 0,\n        \"geometry\": 0,\n        \"observed_velocity\": 0,\n        \"passage_transport\": 0,\n        \"radius_evidence\": 0,\n        \"reference_route\": 1,\n        \"reported_length\": 0,\n        \"scope_notes\": 2,\n        \"scoped_width\": 1,\n        \"source_connectivity\": 0,\n        \"time_samples\": 0,\n        \"width_samples\": 0\n      },\n      \"recorded_claims\": 56,\n      \"nasa_links\": 1,\n      \"fingerprint\": \"9d8334e036009bad4fb92b532ef5cb40417b5abd4398c118c00fdb0a0aa79aba\",\n      \"series\": [],\n      \"section_fingerprints\": {\n        \"claims\": \"a2260e85e85cdaacd05696a2bbc881fb6f1e636ebc87bed5300f637bf643449c\",\n        \"identity\": \"0a7c9e3aeadc47415d4d10a028f9175f4ae733f8e295ba3a97a4b47de019c4a4\",\n        \"measurements\": \"48898dff5dc1c51f0d87ec135947e45563dfef5209883cd906076bda24075e23\",\n        \"media\": \"68658cd0ec2f73124154cc258620ecc3b963fde1f88b1db76b5ddb15420c2128\",\n        \"routes_geometry\": \"74aeb995dc693bc0f23130b0cba8251d723d2686090deea7764749eca886698f\",\n        \"sources\": \"fc499f8708a71982e37552a03408341daeae9bce690af22335d5fd8aadbcac63\",\n        \"time_evidence\": \"8d86da8229951992c802d517eaeaeeb84a4b5f1a3e916ecd7944f448135387bd\",\n        \"pacific_secc_western_reference\": \"de110b943b30e095c0ff37a17859c4eb3f665aae90e6e89ff9fa91da71cc989e\"\n      },\n      \"latest_observation_date\": null,\n      \"claim_review_counts\": {\n        \"not_individually_reviewed\": 56\n      },\n      \"linked_source_count\": 7,\n      \"map_features\": [\n        {\n          \"coordinate_reference_system\": \"OGC:CRS84\",\n          \"geometry\": {\n            \"coordinates\": [\n              165,\n              -9\n            ],\n            \"type\": \"Point\"\n          },\n          \"geometry_id\": \"geometry:0099\",\n          \"note\": \"Representative point inside Argo-observed boreal-spring 150°E–170°W, 5–13°S envelope; not a path endpoint.\",\n          \"positional_uncertainty\": \"not quantified; no observed current core or path\",\n          \"role\": \"editorial_locator\",\n          \"source_id\": \"source:4dc5fc618c26565f\"\n        },\n        {\n          \"geometry\": {\n            \"type\": \"LineString\",\n            \"coordinates\": [\n              [\n                164,\n                -9\n              ],\n              [\n                168,\n                -9\n              ],\n              [\n                172,\n                -9.5\n              ],\n              [\n                176,\n                -9.5\n              ],\n              [\n                180,\n                -9.5\n              ]\n            ]\n          },\n          \"role\": \"editorial_reference_route\",\n          \"candidate_id\": \"pacific-south-equatorial-countercurrent-western-mean-reference-reach-v1\",\n          \"note\": \"Western mean-circulation reference reach between OSW offshore gates164E and180E. Gates and bends are editorial, not physical origin/termination or source-extracted axis points. Excludes upstream island branches, eastern seasonal extensions, SEC return, STCC and subsurface equatorial jets. No whole-current length.\",\n          \"source_url\": \"https://www.soest.hawaii.edu/oceanography/bo/CQ04.pdf\",\n          \"source_locator\": \"Paragraph2 on PDF page1 and Figure1b/caption on PDF page2: western SECC context and mean0-200m geostrophy relative to1500dbar. Selected page2 pixels actually reviewed on2026-10-27.\",\n          \"source_file_sha256\": \"a8bb517551f04dbe1018a6d5a51817cee4c3e3afaf2d82447bccdab03cef1d85\",\n          \"observation_date\": null,\n          \"layer\": \"Source context: mean0-200m relative zonal geostrophy, referenced to1500dbar. The selected path is not a fixed-depth, absolute-current or observed velocity-core axis.\",\n          \"time_convention\": \"WOA01 mean-field context only. Publication2004 is not an observation date. No dated trajectory or seasonal route reconstructed.\",\n          \"physical_current_axis_admitted\": false,\n          \"physical_state_join_eligible\": false,\n          \"source_id\": \"source:chen-qiu-secc-seasonal-2004\"\n        }\n      ],\n      \"state_evidence\": [],\n      \"connections\": [],\n      \"scope_notes\": [\n        {\n          \"current_id\": \"pacific-south-equatorial-countercurrent\",\n          \"label\": \"Argo seasonal envelope and dateline scope\",\n          \"audit_file\": \"research/pacific-secc-argo-seasonal-extent-scope-audit.json\",\n          \"summary\": \"Source preview reports a spring envelope from 150 E to 170 W and an autumn extension to 140 W. These dateline-crossing spans are not traced current lengths. Spring latitude limits are not paired current edges; full methods, averaging years and calendar months remain unresolved.\",\n          \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2025JC023053?af=R\",\n          \"source_locator\": \"Publisher abstract, Plain Language Summary and Data Availability Statement.\",\n          \"observed_period\": null\n        },\n        {\n          \"current_id\": \"pacific-south-equatorial-countercurrent\",\n          \"label\": \"WOA01 mean flow and seasonal anomaly separation\",\n          \"audit_file\": \"research/pacific-secc-woa01-anomaly-scope-audit.json\",\n          \"summary\": \"Full 2004 paper distinguishes surface and 0-200 m WOA01 geostrophy relative to 1500 dbar, modeled Sverdrup flow, and band-passed seasonal anomaly sections at 170 E. Anomaly zero contours and averaging windows cannot define current widths or endpoints. Numerical compatible flow fields remain needed.\",\n          \"source_url\": \"https://www.soest.hawaii.edu/oceanography/bo/CQ04.pdf\",\n          \"source_locator\": \"Figures 1, 2 and 8; paragraphs 2-3, 20 and 26.\",\n          \"observed_period\": null\n        }\n      ],\n      \"evidence_links\": [\n        {\n          \"label\": \"Pacific SECC western reference and measurement scope\",\n          \"url\": \"pacific-secc-reference-support.html\"\n        }\n      ],\n      \"object_url\": \"object.html?id=current%3Apacific-south-equatorial-countercurrent\",\n      \"route_url\": \"reference-routes.html?atlas-layout=map&atlas-feature=current%3Apacific-south-equatorial-countercurrent&atlas-route=pacific-south-equatorial-countercurrent-western-mean-reference-reach-v1#route-atlas\",\n      \"season_url\": \"seasons.html?current=pacific-south-equatorial-countercurrent\",\n      \"dashboard_search\": \"Pacific South Equatorial Countercurrent Tropical South Pacific\",\n      \"width_ids\": [\n        \"pacific-secc-rotschi-1972-170e-width-range\"\n      ],\n      \"measurement_ids\": [],\n      \"route_ids\": [\n        \"pacific-south-equatorial-countercurrent-western-mean-reference-reach-v1\"\n      ],\n      \"source_ids\": [\n        \"source:4dc5fc618c26565f\",\n        \"source:4f7441b953be4651\",\n        \"source:803229fe82eb2360\",\n        \"source:b038491b0e5a3967\",\n        \"source:cb7e6dd38745baf6\",\n        \"source:chen-qiu-secc-seasonal-2004\",\n        \"source:pacific-secc-western-reference-method-v1\"\n      ],\n      \"state_codes\": [],\n      \"published_length_km\": null,\n      \"width_sample_ids\": [],\n      \"route_decision_ids\": [\n        \"route-decision:pacific-south-equatorial-countercurrent\"\n      ],\n      \"current_section_ids\": [],\n      \"velocity_sample_ids\": []\n    },\n    {\n      \"id\": \"current:pacific-south-subsurface-countercurrent\",\n      \"label\": \"Pacific South Subsurface Countercurrent\",\n      \"type\": \"named_current\",\n      \"identity_level\": \"current\",\n      \"source_kind\": \"eastward subsurface jets south of the Equatorial Undercurrent\",\n      \"setting\": \"equatorial\",\n      \"time_behavior\": \"persistent_variable\",\n      \"basin\": \"Equatorial South Pacific\",\n      \"capabilities\": {\n        \"observed_velocity\": 0,\n        \"radius_evidence\": 0,\n        \"reported_length\": 0,\n        \"reference_route\": 1,\n        \"scoped_width\": 1,\n        \"geometry\": 0,\n        \"time_samples\": 0,\n        \"source_connectivity\": 0,\n        \"scope_notes\": 1,\n        \"dated_diagnostics\": 0,\n        \"flow_network\": 0,\n        \"passage_transport\": 0,\n        \"width_samples\": 0\n      },\n      \"recorded_claims\": 56,\n      \"nasa_links\": 1,\n      \"fingerprint\": \"d32576e1a2cb4ca343e04a2ecd09c4a4ab028ce5de76286fbfbc460e9b3f1bc7\",\n      \"series\": [],\n      \"section_fingerprints\": {\n        \"identity\": \"b7414bf443e8963a5b28ca403c015f93dda386b06a5e6fe57a874c0e5c244f15\",\n        \"sources\": \"3a8e02fd0bf8b562ae4d8bbeaba84aea67b798490a5b40994a03a6751b758022\",\n        \"claims\": \"0
_method\": \"Source angular width transcribed; WGS84 meridional unit conversion centered at reported latitude, rounded to 10 km. Normalization limits are computation only, not observed edges; no source figure digitized.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"remaining_gates\": [\r\n        \"Independent scientific extraction review and canonical admission.\",\r\n        \"Diagnose lateral boundaries and compatible repeated sections before full-width or seasonal dimensions.\"\r\n      ],\r\n      \"phase_label\": \"April 1996 section\",\r\n      \"phase_kind\": \"month_dated_section\",\r\n      \"observed_period\": null,\r\n      \"width_metric_label\": \"author-reported meridional section span\",\r\n      \"observed_month\": \"1996-04\",\r\n      \"time_precision\": \"month\",\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"boundary_sides\": \"author_reported_section_span\",\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"angular_span_conversion\": {\r\n        \"source_reported_latitude_span_degrees\": 2,\r\n        \"source_reported_center_latitude_degrees\": 5,\r\n        \"source_section_longitude_degrees_east\": -35,\r\n        \"method\": \"WGS84_meridional_distance_centered_for_unit_conversion_only\",\r\n        \"normalization_limits_are_observed_edges\": false,\r\n        \"unrounded_distance_km\": 221.16564339691212,\r\n        \"rounding_km\": 10\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"ligurian-menton-nice-composite-profile-band\",\r\n      \"current_id\": \"ligurian\",\r\n      \"name\": \"Ligurian Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_composite_coast_distance_flow_band\",\r\n      \"width_metric\": \"author_reported_offshore_flow_band_span\",\r\n      \"approximate_width_km\": 20,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"Difference between source-reported 15 and 35 km coast-distance limits; those are positions, not a 15–35 km width range, statistical uncertainty or seasonal margin.\",\r\n      \"geographic_scope\": \"Local Menton–Nice Northern Current profile, assigned to the Ligurian regional segment under the OSW ledger convention. Not representative of the whole segment or broader Northern Current.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Source cross-shore coast-distance coordinate in local along-shore velocity profiles; exact flow-normal section geometry unresolved.\",\r\n      \"layer\": \"Surface-flow geography in a study combining CODE drifters following the first metre and ARGOSPHERE drifters following the first 10–20 cm with unquantified wind slip. No full-depth or shelf-break axis diagnosed from the editorial route.\",\r\n      \"time_convention\": \"Intermittent coastal drifter profile composite: June–October 2007 and October–November 2008 source context. No exact local-band sampling dates, continuous observation period or seasonal climatology.\",\r\n      \"boundary_rule\": \"Author describes the main offshore flow band between 15 and 35 km from coast off Menton–Nice. Span is about 20 km; boundary velocity threshold unspecified. Inshore highly variable flow is not silently included.\",\r\n      \"source_url\": \"https://mrea.sincem.unibo.it/images/reports/2011_Poulain_Aspects_of_the_surface_circulation.pdf\",\r\n      \"source_citation\": \"Poulain, Gerin, Rixen, Zanasca, Teixeira, Griffa, Molcard, de Marte and Pinardi (2012), Aspects of the surface circulation in the Liguro-Provencal basin and Gulf of Lion as observed by satellite-tracked drifters (2007–2009), Bollettino di Geofisica Teorica ed Applicata 53(2), 261–279, doi:10.4430/bgta0052.\",\r\n      \"source_locator\": \"Section 4, pp. 273–274, Fig. 9b and Discussion p. 276: local flow between 15 and 35 km from coast; section 2.1 distinguishes surface drifter types.\",\r\n      \"source_retrieved_date\": \"2026-10-03\",\r\n      \"source_evidence_kind\": \"published_composite_surface_velocity_profile\",\r\n      \"extraction_method\": \"Source-reported offshore band positions transcribed; subtract 35 minus 15 km for approximately 20 km local band span. No curve digitized, velocity threshold fitted or map footprint constructed.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"remaining_gates\": [\r\n        \"Independent source-extraction and segment-assignment review.\",\r\n        \"Resolve local physical boundaries and wind slip before an occupied footprint or depth-wide width.\",\r\n        \"Obtain compatible repeated seasonal observations before annual dimension ranges.\"\r\n      ],\r\n      \"phase_label\": \"Menton–Nice surface profile composite\",\r\n      \"phase_kind\": \"ensemble_profile_band\",\r\n      \"observed_period\": null,\r\n      \"width_metric_label\": \"reported offshore flow-band span\",\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"boundary_sides\": \"reported_coast_distance_band_limits\",\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"sampling_windows_are_exact_observation_bounds\": false,\r\n      \"sampling_context_month_windows\": [\r\n        {\r\n          \"start\": \"2007-06\",\r\n          \"end\": \"2007-10\"\r\n        },\r\n        {\r\n          \"start\": \"2008-10\",\r\n          \"end\": \"2008-11\"\r\n        }\r\n      ],\r\n      \"coast_distance_profile\": {\r\n        \"source_reported_band_limits_km\": [\r\n          15,\r\n          35\r\n        ],\r\n        \"span_calculation\": \"farther_minus_nearer_coast_distance\",\r\n        \"boundary_velocity_threshold_m_s\": null,\r\n        \"cross_shore_bin_km\": 4,\r\n        \"along_shore_bin_km\": 30,\r\n        \"cross_shore_overlap_percent\": 50\r\n      },\r\n      \"source_current_label\": \"Northern Current\",\r\n      \"source_parent_current_id\": \"northern-mediterranean\",\r\n      \"segment_assignment_role\": \"OSW_editorial_parent_flow_regional_segment_assignment\"\r\n    },\r\n    {\r\n      \"id\": \"east-greenland-coastal-2004-cape-farewell-threshold-section\",\r\n      \"current_id\": \"east-greenland-coastal\",\r\n      \"name\": \"East Greenland Coastal Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_relative_velocity_section_span\",\r\n      \"width_metric\": \"relative_inner_jet_velocity_threshold_span\",\r\n      \"approximate_width_km\": 30,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"No numeric source width uncertainty or annual range extracted.\",\r\n      \"geographic_scope\": \"Cape Farewell JR105 section 1 near 60 N; not the entire southeast Greenland shelf.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Cross-shelf survey section; exact endpoints not digitized.\",\r\n      \"layer\": \"Gridded absolute geostrophic velocity referenced to shipboard ADCP; no fixed depth averaging layer extracted. The separate 75 m frontal depth scale is not width-layer thickness.\",\r\n      \"time_convention\": \"July-August 2004 JR105 campaign; exact occupation date of section 1 not extracted. Not a recurring summer phase or climatology.\",\r\n      \"boundary_rule\": \"Lateral bounds where velocity decreases to 15% of the maximum inner jet velocity; width scale wobs. The separately defined depth scale uses the 34-isohaline at the bottom.\",\r\n      \"source_url\": \"https://www.whoi.edu/cms/files/Sutherland_EGCC_revised_withfigs_33743.pdf\",\r\n      \"source_citation\": \"Sutherland and Pickart (2008), The East Greenland Coastal Current: Structure, variability, and forcing. Accepted manuscript, Progress in Oceanography.\",\r\n      \"source_locator\": \"Section 2.1: July-August 2004 JR105; Section 2.3: absolute geostrophic velocity reference; Section 3.1, PDF pages 9-10: 15% lateral criterion and Cape Farewell wobs = 30 km.\",\r\n      \"source_retrieved_date\": \"2026-10-03\",\r\n      \"source_evidence_kind\": \"published_observational_analysis\",\r\n      \"extraction_method\": \"Author-reported prose width and threshold transcribed; no section figure or velocity field digitized.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"remaining_gates\": [\r\n        \"Review boundary definition and regional/layer sampling.\",\r\n        \"Obtain comparable repeated observations before seasonal animation or annual range.\",\r\n        \"Canonical measurement admission and release review.\"\r\n      ],\r\n      \"phase_label\": \"2004 Cape Farewell section\",\r\n      \"phase_kind\": \"survey_threshold_section\",\r\n      \"observed_period\": null,\r\n      \"full_width_inference_eligible\": false,\r\n      \"width_metric_label\": \"local section width at 15% of maximum inner jet velocity\",\r\n      \"boundary_sides\": \"paired_relative_velocity_boundaries\",\r\n      \"source_quality_note\": \"Source uses 3-5 km station spacing and 3 km by 10 m gridding. Reported 75 m frontal depth scale is separate; no fine boundary accuracy inferred.\",\r\n      \"velocity_threshold_fraction\": 0.15,\r\n      \"velocity_reference_statistic\": \"maximum_inner_jet_velocity\",\r\n      \"campaign_month_window\": {\r\n        \"start_month\": \"2004-07\",\r\n        \"end_month\": \"2004-08\"\r\n      },\r\n      \"sampling_window_is_exact_section_dates\": false,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_play
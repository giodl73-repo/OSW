nge_km\": null,\r\n      \"range_kind\": \"source_reported_composite_point_no_width_error\",\r\n      \"range_interpretation\": \"One published composite cross-shelf extent; differences among sections are spatial, not annual extrema or confidence limits.\",\r\n      \"geographic_scope\": \"Source section 7: Bellingshausen Sea continental shelf; sections numbered east to west.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Source composite cross-shelf transect; no geographic paired edges transcribed.\",\r\n      \"layer\": \"Geostrophic velocity referenced to 400 m; depth integral from surface to the variable 34.4 psu isohaline, not a fixed 0-400 m layer.\",\r\n      \"time_convention\": \"Historical composite of disjoint seal-profile sampling periods and both seasons; no exact section width dates or monthly width curve extracted.\",\r\n      \"boundary_rule\": \"Coastline or ice-shelf face to the offshore location where depth-integrated velocity is 15% of its value at the current center, identified by maximum gradient of net transport.\",\r\n      \"source_url\": \"https://doi.org/10.5194/tc-15-4179-2021\",\r\n      \"source_citation\": \"Schubert, Thompson, Speer, Schulze Chretien and Bebieva (2021), The Antarctic Coastal Current in the Bellingshausen Sea, The Cryosphere 15, 4179-4199, doi:10.5194/tc-15-4179-2021.\",\r\n      \"source_locator\": \"Final original PDF p11 / printed p4189, Table 2 row 7; Table 1 on p5 / p4183; methods section 2.3 pp4-5; Fig.9 p12 and section 4 p13.\",\r\n      \"source_retrieved_date\": \"2026-10-09\",\r\n      \"source_evidence_kind\": \"published_original_composite_hydrographic_section\",\r\n      \"extraction_method\": \"Published Table 2 and Table 1 values transcribed from visually inspected final original, with source definitions and sampling limits retained.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Composite section 7 (Bellingshausen)\",\r\n      \"phase_kind\": \"coastal_composite_threshold_section\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Published composite section, not a dated synoptic width. Table 1 counts determine sampling composition; section 6 contradicts the prose assertion that all sections except 1 are winter-dominated.\",\r\n      \"remaining_gates\": [\r\n        \"Acquire raw calibrated profiles and reproduce geostrophic reference, moving median and edge extraction.\",\r\n        \"Recover geographic coastline/ice-face and offshore-edge coordinates before footprints or physical state intersections.\",\r\n        \"Compute compatible repeated sections and width errors before annual or seasonal margins.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"aacc_composite_threshold_section\",\r\n        \"section_number\": 7,\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_methods_reviewed\": true,\r\n        \"full_study_reproduced\": false,\r\n        \"temporal_operator\": \"all_available_profiles_moving_median_composite\",\r\n        \"geostrophic_reference_depth_m\": 400,\r\n        \"integration_base_salinity_psu\": 34.4,\r\n        \"integration_base_is_fixed_depth\": false,\r\n        \"offshore_edge_fraction_of_center_integrated_velocity\": 0.15,\r\n        \"geographic_edges_extracted\": false,\r\n        \"map_buffer_eligible\": false,\r\n        \"cross_current_width_inheritance_eligible\": false,\r\n        \"seasonal_calendar_extracted\": false,\r\n        \"profile_period_descriptions\": [\r\n          \"2005 to May 2006\",\r\n          \"2007 to 2010\",\r\n          \"austral summer of 2013 and 2014\",\r\n          \"June 2015\"\r\n        ],\r\n        \"source_properties\": {\r\n          \"cross_shelf_section_length_km\": 280,\r\n          \"cross_shelf_latitude_span_degrees\": 2.5,\r\n          \"moving_median_bin_km\": 28.0,\r\n          \"moving_median_bin_latitude_degrees\": 0.25,\r\n          \"winter_profiles\": 147,\r\n          \"summer_profiles\": 59,\r\n          \"total_profiles\": 206,\r\n          \"winter_months_convention\": [\r\n            4,\r\n            5,\r\n            6,\r\n            7,\r\n            8,\r\n            9\r\n          ],\r\n          \"summer_months_convention\": [\r\n            10,\r\n            11,\r\n            12,\r\n            1,\r\n            2,\r\n            3\r\n          ],\r\n          \"source_mean_depth_m\": 218.0,\r\n          \"source_depth_range_m\": [\r\n            158,\r\n            267\r\n          ],\r\n          \"source_alongshore_transport_sv\": -1.89,\r\n          \"source_mean_geostrophic_velocity_m_s\": -0.041,\r\n          \"source_peak_geostrophic_velocity_m_s\": -0.12,\r\n          \"property_source_locators\": {\r\n            \"sampling\": \"Final original Table 1, PDF p5 / p4183\",\r\n            \"width_depth_transport\": \"Final original Table 2, PDF p11 / p4189\",\r\n            \"velocity\": \"Final original section 4, PDF pp11,13 / pp4189,4191\"\r\n          },\r\n          \"signed_transport_convention\": \"Negative westward, positive eastward; 400 m geostrophic reference.\",\r\n          \"velocity_average_caution\": \"Source calls the cross-current spatial average a simple diagnostic to interpret cautiously.\"\r\n        },\r\n        \"sampling_dominant_season\": \"winter\",\r\n        \"sampling_prose_discrepancy\": false,\r\n        \"sampling_discrepancy_note\": null,\r\n        \"depth_range_is_width_uncertainty\": false,\r\n        \"transport_bootstrap_is_width_uncertainty\": false,\r\n        \"cross_shelf_section_length_is_current_length\": false,\r\n        \"display_title\": \"Composite section 7\",\r\n        \"display_aria_label\": \"Antarctic Coastal Current composite section 7: 111.9 kilometres, coastline or ice-shelf face to the 15% depth-integrated velocity edge. Unsynchronized historical profiles; no annual extrema or width uncertainty supplied.\",\r\n        \"display_caption\": \"Section 7: 111.9 km source-computed composite width. Spatial section, not a seasonal state. Numerical width uncertainty unknown.\",\r\n        \"display_method_note\": \"Moving-median seal-profile composite, 400 m geostrophic reference, surface-to-34.4 psu integration. Table 1 counts retain summer/winter sampling and the section 6 prose discrepancy. No fixed-depth layer, dated edge coordinates or width error supplied.\",\r\n        \"audit_file\": \"research/antarctic-coastal-schubert-2021-composite-width-scope-audit.json\",\r\n        \"audit_sha256\": \"088b17a20ccbc2c99b406675bca7b46c519d08fa671b97d97dc61fbd59e05a5e\",\r\n        \"audit_pointer\": \"/measurements/6\"\r\n      },\r\n      \"width_metric_label\": \"Coast or ice-shelf face to 15% integrated-velocity edge\"\r\n    },\r\n    {\r\n      \"id\": \"deep-western-boundary-richardson-1993-upper-core-zero-width\",\r\n      \"current_id\": \"deep-western-boundary\",\r\n      \"name\": \"Deep Western Boundary Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_lagrangian_composite_zero_velocity_width\",\r\n      \"width_metric\": \"along_isobath_composite_zero_velocity_width\",\r\n      \"approximate_width_km\": 100,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"source_reported_composite_point_no_width_error\",\r\n      \"range_interpretation\": \"Approximate width of the historical upper-core float composite. Repeated 100 km subset entries do not establish constant width, annual extrema or numerical width uncertainty.\",\r\n      \"geographic_scope\": \"Tropical western Atlantic upper-core DWBC; Table 2 selection domain 2 S-12 N west of 43 W; section 3.2 labels a 0-7 N / 12-month composite. Source domains retained without forced equivalence.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Distance seaward of 1800 m isobath; velocity rotated parallel and normal to that contour.\",\r\n      \"layer\": \"Nominal 1800 m SOFAR floats; failed active depth control and source-estimated sinking about 230 m over 21 months. No fixed numerical width layer.\",\r\n      \"time_convention\": \"Table 2 historical composite label January 1989-October 1990, overlapping three unequal subsets. No exact width observation dates or recurring seasonal calendar extracted.\",\r\n      \"boundary_rule\": \"Width between zero-velocity points in the composite along-boundary velocity profile, flanked by weak counterflow/recirculation; 10 km averaging bins do not supply a width error.\",\r\n      \"source_url\": \"https://doi.org/10.1029/93JC00051\",\r\n      \"source_citation\": \"Richardson, P. L. and Schmitz, W. J., Jr. (1993), Deep Cross-Equatorial Flow in the Atlantic Measured With SOFAR Floats, Journal of Geophysical Research 98(C5), 8371-8387, doi:10.1029/93JC00051.\",\r\n      \"source_locator\": \"Final original PDF p5 / printed p8375, section 3.2 continuation; Table 2 PDF p8 / p8378; nominal depth and processing p2; subset sampling p6 and Figure 6 p7.\",\r\n      \"source_retrieved_date\": \"2026-10-09\",\r\n      \"source_evidence_kind\": \"published_original_lagrangian_velocity_composite\",\r\n      \"extraction_method\": \"Visually reviewed numerical passage, Table 2 and methods transcribed; no plot-edge digitization or raw velocity recalculation.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Historical upper-core float composite\",\r\n      \"phase_kind\": \"lagrangian_composite_zero_velocity_width\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Composite and subset sampling are sparse and nonuniform. Nominal float depths drifted. Source-label and count inconsistencies are preserved; velocity/transport standard errors are not width errors.\",\r\n      \"remaining_gates\": [\r\n        \"Acquire and reprocess raw calibrated float records with their changing depths.\",\r\n        \"Recover geographically supported zero-velocity edges before footprints or physical state intersections.\",\r\n        \"Repeated compatible sections and width errors before annual margins or seasonal playback.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"width_metric_label\": \"Zero-velocity width of along-isobath float composite\",\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"dwbc_upper_core_float_composite\",\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_methods_reviewed\": true,\r\n        \"full_study_reproduced\": false,\r\n        \"temporal_operator\": \"nonuniform_historical_lagrangian_composite\",\r\n        \"nominal_float_depth_m\": 1800,\r\n        \"nominal_depth_is_fixed_layer\": false,\r\n        \"source_estimated_float_sinking_m\": 230,\r\n        \"averaging_bin_km\": 10,\r\n        \"bin_size_is_width_uncertainty\": false,\r\n        \"velocity_errors_are_width_uncertainty\": false,\r\n        \"transport_errors_are_width_uncertainty\": false,\r\n        \"geographic_edges_extracted\": false,\r\n        \"map_buffer_eligible\": false,\r\n        \"cross_current_width_inheritance_eligible\": false,\r\n        \"seasonal_calendar_extracted\": false,\r\n        \"source_table_rows\": [\r\n          {\r\n            \"period_label\": \"Composite: Jan 1989-Oct 1990\",\r\n            \"current_width_km\": 100,\r\n            \"floats_in_current\": 8,\r\n            \"observations_in_current\": 500,\r\n            \"peak_individual_velocity_range_cm_s\": [\r\n              50,\r\n              60\r\n            ],\r\n            \"maximum_bin_average_velocity_cm_s\": 26,\r\n            \"maximum_bin_average_standard_error_cm_s\": 5,\r\n            \"transport_per_unit_depth_10_3_m2_s\": 14,\r\n            \"transport_per_unit_depth_standard_error_10_3_m2_s\": 3,\r\n            \"total_volume_transport_sv\": 15\r\n          },\r\n          {\r\n            \"period_label\": \"Jan 1989-Oct 1989\",\r\n            \"current_width_km\": 100,\r\n            \"floats_in_current\": 4,\r\n            \"observations_in_current\": 124,\r\n            \"peak_individual_velocity_range_cm_s\": [\r\n              50,\r\n              60\r\n            ],\r\n            \"maximum_bin_average_velocity_cm_s\": 39,\r\n            \"maximum_bin_average_standard_error_cm_s\": 5,\r\n            \"transport_per_unit_depth_10_3_m2_s\": 23,\r\n            \"transport_per_unit_depth_standard_error_10_3_m2_s\": 4,\r\n            \"total_volume_transport_sv\": null,\r\n            \"sampling_qualification\": \"Table 2 footnote: first subset sampled DWBC January-March 1989, with an offshore data gap between 90 and 130 km; transport may be underestimated and width/transport could be larger. Gap endpoints are not current edges or a width range.\"\r\n          },\r\n          {\r\n            \"period_label\": \"Nov 1989-Apr 1990\",\r\n            \"current_width_km\": 100,\r\n            \"floats_in_current\": 3,\r\n            \"observations_in_current\": 188,\r\n            \"peak_individual_velocity_range_cm_s\": [\r\n              40,\r\n              50\r\n            ],\r\n            \"maximum_bin_average_velocity_cm_s\": 30,\r\n            \"maximum_bin_average_standard_error_cm_s\": 4,\r\n            \"transport_per_unit_depth_10_3_m2_s\": 16,\r\n            \"transport_per_unit_depth_standard_error_10_3_m2_s\": 3,\r\n            \"total_volume_transport_sv\": null\r\n          },\r\n          {\r\n            \"period_label\": \"May 1990-Oct 1990\",\r\n            \"current_width_km\": 100,\r\n            \"floats_in_current\": 3,\r\n            \"observations_in_current\": 177,\r\n            \"peak_individual_velocity_range_cm_s\": [\r\n              30,\r\n              40\r\n            ],\r\n            \"maximum_bin_average_velocity_cm_s\": 19,\r\n            \"maximum_bin_average_standard_error_cm_s\": 6,\r\n            \"transport_per_unit_depth_10_3_m2_s\": 8,\r\n            \"transport_per_unit_depth_standard_error_10_3_m2_s\": 2,\r\n            \"total_volume_transport_sv\": null\r\n          }\r\n        ],\r\n        \"source_table_locator\": \"Table 2, original PDF p8 / printed p8378\",\r\n        \"source_scope_discrepancy_note\": \"Table 2 labels 2 S-12 N west of 43 W; section 3.2 describes 0-7 N and 12 months. Historical composite period labels remain source-specific.\",\r\n        \"subset_observation_count_sum\": 489,\r\n        \"composite_observation_count\": 500,\r\n        \"subset_counts_additive\": false,\r\n        \"subset_count_discrepancy_note\": \"Published subset observation counts 124+188+177 total 489, not composite 500. No adjustment or missing-record explanation inferred.\",\r\n        \"source_sampling_gap_label\": \"No floats drifted in the boundary current April-December 1989 (Figure 4 caption).\",\r\n        \"gap_means_current_absent\": false,\r\n        \"independent_subset_width_edges_extracted\": false,\r\n        \"source_prose_transport_per_unit_depth_10_3_m2_s\": 13.8,\r\n        \"alternative_subset_based_transport_standard_error_10_3_m2_s\": 4,\r\n        \"source_total_volume_transport_unrounded_sv\": 14.7,\r\n        \"volume_transport_support_note\": \"Total transport couples float horizontal profile with an independent current-meter profile, assumes elliptical shape and integrates 900-2800 m. These are transport construction bounds, not the width layer.\",\r\n        \"display_title\": \"Upper-core float-composite width\",\r\n        \"display_aria_label\": \"Deep Western Boundary Current upper-core float composite: approximately 100 kilometres between zero-velocity points. Nominal drifting 1800 m floats, nonuniform historical samples; width uncertainty unknown.\",\r\n        \"display_caption\": \"Approximately 100 km source composite width. All four Table 2 rows repeat 100 km; no independent temporal edge series, annual margins or width error supplied.\",\r\n        \"display_method_note\": \"Along-isobath velocity averaging in 10 km bins. Nominal float depth is not a fixed layer. Historical subset speeds and transport have their own standard errors; those do not measure width uncertainty.\",\r\n        \"first_subset_sampling_qualification\": \"Table 2 footnote: first subset sampled DWBC January-March 1989, with an offshore data gap between 90 and 130 km; transport may be underestimated and width/transport could be larger. Gap endpoints are not current edges or a width range.\",\r\n        \"audit_file\": \"research/dwbc-richardson-1993-upper-core-width-scope-audit.json\",\r\n        \"audit_sha256\": \"d3e078458894787b8a812589c48cb96263f2d6a867656840e173410f73712515\",\r\n        \"source_figure_view_extent_lon_lat\": [\r\n          -55,\r\n          -5,\r\n          -10,\r\n          15\r\n        ],\r\n        \"geographic_view_role\": \"figure_viewport_context_only\",\r\n        \"geographic_view_source_locator\": \"Source Figure 2, original PDF p4 / printed p8374, longitude/latitude frame. Viewport only; publisher trajectories not digitized or reproduced.\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"pacific-neuc-li-2018-southern-isopycnal-breadth\",\r\n      \"current_id\": \"pacific-north-equatorial-undercurrent\",\r\n      \"name\": \"Pacific North Equatorial Undercurrent\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_isopycnal_component_angular_breadth\",\r\n      \"width_metric\": \"author_reported_component_meridional_breadth\",\r\n      \"approximate_width_km\": 330,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"source_approximate_component_point_no_width_error\",\r\n      \"range_interpretation\": \"Southern and northern component breadths differ in the same climatological mean. They are not a single-current width range or annual minimum/maximum.\",\r\n      \"geographic_scope\": \"Pacific NEUC southern/northern quasi-stationary jet components in the Argo mean; no fixed width section longitude or paired endpoints supplied.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Meridional latitude breadth; flow-normal span unresolved for tilting jets.\",\r\n      \"layer\": \"27.0 sigma-theta potential-density-anomaly surface (kg/m3), with spatially varying depth; no fixed numeric depth layer.\",\r\n      \"time_convention\": \"Argo 2004-2014 climatological mean, year precision only. Not LICOM/SODA 1969-2007, exact observation dates or a seasonal calendar.\",\r\n      \"boundary_rule\": \"Approximate component breadth reported in Mean Structures of NEUCs prose. Width edge criterion and endpoints are not supplied. Figure 1 zero contours are not digitized width boundaries.\",\r\n      \"source_url\": \"https://doi.org/10.1038/s41598-018-35469-2\",\r\n      \"source_citation\": \"Li, Y., Liu, H. and Lin, P. (2018), Interannual and decadal variability of the North Equatorial Undercurrents in an eddy-resolving ocean model, Scientific Reports 8, 17112, doi:10.1038/s41598-018-35469-2.\",\r\n      \"source_locator\": \"Complete JATS Results / Mean Structures of NEUCs, first paragraph, Figure 1(a) and caption; Methods / Observati
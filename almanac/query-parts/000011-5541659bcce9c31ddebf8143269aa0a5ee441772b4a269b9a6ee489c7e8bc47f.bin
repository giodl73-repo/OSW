er inspected. Coarse station sampling and geographic southern boundary limit interpretation. Underlying 1976 section study and raw stations not independently reproduced; mixed range units unresolved.\",\r\n      \"remaining_gates\": [\r\n        \"Recover original section stations and paired velocity-edge rule.\",\r\n        \"Resolve the historical upper-endpoint mile unit.\",\r\n        \"Obtain compatible repeats before annual margins; independent scientific review.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"dated_geostrophic_mainstream_section\",\r\n        \"width_passage_visually_inspected\": true,\r\n        \"underlying_width_methods_reviewed\": false,\r\n        \"full_study_reproduced\": false,\r\n        \"source_observed_month\": \"1974-10\",\r\n        \"section_longitude_degrees_east\": -67,\r\n        \"southern_limit_latitude_degrees_north\": 12,\r\n        \"southern_limit_kind\": \"author_selected_Los_Roques_geographic_limit\",\r\n        \"reference_pressure_dbar\": 1600,\r\n        \"reference_pressure_is_width_layer\": false,\r\n        \"typical_station_spacing_nautical_miles\": 60,\r\n        \"station_spacing_is_width_uncertainty\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"map_buffer_eligible\": false,\r\n        \"historical_maximum_is_annual_extremum\": false,\r\n        \"range_context\": {\r\n          \"raw_endpoints\": [\r\n            108,\r\n            225\r\n          ],\r\n          \"raw_units\": [\r\n            \"nautical_miles\",\r\n            \"miles_unqualified\"\r\n          ],\r\n          \"upper_unit_resolved\": false,\r\n          \"normalized_range_km\": null,\r\n          \"source_figure_year_labels\": [\r\n            1973,\r\n            1974,\r\n            1975\r\n          ]\r\n        },\r\n        \"speed_context\": {\r\n          \"associated_october_1974_cm_s\": 66,\r\n          \"associated_october_1974_m_s\": 0.66,\r\n          \"reported_mainstream_speed_range_cm_s\": [\r\n            41,\r\n            76\r\n          ],\r\n          \"reported_mainstream_speed_range_m_s\": [\r\n            0.41,\r\n            0.76\r\n          ],\r\n          \"operator\": \"author_reported_geostrophic_station_pair_surface_speeds\",\r\n          \"is_width_uncertainty\": false\r\n        },\r\n        \"protocol_file\": \"plans/caribbean-dated-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"be2d9e1fc2085218aee4b12b46cada09dc3c5b10776894b44d0c77ebfe5f8a4f\",\r\n        \"display_title\": \"October 1974 mainstream section\",\r\n        \"display_aria_label\": \"Caribbean Current: approximately 410 km reported mainstream span at 67 W in October 1974. Southern limit fixed at Los Roques; paired velocity boundaries unresolved. No annual range or uncertainty supplied.\",\r\n        \"display_caption\": \"October 1974 at 67 W: approximately 410 km author-reported mainstream span, with associated surface-geostrophic speed 0.66 m/s. Reference pressure 1600 dbar is not a depth slab. Numerical uncertainty and annual range unknown.\",\r\n        \"display_method_note\": \"Southern limit fixed at Los Roques, 12 N; typical stations 60 nautical miles apart. The separate historical 108 nautical miles to 225 miles range retains an unresolved upper unit. No mapped edges or seasonal animation inferred.\",\r\n        \"audit_file\": \"research/caribbean-duncan-1982-dated-width-scope-audit.json\",\r\n        \"audit_sha256\": \"e9abd7a125b736381a2e29313fc30c2feac6711943ec5f35780d287f51fc9d2c\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"hiri-hughes-1993-1987-07-local-decay-scale\",\r\n      \"current_id\": \"hiri-current\",\r\n      \"name\": \"Hiri Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"width_metric\": \"author_reported_e_folding_scale\",\r\n      \"width_metric_label\": \"local e-folding scale\",\r\n      \"approximate_width_km\": 50,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"dated_local_point_descriptor_not_temporal_range\",\r\n      \"range_interpretation\": \"Author-reported local descriptor. No statistical error, full-current inference or annual range supplied.\",\r\n      \"geographic_scope\": \"A87 northern transect near Rossel Island, southern Papua coast, looking from the east.\",\r\n      \"layer\": \"Thermal-wind cross-section context; no numerical fixed-depth width layer. Transport integration to 1500 dbar does not define the width support.\",\r\n      \"time_convention\": \"July 1987 cruise occupation; exact day unresolved. Different reaches and years are not a recurring seasonal series.\",\r\n      \"boundary_rule\": \"Author e-folding scaling width; lateral fit, reference velocity and paired velocity edges not independently reconstructed. No theoretical full-width multiplier.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Author cross-section descriptor; no independent perpendicular correction or paired edge extraction.\",\r\n      \"source_url\": \"https://researchonline.jcu.edu.au/46216/1/46216-hughes-1993-thesis.pdf\",\r\n      \"source_citation\": \"Hughes, R.D. (1993), An Investigation of the Coral Sea with an Ocean General Circulation Model, PhD thesis, James Cook University of North Queensland, December 1993.\",\r\n      \"source_locator\": \"Printed p70 / PDF86; Figure 3.15 printed p69 / PDF85; methods pp65-67 / PDF81-83.\",\r\n      \"source_retrieved_date\": \"2026-10-13\",\r\n      \"source_evidence_kind\": \"primary_thesis_author_reported_local_geostrophic_decay_scale\",\r\n      \"extraction_method\": \"Numerical prose descriptor transcribed from reviewed original. Source figures inspected for context only; no curve or velocity boundaries digitized.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"July 1987 TEW287 A87 e-folding scale\",\r\n      \"observed_month\": \"1987-07\",\r\n      \"time_precision\": \"month\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Primary thesis inspected. Cross-section e-folding scalar has no supplied numeric error or reconstructed edges. Historical source naming and reference velocity require scope-specific interpretation.\",\r\n      \"remaining_gates\": [\r\n        \"Independent review of source naming, metric and local support before canonical admission.\",\r\n        \"Acquire raw sections and paired velocity edges for any full width; obtain compatible repeats before annual ranges.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"dated_local_descriptor\",\r\n        \"protocol_file\": \"plans/hiri-east-adriatic-local-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"5bfdc5c7027e15bd8ef56b321bb30f41cb21db6d6881d0b26e14d213bc5b6a53\",\r\n        \"width_range_is_annual\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"source_figures_digitized\": false,\r\n        \"full_width_conversion_admitted\": false,\r\n        \"evidence_class\": \"primary_thesis_author_reported_local_geostrophic_decay_scale\",\r\n        \"observed_month\": \"1987-07\",\r\n        \"time_precision\": \"month\",\r\n        \"historical_name_scope\": \"Hughes introduction p13 / PDF29 calls chapter 3 Hiri Current. Chapter3 uses NGCU for a broader Coral Sea circulation under presumed Vitiaz connectivity. Only this southern-Papua study reach is indexed under Hiri; no modern north-coast NGCU alias or whole-circulation equivalence admitted.\",\r\n        \"source_named_flow\": \"Hiri in introduction; Coral Sea NGCU convention in chapter 3\",\r\n        \"source_section\": \"TEW287 A87\",\r\n        \"is_e_folding_scale\": true,\r\n        \"is_full_edge_to_edge_width\": false,\r\n        \"is_gaussian_sigma\": false,\r\n        \"numerical_width_error_supplied\": false,\r\n        \"same_site_repeat_pair\": false,\r\n        \"two_july_cases_are_seasonal_extrema\": false,\r\n        \"transport_reference_pressure_is_width_layer\": false,\r\n        \"velocity_operator\": \"author thermal-wind/geostrophic section analysis with reference-velocity assumptions; not independently reconstructed absolute ADCP velocity edges\",\r\n        \"display_title\": \"July 1987 TEW287 A87 e-folding scale\",\r\n        \"display_aria_label\": \"Hiri under Hughes historical southern-Papua convention: 50 km reported local e-folding scale in July 1987. Not full current width or annual range.\",\r\n        \"display_caption\": \"July 1987, TEW287 A87: approximately 50 km author-reported decay scale. A decay scale describes how rapidly the cross-section velocity decreases; it is not a full edge-to-edge width.\",\r\n        \"display_method_note\": \"Historical Hiri/Coral Sea NGCU source convention; northern modern NGCU is not assigned this value. July 1987 and July 1990 are different years and reaches, not seasonal extrema. Width depth support and paired boundaries unresolved.\",\r\n        \"quality_note\": \"Primary thesis inspected. Cross-section e-folding scalar has no supplied numeric error or reconstructed edges. Historical source naming and reference velocity require scope-specific interpretation.\",\r\n        \"audit_file\": \"research/hiri-hughes-1993-local-decay-scales-scope-audit.json\",\r\n        \"audit_sha256\": \"a4db684cf25734a0519e902115cd9197e1c6f41e0d0097c4a0e7073dc0698084\",\r\n        \"audit_pointer\": \"/measurements/0\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"hiri-hughes-1993-1990-07-local-decay-scale\",\r\n      \"current_id\": \"hiri-current\",\r\n      \"name\": \"Hiri Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"width_metric\": \"author_reported_e_folding_scale\",\r\n      \"width_metric_label\": \"local e-folding scale\",\r\n      \"approximate_width_km\": 75,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"dated_local_point_descriptor_not_temporal_range\",\r\n      \"range_interpretation\": \"Author-reported local descriptor. No statistical error, full-current inference or annual range supplied.\",\r\n      \"geographic_scope\": \"Eastern B90 transect across the Coral Sea between southern Papua and Queensland Plateau; detached current core context about 160 km offshore.\",\r\n      \"layer\": \"Thermal-wind cross-section context; no numerical fixed-depth width layer. Transport integration to 1500 dbar does not define the width support.\",\r\n      \"time_convention\": \"July 1990 cruise occupation; exact day unresolved. Different reaches and years are not a recurring seasonal series.\",\r\n      \"boundary_rule\": \"Author e-folding scaling width; lateral fit, reference velocity and paired velocity edges not independently reconstructed. No theoretical full-width multiplier.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Author cross-section descriptor; no independent perpendicular correction or paired edge extraction.\",\r\n      \"source_url\": \"https://researchonline.jcu.edu.au/46216/1/46216-hughes-1993-thesis.pdf\",\r\n      \"source_citation\": \"Hughes, R.D. (1993), An Investigation of the Coral Sea with an Ocean General Circulation Model, PhD thesis, James Cook University of North Queensland, December 1993.\",\r\n      \"source_locator\": \"Printed p73 / PDF89; Figure 3.18 printed p75 / PDF91; July 1990 cruise map printed p74 / PDF90.\",\r\n      \"source_retrieved_date\": \"2026-10-13\",\r\n      \"source_evidence_kind\": \"primary_thesis_author_reported_local_geostrophic_decay_scale\",\r\n      \"extraction_method\": \"Numerical prose descriptor transcribed from reviewed original. Source figures inspected for context only; no curve or velocity boundaries digitized.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"July 1990 Fr0690 B90 e-folding scale\",\r\n      \"observed_month\": \"1990-07\",\r\n      \"time_precision\": \"month\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Primary thesis inspected. Cross-section e-folding scalar has no supplied numeric error or reconstructed edges. Historical source naming and reference velocity require scope-specific interpretation.\",\r\n      \"remaining_gates\": [\r\n        \"Independent review of source naming, metric and local support before canonical admission.\",\r\n        \"Acquire raw sections and paired velocity edges for any full width; obtain compatible repeats before annual ranges.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"dated_local_descriptor\",\r\n        \"protocol_file\": \"plans/hiri-east-adriatic-local-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"5bfdc5c7027e15bd8ef56b321bb30f41cb21db6d6881d0b26e14d213bc5b6a53\",\r\n        \"width_range_is_annual\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"source_figures_digitized\": false,\r\n        \"full_width_conversion_admitted\": false,\r\n        \"evidence_class\": \"primary_thesis_author_reported_local_geostrophic_decay_scale\",\r\n        \"observed_month\": \"1990-07\",\r\n        \"time_precision\": \"month\",\r\n        \"historical_name_scope\": \"Hughes introduction p13 / PDF29 calls chapter 3 Hiri Current. Chapter3 uses NGCU for a broader Coral Sea circulation under presumed Vitiaz connectivity. Only this southern-Papua study reach is indexed under Hiri; no modern north-coast NGCU alias or whole-circulation equivalence admitted.\",\r\n        \"source_named_flow\": \"Hiri in introduction; Coral Sea NGCU convention in chapter 3\",\r\n        \"source_section\": \"Fr0690 B90\",\r\n        \"is_e_folding_scale\": true,\r\n        \"is_full_edge_to_edge_width\": false,\r\n        \"is_gaussian_sigma\": false,\r\n        \"numerical_width_error_supplied\": false,\r\n        \"same_site_repeat_pair\": false,\r\n        \"two_july_cases_are_seasonal_extrema\": false,\r\n        \"transport_reference_pressure_is_width_layer\": false,\r\n        \"velocity_operator\": \"author thermal-wind/geostrophic section analysis with reference-velocity assumptions; not independently reconstructed absolute ADCP velocity edges\",\r\n        \"display_title\": \"July 1990 Fr0690 B90 e-folding scale\",\r\n        \"display_aria_label\": \"Hiri under Hughes historical southern-Papua convention: 75 km reported local e-folding scale in July 1990. Not full current width or annual range.\",\r\n        \"display_caption\": \"July 1990, Fr0690 B90: approximately 75 km author-reported decay scale. A decay scale describes how rapidly the cross-section velocity decreases; it is not a full edge-to-edge width.\",\r\n        \"display_method_note\": \"Historical Hiri/Coral Sea NGCU source convention; northern modern NGCU is not assigned this value. July 1987 and July 1990 are different years and reaches, not seasonal extrema. Width depth support and paired boundaries unresolved.\",\r\n        \"quality_note\": \"Primary thesis inspected. Cross-section e-folding scalar has no supplied numeric error or reconstructed edges. Historical source naming and reference velocity require scope-specific interpretation.\",\r\n        \"core_depth_context_m\": 350,\r\n        \"core_depth_is_width_layer\": false,\r\n        \"audit_file\": \"research/hiri-hughes-1993-local-decay-scales-scope-audit.json\",\r\n        \"audit_sha256\": \"a4db684cf25734a0519e902115cd9197e1c6f41e0d0097c4a0e7073dc0698084\",\r\n        \"audit_pointer\": \"/measurements/1\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"east-adriatic-pasaric-2019-c1-coastal-inflow-extent\",\r\n      \"current_id\": \"east-adriatic\",\r\n      \"name\": \"East Adriatic Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"width_metric\": \"author_reported_coastal_inflow_extent\",\r\n      \"width_metric_label\": \"local coastal inflow extent\",\r\n      \"approximate_width_km\": 10,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"dated_local_point_descriptor_not_temporal_range\",\r\n      \"range_interpretation\": \"Author-reported local descriptor. No statistical error, full-current inference or annual range supplied.\",\r\n      \"geographic_scope\": \"Primosten southwestward cross-section over the Middle Adriatic Pit, between Blitvenica and Jabuka; first approximately 10 km from the eastern coast.\",\r\n      \"layer\": \"Vessel ADCP sampled 10-70 m in 4 m bins; author does not specify paired edges at a fixed depth. Figure 1 arrows represent 10 m despite surface placement.\",\r\n      \"time_convention\": \"C1 cruise 24-28 May 2017; plotted section28 May 2017. Numeric prose extent belongs to C1; exact width occupation day unresolved. C2 June 2018 is not a second numeric width.\",\r\n      \"boundary_rule\": \"Author-described limit of coastal inflow belonging to EAC; no numerical velocity threshold, coastline-edge reconstruction or perpendicular correction extracted.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Author cross-section descriptor; no independent perpendicular correction or paired edge extraction.\",\r\n      \"source_url\": \"https://www.ciesm.org/online/archives/abstracts/pdf/42/CIESM_Congress_Volume_42.pdf#page=38\",\r\n      \"source_citation\": \"Pasaric, Z., H. Mihanovic and M. Orlic (2019), Spatial variability of pycnocline in the springtime East Adriatic, Rapp. Comm. int. Mer Medit. 42, p38. Complete congress abstract volume retained; only the one-page authored abstract reviewed.\",\r\n      \"source_locator\": \"CIESM volume 42 (2019), printed p38 / PDF 38, methods and final current paragraph; Figure 1 caption.\",\r\n      \"source_retrieved_date\": \"2026-10-13\",\r\n      \"source_evidence_kind\": \"primary_conference_abstract_local_ADCP_inflow_description\",\r\n      \"extraction_method\": \"Numerical prose descriptor transcribed from reviewed original. Source figures inspected for context only; no curve or velocity boundaries digitized.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"May 2017 C1 coastal inflow extent\",\r\n      \"observed_month\": null,\r\n      \"time_precision\": \"cruise_interval_context_exact_width_day_unresolved\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Author conference abstract and figure inspected; one local reported extent, no raw ADCP data or thresholded boundary pair. Exact width day and width at each sampled depth not independently resolved.\",\r\n      \"remaining_gates\": [\r\n        \"Independent review of source naming, metric and local support before canonical admission.\",\r\n        \"Acquire raw sections and paired velocity edges for any full width; obtain compatible repeats before annual ranges.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"dated_local_descriptor\",\r\n        \"protocol_file\": \"plans/hiri-east-adriatic-local-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"5bfdc5c7027e15bd8ef56b321bb30f41cb21db6d6881d0b26e14d213bc5b6a53\",\r\n        \"width_range_is_annual\": false,\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"source_figures_digitized\": false,\r\n        \"full_width_conversion_admitted\": false,\r\n        \"evidence_class\": \"primary_conference_abstract_local_ADCP_inflow_description\",\r\n        \"time_precision\": \"cruise_interval_context_exact_width_day_unresolved\",\r\n        \"cruise_period\": {\r\n          \"start\": \"2017-05-24\",\r\n          \"end\": \"2017-05-28\"\r\n        },\r\n        \"figure_section_date\": \"2017-05-28\",\r\n        \"figure_date_is_exact_width_day\": false,\r\n        \"instrument_sample_depth_bounds_m\": [\r\n          10,\r\n          70\r\n        ],\r\n        \"instrument_bin_size_m\": 4,\r\n        \"instrument_depth_bounds_are_fixed_width_layer\": false,\r\n        \"figure_vector_depth_m\": 10,\r\n        \"figure_surface_placement_is_measurement_depth\": false,\r\n        \"comparison_cruise_period\": {\r\n          \"start\": \"2018-06-04\",\r\n          \"end\": \"2018-06-08\"\r\n        },\r\n        \"comparison_cruise_numeric_current_width_km\": null,\r\n        \"pycnocline_upwelling_extent_km\": 20,\r\n        \"pycnocline_extent_is_current_width\": false,\r\n        \"is_full_edge_to_edge_width\": false,\r\n        \"numerical_width_error_supplied\": false,\r\n        \"display_title\": \"May 2017 C1 coastal inflow extent\",\r\n        \"display_aria_label\": \"East Adriatic Current: about 10 km coastal inflow extent during 24-28 May 2017 near Primosten. Local ADCP description, not whole-current or annual width.\",\r\n        \"display_caption\": \"C1, 24-28 May 2017: inflow identified as part of EAC was confined to roughly the first 10 km offshore. This is a local coastal extent, with exact width occupation day unresolved.\",\r\n        \"display_method_note\": \"ADCP sampled 10-70 m; plotted surface arrows represent 10 m. The 20 km upwelling/pycnocline extent is a different object. C2 supplies no numeric EAC width, so no annual or seasonal range is inferred.\",\r\n        \"quality_note\": \"Author conference abstract and figure inspected; one local reported extent, no raw ADCP data or thresholded boundary pair. Exact width day and width at each sampled depth not independently resolved.\",\r\n        \"audit_file\": \"research/east-adriatic-pasaric-2019-inflow-extent-scope-audit.json\",\r\n        \"audit_sha256\": \"d5e5d83fb84cd1243a5a4dd44b4dd3104ed2dd6c61276d29146b2bfda60e4993\",\r\n        \"audit_pointer\": \"/measurements/0\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"pacific-secc-rotschi-1972-170e-width-range\",\r\n      \"current_id\": \"pacific-south-equatorial-countercurrent\",\r\n      \"name\": \"Pacific South Equatorial Countercurrent\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"width_metric\": \"author_reported_geostrophic_current_width_range\",\r\n      \"width_metric_label\": \"historical local geostrophic width range\",\r\n      \"approximate_width_km\": null,\r\n      \"width_range_km\": [\r\n        300,\r\n        900\r\n      ],\r\n      \"range_kind\": \"reported_historical_cruise_width_span\",\r\n      \"range_interpretation\": \"Historical local source range across cruise-study context. Endpoint occupations, statistical uncertainty and annual extrema unresolved; no midpoint selected.\",\r\n      \"geographic_scope\": \"170 E meridional sections, geostrophic SECC near 10 S. Excludes South Tropical Countercurrent south of 15 S and the subsurface/equatorial Cromwell extensions.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Meridional source sections; no independently reconstructed edges or flow-normal correction.\",\r\n      \"layer\": \"Author geostrophic-current envelope with broad vertical support; exact width depth and reference level unresolved. Speeds above 10 cm/s generally within upper 300 m is a separate statement, not a 0–300 m width slab.\",\r\n      \"time_convention\": \"November 1965–May 1968 Bora/Cyclone cruise-study context. No individual dates assigned to width range endpoints; not seasonal climatology or annual extrema.\",\r\n      \"boundary_rule\": \"Author-reported geostrophic current width; exact velocity cutoff, paired lateral coordinates and reference level not specified in the inspected descriptor. Direct equatorial meters referenced to 500 m are a different method.\",\r\n      \"source_url\": \"https://horizon.documentation.ird.fr/exl-doc/pleins_textes/divers20-05/010028590.pdf#page=13\",\r\n      \"source_citation\": \"Rotschi, H., Hisard, Ph. and Jarrige, F. (1972), The Water Masses of the Western Pacific at 170 E, between 20 S and 4 N, Survey Paper No. 15, Horace Lamb Centre / ORSTOM, advanced English adaptation. Preface dated 10 May 1972.\",\r\n      \"source_locator\": \"Current discussion printed p10 / PDF13; cruise context printed pp3–4 / PDF6–7; method distinction printed p6 / PDF9; title/preface PDF1–2.\",\r\n      \"source_retrieved_date\": \"2026-10-13\",\r\n      \"source_evidence_kind\": \"primary_historical_geostrophic_section_width_summary\",\r\n      \"extraction_method\": \"Range transcribed from visually reviewed original prose. No source figure or velocity boundaries digitized.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Historical Pacific SECC width range at 170 E\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"time_precision\": \"multicruise_context_width_endpoint_dates_unresolved\",\r\n      \"source_quality_note\": \"Complete original report inspected. Repeated historical geostrophic sections support an author width range; raw boundary calculations and endpoint occupations were not recovered.\",\r\n      \"remaining_gates\": [\r\n        \"Resolve geostrophic reference level, width layer and paired boundary criterion before physical comparison.\",\r\n        \"Recover range endpoint occupations and compatible repeated sections before annual or seasonal dimensions.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"historical_geostrophic_cruise_range\",\r\n        \"source_reported_core_latitude_neighborhood_south\": 10,\r\n        \"source_section_longitude_east\": 170,\r\n        \"source_quoted_current_name\": \"South Equatorial Countercurrent\",\r\n        \"source_width_range_km\": [\r\n          300,\r\n          900\r\n        ],\r\n        \"width_range_is_annual\": false,\r\n        \"range_endpoints_assigned_to_cruises\": false,\r\n        \"paired_velocity_boundaries_extracted\": false,\r\n        \"source_figures_digitized\": false,\r\n        \"uniform_300m_width_layer_admitted\": false,\r\n        \"direct_meter_500m_reference_transferred\": false,\r\n        \"geostrophic_reference_level_resolved\": false,\r\n        \"study_period_months\": [\r\n          \"1965-11\",\r\n          \"1968-05\"\r\n        ],\r\n        \"survey_cruise_count\": 11,\r\n        \"evidence_class\": \"primary_historical_geostrophic_section_width_summary\",\r\n        \"time_precision\": \"multicruise_context_width_endpoint_dates_unresolved\",\r\n        \"display_title\": \"Historical Pacific SECC width range at 170 E\",\r\n        \"display_aria_label\": \"Pacific SECC near 10 S at 170 E: source-reported historical 300 to 900 km width range. No midpoint, annual extrema, paired mapped boundaries or numerical uncertainty supplied.\",\r\n        \"display_caption\": \"Near 10 S at 170 E: 300–900 km geostrophic-current width description from the 1965–1968 cruise study. The range endpoints are not assigned to individual cruise dates; no midpoint or annual range inferred.\",\r\n        \"display_method_note\": \"This SECC is distinct from the deeper equatorial/subsurface extensions and the South Tropical Countercurrent south of 15 S. Width layer, geostrophic reference level and paired boundary criterion remain unresolved. The upper-300 m speed statement and direct current-meter 500 m reference are separate descriptors.\",\r\n        \"quality_note\": \"Complete original report inspected. Repeated historical geostrophic sections support an author width range; raw boundary calculations and endpoint occupations were not recovered.\",\r\n        \"source_pdf_sha256\": \"f2d8d1c8ba9655146319829b942278a13ac792b4a634e6d547a2cd17bc6b24fe\",\r\n        \"protocol_file\": \"plans/pacific-secc-historical-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"cb00a88003c2a2877de1d5da85d69abc4b66c18b7b9518f4aadefad55c8facb9\",\r\n        \"boundary_coordinates_extracted\": false,\r\n        \"full_width_conversion_admitted\": false,\r\n        \"audit_file\": \"research/pacific-secc-rotschi-1972-width-range-scope-audit.json\",\r\n        \"audit_sha256\": \"ef2dc83521f6a67900ac95353dd4e1860f345bc6471250943e8c7372d44ade22\"\r\n      },\r\n      \"full_width_inference_eligible\": false\r\n    },\r\n    {\r\n      \"current_id\": \"new-guinea-coastal-current\",\r\n      \"name\": \"New Guinea Coastal Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_regional_summary\",\r\n      \"phase_kind\": \"regional_summary\",\r\n      \"source_url\": \"https://hal.science/hal-01497605/document#page=13\",\r\n      \"source_citation\": \"Radenac, M.-H., Leger, F., Messie, M., Dutrieux, P., Menkes, C. and Eldin, G. (2016), Wind-driven changes of surface current, temperature, and chlorophyll observed by satellites north of New Guinea, JGR Oceans 121, 2231-2252, doi:10.1002/2015JC011438.\",\r\n      \"source_locator\": \"Section 5.1 and Figure 10, printed p2242 / retained PDF13; seasonal climatology section 5 printed p2240 / PDF11; altimetry methods printed pp2235-2236 / PDF6-7.\",\r\n      \"source_retrieved_date\": \"2026-10-13\",\r\n      \"source_evidence_kind\": \"primary_author_seasonal_surface_vein_descriptor\",\r\n      \"extraction_method\": \"Author prose values transcribed from visually reviewed original. No velocity/SST edges digitized and no averaging of regional descriptors.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Author along-track regional surface descriptions; nearly coast-normal satellite tracks, with no flow-normal correction or paired coordinates independently reconstructed.\",\r\n      \"layer\": \"Surface altimetric current anomaly or SST-associated surface water-mass vein, depending on metric. No uniform depth slab; 50-100 m upwelling and deeper NGCUC support not transferred.\",\r\n      \"time_convention\": \"Trade-wind / austral-winter context. Section 5 describes 2001-2010 reconstructed monthly climatology with 150-500 day seasonal signals; Figure 10 illustrates August and February. These regional widths are winter descriptors illustrated in August, not widths dated for every winter month or individual year.\",\r\n      \"boundary_rule\": \"Author-described surface vein span. Exact seasonal velocity-anomaly threshold and paired geographic edges not specified in this descriptor. Figure 3 half-maximum anomaly-standard-deviation region is a different operator.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"time_precision\": \"regional_seasonal_description_not_exact_width_dates\",\r\n      \"source_quality_note\": \"Complete unchanged HAL deposit inspected. Author regional numbers retained with their metrics and seasonal context; paired boundaries and numeric errors not recovered.\",\r\n      \"remaining_gates\": [\r\n        \"Recover compatible surface current and SST boundary criteria before physical comparison.\",\r\n        \"Recover repeated matching sections before annual extrema or seasonal width geometry.\"\r\n      ],\r\n      \"id\": \"ngcc-radenac-2016-winter-east-099\",\r\n      \"phase_label\": \"East of Vitiaz Strait / track 099\",\r\n      \"geographic_scope\": \"Surface current-anomaly vein east of Vitiaz Strait, near southern New Britain; excludes the strait itself.\",\r\n      \"approximate_width_km\": 120,\r\n      \"width_range_km\": null,\r\n      \"width_metric\": \"author_reported_seasonal_surface_current_anomaly_vein_span\",\r\n      \"width_metric_label\": \"surface current-anomaly vein span\",\r\n      \"range_kind\": \"seasonal_regional_point_descriptor_not_temporal_range\",\r\n      \"range_interpretation\": \"Author approximate regional point descriptor; numeric uncertainty and annual variation unknown.\",\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"ngcc_trade_wind_current_anomaly_vein\",\r\n        \"source_claim_id\": \"radenac2016-5.1-current-anomaly-vein-widths\",\r\n        \"descriptors_are_independent_replicates\": false,\r\n  
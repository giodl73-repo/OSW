protocol_file\": \"plans/balearic-socib-regional-width-protocol-v1.md\",\r\n        \"protocol_sha256\": \"82182246e2242e0cf6ec3866a88b54c339a973414877f6ee4e92e63f56ce62df\",\r\n        \"display_aria_label\": \"Balearic Current: provider-reported regional width range 20 to 35 km along the northern island shelf. No midpoint, seasonal endpoint assignment, confidence interval or mapped edges.\",\r\n        \"display_caption\": \"SOCIB reports a 20–35 km regional width range along the northern Balearic shelf. Representative width and numeric uncertainty remain unknown; no midpoint selected.\",\r\n        \"display_method_note\": \"Provider table, version 13 November 2023. Mean GV 0.2 m/s is not an edge cutoff. Autumn maximum is qualitative variability, not a 35 km autumn width. Sampling period, paired boundaries and exact width method are unspecified; whole-current and annual ranges remain unknown.\",\r\n        \"audit_file\": \"research/balearic-socib-2023-regional-width-scope-audit.json\",\r\n        \"audit_sha256\": \"c4eb5039c0a77ece8e775c50637441d0e0816e2cc401363f85f65effc0f1e203\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"antarctic-slope-chavanne-2009-02-23-jet-width-constraint\",\r\n      \"current_id\": \"antarctic-slope\",\r\n      \"name\": \"Antarctic Slope Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_dated_jet_width_constraint\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": null,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"author_reported_dated_less_than_width_constraint\",\r\n      \"range_interpretation\": \"Reported jet narrower than 28 km in one dated snapshot; not a 28 km point, zero-to-28 interval, confidence bound, whole-current envelope or annual range.\",\r\n      \"geographic_scope\": \"Riiser-Larsenisen continental shelf/slope, southeastern Weddell Sea; section 2 offshore narrow jet embedded in broader southwestward flow. No exact paired geographic width limits supplied.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Cross-shelf/slope section context; no exact paired width endpoints or flow-normal orientation diagnosed by OSW.\",\r\n      \"layer\": \"Detided LADCP horizontal-current context at 100 m (paragraph 5 and Figure 1). Surface-intensified jet; no uniform vertical width slab inferred. 3000 m isobath describes bottom topography.\",\r\n      \"time_convention\": \"One observed section on 23 February 2009; January 31 is separate. Neither the 2010 publication date nor the M6 2017–2021 record dates this jet.\",\r\n      \"boundary_rule\": \"Author reports jet narrower than 28 km. Velocity cutoff and paired edges unresolved; peak 28 cm/s and broader-flow speed about 10 cm/s are not boundary thresholds.\",\r\n      \"source_url\": \"https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2010GL043603\",\r\n      \"source_citation\": \"Chavanne, C.P., K.J. Heywood, K.W. Nicholls and I. Fer (2010), Observations of the Antarctic Slope Undercurrent in the southeastern Weddell Sea, Geophysical Research Letters 37, L13601, doi:10.1029/2010GL043603.\",\r\n      \"source_locator\": \"Primary publisher indexed text: section 2 Observations paragraph 5; processing paragraph 4; Figure 1/2 captions establish section dates and 100 m horizontal-current context.\",\r\n      \"source_retrieved_date\": \"2026-10-14\",\r\n      \"source_evidence_kind\": \"published_primary_indexed_dated_jet_width_constraint\",\r\n      \"extraction_method\": \"Reported qualifier, reference scale and date transcribed from primary publisher indexed body/captions; original PDF/pixels and fields not acquired or digitized.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Riiser-Larsenisen narrow surface jet (23 February 2009)\",\r\n      \"phase_kind\": \"dated_width_constraint\",\r\n      \"observed_period\": {\r\n        \"start\": \"2009-02-23\",\r\n        \"end\": \"2009-02-23\"\r\n      },\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"source_quality_note\": \"Primary publisher indexed passages/captions reviewed. Original PDF, figure pixels, fields and paired width edges unavailable. Width constraint describes a narrow jet within broader flow, not complete ASC width.\",\r\n      \"remaining_gates\": [\r\n        \"Acquire original paper/figures and paired width boundary method.\",\r\n        \"Recover compatible repeated sections before seasonal widths or annual extrema.\",\r\n        \"Independent scientific admission.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"indexed_dated_jet_width_constraint\",\r\n        \"full_original_inspected\": false,\r\n        \"figure_pixels_inspected\": false,\r\n        \"paired_edges_extracted\": false,\r\n        \"zero_to_reference_is_width_range\": false,\r\n        \"reference_scale_is_point_width\": false,\r\n        \"is_annual_range\": false,\r\n        \"jet_width_is_broader_flow_width\": false,\r\n        \"speed_context_is_width_cutoff\": false,\r\n        \"bathy_is_width_layer\": false,\r\n        \"point_depth_context_m\": 100,\r\n        \"peak_speed_cm_s\": 28,\r\n        \"background_speed_cm_s_approx\": 10,\r\n        \"bottom_isobath_m\": 3000,\r\n        \"station_ids\": [\r\n          138,\r\n          139,\r\n          140,\r\n          141,\r\n          142,\r\n          143,\r\n          144\r\n        ],\r\n        \"sampling_date\": \"2009-02-23\",\r\n        \"processing_context\": \"LADCP LDEO IX.5; least-squares M2 tidal removal from depth-averaged currents; source-reported, not reproduced by OSW.\",\r\n        \"protocol_file\": \"plans/antarctic-slope-chavanne-2010-width-constraint-protocol-v1.md\",\r\n        \"protocol_sha256\": \"ffa1b604f782ec1b0b696f5c5a2e9ad733cd7ba01be6af2bad3d714c4f526d85\",\r\n        \"display_aria_label\": \"Antarctic Slope Current narrow jet: source reports less than 28 km on 23 February 2009, in 100 m detided LADCP context. No point width, lower bound, zero-to-28 interval, confidence guarantee or full-current envelope.\",\r\n        \"display_caption\": \"Source reports a narrow southwestward jet <28 km on 23 February 2009, within broader slower southwestward flow. Representative width, lower bound and numeric uncertainty remain unknown.\",\r\n        \"display_method_note\": \"Primary publisher indexed text/captions reviewed; original PDF and figure pixels unavailable. 100 m is the horizontal-current context; 3000 m is bottom topography. Peak 28 cm/s and background about 10 cm/s are not width cutoffs. No annual range or mapped width band.\",\r\n        \"audit_file\": \"research/antarctic-slope-chavanne-2010-dated-width-constraint-scope-audit.json\",\r\n        \"audit_sha256\": \"cb1a89fd1e4475cb6682ed178e73365961abc5756054105c6c07eb0bf1bcec6e\"\r\n      },\r\n      \"reported_width_constraint\": {\r\n        \"kind\": \"author_reported_dated_less_than\",\r\n        \"operator\": \"lt\",\r\n        \"reference_scale_km\": 28,\r\n        \"source_notation\": \"<28 km\",\r\n        \"is_rigorous_upper_bound\": false,\r\n        \"representative_width_km\": null,\r\n        \"lower_bound_km\": null,\r\n        \"numerical_uncertainty_km\": null\r\n      },\r\n      \"time_precision\": \"day\"\r\n    },\r\n    {\r\n      \"current_id\": \"gulf-stream\",\r\n      \"name\": \"Gulf Stream\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"section_geometry\": null,\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"whole_current_width_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"source_retrieved_date\": \"2026-10-14\",\r\n      \"id\": \"gulf-stream-richardson-1967-transport-width-statistics\",\r\n      \"measurement_type\": \"published_campaign_transport_width_statistics\",\r\n      \"width_metric\": \"author_zero_transport_fixed_baseline_span\",\r\n      \"width_metric_label\": \"1967 transport-float sections: mean and sampled span\",\r\n      \"approximate_width_km\": 135,\r\n      \"width_range_km\": [\r\n        120,\r\n        145\r\n      ],\r\n      \"range_kind\": \"finite_span_of_three_author_reported_crossing_widths\",\r\n      \"range_interpretation\": \"Author mean135 km from three complete crossings with widths145,140,120 km. Finite campaign span120–145 km; no fourth independent mean occupation, width error, confidence interval, seasonal or annual extrema.\",\r\n      \"geographic_scope\": \"Cape Hatteras offshore fixed TR-038 baseline; three non-synoptic crossings in1967. Not the whole Gulf Stream or Gulf Stream System.\",\r\n      \"section_orientation\": \"Width along a baseline bearing135 degrees true; transport velocity is the component normal to that baseline. Recorded flow directions vary; no exact flow-normal projection applied.\",\r\n      \"layer\": \"Transport per unit width integrated from surface to local bottom, with variable bathymetry. No fixed-depth width layer or surface-only speed boundary.\",\r\n      \"time_convention\": \"Three complete crossings1,3,4:30June–5July,11–15July,16–18July1967. Campaign26June–18July is separate. Multi-day occupations, not simultaneous snapshots or continuous monthly/seasonal means; source clock timezone unspecified.\",\r\n      \"boundary_rule\": \"Authors smooth transport-per-unit-width measurements and extend their curves to zero. No negative inshore transport was observed; inshore edges are extrapolated. Two complete crossings have offshore negative values, one offshore edge is also extended to zero.\",\r\n      \"source_url\": \"https://www2.whoi.edu/staff/prichardson/wp-content/uploads/sites/75/2018/11/Richardson-Knauss-1971-dsr.pdf\",\r\n      \"source_citation\": \"Richardson, P. L. and Knauss, J. A. (1971), Gulf Stream and Western Boundary Undercurrent observations at Cape Hatteras, Deep-Sea Research18,1089–1109, doi:10.1016/0011-7471(71)90095-7.\",\r\n      \"source_locator\": \"Methods printed1091/PDF3; Fig2 printed1093/PDF5; zero-edge construction printed1094–1095/PDF6–7; Table2 printed1105/PDF17; mean135 km printed1107/PDF19.\",\r\n      \"source_evidence_kind\": \"published_original_transport_float_campaign_statistics\",\r\n      \"extraction_method\": \"Transcribed explicit author widths and mean; matched complete occupations using Figure2 and Table2. No curve digitization, geographic endpoints or width error inferred.\",\r\n      \"phase_label\": \"1967 three complete crossings · zero-transport spans\",\r\n      \"phase_kind\": \"campaign_width_statistics\",\r\n      \"observed_period\": {\r\n        \"start\": \"1967-06-30\",\r\n        \"end\": \"1967-07-18\"\r\n      },\r\n      \"source_quality_note\": \"Inshore zero boundaries are author extrapolations, not observed sign reversals. Multi-day sampling and changing flow direction limit synoptic/flow-normal interpretation. Baseline135 degrees differs from mean135 km.\",\r\n      \"remaining_gates\": [\r\n        \"Recover geographic boundary coordinates and the original transport observations.\",\r\n        \"Quantify section-orientation, interpolation and sampling uncertainty.\",\r\n        \"Independent scientific admission before whole-current dimensions or annual variability.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"gulf_stream_transport_float_complete_crossing_statistics\",\r\n        \"complete_crossing_occupations\": [\r\n          {\r\n            \"id\": \"gulf-stream-1967-crossing-1\",\r\n            \"crossing_number\": 1,\r\n            \"observed_period\": {\r\n              \"start\": \"1967-06-30\",\r\n              \"end\": \"1967-07-05\"\r\n            },\r\n            \"width_km\": 145,\r\n            \"transport_sv\": 58,\r\n            \"source_clock_timezone\": null,\r\n            \"is_synoptic_snapshot\": false\r\n          },\r\n          {\r\n            \"id\": \"gulf-stream-1967-crossing-3\",\r\n            \"crossing_number\": 3,\r\n            \"observed_period\": {\r\n              \"start\": \"1967-07-11\",\r\n              \"end\": \"1967-07-15\"\r\n            },\r\n            \"width_km\": 140,\r\n            \"transport_sv\": 67,\r\n            \"source_clock_timezone\": null,\r\n            \"is_synoptic_snapshot\": false\r\n          },\r\n          {\r\n            \"id\": \"gulf-stream-1967-crossing-4\",\r\n            \"crossing_number\": 4,\r\n            \"observed_period\": {\r\n              \"start\": \"1967-07-16\",\r\n              \"end\": \"1967-07-18\"\r\n            },\r\n            \"width_km\": 120,\r\n            \"transport_sv\": 64,\r\n            \"source_clock_timezone\": null,\r\n            \"is_synoptic_snapshot\": false\r\n          }\r\n        ],\r\n        \"partial_crossing_without_width\": 2,\r\n        \"reported_mean_width_km\": 135,\r\n        \"mean_is_independent_occupation\": false,\r\n        \"campaign_context_period\": {\r\n          \"start\": \"1967-06-26\",\r\n          \"end\": \"1967-07-18\"\r\n        },\r\n        \"baseline_bearing_degrees_true\": 135,\r\n        \"baseline_bearing_is_width\": false,\r\n        \"width_is_exact_flow_normal_projection\": false,\r\n        \"author_boundary_extrapolation_present\": true,\r\n        \"inshore_negative_transport_observed\": false,\r\n        \"offshore_negative_transport_observed_complete_crossing_count\": 2,\r\n        \"all_paired_edges_observed_sign_reversals\": false,\r\n        \"source_curve_or_coordinates_digitized\": false,\r\n        \"occupation_range_is_uncertainty_or_annual_extrema\": false,\r\n        \"display_aria_label\": \"Gulf Stream off Cape Hatteras: three author zero-transport section widths145,140,120 km in1967; reported mean135 km and finite sample span120–145 km. Author extrapolation is retained; no annual extrema or geographic edges.\",\r\n        \"display_caption\": \"Mean135 km; three complete1967 crossings span120–145 km. Published zero-transport curve edges include extrapolation.\",\r\n        \"display_method_note\": \"Surface-to-local-bottom transport, fixed135-degree-true baseline; multi-day occupations and varying direction. Mean is not a fourth occupation; finite spread is not uncertainty or annual variability.\",\r\n        \"comparison_figure\": \"figures/gulf-stream-published-width-definitions.svg\",\r\n        \"audit_file\": \"research/gulf-stream-published-width-definitions-scope-audit.json\",\r\n        \"audit_sha256\": \"4e94e8b7f7a29deca11f3005b045d81966de99e967c82fd90f3ba2e4fac2060f\",\r\n        \"audit_pointer\": \"/measurements/0\",\r\n        \"comparison_figure_label\": \"Compare published Gulf Stream width definitions\"\r\n      }\r\n    },\r\n    {\r\n      \"current_id\": \"gulf-stream\",\r\n      \"name\": \"Gulf Stream\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"section_geometry\": null,\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"whole_current_width_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"source_retrieved_date\": \"2026-10-14\",\r\n      \"id\": \"gulf-stream-lozier-1995-climatological-isopycnal-span\",\r\n      \"measurement_type\": \"published_climatological_isopycnal_contour_span\",\r\n      \"width_metric\": \"mean_isopycnal_pressure_contour_separation\",\r\n      \"width_metric_label\": \"Historical climatology: sigma-theta26.50 pressure contours\",\r\n      \"approximate_width_km\": 300,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"One approximate author-reported mean contour span. Meander envelope500 km, smoothing scale100 km and factor-of-two comparison are separate context; no150 km inferred observation or combined135–300 km range.\",\r\n      \"geographic_scope\": \"Gulf Stream near70 W on the mean sigma-theta26.50 surface; not the entire current or its larger system.\",\r\n      \"section_orientation\": \"Author contour separation near70 W; exact geographic endpoints and flow-normal orientation not extracted.\",\r\n      \"layer\": \"Potential-density-anomaly surface sigma-theta26.50. Width between100 and400 dbar pressure contours on that surface; these are not fixed100–400 m depth bounds.\",\r\n      \"time_convention\": \"Historical isopycnal climatology from the NODC archive available as of April1990. Basin-wide observations span1904–1990; exact local averaging dates and seasonal weights are unresolved. Publication1995 is not an observation date.\",\r\n      \"boundary_rule\": \"Author estimates mean width from the separation of100 and400 dbar contours on the sigma-theta26.50 isopycnal near70 W, rather than paired velocity edges.\",\r\n      \"source_url\": \"https://www.whoi.edu/science/po/people/rcurry/pdf_files/Lozier_etal.PiO1995.pdf\",\r\n      \"source_citation\": \"Lozier, M. S., Owens, W. B. and Curry, R. G. (1995), The climatology of the North Atlantic, Progress in Oceanography36,1–44, doi:10.1016/0079-6611(95)00013-5.\",\r\n      \"source_locator\": \"Abstract printed1/PDF1; section2 printed3/PDF3; section5.1 printed14–17/PDF14–17; Figure7 printed15/PDF15; width and meandering discussion printed17/PDF17.\",\r\n      \"source_evidence_kind\": \"published_original_historical_isopycnal_climatology\",\r\n      \"extraction_method\": \"Transcribed explicit about300 km contour span after original-page review. No contour digitization, depth conversion, exact local period or inferred instantaneous width.\",\r\n      \"phase_label\": \"Historical climatology · near70 W contour span\",\r\n      \"phase_kind\": \"climatological_isopycnal_span\",\r\n      \"observed_period\": null,\r\n      \"source_quality_note\": \"Mean pressure contours on an isopycnal differ from instantaneous transport or half-speed boundaries. Local period and width error unresolved; pressure levels are not fixed depths.\",\r\n      \"remaining_gates\": [\r\n        \"Recover exact local contribution dates, contour geography and orientation.\",\r\n        \"Assess smoothing, averaging and meandering effects independently.\",\r\n        \"Independent scientific admission before geographic footprint or physical annual dimensions.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"gulf_stream_historical_mean_isopycnal_contour_span\",\r\n        \"isopycnal_label\": \"sigma-theta26.50\",\r\n        \"pressure_contours_dbar\": [\r\n          100,\r\n          400\r\n        ],\r\n        \"pressure_contours_are_fixed_depth_bounds\": false,\r\n        \"archive_available_as_of\": \"1990-04\",\r\n        \"basin_archive_years_context\": [\r\n          1904,\r\n          1990\r\n        ],\r\n        \"basin_archive_years_are_exact_local_period\": false,\r\n        \"source_meander_envelope_context_km\": 500,\r\n        \"source_local_smoothing_context_km\": 100,\r\n        \"meander_envelope_is_current_width_or_uncertainty\": false,\r\n        \"factor_two_comparison_defines_instantaneous_measurement\": false,\r\n        \"source_curve_or_coordinates_digitized\": false,\r\n        \"display_aria_label\": \"Gulf Stream near70 W: about300 km climatological separation of100 and400 dbar contours on sigma-theta26.50. Historical source cutoffApril1990; local averaging period unresolved. No fixed-depth width or annual range.\",\r\n        \"display_caption\": \"About300 km · historical mean contour span on sigma-theta26.50 near70 W. Pressure levels are not fixed depths.\",\r\n        \"display_method_note\": \"Historical climatology; exact local dates and orientation unresolved. Source discusses meandering and smoothing separately; no instantaneous150 km record or135–300 km range inferred.\",\r\n        \"comparison_figure\": \"figures/gulf-stream-published-width-definitions.svg\",\r\n        \"audit_file\": \"research/gulf-stream-published-width-definitions-scope-audit.json\",\r\n        \"audit_sha256\": \"4e94e8b7f7a29deca11f3005b045d81966de99e967c82fd90f3ba2e4fac2060f\",\r\n        \"audit_pointer\": \"/measurements/1\",\r\n        \"comparison_figure_label\": \"Compare published Gulf Stream width definitions\"\r\n      }\r\n    },\r\n    {\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"section_geometry\": null,\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"uncertainty_km\": null,\r\n      \"whole_current_width_km\": null,\r\n      \"annual_width_range_km\": null,\r\n      \"source_retrieved_date\": \"2026-10-14\",\r\n      \"current_id\": \"loop\",\r\n      \"name\": \"Loop Current\",\r\n      \"id\": \"loop-uhlhorn-2008-prelili-geostrophic-core\",\r\n      \"measurement_type\": \"published_campaign_geostrophic_core_span\",\r\n      \"width_metric\": \"author_reported_fixed_speed_geostrophic_core_span\",\r\n      \"width_metric_label\": \"Pre-Lili survey: fixed0.4 m/s geostrophic core\",\r\n      \"approximate_width_km\": 100,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"One approximate author-reported core span. No paired seasonal values, width error, pooled100-200 km range or annual extrema.\",\r\n      \"geographic_scope\": \"Southeastern Gulf of Mexico, middle-grid-row cross section of the analyzed Loop Current; numerical boundary endpoints not extracted.\",\r\n      \"section_orientation\": \"Source-labeled cross-stream middle grid row, southeast to northwest; no exact geographic section or perpendicular-angle reconstruction.\",\r\n      \"layer\": \"Geostrophic core cross section. Source describes structure mainly within upper300 m; depth at which prose100 km span is evaluated is not separately specified. Reference level is shallower of750 m and local bottom, not a width layer.\",\r\n      \"time_convention\": \"Width paragraph explicitly uses19-23September2002 prestorm fields. Broader flight context18-23September; no width inferred for2October or4October. No source clock timezone assigned.\",\r\n      \"boundary_rule\": \"Author-reported cross-stream extent of geostrophic speeds at least0.4 m/s; preserve fixed cutoff. Approximate e-folding wording is source context, not an adopted relative threshold.\",\r\n      \"source_url\": \"https://scholarship.miami.edu/esploro/outputs/doctoral/Gulf-of-Mexico-Loop-Current-Mechanical/991031447487802976\",\r\n      \"source_citation\": \"Uhlhorn, E. W. (2008), Gulf of Mexico Loop Current Mechanical Energy and Vorticity Response to a Tropical Cyclone, PhD dissertation, University of Miami, May2008.\",\r\n      \"source_locator\": \"Section2.5.2, printed35-37/PDF64-66; width paragraph printed36/PDF65; Figure2.28 printed38/PDF67. Date/flight context printed10-11/PDF39-40. PDF page numbers include repository cover.\",\r\n      \"source_evidence_kind\": \"original_dissertation_observational_density_analysis\",\r\n      \"extraction_method\": \"Transcribed explicit about100 km prose after original-page and section review; no curve digitization or reconstruction from longitude ticks.\",\r\n      \"phase_label\": \"19-23 September2002 · prestorm geostrophic core\",\r\n      \"phase_kind\": \"campaign_geostrophic_core\",\r\n      \"observed_period\": {\r\n        \"start\": \"2002-09-19\",\r\n        \"end\": \"2002-09-23\"\r\n      },\r\n      \"source_quality_note\": \"Thermal-wind velocity relative to an assumed zero-reference level can underestimate absolute speed. Source e-folding wording is not numerically identical to the stated fixed cutoff. Width error and exact edge geometry remain unknown.\",\r\n      \"remaining_gates\": [\r\n        \"Recover paired geographic edges, exact width evaluation depth and numerical density/velocity profiles.\",\r\n        \"Review reference-flow, curvature, mapping resolution and boundary sensitivity before independent physical admission.\",\r\n        \"Acquire compatible repeated sections for seasonal or whole-current dimensions.\"\r\n      ],\r\n      \"original_regional_context\": {\r\n        \"description_kind\": \"loop_prestorm_fixed_speed_geostrophic_core\",\r\n        \"source_speed_threshold_m_s\": 0.4,\r\n        \"source_local_peak_context_m_s\": 0.75,\r\n        \"source_e_folding_wording_is_adopted_threshold\": false,\r\n        \"source_threshold_to_prose_peak_ratio\": 0.5333333333333333,\r\n        \"reference_depth_limit_m\": 750,\r\n        \"reference_condition\": \"zero geostrophic velocity at shallower of750 m and local bottom\",\r\n        \"reference_depth_is_width_layer\": false,\r\n        \"upper_core_depth_context_m\": 300,\r\n        \"core_depth_context_is_uniform_width_slab\": false,\r\n        \"source_width_period\": {\r\n          \"start\": \"2002-09-19\",\r\n          \"end\": \"2002-09-23\"\r\n        },\r\n        \"general_flight_period_context\": {\r\n          \"start\": \"2002-09-18\",\r\n          \"end\": \"2002-09-23\"\r\n        },\r\n        \"poststorm_current_change_is_width_change\": false,\r\n        \"speed_bias_is_width_error\": false,\r\n        \"source_curve_or_coordinates_digitized\": false,\r\n        \"display_aria_label\": \"Loop Current: about100 km author-reported fixed0.4 m/s geostrophic core span,19-23September2002. Relative reference flow, exact evaluation depth and geographic edges unresolved; no annual range.\",\r\n        \"display_caption\": \"About100 km · prestorm geostrophic core at fixed0.4 m/s cutoff.\",\r\n        \"display_method_note\": \"Thermal-wind density analysis relative to750 m or bottom. Upper300 m core context is not a uniform width layer. Source e-folding wording is not adopted; no width-error or seasonal interval.\",\r\n        \"comparison_figure\": \"figures/loop-uhlhorn-2008-core-width.svg\",\r\n        \"comparison_figure_label\": \"Inspect the Loop Current core width definition\",\r\n        \"audit_file\": \"research/loop-uhlhorn-2008-core-width-scope-audit.json\",\r\n        \"audit_sha256\": \"d96a85769d521a858d6975a66fdfed10be47989daa1010d805e61146581d8ae9\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"south-pacific-stramma-1990-03-relative-band-constraint\",\r\n      \"current_id\": \"south-pacific\",\r\n      \"name\": \"South Pacific Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_month_relative_geostrophic_band_width_constraint\",\r\n      \"width_metric\": \"author_reported_current_width\",\r\n      \"approximate_width_km\": null,\r\n      \"width_range_km\": null,\r\n      \"range_kind\": \"author_reported_dated_less_than_width_constraint\",\r\n      \"range_interpretation\": \"Reported enhanced eastward band less than200 km in one historical section. Representative width, lower bound, confidence limits, whole-current envelope and annual range remain unknown.\",\r\n      \"geographic_scope\": \"Western South Pacific near Chatham Rise; Baldrige section d at nominal170 W in March1990. Front station table gives170.6 W; exact width edges unresolved.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Nominal meridional hydrographic section; no diagnosed flow-normal axis or paired width endpoints.\",\r\n      \"layer\": \"Enhanced eastward relative-geostrophic band in Figure3 upper1000 m context. Surface-intensified flow; exact width-evaluation depth unknown. No uniform vertical width slab.\",\r\n      \"time_convention\": \"March1990, late austral summer, from Table1(d) and Figure3 caption. Exact occupation days and annual coverage unavailable.\",\r\n      \"boundary_rule\": \"Author reports band less than200 km wide. No numeric edge cutoff or geographic edge pair supplied; peak/sampled velocities are context only.\",\r\n      \"source_url\": \"https://doi.org/10.1175/1520-0485(1995)025<0077:TSPC>2.0.CO;2\",\r\n      \"source_citation\": \"Stramma, L., R.G. Peterson and M. Tomczak (1995), The South Pacific Current, Journal of Physical Oceanography25,77-91.\",\r\n      \"source_locator\": \"Original p82 right column; Table1(d) p79, Table2(d) p83 and Figure3/caption p84. Rejected illustrative100 km assumption: p89.\",\r\n      \"source_retrieved_date\": \"2026-10-17\",\r\n      \"source_evidence_kind\": \"published_original_scan_reviewed_relative_geostrophic_band_constraint\",\r\n      \"extraction_method\": \"Source qualifier and context transcribed after visual review of original pages. No source curve or edge digitization.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"phase_label\": \"Bal
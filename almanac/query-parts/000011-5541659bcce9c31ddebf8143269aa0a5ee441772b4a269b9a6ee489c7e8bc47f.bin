.html#monsoon-summer-sri-lanka-reference-path-candidate\",\n      \"season_url\": \"seasons.html?current=monsoon\",\n      \"dashboard_search\": \"Monsoon Current Indian Ocean\",\n      \"width_ids\": [\n        \"monsoon-webber-2018-observed-near-surface-flow-width\",\n        \"monsoon-webber-2018-conditional-salinity-origin-component-width\"\n      ],\n      \"measurement_ids\": [],\n      \"route_ids\": [\n        \"monsoon-summer-sri-lanka-reference-path-candidate\",\n        \"monsoon-winter-sri-lanka-reference-path-candidate\"\n      ],\n      \"source_ids\": [\n        \"source:4556886a82d6f61a\",\n        \"source:4dc5fc618c26565f\",\n        \"source:4f7441b953be4651\",\n        \"source:803229fe82eb2360\",\n        \"source:b038491b0e5a3967\"\n      ],\n      \"state_codes\": [],\n      \"published_length_km\": null,\n      \"seasonal_route_ids\": [\n        \"monsoon-summer-sri-lanka\",\n        \"monsoon-winter-sri-lanka\"\n      ],\n      \"width_sample_ids\": [],\n      \"route_decision_ids\": [\n        \"route-decision:monsoon\"\n      ],\n      \"current_section_ids\": [],\n      \"velocity_sample_ids\": []\n    },\n    {\n      \"id\": \"current:new-guinea-coastal-current\",\n      \"label\": \"New Guinea Coastal Current\",\n      \"type\": \"named_current\",\n      \"identity_level\": \"current\",\n      \"source_kind\": \"seasonally reversing surface western boundary current\",\n      \"setting\": \"western_boundary\",\n      \"time_behavior\": \"seasonally_reversing\",\n      \"basin\": \"Southwestern tropical Pacific / north New Guinea coast\",\n      \"capabilities\": {\n        \"observed_velocity\": 0,\n        \"radius_evidence\": 0,\n        \"reported_length\": 0,\n        \"reference_route\": 1,\n        \"scoped_width\": 4,\n        \"geometry\": 0,\n        \"time_samples\": 0,\n        \"source_connectivity\": 0,\n        \"scope_notes\": 1,\n        \"dated_diagnostics\": 0,\n        \"flow_network\": 0,\n        \"passage_transport
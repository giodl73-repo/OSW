nce_status\": \"no_numeric_length\",\r\n      \"existing_scope\": \"The source describes a Northern Current formed in the Ligurian Sea that flows onward along the Provençal and Balearic slopes; the Ligurian name is treated here as its source-region segment, without assigning the whole system's extent to this record.\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=3357\",\r\n      \"candidate_ids\": [\r\n        \"ligurian-reach-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"Northern Current segment\",\r\n      \"route_strategy_id\": \"resolve_naming_scope\",\r\n      \"route_strategy_label\": \"Resolve naming or extent convention\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"The source describes a Northern Current formed in the Ligurian Sea that flows onward along the Provençal and Balearic slopes; the Ligurian name is treated here as its source-region segment, without assigning the whole system's extent to this record.\",\r\n      \"next_action\": \"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.\",\r\n      \"strategy_next_action\": \"Read competing definitions, resolve aliases versus distinct flows, and retain source-convention routes without merging their extents.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"loop\",\r\n      \"name\": \"Loop Current\",\r\n      \"existing_length_evidence_status\": \"no_numeric_length\",\r\n      \"existing_scope\": \"The loop expands and retracts; its path length changes.\",\r\n      \"name_source_url\": \"https://oceanservice.noaa.gov/facts/loopcurrent.html\",\r\n      \"candidate_ids\": [],\r\n      \"reference_path_decision\": \"reference_path_not_constructed\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"western boundary current segment\",\r\n      \"route_strategy_id\": \"dated_geometry\",\r\n      \"route_strategy_label\": \"Construct dated or regime-specific geometry\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"The loop expands and retracts; its path length changes.\",\r\n      \"next_action\": \"Review regional gateway placement, effective resolution and original maximum-velocity contour details against five dated NOAA/DUACS comparisons. Four predeclared 2025 dates retain three failed nominal NOAA traces, while DUACS remains connected. Assess broader observed regimes; failed methods and sparse snapshots do not establish annual ranges. See research/loop-current-recorded-date-comparison.json; no ranked length or width admitted.\",\r\n      \"strategy_next_action\": \"Use dated or explicitly averaged geometry, distinguish an open loop from a closed circuit, and compare repeated regimes before summarizing.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"mauritanian\",\r\n      \"name\": \"Mauritanian Current\",\r\n      \"existing_length_evidence_status\": \"no_numeric_length\",\r\n      \"existing_scope\": \"The source reports poleward surface flow during the May–July relaxation season in the Mauritanian upwelling region; winter upwelling-season coastal flow is equatorward. A single year-round direction or whole-current length would misrepresent this seasonal regime.\",\r\n      \"name_source_url\": \"https://www.marineregions.org/gazetteer.php?p=details&id=30081\",\r\n      \"candidate_ids\": [\r\n        \"mauritanian-summer-reach-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"seasonal poleward eastern-boundary current\",\r\n      \"route_strategy_id\": \"seasonal_routes\",\r\n      \"route_strategy_label\": \"Construct seasonal routes\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"The source reports poleward surface flow during the May–July relaxation season in the Mauritanian upwelling region; winter upwelling-season coastal flow is equatorward. A single year-round direction or whole-current length would misrepresent this seasonal regime.\",\r\n      \"next_action\": \"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.\",\r\n      \"strategy_next_action\": \"Choose sourced season, direction and layer; construct each supported seasonal path separately and preserve missing seasons.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"mediterranean-undercurrent\",\r\n      \"name\": \"Mediterranean Undercurrent\",\r\n      \"existing_length_evidence_status\": \"no_numeric_length\",\r\n      \"existing_scope\": \"RAFOS floats and hydrography track the undercurrent from the Gulf of Cádiz around southwestern Portugal, where a roughly 30 km wide jet weakens and broadens northward. That width is cross-stream, not its length; branching and loss from the slope prevent a single measured endpoint here.\",\r\n      \"name_source_url\": \"https://doi.org/10.1029/2001JC001007\",\r\n      \"candidate_ids\": [\r\n        \"mediterranean-undercurrent-reach-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"intermediate-depth boundary undercurrent\",\r\n      \"route_strategy_id\": \"layer_specific_route\",\r\n      \"route_strategy_label\": \"Construct layer-specific paths\",\r\n      \"planning_status\": \"editorial_planning_crosswalk_not_scientific_classification_approval\",\r\n      \"planning_basis\": \"RAFOS floats and hydrography track the undercurrent from the Gulf of Cádiz around southwestern Portugal, where a roughly 30 km wide jet weakens and broadens northward. That width is cross-stream, not its length; branching and loss from the slope prevent a single measured endpoint here.\",\r\n      \"next_action\": \"Review the existing editorial route against scientific gates; broader/system/family scope remains governed by the planning strategy.\",\r\n      \"strategy_next_action\": \"Specify source layer and time support, obtain intermediate pathway geometry, and separate branches or dilution thresholds before measuring.\",\r\n      \"known_component_currents\": [],\r\n      \"component_inventory_status\": \"not_assessed_by_this_planning_crosswalk\"\r\n    },\r\n    {\r\n      \"current_id\": \"mindanao-current\",\r\n      \"name\": \"Mindanao Current\",\r\n      \"existing_length_evidence_status\": \"no_numeric_length\",\r\n      \"existing_scope\": \"The source describes flow southward along the Philippine Islands and supply to the Indonesian Throughflow, North Equatorial Countercurrent, and Pacific Equatorial Undercurrent. It gives no whole-current alongflow length or fixed endpoint gates.\",\r\n      \"name_source_url\": \"https://doi.org/10.1029/2011JC007477\",\r\n      \"candidate_ids\": [\r\n        \"mindanao-reference-path-candidate\"\r\n      ],\r\n      \"reference_path_decision\": \"editorial_candidate_present_scientific_review_pending\",\r\n      \"published_length_rank_eligible\": false,\r\n      \"ledger_kind\": \"south
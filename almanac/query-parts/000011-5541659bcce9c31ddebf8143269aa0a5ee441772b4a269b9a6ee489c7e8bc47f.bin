ry page 34.\",\r\n      \"source_retrieved_date\": \"2026-10-04\",\r\n      \"source_evidence_kind\": \"published_satellite_product_diagnostic_summary\",\r\n      \"extraction_method\": \"Approximate scalar values transcribed from published prose; no graph digitization or geographic width edges.\",\r\n      \"whole_current_representative\": false,\r\n      \"width_rank_eligible\": false,\r\n      \"phase_label\": \"winter\",\r\n      \"phase_kind\": \"stream_mean_threshold_summary\",\r\n      \"observed_period\": null,\r\n      \"calendar_months\": null,\r\n      \"fixed_layer_bounds_m\": null,\r\n      \"annual_extrema_eligible\": false,\r\n      \"seasonal_playback_eligible\": false,\r\n      \"full_width_inference_eligible\": false,\r\n      \"is_confidence_interval\": false,\r\n      \"source_quality_note\": \"Weekly averaged and smoothed surface geostrophic product; ageostrophic flow is not included in the width diagnosis. Interpolation to 0.1 degree does not add independent observation resolution. Exact spatial/temporal weighting and season-to-month convention remain unresolved.\",\r\n      \"remaining_gates\": [\r\n        \"Review exact temporal/spatial averaging weights and season calendar membership.\",\r\n        \"Independent scientific measurement admission; geographic boundaries remain unextracted.\"\r\n      ],\r\n      \"stream_mean_context\": {\r\n        \"audit_file\": \"research/kuroshio-liu-gan-2012-stream-mean-width-scope-audit.json\",\r\n        \"audit_sha256\": \"607924d8b2f54393fcb150bd29b6e08f5abc99616e72b9142f879a17ded83fcd\",\r\n        \"source_pdf_sha256\": \"a452007ff7f3b0051f811ba8172e9ae7932642ed1916a29c779db6335772203b\",\r\n        \"velocity_threshold_m_s\": 0.1,\r\n        \"velocity_component\": \"along_stream_parallel_to_diagnosed_axis\",\r\n        \"section_orientation\": \"normal_to_diagnosed_jet_axis\",\r\n        \"study_period_years\": [\r\n          1993,\r\n          2008\r\n        ],\r\n        \"season\": \"winter\"
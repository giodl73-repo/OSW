hs\": false,\r\n        \"audit_file\": \"research/north-brazil-guiana-oblique-mean-width-scope-audit.json\",\r\n        \"audit_sha256\": \"8deddb91cf6f4ff46710374d9304b6e323a42b38427235d5514a94e23bb1328b\"\r\n      },\r\n      \"source_quality_note\": \"0.25-degree geostrophic product omits ageostrophic contributions. Oblique section span cannot be converted from latitude as if meridional. Table mean is about 220 km; section 4.1 says 20 km in another comparison. Discrepancy unresolved; not a seasonal or uncertainty range.\"\r\n    },\r\n    {\r\n      \"id\": \"guiana-hs3-oblique-mean-zero-width\",\r\n      \"current_id\": \"guiana\",\r\n      \"name\": \"Guiana Current\",\r\n      \"status\": \"editorial_source_extraction_not_canonical\",\r\n      \"measurement_type\": \"published_mean_section_width\",\r\n      \"width_metric\": \"mean_cross_section_zero_crossing_span\",\r\n      \"approximate_width_km\": 440,\r\n      \"width_range_km\": null,\r\n      \"range_interpretation\": \"Published approximate mean-field oblique section width; no error interval. Regional sections do not establish annual or seasonal extrema.\",\r\n      \"geographic_scope\": \"HS3 / NBC3: local oblique section of North Brazil–Guyana surface circulation; source-specific flow naming, not a uniform whole-current width.\",\r\n      \"section_geometry\": null,\r\n      \"section_orientation\": \"Source rotated cross-section component with 45 degree angle; exact endpoints and paired edge coordinates not extracted.\",\r\n      \"layer\": \"Altimetry-derived surface geostrophic field; no fixed-depth bounds inferred.\",\r\n      \"time_convention\": \"January 1993–December 2017 mean velocity-profile context; width of mean field, not mean instantaneous width or seasonal range.\",\r\n      \"boundary_rule\": \"Zero contours of mean signed rotated cross-section velocity; source northward convention for NBC components. Half-peak intensity domain is separate.\",\r\n      \"source_url\": \"https://os.co
ments_separately_gated","admission_date":"2026-10-21","review_type":"internal_editorial_identity_review_not_external_scientific_peer_review","identity_evidence":{"source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639","source_locator":"Title; Introduction paragraph2; abstract; Results3.1 paragraph17","access_mode":"publisher_full_HTML_inspected_original_PDF_unavailable","decision":"The primary text explicitly identifies a southward East Madagascar Current. The southern qualifier distinguishes the named poleward branch from northward flow, the underlying equatorward undercurrent and offshore countercurrent.","classification_basis":"Introduction identifies the western boundary current of the South Indian subtropical gyre. Abstract describes near-surface expression and1992–2005 altimetry with eddy and interannual variability.","global_aliases_admitted":[],"parent_relationships_admitted":[]},"source_dimensions":{"schema":"osw.proposed-current-reported-dimensions.v1","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639","source_citation":"Nauw, van Aken, Webb, Lutjeharms and de Ruijter (2008), Observations of the southern East Madagascar Current and undercurrent and countercurrent system, JGR113, C08006, doi:10.1029/2007JC004639.","source_original_pdf_sha256":null,"source_license":"AGU/Wiley copyrighted publication; free access does not imply a redistribution license. Original factual summaries and OSW diagram only.","figure_file":"figures/southern-east-madagascar-reported-dimensions.svg","reported_length_rank_eligible":false,"physical_annual_width_range_km":null,"geographic_current_edges":null,"seasonal_playback_eligible":false,"records":[{"id":"southern-east-madagascar-nauw2008-reported-extent","dimension":"length","value_km":650,"approximate":true,"metric":"author_reported_southern_branch_extent","source_locator":"Introduction paragraph2","support":"Southward branch from approximately20S to Cap Sainte Marie at approximately25deg30minS. Source cites Duncan1970 and Lutjeharms1988b; this is a contextual literature estimate, not a new length measured by the2001 cruise.","observed_period":null,"fixed_layer_bounds_m":null,"endpoint_coordinates_lon_lat":null,"uncertainty_km":null,"is_annual_mean":false,"is_annual_extremum":false,"rank_eligible":false},{"id":"southern-east-madagascar-nauw2008-survey-width","dimension":"width","value_km":120,"approximate":true,"metric":"author_reported_near_surface_survey_width","source_locator":"Results3.1 paragraph17; abstract","support":"SectionsT5–T8 in April2001 off southeast Madagascar. Near-surface current structure uses VMADCP mean velocity in the upper100m. Numeric edge cutoff, boundary coordinates and width uncertainty are not specified in this passage.","observed_period":"2001-04","fixed_layer_bounds_m":null,"velocity_averaging_layer_m":[0,100],"velocity_averaging_layer_is_verified_width_layer":false,"endpoint_coordinates_lon_lat":null,"uncertainty_km":null,"is_annual_mean":false,"is_annual_extremum":false,"rank_eligible":false}],"interpretation":"Separate source-reported dimensions, not the sides of a current footprint. April2001 width and contextual branch length must not be multiplied into an area. No seasonal range, dated axis, fixed width layer or annual mean inferred."},"canonical_measurements_admitted":false,"rank_eligible":false,"physical_edges_admitted":false,"geometry":null,"annual_width_range_km":null,"annual_length_range_km":null,"seasonal_playback_eligible":false,"external_scientific_review_claimed":false,"remaining_measurement_gates":["Acquire and visually review original figures before quantitative measurement admission.","Recover paired velocity boundaries, layer and error convention for width measurements.","Recover source-supported route geometry and repeat temporal support before annual ranges, seasonal animation or state intersections."],"identity_figure_file":"figures/southern-east-madagascar-admitted-identity.svg","route_planning_decision":{"current_id":"southern-east-madagascar","name":"Southern East Madagascar Current","candidate_ids":[],"published_length_rank_eligible":false,"route_strategy_id":"source_gated_boundary_current","route_strategy_label":"Source-gated boundary-current route","reference_path_decision":"not_constructed","next_action":"Acquire source-supported route geometry with layer, start/end gates and time support; retain contextual extent separately.","existing_scope":"Southward branch identity admitted; no geographic axis or current-edge coordinates recovered.","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","name_source_url":"https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2007JC004639","existing_length_evidence_status":"reported_contextual_extent_pending_measurement_admission","ledger_kind":"current","planning_basis":"Source-supported southern current identity; no source-defined route geometry has been recovered.","strategy_next_action":"Recover a source-supported current-axis route with explicit layer, source period and endpoint convention.","known_component_currents":[],"component_inventory_status":"no_component_inventory_asserted"}},{"id":"current_admission:norwegian-atlantic-slope","proposal_id":"norwegian-atlantic-slope","entity_id":"current:norwegian-atlantic-slope","entity":{"id":"current:norwegian-atlantic-slope","label":"Norwegian Atlantic Slope Current","type":"named_current","source_record_id":"norwegian-atlantic-slope","source_id":"source:nwasc-baumann-2026","source_kind":"source-defined Atlantic-water slope current","identity_level":"current","setting":"polar_or_subpolar_margin","time_behavior":"persistent_variable","basin":"Norwegian Sea / Nordic Seas","identity_scope_note":"Atlantic-water eastern slope branch along the Norwegian continental margin, with northern bifurcation. Distinct from ambiguous Norwegian Current, coastal current and western frontal branch. Parent Norwegian Atlantic Current remains a separately proposed identity.","almanac_url":"reference-routes.html#inventory-addition-norwegian-atlantic-slope","catalogue_version":"0.3.0-draft-nwasc","identity_admission_id":"current_admission:norwegian-atlantic-slope"},"source":{"kind":"external","material_use_class":"source_scoped_factual_claim","used_in_collections":["entities","names","claims","measurements","widths","current_identity_admissions"],"metadata_status":"Original source context inspected; working editorial admission, no external scientific approval.","id":"source:nwasc-baumann-2026","label":"Baumann et al. (2026): Norwegian Atlantic Slope Current","title":"Reduced cooling in the Norwegian Atlantic Slope Current: investigating mechanisms of change from 30 years of observations","doi":"10.5194/os-22-17-2026","url":"https://os.copernicus.org/articles/22/17/2026/","publication_date":"2026-01-05","rights_status":"CC BY 4.0","provider_asset_redistributed":true,"repository_path":"research/source-data/baumann-nwasc-2026/article.pdf","credit_text":"Baumann, Skagseth, Ingvaldsen and Mork (2026), Ocean Science 22, 17–29, CC BY 4.0."},"status":"working_identity_and_separately_scoped_dimensions_admitted","admission_date":"2026-10-22","review_type":"internal_editorial_primary_source_review","identity_evidence":[{"url":"https://os.copernicus.org/articles/22/17/2026/","citation":"Baumann, Skagseth, Ingvaldsen and Mork (2026), Reduced cooling in the Norwegian Atlantic Slope Current: investigating mechanisms of change from 30 years of observations, Ocean Science 22, 17–29, doi:10.5194/os-22-17-2026.","locator":"Introduction paragraphs on two branches and northern bifurcation; sections 2.1 and 2.1.2 on section sampling and distinct current-core definitions.","supports":"NwASC follows the Norwegian continental slope, with branches toward the Barents Sea and West Spitsbergen. Whole-current origin, termination and layer-specific geometry not extracted.","source_access":"Publisher relevant introduction and methods read, not all article sections; figures not digitized.","source_license":"Creative Commons Attribution 4.0","source_retrieved_date":"2026-10-03"},{"url":"https://os.copernicus.org/articles/6/901/2010/","citation":"Mork, K. A. and Skagseth, O. (2010), A quantitative description of the Norwegian Atlantic Current by combining altimetry and hydrography, Ocean Science 6, 901-911, doi:10.5194/os-6-901-2010.","locator":"Introduction and Fig. 1; Sections 3 and 4.1.1, pp.904 and 906.","supports":"Separate slope/front branch identities and method-dependent local widths; no total system width or annual envelope.","source_access":"Original eleven-page PDF acquired; methods/results/discussion and Figures 2-3 visually inspected. No raw ADT field or width boundaries digitized.","source_license":"CC BY 3.0","source_retrieved_date":"2026-10-08"}],"canonical_measurements_admitted":true,"rank_eligible":true,"physical_edges_admitted":false,"geometry":null,"annual_width_range_km":null,"annual_length_range_km":null,"seasonal_playback_eligible":false,"external_scientific_review_claimed":false,"remaining_measurement_gates":["Acquire a layer- and time-defined axis before mapped length and physical joins.","Acquire comparable repeated dated dimensions before annual envelopes and seasonal animation."],"identity_figure_file":"figures/norwegian-atlantic-slope-admitted-dimensions.svg","route_planning_decision":{"current_id":"norwegian-atlantic-slope","name":"Norwegian Atlantic Slope Current","candidate_ids":[],"published_length_rank_eligible":true,"route_strategy_id":"source_gated_boundary_current","route_strategy_label":"Source-gated slope-current route","reference_path_decision":"not_constructed","next_action":"Recover a source-supported axis with branch, layer, endpoint and time conventions.","existing_scope":"Author-reported approximate3500km eastern shelf-edge branch extent in Orvik and Skagseth (2003). Historical broad branch geography from Shetland toward the Arctic west of Svalbard at80°N is described in Orvik and Niiler (2001), not an independent length measurement. This broad scope may overlap flow now named West Spitsbergen Current; not an additive component length or a modern regional axis. No fixed layer, reference period, paired endpoint coordinates, error or annual range supplied.","planning_status":"editorial_planning_crosswalk_not_scientific_classification_approval","name_source_url":"https://os.copernicus.org/articles/22/17/2026/","existing_length_evidence_status":"published_estimate","ledger_kind":"current","planning_basis":"Reported branch extent and scoped local widths do not supply source geometry.","strategy_next_action":"Recover independent route geometry; do not trace a physical route from scalar prose.","known_component_currents":[],"component_inventory_status":"parent_and_downstream_name_boundaries_retained"}}],"proposed_widths":[{"id":"norwegian-atlantic-slope-orvik-2001-regional-width","proposed_current_id":"norwegian-atlantic-slope","name":"Norwegian Atlantic Slope Current","status":"editorial_width_evidence_for_proposed_identity_not_canonical","source_current_label":"eastern branch","measurement_type":"published_regional_branch_width_summary","width_metric":"author_reported_branch_width","approximate_width_km":null,"width_range_km":[30,50],"range_kind":"reported_regional_branch_width_span","is_confidence_interval":false,"geographic_scope":"Svinoy section north of the Faroe-Shetland Channel; local branch support, not whole-route dimensions.","layer":"Near-barotropic eastern branch; no fixed width measurement depth.","boundary_rule":"No paired coordinates or velocity cutoff supplied by the abstract width statement.","observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"section_geometry":null,"whole_current_representative":false,"rank_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"source_url":"https://www.sciencedirect.com/science/article/pii/S0967063700000388","source_citation":"Orvik, K. A., Skagseth, O. and Mork, M. (2001), Atlantic inflow to the Nordic Seas: current structure and volume fluxes from moored current meters, VM-ADCP and SeaSoar-CTD observations, 1995-1999, Deep-Sea Research I 48, 937-957, doi:10.1016/S0967-0637(00)00038-8.","source_locator":"Publisher-indexed abstract, eastern and western branch width statements.","source_access":"Publisher-indexed abstract inspected. Full original 2001 article and figures remain unreviewed.","source_retrieved_date":"2026-10-08","sampling_context":{"mooring_context_months":{"start":"1995-04","end":"1999-02"},"mooring_context_is_width_sampling_interval":false,"mooring_bathymetry_m":[490,990],"bathymetry_is_width_layer":false,"reported_jet_depth_m":null,"jet_depth_is_width_layer":false},"temporal_interpretation":"Mooring program dates are context, not a dated width series. No annual or seasonal range established.","unit":"km","full_width_inference_eligible":false,"source_publication_year":2001,"source_file":"research/norwegian-atlantic-branch-width-scope-audit.json","source_pointer":"/measurements/0"},{"id":"norwegian-atlantic-front-orvik-2001-regional-width","proposed_current_id":"norwegian-atlantic-front","name":"Norwegian Atlantic Front Current","status":"editorial_width_evidence_for_proposed_identity_not_canonical","source_current_label":"western branch","measurement_type":"published_regional_branch_width_summary","width_metric":"author_reported_branch_width","approximate_width_km":null,"width_range_km":[30,50],"range_kind":"reported_regional_branch_width_span","is_confidence_interval":false,"geographic_scope":"Svinoy section north of the Faroe-Shetland Channel; local branch support, not whole-route dimensions.","layer":"Frontal jet described as about 400 m deep; jet depth is not a fixed width measurement layer.","boundary_rule":"No paired coordinates or velocity cutoff supplied by the abstract width statement.","observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"section_geometry":null,"whole_current_representative":false,"rank_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"source_url":"https://www.sciencedirect.com/science/article/pii/S0967063700000388","source_citation":"Orvik, K. A., Skagseth, O. and Mork, M. (2001), Atlantic inflow to the Nordic Seas: current structure and volume fluxes from moored current meters, VM-ADCP and SeaSoar-CTD observations, 1995-1999, Deep-Sea Research I 48, 937-957, doi:10.1016/S0967-0637(00)00038-8.","source_locator":"Publisher-indexed abstract, eastern and western branch width statements.","source_access":"Publisher-indexed abstract inspected. Full original 2001 article and figures remain unreviewed.","source_retrieved_date":"2026-10-08","sampling_context":{"mooring_context_months":{"start":"1995-04","end":"1999-02"},"mooring_context_is_width_sampling_interval":false,"mooring_bathymetry_m":[490,990],"bathymetry_is_width_layer":false,"reported_jet_depth_m":400,"jet_depth_is_width_layer":false},"temporal_interpretation":"Mooring program dates are context, not a dated width series. No annual or seasonal range established.","unit":"km","full_width_inference_eligible":false,"source_publication_year":2001,"source_file":"research/norwegian-atlantic-branch-width-scope-audit.json","source_pointer":"/measurements/1"},{"id":"norwegian-atlantic-slope-mork-2010-surface-scale","proposed_current_id":"norwegian-atlantic-slope","name":"Norwegian Atlantic Slope Current","status":"editorial_width_evidence_for_proposed_identity_not_canonical","source_current_label":"NwASC","measurement_type":"published_ADT_surface_branch_scale","width_metric":"author_reported_surface_branch_scale","approximate_width_km":50,"width_range_km":null,"range_kind":null,"is_confidence_interval":false,"geographic_scope":"Svinoy section, eastern slope branch in surface-velocity description. The source 500 m isobath locates the branch core; it is not a width layer.","layer":"Altimetry-derived absolute geostrophic surface velocity; not the independent 100 m current-meter validation layer.","boundary_rule":"Approximate prose scale associated with Fig. 2; no numerical cutoff or width-edge coordinates extracted. Fig. 2 displays three-month moving averages.","observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"section_geometry":null,"whole_current_representative":false,"rank_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"source_url":"https://os.copernicus.org/articles/6/901/2010/","source_citation":"Mork, K. A. and Skagseth, O. (2010), A quantitative description of the Norwegian Atlantic Current by combining altimetry and hydrography, Ocean Science 6, 901-911, doi:10.5194/os-6-901-2010.","source_locator":"Section 3, printed p.904, first paragraph (approximately 50 km); Fig. 2 caption p.903; Sections 2.1-2.2 pp.902-903 and 4.1.1 p.906.","source_access":"Original eleven-page PDF acquired; methods/results/discussion and Figures 2-3 visually inspected. No raw ADT field or width boundaries digitized.","source_retrieved_date":"2026-10-08","sampling_context":{"ADT_context_months":{"start":"1992-10","end":"2009-07"},"ADT_context_is_exact_width_observation_interval":false,"surface_grid_resolution_km_at_section_approx":17,"figure_2_moving_average_months":3,"width_is_temporal_mean_or_mean_of_widths":false,"core_bathymetry_m_approx":500,"bathymetry_is_width_layer":false,"validation_instrument_depth_m":100,"validation_depth_is_width_layer":false},"temporal_interpretation":"Regional scale described from a smoothed surface-velocity field. Not an instantaneous width, width of the long-term mean, mean of widths, or numerical seasonal series.","unit":"km","full_width_inference_eligible":false,"source_publication_year":2010,"source_file":"research/norwegian-atlantic-branch-width-scope-audit.json","source_pointer":"/measurements/2"},{"id":"norwegian-atlantic-front-bosse-2019-corrected-width","proposed_current_id":"norwegian-atlantic-front","name":"Norwegian Atlantic Front Current","status":"editorial_width_evidence_for_proposed_identity_not_canonical","source_current_label":"NwAFC / Polar Front","measurement_type":"published_corrected_glider_front_width_summary","width_metric":"positive_poleward_depth_averaged_gaussian_integration_span","approximate_width_km":38,"width_range_km":null,"author_reported_error_km":2,"error_interpretation":"Reported plus/minus statistic; width-specific interpretation awaits corrected supporting Table S1. Adjacent velocity statistics use standard errors. No annual range or confidence level assigned.","range_kind":null,"is_confidence_interval":false,"geographic_scope":"Mohn Ridge Polar Front, not the Svinoy section or whole branch.","layer":"Depth-averaged absolute geostrophic jet, constrained by glider depth-average currents from upper-1000-m profiling; no fixed-depth width slab.","boundary_rule":"Fit a Gaussian to depth-averaged velocities above half peak; positive poleward integration boundaries within maximum plus/minus two fitted sigma. Theoretical transport coverage is not confidence coverage or FWHM.","observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"section_geometry":null,"whole_current_representative":false,"rank_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"full_width_inference_eligible":false,"source_url":"https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2019GL084723","source_citation":"Bosse and Fer (2019), Mean Structure and Seasonality of the Norwegian Atlantic Front Current Along the Mohn Ridge From Repeated Glider Transects, doi:10.1029/2019GL084723; corrected 2020-09-28.","source_locator":"Corrected publisher HTML: sections 2.2-2.4, 3.1-3.2 and erratum.","source_access":"Corrected publisher text reviewed. Corrected original PDF and supporting Table S1 not acquired; raw-mission source QA is not paper reproduction.","source_retrieved_date":"2026-10-13","source_correction_date":"2020-09-28","source_publication_year":2019,"sampling_context":{"glider_context_months":{"start":"2016-06","end":"2017-07"},"glider_sections":25,"study_interval_is_exact_width_occupation_dates":false,"seasonal_composite_months":{"winter":[1,2,3,4],"summer":[5,6,7,8],"fall":[9,10,11,12]},"seasonal_numeric_widths_verified":false,"raw_mission_georeferencing_reproduction_verified":false},"temporal_interpretation":"Published mean-structure width. Source describes seasonal widths as compatible within error bars; numeric seasonal means and annual physical extrema unverified.","unit":"km","source_file":"research/norwegian-atlantic-branch-width-scope-audit.json","source_pointer":"/measurements/3"},{"name":"Norwegian Atlantic Slope Current","status":"editorial_width_evidence_for_proposed_identity_not_canonical","section_geometry":null,"source_url":"https://os.copernicus.org/articles/16/685/2020/os-16-685-2020.pdf","source_citation":"Fer, I., Bosse, A., and Dugstad, J. (2020), Norwegian Atlantic Slope Current along the Lofoten Escarpment, Ocean Sci., 16, 685–701, doi:10.5194/os-16-685-2020.","source_retrieved_date":"2026-10-14","source_evidence_kind":"published_original_hydrographic_section_width","extraction_method":"Transcribed published numerical widths after original-page visual review; no field or edge-coordinate digitization.","whole_current_representative":false,"width_rank_eligible":false,"full_width_inference_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"is_confidence_interval":false,"observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"uncertainty_km":null,"whole_current_width_km":null,"annual_width_range_km":null,"remaining_gates":["Resolve catalog-name equivalence without transferring branch dimensions.","Extract exact section dates, layer support and paired edge coordinates before mapped or seasonal widths.","Independent scientific admission."],"id":"norwegian-fer-2020-gimsoy-relative-geostrophic-span","source_feature_name":"Norwegian Atlantic Slope Current","phase_kind":"campaign_relative_geostrophic_section_span","phase_label":"Gimsøy four-occupation relative-geostrophic span","measurement_type":"published_campaign_relative_geostrophic_span","width_metric":"relative_geostrophic_transport_density_twenty_percent_span","approximate_width_km":null,"width_range_km":[25,30],"range_kind":"author_reported_characteristic_section_span","range_interpretation":"Author-reported characteristic width span from the four-occupation analysis. No midpoint, per-date widths, confidence bounds or annual extrema.","geographic_scope":"Gimsøy hydrographic section near the Lofoten Escarpment; source-defined Norwegian Atlantic Slope Current, not Norwegian Coastal Current.","section_orientation":"Source hydrographic section across the continental slope; no reconstructed geographic edge coordinates.","layer":"Depth-integrated relative geostrophic current. Exact vertical integration limits for the width paragraph are unspecified; nearby mooring/transport layers are not assigned to width.","time_convention":"Four Gimsøy occupations: 2016-07-30, 2016-11-19, 2017-03-08, 2017-06-07. Source reports one characteristic range, not a width value for each date.","support_dates":["2016-07-30","2016-11-19","2017-03-08","2017-06-07"],"boundary_rule":"Lateral depth-integrated relative geostrophic current reduced to 20% of its maximum; geostrophic reference is surface pressure.","source_locator":"Section 2.2, printed p688/PDF p4; Section 5, printed p692/PDF p8, right-column Gimsøy paragraph.","source_quality_note":"Width integration bounds and numerical width uncertainty unspecified. Effective 20.1 km mooring integration width and assumed 4 km error are different quantities. Catalog naming ambiguity remains.","original_regional_context":{"description_kind":"gimsoy_relative_geostrophic_span","relative_threshold_fraction":0.2,"geostrophic_reference":"surface_pressure","exact_vertical_bounds_specified":f
ional_eddy_state_observation:W26002:NWCS","unit":null,"value":null},{"assertion_status":"recorded_observation","evidence_class":"derived_field","id":"claim:diagnosed_current_path:2026-09-25:gulf-stream-western-north-atlantic-reach","method":"Frozen-time geodesic midpoint integration of NOAA LSA surface geostrophic velocity; see source snapshot","method_source_id":"source:d65455d9259bb212","method_status":"described","object_id":null,"observation_time":"2026-09-25","predicate":"dated_geostrophic_streamline_reach","review_date":null,"review_fingerprint":"48f15ff152a7986510c049bef1b9f57aa3d8ed1771d9df042a7aa6f4d5f0720d","review_note":null,"review_status":"not_individually_reviewed","reviewer":null,"scope":"A 0.25-degree daily altimetry-derived surface geostrophic field omits ageostrophic and depth structure. Seed choice and numerical step change the trace. The line is a one-day frozen-field diagnostic, not a measured current axis, parcel trajectory, permanent state passage, or whole Gulf Stream length.","source_date":"2026-09-25","source_id":"source:80d0bf24c139328c","source_locator":"NetCDF ugos/vgos[time=0], 2026-09-25 daily field; see pinned subset and integration method","source_locator_status":"specific","source_snapshot_id":"source:d65455d9259bb212","subject_id":"current:gulf-stream-system","support_claim_id":null,"target_collection":"diagnosed_current_path_observations","target_id":"diagnosed_current_path:2026-09-25:gulf-stream-western-north-atlantic-reach","unit":"km","value":2277.3},{"assertion_status":"recorded_vocabulary_not_observed_assignment","evidence_class":"source_identified","id":"claim:classification_vocabulary:thompson-2018-antarctic-shelf-regimes","method":"OSW paraphrase of the cited source classification; criteria describe regional hydrographic support, not observed assignments or automatic surface-image classification","method_source_id":null,"method_status":"described","object_id":null,"observation_time":null,"predicate":"source_scoped_regime_vocabulary","review_date":null,"review_fingerprint":"c2316b6ba9f18d3d0846cf8c845be441163997cf40cc1fd8b1b139db6fcb2e22","review_note":null,"review_status":"not_individually_reviewed","reviewer":null,"scope":"Regional shelf/slope hydrographic regimes in this review, not a whole-current permanent class or global eddy taxonomy","source_date":"2018-12","source_id":"source:c81191f8e01b20c1","source_locator":"Section 2 introductory classification paragraphs; sections 2.1-2.3","source_locator_status":"specific","source_snapshot_id":null,"subject_id":"current:antarctic-slope","support_claim_id":null,"target_collection":"classification_vocabularies","target_id":"classification_vocabulary:thompson-2018-antarctic-shelf-regimes","unit":null,"value":null,"vocabulary_definition":{"assignment_requirements":["Source-supported regional/time/depth support","Compatible hydrographic fields","Explicit unknown or mixed regime where support is insufficient"],"assignment_status":"vocabulary_only_no_osw_state_assignments","assignments":[],"density_variable_note":"Thresholds refer to the source's neutral-density variable gamma_n in its conventional reported units, not an absolute seawater mass density of 28 kg/m3.","not_equivalent_to":["eddy_core_thermal_sign","surface_temperature_only","permanent_state_property"],"terms":[{"criterion_summary":"Layers with neutral density gamma_n greater than 28.0 (source-reported kg/m3 scale) do not extend onto the shelf.","id":"fresh_shelf","source_label":"Fresh Shelf"},{"criterion_summary":"Water with neutral density gamma_n greater than 28.0 (source-reported kg/m3 scale) occupies the shelf, which stays relatively cold with convection and dense-water formation.","id":"dense_shelf","source_label":"Dense Shelf"},{"criterion_summary":"Water with neutral density gamma_n greater than 28.0 reaches the shelf without dense-water formation; shelf water exceeds 0.5 degrees Celsius at some shelf depth.","id":"warm_shelf","source_label":"Warm Shelf"}]}},{"assertion_sta
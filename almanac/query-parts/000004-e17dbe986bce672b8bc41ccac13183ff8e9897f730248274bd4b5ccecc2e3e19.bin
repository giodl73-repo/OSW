17-2-36-50.","source_locator":"Abstract; Introduction pp. 36–37; Instruments p. 37; Stationary currents p. 38; Currents pp. 45–47, Fig. 9 and Fig. 10, especially Gaussian-fit paragraph on p. 47.","source_retrieved_date":"2026-10-03","source_evidence_kind":"published_front_centered_velocity_profile_fit","extraction_method":"Transcribed source fit scale and 15-crossing count; metric interpretation inferred algebraically from stated Gaussian equation. No figure digitized or converted full width added.","whole_current_representative":false,"width_rank_eligible":false,"phase_kind":"survey_profile_composite","phase_label":"2007 frontal-crossing composite","observed_period":null,"calendar_months":null,"cruise_context_period":{"start":"2007-05-29","end":"2007-06-10"},"cruise_context_is_composite_sampling_bounds":false,"profile_fit":{"model":"gaussian","equation":"V(x)=A*exp(-(x/a)^2)","amplitude":17,"velocity_units":"cm/s","scale_km":8,"coordinate_units":"km","component":"northward_geographic_velocity","center_definition":"frontal_section_center","crossing_count":15,"parameter_interpretation":"center_to_e_folding_distance","interpretation_origin":"OSW_algebraic_inference_from_source_equation","fit_uncertainty_km":null},"remaining_gates":["Resolve exact composite depth averaging and crossing dates from underlying data.","Define comparable paired boundaries before any full-width comparison.","Review branch identity and along-route support; canonical admission remains pending."]},{"id":"atlantic-neuc-1993-02-angular-section-span","current_id":"atlantic-north-equatorial-undercurrent","name":"Atlantic North Equatorial Undercurrent","status":"editorial_source_extraction_not_canonical","measurement_type":"published_month_section_angular_span","width_metric":"author_reported_meridional_angular_span","approximate_width_km":220,"width_range_km":null,"range_interpretation":"Published approximate two-degree latitude span, converted to kilometres; no source uncertainty range and no annu
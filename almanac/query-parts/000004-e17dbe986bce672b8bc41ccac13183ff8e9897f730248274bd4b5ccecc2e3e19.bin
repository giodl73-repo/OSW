dpoints not extracted.","layer":"HF radar nominal measurement depth 0.75 m; no fixed vertical layer assigned.","time_convention":"2005-2006, year precision; jet metrics filtered with a 40 h Hanning window. Monthly graph readings are provided in a separate diagnostic; this record preserves whole-study statistics.","boundary_rule":"Distance between both jet edges at 50% of the instantaneous core speed in the jet-coordinate downstream velocity profile; author applies a 40 h Hanning temporal filter to the jet metrics.","source_url":"https://agupubs.onlinelibrary.wiley.com/doi/10.1002/2017JC013286","source_citation":"Archer, Shay and Johns (2017), JGR Oceans 122, 9189-9208, doi:10.1002/2017JC013286.","source_locator":"Sections 2.2 and 3.4; Table 1 measurement depth; Table 2 width row and note; Figure 9 caption and section 6 item 5.","source_retrieved_date":"2026-10-06","source_evidence_kind":"published_hf_radar_jet_width_time_series_statistics","extraction_method":"Transcribed Table 2 width statistics and author-defined threshold/filter; monthly graph values and geographic edges not digitized.","whole_current_representative":false,"width_rank_eligible":false,"remaining_gates":["Recover year-specific monthly values and the source within-month variability envelope or original arrays.","Recover matched geographic boundary coordinates before physical map animation.","Independent scientific admission."],"phase_label":"Local surface jet statistics, 2005-2006","phase_kind":"width_time_series_statistics","observed_period":null,"calendar_months":null,"fixed_layer_bounds_m":null,"boundary_sides":"paired_half_core_speed_edges","full_width_inference_eligible":false,"annual_extrema_eligible":false,"seasonal_playback_eligible":false,"is_confidence_interval":false,"width_statistics_context":{"audit_file":"research/florida-hf-radar-width-statistics-scope-audit.json","audit_sha256":"c01d54e0cf90b1335d83710e8c104e36ef532ea3caaebd0b73d78f493554abdc","section_latitude_degrees_north":25.42,"
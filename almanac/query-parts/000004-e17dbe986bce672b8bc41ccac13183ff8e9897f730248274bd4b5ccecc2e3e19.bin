ubs.onlinelibrary.wiley.com/doi/full/10.1029/2018JC014264","source_citation":"Klenz, Dengler and Brandt (2018), Seasonal Variability of the Mauritania Current and Hydrography at 18 N, JGR: Oceans 123, 8122–8137, doi:10.1029/2018JC014264.","source_locator":"Section 5 width statement; section 2.1 and Table 2 sampling/remapping; section 3.1 and Figure 5 seasonal mean context.","source_retrieved_date":"2026-10-03","source_publication_year":2018,"source_evidence_kind":"published_observational_seasonal_mean_summary","extraction_method":"Width span transcribed from publisher conclusion; figures, edges and source arrays not digitized.","whole_current_representative":false,"width_rank_eligible":false,"remaining_gates":["Recover paired boundaries and thresholds for the source seasonal mean.","Obtain compatible relaxation/other-season repeat widths; no annual extrema yet.","Independent canonical measurement admission and release review."],"phase_label":"December–April poleward undercurrent · seasonal mean","phase_kind":"seasonal_mean_width_range","observed_period":null,"calendar_months":[12,1,2,3,4],"source_quality_note":"Five upwelling cruises support this mean. August 2016 was excluded from both seasonal means. The 60 km transport window and 200 km surface-flow context are not current widths.","calendar_source_locator":"Section 2.1 seasonal cruise assignment and Figure 5 caption.","seasonal_playback_eligible":false,"seasonal_mean_context":{"reference_latitude_degrees":18,"pooled_latitude_bounds_degrees":[17,19],"sample_years":[2005,2011],"study_years":[2005,2016],"cruise_ids":["P320","P347","P348","ATA3","MSM17/4"],"sampled_months":[1,2,3,4],"averaging_rule":"Measurements rotated locally, sorted by water depth, remapped onto reference topography, then assigned to source seasonal means.","width_of_mean_section":true,"mean_of_instantaneous_widths":false,"paired_edges_extracted":false,"fixed_depth_bounds_m":null}},{"id":"atlantic-secc-1994-03-described-band-span","current_id":"